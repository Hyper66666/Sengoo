import sgllm;

def expect_protocol(condition: bool, label: &str) -> i64 {
    if condition { return 0; };
    llm_diagnostic(label);
    1;
}

def response_control_case(payload: &str, valid: bool, signal: i64, continuation: bool) -> Result<i64, i64> {
    let mut turn = provider_turn();
    let event = turn.event(1, payload);
    if not valid { return llm_ok(expect_protocol(not event.is_ok() and not turn.finish().is_ok(), "Invalid Responses completion cannot authorize continuation or tools")); };
    if not event.is_ok() { return llm_ok(1); };
    let result = turn.finish()?;
    let mut failures = expect_protocol(result.root().object_get("requires_continuation")?.bool_value()? == continuation, "Only explicit end_turn=false continues Responses");
    if signal < 0 { failures = failures + expect_protocol(not result.root().object_has("responses_end_turn"), "Missing end_turn remains absent"); } else { failures = failures + expect_protocol(result.root().object_get("responses_end_turn")?.bool_value()? == (signal == 1), "end_turn round trip"); };
    llm_ok(failures);
}

def protocol_tests() -> Result<i64, i64> {
    let mut failures = 0;
    let metadata = json_doc_object_limits(1048576, 65536)?;
    llm_put_string(&metadata, metadata.root(), "type", "response.completed")?;
    let response = metadata.new_object()?;
    metadata.root().object_set("response", response)?;
    llm_put_string(&metadata, response, "status", "completed")?;
    let usage = metadata.new_object()?;
    response.object_set("usage", usage)?;
    llm_put_i64(&metadata, usage, "input_tokens", 9000)?;
    llm_put_i64(&metadata, usage, "output_tokens", 42)?;
    let attribution = metadata.new_array()?;
    usage.object_set("attribution", attribution)?;
    let mut metadata_index = 0;
    while metadata_index < 600 { let row = metadata.new_object()?; attribution.array_push(row)?; llm_put_i64(&metadata, row, "input_tokens", metadata_index)?; llm_put_i64(&metadata, row, "output_tokens", 1)?; llm_put_i64(&metadata, row, "cached_tokens", 0)?; llm_put_i64(&metadata, row, "cache_write_tokens", 0)?; llm_put_i64(&metadata, row, "reasoning_tokens", 0)?; llm_put_i64(&metadata, row, "total_tokens", metadata_index + 1)?; metadata_index = metadata_index + 1; };
    let serialized = metadata.serialize_string()?;
    failures = failures + expect_protocol(not json_parse(serialized.as_str()).is_ok(), "Regression fixture crosses the legacy JSON node budget");
    let baseline = sengoo_json_bounded_live_documents();
    let mut metadata_turn = provider_turn();
    metadata_turn.event(1, "{\"type\":\"response.output_text.delta\",\"delta\":\"metadata verified 世界\"}")?;
    metadata_turn.event(1, serialized.as_str())?;
    let metadata_result = metadata_turn.finish()?;
    failures = failures + expect_protocol(llm_json_string(metadata_result.root(), "content")?.as_str() == "metadata verified 世界" and llm_json_optional_i64(metadata_result.root(), "input_tokens", 0) == 9000 and llm_json_optional_i64(metadata_result.root(), "output_tokens", 0) == 42, "Rich completion metadata preserves answer and reported totals");
    failures = failures + expect_protocol(not metadata_result.root().object_has("attribution") and sengoo_json_bounded_live_documents() == baseline, "Transient event metadata is released and never retained in history");
    let mut invalid_json = provider_turn();
    failures = failures + expect_protocol(not invalid_json.event(1, "{broken").is_ok() and invalid_json.failure_label() == "Invalid provider event JSON", "Malformed JSON has a separate diagnostic");
    let oversized = llm_text("{\"type\":\"response.completed\",\"padding\":[");
    let mut oversized_index = 0;
    while oversized_index < 65536 { if oversized_index > 0 { oversized.push_str(",")?; (); }; oversized.push_str("0")?; oversized_index = oversized_index + 1; };
    oversized.push_str("]}")?;
    let mut limited_json = provider_turn();
    let refused_json = limited_json.event(1, oversized.as_str());
    failures = failures + expect_protocol(not refused_json.is_ok() and refused_json.error == 13 and not limited_json.done and limited_json.failure_label() == "Provider event exceeded the local JSON byte, node or memory limit", "JSON limit remains bounded and cannot authorize tools");
    let mut extra_http = http_decoder();
    let extra_data = extra_http.feed("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nokextra");
    failures = failures + expect_protocol(not extra_data.is_ok() or not extra_http.finish().is_ok(), "HTTP terminal rejects bytes beyond framed body");
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"end_turn\":false}}", true, 0, true)?;
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"end_turn\":true}}", true, 1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\"}}", true, -1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"end_turn\":\"false\"}}", false, -1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"end_turn\":null}}", false, -1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"end_turn\":0}}", false, -1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"incomplete\",\"end_turn\":false}}", false, -1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.incomplete\",\"response\":{\"status\":\"incomplete\",\"end_turn\":false}}", false, -1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"end_turn\":false,\"incomplete_details\":{\"reason\":\"max_output_tokens\"}}}", false, -1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"end_turn\":false,\"output\":[{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"refusal\",\"refusal\":\"no\"}]}]}}", false, -1, false)?;
    failures = failures + response_control_case("{\"type\":\"response.refusal.delta\",\"delta\":\"no\"}", false, -1, false)?;
    let history = json_parse("{\"messages\":[{\"role\":\"system\",\"content\":\"You code\"},{\"role\":\"user\",\"content\":\"世界\"},{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c1\",\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"a.sg\\\"}\"}]},{\"role\":\"tool\",\"tool_call_id\":\"c1\",\"content\":\"file content\"}]}")?;
    let tools = json_parse("{\"tools\":[{\"name\":\"read_file\",\"description\":\"Read\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}]}")?;
    let chat = provider_build_request(0, "chat-model", &history, &tools)?;
    let chat_doc = json_parse(chat.as_str())?;
    failures = failures + expect_protocol(chat_doc.root().object_get("messages")?.array_len()? == 4, "Chat history shape");
    let responses = provider_build_request(1, "responses-model", &history, &tools)?;
    let responses_doc = json_parse(responses.as_str())?;
    failures = failures + expect_protocol(responses_doc.root().object_get("input")?.array_len()? == 4, "Responses input preserves function call/output");
    let anthropic = provider_build_request(2, "messages-model", &history, &tools)?;
    let anthropic_doc = json_parse(anthropic.as_str())?;
    failures = failures + expect_protocol(anthropic_doc.root().object_get("messages")?.array_len()? == 3, "Anthropic extracts system");
    let mut turn = provider_turn();
    turn.event(0, "{\"choices\":[{\"delta\":{\"content\":\"hello 世界\",\"tool_calls\":[{\"index\":0,\"id\":\"call\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\"}}]},\"finish_reason\":null}]}")?;
    turn.event(0, "{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"\\\"a.sg\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":100,\"completion_tokens\":12}}")?;
    turn.event(0, "[DONE]")?;
    let finished = turn.finish()?;
    failures = failures + expect_protocol(finished.root().object_get("tool_calls")?.array_len()? == 1, "Chat split tool arguments");
    failures = failures + expect_protocol(llm_json_optional_i64(finished.root(), "input_tokens", 0) == 100, "Usage total");
    let mut response_turn = provider_turn();
    response_turn.event(1, "{\"type\":\"response.output_item.added\",\"output_index\":1,\"item\":{\"type\":\"function_call\",\"call_id\":\"r1\",\"name\":\"search\",\"arguments\":\"\"}}")?;
    response_turn.event(1, "{\"type\":\"response.function_call_arguments.delta\",\"output_index\":1,\"delta\":\"{}\"}")?;
    response_turn.event(1, "{\"type\":\"response.completed\",\"response\":{\"usage\":{\"input_tokens\":5,\"output_tokens\":6}}}")?;
    failures = failures + expect_protocol(response_turn.finish().is_ok(), "Responses tool call completion");
    let mut reasoning_turn = provider_turn();
    reasoning_turn.event(1, "{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"type\":\"reasoning\",\"id\":\"opaque-r1\",\"summary\":[]}}")?;
    reasoning_turn.event(1, "{\"type\":\"response.output_item.added\",\"output_index\":1,\"item\":{\"type\":\"function_call\",\"call_id\":\"r2\",\"name\":\"read_file\",\"arguments\":\"{}\"}}")?;
    reasoning_turn.event(1, "{\"type\":\"response.output_item.done\",\"output_index\":0,\"item\":{\"type\":\"reasoning\",\"id\":\"opaque-r1\",\"summary\":[]}}")?;
    reasoning_turn.event(1, "{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\"}}")?;
    let reasoning_finished = reasoning_turn.finish()?;
    failures = failures + expect_protocol(reasoning_finished.root().object_get("responses_output")?.array_len()? == 2, "Responses output items are retained for continuation");
    let continuation_history = json_parse("{\"messages\":[{\"role\":\"system\",\"content\":\"You code\"},{\"role\":\"user\",\"content\":\"世界\"},{\"role\":\"assistant\",\"content\":\"\",\"responses_output\":[{\"type\":\"reasoning\",\"id\":\"opaque-r1\",\"summary\":[]},{\"type\":\"function_call\",\"call_id\":\"r2\",\"name\":\"read_file\",\"arguments\":\"{}\"}],\"tool_calls\":[{\"id\":\"r2\",\"name\":\"read_file\",\"arguments\":\"{}\"}]},{\"role\":\"tool\",\"tool_call_id\":\"r2\",\"content\":\"file content\"}]}")?;
    let continuation = provider_build_request(1, "responses-model", &continuation_history, &tools)?;
    let continuation_doc = json_parse(continuation.as_str())?;
    let continuation_input = continuation_doc.root().object_get("input")?;
    failures = failures + expect_protocol(continuation_input.array_len()? == 5 and llm_json_string(continuation_input.array_get(2)?, "type")?.as_str() == "reasoning", "Responses reasoning item precedes tool continuation");
    failures = failures + expect_protocol(not continuation_doc.root().object_get("store")?.bool_value()? and continuation_doc.root().object_get("include")?.array_len()? == 1, "Responses requests encrypted stateless continuation");
    let mut completed_only = provider_turn();
    completed_only.event(1, "{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[{\"id\":\"message-phase\",\"type\":\"message\",\"role\":\"assistant\",\"phase\":\"commentary\",\"content\":[{\"type\":\"output_text\",\"text\":\"Let me inspect.\"}]},{\"id\":\"reasoning-full\",\"type\":\"reasoning\",\"encrypted_content\":\"opaque-encrypted\",\"summary\":[]},{\"id\":\"function-item\",\"type\":\"function_call\",\"call_id\":\"complete-call\",\"name\":\"read_file\",\"arguments\":\"{}\"}]}}")?;
    let completed_only_result = completed_only.finish()?;
    let completed_output = completed_only_result.root().object_get("responses_output")?;
    failures = failures + expect_protocol(completed_output.array_len()? == 3 and llm_json_string(completed_output.array_get(0)?, "phase")?.as_str() == "commentary" and llm_json_string(completed_output.array_get(1)?, "encrypted_content")?.as_str() == "opaque-encrypted" and completed_only_result.root().object_get("tool_calls")?.array_len()? == 1, "Complete-only response preserves full ordered opaque items and phase");
    let mut bad_reasoning = provider_turn();
    failures = failures + expect_protocol(not bad_reasoning.event(1, "{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"type\":\"reasoning\",\"id\":\"opaque\\u0000hidden\",\"summary\":[]}}").is_ok(), "NUL reasoning identity is refused before tools");
    let mut duplicate_reasoning = provider_turn();
    duplicate_reasoning.event(1, "{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"type\":\"reasoning\",\"id\":\"duplicate\",\"summary\":[]}}")?;
    failures = failures + expect_protocol(not duplicate_reasoning.event(1, "{\"type\":\"response.output_item.added\",\"output_index\":1,\"item\":{\"type\":\"reasoning\",\"id\":\"duplicate\",\"summary\":[]}}").is_ok(), "Duplicate provider output identity is refused");
    let mut messages_turn = provider_turn();
    messages_turn.event(2, "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"tool_use\",\"id\":\"a1\",\"name\":\"read_file\",\"input\":{}}}")?;
    messages_turn.event(2, "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{}\"}}")?;
    messages_turn.event(2, "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\"},\"usage\":{\"output_tokens\":8}}")?;
    messages_turn.event(2, "{\"type\":\"message_stop\"}")?;
    failures = failures + expect_protocol(messages_turn.finish().is_ok(), "Messages tool call completion");
    let incomplete = provider_turn();
    failures = failures + expect_protocol(not incomplete.finish().is_ok(), "Truncated turns cannot run tools");
    let mut limited = provider_turn();
    failures = failures + expect_protocol(not limited.event(1, "{\"type\":\"response.incomplete\",\"response\":{\"incomplete_details\":{\"reason\":\"max_output_tokens\"}}}").is_ok() and limited.failure_label() == "Provider output token limit reached", "Incomplete Responses output limit has a distinct safe diagnostic");
    let mut failed_stream = provider_turn();
    failures = failures + expect_protocol(not failed_stream.event(2, "{\"type\":\"error\",\"error\":{\"type\":\"rate_limit_error\",\"message\":\"SECRET-DO-NOT-LOG\"}}").is_ok() and failed_stream.failure_label() == "Provider rate limit reported inside the stream", "HTTP 200 stream errors retain only a closed diagnostic category");
    let sample = "data: {\"text\":\"世界😀\"}\r\n\r\nevent: ping\ndata: first\ndata: second\n\n";
    let sample_bytes = ffi_buffer_from_bytes(sample)?;
    let mut split = 0;
    while split <= sample.len() { let mut decoder = sse_decoder(); let a = decoder.feed_bytes(&sample_bytes, 0, split)?; let b = decoder.feed_bytes(&sample_bytes, split, sample.len() - split)?; failures = failures + expect_protocol(a.len() + b.len() == 2, "SSE every byte boundary"); decoder.finish()?; split = split + 1; };
    let invalid = ffi_buffer_new(4)?;
    invalid.push_u8(255)?;
    invalid.push_u8(10)?;
    let mut invalid_decoder = sse_decoder();
    failures = failures + expect_protocol(not invalid_decoder.feed_bytes(&invalid, 0, 2).is_ok(), "SSE invalid UTF-8 fails before JSON");
    llm_ok(failures);
}

def main() -> i64 {
    let result = protocol_tests();
    if not result.is_ok() { println(result.error); return 1; };
    if result.value == 0 { println("provider and SSE acceptance passed"); };
    result.value;
}
