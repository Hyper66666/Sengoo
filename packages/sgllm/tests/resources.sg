import sgllm;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def resource_expect(value: bool, label: &str) -> Result<bool, i64> {
    if not value { println(label); return Result { is_ok: false, value: false, error: 99 }; };
    Result { is_ok: true, value: true, error: 0 };
}

def one_round() -> Result<bool, i64> {
    let invalid = http_endpoint("ftp://invalid", "/responses");
    resource_expect(not invalid.is_ok(), "invalid endpoint refused")?;
    let invalid_host = http_endpoint("http://external.invalid", "/responses");
    resource_expect(not invalid_host.is_ok(), "unsafe plaintext endpoint refused")?;
    Result { is_ok: true, value: true, error: 0 };
}

def malformed_round() -> Result<bool, i64> {
    let mut malformed = provider_turn();
    let decoded = malformed.event(1, "{malformed");
    resource_expect(not decoded.is_ok(), "malformed model event refused")?;
    let early = malformed.finish();
    resource_expect(not early.is_ok() and early.value.handle == 0, "failed completion carries no owning JSON")?;
    Result { is_ok: true, value: true, error: 0 };
}

def duplicate_round() -> Result<bool, i64> {
    let mut duplicate = provider_turn();
    duplicate.done = true;
    duplicate.finish_reason = llm_text("stop");
    duplicate.calls.push(ProviderToolCall { index: 0, id: llm_text("same"), name: llm_text("read"), arguments: llm_text("{}") });
    duplicate.calls.push(ProviderToolCall { index: 1, id: llm_text("same"), name: llm_text("read"), arguments: llm_text("{}") });
    let duplicate_result = duplicate.finish();
    resource_expect(not duplicate_result.is_ok() and duplicate_result.value.handle == 0, "invalid call completion releases its allocated document")?;
    Result { is_ok: true, value: true, error: 0 };
}

def sse_round() -> Result<bool, i64> {
    let mut sse = sse_decoder();
    sse.maximum = 8;
    let overflow = sse.feed("data: too much\n\n");
    resource_expect(not overflow.is_ok() and overflow.error == 13 and overflow.value.handle == 0, "SSE overflow carries no owning events")?;
    Result { is_ok: true, value: true, error: 0 };
}

def http_round() -> Result<bool, i64> {
    let mut http = http_decoder();
    let bytes = ffi_buffer_from_bytes("abc")?;
    let bad_slice = http.feed_bytes(&bytes, 0, 9223372036854775807);
    resource_expect(not bad_slice.is_ok() and bad_slice.error == 2 and bad_slice.value.handle == 0, "HTTP slice checked before allocation")?;
    let extra = ffi_buffer_new(2097153)?;
    sengoo_ffi_buffer_commit_used_len(extra.raw_handle(), 2097153);
    let too_large = http.feed_bytes(&extra, 0, extra.used_len());
    resource_expect(not too_large.is_ok(), "HTTP rejects oversized admission")?;
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let documents = sengoo_json_bounded_live_documents();
    let mut index = 0;
    while index < 20 { let result = one_round(); if not result.is_ok() { println(result.error); return 1; }; if not malformed_round().unwrap_or(false) or not duplicate_round().unwrap_or(false) or not sse_round().unwrap_or(false) or not http_round().unwrap_or(false) { return 1; }; if sengoo_string_live_handle_count() != strings or sengoo_buffer_live_handle_count() != buffers or sengoo_opaque_live_handle_count() != opaque or sengoo_json_bounded_live_documents() != documents { println("SDK failure paths did not return resource counters to baseline"); println(strings); println(sengoo_string_live_handle_count()); println(buffers); println(sengoo_buffer_live_handle_count()); println(opaque); println(sengoo_opaque_live_handle_count()); return 1; }; index = index + 1; };
    println("20 repeated invalid endpoint, malformed event, finish failure, SSE overflow and HTTP admission paths reclaim strings, buffers, JSON and opaque handles");
    0;
}
