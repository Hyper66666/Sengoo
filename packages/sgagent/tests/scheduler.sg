import sgagent;

def expect_schedule(value: bool, message: &str) -> i64 {
    if value { return 0; };
    agent_diagnostic(message);
    1;
}

def check_scheduler() -> Result<i64, i64> {
    println("scheduler: limits");
    let mut failures = 0;
    let unlimited = scheduler_new();
    let root_unlimited = scheduler_add(&unlimited, 0, "a", ".", false)?;
    let child_unlimited = scheduler_add(&unlimited, root_unlimited, "a", ".", false)?;
    let mut no_cap = goal_new(0, 0);
    let mut request_index = 0;
    while request_index < 160 { let owner = if request_index % 2 == 0 { root_unlimited; } else { child_unlimited; }; scheduler_acquire_model(&unlimited, owner)?; failures = failures + expect_schedule(scheduler_take_request(&unlimited, owner, &mut no_cap), "unlimited parent and child requests continue past fifty calls"); scheduler_report_usage(&unlimited, owner, &mut no_cap, 5); scheduler_release_model(&unlimited, owner)?; request_index = request_index + 1; };
    failures = failures + expect_schedule(no_cap.status == 1 and no_cap.requests == 160 and no_cap.tokens == 800, "unlimited admission retains shared usage accounting");
    let scheduler = scheduler_new();
    let parent = scheduler_add(&scheduler, 0, "a", ".", true)?;
    let child1 = scheduler_add(&scheduler, parent, "a", ".", false)?;
    let child2 = scheduler_add(&scheduler, parent, "a", ".", false)?;
    let other1 = scheduler_add(&scheduler, 0, "b", ".", false)?;
    let other2 = scheduler_add(&scheduler, 0, "b", ".", false)?;
    let extra = scheduler_add(&scheduler, 0, "c", ".", false)?;
    let nested = scheduler_add(&scheduler, child1, "a", ".", false);
    failures = failures + expect_schedule(not nested.is_ok() and nested.error == 7, "Active child cannot spawn a grandchild");
    failures = failures + expect_schedule(scheduler_acquire_model(&scheduler, parent)?, "Parent gets model permit");
    failures = failures + expect_schedule(scheduler_acquire_model(&scheduler, child1)?, "Child shares connection capacity");
    failures = failures + expect_schedule(not scheduler_acquire_model(&scheduler, child2)?, "Connection is bounded at two");
    failures = failures + expect_schedule(scheduler_acquire_model(&scheduler, other1)? and scheduler_acquire_model(&scheduler, other2)?, "Other connection progresses independently");
    failures = failures + expect_schedule(not scheduler_acquire_model(&scheduler, extra)? and scheduler_model_count(&scheduler, "") == 4, "Global capacity is four");
    failures = failures + expect_schedule(not scheduler_wait_children(&scheduler, parent)?, "Parent waits for children");
    failures = failures + expect_schedule(scheduler_model_count(&scheduler, "") == 3 and scheduler_acquire_model(&scheduler, child2)?, "Waiting parent releases a saturated connection slot");
    failures = failures + expect_schedule(not scheduler_acquire_model(&scheduler, parent)?, "Parent cannot resume before children finish");
    scheduler_finish(&scheduler, child1, 0)?;
    scheduler_finish(&scheduler, child2, 0)?;
    failures = failures + expect_schedule(scheduler_wait_children(&scheduler, parent)? and scheduler_acquire_model(&scheduler, parent)?, "Parent resumes after children finish");
    let forbidden = scheduler_add(&scheduler, child1, "a", ".", false);
    failures = failures + expect_schedule(not forbidden.is_ok(), "Child cannot spawn a grandchild");
    let read_parent = scheduler_add(&scheduler, 0, "d", ".", false)?;
    let escalation = scheduler_add(&scheduler, read_parent, "d", ".", true);
    failures = failures + expect_schedule(not escalation.is_ok() and escalation.error == 7, "Read-only parent cannot create a writer");
    let reader_write = scheduler_acquire_write(&scheduler, read_parent);
    failures = failures + expect_schedule(not reader_write.is_ok() and reader_write.error == 7, "Read-only jobs never acquire write permit");
    scheduler_cancel_all(&scheduler);
    failures = failures + expect_schedule(scheduler_model_count(&scheduler, "") == 0 and scheduler_is_cancelled(&scheduler, parent) and scheduler_is_cancelled(&scheduler, other1) and scheduler_state(&scheduler, child2) == 2, "Cancellation releases permits and preserves completed children");
    let writers = scheduler_new();
    println("scheduler: writers");
    let w1 = scheduler_add(&writers, 0, "a", ".", true)?;
    let w2 = scheduler_add(&writers, 0, "a", "./src/..", true)?;
    let w3 = scheduler_add(&writers, 0, "b", ".", true)?;
    let reader = scheduler_add(&writers, 0, "b", ".", false)?;
    failures = failures + expect_schedule(scheduler_acquire_write(&writers, w1)?, "First writer acquired");
    failures = failures + expect_schedule(not scheduler_acquire_write(&writers, w2)? and not scheduler_acquire_write(&writers, w3)?, "Canonical cwd aliases serialize writes");
    failures = failures + expect_schedule(scheduler_acquire_model(&writers, reader)?, "Read-only model request can progress beside writer");
    scheduler_release_write(&writers, w1)?;
    failures = failures + expect_schedule(not scheduler_acquire_write(&writers, w3)? and scheduler_acquire_write(&writers, w2)?, "Queued writers preserve FIFO");
    scheduler_cancel_tree(&writers, w2);
    failures = failures + expect_schedule(not scheduler_acquire_write(&writers, w3)?, "Cancellation does not release a potentially live writer");
    failures = failures + expect_schedule(scheduler_confirm_quiescent(&writers, w2)? and scheduler_acquire_write(&writers, w3)?, "Confirmed quiescent writer releases its cwd permit");
    println("scheduler: tool quiescence");
    let draining = scheduler_new();
    let owner = scheduler_add(&draining, 0, "a", ".", true)?;
    let descendant = scheduler_add(&draining, owner, "b", ".", true)?;
    let successor = scheduler_add(&draining, 0, "c", ".", true)?;
    scheduler_acquire_write(&draining, descendant)?;
    let lease = scheduler_begin_tool(&draining, descendant)?;
    let second_lease = scheduler_begin_tool(&draining, descendant)?;
    let live_wait = scheduler_wait_children(&draining, descendant);
    let live_finish = scheduler_finish(&draining, descendant, 0);
    let live_release = scheduler_release_write(&draining, descendant);
    failures = failures + expect_schedule(not live_wait.is_ok() and live_wait.error == 6 and not live_finish.is_ok() and not live_release.is_ok(), "Live tool leases cannot be hidden by wait finish or write release");
    scheduler_cancel_tree(&draining, owner);
    let too_soon = scheduler_confirm_quiescent(&draining, descendant);
    let unproven = scheduler_end_tool(&draining, descendant, lease, false);
    failures = failures + expect_schedule(not too_soon.is_ok() and not unproven.is_ok() and scheduler_children_pending(&draining, owner), "Canceled descendants stay pending until cleanup is proven");
    failures = failures + expect_schedule(scheduler_reap(&draining) == 0 and not scheduler_acquire_write(&draining, successor)?, "Reaping and new writes cannot bypass draining descendants");
    scheduler_end_tool(&draining, descendant, lease, true)?;
    failures = failures + expect_schedule(not scheduler_end_tool(&draining, descendant, lease, true)? and not scheduler_end_tool(&draining, descendant, lease + 100, true)?, "Duplicate and stale completions cannot remove another live lease");
    let outstanding = scheduler_confirm_quiescent(&draining, descendant);
    failures = failures + expect_schedule(not outstanding.is_ok() and not scheduler_acquire_write(&draining, successor)?, "Every parallel tool must settle before handoff");
    scheduler_end_tool(&draining, descendant, second_lease, true)?;
    failures = failures + expect_schedule(scheduler_confirm_quiescent(&draining, descendant)? and not scheduler_children_pending(&draining, owner), "All completed leases allow canceled child cleanup");
    failures = failures + expect_schedule(scheduler_confirm_quiescent(&draining, owner)? and scheduler_acquire_write(&draining, successor)?, "Parent handoff follows descendant quiescence");
    failures = failures + expect_schedule(scheduler_reap(&draining) == 2, "Only fully quiescent canceled tree is reaped");
    let late_lease = scheduler_begin_tool(&draining, owner);
    failures = failures + expect_schedule(not late_lease.is_ok(), "Canceled or reaped owners cannot start new tool work");
    let pending_cancel = scheduler_new();
    let holder = scheduler_add(&pending_cancel, 0, "a", ".", true)?;
    let canceled_waiter = scheduler_add(&pending_cancel, 0, "a", ".", true)?;
    let next_waiter = scheduler_add(&pending_cancel, 0, "b", ".", true)?;
    scheduler_acquire_write(&pending_cancel, holder)?;
    scheduler_acquire_write(&pending_cancel, canceled_waiter)?;
    scheduler_acquire_write(&pending_cancel, next_waiter)?;
    scheduler_cancel_tree(&pending_cancel, canceled_waiter);
    scheduler_release_write(&pending_cancel, holder)?;
    failures = failures + expect_schedule(scheduler_acquire_write(&pending_cancel, next_waiter)?, "Canceled queued writer removes its ticket without blocking FIFO");
    let budgeted = scheduler_new();
    println("scheduler: requests");
    let root = scheduler_add(&budgeted, 0, "a", ".", true)?;
    let child = scheduler_add(&budgeted, root, "a", ".", false)?;
    let unrelated = scheduler_add(&budgeted, 0, "b", ".", false)?;
    let mut goal = goal_new(2, 0);
    scheduler_acquire_model(&budgeted, root)?;
    failures = failures + expect_schedule(scheduler_take_request(&budgeted, root, &mut goal), "Parent reserves one shared request");
    failures = failures + expect_schedule(not scheduler_take_request(&budgeted, root, &mut goal) and goal.requests == 1, "Repeated poll cannot consume another request");
    let premature_wait = scheduler_wait_children(&budgeted, root);
    failures = failures + expect_schedule(not premature_wait.is_ok() and premature_wait.error == 6, "Live provider request cannot be hidden by parent wait");
    let reported = scheduler_report_usage(&budgeted, root, &mut goal, 10);
    let duplicate_report = scheduler_report_usage(&budgeted, root, &mut goal, 10);
    failures = failures + expect_schedule(reported and not duplicate_report and goal.tokens == 10, "Usage charged exactly once");
    scheduler_wait_children(&budgeted, root)?;
    scheduler_acquire_model(&budgeted, child)?;
    failures = failures + expect_schedule(scheduler_take_request(&budgeted, child, &mut goal), "Child uses shared request budget");
    scheduler_report_usage(&budgeted, child, &mut goal, 20);
    scheduler_acquire_model(&budgeted, unrelated)?;
    failures = failures + expect_schedule(not scheduler_take_request(&budgeted, unrelated, &mut goal) and goal.status == 3 and goal.requests == 2, "Shared budget denies third request");
    failures = failures + expect_schedule(scheduler_is_cancelled(&budgeted, root) and scheduler_is_cancelled(&budgeted, child) and scheduler_is_cancelled(&budgeted, unrelated), "Budget exhaustion cancels all trees");
    let token_limited = scheduler_new();
    println("scheduler: tokens");
    let t1 = scheduler_add(&token_limited, 0, "a", ".", true)?;
    let t2 = scheduler_add(&token_limited, t1, "a", ".", false)?;
    let mut tokens = goal_new(50, 15);
    scheduler_acquire_model(&token_limited, t1)?;
    scheduler_acquire_model(&token_limited, t2)?;
    scheduler_take_request(&token_limited, t1, &mut tokens);
    scheduler_take_request(&token_limited, t2, &mut tokens);
    let premature_release = scheduler_release_model(&token_limited, t2);
    failures = failures + expect_schedule(not premature_release.is_ok() and premature_release.error == 6, "Live provider keeps its model slot until accounting completion");
    scheduler_report_usage(&token_limited, t1, &mut tokens, 15);
    failures = failures + expect_schedule(tokens.status == 3 and scheduler_is_cancelled(&token_limited, t2), "Token budget cancels already active children");
    failures = failures + expect_schedule(scheduler_model_count(&token_limited, "") == 1, "Canceled provider retains capacity while its worker is live");
    failures = failures + expect_schedule(scheduler_reap(&token_limited) == 0, "Unreported child usage retains stable task identity");
    scheduler_report_usage(&token_limited, t2, &mut tokens, 2);
    failures = failures + expect_schedule(scheduler_reap(&token_limited) == 2 and tokens.tokens == 17, "Late cancellation usage is accounted before cleanup");
    let reuse = scheduler_new();
    println("scheduler: reuse");
    let mut first = 0;
    let mut last = 0;
    let mut cycle = 0;
    while cycle < 140 { let id = scheduler_add(&reuse, 0, "a", ".", false)?; if cycle == 0 { first = id; }; last = id; scheduler_finish(&reuse, id, 0)?; scheduler_reap(&reuse); cycle = cycle + 1; };
    failures = failures + expect_schedule(last > first and scheduler_state(&reuse, first) == -3 and reuse.tasks.len() == 0, "Finished slots reuse bounded memory without reusing ids");
    let limits = scheduler_with_limits(1, 1)?;
    println("scheduler: configured");
    let l1 = scheduler_add(&limits, 0, "a", ".", false)?;
    let l2 = scheduler_add(&limits, 0, "b", ".", false)?;
    failures = failures + expect_schedule(scheduler_acquire_model(&limits, l1)? and not scheduler_acquire_model(&limits, l2)?, "Explicit concurrency limits apply");
    let bad = scheduler_with_limits(9, 2);
    failures = failures + expect_schedule(not bad.is_ok() and bad.error == 2, "Invalid concurrency limits are rejected");
    let bounded = scheduler_new();
    let mut budget = goal_new(20, 0);
    let waiting = scheduler_add(&bounded, 0, "a", ".", true)?;
    let child = scheduler_add(&bounded, waiting, "a", ".", false)?;
    scheduler_wait_children(&bounded, waiting)?;
    failures = failures + expect_schedule(not scheduler_acquire_model(&bounded, waiting)?, "indefinite join waits for pending children");
    scheduler_resume_wait(&bounded, waiting)?;
    failures = failures + expect_schedule(scheduler_acquire_model(&bounded, waiting)? and budget.requests == 0, "bounded wait returns runnable without charging a request");
    scheduler_release_model(&bounded, waiting)?;
    scheduler_acquire_model(&bounded, child)?;
    scheduler_cancel_tree(&bounded, waiting);
    failures = failures + expect_schedule(not scheduler_resume_wait(&bounded, waiting).is_ok(), "resuming a wait cannot undo cancellation");
    agent_ok(failures);
}

def main() -> i64 {
    let checked = check_scheduler();
    if not checked.is_ok() { println(checked.error); return 1; };
    if checked.value == 0 { println("scheduler acceptance passed"); };
    checked.value;
}
