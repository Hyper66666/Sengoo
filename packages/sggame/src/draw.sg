import std::status;

import sgplatform;

import state;

def clear(color: Color) -> Result<i64, i64> {
    let renderer = current_renderer();
    if renderer.handle == 0 or renderer.destroyed { Result { is_ok: false, value: 0, error: STATUS_INVALID_HANDLE() }; } else { renderer.clear(color); };
}

def rect(color: Color, target: Rect) -> Result<i64, i64> {
    let renderer = current_renderer();
    if renderer.handle == 0 or renderer.destroyed { Result { is_ok: false, value: 0, error: STATUS_INVALID_HANDLE() }; } else { renderer.fill_rect(target, color); };
}

def line(color: Color, x1: i64, y1: i64, x2: i64, y2: i64) -> Result<i64, i64> {
    let renderer = current_renderer();
    if renderer.handle == 0 or renderer.destroyed { Result { is_ok: false, value: 0, error: STATUS_INVALID_HANDLE() }; } else { renderer.draw_line(x1, y1, x2, y2, color); };
}