import sggame;

import std::assert;

import std::env;

import std::status;

def main() -> i64 {
    let started = sggame_init();
    if env_has_var("SGPLATFORM_SKIP_GRAPHICS") { assert_true(not started.is_ok); assert_eq_i64(started.error, STATUS_PLATFORM()); } else if started.is_ok { assert_eq_i64(started.value, STATUS_OK()); assert_true(sggame_quit()); } else { assert_eq_i64(started.error, STATUS_PLATFORM()); };
    0;
}