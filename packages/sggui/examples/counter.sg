import sggui;

def main() -> i64 {
    let created = app_new("sggui counter", 480, 320);
    if !created.is_ok {
        return 1;
    }

    let app = created.value;
    let renderer = app.renderer_ref();

    let panel_bounds = layout_rect(40, 40, 400, 240);
    let label_row = panel_alloc_row(panel_new(panel_bounds, 16), 80);
    let button_row = panel_alloc_row(label_row.panel, 48);
    let panel = button_row.panel;
    let count_label = label_new("Count", 0, label_row.bounds);
    let increment_button = button_new("Increment", button_row.bounds);

    let panel_bg = color_new(36, 40, 48, 255);
    let panel_border = color_new(71, 85, 105, 255);
    let label_bg = color_new(51, 65, 85, 255);
    let label_accent = color_new(96, 165, 250, 255);
    let button_fill = color_new(59, 130, 246, 255);
    let button_border = color_new(147, 197, 253, 255);

    let running = app.running();
    let app_loop = app;
    let label_loop = count_label;
    let start_ms = app.platform.ticks_ms();
    while running {
        let polled = app_loop.poll();
        app_loop = polled.app;
        let event = polled.event;
        running = app_loop.running();

        if increment_button.handle_event(event) {
            label_loop = label_increment(label_loop);
        }

        let frame = app_loop.begin_frame();
        if !frame.is_ok {
            running = false;
        } else {
            panel.draw(renderer, panel_bg, panel_border);
            label_loop.draw(renderer, label_bg, label_accent, 8);
            increment_button.draw(renderer, button_fill, button_border);

            let presented = app_loop.end_frame();
            if !presented.is_ok {
                running = false;
            } else {
                let delayed = app_delay_ms(app_loop, 16);
                if !delayed {
                    running = false;
                }
            }
        }

        if app_loop.platform.ticks_ms() - start_ms > 1500 {
            running = false;
        }
    }

    if app_loop.close() {
        0
    } else {
        1
    }
}
