import sgmcp;

import std::args;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_json_bounded_live_documents() -> i64;
}

def serve() -> Result<bool, i64> {
    let mut server = sgmcp_server("backpressure", "0.1.0", 1)?;
    let schema = json_parse("{\"type\":\"object\"}")?;
    server.tool("flood", "Generate output until the host cancels", schema.root(), schema.root())?;
    let deadline_case = args_len() == 1;
    let mut stdio = sgmcp_stdio_with_timeout(if deadline_case { 500; } else { 10000; })?;
    let active = json_doc_object()?;
    let message = string_new();
    let mut index = 0;
    while index < 8192 { message.push_str("abcdefgh")?; index = index + 1; };
    let mut progress = 0;
    let mut signalled = false;
    let mut initial_written = -1;
    let mut progress_signalled = false;
    while not stdio.eof { let request = stdio.next()?; if request.root().object_has("method") { let action = server.accept(&request)?; if sgmcp_string(action.root(), "kind").as_str() == "call" { active.root().object_set("id", active.copy(action.root().object_get("id")?)?)?; (); }; }; if active.root().object_has("id") { if initial_written < 0 { initial_written = stdio.writer.snapshot()?.written_bytes; }; if server.cancelled(active.root().object_get("id")?)? { if not stdio.cancel(3000)? { return sgmcp_error(11); }; io_stderr_write("cancel-observed-and-joined\n")?; return sgmcp_ok(); }; if server.outgoing.len() < 2 { progress = progress + 1; server.progress(active.root().object_get("id")?, progress, 1000000, message.as_str())?; (); }; }; let flushed = stdio.flush(&server); if not flushed.is_ok() { if not deadline_case or flushed.error != 11 { return sgmcp_error(flushed.error); }; if not stdio.cancel(3000)? { return sgmcp_error(11); }; io_stderr_write("original-deadline-observed-and-joined\n")?; return sgmcp_ok(); }; let status = stdio.writer.snapshot()?; if stdio.outgoing.used_len() > 0 and status.in_flight_bytes > 0 and status.queued_bytes + status.in_flight_bytes == status.capacity_bytes and not signalled { io_stderr_write("output-backpressure-observed\n")?; signalled = true; }; if deadline_case and signalled and initial_written >= 0 and status.written_bytes > initial_written and not progress_signalled { io_stderr_write("output-progress-within-deadline\n")?; progress_signalled = true; }; if server.outgoing.len() > 2 or stdio.outgoing.used_len() > 1048577 { return sgmcp_error(13); }; time_sleep_ms(1); };
    sgmcp_error(12);
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let documents = sengoo_json_bounded_live_documents();
    let writers = io_writer_resource_count(0);
    let workers = io_writer_resource_count(1);
    let handles = io_writer_resource_count(2);
    let capacity = io_writer_resource_count(5);
    let result = serve();
    if not result.is_ok() { io_stderr_write("backpressure-server-failed\n"); return 1; };
    if sengoo_string_live_handle_count() != strings or sengoo_buffer_live_handle_count() != buffers or sengoo_json_bounded_live_documents() != documents { io_stderr_write("protocol-resources-leaked\n"); return 2; };
    if io_writer_resource_count(0) != writers or io_writer_resource_count(1) != workers or io_writer_resource_count(2) != handles or io_writer_resource_count(3) != 0 or io_writer_resource_count(4) != 0 or io_writer_resource_count(5) != capacity { io_stderr_write("writer-resources-leaked\n"); return 3; };
    io_stderr_write("protocol-resources-at-baseline\n");
    0;
}
