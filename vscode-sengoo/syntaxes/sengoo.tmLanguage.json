{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sengoo",
  "scopeName": "source.sengoo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sengoo",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sengoo",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.sengoo",
          "match": "r\"[^\"]*\""
        },
        {
          "name": "string.quoted.double.bytes.sengoo",
          "match": "b\"[^\"]*\""
        },
        {
          "name": "string.quoted.double.sengoo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sengoo",
              "match": "\\\\(n|t|r|0|\\\\|\"|'|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        },
        {
          "name": "string.quoted.single.sengoo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sengoo",
              "match": "\\\\(n|t|r|0|\\\\|'|\")"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sengoo",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.sengoo",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.sengoo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.sengoo",
          "match": "\\b(if|elif|else|match|case|default|for|while|loop|break|continue|return|yield|await|in)\\b"
        },
        {
          "name": "keyword.control.exception.sengoo",
          "match": "\\b(try|except|finally|raise|throw)\\b"
        },
        {
          "name": "storage.type.sengoo",
          "match": "\\b(def|fn|struct|class|enum|impl|trait|type)\\b"
        },
        {
          "name": "storage.modifier.sengoo",
          "match": "\\b(let|const|static|mut|pub|priv|async|parallel|export)\\b"
        },
        {
          "name": "keyword.other.sengoo",
          "match": "\\b(import|from|as|where|pass)\\b"
        },
        {
          "name": "constant.language.boolean.sengoo",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.sengoo",
          "match": "\\b(none|null)\\b"
        },
        {
          "name": "variable.language.self.sengoo",
          "match": "\\b(self|Self)\\b"
        },
        {
          "name": "keyword.operator.logical.sengoo",
          "match": "\\b(and|or|not|is|in)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.sengoo",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str|char|void)\\b"
        },
        {
          "name": "entity.name.type.sengoo",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.sengoo",
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "storage.type.function.sengoo" },
            "2": { "name": "entity.name.function.sengoo" }
          }
        },
        {
          "name": "meta.function.call.sengoo",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.sengoo" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.sengoo",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.comparison.sengoo",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.compound.sengoo",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.assignment.sengoo",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.sengoo",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.sengoo",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.sengoo",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.range.sengoo",
          "match": "(\\.\\.\\.|\\.\\.|::)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.sengoo",
          "match": "[;,]"
        },
        {
          "name": "punctuation.accessor.sengoo",
          "match": "\\."
        },
        {
          "name": "punctuation.section.braces.begin.sengoo",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.sengoo",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.sengoo",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.sengoo",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.sengoo",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.sengoo",
          "match": "\\)"
        },
        {
          "name": "punctuation.definition.closure.sengoo",
          "match": "\\|"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.sengoo",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
