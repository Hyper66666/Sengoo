extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_env_var_len(name: i64) -> i64;
    fn sengoo_env_var_copy(name: i64, out_buffer: i64, out_capacity: i64) -> i64;
    fn sengoo_env_is_windows() -> i64;
    fn sengoo_env_is_unix() -> i64;
}

def env_var_len_raw(name_ptr: i64) -> Result<i64, i64> {
    let len = sengoo_env_var_len(name_ptr);
    if len >= 0 {
        Ok(len)
    } else {
        Err(status_from_raw_ffi(len))
    }
}

def env_var_len(name: &str) -> Result<i64, i64> {
    env_var_len_raw(sengoo_stdlib_str_ptr(name))
}

def env_var_copy_raw(name_ptr: i64, buffer_ptr: i64, capacity: i64) -> Result<i64, i64> {
    let copied = sengoo_env_var_copy(name_ptr, buffer_ptr, capacity);
    if copied >= 0 {
        Ok(copied)
    } else {
        Err(status_from_raw_ffi(copied))
    }
}

def env_var_copy(name: &str, buffer: Buffer) -> Result<i64, i64> {
    env_var_copy_raw(sengoo_stdlib_str_ptr(name), buffer.ptr(), buffer.len())
}

def env_has_var(name: &str) -> bool {
    env_var_len(name).is_ok()
}

def env_is_windows() -> bool {
    sengoo_env_is_windows() != 0
}

def env_is_unix() -> bool {
    sengoo_env_is_unix() != 0
}

def env_exit_code(success: bool, failure_code: i64) -> i64 {
    if success {
        0
    } else {
        failure_code
    }
}
