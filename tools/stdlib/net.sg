    let handle = sengoo_udp_bind(host_ptr, port);
    if handle != 0 {
        Result { is_ok: true, value: UdpSocket { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: UdpSocket { handle: 0 }, error: net_last_status() }
