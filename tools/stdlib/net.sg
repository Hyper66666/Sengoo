impl UdpSocket {
    def connect_raw(self, host_ptr: i64, port: i64) -> Result<bool, i64> {
        let status = sengoo_udp_connect(self.handle, host_ptr, port);
        if status != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    def connect(self, host: &str, port: i64) -> Result<bool, i64> {
        self.connect_raw(sengoo_stdlib_str_ptr(host), port)
    }

    def send_raw(self, data_ptr: i64, len: i64) -> Result<i64, i64> {
        let sent = sengoo_udp_send(self.handle, data_ptr, len);
        if sent >= 0 {
            Result { is_ok: true, value: sent, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def send(self, data: &str) -> Result<i64, i64> {
        self.send_raw(sengoo_stdlib_str_ptr(data), data.len())
    }

    def recv_raw(self, buffer_ptr: i64, capacity: i64, timeout_ms: i64) -> Result<i64, i64> {
        let received = sengoo_udp_recv(self.handle, buffer_ptr, capacity, timeout_ms);
        if received >= 0 {
            Result { is_ok: true, value: received, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def recv(self, buffer: Buffer, timeout_ms: i64) -> Result<i64, i64> {
        self.recv_raw(buffer.ptr(), buffer.len(), timeout_ms)
    }

    def close(self) -> bool {
        sengoo_udp_close(self.handle) != 0
    }
}

impl Drop for UdpSocket {
    def drop(&mut self) {
        sengoo_udp_close(self.handle);
    }
}

