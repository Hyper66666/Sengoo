    fn sengoo_http_close(handle: i64) -> i64;
    fn sengoo_http_server_bind(host: i64, port: i64) -> i64;
    fn sengoo_http_server_local_port(handle: i64) -> i64;
    fn sengoo_http_server_set_limits(handle: i64, max_header_bytes: i64, max_body_bytes: i64) -> i64;
    fn sengoo_http_server_add_route(handle: i64, method: i64, path_pattern: i64, status: i64, body: i64, body_len: i64) -> i64;
    fn sengoo_http_server_add_middleware_require_header(handle: i64, name: i64, expected_value: i64, reject_status: i64, reject_body: i64, reject_body_len: i64) -> i64;
