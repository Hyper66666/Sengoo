}

def http_server_bind(host: &str, port: i64) -> Result<HttpServer, i64> {
    http_server_bind_raw(sengoo_stdlib_str_ptr(host), port)
}

impl HttpServer {
    def local_port(self) -> Result<i64, i64> {
        let port = sengoo_http_server_local_port(self.handle);
        if port >= 0 {
            Result { is_ok: true, value: port, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def set_limits(self, max_header_bytes: i64, max_body_bytes: i64) -> Result<bool, i64> {
        let status = sengoo_http_server_set_limits(self.handle, max_header_bytes, max_body_bytes);
        if status != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    def add_route_raw(self, method_ptr: i64, path_pattern_ptr: i64, status: i64, body_ptr: i64, body_len: i64) -> Result<bool, i64> {
        let added = sengoo_http_server_add_route(self.handle, method_ptr, path_pattern_ptr, status, body_ptr, body_len);
        if added != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    def add_route(self, method: &str, path_pattern: &str, status: i64, body: &str) -> Result<bool, i64> {
        self.add_route_raw(sengoo_stdlib_str_ptr(method), sengoo_stdlib_str_ptr(path_pattern), status, sengoo_stdlib_str_ptr(body), body.len())
    }

    def require_header_raw(self, name_ptr: i64, expected_value_ptr: i64, reject_status: i64, reject_body_ptr: i64, reject_body_len: i64) -> Result<bool, i64> {
        let added = sengoo_http_server_add_middleware_require_header(self.handle, name_ptr, expected_value_ptr, reject_status, reject_body_ptr, reject_body_len);
        if added != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    def require_header(self, name: &str, expected_value: &str, reject_status: i64, reject_body: &str) -> Result<bool, i64> {
        self.require_header_raw(sengoo_stdlib_str_ptr(name), sengoo_stdlib_str_ptr(expected_value), reject_status, sengoo_stdlib_str_ptr(reject_body), reject_body.len())
    }

    def add_ws_echo_route_raw(self, path_pattern_ptr: i64) -> Result<bool, i64> {
        let added = sengoo_http_server_add_ws_echo_route(self.handle, path_pattern_ptr);
        if added != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    def add_ws_echo_route(self, path_pattern: &str) -> Result<bool, i64> {
        self.add_ws_echo_route_raw(sengoo_stdlib_str_ptr(path_pattern))
    }

    def serve_once(self, timeout_ms: i64) -> Result<bool, i64> {
        let served = sengoo_http_server_serve_once(self.handle, timeout_ms);
        if served > 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else if served == 0 {
            Result { is_ok: true, value: false, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    // Pull the next dynamic request. Static routes, ws-echo routes, and
    // require-header middleware are answered inline before anything surfaces
    // here; timeout expiry maps to STATUS_TIMEOUT.
    def next_request(self, timeout_ms: i64) -> Result<HttpServerRequest, i64> {
        let handle = sengoo_http_server_next_request(self.handle, timeout_ms);
        if handle != 0 {
            Result { is_ok: true, value: HttpServerRequest { handle: handle }, error: 0 }
        } else {
            Result { is_ok: false, value: HttpServerRequest { handle: 0 }, error: net_last_status() }
        }
    }

    def next_request_async(self, timeout_ms: i64) -> Future<HttpServerNextRequestOutcome> {
        sengoo_http_server_next_request_async__start(self.handle, timeout_ms)
    }

    def next_request_router_async(self, timeout_ms: i64) -> Future<HttpServerNextRequestOutcome> {
        sengoo_http_server_next_request_router_async__start(self.handle, timeout_ms)
    }

    def close(self) -> bool {
        sengoo_http_server_close(self.handle) != 0
    }

    def claim_serve_mode(self, mode: i64) -> Result<bool, i64> {
        let status = sengoo_http_server_claim_serve_mode(self.handle, mode);
        if status != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }
}

impl Drop for HttpServer {
    def drop(&mut self) {
        sengoo_http_server_close(self.handle);
    }
}

def http_request_i64_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: net_last_status() }
    }
}

impl HttpServerRequest {
    def method_len(self) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_method_len(self.handle))
    }

    def method_copy(self, buffer: Buffer) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_method_copy(self.handle, buffer.ptr(), buffer.len()))
    }

    def method_string(self) -> Result<String, i64> {
        let len = sengoo_http_request_method_len(self.handle);
        if len < 0 {
            Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
        } else {
            let buffer_result = ffi_buffer_new(len + 1);
            if buffer_result.is_ok {
                let buffer = buffer_result.value;
                let copied = sengoo_http_request_method_copy(self.handle, buffer.ptr(), buffer.len());
                if copied >= 0 {
                    let owned = string_from_bytes_raw(buffer.ptr(), copied);
                    buffer.free();
                    owned
                } else {
                    buffer.free();
                    Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
                }
            } else {
                Result { is_ok: false, value: String { handle: 0 }, error: buffer_result.error }
            }
        }
    }

    def path_len(self) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_path_len(self.handle))
    }

    def path_copy(self, buffer: Buffer) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_path_copy(self.handle, buffer.ptr(), buffer.len()))
    }

    def path_string(self) -> Result<String, i64> {
        let len = sengoo_http_request_path_len(self.handle);
        if len < 0 {
            Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
        } else {
            let buffer_result = ffi_buffer_new(len + 1);
            if buffer_result.is_ok {
                let buffer = buffer_result.value;
                let copied = sengoo_http_request_path_copy(self.handle, buffer.ptr(), buffer.len());
                if copied >= 0 {
                    let owned = string_from_bytes_raw(buffer.ptr(), copied);
                    buffer.free();
                    owned
                } else {
                    buffer.free();
                    Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
                }
            } else {
                Result { is_ok: false, value: String { handle: 0 }, error: buffer_result.error }
            }
        }
    }

    def query_len(self) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_query_len(self.handle))
    }

    def query_copy(self, buffer: Buffer) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_query_copy(self.handle, buffer.ptr(), buffer.len()))
    }

    def query_string(self) -> Result<String, i64> {
        let len = sengoo_http_request_query_len(self.handle);
        if len < 0 {
            Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
        } else {
            let buffer_result = ffi_buffer_new(len + 1);
            if buffer_result.is_ok {
                let buffer = buffer_result.value;
                let copied = sengoo_http_request_query_copy(self.handle, buffer.ptr(), buffer.len());
                if copied >= 0 {
                    let owned = string_from_bytes_raw(buffer.ptr(), copied);
                    buffer.free();
                    owned
                } else {
                    buffer.free();
                    Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
                }
            } else {
                Result { is_ok: false, value: String { handle: 0 }, error: buffer_result.error }
            }
        }
    }

    def version_len(self) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_version_len(self.handle))
    }

    def version_copy(self, buffer: Buffer) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_version_copy(self.handle, buffer.ptr(), buffer.len()))
    }

    def version_string(self) -> Result<String, i64> {
        let len = sengoo_http_request_version_len(self.handle);
        if len < 0 {
            Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
        } else {
            let buffer_result = ffi_buffer_new(len + 1);
            if buffer_result.is_ok {
                let buffer = buffer_result.value;
                let copied = sengoo_http_request_version_copy(self.handle, buffer.ptr(), buffer.len());
                if copied >= 0 {
                    let owned = string_from_bytes_raw(buffer.ptr(), copied);
                    buffer.free();
                    owned
                } else {
                    buffer.free();
                    Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
                }
            } else {
                Result { is_ok: false, value: String { handle: 0 }, error: buffer_result.error }
            }
        }
    }

    // Absent headers map to STATUS_NOT_FOUND; an empty value is Ok with len 0.
    def header_len(self, name: &str) -> Result<i64, i64> {
        let len = sengoo_http_request_header_len(self.handle, sengoo_stdlib_str_ptr(name));
        if len >= 0 {
            Result { is_ok: true, value: len, error: 0 }
        } else if net_last_error() == 0 {
            Result { is_ok: false, value: 0, error: STATUS_NOT_FOUND() }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def header_copy(self, name: &str, buffer: Buffer) -> Result<i64, i64> {
        let copied = sengoo_http_request_header_copy(self.handle, sengoo_stdlib_str_ptr(name), buffer.ptr(), buffer.len());
        if copied >= 0 {
            Result { is_ok: true, value: copied, error: 0 }
        } else if net_last_error() == 0 {
            Result { is_ok: false, value: 0, error: STATUS_NOT_FOUND() }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def header_string(self, name: &str) -> Result<String, i64> {
        let len = sengoo_http_request_header_len(self.handle, sengoo_stdlib_str_ptr(name));
        if len < 0 {
            if net_last_error() == 0 {
                Result { is_ok: false, value: String { handle: 0 }, error: STATUS_NOT_FOUND() }
            } else {
                Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
            }
        } else {
            let buffer_result = ffi_buffer_new(len + 1);
            if buffer_result.is_ok {
                let buffer = buffer_result.value;
                let copied = sengoo_http_request_header_copy(self.handle, sengoo_stdlib_str_ptr(name), buffer.ptr(), buffer.len());
                if copied >= 0 {
                    let owned = string_from_bytes_raw(buffer.ptr(), copied);
                    buffer.free();
                    owned
                } else {
                    buffer.free();
                    Result { is_ok: false, value: String { handle: 0 }, error: net_last_status() }
                }
            } else {
                Result { is_ok: false, value: String { handle: 0 }, error: buffer_result.error }
            }
        }
    }

    def body_len(self) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_body_len(self.handle))
    }

    def body_copy(self, buffer: Buffer) -> Result<i64, i64> {
        http_request_i64_result(sengoo_http_request_body_copy(self.handle, buffer.ptr(), buffer.len()))
    }

    // Answers the request exactly once: writes the response, closes the
    // connection, and invalidates this handle.
    def respond(self, status: i64, body: &str) -> Result<bool, i64> {
        let written = sengoo_http_request_respond(self.handle, status, sengoo_stdlib_str_ptr(body), body.len());
        if written != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    def respond_with_content_type(self, status: i64, content_type: &str, body: &str) -> Result<bool, i64> {
        let written = sengoo_http_request_respond_with_content_type(
            self.handle,
            status,
            sengoo_stdlib_str_ptr(content_type),
            sengoo_stdlib_str_ptr(body),
            body.len()
        );
        if written != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    def respond_raw(self, status: i64, body_ptr: i64, body_len: i64) -> Result<bool, i64> {
        let written = sengoo_http_request_respond(self.handle, status, body_ptr, body_len);
        if written != 0 {
            Result { is_ok: true, value: true, error: 0 }
        } else {
            Result { is_ok: false, value: false, error: net_last_status() }
        }
    }

    // Closing an unanswered request first writes a deterministic 504 fallback.
    def close(self) -> bool {
        sengoo_http_request_close(self.handle) != 0
    }
}

impl Drop for HttpServerRequest {
    def drop(&mut self) {
        sengoo_http_request_close(self.handle);
    }
}

def ws_connect_raw(url_ptr: i64, timeout_ms: i64) -> Result<WsClient, i64> {
    let handle = sengoo_ws_connect(url_ptr, timeout_ms);
    if handle != 0 {
        Result { is_ok: true, value: WsClient { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: WsClient { handle: 0 }, error: net_last_status() }
    }
}

def ws_connect(url: &str, timeout_ms: i64) -> Result<WsClient, i64> {
    ws_connect_raw(sengoo_stdlib_str_ptr(url), timeout_ms)
}

impl WsClient {
    def send_text_raw(self, data_ptr: i64, len: i64) -> Result<i64, i64> {
        let sent = sengoo_ws_send_text(self.handle, data_ptr, len);
        if sent >= 0 {
            Result { is_ok: true, value: sent, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def send_text(self, data: &str) -> Result<i64, i64> {
        self.send_text_raw(sengoo_stdlib_str_ptr(data), data.len())
    }

    def recv_text_raw(self, buffer_ptr: i64, capacity: i64, timeout_ms: i64) -> Result<i64, i64> {
        let received = sengoo_ws_recv_text(self.handle, buffer_ptr, capacity, timeout_ms);
        if received >= 0 {
            Result { is_ok: true, value: received, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def recv_text(self, buffer: Buffer, timeout_ms: i64) -> Result<i64, i64> {
        self.recv_text_raw(buffer.ptr(), buffer.len(), timeout_ms)
    }

    def close(self) -> bool {
        sengoo_ws_close(self.handle) != 0
    }
}

impl Drop for WsClient {
    def drop(&mut self) {
        sengoo_ws_close(self.handle);
    }
}

def net_bench_last_error_code() -> i64 {
    sengoo_net_bench_last_error_code()
}

def net_bench_last_error_len() -> i64 {
    sengoo_net_bench_last_error_len()
}

def net_bench_last_error_copy_raw(buffer_ptr: i64, capacity: i64) -> Result<i64, i64> {
    let copied = sengoo_net_bench_last_error_copy(buffer_ptr, capacity);
    if copied >= 0 {
        Result { is_ok: true, value: copied, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: net_bench_last_status() }
    }
}

def net_bench_last_error_copy(buffer: Buffer) -> Result<i64, i64> {
    net_bench_last_error_copy_raw(buffer.ptr(), buffer.len())
}

def net_bench_last_error_clear() -> bool {
    sengoo_net_bench_last_error_clear() == 0
}

def net_bench_last_status() -> i64 {
    status_from_net_bench_error(sengoo_net_bench_last_error_code())
}

def net_bench_run_raw(connections: i64, rtt_messages_per_connection: i64, broadcast_rounds: i64, payload_bytes: i64, report_buffer: i64, report_capacity: i64) -> Result<i64, i64> {
    let copied = sengoo_net_bench_run(connections, rtt_messages_per_connection, broadcast_rounds, payload_bytes, report_buffer, report_capacity);
    if copied >= 0 {
        Result { is_ok: true, value: copied, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: net_bench_last_status() }
    }
}

def net_bench_run(connections: i64, rtt_messages_per_connection: i64, broadcast_rounds: i64, payload_bytes: i64, report: Buffer) -> Result<i64, i64> {
    net_bench_run_raw(connections, rtt_messages_per_connection, broadcast_rounds, payload_bytes, report.ptr(), report.len())
}

def HTTP_SERVER_MODE_PULL() -> i64 { 1 }
def HTTP_SERVER_MODE_ROUTER() -> i64 { 2 }

// Handler returns 1=answered, 0=not answered (500), negative=error.
// Design: fn(&mut HttpServerRequest) -> Result<bool, i64>; i64 form is the
// concrete stdlib encoding until fn-returning-Result is broadly supported.
struct HttpRouter {
    count: i64,
    r0_used: bool,
    r0_method: String,
    r0_path: String,
    r0_handler: fn(HttpServerRequest) -> i64,
    r1_used: bool,
    r1_method: String,
    r1_path: String,
    r1_handler: fn(HttpServerRequest) -> i64,
    r2_used: bool,
    r2_method: String,
    r2_path: String,
    r2_handler: fn(HttpServerRequest) -> i64,
    r3_used: bool,
    r3_method: String,
    r3_path: String,
    r3_handler: fn(HttpServerRequest) -> i64,
    has_default: bool,
    default_handler: fn(HttpServerRequest) -> i64,
}

def http_router_noop_handler(request: HttpServerRequest) -> i64 { 0 }

def http_router_new() -> HttpRouter {
    HttpRouter {
        count: 0,
        r0_used: false,
        r0_method: String { handle: 0 },
        r0_path: String { handle: 0 },
        r0_handler: http_router_noop_handler,
        r1_used: false,
        r1_method: String { handle: 0 },
        r1_path: String { handle: 0 },
        r1_handler: http_router_noop_handler,
        r2_used: false,
        r2_method: String { handle: 0 },
        r2_path: String { handle: 0 },
        r2_handler: http_router_noop_handler,
        r3_used: false,
        r3_method: String { handle: 0 },
        r3_path: String { handle: 0 },
        r3_handler: http_router_noop_handler,
        has_default: false,
        default_handler: http_router_noop_handler,
    }
}

def http_router_route(
    router: HttpRouter,
    method: &str,
    path: &str,
    handler: fn(HttpServerRequest) -> i64,
) -> Result<HttpRouter, i64> {
    let mut out = router;
    if !out.r0_used {
        out.r0_used = true;
        out.r0_method = string_from_str(method).unwrap_or(String { handle: 0 });
        out.r0_path = string_from_str(path).unwrap_or(String { handle: 0 });
        out.r0_handler = handler;
        out.count = out.count + 1;
        Result { is_ok: true, value: out, error: 0 }
    } else if !out.r1_used {
        out.r1_used = true;
        out.r1_method = string_from_str(method).unwrap_or(String { handle: 0 });
        out.r1_path = string_from_str(path).unwrap_or(String { handle: 0 });
        out.r1_handler = handler;
        out.count = out.count + 1;
        Result { is_ok: true, value: out, error: 0 }
    } else if !out.r2_used {
        out.r2_used = true;
        out.r2_method = string_from_str(method).unwrap_or(String { handle: 0 });
        out.r2_path = string_from_str(path).unwrap_or(String { handle: 0 });
        out.r2_handler = handler;
        out.count = out.count + 1;
        Result { is_ok: true, value: out, error: 0 }
    } else if !out.r3_used {
        out.r3_used = true;
        out.r3_method = string_from_str(method).unwrap_or(String { handle: 0 });
        out.r3_path = string_from_str(path).unwrap_or(String { handle: 0 });
        out.r3_handler = handler;
        out.count = out.count + 1;
        Result { is_ok: true, value: out, error: 0 }
    } else {
        Result { is_ok: false, value: out, error: STATUS_BUFFER_TOO_SMALL() }
    }
}

def http_router_default(
    router: HttpRouter,
    handler: fn(HttpServerRequest) -> i64,
) -> Result<HttpRouter, i64> {
    let mut out = router;
    if out.has_default {
        Result { is_ok: false, value: out, error: STATUS_ALREADY_EXISTS() }
    } else {
        out.has_default = true;
        out.default_handler = handler;
        Result { is_ok: true, value: out, error: 0 }
    }
}

def http_router_match_handles(
    used: bool,
    route_method_handle: i64,
    route_path_handle: i64,
    req_method_handle: i64,
    req_path_handle: i64,
) -> bool {
    if !used {
        false
    } else {
        sengoo_string_eq(route_method_handle, req_method_handle) != 0
            and sengoo_string_eq(route_path_handle, req_path_handle) != 0
    }
}

def http_server_next_request_router(server: HttpServer, timeout_ms: i64) -> Result<HttpServerRequest, i64> {
    let handle = sengoo_http_server_next_request_router(server.handle, timeout_ms);
    if handle != 0 {
        Result { is_ok: true, value: HttpServerRequest { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: HttpServerRequest { handle: 0 }, error: net_last_status() }
    }
}

/// Dispatch one already-pulled request through `router` (exact method+path).
/// Unmatched → 404; handler return != 1 and unanswered → 500.
/// Returns the router so callers can rebuild-free multi-request loops.
/// Prefer this after `await server.next_request_async_router(...)` so fn-bearing
/// routers never cross async frame await points (rebuild in a sync helper instead).
def http_router_dispatch(router: HttpRouter, request: HttpServerRequest) -> HttpRouter {
    let method_r = request.method_string();
    let path_r = request.path_string();
    if !method_r.is_ok or !path_r.is_ok {
        let ignored = request.respond(500, "internal error");
        router
    } else {
        let method = method_r.value;
        let path = path_r.value;
        let mut handler_ok = false;
        let mut matched = false;
        if http_router_match_handles(router.r0_used, router.r0_method.handle, router.r0_path.handle, method.handle, path.handle) {
            let h0 = router.r0_handler; handler_ok = h0(request) == 1;
            matched = true;
        } else if http_router_match_handles(router.r1_used, router.r1_method.handle, router.r1_path.handle, method.handle, path.handle) {
            let h1 = router.r1_handler; handler_ok = h1(request) == 1;
            matched = true;
        } else if http_router_match_handles(router.r2_used, router.r2_method.handle, router.r2_path.handle, method.handle, path.handle) {
            let h2 = router.r2_handler; handler_ok = h2(request) == 1;
            matched = true;
        } else if http_router_match_handles(router.r3_used, router.r3_method.handle, router.r3_path.handle, method.handle, path.handle) {
            let h3 = router.r3_handler; handler_ok = h3(request) == 1;
            matched = true;
        } else if router.has_default {
            let hd = router.default_handler; handler_ok = hd(request) == 1;
            matched = true;
        } else {
            let ignored = request.respond(404, "not found");
            matched = true;
            handler_ok = true;
        }
        if matched and !handler_ok {
            let ignored = request.respond(500, "handler error");
        }
        router
    }
}

/// Serve one request under router mode (blocking pull). Returns the router on
/// both success and error so multi-request hosts can loop without rebuilding.
/// `is_ok` means one request was dispatched; timeout/mode/pull failures are
/// `is_ok=false` with the router still returned.
/// Note: blocking pull does not yield the cooperative scheduler — async hosts
/// should `claim_serve_mode(ROUTER)`, `await next_request_router_async`, then
/// `http_router_dispatch` from a sync helper that rebuilds the router.
def serve_http_once(server: HttpServer, router: HttpRouter, timeout_ms: i64) -> Result<HttpRouter, i64> {
    let claimed = server.claim_serve_mode(HTTP_SERVER_MODE_ROUTER());
    if !claimed.is_ok {
        Result { is_ok: false, value: router, error: claimed.error }
    } else {
        let pull = http_server_next_request_router(server, timeout_ms);
        if !pull.is_ok {
            Result { is_ok: false, value: router, error: pull.error }
        } else {
            let out = http_router_dispatch(router, pull.value);
            Result { is_ok: true, value: out, error: 0 }
        }
    }
}

/// Serve one request under router mode (blocking). Call in a loop for
/// multi-request hosts. Returns the router for reuse (see `serve_http_once`).
def serve_http(server: HttpServer, router: HttpRouter, timeout_ms: i64) -> Result<HttpRouter, i64> {
    serve_http_once(server, router, timeout_ms)
}


