struct TcpStream {
    handle: i64,
}

struct UdpSocket {
    handle: i64,
}

struct HttpClient {
    handle: i64,
}

struct HttpServer {
    handle: i64,
}

struct HttpServerRequest {
    handle: i64,
}

struct WsClient {
    handle: i64,
}

def net_last_error() -> i64 {
    sengoo_net_last_error()
}

def net_last_status() -> i64 {
    status_from_net_error(sengoo_net_last_error())
}

def net_clear_error() -> bool {
    sengoo_net_clear_error();
    true
}

def net_error_name_copy_raw(code: i64, buffer_ptr: i64, capacity: i64) -> Result<i64, i64> {
    let copied = sengoo_net_error_name_copy(code, buffer_ptr, capacity);
    if copied >= 0 {
        Result { is_ok: true, value: copied, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: net_last_status() }
    }
}

def net_error_name_copy(code: i64, buffer: Buffer) -> Result<i64, i64> {
    net_error_name_copy_raw(code, buffer.ptr(), buffer.len())
}

def net_tcp_connect_raw(host_ptr: i64, port: i64, timeout_ms: i64) -> Result<TcpStream, i64> {
    let handle = sengoo_tcp_connect(host_ptr, port, timeout_ms);
    if handle != 0 {
        Result { is_ok: true, value: TcpStream { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: TcpStream { handle: 0 }, error: net_last_status() }
    }
}

def net_tcp_connect(host: &str, port: i64, timeout_ms: i64) -> Result<TcpStream, i64> {
    net_tcp_connect_raw(sengoo_stdlib_str_ptr(host), port, timeout_ms)
}

impl TcpStream {
    def close(self) -> bool {
        sengoo_tcp_close(self.handle) != 0
    }

    def send_raw(self, data_ptr: i64, len: i64) -> Result<i64, i64> {
        let sent = sengoo_tcp_send(self.handle, data_ptr, len);
        if sent >= 0 {
            Result { is_ok: true, value: sent, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def send(self, data: &str) -> Result<i64, i64> {
        self.send_raw(sengoo_stdlib_str_ptr(data), data.len())
    }

    def recv_raw(self, buffer_ptr: i64, capacity: i64, timeout_ms: i64) -> Result<i64, i64> {
        let received = sengoo_tcp_recv(self.handle, buffer_ptr, capacity, timeout_ms);
        if received >= 0 {
            Result { is_ok: true, value: received, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: net_last_status() }
        }
    }

    def recv(self, buffer: Buffer, timeout_ms: i64) -> Result<i64, i64> {
        self.recv_raw(buffer.ptr(), buffer.len(), timeout_ms)
    }
}

