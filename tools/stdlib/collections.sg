            }
        }
        result
    }
}

impl<I: Iterator, T> Iterator for TakeIter<I, T> {
    type Item = T;

    def next(&self) -> Option<T> {
        let count = raw_vec_get_or_default_i64(self.remaining.handle, 0, 0);
        if count <= 0 {
            __sengoo_option_none()
        } else {
            raw_vec_set(self.remaining.handle, 0, count - 1);
            self.inner.next()
        }
    }
}

