impl StringMapKeyIter {
    def done(self) -> bool {
        sengoo_raw_map_key_iter_done(self.handle) != 0
    }

    def next(self) -> Result<String, i64> {
        let item: Option<&String> = raw_map_key_iter_next(self.handle);
        if item.is_some {
            collections_string_result(sengoo_string_clone_status((*item.value).handle))
        } else {
            Result { is_ok: false, value: String { handle: 0 }, error: 1 }
        }
    }

    def next_copy(self, buffer: Buffer) -> Result<i64, i64> {
        let item: Option<&String> = raw_map_key_iter_next(self.handle);
        if item.is_some {
            collections_copy_result(sengoo_string_copy_to_buffer((*item.value).handle, buffer.handle))
        } else {
            Result { is_ok: false, value: 0, error: 1 }
        }
    }

    def count(self) -> i64 {
        let mut total = 0;
        while !self.done() {
            let next_value = self.next();
            if next_value.is_ok {
                total = total + 1;
            }
        }
        total
    }

    def skip(self, n: i64) -> StringMapKeyIter {
        let mut skipped = 0;
        while skipped < n && !self.done() {
            let _next_value = self.next();
            skipped = skipped + 1;
        }
        self
    }

    def take(self, n: i64) -> Vec<String> {
        let taken = vec_new_string();
        let mut total = 0;
        while total < n && !self.done() {
            let next_value = self.next();
            if next_value.is_ok {
                taken.push(next_value.value);
                total = total + 1;
            }
        }
        taken
    }

    def collect(self) -> Vec<String> {
        let collected = vec_new_string();
        while !self.done() {
            let next_value = self.next();
            if next_value.is_ok {
                collected.push(next_value.value);
            }
        }
        collected
    }

    def enumerate(self) -> EnumerateStringMapKeyIter {
        EnumerateStringMapKeyIter { iter: self }
    }

    def reset(self) -> bool {
        sengoo_raw_map_key_iter_reset(self.handle) == 0
    }

    def free(self) -> bool {
        sengoo_raw_map_key_iter_free(self.handle) == 0
    }
}

impl EnumerateStringMapKeyIter {
    def next(self) -> Option<EnumeratedString> {
        if sengoo_raw_map_key_iter_done(self.iter.handle) != 0 {
            option_none_with(EnumeratedString { index: 0, value: String { handle: 0 } })
        } else {
            let current = sengoo_raw_map_key_iter_index(self.iter.handle);
            let item: Option<&String> = raw_map_key_iter_next(self.iter.handle);
            if item.is_some {
                let value = sengoo_string_clone_status((*item.value).handle);
                option_some(EnumeratedString { index: current, value: String { handle: value } })
            } else {
                option_none_with(EnumeratedString { index: 0, value: String { handle: 0 } })
            }
        }
    }
}

def collections_string_result(value: i64) -> Result<String, i64> {
    if value >= 0 {
        Result { is_ok: true, value: String { handle: value }, error: 0 }
    } else {
        Result { is_ok: false, value: String { handle: 0 }, error: 0 - value }
    }
}

impl Vec<String> {
    def len(&self) -> i64 {
        sengoo_raw_vec_len(self.handle)
    }

    def clear(&self) -> bool {
        sengoo_raw_vec_clear(self.handle) == 0
    }

    def is_empty(&self) -> bool {
        self.len() == 0
    }

    def free(&self) -> bool {
        sengoo_raw_vec_free(self.handle) == 0
    }

    def push(&self, value: String) -> bool {
        raw_vec_push(self.handle, value)
    }

    def get(&self, index: i64) -> Result<String, i64> {
        if index < 0 || index >= self.len() {
            Result { is_ok: false, value: String { handle: 0 }, error: 1 }
        } else {
            let value: &String = raw_vec_get(self.handle, index);
            collections_string_result(sengoo_string_clone_status((*value).handle))
        }
    }

    def set(&self, index: i64, value: String) -> bool {
        raw_vec_set(self.handle, index, value)
    }

    def insert(&self, index: i64, value: String) -> bool {
        raw_vec_insert(self.handle, index, value)
    }

    def remove(&self, index: i64) -> Result<String, i64> {
        if index < 0 || index >= self.len() {
            Result { is_ok: false, value: String { handle: 0 }, error: 1 }
        } else {
            collections_string_result(sengoo_raw_vec_remove_string(self.handle, index))
        }
    }

    def iter(&self) -> VecStringIter {
        VecStringIter { handle: sengoo_raw_vec_iter_new(self.handle) }
    }
}

