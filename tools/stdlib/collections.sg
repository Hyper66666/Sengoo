impl HashMapIter<bool> {
    def next(self) -> Option<bool> {
        if sengoo_hashmap_iter_done_i64(self.handle) != 0 {
            option_none_bool()
        } else {
            option_some_bool(i64_to_bool(sengoo_hashmap_iter_next_or_default_i64(self.handle, 0)))
        }
    }

    def map_with(self, f: fn(bool) -> bool) -> Option<bool> {
        if sengoo_hashmap_iter_done_i64(self.handle) != 0 {
            option_none_bool()
        } else {
            let value = i64_to_bool(sengoo_hashmap_iter_next_or_default_i64(self.handle, 0));
            option_some_bool(f(value))
        }
    }

    def filter_with(self, pred: fn(bool) -> bool) -> Option<bool> {
        let mut found = 0;
        let mut matched = false;
        while sengoo_hashmap_iter_done_i64(self.handle) == 0 {
            if found != 0 {
                break;
            }
            let value = i64_to_bool(sengoo_hashmap_iter_next_or_default_i64(self.handle, 0));
            if pred(value) {
                matched = value;
                found = 1;
            }
        }
        if found != 0 {
            option_some_bool(matched)
        } else {
            option_none_bool()
        }
    }

    def count(self) -> i64 {
        let mut total = 0;
        while sengoo_hashmap_iter_done_i64(self.handle) == 0 {
            let _value = sengoo_hashmap_iter_next_or_default_i64(self.handle, 0);
            total = total + 1;
        }
        total
    }

    def take(self, n: i64) -> Vec<bool> {
        let taken = vec_new_bool();
        let mut total = 0;
        while total < n && sengoo_hashmap_iter_done_i64(self.handle) == 0 {
            let value = i64_to_bool(sengoo_hashmap_iter_next_or_default_i64(self.handle, 0));
            taken.push(value);
            total = total + 1;
        }
        taken
    }

    def collect(self) -> Vec<bool> {
        let collected = vec_new_bool();
        while sengoo_hashmap_iter_done_i64(self.handle) == 0 {
            let value = i64_to_bool(sengoo_hashmap_iter_next_or_default_i64(self.handle, 0));
            collected.push(value);
        }
        collected
    }

    def skip(self, n: i64) -> HashMapIter<bool> {
        let mut skipped = 0;
        while skipped < n && sengoo_hashmap_iter_done_i64(self.handle) == 0 {
            let _value = sengoo_hashmap_iter_next_or_default_i64(self.handle, 0);
            skipped = skipped + 1;
        }
        self
    }

    def fold_with(self, initial: bool, f: fn(bool, bool) -> bool) -> bool {
        let mut acc = initial;
        while sengoo_hashmap_iter_done_i64(self.handle) == 0 {
            let value = i64_to_bool(sengoo_hashmap_iter_next_or_default_i64(self.handle, 0));
            acc = f(acc, value);
        }
        acc
    }

    def enumerate(self) -> EnumerateHashMapIterBool {
        EnumerateHashMapIterBool { iter: self }
    }
}

