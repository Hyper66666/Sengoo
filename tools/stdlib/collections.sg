        let taken = vec_new_string();
        let mut total = 0;
        while total < n && !self.done() {
            let next_value = self.next();
            if next_value.is_ok {
                taken.push(next_value.value);
                total = total + 1;
            }
        }
        taken
    }

    def reset(self) -> bool {
        sengoo_vec_string_iter_reset_status(self.handle) != 0
