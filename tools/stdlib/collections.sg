    type Item = T;

    def next(&self) -> Option<T> {
        let count = sengoo_vec_get_or_default_i64(self.remaining.handle, 0, 0);
        if count <= 0 {
            __sengoo_option_none()
        } else {
            sengoo_vec_set_i64(self.remaining.handle, 0, count - 1);
            self.inner.next()
        }
    }
}

