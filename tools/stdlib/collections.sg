impl<T> VecIter<T> {
    def reset(&self) -> bool {
        sengoo_raw_vec_iter_reset(self.handle) == 0
    }

    def free(&self) -> bool {
        sengoo_raw_vec_iter_free(self.handle) == 0
    }
}

impl VecIter<bool> {
    def next(self) -> Option<bool> {
        if sengoo_raw_vec_iter_done(self.handle) != 0 { option_none_bool() }
        else { option_some_bool(i64_to_bool(raw_vec_iter_next_bool_i64(self.handle, 0))) }
    }

    def map_with(self, f: fn(bool) -> bool) -> Option<bool> {
        if sengoo_raw_vec_iter_done(self.handle) != 0 {
            option_none_bool()
        } else {
            let value = i64_to_bool(raw_vec_iter_next_bool_i64(self.handle, 0));
            option_some_bool(f(value))
        }
    }

    def filter_with(self, pred: fn(bool) -> bool) -> Option<bool> {
        let mut found = 0;
        let mut matched = false;
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            if found != 0 {
                break;
            }
            let value = i64_to_bool(raw_vec_iter_next_bool_i64(self.handle, 0));
            if pred(value) {
                matched = value;
                found = 1;
            }
        }
        if found != 0 {
            option_some_bool(matched)
        } else {
            option_none_bool()
        }
    }

    def count(self) -> i64 {
        let mut total = 0;
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            let _value = raw_vec_iter_next_bool_i64(self.handle, 0);
            total = total + 1;
        }
        total
    }

    def take(self, n: i64) -> Vec<bool> {
        let taken = vec_new_bool();
        let mut total = 0;
        while total < n && sengoo_raw_vec_iter_done(self.handle) == 0 {
            let value = i64_to_bool(raw_vec_iter_next_bool_i64(self.handle, 0));
            taken.push(value);
            total = total + 1;
        }
        taken
    }

    def collect(self) -> Vec<bool> {
        let collected = vec_new_bool();
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            let value = i64_to_bool(raw_vec_iter_next_bool_i64(self.handle, 0));
            collected.push(value);
        }
        collected
    }

    def skip(self, n: i64) -> VecIter<bool> {
        let mut skipped = 0;
        while skipped < n && sengoo_raw_vec_iter_done(self.handle) == 0 {
            let _value = raw_vec_iter_next_bool_i64(self.handle, 0);
            skipped = skipped + 1;
        }
        self
    }

    def fold_with(self, initial: bool, f: fn(bool, bool) -> bool) -> bool {
        let mut acc = initial;
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            let value = i64_to_bool(raw_vec_iter_next_bool_i64(self.handle, 0));
            acc = f(acc, value);
        }
        acc
    }

    def enumerate(self) -> EnumerateVecIterBool {
        EnumerateVecIterBool { iter: self }
    }
}

impl EnumerateVecIterBool {
    def next(self) -> Option<EnumeratedBool> {
        if sengoo_raw_vec_iter_done(self.iter.handle) != 0 {
            option_none_with(EnumeratedBool { index: 0, value: false })
        } else {
            let current = sengoo_raw_vec_iter_index(self.iter.handle);
            let value = i64_to_bool(raw_vec_iter_next_bool_i64(self.iter.handle, 0));
            option_some(EnumeratedBool { index: current, value: value })
        }
    }
}

impl Iterator for VecIter<i64> {
    type Item = i64;

    def next(&self) -> Option<i64> {
        if sengoo_raw_vec_iter_done(self.handle) != 0 {
            option_none_i64()
        } else {
            option_some_i64(raw_vec_iter_next_i64(self.handle, 0))
        }
    }

    def map_add(self, delta: i64) -> Option<i64> {
        if sengoo_raw_vec_iter_done(self.handle) != 0 {
            option_none_i64()
        } else {
            option_some_i64(raw_vec_iter_next_i64(self.handle, 0) + delta)
        }
    }

    def filter_even(self) -> Option<i64> {
        let mut found = 0;
        let mut matched = 0;
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            if found != 0 {
                break;
            }
            let value = raw_vec_iter_next_i64(self.handle, 0);
            if (value % 2) == 0 {
                matched = value;
                found = 1;
            }
        }
        if found != 0 {
            option_some_i64(matched)
        } else {
            option_none_i64()
        }
    }

    def map_with(self, f: fn(i64) -> i64) -> Option<i64> {
        if sengoo_raw_vec_iter_done(self.handle) != 0 {
            option_none_i64()
        } else {
            let value = raw_vec_iter_next_i64(self.handle, 0);
            option_some_i64(f(value))
        }
    }

    def filter_with(self, pred: fn(i64) -> i64) -> Option<i64> {
        let mut found = 0;
        let mut matched = 0;
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            if found != 0 {
                break;
            }
            let value = raw_vec_iter_next_i64(self.handle, 0);
            if pred(value) != 0 {
                matched = value;
                found = 1;
            }
        }
        if found != 0 {
            option_some_i64(matched)
        } else {
            option_none_i64()
        }
    }

    def count(self) -> i64 {
        let mut total = 0;
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            let _value = raw_vec_iter_next_i64(self.handle, 0);
            total = total + 1;
        }
        total
    }

    def take(self, n: i64) -> Vec<i64> {
        let taken = vec_new_i64();
        let mut total = 0;
        while total < n && sengoo_raw_vec_iter_done(self.handle) == 0 {
            taken.push(raw_vec_iter_next_i64(self.handle, 0));
            total = total + 1;
        }
        taken
    }

    def collect(self) -> Vec<i64> {
        let collected = vec_new_i64();
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            collected.push(raw_vec_iter_next_i64(self.handle, 0));
        }
        collected
    }

    def skip(self, n: i64) -> VecIter<i64> {
        let mut skipped = 0;
        while skipped < n && sengoo_raw_vec_iter_done(self.handle) == 0 {
            let _value = raw_vec_iter_next_i64(self.handle, 0);
            skipped = skipped + 1;
        }
        self
    }

    def fold_with(self, initial: i64, f: fn(i64, i64) -> i64) -> i64 {
        let mut acc = initial;
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            let value = raw_vec_iter_next_i64(self.handle, 0);
            acc = f(acc, value);
        }
        acc
    }

    def sum(self) -> i64 {
        let mut total = 0;
        while sengoo_raw_vec_iter_done(self.handle) == 0 {
            total = total + raw_vec_iter_next_i64(self.handle, 0);
        }
        total
    }

    def enumerate(self) -> EnumerateVecIterI64 {
        EnumerateVecIterI64 { iter: self }
    }
}

