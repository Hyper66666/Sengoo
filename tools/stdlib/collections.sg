impl Iterator for BTreeKeyIterI64 {
    type Item = i64;

    def next(&self) -> Option<i64> {
        if sengoo_btreemap_key_iter_done_i64(self.handle) != 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_btreemap_key_iter_next_or_default_i64(self.handle, 0))
        }
    }

    def count(self) -> i64 {
        let mut total = 0;
        while sengoo_btreemap_key_iter_done_i64(self.handle) == 0 {
            let _key = sengoo_btreemap_key_iter_next_or_default_i64(self.handle, 0);
            total = total + 1;
        }
        total
    }

    def collect(self) -> Vec<i64> {
        let collected = vec_new_i64();
        while sengoo_btreemap_key_iter_done_i64(self.handle) == 0 {
            collected.push(sengoo_btreemap_key_iter_next_or_default_i64(self.handle, 0));
        }
        collected
    }

    def skip(self, n: i64) -> BTreeKeyIterI64 {
        let mut skipped = 0;
        while skipped < n && sengoo_btreemap_key_iter_done_i64(self.handle) == 0 {
            let _key = sengoo_btreemap_key_iter_next_or_default_i64(self.handle, 0);
            skipped = skipped + 1;
        }
        self
    }

    def take(self, n: i64) -> Vec<i64> {
        let taken = vec_new_i64();
        let mut total = 0;
        while total < n && sengoo_btreemap_key_iter_done_i64(self.handle) == 0 {
            taken.push(sengoo_btreemap_key_iter_next_or_default_i64(self.handle, 0));
            total = total + 1;
        }
        taken
    }

    def reset(&self) -> bool {
        sengoo_btreemap_key_iter_reset_i64_status(self.handle) != 0
    }
}

