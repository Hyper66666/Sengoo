impl<T> Vec<T> {
    def len(&self) -> i64 {
        sengoo_raw_vec_len(self.handle)
    }

    def clear(&self) -> bool {
        sengoo_raw_vec_clear(self.handle) == 0
    }

    def is_empty(&self) -> bool {
        sengoo_raw_vec_len(self.handle) == 0
    }

    def free(&self) -> bool {
        sengoo_raw_vec_free(self.handle) == 0
    }

    def push(&self, value: T) -> bool {
        raw_vec_push(self.handle, value)
    }

    def set(&self, index: i64, value: T) -> bool {
        raw_vec_set(self.handle, index, value)
    }

    def insert(&self, index: i64, value: T) -> bool {
        raw_vec_insert(self.handle, index, value)
    }

    def get(&self, index: i64) -> &T {
        raw_vec_get(self.handle, index)
    }

    def pop(&self) -> Option<T> {
        raw_vec_pop(self.handle)
    }

    def remove(&self, index: i64) -> Option<T> {
        raw_vec_remove(self.handle, index)
    }

    def iter(&self) -> RawVecIter<T> {
        RawVecIter { handle: sengoo_raw_vec_iter_new(self.handle), marker: 0 }
    }

    def into_iter(self) -> RawVecIntoIter<T> {
        RawVecIntoIter { vec: self, marker: 0 }
    }
}

impl<T> VecDeque<T> {
    def len(&self) -> i64 {
        sengoo_raw_vec_len(self.handle)
    }

    def is_empty(&self) -> bool {
        self.len() == 0
    }

    def push_back(&self, value: T) -> bool {
        raw_vec_push(self.handle, value)
    }

    def push_front(&self, value: T) -> bool {
        raw_vec_insert(self.handle, 0, value)
    }

    def pop_back(&self) -> Option<T> {
        raw_vec_pop(self.handle)
    }

    def pop_front(&self) -> Option<T> {
        raw_vec_remove(self.handle, 0)
    }

    def front(&self) -> &T {
        raw_vec_get(self.handle, 0)
    }

    def back(&self) -> &T {
        raw_vec_get(self.handle, self.len() - 1)
    }

    def clear(&self) -> bool {
        sengoo_raw_vec_clear(self.handle) == 0
    }

    def free(&self) -> bool {
        sengoo_raw_vec_free(self.handle) == 0
    }
}

