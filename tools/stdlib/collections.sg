impl Vec<i64> {
    def len(&self) -> i64 {
        sengoo_vec_len_i64(self.handle)
    }

    def clear(&self) -> bool {
        sengoo_vec_clear_i64_status(self.handle) != 0
    }

    def is_empty(&self) -> bool {
        sengoo_vec_len_i64(self.handle) == 0
    }

    def free(&self) -> bool {
        sengoo_vec_free_i64_status(self.handle) != 0
    }

    def push(&self, value: i64) -> bool {
        sengoo_vec_push_i64(self.handle, value) != 0
    }

    def get(&self, index: i64) -> Option<i64> {
        if index < 0 {
            option_none_i64()
        } else if index >= sengoo_vec_len_i64(self.handle) {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_get_or_default_i64(self.handle, index, 0))
        }
    }

    def set(&self, index: i64, value: i64) -> bool {
        sengoo_vec_set_i64(self.handle, index, value) != 0
    }

    def insert(&self, index: i64, value: i64) -> bool {
        sengoo_vec_insert_i64(self.handle, index, value) != 0
    }

    def pop(&self) -> Option<i64> {
        if sengoo_vec_len_i64(self.handle) == 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_pop_or_default_i64(self.handle, 0))
        }
    }

    def iter(&self) -> VecIter<i64> {
        VecIter { handle: sengoo_vec_iter_new_i64(self.handle), marker: 0 }
    }

    def contains(&self, value: i64) -> bool {
        sengoo_vec_contains_i64(self.handle, value) != 0
    }

    def remove(&self, index: i64) -> Option<i64> {
        if index < 0 {
            option_none_i64()
        } else if index >= sengoo_vec_len_i64(self.handle) {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_remove_or_default_i64(self.handle, index, 0))
        }
    }
}

impl VecDeque<i64> {
    def len(&self) -> i64 {
        sengoo_vec_len_i64(self.handle)
    }

    def is_empty(&self) -> bool {
        sengoo_vec_len_i64(self.handle) == 0
    }

    def clear(&self) -> bool {
        sengoo_vec_clear_i64_status(self.handle) != 0
    }

    def free(&self) -> bool {
        sengoo_vec_free_i64_status(self.handle) != 0
    }

    def push_back(&self, value: i64) -> bool {
        sengoo_vec_push_i64(self.handle, value) != 0
    }

    def push_front(&self, value: i64) -> bool {
        sengoo_vec_insert_i64(self.handle, 0, value) != 0
    }

    def pop_back(&self) -> Option<i64> {
        if sengoo_vec_len_i64(self.handle) == 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_pop_or_default_i64(self.handle, 0))
        }
    }

    def pop_front(&self) -> Option<i64> {
        if sengoo_vec_len_i64(self.handle) == 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_remove_or_default_i64(self.handle, 0, 0))
        }
    }

    def front(&self) -> Option<i64> {
        if sengoo_vec_len_i64(self.handle) == 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_get_or_default_i64(self.handle, 0, 0))
        }
    }

    def back(&self) -> Option<i64> {
        let len = sengoo_vec_len_i64(self.handle);
        if len == 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_get_or_default_i64(self.handle, len - 1, 0))
        }
    }
}

