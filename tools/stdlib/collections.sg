        if item.is_none() {
            __sengoo_option_none()
        } else {
            let mapper = self.mapper;
            option_some(mapper(item.value))
        }
    }
}

impl<I: Iterator, T, O> MapIter<I, T, O> {
    def next(&self) -> Option<O> {
        let item = self.inner.next();
        if item.is_none() {
            __sengoo_option_none()
        } else {
            let mapper = self.mapper;
            option_some(mapper(item.value))
        }
    }
    def enumerate(self) -> EnumerateIter<MapIter<I, T, O>, O> {
        let index: Vec<i64> = vec_new_i64();
        raw_vec_push(index.handle, 0);
        EnumerateIter { inner: self, index: index }
    }
    def filter(self, predicate: fn(&O) -> bool) -> FilterIter<MapIter<I, T, O>, O> {
        FilterIter { inner: self, predicate: predicate }
    }
    def map<P>(self, mapper: fn(O) -> P) -> MapIter<MapIter<I, T, O>, O, P> {
        MapIter { inner: self, mapper: mapper }
    }
    def take(self, count: i64) -> TakeIter<MapIter<I, T, O>, O> {
        iterator_take(self, count)
    }
    def skip(self, count: i64) -> SkipIter<MapIter<I, T, O>, O> {
        iterator_skip(self, count)
    }
    def collect(self) -> Vec<O> {
        let result: Vec<O> = vec_new();
        let mut done = false;
        while done == false {
            let mut item = self.next();
            if item.is_none() {
                done = true;
            } else {
                raw_vec_push(result.handle, item.value);
                item.is_some = false;
            }
        }
        result
    }
    def count(self) -> i64 {
        let mut total = 0;
        let mut done = false;
        while done == false {
            let item = self.next();
            if item.is_none() { done = true; } else { total = total + 1; }
        }
        total
    }
    def fold<A>(self, initial: A, reducer: fn(A, O) -> A) -> A {
        let mut result = initial;
        let mut done = false;
        while done == false {
            let mut item = self.next();
            if item.is_none() { done = true; } else {
                result = reducer(result, item.value);
                item.is_some = false;
            }
        }
        result
    }
    def collect_hashmap<K: Hash + Eq, V>(
        self,
        projector: fn(O) -> MapEntry<K, V>,
    ) -> HashMap<K, V> {
        let result: HashMap<K, V> = hashmap_new();
        let mut done = false;
        while done == false {
            let mut item = self.next();
            if item.is_none() { done = true; } else {
                let entry = projector(item.value);
                item.is_some = false;
                raw_hashmap_insert(result.handle, entry.key, entry.value);
            }
        }
        result
    }
}

impl<I: Iterator, T, O: SumValue> MapIter<I, T, O> {
