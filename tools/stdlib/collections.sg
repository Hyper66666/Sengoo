struct Vec<T> {
    handle: i64,
    marker: T,
}

struct VecIter<T> {
    handle: i64,
    marker: T,
}

struct HashMap<K, V> {
    handle: i64,
    key_marker: K,
    value_marker: V,
}

struct HashMapIter<V> {
    handle: i64,
    marker: V,
}

struct TextList {
    handle: i64,
}

struct TextListIter {
    handle: i64,
}

struct StringMapI64 {
    handle: i64,
}

struct StringMapBool {
    handle: i64,
}

struct StringMapKeyIter {
    handle: i64,
}

struct StringMapString {
    handle: i64,
}

struct StringMapStringKeyIter {
    handle: i64,
}

struct VecStringIter {
    handle: i64,
}

def bool_to_i64(value: bool) -> i64 {
    if value {
        1
    } else {
        0
    }
}

def i64_to_bool(value: i64) -> bool {
    value != 0
}

def collections_copy_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: 0 - value }
    }
}

trait Iterator {
    def next(self) -> Option<i64> {
        option_none_i64()
    }


    def map_add(self, delta: i64) -> Option<i64> {
        option_none_i64()
    }

    def filter_even(self) -> Option<i64> {
        option_none_i64()
    }

    def map_with(self, f: fn(i64) -> i64) -> Option<i64> {
        option_none_i64()
    }

    def filter_with(self, pred: fn(i64) -> i64) -> Option<i64> {
        option_none_i64()
    }
}

def vec_new_i64() -> Vec<i64> {
    Vec { handle: sengoo_vec_new_i64(), marker: 0 }
}

def vec_new_bool() -> Vec<bool> {
    Vec { handle: sengoo_vec_new_i64(), marker: false }
}

def vec_new_string() -> Vec<String> {
    Vec { handle: sengoo_vec_new_string(), marker: String { handle: 0 } }
}

def string_map_string_new() -> StringMapString {
    StringMapString { handle: sengoo_string_map_string_new() }
}

def hashmap_new_i64_i64() -> HashMap<i64, i64> {
    HashMap { handle: sengoo_hashmap_new_i64(), key_marker: 0, value_marker: 0 }
}

def hashmap_new_bool_bool() -> HashMap<bool, bool> {
    HashMap { handle: sengoo_hashmap_new_i64(), key_marker: false, value_marker: false }
}

def hashmap_new_i64_bool() -> HashMap<i64, bool> {
    HashMap { handle: sengoo_hashmap_new_i64(), key_marker: 0, value_marker: false }
}

def hashmap_new_bool_i64() -> HashMap<bool, i64> {
    HashMap { handle: sengoo_hashmap_new_i64(), key_marker: false, value_marker: 0 }
}

impl<T> Vec<T> {
    def len(self) -> i64 {
        sengoo_vec_len_i64(self.handle)
    }

    def clear(self) -> bool {
        sengoo_vec_clear_i64_status(self.handle) != 0
    }

    def is_empty(self) -> bool {
        sengoo_vec_len_i64(self.handle) == 0
    }

    def free(self) -> bool {
        sengoo_vec_free_i64_status(self.handle) != 0
    }
}

impl Vec<i64> {
    def push(self, value: i64) -> bool {
        sengoo_vec_push_i64(self.handle, value) != 0
    }

    def get(self, index: i64) -> Option<i64> {
        if index < 0 {
            option_none_i64()
        } else if index >= sengoo_vec_len_i64(self.handle) {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_get_or_default_i64(self.handle, index, 0))
        }
    }

    def set(self, index: i64, value: i64) -> bool {
        sengoo_vec_set_i64(self.handle, index, value) != 0
    }

    def pop(self) -> Option<i64> {
        if sengoo_vec_len_i64(self.handle) == 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_pop_or_default_i64(self.handle, 0))
        }
    }

    def iter(self) -> VecIter<i64> {
        VecIter { handle: sengoo_vec_iter_new_i64(self.handle), marker: self.marker }
    }

    def contains(self, value: i64) -> bool {
        sengoo_vec_contains_i64(self.handle, value) != 0
    }

    def remove(self, index: i64) -> Option<i64> {
        if index < 0 {
            option_none_i64()
        } else if index >= sengoo_vec_len_i64(self.handle) {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_remove_or_default_i64(self.handle, index, 0))
        }
    }
}

impl Vec<bool> {
    def push(self, value: bool) -> bool {
        sengoo_vec_push_i64(self.handle, bool_to_i64(value)) != 0
    }

    def get(self, index: i64) -> Option<bool> {
        if index < 0 {
            option_none_bool()
        } else if index >= sengoo_vec_len_i64(self.handle) {
            option_none_bool()
        } else {
            option_some_bool(i64_to_bool(sengoo_vec_get_or_default_i64(self.handle, index, 0)))
        }
    }

    def set(self, index: i64, value: bool) -> bool {
        sengoo_vec_set_i64(self.handle, index, bool_to_i64(value)) != 0
    }

    def pop(self) -> Option<bool> {
        if sengoo_vec_len_i64(self.handle) == 0 {
            option_none_bool()
        } else {
            option_some_bool(i64_to_bool(sengoo_vec_pop_or_default_i64(self.handle, 0)))
        }
    }

    def iter(self) -> VecIter<bool> {
        VecIter { handle: sengoo_vec_iter_new_i64(self.handle), marker: self.marker }
    }

    def contains(self, value: bool) -> bool {
        sengoo_vec_contains_i64(self.handle, bool_to_i64(value)) != 0
    }

    def remove(self, index: i64) -> Option<bool> {
        if index < 0 {
            option_none_bool()
        } else if index >= sengoo_vec_len_i64(self.handle) {
            option_none_bool()
        } else {
            option_some_bool(i64_to_bool(sengoo_vec_remove_or_default_i64(self.handle, index, 0)))
        }
    }
}

impl<T> VecIter<T> {
    def reset(self) -> bool {
        sengoo_vec_iter_reset_i64_status(self.handle) != 0
    }

    def free(self) -> bool {
        sengoo_vec_iter_free_i64_status(self.handle) != 0
    }
}

impl VecIter<bool> {
    def next(self) -> Option<bool> {
        if sengoo_vec_iter_done_i64(self.handle) != 0 {
            option_none_bool()
        } else {
            option_some_bool(i64_to_bool(sengoo_vec_iter_next_or_default_i64(self.handle, 0)))
        }
    }

    def map_with(self, f: fn(bool) -> bool) -> Option<bool> {
        if sengoo_vec_iter_done_i64(self.handle) != 0 {
            option_none_bool()
        } else {
            let value = i64_to_bool(sengoo_vec_iter_next_or_default_i64(self.handle, 0));
            option_some_bool(f(value))
        }
    }

    def filter_with(self, pred: fn(bool) -> bool) -> Option<bool> {
        let mut found = 0;
        let mut matched = false;
        while sengoo_vec_iter_done_i64(self.handle) == 0 {
            if found != 0 {
                break;
            }
            let value = i64_to_bool(sengoo_vec_iter_next_or_default_i64(self.handle, 0));
            if pred(value) {
                matched = value;
                found = 1;
            }
        }
        if found != 0 {
            option_some_bool(matched)
        } else {
            option_none_bool()
        }
    }
}

impl Iterator for VecIter<i64> {
    def next(self) -> Option<i64> {
        if sengoo_vec_iter_done_i64(self.handle) != 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_iter_next_or_default_i64(self.handle, 0))
        }
    }

    def map_add(self, delta: i64) -> Option<i64> {
        if sengoo_vec_iter_done_i64(self.handle) != 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_vec_iter_next_or_default_i64(self.handle, 0) + delta)
        }
    }

    def filter_even(self) -> Option<i64> {
        let mut found = 0;
        let mut matched = 0;
        while sengoo_vec_iter_done_i64(self.handle) == 0 {
            if found != 0 {
                break;
            }
            let value = sengoo_vec_iter_next_or_default_i64(self.handle, 0);
            if (value % 2) == 0 {
                matched = value;
                found = 1;
            }
        }
        if found != 0 {
            option_some_i64(matched)
        } else {
            option_none_i64()
        }
    }

    def map_with(self, f: fn(i64) -> i64) -> Option<i64> {
        if sengoo_vec_iter_done_i64(self.handle) != 0 {
            option_none_i64()
        } else {
            let value = sengoo_vec_iter_next_or_default_i64(self.handle, 0);
            option_some_i64(f(value))
        }
    }

    def filter_with(self, pred: fn(i64) -> i64) -> Option<i64> {
        let mut found = 0;
        let mut matched = 0;
        while sengoo_vec_iter_done_i64(self.handle) == 0 {
            if found != 0 {
                break;
            }
            let value = sengoo_vec_iter_next_or_default_i64(self.handle, 0);
            if pred(value) != 0 {
                matched = value;
                found = 1;
            }
        }
        if found != 0 {
            option_some_i64(matched)
        } else {
            option_none_i64()
        }
    }
}

