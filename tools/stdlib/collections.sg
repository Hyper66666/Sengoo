    }

    def collect(self) -> Vec<String> {
        Vec { handle: sengoo_vec_string_iter_collect(self.handle), marker: 0 }
    }

    def count(self) -> i64 {
        let mut total = 0;
        while !self.done() {
            let next_value = self.next();
            if next_value.is_ok {
                total = total + 1;
            }
        }
        total
    }

    def skip(self, n: i64) -> VecStringIter {
