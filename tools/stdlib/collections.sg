    def get_raw(&self, key_ptr: i64) -> Option<i64> {
        let key = String { handle: sengoo_string_from_str_copy(key_ptr) };
        if key.handle >= 0 && raw_hashmap_contains(self.handle, &key) {
            let value: &i64 = raw_hashmap_get(self.handle, &key);
            option_some_i64(*value)
        } else {
            option_none_i64()
        }
    }

    def get(self, key: &str) -> Option<i64> {
        self.get_raw(sengoo_stdlib_str_ptr(key))
    }

    def remove_raw(&self, key_ptr: i64) -> bool {
        let key = String { handle: sengoo_string_from_str_copy(key_ptr) };
        if key.handle < 0 {
            false
        } else {
            let removed: Option<i64> = raw_hashmap_remove(self.handle, &key);
            removed.is_some()
        }
    }

    def remove(self, key: &str) -> bool {
        self.remove_raw(sengoo_stdlib_str_ptr(key))
    }

    def iter_keys(self) -> StringMapKeyIter {
        StringMapKeyIter { handle: sengoo_raw_map_key_iter_new(self.handle) }
    }
}

