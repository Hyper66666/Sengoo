trait RcValue {
    def rc(self) -> Rc<Self> {
        Rc { handle: 0 }
    }
}

def bool_to_i64(value: bool) -> i64 {
    if value {
        1
    } else {
        0
    }
}

def i64_to_bool(value: i64) -> bool {
    value != 0
}

def rc_new_i64(value: i64) -> Rc<i64> {
    Rc { handle: sengoo_rc_new_i64(value) }
}

def rc_new_bool(value: bool) -> Rc<bool> {
    Rc { handle: sengoo_rc_new_bool(bool_to_i64(value)) }
}

def rc_new_string(value: String) -> Rc<String> {
    Rc { handle: sengoo_rc_new_string(value.handle) }
}

def rc_new<T>(value: T) -> Rc<T> {
    Rc { handle: 0 }
}

impl RcValue for i64 {
    def rc(self) -> Rc<i64> {
        rc_new_i64(self)
    }
}

impl RcValue for bool {
    def rc(self) -> Rc<bool> {
        rc_new_bool(self)
    }
}

impl RcValue for String {
    def rc(self) -> Rc<String> {
        rc_new_string(self)
    }
}

impl<T> Rc<T> {
    def clone(&self) -> Rc<T> {
        Rc { handle: sengoo_rc_clone(self.handle) }
    }

    def strong_count(&self) -> i64 {
        sengoo_rc_strong_count(self.handle)
    }

    def is_unique(&self) -> bool {
        self.strong_count() == 1
    }
}

impl Rc<i64> {
    def get(&self) -> i64 {
        sengoo_rc_get_i64(self.handle)
    }
}

impl Rc<bool> {
    def get(&self) -> bool {
        i64_to_bool(sengoo_rc_get_bool(self.handle))
    }
}

impl Rc<String> {
    def get(&self) -> String {
        String { handle: sengoo_rc_get_string_clone(self.handle) }
    }
}

impl<T> Drop for Rc<T> {
    def drop(&mut self) {
        sengoo_rc_drop(self.handle);
    }
}

def collections_copy_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: 0 - value }
    }
}

trait Iterator {
    type Item;

    def next(&self) -> Option<Self::Item> {}


    def map_add(self, delta: i64) -> Option<i64> {
        option_none_i64()
    }

    def filter_even(self) -> Option<i64> {
        option_none_i64()
    }

    def map_with(self, f: fn(i64) -> i64) -> Option<i64> {
        option_none_i64()
    }

    def filter_with(self, pred: fn(i64) -> i64) -> Option<i64> {
        option_none_i64()
    }

    def fold_with(self, initial: i64, f: fn(i64, i64) -> i64) -> i64 {
        initial
    }

    def count(self) -> i64 {
        0
    }

    def sum(self) -> i64 {
        0
    }
}

trait SumValue {
    def sum_combine(self, rhs: Self) -> Self {}
}

impl SumValue for i8 {
    def sum_combine(self, rhs: i8) -> i8 { self + rhs }
}

impl SumValue for i16 {
    def sum_combine(self, rhs: i16) -> i16 { self + rhs }
}

impl SumValue for i32 {
    def sum_combine(self, rhs: i32) -> i32 { self + rhs }
}

impl SumValue for i64 {
    def sum_combine(self, rhs: i64) -> i64 { self + rhs }
}

impl SumValue for isize {
    def sum_combine(self, rhs: isize) -> isize { self + rhs }
}

impl SumValue for u8 {
    def sum_combine(self, rhs: u8) -> u8 { self + rhs }
}

impl SumValue for u16 {
    def sum_combine(self, rhs: u16) -> u16 { self + rhs }
}

impl SumValue for u32 {
    def sum_combine(self, rhs: u32) -> u32 { self + rhs }
}

impl SumValue for u64 {
    def sum_combine(self, rhs: u64) -> u64 { self + rhs }
}

impl SumValue for usize {
    def sum_combine(self, rhs: usize) -> usize { self + rhs }
}

impl SumValue for f32 {
    def sum_combine(self, rhs: f32) -> f32 { self + rhs }
}

impl SumValue for f64 {
    def sum_combine(self, rhs: f64) -> f64 { self + rhs }
}

def sum_identity<T: SumValue>() -> T {
    sum_identity()
}

