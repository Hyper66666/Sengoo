        while sengoo_hashmap_iter_done_i64(self.handle) == 0 {
            if found != 0 {
                break;
            }
            let value = sengoo_hashmap_iter_next_or_default_i64(self.handle, 0);
            if pred(value) != 0 {
                matched = value;
                found = 1;
            }
        }
        if found != 0 {
            option_some_i64(matched)
        } else {
            option_none_i64()
        }
    }
}

def text_list_new() -> TextList {
    TextList { handle: sengoo_text_list_new() }
}

