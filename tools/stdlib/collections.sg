            option_none_i64()
        }
    }

    def remove(&self, key: i64) -> bool {
        sengoo_hashmap_remove_i64(self.handle, key) != 0
    }

    def iter(&self) -> HashMapIter<i64> {
        HashMapIter { handle: sengoo_hashmap_iter_new_i64(self.handle), marker: self.value_marker }
    }
}

