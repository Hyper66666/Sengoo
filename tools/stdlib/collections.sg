impl Vec<i64> {
    def len(&self) -> i64 { sengoo_raw_vec_len(self.handle) }
    def clear(&self) -> bool { sengoo_raw_vec_clear(self.handle) == 0 }
    def is_empty(&self) -> bool { self.len() == 0 }
    def free(&self) -> bool { sengoo_raw_vec_free(self.handle) == 0 }
    def push(&self, value: i64) -> bool { raw_vec_push(self.handle, value) }

    def get(&self, index: i64) -> Option<i64> {
        if index < 0 {
            option_none_i64()
        } else if index >= self.len() {
            option_none_i64()
        } else {
            let item: &i64 = raw_vec_get(self.handle, index);
            option_some_i64(*item)
        }
    }

    def set(&self, index: i64, value: i64) -> bool {
        raw_vec_set(self.handle, index, value)
    }

    def insert(&self, index: i64, value: i64) -> bool {
        raw_vec_insert(self.handle, index, value)
    }

    def pop(&self) -> Option<i64> {
        raw_vec_pop(self.handle)
    }

    def iter(&self) -> VecIter<i64> {
        VecIter { handle: sengoo_raw_vec_iter_new(self.handle), marker: 0 }
    }

    def contains(&self, value: i64) -> bool {
        let mut index = 0;
        let mut found = false;
        while index < self.len() {
            let item: &i64 = raw_vec_get(self.handle, index);
            if *item == value { found = true; }
            index = index + 1;
        }
        found
    }

    def remove(&self, index: i64) -> Option<i64> {
        if index < 0 || index >= self.len() { option_none_i64() } else { raw_vec_remove(self.handle, index) }
    }
}

impl VecDeque<i64> {
    def len(&self) -> i64 { sengoo_raw_vec_len(self.handle) }

    def is_empty(&self) -> bool {
        self.len() == 0
    }

    def clear(&self) -> bool {
        sengoo_raw_vec_clear(self.handle) == 0
    }

    def free(&self) -> bool {
        sengoo_raw_vec_free(self.handle) == 0
    }

    def push_back(&self, value: i64) -> bool {
        raw_vec_push(self.handle, value)
    }

    def push_front(&self, value: i64) -> bool {
        raw_vec_insert(self.handle, 0, value)
    }

    def pop_back(&self) -> Option<i64> {
        raw_vec_pop(self.handle)
    }

    def pop_front(&self) -> Option<i64> {
        raw_vec_remove(self.handle, 0)
    }

    def front(&self) -> Option<i64> {
        if self.is_empty() {
            option_none_i64()
        } else {
            let item: &i64 = raw_vec_get(self.handle, 0);
            option_some_i64(*item)
        }
    }

    def back(&self) -> Option<i64> {
        let len = self.len();
        if len == 0 {
            option_none_i64()
        } else {
            let item: &i64 = raw_vec_get(self.handle, len - 1);
            option_some_i64(*item)
        }
    }
}

