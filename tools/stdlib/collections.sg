impl<T> RawVecIntoIter<T> {
    def next(&self) -> Option<T> {
        self.vec.pop()
    }

    def take(self, count: i64) -> TakeIter<RawVecIntoIter<T>, T> {
        let remaining: Vec<i64> = vec_new_i64();
        sengoo_vec_push_i64(remaining.handle, count);
        TakeIter { inner: self, remaining: remaining }
    }

    def skip(self, count: i64) -> SkipIter<RawVecIntoIter<T>, T> {
        let remaining: Vec<i64> = vec_new_i64();
        sengoo_vec_push_i64(remaining.handle, count);
        SkipIter { inner: self, remaining: remaining }
    }
    def enumerate(self) -> EnumerateIter<RawVecIntoIter<T>, T> {
        let index: Vec<i64> = vec_new_i64();
        sengoo_vec_push_i64(index.handle, 0);
        EnumerateIter { inner: self, index: index }
    }
    def map<O>(self, mapper: fn(T) -> O) -> MapIter<RawVecIntoIter<T>, T, O> {
        MapIter { inner: self, mapper: mapper }
    }
    def filter(self, predicate: fn(&T) -> bool) -> FilterIter<RawVecIntoIter<T>, T> {
        FilterIter { inner: self, predicate: predicate }
    }

    def collect(self) -> Vec<T> {
        let result: Vec<T> = vec_new();
        let mut done = false;
        while done == false {
            let mut item = self.next();
            if item.is_none() {
                done = true;
            } else {
                raw_vec_push(result.handle, item.value);
                item.is_some = false;
            }
        }
        result
    }
    def count(self) -> i64 {
        let mut total = 0;
        let mut done = false;
        while done == false {
            let item = self.next();
            if item.is_none() { done = true; } else { total = total + 1; }
        }
        total
    }
    def fold<A>(self, initial: A, reducer: fn(A, T) -> A) -> A {
        let mut result = initial;
        let mut done = false;
        while done == false {
            let mut item = self.next();
            if item.is_none() {
                done = true;
            } else {
                result = reducer(result, item.value);
                item.is_some = false;
            }
        }
        result
    }

}

