    Vec { handle: 0, marker: 0 }
}

def vecdeque_new<T>() -> VecDeque<T> {
    VecDeque { handle: 0, marker: 0 }
}

def raw_vec_push<T>(handle: i64, value: T) -> bool {
    false
}

def raw_vec_set<T>(handle: i64, index: i64, value: T) -> bool {
    false
}

def raw_vec_insert<T>(handle: i64, index: i64, value: T) -> bool {
    false
}

def raw_vec_get<T>(handle: i64, index: i64) -> &T {
    raw_vec_get(handle, index)
}

def raw_vec_pop<T>(handle: i64) -> Option<T> {
    raw_vec_pop(handle)
}

def raw_vec_remove<T>(handle: i64, index: i64) -> Option<T> {
    raw_vec_remove(handle, index)
}

def raw_vec_iter_next<T>(handle: i64) -> Option<&T> {
    raw_vec_iter_next(handle)
}

def raw_vec_iter_next_i64(handle: i64, fallback: i64) -> i64 {
    let item: Option<&i64> = raw_vec_iter_next(handle);
    if item.is_some { *item.value } else { fallback }
}

def raw_vec_iter_next_bool_i64(handle: i64, fallback: i64) -> i64 {
    let item: Option<&bool> = raw_vec_iter_next(handle);
    if item.is_some { bool_to_i64(*item.value) } else { fallback }
}

def raw_vec_get_or_default_i64(handle: i64, index: i64, fallback: i64) -> i64 {
    if index < 0 || index >= sengoo_raw_vec_len(handle) {
        fallback
    } else {
        let item: &i64 = raw_vec_get(handle, index);
        *item
    }
}

def iterator_take<I: Iterator>(inner: I, count: i64) -> TakeIter<I, I::Item> {
    let remaining: Vec<i64> = vec_new_i64();
    raw_vec_push(remaining.handle, count);
    TakeIter { inner: inner, remaining: remaining }
}

def iterator_skip<I: Iterator>(inner: I, count: i64) -> SkipIter<I, I::Item> {
    let remaining: Vec<i64> = vec_new_i64();
    raw_vec_push(remaining.handle, count);
    SkipIter { inner: inner, remaining: remaining }
}

def string_map_string_new() -> StringMapString {
    let mut map: HashMap<String, String> = hashmap_new();
    let handle = map.handle;
    map.handle = 0;
    StringMapString { handle: handle }
}

