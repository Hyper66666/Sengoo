impl<I: Iterator, T> Iterator for SkipIter<I, T> {
    type Item = T;

    def next(&self) -> Option<T> {
        let mut count = sengoo_vec_get_or_default_i64(self.remaining.handle, 0, 0);
        let mut exhausted = false;
        while count > 0 {
            let skipped = self.inner.next();
            if skipped.is_none() {
                exhausted = true;
                count = 0;
            } else {
                count = count - 1;
            }
        }
        sengoo_vec_set_i64(self.remaining.handle, 0, count);
        if exhausted {
            __sengoo_option_none()
        } else {
            self.inner.next()
        }
    }
}

