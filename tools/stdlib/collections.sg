impl StringMapKeyIter {
    def done(self) -> bool {
        sengoo_string_map_key_iter_done(self.handle) != 0
    }

    def next(self) -> Result<String, i64> {
        collections_string_result(sengoo_string_map_key_iter_next_string(self.handle))
    }

    def next_copy(self, buffer: Buffer) -> Result<i64, i64> {
        collections_copy_result(sengoo_string_map_key_iter_next_copy(self.handle, buffer.handle))
    }

    def count(self) -> i64 {
        let mut total = 0;
        while !self.done() {
            let next_value = self.next();
            if next_value.is_ok {
                total = total + 1;
            }
        }
        total
    }

    def skip(self, n: i64) -> StringMapKeyIter {
        let mut skipped = 0;
        while skipped < n && !self.done() {
            let _next_value = self.next();
            skipped = skipped + 1;
        }
        self
    }

    def take(self, n: i64) -> Vec<String> {
        let taken = vec_new_string();
        let mut total = 0;
        while total < n && !self.done() {
            let next_value = sengoo_string_map_key_iter_next_string(self.handle);
            if next_value >= 0 {
                taken.push(String { handle: next_value });
                total = total + 1;
            }
        }
        taken
    }

    def collect(self) -> Vec<String> {
        let collected = vec_new_string();
        while !self.done() {
            let next_value = sengoo_string_map_key_iter_next_string(self.handle);
            if next_value >= 0 {
                collected.push(String { handle: next_value });
            }
        }
        collected
    }

    def enumerate(self) -> EnumerateStringMapKeyIter {
        EnumerateStringMapKeyIter { iter: self }
    }

    def reset(self) -> bool {
        sengoo_string_map_key_iter_reset_status(self.handle) != 0
    }

    def free(self) -> bool {
        sengoo_string_map_key_iter_free_status(self.handle) != 0
    }
}

impl EnumerateStringMapKeyIter {
    def next(self) -> Option<EnumeratedString> {
        if sengoo_string_map_key_iter_done(self.iter.handle) != 0 {
            option_none_with(EnumeratedString { index: 0, value: String { handle: 0 } })
        } else {
            let current = sengoo_string_map_key_iter_index(self.iter.handle);
            let value = sengoo_string_map_key_iter_next_string(self.iter.handle);
            if value >= 0 {
                option_some(EnumeratedString { index: current, value: String { handle: value } })
            } else {
                option_none_with(EnumeratedString { index: 0, value: String { handle: 0 } })
            }
        }
    }
}

def collections_string_result(value: i64) -> Result<String, i64> {
    if value >= 0 {
        Result { is_ok: true, value: String { handle: value }, error: 0 }
    } else {
        Result { is_ok: false, value: String { handle: 0 }, error: 0 - value }
    }
}

