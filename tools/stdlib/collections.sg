impl HashMap<i64, i64> {
    def len(&self) -> i64 { sengoo_raw_hashmap_len(self.handle) }
    def is_empty(&self) -> bool { self.len() == 0 }
    def clear(&self) -> bool { sengoo_raw_hashmap_clear(self.handle) == 0 }
    def free(&self) -> bool { sengoo_raw_hashmap_free(self.handle) == 0 }

    def insert(&self, key: i64, value: i64) -> bool {
        raw_hashmap_insert(self.handle, key, value)
    }

    def contains(&self, key: i64) -> bool {
        let mut lookup = key;
        raw_hashmap_contains(self.handle, &lookup)
    }

    def get(&self, key: i64) -> Option<i64> {
        let mut lookup = key;
        if raw_hashmap_contains(self.handle, &lookup) {
            let value: &i64 = raw_hashmap_get(self.handle, &lookup);
            option_some_i64(*value)
        } else {
            option_none_i64()
        }
    }

    def remove(&self, key: i64) -> bool {
        let mut lookup = key;
        let removed: Option<i64> = raw_hashmap_remove(self.handle, &lookup);
        removed.is_some()
    }

    def iter(&self) -> HashMapIter<i64> {
        let mut values: Vec<i64> = vec_new();
        let keys: RawMapKeyIter<i64> = RawMapKeyIter { handle: sengoo_raw_map_key_iter_new(self.handle), marker: 0 };
        let mut done = false;
        while done == false {
            let key: Option<&i64> = raw_map_key_iter_next(keys.handle);
            if key.is_none() {
                done = true;
            } else {
                let value: &i64 = raw_hashmap_get(self.handle, key.value);
                values.push(*value);
            }
        }
        let values_handle = values.handle;
        let iter_handle = sengoo_raw_vec_iter_new(values_handle);
        values.handle = 0;
        HashMapIter { handle: iter_handle, values_handle: values_handle, marker: 0 }
    }
}

