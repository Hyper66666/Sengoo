extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_lua54_last_error_code() -> i64;
    fn sengoo_lua54_last_error_len() -> i64;
    fn sengoo_lua54_last_error_copy(buffer: i64, capacity: i64) -> i64;
    fn sengoo_lua54_last_error_clear() -> i64;
    fn sengoo_lua54_open(path: i64) -> i64;
    fn sengoo_lua54_close(handle: i64) -> i64;
    fn sengoo_lua54_exec(handle: i64, chunk: i64) -> i64;
    fn sengoo_lua54_call_i64(handle: i64, func_name: i64, argc: i64, argv: i64, out_value: i64) -> i64;
    fn sengoo_lua54_call_i64_value(handle: i64, func_name: i64, argc: i64, a0: i64, a1: i64, a2: i64, a3: i64) -> i64;
}

struct Lua54 {
    handle: i64,
}

impl !Send for Lua54 {}
impl !Sync for Lua54 {}

def lua54_last_error_code() -> i64 {
    sengoo_lua54_last_error_code()
}

def lua54_last_error_len() -> i64 {
    sengoo_lua54_last_error_len()
}

def lua54_last_error_copy_raw(buffer_ptr: i64, capacity: i64) -> Result<i64, i64> {
    let copied = sengoo_lua54_last_error_copy(buffer_ptr, capacity);
    if copied >= 0 {
        Result { is_ok: true, value: copied, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: sengoo_lua54_last_error_code() }
    }
}

def lua54_last_error_copy(buffer: Buffer) -> Result<i64, i64> {
    lua54_last_error_copy_raw(buffer.ptr(), buffer.len())
}

def lua54_last_error_clear() -> bool {
    sengoo_lua54_last_error_clear() == 0
}

def lua54_open_raw(path_ptr: i64) -> Result<Lua54, i64> {
    let handle = sengoo_lua54_open(path_ptr);
    if handle != 0 {
        Result { is_ok: true, value: Lua54 { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: Lua54 { handle: 0 }, error: sengoo_lua54_last_error_code() }
    }
}

def lua54_open(path: &str) -> Result<Lua54, i64> {
    lua54_open_raw(sengoo_stdlib_str_ptr(path))
}

impl Lua54 {
    def close(self) -> bool {
        sengoo_lua54_close(self.handle) == 0
    }

    def exec_raw(self, chunk_ptr: i64) -> bool {
        sengoo_lua54_exec(self.handle, chunk_ptr) == 0
    }

    def exec(self, chunk: &str) -> bool {
        self.exec_raw(sengoo_stdlib_str_ptr(chunk))
    }

    def call_i64_raw(self, func_name_ptr: i64, argc: i64, argv_ptr: i64, out_value_ptr: i64) -> Result<i64, i64> {
        let status = sengoo_lua54_call_i64(self.handle, func_name_ptr, argc, argv_ptr, out_value_ptr);
        if status == 0 {
            Result { is_ok: true, value: status, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: status }
        }
    }

    def call_i64(self, func_name: &str, argc: i64, argv_ptr: i64, out_value_ptr: i64) -> Result<i64, i64> {
        self.call_i64_raw(sengoo_stdlib_str_ptr(func_name), argc, argv_ptr, out_value_ptr)
    }

    def call_i64_value_raw(self, func_name_ptr: i64, argc: i64, a0: i64, a1: i64, a2: i64, a3: i64) -> Result<i64, i64> {
        let value = sengoo_lua54_call_i64_value(self.handle, func_name_ptr, argc, a0, a1, a2, a3);
        let error = sengoo_lua54_last_error_code();
        if error == 0 {
            Result { is_ok: true, value: value, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: error }
        }
    }

    def call_i64_0(self, func_name: &str) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(func_name), 0, 0, 0, 0, 0)
    }

    def call_i64_1(self, func_name: &str, a0: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(func_name), 1, a0, 0, 0, 0)
    }

    def call_i64_2(self, func_name: &str, a0: i64, a1: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(func_name), 2, a0, a1, 0, 0)
    }

    def call_i64_3(self, func_name: &str, a0: i64, a1: i64, a2: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(func_name), 3, a0, a1, a2, 0)
    }

    def call_i64_4(self, func_name: &str, a0: i64, a1: i64, a2: i64, a3: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(func_name), 4, a0, a1, a2, a3)
    }
}
