extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_fs_glob_collect(root_ptr: i64, pattern_ptr: i64) -> i64;
    fn sengoo_fs_glob_count(handle: i64) -> i64;
    fn sengoo_fs_glob_copy(handle: i64, index: i64, buffer_handle: i64, capacity: i64) -> i64;
    fn sengoo_fs_glob_free(handle: i64) -> i64;
    fn sengoo_fs_watch_supported() -> i64;
    fn sengoo_file_copy(source: i64, destination: i64, overwrite: i64) -> i64;
    fn sengoo_file_remove(path: i64) -> i64;
}

struct GlobMatch {
    handle: i64,
}

def fs_glob(root: &str, pattern: &str) -> Result<GlobMatch, i64> {
    let handle = sengoo_fs_glob_collect(sengoo_stdlib_str_ptr(root), sengoo_stdlib_str_ptr(pattern));
    if handle > 0 {
        Result { is_ok: true, value: GlobMatch { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: GlobMatch { handle: 0 }, error: status_from_raw_ffi(handle) }
    }
}

impl GlobMatch {
    def count(self) -> Result<i64, i64> {
        let count = sengoo_fs_glob_count(self.handle);
        if count >= 0 {
            Result { is_ok: true, value: count, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: status_from_raw_ffi(count) }
        }
    }

    def name_copy(self, index: i64, buffer: Buffer) -> Result<i64, i64> {
        let copied = sengoo_fs_glob_copy(self.handle, index, buffer.handle, buffer.len());
        if copied >= 0 {
            Result { is_ok: true, value: copied, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: status_from_raw_ffi(copied) }
        }
    }

    def drop(self) -> bool {
        sengoo_fs_glob_free(self.handle) >= 0
    }
}

def fs_watch_supported() -> bool {
    sengoo_fs_watch_supported() != 0
}

def fs_copy_file(source: &str, destination: &str, overwrite: bool) -> Result<bool, i64> {
    let flag = if overwrite { 1 } else { 0 };
    let status = sengoo_file_copy(
        sengoo_stdlib_str_ptr(source),
        sengoo_stdlib_str_ptr(destination),
        flag
    );
    if status >= 0 {
        Result { is_ok: true, value: true, error: 0 }
    } else {
        Result { is_ok: false, value: false, error: status_from_raw_ffi(status) }
    }
}

def fs_remove_file(path: &str) -> Result<bool, i64> {
    let status = sengoo_file_remove(sengoo_stdlib_str_ptr(path));
    if status >= 0 {
        Result { is_ok: true, value: true, error: 0 }
    } else {
        Result { is_ok: false, value: false, error: status_from_raw_ffi(status) }
    }
}
