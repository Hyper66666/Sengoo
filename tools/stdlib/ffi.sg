extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_ffi_last_error_code() -> i64;
    fn sengoo_ffi_last_error_len() -> i64;
    fn sengoo_ffi_last_error_copy(buffer: i64, capacity: i64) -> i64;
    fn sengoo_ffi_last_error_clear() -> i64;
    fn sengoo_ffi_c_open(path: i64) -> i64;
    fn sengoo_ffi_c_close(handle: i64) -> i64;
    fn sengoo_ffi_c_call_i64(handle: i64, symbol: i64, argc: i64, argv: i64, out_value: i64) -> i64;
    fn sengoo_ffi_c_call_i64_value(handle: i64, symbol: i64, argc: i64, a0: i64, a1: i64, a2: i64, a3: i64) -> i64;
    fn sengoo_ffi_object_create(lib_handle: i64, constructor_symbol: i64, argc: i64, argv: i64, destructor_symbol: i64) -> i64;
    fn sengoo_ffi_object_create_value(lib_handle: i64, constructor_symbol: i64, argc: i64, a0: i64, a1: i64, a2: i64, a3: i64, destructor_symbol: i64) -> i64;
    fn sengoo_ffi_object_raw_ptr(object_handle: i64) -> i64;
    fn sengoo_ffi_object_call_i64(object_handle: i64, method_symbol: i64, argc: i64, argv: i64, out_value: i64) -> i64;
    fn sengoo_ffi_object_call_i64_value(object_handle: i64, method_symbol: i64, argc: i64, a0: i64, a1: i64, a2: i64) -> i64;
    fn sengoo_ffi_object_destroy(object_handle: i64) -> i64;
    fn sengoo_ffi_callback_bind_i64(lib_handle: i64, symbol: i64, arity: i64) -> i64;
    fn sengoo_ffi_callback_dispatch_i64(callback_id: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64;
    fn sengoo_ffi_callback_unbind(callback_id: i64) -> i64;
    fn sengoo_ffi_buffer_new(capacity: i64) -> i64;
    fn sengoo_ffi_buffer_from_bytes(data: i64, len: i64) -> i64;
    fn sengoo_ffi_buffer_len(buffer_handle: i64) -> i64;
    fn sengoo_ffi_buffer_capacity(buffer_handle: i64) -> i64;
    fn sengoo_ffi_buffer_used_len(buffer_handle: i64) -> i64;
    fn sengoo_ffi_buffer_get_u8(buffer_handle: i64, index: i64) -> i64;
    fn sengoo_ffi_buffer_set_u8(buffer_handle: i64, index: i64, value: i64) -> i64;
    fn sengoo_ffi_buffer_read_u32_be(buffer_handle: i64, offset: i64) -> i64;
    fn sengoo_ffi_buffer_write_u32_be(buffer_handle: i64, offset: i64, value: i64) -> i64;
    fn sengoo_ffi_buffer_ptr(buffer_handle: i64) -> i64;
    fn sengoo_ffi_buffer_copy_out(buffer_handle: i64, out_buffer: i64, out_capacity: i64) -> i64;
    fn sengoo_ffi_buffer_copy_in(buffer_handle: i64, src_ptr: i64, src_len: i64) -> i64;
    fn sengoo_ffi_buffer_clear(buffer_handle: i64) -> i64;
    fn sengoo_ffi_buffer_copy_range(buffer_handle: i64, start: i64, len: i64, out_buffer_handle: i64) -> i64;
    fn sengoo_ffi_buffer_append(buffer_handle: i64, src_ptr: i64, src_len: i64) -> i64;
    fn sengoo_ffi_buffer_is_utf8(buffer_handle: i64) -> i64;
    fn sengoo_ffi_buffer_free(buffer_handle: i64) -> i64;
}

struct CLib {
    handle: i64,
}

struct CppObject {
    handle: i64,
}

struct CallbackToken {
    handle: i64,
}

struct Buffer {
    handle: i64,
}

impl !Send for CLib {}
impl !Sync for CLib {}
impl !Send for CppObject {}
impl !Sync for CppObject {}
impl !Send for CallbackToken {}
impl !Sync for CallbackToken {}
impl !Send for Buffer {}
impl !Sync for Buffer {}

def ffi_last_error_code() -> i64 {
    sengoo_ffi_last_error_code()
}

def ffi_open_raw(path_ptr: i64) -> Result<CLib, i64> {
    let handle = sengoo_ffi_c_open(path_ptr);
    if handle != 0 {
        Result { is_ok: true, value: CLib { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: CLib { handle: 0 }, error: sengoo_ffi_last_error_code() }
    }
}

def ffi_open(path: &str) -> Result<CLib, i64> {
    ffi_open_raw(sengoo_stdlib_str_ptr(path))
}

def ffi_last_error_len() -> i64 {
    sengoo_ffi_last_error_len()
}

def ffi_last_error_copy_raw(buffer_ptr: i64, capacity: i64) -> i64 {
    sengoo_ffi_last_error_copy(buffer_ptr, capacity)
}

def ffi_last_error_copy(buffer: Buffer) -> Result<i64, i64> {
    let copied = ffi_last_error_copy_raw(sengoo_ffi_buffer_ptr(buffer.handle), sengoo_ffi_buffer_len(buffer.handle));
    if copied >= 0 {
        Result { is_ok: true, value: copied, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: sengoo_ffi_last_error_code() }
    }
}

def ffi_last_error_clear() -> bool {
    sengoo_ffi_last_error_clear() == 0
}

def ffi_i64_value_result(value: i64) -> Result<i64, i64> {
    let error = sengoo_ffi_last_error_code();
    if error == 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: error }
    }
}

def ffi_status_from_raw(code: i64) -> i64 {
    if code == 0 {
        0
    } else if code <= -1 && code >= -19 {
        0 - code
    } else if code == -2001 {
        2
    } else if code == -2002 {
        3
    } else if code == -2006 {
        4
    } else if code == -2007 {
        8
    } else {
        1
    }
}

def ffi_bool_result(value: i64) -> Result<bool, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value != 0, error: 0 }
    } else {
        Result { is_ok: false, value: false, error: ffi_status_from_raw(value) }
    }
}

def ffi_byte_count_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: ffi_status_from_raw(value) }
    }
}

impl CLib {
    def close(self) -> bool {
        sengoo_ffi_c_close(self.handle) == 0
    }

    def call_i64_raw(self, symbol_ptr: i64, argc: i64, argv_ptr: i64, out_value_ptr: i64) -> Result<i64, i64> {
        let status = sengoo_ffi_c_call_i64(self.handle, symbol_ptr, argc, argv_ptr, out_value_ptr);
        if status == 0 {
            Result { is_ok: true, value: status, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: status }
        }
    }

    def call_i64(self, symbol: &str, argc: i64, argv_ptr: i64, out_value_ptr: i64) -> Result<i64, i64> {
        self.call_i64_raw(sengoo_stdlib_str_ptr(symbol), argc, argv_ptr, out_value_ptr)
    }

    def call_i64_value_raw(self, symbol_ptr: i64, argc: i64, a0: i64, a1: i64, a2: i64, a3: i64) -> Result<i64, i64> {
        ffi_i64_value_result(sengoo_ffi_c_call_i64_value(self.handle, symbol_ptr, argc, a0, a1, a2, a3))
    }

    def call_i64_0(self, symbol: &str) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(symbol), 0, 0, 0, 0, 0)
    }

    def call_i64_1(self, symbol: &str, a0: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(symbol), 1, a0, 0, 0, 0)
    }

    def call_i64_2(self, symbol: &str, a0: i64, a1: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(symbol), 2, a0, a1, 0, 0)
    }

    def call_i64_3(self, symbol: &str, a0: i64, a1: i64, a2: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(symbol), 3, a0, a1, a2, 0)
    }

    def call_i64_4(self, symbol: &str, a0: i64, a1: i64, a2: i64, a3: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(symbol), 4, a0, a1, a2, a3)
    }

    def bind_callback_i64_raw(self, symbol_ptr: i64, arity: i64) -> Result<CallbackToken, i64> {
        let handle = sengoo_ffi_callback_bind_i64(self.handle, symbol_ptr, arity);
        if handle != 0 {
            Result { is_ok: true, value: CallbackToken { handle: handle }, error: 0 }
        } else {
            Result { is_ok: false, value: CallbackToken { handle: 0 }, error: sengoo_ffi_last_error_code() }
        }
    }

    def bind_callback_i64(self, symbol: &str, arity: i64) -> Result<CallbackToken, i64> {
        self.bind_callback_i64_raw(sengoo_stdlib_str_ptr(symbol), arity)
    }

    def object_create_raw(self, constructor_symbol_ptr: i64, argc: i64, argv_ptr: i64, destructor_symbol_ptr: i64) -> Result<CppObject, i64> {
        let handle = sengoo_ffi_object_create(self.handle, constructor_symbol_ptr, argc, argv_ptr, destructor_symbol_ptr);
        if handle != 0 {
            Result { is_ok: true, value: CppObject { handle: handle }, error: 0 }
        } else {
            Result { is_ok: false, value: CppObject { handle: 0 }, error: sengoo_ffi_last_error_code() }
        }
    }

    def object_create(self, constructor_symbol: &str, argc: i64, argv_ptr: i64, destructor_symbol: &str) -> Result<CppObject, i64> {
        self.object_create_raw(sengoo_stdlib_str_ptr(constructor_symbol), argc, argv_ptr, sengoo_stdlib_str_ptr(destructor_symbol))
    }

    def object_create_value_raw(self, constructor_symbol_ptr: i64, argc: i64, a0: i64, a1: i64, a2: i64, a3: i64, destructor_symbol_ptr: i64) -> Result<CppObject, i64> {
        let handle = sengoo_ffi_object_create_value(self.handle, constructor_symbol_ptr, argc, a0, a1, a2, a3, destructor_symbol_ptr);
        if handle != 0 {
            Result { is_ok: true, value: CppObject { handle: handle }, error: 0 }
        } else {
            Result { is_ok: false, value: CppObject { handle: 0 }, error: sengoo_ffi_last_error_code() }
        }
    }

    def object_create_0(self, constructor_symbol: &str, destructor_symbol: &str) -> Result<CppObject, i64> {
        self.object_create_value_raw(sengoo_stdlib_str_ptr(constructor_symbol), 0, 0, 0, 0, 0, sengoo_stdlib_str_ptr(destructor_symbol))
    }

    def object_create_1(self, constructor_symbol: &str, a0: i64, destructor_symbol: &str) -> Result<CppObject, i64> {
        self.object_create_value_raw(sengoo_stdlib_str_ptr(constructor_symbol), 1, a0, 0, 0, 0, sengoo_stdlib_str_ptr(destructor_symbol))
    }

    def object_create_2(self, constructor_symbol: &str, a0: i64, a1: i64, destructor_symbol: &str) -> Result<CppObject, i64> {
        self.object_create_value_raw(sengoo_stdlib_str_ptr(constructor_symbol), 2, a0, a1, 0, 0, sengoo_stdlib_str_ptr(destructor_symbol))
    }

    def object_create_3(self, constructor_symbol: &str, a0: i64, a1: i64, a2: i64, destructor_symbol: &str) -> Result<CppObject, i64> {
        self.object_create_value_raw(sengoo_stdlib_str_ptr(constructor_symbol), 3, a0, a1, a2, 0, sengoo_stdlib_str_ptr(destructor_symbol))
    }

    def object_create_4(self, constructor_symbol: &str, a0: i64, a1: i64, a2: i64, a3: i64, destructor_symbol: &str) -> Result<CppObject, i64> {
        self.object_create_value_raw(sengoo_stdlib_str_ptr(constructor_symbol), 4, a0, a1, a2, a3, sengoo_stdlib_str_ptr(destructor_symbol))
    }
}

impl CppObject {
    def raw_ptr(self) -> i64 {
        sengoo_ffi_object_raw_ptr(self.handle)
    }

    def call_i64_raw(self, method_symbol_ptr: i64, argc: i64, argv_ptr: i64, out_value_ptr: i64) -> Result<i64, i64> {
        let status = sengoo_ffi_object_call_i64(self.handle, method_symbol_ptr, argc, argv_ptr, out_value_ptr);
        if status == 0 {
            Result { is_ok: true, value: status, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: status }
        }
    }

    def call_i64_value_raw(self, method_symbol_ptr: i64, argc: i64, a0: i64, a1: i64, a2: i64) -> Result<i64, i64> {
        ffi_i64_value_result(sengoo_ffi_object_call_i64_value(self.handle, method_symbol_ptr, argc, a0, a1, a2))
    }

    def call_i64_0(self, method_symbol: &str) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(method_symbol), 0, 0, 0, 0)
    }

    def call_i64_1(self, method_symbol: &str, a0: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(method_symbol), 1, a0, 0, 0)
    }

    def call_i64_2(self, method_symbol: &str, a0: i64, a1: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(method_symbol), 2, a0, a1, 0)
    }

    def call_i64_3(self, method_symbol: &str, a0: i64, a1: i64, a2: i64) -> Result<i64, i64> {
        self.call_i64_value_raw(sengoo_stdlib_str_ptr(method_symbol), 3, a0, a1, a2)
    }

    def destroy(self) -> bool {
        sengoo_ffi_object_destroy(self.handle) == 0
    }
}

impl CallbackToken {
    def dispatch_i64(self, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 {
        sengoo_ffi_callback_dispatch_i64(self.handle, a0, a1, a2, a3, a4, a5)
    }

    def unbind(self) -> bool {
        sengoo_ffi_callback_unbind(self.handle) == 0
    }
}

def ffi_buffer_from_bytes_raw(data_ptr: i64, len: i64) -> Result<Buffer, i64> {
    let handle = sengoo_ffi_buffer_from_bytes(data_ptr, len);
    if handle != 0 {
        Result { is_ok: true, value: Buffer { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: Buffer { handle: 0 }, error: sengoo_ffi_last_error_code() }
    }
}

def ffi_buffer_from_bytes(data: &str) -> Result<Buffer, i64> {
    ffi_buffer_from_bytes_raw(sengoo_stdlib_str_ptr(data), data.len())
}

def ffi_buffer_new(capacity: i64) -> Result<Buffer, i64> {
    let handle = sengoo_ffi_buffer_new(capacity);
    if handle != 0 {
        Result { is_ok: true, value: Buffer { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: Buffer { handle: 0 }, error: sengoo_ffi_last_error_code() }
    }
}

impl Buffer {
    def len(self) -> i64 {
        sengoo_ffi_buffer_len(self.handle)
    }

    def capacity(self) -> i64 {
        sengoo_ffi_buffer_capacity(self.handle)
    }

    def used_len(self) -> i64 {
        sengoo_ffi_buffer_used_len(self.handle)
    }

    def get_u8(self, index: i64) -> Result<i64, i64> {
        ffi_byte_count_result(sengoo_ffi_buffer_get_u8(self.handle, index))
    }

    def set_u8(self, index: i64, value: i64) -> Result<bool, i64> {
        ffi_bool_result(sengoo_ffi_buffer_set_u8(self.handle, index, value))
    }

    def read_u32_be(self, offset: i64) -> Result<i64, i64> {
        ffi_byte_count_result(sengoo_ffi_buffer_read_u32_be(self.handle, offset))
    }

    def write_u32_be(self, offset: i64, value: i64) -> Result<bool, i64> {
        ffi_bool_result(sengoo_ffi_buffer_write_u32_be(self.handle, offset, value))
    }

    def ptr(self) -> i64 {
        sengoo_ffi_buffer_ptr(self.handle)
    }

    def copy_out_raw(self, out_buffer_ptr: i64, out_capacity: i64) -> i64 {
        sengoo_ffi_buffer_copy_out(self.handle, out_buffer_ptr, out_capacity)
    }

    def copy_out(self, out: Buffer) -> Result<i64, i64> {
        let copied = self.copy_out_raw(out.ptr(), out.len());
        if copied >= 0 {
            Result { is_ok: true, value: copied, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: sengoo_ffi_last_error_code() }
        }
    }

    def copy_in_raw(self, src_ptr: i64, src_len: i64) -> bool {
        sengoo_ffi_buffer_copy_in(self.handle, src_ptr, src_len) == 0
    }

    def copy_in(self, src: &str) -> bool {
        self.copy_in_raw(sengoo_stdlib_str_ptr(src), src.len())
    }

    def clear(self) -> bool {
        sengoo_ffi_buffer_clear(self.handle) == 0
    }

    def copy_range(self, start: i64, len: i64, out: Buffer) -> Result<i64, i64> {
        ffi_byte_count_result(sengoo_ffi_buffer_copy_range(self.handle, start, len, out.handle))
    }

    def copy_from_str(self, value: &str) -> Result<i64, i64> {
        let status = sengoo_ffi_buffer_copy_in(self.handle, sengoo_stdlib_str_ptr(value), value.len());
        if status == 0 {
            Result { is_ok: true, value: value.len(), error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: ffi_status_from_raw(status) }
        }
    }

    def append_str(self, value: &str) -> Result<i64, i64> {
        ffi_byte_count_result(sengoo_ffi_buffer_append(self.handle, sengoo_stdlib_str_ptr(value), value.len()))
    }

    def is_utf8(self) -> bool {
        sengoo_ffi_buffer_is_utf8(self.handle) != 0
    }

    def free(self) -> bool {
        if self.handle == 0 { true } else { sengoo_ffi_buffer_free(self.handle) == 0 }
    }
}

impl Drop for Buffer {
    def drop(&mut self) {
        if self.handle != 0 {
            sengoo_ffi_buffer_free(self.handle);
        }
    }
}
