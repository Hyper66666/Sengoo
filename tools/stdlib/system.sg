extern "C" {
    fn sengoo_file_lock(path: i64, length: i64, exclusive: i64) -> i64;
    fn sengoo_file_lock_close(handle: i64) -> i64;
    fn sengoo_file_lock_live_count() -> i64;
    fn sengoo_canonical_path_string(path: i64, length: i64) -> i64;
    fn sengoo_current_executable_string() -> i64;
    fn sengoo_credential_read(target: i64, length: i64) -> i64;
    fn sengoo_credential_write(target: i64, target_length: i64, value: i64, value_length: i64) -> i64;
    fn sengoo_credential_delete(target: i64, length: i64) -> i64;
}

struct FileLock {
    handle: i64,
}

impl !Send for FileLock {
}

impl !Sync for FileLock {
}

def system_string_result(raw: i64) -> Result<String, i64> {
    if raw > 0 { Result { is_ok: true, value: String { handle: raw }, error: 0 }; } else { Result { is_ok: false, value: String { handle: 0 }, error: status_from_raw_ffi(raw) }; };
}

def system_bool_result(raw: i64) -> Result<bool, i64> {
    if raw >= 0 { Result { is_ok: true, value: raw > 0, error: 0 }; } else { Result { is_ok: false, value: false, error: status_from_raw_ffi(raw) }; };
}

def file_lock_mode(path: &str, exclusive: bool) -> Result<FileLock, i64> {
    let raw = sengoo_file_lock(sengoo_stdlib_str_ptr(path), path.len(), if exclusive { 1; } else { 0; });
    if raw > 0 { Result { is_ok: true, value: FileLock { handle: raw }, error: 0 }; } else { Result { is_ok: false, value: FileLock { handle: 0 }, error: status_from_raw_ffi(raw) }; };
}

def file_lock(path: &str) -> Result<FileLock, i64> {
    file_lock_mode(path, true);
}

def canonical_path_string(path: &str) -> Result<String, i64> {
    system_string_result(sengoo_canonical_path_string(sengoo_stdlib_str_ptr(path), path.len()));
}

// The running image, independent of cwd, PATH and the caller's argv spelling.
def current_executable_string() -> Result<String, i64> {
    system_string_result(sengoo_current_executable_string());
}

def credential_read(target: &str) -> Result<String, i64> {
    system_string_result(sengoo_credential_read(sengoo_stdlib_str_ptr(target), target.len()));
}

def credential_write(target: &str, value: &str) -> Result<bool, i64> {
    system_bool_result(sengoo_credential_write(sengoo_stdlib_str_ptr(target), target.len(), sengoo_stdlib_str_ptr(value), value.len()));
}

def credential_delete(target: &str) -> Result<bool, i64> {
    system_bool_result(sengoo_credential_delete(sengoo_stdlib_str_ptr(target), target.len()));
}

impl FileLock {
    def close(&mut self) -> Result<bool, i64> {
        let raw = sengoo_file_lock_close(self.handle);
        self.handle = 0;
        system_bool_result(if raw == 0 { 1; } else { raw; });
    }
}

impl Drop for FileLock {
    def drop(&mut self) {
        if self.handle != 0 { sengoo_file_lock_close(self.handle); self.handle = 0; };
    }
}
