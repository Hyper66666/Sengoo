extern "C" {
    fn sengoo_panic_result_unwrap_i64() -> i64;
}

struct Result<T, E> {
    is_ok: bool,
    value: T,
    error: E,
}

def result_ok_with<T, E>(value: T, error_placeholder: E) -> Result<T, E> {
    Result { is_ok: true, value: value, error: error_placeholder }
}

def result_err_with<T, E>(value_placeholder: T, error: E) -> Result<T, E> {
    Result { is_ok: false, value: value_placeholder, error: error }
}

def result_ok_i64(value: i64) -> Result<i64, i64> {
    result_ok_with(value, 0)
}

def result_err_i64(error: i64) -> Result<i64, i64> {
    result_err_with(0, error)
}

def result_ok_bool(value: bool) -> Result<bool, i64> {
    result_ok_with(value, 0)
}

def result_err_bool(error: i64) -> Result<bool, i64> {
    result_err_with(false, error)
}

impl<T, E> Result<T, E> {
    def is_ok(self) -> bool {
        self.is_ok
    }

    def is_err(self) -> bool {
        if self.is_ok {
            false
        } else {
            true
        }
    }

    def unwrap_or(self, fallback: T) -> T {
        if self.is_ok {
            self.value
        } else {
            fallback
        }
    }

    def ok(self) -> Option<T> {
        if self.is_ok {
            Option { is_some: true, value: self.value }
        } else {
            Option { is_some: false, value: self.value }
        }
    }

    def err(self) -> Option<E> {
        if self.is_ok {
            Option { is_some: false, value: self.error }
        } else {
            Option { is_some: true, value: self.error }
        }
    }
}

impl Result<i64, i64> {
    def expect(self, msg: &str) -> i64 {
        if self.is_ok {
            self.value
        } else {
            print(msg);
            sengoo_panic_result_unwrap_i64()
        }
    }

    def unwrap(self) -> i64 {
        if self.is_ok {
            self.value
        } else {
            sengoo_panic_result_unwrap_i64()
        }
    }

    def map_add(self, delta: i64) -> Result<i64, i64> {
        if self.is_ok {
            result_ok_i64(self.value + delta)
        } else {
            result_err_i64(self.error)
        }
    }

    def and_then_mul(self, factor: i64) -> Result<i64, i64> {
        if self.is_ok {
            result_ok_i64(self.value * factor)
        } else {
            result_err_i64(self.error)
        }
    }

    def map_err_add(self, delta: i64) -> Result<i64, i64> {
        if self.is_ok {
            result_ok_i64(self.value)
        } else {
            result_err_i64(self.error + delta)
        }
    }
}
