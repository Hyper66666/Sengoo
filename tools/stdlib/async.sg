    inner: Arc<Mutex<T>>,
}

struct SharedCounterJobI64 {
    handle: i64,
}

def arc_new<T>(value: T) -> Arc<T> {
    Arc { handle: 0, marker: 0 }
}

def arc_new_i64(value: i64) -> Arc<i64> {
    arc_new(value)
}

def arc_new_bool(value: bool) -> Arc<bool> {
    arc_new(value)
}

def arc_borrow<T>(handle: i64) -> &T {
    arc_borrow(handle)
}

def mutex_new<T>(value: T) -> Mutex<T> {
    Mutex { handle: 0, marker: 0 }
}

def rwlock_new<T>(value: T) -> RwLock<T> {
    RwLock { handle: 0, marker: 0 }
}

def raw_mutex_guard_set<T>(handle: i64, value: T) -> bool {
    false
}

def raw_rwlock_write_guard_set<T>(handle: i64, guard_id: i64, value: T) -> bool {
    false
}

def raw_channel_send<T>(sender: &ChannelSender<T>, value: T) -> i64 {
    0
}

def raw_channel_recv<T>(receiver: &ChannelReceiver<T>) -> i64 {
    0
}

def raw_channel_value_move_into<T>(
    receiver: &ChannelReceiver<T>,
    value_handle: i64,
    output: &mut T,
) -> bool {
    false
}

impl<T> Arc<T> {
    def clone_arc(&self) -> Arc<T> {
        Arc { handle: sengoo_arc_clone(self.handle), marker: 0 }
    }

    def strong_count(&self) -> i64 {
        sengoo_arc_strong_count(self.handle)
    }

    def borrow(&self) -> &T {
        arc_borrow(self.handle)
    }
}

impl Arc<i64> {
    def get(&self) -> i64 {
        *self.borrow()
    }
}

impl Arc<bool> {
    def get(&self) -> bool {
        *self.borrow()
    }
}

impl<T> Drop for Arc<T> {
    def drop(&mut self) {
        sengoo_arc_drop(self.handle);
    }
}

def arc_mutex_new_i64(value: i64) -> ArcMutex<i64> {
    ArcMutex { inner: arc_new(mutex_new(value)) }
}

impl ArcMutex<i64> {
    def clone_arc_mutex(&self) -> Arc<Mutex<i64>> {
        self.inner.clone_arc()
    }

    def get(&self) -> i64 {
        sengoo_async_shared_counter_get_i64(self.inner.handle)
    }
}

impl SharedCounterJobI64 {
    def join(&self) -> i64 {
        sengoo_async_shared_counter_join_i64(self.handle)
    }
}

impl Drop for SharedCounterJobI64 {
    def drop(&mut self) {
        sengoo_async_shared_counter_job_drop(self.handle);
    }
}

impl MutexGuardI64 {
    def get(&self) -> i64 {
        sengoo_async_mutex_guard_get_i64(self.mutex_handle)
    }

    def set(&self, value: i64) {
        sengoo_async_mutex_guard_set_i64(self.mutex_handle, value);
    }
}

impl<T> MutexGuard<T> {
    def set(&mut self, value: T) -> bool {
        raw_mutex_guard_set(self.mutex_handle, value)
    }
}

def mutex_guard_copy_into<T: Copy>(guard: &MutexGuard<T>, output: &mut T) -> bool {
    false
}

impl MutexGuard<i64> {
    def get(&self) -> i64 {
        if !self.active { return 0; }
        sengoo_async_mutex_guard_get_i64(self.mutex_handle)
    }
}

impl MutexGuard<bool> {
    def get(&self) -> bool {
        if !self.active { return false; }
        sengoo_async_mutex_guard_get_i64(self.mutex_handle) != 0
    }
}

impl<T> Mutex<T> {
    def raw_handle(&self) -> i64 {
        self.handle
    }

    def make_guard(&self, handle: i64, active: bool) -> MutexGuard<T> {
        MutexGuard {
            mutex_handle: handle,
            marker: 0,
            active: active,
        }
    }
}

def raw_mutex_lock_async<T>(mutex: &Mutex<T>) -> i64 {
    sengoo_async_mutex_lock__start(mutex.raw_handle())
}

def raw_rwlock_read_async<T>(lock: &RwLock<T>) -> i64 {
    sengoo_async_rwlock_read__start((*lock).handle)
}

def raw_rwlock_write_async<T>(lock: &RwLock<T>) -> i64 {
    sengoo_async_rwlock_write__start((*lock).handle)
}

impl<T> Drop for Mutex<T> {
    def drop(&mut self) {
        sengoo_async_mutex_drop(self.handle);
    }
}

impl<T> Drop for MutexGuard<T> {
    def drop(&mut self) {
        if self.active {
            sengoo_async_mutex_guard_unlock(self.mutex_handle);
        }
    }
}

impl Drop for MutexGuardI64 {
    def drop(&mut self) {
        if self.active {
            sengoo_async_mutex_guard_unlock_i64(self.mutex_handle);
        }
    }
}

impl<T> RwLock<T> {
    def raw_handle(&self) -> i64 {
        self.handle
    }

    def make_read_guard(&self, guard_id: i64, active: bool) -> RwLockReadGuard<T> {
        RwLockReadGuard {
            lock_handle: self.handle,
            guard_id: guard_id,
            marker: 0,
            active: active,
        }
    }

    def make_write_guard(&self, guard_id: i64, active: bool) -> RwLockWriteGuard<T> {
        RwLockWriteGuard {
            lock_handle: self.handle,
            guard_id: guard_id,
            marker: 0,
            active: active,
        }
    }

    def close(&self) {
        sengoo_async_rwlock_close(self.handle);
    }
}

impl<T> Drop for RwLock<T> {
    def drop(&mut self) {
        sengoo_async_rwlock_drop(self.handle);
    }
}

