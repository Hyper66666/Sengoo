}

def channel_pair_drop(pair: ChannelPairI64) {
    sengoo_async_channel_pair_free(pair.handle);
}

def channel_sender_clone(sender: ChannelSenderI64) -> ChannelSenderI64 {
    ChannelSenderI64 { handle: sengoo_async_channel_sender_clone(sender.handle) }
}

def channel_sender_close(sender: ChannelSenderI64) {
    sengoo_async_channel_sender_close(sender.handle);
}

def channel_sender_drop(sender: ChannelSenderI64) {
    sengoo_async_channel_sender_drop(sender.handle);
}

def channel_send_i64(sender: ChannelSenderI64, value: i64) -> i64 {
    sengoo_async_channel_send_i64__start(sender.handle, value)
}

def channel_recv_i64(receiver: ChannelReceiverI64) -> i64 {
    sengoo_async_channel_recv_i64__start(receiver.handle)
}

def mutex_new_i64(value: i64) -> MutexI64 {
    MutexI64 { handle: sengoo_async_mutex_new_i64(value) }
}

def mutex_close(mutex: MutexI64) {
    sengoo_async_mutex_close(mutex.handle);
}

def mutex_drop(mutex: MutexI64) {
    sengoo_async_mutex_drop(mutex.handle);
}

def mutex_lock_async(mutex: MutexI64) -> i64 {
    sengoo_async_mutex_lock_i64__start(mutex.handle)
}

async def mutex_lock_guard_i64(mutex: MutexI64) -> Result<MutexGuardI64, i64> {
    let locked = await mutex_lock_async(mutex);
    if locked.is_ok {
        Result {
            is_ok: true,
            value: MutexGuardI64 {
                mutex_handle: mutex.handle,
                value: locked.value,
                active: true,
            },
            error: 0,
        }
    } else {
        Result {
            is_ok: false,
            value: MutexGuardI64 { mutex_handle: 0, value: 0, active: false },
            error: locked.error,
        }
    }
}

def mutex_unlock_i64(mutex: MutexI64, value: i64) -> Result<i64, i64> {
    let raw = sengoo_async_mutex_unlock_i64(mutex.handle, value);
    if raw >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: STATUS_INVALID_HANDLE() }
    }
}

def rwlock_new_i64(value: i64) -> RwLockI64 {
    RwLockI64 { handle: sengoo_async_rwlock_new_i64(value) }
}

def rwlock_close(lock: RwLockI64) {
    sengoo_async_rwlock_close(lock.handle);
}

def rwlock_drop(lock: RwLockI64) {
    sengoo_async_rwlock_drop(lock.handle);
}

def rwlock_try_read_guard<T>(lock: &RwLock<T>) -> Result<RwLockReadGuard<T>, i64> {
    let raw = sengoo_async_rwlock_try_read(lock.raw_handle());
    if raw > 0 {
        Result {
            is_ok: true,
            value: lock.make_read_guard(raw, true),
            error: 0,
        }
    } else {
        Result {
            is_ok: false,
            value: lock.make_read_guard(0, false),
            error: if raw == -11 { STATUS_TIMEOUT() } else { STATUS_INVALID_HANDLE() },
        }
    }
}

def rwlock_try_write_guard<T>(lock: &RwLock<T>) -> Result<RwLockWriteGuard<T>, i64> {
    let raw = sengoo_async_rwlock_try_write(lock.raw_handle());
    if raw > 0 {
        Result {
            is_ok: true,
            value: lock.make_write_guard(raw, true),
            error: 0,
        }
    } else {
        Result {
            is_ok: false,
            value: lock.make_write_guard(0, false),
            error: if raw == -11 { STATUS_TIMEOUT() } else { STATUS_INVALID_HANDLE() },
        }
    }
}

def rwlock_try_read_guard_i64(lock: RwLockI64) -> Result<RwLockReadGuardI64, i64> {
    let raw = sengoo_async_rwlock_try_read_i64(lock.handle);
    if raw > 0 {
        Result {
            is_ok: true,
            value: RwLockReadGuardI64 {
                lock_handle: lock.handle,
                guard_id: raw,
                active: true,
            },
            error: 0,
        }
    } else {
        Result {
            is_ok: false,
            value: RwLockReadGuardI64 { lock_handle: 0, guard_id: 0, active: false },
            error: if raw == -11 { STATUS_TIMEOUT() } else { STATUS_INVALID_HANDLE() },
        }
    }
}

def rwlock_try_write_guard_i64(lock: RwLockI64) -> Result<RwLockWriteGuardI64, i64> {
    let raw = sengoo_async_rwlock_try_write_i64(lock.handle);
    if raw > 0 {
        Result {
            is_ok: true,
            value: RwLockWriteGuardI64 {
                lock_handle: lock.handle,
                guard_id: raw,
                active: true,
            },
            error: 0,
        }
    } else {
        Result {
            is_ok: false,
            value: RwLockWriteGuardI64 { lock_handle: 0, guard_id: 0, active: false },
            error: if raw == -11 { STATUS_TIMEOUT() } else { STATUS_INVALID_HANDLE() },
        }
    }
}
