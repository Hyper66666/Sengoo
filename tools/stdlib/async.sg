def runtime_enable_thread_pool(worker_count: i64) -> Result<i64, i64> {
    let raw = sengoo_async_runtime_enable_thread_pool(worker_count);
    if raw >= 0 {
        Result { is_ok: true, value: raw, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: STATUS_INVALID_ARGUMENT() }
    }
}

def runtime_enable_executor(worker_count: i64, capacity: i64) -> Result<i64, i64> {
    let raw = sengoo_async_runtime_enable_executor(worker_count, capacity);
    if raw >= 0 {
        Result { is_ok: true, value: raw, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: status_from_raw_ffi(raw) }
    }
}

def runtime_executor_enabled() -> bool {
    sengoo_async_runtime_executor_enabled()
}

def task_join(task_id: i64) -> i64 {
    sengoo_async_join_task(task_id)
}

def runtime_shutdown_executor(cancel_pending: bool) -> i64 {
    sengoo_async_runtime_shutdown_executor(cancel_pending)
}

def spawn_blocking_future_i64(work: fn() -> i64) -> i64 {
    sengoo_async_spawn_blocking_i64__start(work)
}

def spawn_blocking_i64(work: fn() -> i64) -> Result<i64, i64> {
    if !sengoo_async_runtime_thread_pool_enabled() {
        Result { is_ok: false, value: 0, error: STATUS_UNSUPPORTED() }
    } else {
        let handle = sengoo_async_spawn_blocking_i64__start(work);
        if handle == 0 {
            Result { is_ok: false, value: 0, error: STATUS_UNSUPPORTED() }
        } else {
            Result { is_ok: true, value: handle, error: 0 }
        }
    }
}

def spawn_shared_counter_i64(
    shared: Arc<Mutex<i64>>,
    delta: i64,
    repetitions: i64,
) -> Result<SharedCounterJobI64, i64> {
    if repetitions < 0 {
        Result {
            is_ok: false,
            value: SharedCounterJobI64 { handle: 0 },
            error: STATUS_INVALID_ARGUMENT(),
        }
    } else {
        let handle = sengoo_async_shared_counter_spawn_add_i64(
            shared.handle,
            delta,
            repetitions,
        );
        if handle == 0 {
            Result {
                is_ok: false,
                value: SharedCounterJobI64 { handle: 0 },
                error: STATUS_UNSUPPORTED(),
            }
        } else {
            Result {
                is_ok: true,
                value: SharedCounterJobI64 { handle: handle },
                error: 0,
            }
        }
    }
}

async def mutex_lock_guard<T>(mutex: &Mutex<T>) -> Result<MutexGuard<T>, i64> {
    let status = await raw_mutex_lock_async(mutex);
    if status == 0 {
        let result: Result<MutexGuard<T>, i64> = Result {
            is_ok: true,
            value: mutex.make_guard(mutex.raw_handle(), true),
            error: 0,
        };
        result
    } else {
        let result: Result<MutexGuard<T>, i64> = Result {
            is_ok: false,
            value: mutex.make_guard(0, false),
            error: status,
        };
        result
    }
}

async def rwlock_read_guard<T>(lock: &RwLock<T>) -> Result<RwLockReadGuard<T>, i64> {
    let guard_id = await raw_rwlock_read_async(lock);
    if guard_id > 0 {
        Result {
            is_ok: true,
            value: lock.make_read_guard(guard_id, true),
            error: 0,
        }
    } else {
        Result {
            is_ok: false,
            value: lock.make_read_guard(0, false),
            error: status_from_raw_ffi(guard_id),
        }
    }
}

async def rwlock_write_guard<T>(lock: &RwLock<T>) -> Result<RwLockWriteGuard<T>, i64> {
    let guard_id = await raw_rwlock_write_async(lock);
    if guard_id > 0 {
        Result {
            is_ok: true,
            value: lock.make_write_guard(guard_id, true),
            error: 0,
        }
    } else {
        Result {
            is_ok: false,
            value: lock.make_write_guard(0, false),
            error: status_from_raw_ffi(guard_id),
        }
    }
}

def channel<T: Send>(capacity: i64) -> ChannelPair<T> {
    ChannelPair { handle: 0, marker: 0 }
}

def channel_sender<T>(pair: &ChannelPair<T>) -> ChannelSender<T> {
    ChannelSender {
        handle: sengoo_async_channel_pair_sender((*pair).handle),
        marker: 0,
    }
}

def channel_receiver<T>(pair: &ChannelPair<T>) -> ChannelReceiver<T> {
    ChannelReceiver {
        handle: sengoo_async_channel_pair_receiver((*pair).handle),
        marker: 0,
    }
}

def channel_clone_sender<T>(sender: &ChannelSender<T>) -> ChannelSender<T> {
    ChannelSender {
        handle: sengoo_async_channel_sender_clone((*sender).handle),
        marker: 0,
    }
}

async def channel_send<T: Send>(
    sender: &ChannelSender<T>,
    value: T,
) -> Result<i64, i64> {
    let status = await raw_channel_send(sender, value);
    if status == 0 {
        Result { is_ok: true, value: 0, error: 0 }
    } else {
        Result {
            is_ok: false,
            value: 0,
            error: status_from_raw_ffi(status),
        }
    }
}

async def channel_recv_into<T>(
    receiver: &ChannelReceiver<T>,
    output: &mut T,
) -> Result<i64, i64> {
    let value_handle = await raw_channel_recv(receiver);
    if value_handle > 0 {
        if raw_channel_value_move_into(receiver, value_handle, output) {
            Result { is_ok: true, value: 0, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: STATUS_INVALID_HANDLE() }
        }
    } else {
        Result {
            is_ok: false,
            value: 0,
            error: if value_handle < 0 { status_from_raw_ffi(value_handle) } else { STATUS_INVALID_HANDLE() },
        }
    }
}

impl<T> Drop for ChannelPair<T> {
    def drop(&mut self) {
        if self.handle != 0 {
            sengoo_async_channel_pair_free(self.handle);
        }
    }
}

impl<T> Drop for ChannelSender<T> {
    def drop(&mut self) {
        if self.handle != 0 {
            sengoo_async_channel_sender_drop(self.handle);
        }
    }
}

impl<T> Drop for ChannelReceiver<T> {
    def drop(&mut self) {
        if self.handle != 0 {
            sengoo_async_channel_receiver_drop(self.handle);
        }
    }
}

def channel_bounded(capacity: i64) -> Result<ChannelPairI64, i64> {
    channel_bounded_i64(capacity)
}

def channel_bounded_i64(capacity: i64) -> Result<ChannelPairI64, i64> {
    let pair = sengoo_async_channel_bounded_i64(capacity);
    if pair == 0 {
        Result { is_ok: false, value: ChannelPairI64 { handle: 0 }, error: STATUS_INVALID_ARGUMENT() }
    } else {
        Result { is_ok: true, value: ChannelPairI64 { handle: pair }, error: 0 }
    }
}

