struct TaskScope {
    handle: i64,
}

impl !Send for TaskScope {}
impl !Sync for TaskScope {}

impl Drop for TaskScope {
    def drop(&mut self) {
        if self.handle > 0 {
            sengoo_async_task_scope_cancel_join(self.handle);
        }
    }
}

