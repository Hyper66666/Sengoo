extern "C" {
    fn sengoo_panic_option_unwrap_i64() -> i64;
}

enum Option<T> {
    None,
    Some(T),
}

def option_some<T>(value: T) -> Option<T> {
    Some(value)
}

#[deprecated(message = "`None` carries no payload; the placeholder is ignored", replacement = "None", removal = "the release after next")]
def option_none_with<T>(placeholder: T) -> Option<T> {
    None
}

def option_none<T>() -> Option<T> {
    None
}

def option_some_i64(value: i64) -> Option<i64> {
    Some(value)
}

def option_none_i64() -> Option<i64> {
    None
}

def option_some_bool(value: bool) -> Option<bool> {
    Some(value)
}

def option_none_bool() -> Option<bool> {
    None
}

impl<T> Option<T> {
    def is_some(&self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    def is_none(&self) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }

    def unwrap_or(self, fallback: T) -> T {
        match self {
            Some(value) => value,
            None => fallback,
        }
    }

    def ok_or<E>(self, error: E) -> Result<T, E> {
        match self {
            Some(value) => Ok(value),
            None => Err(error),
        }
    }
}

impl Option<i64> {
    def expect(self, msg: &str) -> i64 {
        match self {
            Some(value) => value,
            None => {
                print(msg);
                sengoo_panic_option_unwrap_i64()
            }
        }
    }

    def unwrap(self) -> i64 {
        match self {
            Some(value) => value,
            None => sengoo_panic_option_unwrap_i64(),
        }
    }

    def map_add(self, delta: i64) -> Option<i64> {
        match self {
            Some(value) => Some(value + delta),
            None => None,
        }
    }

    def and_then_mul(self, factor: i64) -> Option<i64> {
        match self {
            Some(value) => Some(value * factor),
            None => None,
        }
    }
}

impl Option<bool> {
    def expect(self, msg: &str) -> bool {
        match self {
            Some(value) => value,
            None => {
                print(msg);
                sengoo_panic_option_unwrap_i64() != 0
            }
        }
    }

    def unwrap(self) -> bool {
        match self {
            Some(value) => value,
            None => sengoo_panic_option_unwrap_i64() != 0,
        }
    }
}
