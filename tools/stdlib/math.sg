def abs_f64(value: f64) -> f64 {
    if value < 0.0 {
        0.0 - value
    } else {
        value
    }
}

def min_f64(lhs: f64, rhs: f64) -> f64 {
    if lhs < rhs {
        lhs
    } else {
        rhs
    }
}

def max_f64(lhs: f64, rhs: f64) -> f64 {
    if lhs > rhs {
        lhs
    } else {
        rhs
    }
}

def abs_f32(value: f32) -> f32 {
    if value < 0.0f32 {
        0.0f32 - value
    } else {
        value
    }
}

def min_f32(lhs: f32, rhs: f32) -> f32 {
    if lhs < rhs {
        lhs
    } else {
        rhs
    }
}

def max_f32(lhs: f32, rhs: f32) -> f32 {
    if lhs > rhs {
        lhs
    } else {
        rhs
    }
}

def sqrt_f32(value: f32) -> f32 {
    sengoo_f32_sqrt(value)
}

def pow_f32(base: f32, exp: f32) -> f32 {
    sengoo_f32_pow(base, exp)
}

def exp_f32(value: f32) -> f32 {
    sengoo_f32_exp(value)
}

def ln_f32(value: f32) -> f32 {
    sengoo_f32_ln(value)
}

def floor_f32(value: f32) -> f32 {
    sengoo_f32_floor(value)
}

def ceil_f32(value: f32) -> f32 {
    sengoo_f32_ceil(value)
}

def round_f32(value: f32) -> f32 {
    sengoo_f32_round(value)
}

def sin_f32(value: f32) -> f32 {
    sengoo_f32_sin(value)
}

def cos_f32(value: f32) -> f32 {
    sengoo_f32_cos(value)
}

def tan_f32(value: f32) -> f32 {
    sengoo_f32_tan(value)
}

def sqrt_f64(value: f64) -> f64 {
    sengoo_f64_sqrt(value)
}

def pow_f64(base: f64, exp: f64) -> f64 {
    sengoo_f64_pow(base, exp)
}

def exp_f64(value: f64) -> f64 {
    sengoo_f64_exp(value)
}

def ln_f64(value: f64) -> f64 {
    sengoo_f64_ln(value)
}

def floor_f64(value: f64) -> f64 {
    sengoo_f64_floor(value)
}

def ceil_f64(value: f64) -> f64 {
    sengoo_f64_ceil(value)
}

def round_f64(value: f64) -> f64 {
