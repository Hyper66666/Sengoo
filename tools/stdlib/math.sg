impl i64 {
    def wrapping_add(self, rhs: i64) -> i64 {
        sengoo_i64_wrapping_add(self, rhs)
    }

    def wrapping_sub(self, rhs: i64) -> i64 {
        sengoo_i64_wrapping_sub(self, rhs)
    }

    def wrapping_mul(self, rhs: i64) -> i64 {
        sengoo_i64_wrapping_mul(self, rhs)
    }

    def checked_add(self, rhs: i64) -> Option<i64> {
        if sengoo_i64_checked_add_ok(self, rhs) != 0 {
            option_some_i64(self + rhs)
        } else {
            option_none_i64()
        }
    }

    def checked_sub(self, rhs: i64) -> Option<i64> {
        if sengoo_i64_checked_sub_ok(self, rhs) != 0 {
            option_some_i64(self - rhs)
        } else {
            option_none_i64()
        }
    }

    def checked_mul(self, rhs: i64) -> Option<i64> {
        if sengoo_i64_checked_mul_ok(self, rhs) != 0 {
            option_some_i64(self * rhs)
        } else {
            option_none_i64()
        }
    }

    def saturating_add(self, rhs: i64) -> i64 {
        sengoo_i64_saturating_add(self, rhs)
    }

    def saturating_sub(self, rhs: i64) -> i64 {
        sengoo_i64_saturating_sub(self, rhs)
    }

    def saturating_mul(self, rhs: i64) -> i64 {
        sengoo_i64_saturating_mul(self, rhs)
    }
}

impl i32 {
    def wrapping_add(self, rhs: i32) -> i32 {
        ((self as i64) + (rhs as i64)) as i32
    }

    def wrapping_sub(self, rhs: i32) -> i32 {
        ((self as i64) - (rhs as i64)) as i32
    }

    def wrapping_mul(self, rhs: i32) -> i32 {
        ((self as i64) * (rhs as i64)) as i32
    }

    def checked_add(self, rhs: i32) -> Option<i32> {
        let result = (self as i64) + (rhs as i64);
        if result < -2147483648 {
            option_none_with(0i32)
        } else if result > 2147483647 {
            option_none_with(0i32)
        } else {
            option_some(result as i32)
        }
    }

    def checked_sub(self, rhs: i32) -> Option<i32> {
        let result = (self as i64) - (rhs as i64);
        if result < -2147483648 {
            option_none_with(0i32)
        } else if result > 2147483647 {
            option_none_with(0i32)
        } else {
            option_some(result as i32)
        }
    }

    def checked_mul(self, rhs: i32) -> Option<i32> {
        let result = (self as i64) * (rhs as i64);
        if result < -2147483648 {
            option_none_with(0i32)
        } else if result > 2147483647 {
            option_none_with(0i32)
        } else {
            option_some(result as i32)
        }
    }

    def saturating_add(self, rhs: i32) -> i32 {
        let result = (self as i64) + (rhs as i64);
        if result < -2147483648 {
            -2147483648i32
        } else if result > 2147483647 {
            2147483647i32
        } else {
            result as i32
        }
    }

    def saturating_sub(self, rhs: i32) -> i32 {
        let result = (self as i64) - (rhs as i64);
        if result < -2147483648 {
            -2147483648i32
        } else if result > 2147483647 {
            2147483647i32
        } else {
            result as i32
        }
    }

    def saturating_mul(self, rhs: i32) -> i32 {
        let result = (self as i64) * (rhs as i64);
        if result < -2147483648 {
            -2147483648i32
        } else if result > 2147483647 {
            2147483647i32
        } else {
            result as i32
        }
    }
}

