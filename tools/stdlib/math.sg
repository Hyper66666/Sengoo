}

trait Into<T> {
    def into(self) -> T {}
}

trait From<T> {
    def from_value(value: T) -> Self {}
}

trait NumericOrder<T> {
    def numeric_abs_value(self) -> T {}
    def numeric_min_value(self, rhs: T) -> T {}
    def numeric_max_value(self, rhs: T) -> T {}
    def numeric_clamp_value(self, lower: T, upper: T) -> T {}
}

def numeric_abs<T>(value: T) -> T where T: NumericOrder<T> {
    value.numeric_abs_value()
}

def numeric_min<T>(lhs: T, rhs: T) -> T where T: NumericOrder<T> {
    lhs.numeric_min_value(rhs)
}

def numeric_max<T>(lhs: T, rhs: T) -> T where T: NumericOrder<T> {
    lhs.numeric_max_value(rhs)
}

def numeric_clamp<T>(value: T, lower: T, upper: T) -> T where T: NumericOrder<T> {
    value.numeric_clamp_value(lower, upper)
}

impl NumericOrder<i64> for i64 {
    def numeric_abs_value(self) -> i64 { abs_i64(self) }
    def numeric_min_value(self, rhs: i64) -> i64 { min_i64(self, rhs) }
    def numeric_max_value(self, rhs: i64) -> i64 { max_i64(self, rhs) }
    def numeric_clamp_value(self, lower: i64, upper: i64) -> i64 {
        clamp_i64(self, lower, upper)
    }
}

impl NumericOrder<i32> for i32 {
    def numeric_abs_value(self) -> i32 {
        if self < 0i32 { 0i32 - self } else { self }
    }
    def numeric_min_value(self, rhs: i32) -> i32 {
        if self < rhs { self } else { rhs }
    }
    def numeric_max_value(self, rhs: i32) -> i32 {
        if self > rhs { self } else { rhs }
    }
    def numeric_clamp_value(self, lower: i32, upper: i32) -> i32 {
        let minimum = self.numeric_min_value(upper);
        minimum.numeric_max_value(lower)
    }
}

