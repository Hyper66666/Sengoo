def tan_f64(value: f64) -> f64 {
    sengoo_f64_tan(value)
}

def is_nan_f64(value: f64) -> bool {
    sengoo_f64_is_nan(value) != 0
}

def is_finite_f64(value: f64) -> bool {
    sengoo_f64_is_finite(value) != 0
}

def is_infinite_f64(value: f64) -> bool {
    sengoo_f64_is_infinite(value) != 0
}

