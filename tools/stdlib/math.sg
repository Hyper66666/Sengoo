def usize_max_value() -> usize {
    sengoo_u64_wrapping_sub(0u64, 1u64) as usize
}

def isize_max_value() -> isize {
    (usize_max_value() >> 1usize) as isize
}

def isize_min_value() -> isize {
    0isize - isize_max_value() - 1isize
}

impl usize {
    def wrapping_add(self, rhs: usize) -> usize {
        sengoo_u64_wrapping_add(self as u64, rhs as u64) as usize
    }

    def wrapping_sub(self, rhs: usize) -> usize {
        sengoo_u64_wrapping_sub(self as u64, rhs as u64) as usize
    }

    def wrapping_mul(self, rhs: usize) -> usize {
        sengoo_u64_wrapping_mul(self as u64, rhs as u64) as usize
    }

    def checked_add(self, rhs: usize) -> Option<usize> {
        let max = usize_max_value();
        if rhs > max - self {
            option_none_with(0usize)
        } else {
            option_some(self + rhs)
        }
    }

    def checked_sub(self, rhs: usize) -> Option<usize> {
        if self < rhs {
            option_none_with(0usize)
        } else {
            option_some(self - rhs)
        }
    }

    def checked_mul(self, rhs: usize) -> Option<usize> {
        let max = usize_max_value();
        if self != 0usize && rhs > max / self {
            option_none_with(0usize)
        } else {
            option_some(self * rhs)
        }
    }

    def saturating_add(self, rhs: usize) -> usize {
        let max = usize_max_value();
        if rhs > max - self { max } else { self + rhs }
    }

    def saturating_sub(self, rhs: usize) -> usize {
        if self < rhs { 0usize } else { self - rhs }
    }

    def saturating_mul(self, rhs: usize) -> usize {
        let max = usize_max_value();
        if self != 0usize && rhs > max / self { max } else { self * rhs }
    }
}

impl isize {
    def wrapping_add(self, rhs: isize) -> isize {
        sengoo_i64_wrapping_add(self as i64, rhs as i64) as isize
    }

    def wrapping_sub(self, rhs: isize) -> isize {
        sengoo_i64_wrapping_sub(self as i64, rhs as i64) as isize
    }

    def wrapping_mul(self, rhs: isize) -> isize {
        sengoo_i64_wrapping_mul(self as i64, rhs as i64) as isize
    }

    def checked_add(self, rhs: isize) -> Option<isize> {
        if sengoo_i64_checked_add_ok(self as i64, rhs as i64) != 0 {
            let value = (self as i64) + (rhs as i64);
            if value < (isize_min_value() as i64) || value > (isize_max_value() as i64) {
                option_none_with(0isize)
            } else {
                option_some(value as isize)
            }
        } else {
            option_none_with(0isize)
        }
    }

    def checked_sub(self, rhs: isize) -> Option<isize> {
        if sengoo_i64_checked_sub_ok(self as i64, rhs as i64) != 0 {
            let value = (self as i64) - (rhs as i64);
            if value < (isize_min_value() as i64) || value > (isize_max_value() as i64) {
                option_none_with(0isize)
            } else {
                option_some(value as isize)
            }
        } else {
            option_none_with(0isize)
        }
    }

    def checked_mul(self, rhs: isize) -> Option<isize> {
        if sengoo_i64_checked_mul_ok(self as i64, rhs as i64) != 0 {
            let value = (self as i64) * (rhs as i64);
            if value < (isize_min_value() as i64) || value > (isize_max_value() as i64) {
                option_none_with(0isize)
            } else {
                option_some(value as isize)
            }
        } else {
            option_none_with(0isize)
        }
    }

    def saturating_add(self, rhs: isize) -> isize {
        let value = sengoo_i64_saturating_add(self as i64, rhs as i64);
        if value < (isize_min_value() as i64) {
            isize_min_value()
        } else if value > (isize_max_value() as i64) {
            isize_max_value()
        } else {
            value as isize
        }
    }

    def saturating_sub(self, rhs: isize) -> isize {
        let value = sengoo_i64_saturating_sub(self as i64, rhs as i64);
        if value < (isize_min_value() as i64) {
            isize_min_value()
        } else if value > (isize_max_value() as i64) {
            isize_max_value()
        } else {
            value as isize
        }
    }

    def saturating_mul(self, rhs: isize) -> isize {
        let value = sengoo_i64_saturating_mul(self as i64, rhs as i64);
        if value < (isize_min_value() as i64) {
            isize_min_value()
        } else if value > (isize_max_value() as i64) {
            isize_max_value()
        } else {
            value as isize
        }
    }
}

