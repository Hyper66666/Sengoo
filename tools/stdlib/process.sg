extern "C" {
    fn sengoo_process_id() -> i64;
    fn sengoo_process_current_dir_len() -> i64;
    fn sengoo_process_current_dir_copy(out_buffer: i64, out_capacity: i64) -> i64;
    fn sengoo_process_run(executable: i64, arg0: i64, arg1: i64, arg2: i64, arg_count: i64) -> i64;
    fn sengoo_process_command_new(executable: i64) -> i64;
    fn sengoo_process_command_arg(handle: i64, arg: i64) -> i64;
    fn sengoo_process_command_cwd(handle: i64, cwd: i64) -> i64;
    fn sengoo_process_command_env_set(handle: i64, name: i64, value: i64) -> i64;
    fn sengoo_process_command_env_remove(handle: i64, name: i64) -> i64;
    fn sengoo_process_command_env_clear(handle: i64) -> i64;
    fn sengoo_process_command_capture_stdout(handle: i64, capture: i64) -> i64;
    fn sengoo_process_command_capture_stderr(handle: i64, capture: i64) -> i64;
    fn sengoo_process_command_timeout_ms(handle: i64, timeout_ms: i64) -> i64;
    fn sengoo_process_command_run(handle: i64) -> i64;
    fn sengoo_process_command_close(handle: i64) -> i64;
    fn sengoo_process_output_exit_code(handle: i64) -> i64;
    fn sengoo_process_output_timed_out(handle: i64) -> i64;
    fn sengoo_process_output_stdout_len(handle: i64) -> i64;
    fn sengoo_process_output_stderr_len(handle: i64) -> i64;
    fn sengoo_process_output_stdout_copy(handle: i64, out_buffer: i64, out_capacity: i64) -> i64;
    fn sengoo_process_output_stderr_copy(handle: i64, out_buffer: i64, out_capacity: i64) -> i64;
    fn sengoo_process_output_close(handle: i64) -> i64;
    fn sengoo_process_command_pipe_stdout_to(upstream: i64, downstream: i64) -> i64;
    fn sengoo_process_command_spawn(handle: i64) -> i64;
    fn sengoo_process_handle_wait(handle: i64, timeout_ms: i64) -> i64;
    fn sengoo_process_handle_wait_cancellable(handle: i64, timeout_ms: i64) -> i64;
    fn sengoo_process_handle_kill(handle: i64) -> i64;
    fn sengoo_process_handle_exit_code(handle: i64) -> i64;
    fn sengoo_process_handle_close(handle: i64) -> i64;
    fn sengoo_process_command_spawn_piped(handle: i64) -> i64;
    fn sengoo_process_command_spawn_detached(handle: i64, identity_buffer: i64) -> i64;
    fn sengoo_process_identity_matches(pid: i64, creation_identity: i64) -> i64;
    fn sengoo_process_handle_try_wait(handle: i64) -> i64;
    fn sengoo_process_handle_tree_quiescent(handle: i64) -> i64;
    fn sengoo_process_handle_read(handle: i64, stream: i64, buffer: i64) -> i64;
    fn sengoo_process_handle_stream_eof(handle: i64, stream: i64) -> i64;
    fn sengoo_process_handle_write_stdin(handle: i64, buffer: i64, used_len: i64) -> i64;
    fn sengoo_process_handle_try_write_stdin(handle: i64, buffer: i64, used_len: i64) -> i64;
    fn sengoo_process_handle_close_stdin(handle: i64) -> i64;
    fn sengoo_process_handle_terminate_tree(handle: i64) -> i64;
    fn sengoo_process_handle_reap(handle: i64, timeout_ms: i64) -> i64;
    fn sengoo_process_live_handle_count() -> i64;
    fn sengoo_process_live_resource_count() -> i64;
}

struct ProcessCommand {
    handle: i64,
}

struct ProcessOutput {
    handle: i64,
}

struct ProcessHandle {
    handle: i64,
}

// Plain launch evidence; owns no process handle and Drop never kills the child.
struct ProcessLaunchReceipt {
    pid: i64,
    creation_identity: i64,
}

def process_identity_matches(pid: i64, creation_identity: i64) -> Result<bool, i64> {
    process_status_bool_result(sengoo_process_identity_matches(pid, creation_identity))
}

impl ProcessLaunchReceipt {
    def is_running(&self) -> Result<bool, i64> {
        process_identity_matches(self.pid, self.creation_identity)
    }
}

impl !Send for ProcessCommand {}
impl !Sync for ProcessCommand {}
impl !Send for ProcessOutput {}
impl !Sync for ProcessOutput {}
impl !Send for ProcessHandle {}
impl !Sync for ProcessHandle {}

def process_i64_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: status_from_raw_ffi(value) }
    }
}

def process_status_i64_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: status_from_raw_ffi(value) }
    }
}

def process_status_bool_result(value: i64) -> Result<bool, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value != 0, error: 0 }
    } else {
        Result { is_ok: false, value: false, error: status_from_raw_ffi(value) }
    }
}

def process_id() -> i64 {
    sengoo_process_id()
}

def process_current_dir_len() -> Result<i64, i64> {
    process_i64_result(sengoo_process_current_dir_len())
}

def process_current_dir_copy_raw(buffer_ptr: i64, capacity: i64) -> Result<i64, i64> {
    process_i64_result(sengoo_process_current_dir_copy(buffer_ptr, capacity))
}

def process_current_dir_copy(buffer: Buffer) -> Result<i64, i64> {
    process_current_dir_copy_raw(buffer.ptr(), buffer.len())
}

def process_exit_code(success: bool, failure_code: i64) -> i64 {
    if success {
        0
    } else {
        failure_code
    }
}

def process_run_raw(executable_ptr: i64, arg0_ptr: i64, arg1_ptr: i64, arg2_ptr: i64, arg_count: i64) -> Result<i64, i64> {
    process_i64_result(sengoo_process_run(executable_ptr, arg0_ptr, arg1_ptr, arg2_ptr, arg_count))
}

def process_run(executable: &str) -> Result<i64, i64> {
    process_run_raw(sengoo_stdlib_str_ptr(executable), 0, 0, 0, 0)
}

def process_run_1(executable: &str, arg0: &str) -> Result<i64, i64> {
    process_run_raw(sengoo_stdlib_str_ptr(executable), sengoo_stdlib_str_ptr(arg0), 0, 0, 1)
}

def process_run_2(executable: &str, arg0: &str, arg1: &str) -> Result<i64, i64> {
    process_run_raw(
        sengoo_stdlib_str_ptr(executable),
        sengoo_stdlib_str_ptr(arg0),
        sengoo_stdlib_str_ptr(arg1),
        0,
        2,
    )
}

def process_run_3(executable: &str, arg0: &str, arg1: &str, arg2: &str) -> Result<i64, i64> {
    process_run_raw(
        sengoo_stdlib_str_ptr(executable),
        sengoo_stdlib_str_ptr(arg0),
        sengoo_stdlib_str_ptr(arg1),
        sengoo_stdlib_str_ptr(arg2),
        3,
    )
}

def process_command_raw(executable_ptr: i64) -> Result<ProcessCommand, i64> {
    let handle = sengoo_process_command_new(executable_ptr);
    if handle != 0 {
        Result { is_ok: true, value: ProcessCommand { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: ProcessCommand { handle: 0 }, error: STATUS_UNKNOWN() }
    }
}

def process_command(executable: &str) -> Result<ProcessCommand, i64> {
    process_command_raw(sengoo_stdlib_str_ptr(executable))
}

def process_output_handle_result(handle: i64) -> Result<ProcessOutput, i64> {
    if handle != 0 {
        Result { is_ok: true, value: ProcessOutput { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: ProcessOutput { handle: 0 }, error: STATUS_UNKNOWN() }
    }
}

def process_handle_result(handle: i64) -> Result<ProcessHandle, i64> {
    if handle > 0 {
        Result { is_ok: true, value: ProcessHandle { handle: handle }, error: 0 }
    } else if handle < 0 {
        Result { is_ok: false, value: ProcessHandle { handle: 0 }, error: status_from_raw_ffi(handle) }
    } else {
        Result { is_ok: false, value: ProcessHandle { handle: 0 }, error: STATUS_UNKNOWN() }
    }
}

impl ProcessCommand {
    def arg_raw(self, arg_ptr: i64) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_command_arg(self.handle, arg_ptr))
    }

    def arg(self, value: &str) -> Result<bool, i64> {
        self.arg_raw(sengoo_stdlib_str_ptr(value))
    }

    def cwd_raw(self, cwd_ptr: i64) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_command_cwd(self.handle, cwd_ptr))
    }

    def cwd(self, value: &str) -> Result<bool, i64> {
        self.cwd_raw(sengoo_stdlib_str_ptr(value))
    }

    def env_set_raw(self, name_ptr: i64, value_ptr: i64) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_command_env_set(self.handle, name_ptr, value_ptr))
    }

    def env_set(self, name: &str, value: &str) -> Result<bool, i64> {
        self.env_set_raw(sengoo_stdlib_str_ptr(name), sengoo_stdlib_str_ptr(value))
    }

    def env_remove_raw(self, name_ptr: i64) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_command_env_remove(self.handle, name_ptr))
    }

    def env_remove(self, name: &str) -> Result<bool, i64> {
        self.env_remove_raw(sengoo_stdlib_str_ptr(name))
    }

    def env_clear(self) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_command_env_clear(self.handle))
    }

    def capture_stdout(self, capture: bool) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_command_capture_stdout(self.handle, if capture { 1 } else { 0 }))
    }

    def capture_stderr(self, capture: bool) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_command_capture_stderr(self.handle, if capture { 1 } else { 0 }))
    }

    def timeout_ms(self, timeout_ms: i64) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_command_timeout_ms(self.handle, timeout_ms))
    }

    def run(self) -> Result<ProcessOutput, i64> {
        process_output_handle_result(sengoo_process_command_run(self.handle))
    }

    def pipe_stdout_to(self, child: ProcessCommand) -> Result<ProcessCommand, i64> {
        let merged = sengoo_process_command_pipe_stdout_to(self.handle, child.handle);
        if merged > 0 {
            Result { is_ok: true, value: ProcessCommand { handle: merged }, error: 0 }
        } else if merged < 0 {
            Result { is_ok: false, value: ProcessCommand { handle: 0 }, error: status_from_raw_ffi(merged) }
        } else {
            Result { is_ok: false, value: ProcessCommand { handle: 0 }, error: STATUS_UNKNOWN() }
        }
    }

    def spawn(self) -> Result<ProcessHandle, i64> {
        process_handle_result(sengoo_process_command_spawn(self.handle))
    }

    def spawn_piped(&self) -> Result<ProcessHandle, i64> {
        process_handle_result(sengoo_process_command_spawn_piped(self.handle));
    }
    // Explicit detached launch: no caller stdio/handles or launcher-owned
    // kill job. Windows only; a parent job that forbids breakaway is an error.
    def spawn_detached(&self) -> Result<ProcessLaunchReceipt, i64> {
        let identity = ffi_buffer_new(8)?;
        let raw = sengoo_process_command_spawn_detached(self.handle, identity.raw_handle());
        if raw <= 0 { return Result { is_ok: false, value: ProcessLaunchReceipt { pid: 0, creation_identity: 0 }, error: status_from_raw_ffi(raw) }; };
        let mut birth = 0;
        let mut multiplier = 1;
        let mut index = 0;
        while index < 8 {
            birth = birth + identity.get_u8(index)? * multiplier;
            if index < 7 { multiplier = multiplier * 256; };
            index = index + 1;
        };
        Result { is_ok: true, value: ProcessLaunchReceipt { pid: raw, creation_identity: birth }, error: 0 }
    }
    def close(self) -> bool {
        sengoo_process_command_close(self.handle) == 0
    }
}

impl Drop for ProcessCommand {
    def drop(&mut self) {
        sengoo_process_command_close(self.handle);
    }
}

impl ProcessHandle {
    def try_wait(&self) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_handle_try_wait(self.handle));
    }
    def tree_quiescent(&self) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_handle_tree_quiescent(self.handle))
    }
    def read_stdout(&self, out: &mut Buffer) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_handle_read(self.handle, 1, out.raw_handle()));
    }
    def read_stderr(&self, out: &mut Buffer) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_handle_read(self.handle, 2, out.raw_handle()));
    }
    def stdout_eof(&self) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_handle_stream_eof(self.handle, 1));
    }
    def stderr_eof(&self) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_handle_stream_eof(self.handle, 2));
    }
    def write_stdin(&self, data: &Buffer, used_len: i64) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_handle_write_stdin(self.handle, data.raw_handle(), used_len));
    }
    // Alias with explicit nonblocking intent: partial count or 0 backpressure.
    def try_write_stdin(&self, data: &Buffer, used_len: i64) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_handle_try_write_stdin(self.handle, data.raw_handle(), used_len));
    }
    def close_stdin(&self) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_handle_close_stdin(self.handle));
    }
    def terminate_tree(&self) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_handle_terminate_tree(self.handle));
    }
    def reap(&self, timeout_ms: i64) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_handle_reap(self.handle, timeout_ms));
    }

    def wait(self, timeout_ms: i64) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_handle_wait(self.handle, timeout_ms))
    }

    def wait_cancellable(self, timeout_ms: i64) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_handle_wait_cancellable(self.handle, timeout_ms))
    }

    def kill(self) -> Result<bool, i64> {
        process_status_bool_result(sengoo_process_handle_kill(self.handle))
    }

    def exit_code(self) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_handle_exit_code(self.handle))
    }

    def close(self) -> bool {
        sengoo_process_handle_close(self.handle) == 0
    }
}

impl Drop for ProcessHandle {
    def drop(&mut self) {
        sengoo_process_handle_close(self.handle);
    }
}

impl ProcessOutput {
    def exit_code(self) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_output_exit_code(self.handle))
    }

    def timed_out(self) -> bool {
        sengoo_process_output_timed_out(self.handle) > 0
    }

    def stdout_len(self) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_output_stdout_len(self.handle))
    }

    def stderr_len(self) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_output_stderr_len(self.handle))
    }

    def stdout_copy_raw(self, out_buffer_ptr: i64, out_capacity: i64) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_output_stdout_copy(self.handle, out_buffer_ptr, out_capacity))
    }

    def stdout_copy(self, buffer: Buffer) -> Result<i64, i64> {
        self.stdout_copy_raw(buffer.ptr(), buffer.len())
    }

    def stderr_copy_raw(self, out_buffer_ptr: i64, out_capacity: i64) -> Result<i64, i64> {
        process_status_i64_result(sengoo_process_output_stderr_copy(self.handle, out_buffer_ptr, out_capacity))
    }

    def stderr_copy(self, buffer: Buffer) -> Result<i64, i64> {
        self.stderr_copy_raw(buffer.ptr(), buffer.len())
    }

    def close(self) -> bool {
        sengoo_process_output_close(self.handle) == 0
    }
}

impl Drop for ProcessOutput {
    def drop(&mut self) {
        sengoo_process_output_close(self.handle);
    }
}
