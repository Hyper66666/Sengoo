extern "C" {
    fn sengoo_compress_gzip(data_ptr: i64, data_len: i64, out_buffer: i64, out_capacity: i64) -> i64;
    fn sengoo_compress_gunzip(data_ptr: i64, data_len: i64, out_buffer: i64, out_capacity: i64) -> i64;
}

def compress_gzip_buffer(buffer: Buffer, used_len: i64, out: Buffer) -> Result<i64, i64> {
    let compressed_len = sengoo_compress_gzip(buffer.ptr(), used_len, out.handle, out.len());
    if compressed_len >= 0 {
        Ok(compressed_len)
    } else {
        Err(status_from_raw_ffi(compressed_len))
    }
}

def decompress_gzip_buffer(buffer: Buffer, used_len: i64, out: Buffer) -> Result<i64, i64> {
    let decompressed_len = sengoo_compress_gunzip(buffer.ptr(), used_len, out.handle, out.len());
    if decompressed_len >= 0 {
        Ok(decompressed_len)
    } else {
        Err(status_from_raw_ffi(decompressed_len))
    }
}
