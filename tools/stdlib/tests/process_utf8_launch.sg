import std::args;

import std::process;

import std::string;

extern "C" {
    fn sengoo_process_live_handle_count() -> i64;
    fn sengoo_process_live_resource_count() -> i64;
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def utf8_argument(index: i64) -> Result<String, i64> {
    let length = arg_len(index)?;
    let bytes = ffi_buffer_new(length)?;
    let count = arg_copy(index, bytes)?;
    string_from_utf8(bytes, count);
}

def utf8_launch() -> Result<bool, i64> {
    let executable = utf8_argument(0)?;
    let directory = utf8_argument(1)?;
    let command = process_command(executable.as_str())?;
    command.capture_stdout(true)?;
    command.capture_stderr(true)?;
    command.cwd(directory.as_str())?;
    command.env_set("SENGOO_UTF8_LAUNCH", "env 世界😀")?;
    command.env_set("SENGOO_环境", "value😀")?;
    command.arg("--verify")?;
    command.arg(directory.as_str())?;
    command.arg("世界 😀 \"quoted\" &")?;
    command.arg("")?;
    command.arg("tail\\")?;
    command.arg("&literal")?;
    command.timeout_ms(5000)?;
    let output = command.run()?;
    if output.timed_out() or output.exit_code()? != 0 { return Result { is_ok: false, value: false, error: 101 }; };
    let stdout = ffi_buffer_new(64)?;
    let stderr = ffi_buffer_new(64)?;
    let stdout_len = output.stdout_copy(stdout)?;
    let stderr_len = output.stderr_copy(stderr)?;
    if sengoo_ffi_buffer_commit_used_len(stdout.handle, stdout_len) < 0 or sengoo_ffi_buffer_commit_used_len(stderr.handle, stderr_len) < 0 { return Result { is_ok: false, value: false, error: 103 }; };
    let text = string_from_utf8(stdout, stdout_len)?;
    let errors = string_from_utf8(stderr, stderr_len)?;
    if text.as_str() != "UTF8 CHILD\n" or errors.as_str() != "UTF8 ERROR" { return Result { is_ok: false, value: false, error: 102 }; };
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    if args_len() != 2 { return 64; };
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let mut round = 0;
    while round < 20 { let outcome = utf8_launch(); if not outcome.is_ok() { println(outcome.error); return 1; }; round = round + 1; };
    if sengoo_process_live_handle_count() != 0 or sengoo_process_live_resource_count() != 0 { return 2; };
    if sengoo_string_live_handle_count() != strings or sengoo_buffer_live_handle_count() != buffers or sengoo_opaque_live_handle_count() != opaque { return 3; };
    println("process UTF-8 SG: 20 synchronous launches and exact resources passed");
    0;
}
