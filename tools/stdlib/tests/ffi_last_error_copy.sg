import std::ffi;
extern "C" {
    fn sg_acquire() -> i64;
    fn sg_prepare_error() -> i64;
    fn sg_validate_copy(copied: i64) -> i64;
    fn sg_resources() -> i64;
}
def exercise() -> i64 {
    let output = Buffer { handle: sg_acquire() };
    if sg_prepare_error() != 23 { return 1; };
    let copied = ffi_last_error_copy(output);
    if not copied.is_ok or copied.value != 23 { return 2; };
    if sg_validate_copy(copied.value) != 42 { return 3; };
    if not output.free() { return 4; };
    42;
}
def main() -> i64 {
    let mut round = 0;
    while round < 100 {
        if exercise() != 42 { return 5; };
        if sg_resources() != 0 { return 6; };
        round = round + 1;
    };
    42;
}
