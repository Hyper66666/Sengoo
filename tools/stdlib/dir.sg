extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_dir_exists(path: i64) -> i64;
    fn sengoo_dir_create(path: i64) -> i64;
    fn sengoo_dir_create_all(path: i64) -> i64;
    fn sengoo_dir_remove(path: i64) -> i64;
    fn sengoo_dir_entry_count(path: i64) -> i64;
    fn sengoo_dir_entry_name(path: i64, index: i64, buffer: i64, capacity: i64) -> i64;
    fn sengoo_dir_walk_new(root: i64, max_depth: i64) -> i64;
    fn sengoo_dir_walk_next(handle: i64, buffer: i64) -> i64;
    fn sengoo_dir_walk_next_string(handle: i64) -> i64;
    fn sengoo_dir_walk_close(handle: i64) -> i64;
    fn sengoo_dir_entry_name_string(path: i64, index: i64) -> i64;
    fn sengoo_dir_copy_tree(source: i64, destination: i64, max_depth: i64, max_entries: i64) -> i64;
    fn sengoo_dir_remove_tree(path: i64, max_depth: i64, max_entries: i64) -> i64;
}

struct DirWalk {
    handle: i64,
}

impl !Send for DirWalk {}
impl !Sync for DirWalk {}

def dir_bool_result(status: i64) -> Result<bool, i64> {
    if status == 0 {
        Ok(true)
    } else {
        Err(status_from_raw_ffi(status))
    }
}

def dir_i64_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Ok(value)
    } else {
        Err(status_from_raw_ffi(value))
    }
}

def dir_status_i64_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Ok(value)
    } else {
        Err(status_from_raw_ffi(value))
    }
}

def dir_walk_result(value: i64) -> Result<DirWalk, i64> {
    if value > 0 {
        Ok(DirWalk { handle: value })
    } else if value < 0 {
        Err(status_from_raw_ffi(value))
    } else {
        Err(STATUS_UNKNOWN())
    }
}

def dir_exists_raw(path_ptr: i64) -> bool {
    sengoo_dir_exists(path_ptr) != 0
}

def dir_exists(path: &str) -> bool {
    dir_exists_raw(sengoo_stdlib_str_ptr(path))
}

def dir_create_raw(path_ptr: i64) -> Result<bool, i64> {
    dir_bool_result(sengoo_dir_create(path_ptr))
}

def dir_create(path: &str) -> Result<bool, i64> {
    dir_create_raw(sengoo_stdlib_str_ptr(path))
}

def dir_create_all_raw(path_ptr: i64) -> Result<bool, i64> {
    dir_bool_result(sengoo_dir_create_all(path_ptr))
}

def dir_create_all(path: &str) -> Result<bool, i64> {
    dir_create_all_raw(sengoo_stdlib_str_ptr(path))
}

def dir_remove_raw(path_ptr: i64) -> Result<bool, i64> {
    dir_bool_result(sengoo_dir_remove(path_ptr))
}

def dir_remove(path: &str) -> Result<bool, i64> {
    dir_remove_raw(sengoo_stdlib_str_ptr(path))
}

def dir_entry_count_raw(path_ptr: i64) -> Result<i64, i64> {
    dir_i64_result(sengoo_dir_entry_count(path_ptr))
}

def dir_entry_count(path: &str) -> Result<i64, i64> {
    dir_entry_count_raw(sengoo_stdlib_str_ptr(path))
}

def dir_entry_name_raw(path_ptr: i64, index: i64, buffer_ptr: i64, capacity: i64) -> Result<i64, i64> {
    dir_i64_result(sengoo_dir_entry_name(path_ptr, index, buffer_ptr, capacity))
}

def dir_entry_name(path: &str, index: i64, buffer: Buffer) -> Result<i64, i64> {
    dir_entry_name_raw(sengoo_stdlib_str_ptr(path), index, buffer.ptr(), buffer.len())
}

def dir_entry_name_string(path: &str, index: i64) -> Result<String, i64> {
    let value = sengoo_dir_entry_name_string(sengoo_stdlib_str_ptr(path), index);
    if value >= 0 {
        Ok(String { handle: value })
    } else {
        Err(status_from_raw_ffi(value))
    }
}

def dir_copy_tree(root: &str, destination: &str, max_depth: i64, max_entries: i64) -> Result<i64, i64> {
    dir_i64_result(sengoo_dir_copy_tree(
        sengoo_stdlib_str_ptr(root),
        sengoo_stdlib_str_ptr(destination),
        max_depth,
        max_entries,
    ))
}

def dir_remove_tree(root: &str, max_depth: i64, max_entries: i64) -> Result<i64, i64> {
    dir_i64_result(sengoo_dir_remove_tree(sengoo_stdlib_str_ptr(root), max_depth, max_entries))
}

def dir_walk_raw(root_ptr: i64, max_depth: i64) -> Result<DirWalk, i64> {
    dir_walk_result(sengoo_dir_walk_new(root_ptr, max_depth))
}

def dir_walk(root: &str, max_depth: i64) -> Result<DirWalk, i64> {
    dir_walk_raw(sengoo_stdlib_str_ptr(root), max_depth)
}

impl DirWalk {
    def next(&self, buffer: Buffer) -> Result<i64, i64> {
        dir_status_i64_result(sengoo_dir_walk_next(self.handle, buffer.handle))
    }

    def next_string(&self) -> Result<String, i64> {
        dir_string_result(sengoo_dir_walk_next_string(self.handle))
    }

    def close(&self) -> bool {
        sengoo_dir_walk_close(self.handle) == 0
    }
}

impl Drop for DirWalk {
    def drop(&mut self) {
        sengoo_dir_walk_close(self.handle);
    }
}

def dir_string_result(value: i64) -> Result<String, i64> {
    if value > 0 {
        Ok(String { handle: value })
    } else if value == 0 {
        Err(STATUS_NOT_FOUND())
    } else {
        Err(status_from_raw_ffi(value))
    }
}
