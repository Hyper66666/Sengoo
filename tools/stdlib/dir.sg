extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_dir_exists(path: i64) -> i64;
    fn sengoo_dir_create(path: i64) -> i64;
    fn sengoo_dir_create_all(path: i64) -> i64;
    fn sengoo_dir_remove(path: i64) -> i64;
}

def dir_bool_result(status: i64) -> Result<bool, i64> {
    if status == 0 {
        Result { is_ok: true, value: true, error: 0 }
    } else {
        Result { is_ok: false, value: false, error: 1 }
    }
}

def dir_exists_raw(path_ptr: i64) -> bool {
    sengoo_dir_exists(path_ptr) != 0
}

def dir_exists(path: &str) -> bool {
    dir_exists_raw(sengoo_stdlib_str_ptr(path))
}

def dir_create_raw(path_ptr: i64) -> Result<bool, i64> {
    dir_bool_result(sengoo_dir_create(path_ptr))
}

def dir_create(path: &str) -> Result<bool, i64> {
    dir_create_raw(sengoo_stdlib_str_ptr(path))
}

def dir_create_all_raw(path_ptr: i64) -> Result<bool, i64> {
    dir_bool_result(sengoo_dir_create_all(path_ptr))
}

def dir_create_all(path: &str) -> Result<bool, i64> {
    dir_create_all_raw(sengoo_stdlib_str_ptr(path))
}

def dir_remove_raw(path_ptr: i64) -> Result<bool, i64> {
    dir_bool_result(sengoo_dir_remove(path_ptr))
}

def dir_remove(path: &str) -> Result<bool, i64> {
    dir_remove_raw(sengoo_stdlib_str_ptr(path))
}
