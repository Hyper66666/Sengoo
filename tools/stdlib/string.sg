extern "C" {
    fn sengoo_str_contains(value: &str, needle: &str) -> i64;
    fn sengoo_str_starts_with(value: &str, prefix: &str) -> i64;
    fn sengoo_str_ends_with(value: &str, suffix: &str) -> i64;
    fn sengoo_str_index_of(value: &str, needle: &str) -> i64;
    fn sengoo_str_trim(value: &str) -> i64;
    fn sengoo_str_to_ascii_upper(value: &str) -> i64;
    fn sengoo_str_to_ascii_lower(value: &str) -> i64;
    fn sengoo_str_slice_copy(value_ptr: i64, start: i64, end: i64) -> i64;
    fn sengoo_string_new() -> i64;
    fn sengoo_string_free_status(handle: i64) -> i64;
    fn sengoo_string_len(handle: i64) -> i64;
    fn sengoo_string_is_empty(handle: i64) -> i64;
    fn sengoo_string_from_str_copy(value_ptr: i64) -> i64;
    fn sengoo_string_from_buffer(buffer_handle: i64, used_len: i64) -> i64;
    fn sengoo_string_clone_status(handle: i64) -> i64;
    fn sengoo_string_push_str_status(handle: i64, value_ptr: i64) -> i64;
    fn sengoo_string_concat_str_status(handle: i64, value_ptr: i64) -> i64;
    fn sengoo_string_as_str_ptr(handle: i64) -> i64;
    fn sengoo_string_with_capacity(capacity: i64) -> i64;
    fn sengoo_string_push_i64_status(handle: i64, value: i64) -> i64;
    fn sengoo_string_push_bool_status(handle: i64, value: i64) -> i64;
    fn sengoo_string_push_char_status(handle: i64, codepoint: char) -> i64;
    fn sengoo_string_push_f64_precision_status(handle: i64, value: f64, precision: i64) -> i64;
    fn sengoo_string_push_padded_string_status(handle: i64, value_handle: i64, align: i64, width: i64) -> i64;
    fn sengoo_string_clear_status(handle: i64) -> i64;
    fn sengoo_string_copy_to_buffer(handle: i64, buffer_handle: i64) -> i64;
    fn sengoo_string_slice_status(handle: i64, start: i64, end: i64) -> i64;
    fn sengoo_string_eq(lhs_handle: i64, rhs_handle: i64) -> i64;
    fn sengoo_string_compare(lhs_handle: i64, rhs_handle: i64) -> i64;
    fn sengoo_str_hash(value: &str) -> i64;
    fn sengoo_hasher_new() -> i64;
    fn sengoo_hasher_free_status(handle: i64) -> i64;
    fn sengoo_hasher_write_i64(handle: i64, value: i64) -> i64;
    fn sengoo_hasher_write_bool(handle: i64, value: i64) -> i64;
    fn sengoo_hasher_write_str(handle: i64, value: &str) -> i64;
    fn sengoo_hasher_write_string(handle: i64, string_handle: i64) -> i64;
    fn sengoo_hasher_finish(handle: i64) -> i64;
    fn sengoo_string_bytes_iter_new(handle: i64) -> i64;
    fn sengoo_string_chars_iter_new(handle: i64) -> i64;
    fn sengoo_string_iter_done(iter_handle: i64) -> i64;
    fn sengoo_string_bytes_iter_next_or_default(iter_handle: i64, fallback: i64) -> i64;
    fn sengoo_string_chars_iter_next_or_default(iter_handle: i64, fallback: i64) -> i64;
    fn sengoo_string_chars_iter_next_char(iter_handle: i64, fallback: char) -> char;
    fn sengoo_string_iter_free_status(iter_handle: i64) -> i64;
    fn sengoo_string_split_iter_new(handle: i64, delimiter_ptr: i64) -> i64;
    fn sengoo_string_split_iter_done(iter_handle: i64) -> i64;
    fn sengoo_string_split_iter_next(iter_handle: i64) -> i64;
    fn sengoo_string_split_iter_free_status(iter_handle: i64) -> i64;
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
}

struct String {
    handle: i64,
}

struct StringBytesIter {
    handle: i64,
}

struct StringCharsIter {
    handle: i64,
}

struct StringSplitIter {
    handle: i64,
}

struct Formatter {
    handle: i64,
}

struct Hasher {
    handle: i64,
}

def formatter_new() -> Formatter {
    Formatter { handle: sengoo_string_new() }
}

def hasher_new() -> Hasher {
    Hasher { handle: sengoo_hasher_new() }
}

impl Formatter {
    def write_str(&mut self, text: &str) -> bool {
        sengoo_string_push_str_status(self.handle, sengoo_stdlib_str_ptr(text)) >= 0
    }

    def write_char(&mut self, value: char) -> bool {
        sengoo_string_push_char_status(self.handle, value) >= 0
    }

    def write_i64(&mut self, value: i64) -> bool {
        sengoo_string_push_i64_status(self.handle, value) >= 0
    }

    def write_bool(&mut self, value: bool) -> bool {
        let raw = if value { 1 } else { 0 };
        sengoo_string_push_bool_status(self.handle, raw) >= 0
    }

    def write_f64(&mut self, value: f64, precision: i64) -> bool {
        sengoo_string_push_f64_precision_status(self.handle, value, precision) >= 0
    }

    def write_string(&mut self, value: String) -> bool {
        sengoo_string_push_padded_string_status(self.handle, value.handle, 1, 0) >= 0
    }

    def finish(self) -> String {
        String { handle: self.handle }
    }
}

impl Hasher {
    def write_i64(&mut self, value: i64) -> bool {
        sengoo_hasher_write_i64(self.handle, value) >= 0
    }

    def write_bool(&mut self, value: bool) -> bool {
        let raw = if value { 1 } else { 0 };
        sengoo_hasher_write_bool(self.handle, raw) >= 0
    }

    def write_str(&mut self, text: &str) -> bool {
        sengoo_hasher_write_str(self.handle, text) >= 0
    }

    def write_string(&mut self, value: String) -> bool {
        sengoo_hasher_write_string(self.handle, value.handle) >= 0
    }

    def finish(self) -> i64 {
        let state = sengoo_hasher_finish(self.handle);
        sengoo_hasher_free_status(self.handle);
        state
    }
}

impl Hash for String {
    def hash_into(&self, h: &mut Hasher) {
        sengoo_hasher_write_string(h.handle, self.handle);
    }
}

def str_len(value: &str) -> i64 {
    value.len()
}

def str_eq(lhs: &str, rhs: &str) -> bool {
    lhs == rhs
}

def str_concat(lhs: &str, rhs: &str) -> &str {
    lhs + rhs
}

def str_ne(lhs: &str, rhs: &str) -> bool {
    !str_eq(lhs, rhs)
}

def str_contains(value: &str, needle: &str) -> bool {
    sengoo_str_contains(value, needle) != 0
}

def str_starts_with(value: &str, prefix: &str) -> bool {
    sengoo_str_starts_with(value, prefix) != 0
}

def str_ends_with(value: &str, suffix: &str) -> bool {
    sengoo_str_ends_with(value, suffix) != 0
}

def str_index_of(value: &str, needle: &str) -> i64 {
    sengoo_str_index_of(value, needle)
}

def str_is_empty(value: &str) -> bool {
    str_len(value) == 0
}

def str_is_not_empty(value: &str) -> bool {
    !str_is_empty(value)
}

def str_append(lhs: &str, rhs: &str) -> &str {
    str_concat(lhs, rhs)
}

def str_repeat(value: &str, count: i64) -> &str {
    let mut out = "";
    let mut remaining = count;
    while remaining > 0 {
        out = str_concat(out, value);
        remaining = remaining - 1;
    }
    out
}

def str_trim(value: &str) -> Result<String, i64> {
    let raw = sengoo_str_trim(value);
    if raw >= 0 {
        string_result_ok(String { handle: raw })
    } else {
        string_result_err(0 - raw)
    }
}

def str_to_ascii_upper(value: &str) -> Result<String, i64> {
    let raw = sengoo_str_to_ascii_upper(value);
    if raw >= 0 {
        string_result_ok(String { handle: raw })
    } else {
        string_result_err(0 - raw)
    }
}

def str_to_ascii_lower(value: &str) -> Result<String, i64> {
    let raw = sengoo_str_to_ascii_lower(value);
    if raw >= 0 {
        string_result_ok(String { handle: raw })
    } else {
        string_result_err(0 - raw)
    }
}

def str_get(value: &str, start: i64, end: i64) -> Result<String, i64> {
    let raw = sengoo_str_slice_copy(sengoo_stdlib_str_ptr(value), start, end);
    if raw >= 0 {
        string_result_ok(String { handle: raw })
    } else {
        string_result_err(0 - raw)
    }
}

def string_copy_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: 0 - value }
    }
}

def string_result_ok(value: String) -> Result<String, i64> {
    Result { is_ok: true, value: value, error: 0 }
}

def string_result_err(error: i64) -> Result<String, i64> {
    Result { is_ok: false, value: String { handle: 0 }, error: error }
}

def string_new() -> String {
    String { handle: sengoo_string_new() }
}

def string_with_capacity(capacity: i64) -> Result<String, i64> {
    let raw = sengoo_string_with_capacity(capacity);
    if raw >= 0 {
        string_result_ok(String { handle: raw })
    } else {
        string_result_err(0 - raw)
    }
}

def string_from_str(value: &str) -> Result<String, i64> {
    let raw = sengoo_string_from_str_copy(sengoo_stdlib_str_ptr(value));
    if raw >= 0 {
        string_result_ok(String { handle: raw })
    } else {
        string_result_err(0 - raw)
    }
}

def string_from_buffer(buffer: Buffer, used_len: i64) -> Result<String, i64> {
    let raw = sengoo_string_from_buffer(buffer.handle, used_len);
    if raw >= 0 {
        string_result_ok(String { handle: raw })
    } else {
        string_result_err(0 - raw)
    }
}

impl String {
    def len(self) -> i64 {
        sengoo_string_len(self.handle)
    }

    def is_empty(self) -> bool {
        sengoo_string_is_empty(self.handle) != 0
    }

    def clone(self) -> Result<String, i64> {
        let raw = sengoo_string_clone_status(self.handle);
        if raw >= 0 {
            string_result_ok(String { handle: raw })
        } else {
            string_result_err(0 - raw)
        }
    }

    def push_str(self, value: &str) -> Result<bool, i64> {
        let raw = sengoo_string_push_str_status(self.handle, sengoo_stdlib_str_ptr(value));
        if raw >= 0 {
            result_ok_bool(true)
        } else {
            result_err_bool(0 - raw)
        }
    }

    def push_i64(self, value: i64) -> Result<bool, i64> {
        let raw = sengoo_string_push_i64_status(self.handle, value);
        if raw >= 0 {
            result_ok_bool(true)
        } else {
            result_err_bool(0 - raw)
        }
    }

    def push_char(self, value: char) -> Result<bool, i64> {
        let raw = sengoo_string_push_char_status(self.handle, value);
        if raw >= 0 {
            result_ok_bool(true)
        } else {
            result_err_bool(0 - raw)
        }
    }

    def clear(self) -> bool {
        sengoo_string_clear_status(self.handle) >= 0
    }

    def copy_to_buffer(self, buffer: Buffer) -> Result<i64, i64> {
        string_copy_result(sengoo_string_copy_to_buffer(self.handle, buffer.handle))
    }

    def get(self, start: i64, end: i64) -> Result<String, i64> {
        let raw = sengoo_string_slice_status(self.handle, start, end);
        if raw >= 0 {
            string_result_ok(String { handle: raw })
        } else {
            string_result_err(0 - raw)
        }
    }

    def bytes(self) -> StringBytesIter {
        StringBytesIter { handle: sengoo_string_bytes_iter_new(self.handle) }
    }

    def chars(self) -> StringCharsIter {
        StringCharsIter { handle: sengoo_string_chars_iter_new(self.handle) }
    }

    def split(self, delimiter: &str) -> StringSplitIter {
        StringSplitIter {
            handle: sengoo_string_split_iter_new(self.handle, sengoo_stdlib_str_ptr(delimiter)),
        }
    }

    def drop(self) -> bool {
        sengoo_string_free_status(self.handle) >= 0
    }

    def eq(self, other: String) -> bool {
        sengoo_string_eq(self.handle, other.handle) != 0
    }

    def ne(self, other: String) -> bool {
        !self.eq(other)
    }

    def compare(self, other: String) -> i64 {
        sengoo_string_compare(self.handle, other.handle)
    }

    def lt(self, other: String) -> bool {
        self.compare(other) < 0
    }

    def le(self, other: String) -> bool {
        self.compare(other) <= 0
    }

    def gt(self, other: String) -> bool {
        self.compare(other) > 0
    }

    def ge(self, other: String) -> bool {
        self.compare(other) >= 0
    }
}

impl Drop for String {
    def drop(&mut self) {
        sengoo_string_free_status(self.handle);
    }
}

impl Option<String> {
    def unwrap_or(self, fallback: String) -> String {
        let selected = if self.is_some { self.value.handle } else { fallback.handle };
        if selected == 0 {
            String { handle: 0 }
        } else {
            String { handle: sengoo_string_clone_status(selected) }
        }
    }
}

impl PartialEq for String {
}

impl Eq for String {
}

impl PartialOrd for String {
}

impl Ord for String {
}

impl Iterator for StringBytesIter {
    type Item = i64;

    def next(&self) -> Option<i64> {
        if sengoo_string_iter_done(self.handle) != 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_string_bytes_iter_next_or_default(self.handle, 0))
        }
    }

    def free(self) -> bool {
        sengoo_string_iter_free_status(self.handle) >= 0
    }
}

impl Iterator for StringCharsIter {
    type Item = char;

    def next(&self) -> Option<char> {
        if sengoo_string_iter_done(self.handle) != 0 {
            option_none_with('\0')
        } else {
            option_some(sengoo_string_chars_iter_next_char(self.handle, '\0'))
        }
    }

}

impl StringCharsIter {
    def next_codepoint(&self) -> Option<i64> {
        if sengoo_string_iter_done(self.handle) != 0 {
            option_none_i64()
        } else {
            option_some_i64(sengoo_string_chars_iter_next_or_default(self.handle, 0))
        }
    }

    def free(self) -> bool {
        sengoo_string_iter_free_status(self.handle) >= 0
    }
}

impl Iterator for StringSplitIter {
    type Item = String;

    def next(&self) -> Option<String> {
        if sengoo_string_split_iter_done(self.handle) != 0 {
            option_none_with(String { handle: 0 })
        } else {
            let raw = sengoo_string_split_iter_next(self.handle);
            if raw >= 0 {
                option_some(String { handle: raw })
            } else {
                option_none_with(String { handle: 0 })
            }
        }
    }

    def free(self) -> bool {
        sengoo_string_split_iter_free_status(self.handle) >= 0
    }
}
