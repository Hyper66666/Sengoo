extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_config_ini_parse(text_ptr: i64, text_len: i64) -> i64;
    fn sengoo_config_ini_get(handle: i64, key_ptr: i64, value_buffer: i64, capacity: i64) -> i64;
    fn sengoo_config_ini_free(handle: i64) -> i64;
    fn sengoo_config_toml_parse(text_ptr: i64, text_len: i64) -> i64;
    fn sengoo_config_toml_get(handle: i64, key_ptr: i64, value_buffer: i64, capacity: i64) -> i64;
    fn sengoo_config_toml_free(handle: i64) -> i64;
}

struct IniDoc {
    handle: i64,
}

struct TomlDoc {
    handle: i64,
}

def config_doc_result(handle: i64) -> Result<i64, i64> {
    if handle > 0 {
        Result { is_ok: true, value: handle, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: status_from_raw_ffi(handle) }
    }
}

def ini_parse(text: &str) -> Result<IniDoc, i64> {
    let handle = sengoo_config_ini_parse(sengoo_stdlib_str_ptr(text), text.len());
    if handle > 0 {
        Result { is_ok: true, value: IniDoc { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: IniDoc { handle: 0 }, error: status_from_raw_ffi(handle) }
    }
}

impl IniDoc {
    def get_copy(self, key: &str, buffer: Buffer) -> Result<i64, i64> {
        let copied = sengoo_config_ini_get(
            self.handle,
            sengoo_stdlib_str_ptr(key),
            buffer.handle,
            buffer.len()
        );
        if copied >= 0 {
            Result { is_ok: true, value: copied, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: status_from_raw_ffi(copied) }
        }
    }

    def drop(self) -> bool {
        sengoo_config_ini_free(self.handle) >= 0
    }
}

def toml_parse(text: &str) -> Result<TomlDoc, i64> {
    let handle = sengoo_config_toml_parse(sengoo_stdlib_str_ptr(text), text.len());
    if handle > 0 {
        Result { is_ok: true, value: TomlDoc { handle: handle }, error: 0 }
    } else {
        Result { is_ok: false, value: TomlDoc { handle: 0 }, error: status_from_raw_ffi(handle) }
    }
}

impl TomlDoc {
    def get_copy(self, key: &str, buffer: Buffer) -> Result<i64, i64> {
        let copied = sengoo_config_toml_get(
            self.handle,
            sengoo_stdlib_str_ptr(key),
            buffer.handle,
            buffer.len()
        );
        if copied >= 0 {
            Result { is_ok: true, value: copied, error: 0 }
        } else {
            Result { is_ok: false, value: 0, error: status_from_raw_ffi(copied) }
        }
    }

    def drop(self) -> bool {
        sengoo_config_toml_free(self.handle) >= 0
    }
}
