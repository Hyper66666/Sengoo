extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_io_stdin_read(buffer: i64, capacity: i64) -> i64;
    fn sengoo_io_stdin_read_line(buffer: i64, capacity: i64) -> i64;
    fn sengoo_io_stdout_write(data: i64, len: i64) -> i64;
    fn sengoo_io_stderr_write(data: i64, len: i64) -> i64;
    fn sengoo_io_stdout_flush() -> i64;
    fn sengoo_io_stderr_flush() -> i64;
    fn sengoo_io_fd_read(fd: i64, buffer: i64, capacity: i64) -> i64;
    fn sengoo_io_fd_write(fd: i64, data: i64, len: i64) -> i64;
}

def io_i64_result(value: i64) -> Result<i64, i64> {
    if value >= 0 {
        Result { is_ok: true, value: value, error: 0 }
    } else {
        Result { is_ok: false, value: 0, error: status_from_raw_ffi(value) }
    }
}

def io_bool_result(status: i64) -> Result<bool, i64> {
    if status == 0 {
        Result { is_ok: true, value: true, error: 0 }
    } else {
        Result { is_ok: false, value: false, error: status_from_raw_ffi(status) }
    }
}

def io_stdin_read_raw(buffer_ptr: i64, capacity: i64) -> Result<i64, i64> {
    io_i64_result(sengoo_io_stdin_read(buffer_ptr, capacity))
}

def io_stdin_read(buffer: Buffer) -> Result<i64, i64> {
    io_stdin_read_raw(buffer.ptr(), buffer.len())
}

def io_stdin_read_line_raw(buffer_ptr: i64, capacity: i64) -> Result<i64, i64> {
    io_i64_result(sengoo_io_stdin_read_line(buffer_ptr, capacity))
}

def io_stdin_read_line(buffer: Buffer) -> Result<i64, i64> {
    io_stdin_read_line_raw(buffer.ptr(), buffer.len())
}

def io_stdout_write_raw(data_ptr: i64, len: i64) -> Result<i64, i64> {
    io_i64_result(sengoo_io_stdout_write(data_ptr, len))
}

def io_stdout_write(data: &str) -> Result<i64, i64> {
    io_stdout_write_raw(sengoo_stdlib_str_ptr(data), data.len())
}

def io_stderr_write_raw(data_ptr: i64, len: i64) -> Result<i64, i64> {
    io_i64_result(sengoo_io_stderr_write(data_ptr, len))
}

def io_stderr_write(data: &str) -> Result<i64, i64> {
    io_stderr_write_raw(sengoo_stdlib_str_ptr(data), data.len())
}

def io_stdout_flush() -> Result<bool, i64> {
    io_bool_result(sengoo_io_stdout_flush())
}

def io_stderr_flush() -> Result<bool, i64> {
    io_bool_result(sengoo_io_stderr_flush())
}

def io_fd_read(fd: i64, buffer: Buffer) -> Result<i64, i64> {
    io_i64_result(sengoo_io_fd_read(fd, buffer.ptr(), buffer.len()))
}

def io_fd_write(fd: i64, data: &str) -> Result<i64, i64> {
    io_i64_result(sengoo_io_fd_write(fd, sengoo_stdlib_str_ptr(data), data.len()))
}
