extern "C" {
    fn sengoo_stdlib_str_ptr(value: &str) -> i64;
    fn sengoo_hash_sha256(data_ptr: i64, data_len: i64, out_buffer: i64, out_capacity: i64) -> i64;
}

def hash_sha256_bytes(data_ptr: i64, data_len: i64, out: Buffer) -> Result<i64, i64> {
    let digest_len = sengoo_hash_sha256(data_ptr, data_len, out.handle, out.len());
    if digest_len >= 0 {
        Ok(digest_len)
    } else {
        Err(status_from_raw_ffi(digest_len))
    }
}

def hash_sha256_str(value: &str, out: Buffer) -> Result<i64, i64> {
    hash_sha256_bytes(sengoo_stdlib_str_ptr(value), value.len(), out)
}
