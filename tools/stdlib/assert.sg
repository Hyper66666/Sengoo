extern "C" {
    fn sengoo_panic_option_unwrap_i64() -> i64;
    fn sengoo_f64_eq(lhs: f64, rhs: f64) -> i64;
    fn sengoo_f64_ne(lhs: f64, rhs: f64) -> i64;
}

def assert(cond: bool) -> bool {
    if cond {
        true
    } else {
        sengoo_panic_option_unwrap_i64();
        false
    }
}

def assert_true(cond: bool) -> bool {
    assert(cond)
}

def assert_false(cond: bool) -> bool {
    assert(!cond)
}

def assert_eq_i64(lhs: i64, rhs: i64) -> bool {
    assert(lhs == rhs)
}

def assert_ne_i64(lhs: i64, rhs: i64) -> bool {
    assert(lhs != rhs)
}

def assert_eq_bool(lhs: bool, rhs: bool) -> bool {
    assert(lhs == rhs)
}

def assert_ne_bool(lhs: bool, rhs: bool) -> bool {
    assert(lhs != rhs)
}

def assert_eq_str(lhs: &str, rhs: &str) -> bool {
    assert(lhs == rhs)
}

def assert_ne_str(lhs: &str, rhs: &str) -> bool {
    assert(lhs != rhs)
}

def assert_eq_f64(lhs: f64, rhs: f64) -> bool {
    assert(sengoo_f64_eq(lhs, rhs) != 0)
}

def assert_ne_f64(lhs: f64, rhs: f64) -> bool {
    assert(sengoo_f64_ne(lhs, rhs) != 0)
}
