import std::http;

import std::json;

import std::log;

import std::status;

def main() -> i64 {
    let log_level_set = log_set_level(LOG_INFO()).unwrap_or(false);
    let log_cleared = log_test_sink_clear();
    let log_written = log_write(LOG_INFO(), "http status smoke").unwrap_or(false);
    let result = http_client_get("ftp://127.0.0.1/", 1);
    let response_closed = if result.is_ok { result.value.close(); } else { true; };
    let unsupported = if result.is_ok { false; } else { result.error == STATUS_UNSUPPORTED(); };
    let doc = json_parse("[0]").unwrap_or(JsonDoc { handle: 0 });
    let root = doc.root();
    let count = root.array_len().unwrap_or(0);
    let closed = doc.close();
    if unsupported and response_closed and count == 1 and closed and log_level_set and log_cleared and log_written { 0; } else { 1; };
}