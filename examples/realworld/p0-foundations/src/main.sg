import std::string;

struct Label {
    id: i64,
}

impl Display for Label {
    def to_string(&self) -> String {
        let rendered = format("Label({})", self.id);
        rendered;
    }
}

def score_result() -> Result<i64, i64> {
    Ok(42);
}

def text_result() -> Result<String, i64> {
    string_from_str("p0-ready");
}

def main() -> i64 {
    let score = match score_result() { Ok(value) => value, Err(_) => return 1 };
    let text = match text_result() { Ok(value) => value, Err(_) => return 1 };
    let label = Label { id: score };
    println(text);
    println(label);
    0;
}
