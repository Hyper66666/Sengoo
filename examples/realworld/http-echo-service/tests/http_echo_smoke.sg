import std::net;

import std::status;

import std::async;

def health_handler(request: HttpServerRequest) -> i64 {
    if request.respond(200, "ok").unwrap_or(false) { 1; } else { 0; };
}

def echo_handler(request: HttpServerRequest) -> i64 {
    if request.respond(200, "echo").unwrap_or(false) { 1; } else { 0; };
}

def dual_router() -> Result<HttpRouter, i64> {
    let h_health: fn(HttpServerRequest) -> i64 = health_handler;
    let h_echo: fn(HttpServerRequest) -> i64 = echo_handler;
    let r0 = http_router_new();
    match http_router_route(r0, "GET", "/health", h_health) {
        Ok(router) => http_router_route(router, "GET", "/echo", h_echo),
        Err(error) => Err(error),
    }
}

def dispatch_dual(request: HttpServerRequest) -> bool {
    match dual_router() {
        Ok(router) => {
            let ignored = http_router_dispatch(router, request);
            true
        },
        Err(_) => false,
    }
}

async def client_health(port: i64) -> i64 {
    await sleep(10);
    match net_tcp_connect("127.0.0.1", port, 1000) {
        Err(error) => error,
        Ok(stream) => {
            let sent_ok = match stream.send("GET /health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n") {
                Ok(_) => true,
                Err(_) => false,
            };
            await sleep(1000);
            let closed = stream.close();
            if sent_ok and closed { 0 } else { 2 }
        },
    }
}

async def client_echo(port: i64) -> i64 {
    await sleep(10);
    match net_tcp_connect("127.0.0.1", port, 1000) {
        Err(error) => error,
        Ok(stream) => {
            let sent_ok = match stream.send("GET /echo HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n") {
                Ok(_) => true,
                Err(_) => false,
            };
            await sleep(1000);
            let closed = stream.close();
            if sent_ok and closed { 0 } else { 2 }
        },
    }
}

async def dual_route_contract(server: HttpServer) -> bool {
    let port = server.local_port().unwrap_or(0);
    match server.claim_serve_mode(HTTP_SERVER_MODE_ROUTER()) {
        Err(_) => {
            server.close();
            false
        },
        Ok(_) => {
            let client1 = spawn(client_health(port));
            let o1 = await server.next_request_router_async(5000);
            let health_ok = if o1.is_ok { dispatch_dual(o1.value) } else { false };
            let client1_ok = await client1 == 0;
            let client2 = spawn(client_echo(port));
            let o2 = await server.next_request_router_async(5000);
            let echo_ok = if o2.is_ok { dispatch_dual(o2.value) } else { false };
            let client2_ok = await client2 == 0;
            let closed = server.close();
            port > 0 and health_ok and echo_ok and client1_ok and client2_ok and closed
        },
    }
}

async def main() -> i64 {
    match http_server_bind("127.0.0.1", 0) {
        Ok(server) => {
            if await dual_route_contract(server) { 0 } else { 2 }
        },
        Err(error) => {
            if error == STATUS_UNSUPPORTED() { 0 } else { 2 }
        },
    }
}
