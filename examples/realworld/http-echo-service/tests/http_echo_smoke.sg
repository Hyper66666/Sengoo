import std::net;

import std::status;

import std::async;

def health_handler(request: &mut HttpServerRequest) -> Result<bool, i64> {
    request.respond(200, "ok");
}

def echo_handler(request: &mut HttpServerRequest) -> Result<bool, i64> {
    request.respond(200, "echo");
}

def dual_router() -> Result<HttpRouter, i64> {
    match http_router_new() {
        Err(error) => Err(error),
        Ok(mut router) => {
            let health: fn(&mut HttpServerRequest) -> Result<bool, i64> = health_handler;
            let echo: fn(&mut HttpServerRequest) -> Result<bool, i64> = echo_handler;
            match http_router_route(&mut router, "GET", "/health", health) {
                Err(error) => Err(error),
                Ok(_) => match http_router_route(&mut router, "GET", "/echo", echo) {
                    Err(error) => Err(error),
                    Ok(_) => Ok(router),
                },
            }
        },
    }
}

async def client_health(port: i64) -> i64 {
    await sleep(10);
    match net_tcp_connect("127.0.0.1", port, 1000) {
        Err(error) => error,
        Ok(stream) => {
            let sent = stream.send(
                "GET /health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
            );
            await sleep(1000);
            let closed = stream.close();
            if sent.is_ok and closed {
                0;
            } else {
                2;
            };
        },
    }
}

async def client_echo(port: i64) -> i64 {
    await sleep(10);
    match net_tcp_connect("127.0.0.1", port, 1000) {
        Err(error) => error,
        Ok(stream) => {
            let sent = stream.send(
                "GET /echo HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
            );
            await sleep(1000);
            let closed = stream.close();
            if sent.is_ok and closed {
                0;
            } else {
                2;
            };
        },
    }
}

async def dual_route_contract(server: HttpServer) -> bool {
    let port = server.local_port().unwrap_or(0);
    match dual_router() {
        Err(_) => {
            server.close();
            false;
        },
        Ok(router) => {
            let client1 = spawn(client_health(port));
            let health = await serve_http_timeout(&server, &router, 5000);
            let client1_ok = await client1 == 0;
            let client2 = spawn(client_echo(port));
            let echo = await serve_http_timeout(&server, &router, 5000);
            let client2_ok = await client2 == 0;
            let closed = server.close();
            port > 0
                and health.is_ok
                and echo.is_ok
                and client1_ok
                and client2_ok
                and closed;
        },
    }
}

async def main() -> i64 {
    match http_server_bind("127.0.0.1", 0) {
        Ok(server) => {
            if await dual_route_contract(server) {
                0;
            } else {
                2;
            };
        },
        Err(error) => {
            if error == STATUS_UNSUPPORTED() {
                0;
            } else {
                2;
            };
        },
    }
}
