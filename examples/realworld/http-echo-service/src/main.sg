import std::net;

import std::status;

async def main() -> i64 {
    let bind_result = http_server_bind("127.0.0.1", 0);
    let unsupported_host = if bind_result.is_ok { false; } else { bind_result.error == STATUS_UNSUPPORTED(); };
    if bind_result.is_ok { let server = bind_result.value; let outcome = await server.next_request_async(5000); let timed_out = if outcome.is_ok { false; } else { outcome.error == STATUS_TIMEOUT(); }; let buffer = ffi_buffer_new(1024).unwrap_or(Buffer { handle: 0 }); let request = outcome.value; let copied = if outcome.is_ok { request.body_copy(buffer).unwrap_or(0); } else { 0; }; let answered = if outcome.is_ok { request.respond_raw(200, buffer.ptr(), copied).unwrap_or(false); } else { false; }; buffer.free(); let closed = server.close(); if (answered or timed_out) and closed { 0; } else { 1; }; } else if unsupported_host { 0; } else { 1; };
}