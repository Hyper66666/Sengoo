import std::net;

import std::status;

def health_handler(request: &mut HttpServerRequest) -> Result<bool, i64> {
    request.respond(200, "ok");
}

def echo_handler(request: &mut HttpServerRequest) -> Result<bool, i64> {
    request.respond(200, "echo");
}

def dual_router() -> Result<HttpRouter, i64> {
    match http_router_new() {
        Err(error) => Err(error),
        Ok(mut router) => {
            let health: fn(&mut HttpServerRequest) -> Result<bool, i64> = health_handler;
            let echo: fn(&mut HttpServerRequest) -> Result<bool, i64> = echo_handler;
            match http_router_route(&mut router, "GET", "/health", health) {
                Err(error) => Err(error),
                Ok(_) => match http_router_route(&mut router, "GET", "/echo", echo) {
                    Err(error) => Err(error),
                    Ok(_) => Ok(router),
                },
            }
        },
    }
}

async def main() -> i64 {
    match http_server_bind("127.0.0.1", 0) {
        Err(error) => {
            if error == STATUS_UNSUPPORTED() {
                0;
            } else {
                1;
            };
        },
        Ok(server) => match dual_router() {
            Err(_) => {
                server.close();
                1;
            },
            Ok(router) => {
                let served = await serve_http_timeout(&server, &router, 5000);
                let timed_out = if served.is_ok {
                    false;
                } else {
                    served.error == STATUS_TIMEOUT();
                };
                let closed = server.close();
                if (served.is_ok or timed_out) and closed {
                    0;
                } else {
                    1;
                };
            },
        },
    }
}
