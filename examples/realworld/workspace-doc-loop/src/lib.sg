import std::env;

import std::process;

def doc_loop_value() -> i64 {
    let cwd_len = process_current_dir_len().unwrap_or(0);
    let buffer = ffi_buffer_new(cwd_len + 1).unwrap_or(Buffer { handle: 0 });
    let pipeline_buffer = ffi_buffer_new(32).unwrap_or(Buffer { handle: 0 });
    let copied_cwd = process_current_dir_copy(buffer).unwrap_or(0);
    let pid = process_id();
    let child_code = if env_is_windows() {
        process_run_3("cmd.exe", "/D", "/C", "exit /B 42").unwrap_or(-1);
    } else {
        process_run_2("sh", "-c", "exit 42").unwrap_or(-1);
    };
    let captured = if env_is_windows() {
        let command = process_command("cmd.exe").unwrap_or(ProcessCommand { handle: 0 });
        let arg0 = command.arg("/D").unwrap_or(false);
        let arg1 = command.arg("/C").unwrap_or(false);
        let arg2 = command.arg("echo capture").unwrap_or(false);
        let capture = command.capture_stdout(true).unwrap_or(false);
        let output = command.run().unwrap_or(ProcessOutput { handle: 0 });
        let exit = output.exit_code().unwrap_or(-1);
        let len = output.stdout_len().unwrap_or(0);
        let closed_output = output.close();
        let closed_command = command.close();
        arg0 and arg1 and arg2 and capture and exit == 0 and len > 0 and closed_output and closed_command;
    } else {
        let command = process_command("sh").unwrap_or(ProcessCommand { handle: 0 });
        let arg0 = command.arg("-c").unwrap_or(false);
        let arg1 = command.arg("printf capture").unwrap_or(false);
        let capture = command.capture_stdout(true).unwrap_or(false);
        let output = command.run().unwrap_or(ProcessOutput { handle: 0 });
        let exit = output.exit_code().unwrap_or(-1);
        let len = output.stdout_len().unwrap_or(0);
        let closed_output = output.close();
        let closed_command = command.close();
        arg0 and arg1 and capture and exit == 0 and len == 7 and closed_output and closed_command;
    };
    let piped = if env_is_windows() {
        let producer = process_command("cmd.exe").unwrap_or(ProcessCommand { handle: 0 });
        let producer_arg0 = producer.arg("/D").unwrap_or(false);
        let producer_arg1 = producer.arg("/C").unwrap_or(false);
        let producer_arg2 = producer.arg("echo 789").unwrap_or(false);
        let consumer = process_command("cmd.exe").unwrap_or(ProcessCommand { handle: 0 });
        let consumer_arg0 = consumer.arg("/D").unwrap_or(false);
        let consumer_arg1 = consumer.arg("/C").unwrap_or(false);
        let consumer_arg2 = consumer.arg("findstr .").unwrap_or(false);
        let consumer_capture = consumer.capture_stdout(true).unwrap_or(false);
        let pipeline = producer.pipe_stdout_to(consumer).unwrap_or(ProcessCommand { handle: 0 });
        let output = pipeline.run().unwrap_or(ProcessOutput { handle: 0 });
        let exit = output.exit_code().unwrap_or(-1);
        let len = output.stdout_len().unwrap_or(0);
        let copied = output.stdout_copy(pipeline_buffer).unwrap_or(0);
        let closed_output = output.close();
        let closed_pipeline = pipeline.close();
        producer_arg0 and producer_arg1 and producer_arg2 and consumer_arg0 and consumer_arg1 and consumer_arg2 and consumer_capture and exit == 0 and len > 0 and copied == len and closed_output and closed_pipeline;
    } else {
        let producer = process_command("sh").unwrap_or(ProcessCommand { handle: 0 });
        let producer_arg0 = producer.arg("-c").unwrap_or(false);
        let producer_arg1 = producer.arg("printf 789").unwrap_or(false);
        let consumer = process_command("cat").unwrap_or(ProcessCommand { handle: 0 });
        let consumer_capture = consumer.capture_stdout(true).unwrap_or(false);
        let pipeline = producer.pipe_stdout_to(consumer).unwrap_or(ProcessCommand { handle: 0 });
        let output = pipeline.run().unwrap_or(ProcessOutput { handle: 0 });
        let exit = output.exit_code().unwrap_or(-1);
        let len = output.stdout_len().unwrap_or(0);
        let copied = output.stdout_copy(pipeline_buffer).unwrap_or(0);
        let closed_output = output.close();
        let closed_pipeline = pipeline.close();
        producer_arg0 and producer_arg1 and consumer_capture and exit == 0 and len == 3 and copied == 3 and closed_output and closed_pipeline;
    };
    let spawned = if env_is_windows() {
        let command = process_command("cmd.exe").unwrap_or(ProcessCommand { handle: 0 });
        let arg0 = command.arg("/D").unwrap_or(false);
        let arg1 = command.arg("/C").unwrap_or(false);
        let arg2 = command.arg("exit /B 0").unwrap_or(false);
        let handle = command.spawn().unwrap_or(ProcessHandle { handle: 0 });
        let waited = handle.wait(2000).unwrap_or(-1);
        let exit = handle.exit_code().unwrap_or(-1);
        let closed = handle.close();
        let kill_command = process_command("cmd.exe").unwrap_or(ProcessCommand { handle: 0 });
        let kill_arg0 = kill_command.arg("/D").unwrap_or(false);
        let kill_arg1 = kill_command.arg("/C").unwrap_or(false);
        let kill_arg2 = kill_command.arg("ping -n 6 127.0.0.1 > NUL").unwrap_or(false);
        let kill_handle = kill_command.spawn().unwrap_or(ProcessHandle { handle: 0 });
        let killed = kill_handle.kill().unwrap_or(false);
        let kill_waited = kill_handle.wait(2000);
        let kill_closed = kill_handle.close();
        arg0 and arg1 and arg2 and waited == 0 and exit == 0 and closed and kill_arg0 and kill_arg1 and kill_arg2 and killed and not kill_waited.is_err() and kill_closed;
    } else {
        let command = process_command("sh").unwrap_or(ProcessCommand { handle: 0 });
        let arg0 = command.arg("-c").unwrap_or(false);
        let arg1 = command.arg("exit 0").unwrap_or(false);
        let handle = command.spawn().unwrap_or(ProcessHandle { handle: 0 });
        let waited = handle.wait(2000).unwrap_or(-1);
        let exit = handle.exit_code().unwrap_or(-1);
        let closed = handle.close();
        let kill_command = process_command("sh").unwrap_or(ProcessCommand { handle: 0 });
        let kill_arg0 = kill_command.arg("-c").unwrap_or(false);
        let kill_arg1 = kill_command.arg("sleep 5").unwrap_or(false);
        let kill_handle = kill_command.spawn().unwrap_or(ProcessHandle { handle: 0 });
        let killed = kill_handle.kill().unwrap_or(false);
        let kill_waited = kill_handle.wait(2000);
        let kill_closed = kill_handle.close();
        arg0 and arg1 and waited == 0 and exit == 0 and closed and kill_arg0 and kill_arg1 and killed and not kill_waited.is_err() and kill_closed;
    };
    buffer.free();
    pipeline_buffer.free();
    if cwd_len > 0 and copied_cwd == cwd_len and pid > 0 and child_code == 42 and captured and piped and spawned {
        42;
    } else {
        0;
    };
}
