import std::compress;

import std::json;

import std::status;

def main() -> i64 {
    let source = ffi_buffer_from_bytes("[1,2,3]").unwrap_or(Buffer { handle: 0 });
    let compressed = ffi_buffer_new(128).unwrap_or(Buffer { handle: 0 });
    let restored = ffi_buffer_new(128).unwrap_or(Buffer { handle: 0 });
    let tiny = ffi_buffer_new(8).unwrap_or(Buffer { handle: 0 });
    let invalid = ffi_buffer_from_bytes("not-gzip").unwrap_or(Buffer { handle: 0 });
    let compressed_result = compress_gzip_buffer(source, source.used_len(), compressed);
    let too_small = compress_gzip_buffer(source, source.used_len(), tiny).err().unwrap_or(0);
    let invalid_status = decompress_gzip_buffer(invalid, invalid.used_len(), restored).err().unwrap_or(0);
    let parsed_ok = if compressed_result.is_ok { let restored_result = decompress_gzip_buffer(compressed, compressed_result.value, restored); if restored_result.is_ok { let doc_result = json_parse_buffer(restored, restored_result.value); if doc_result.is_ok { let doc = doc_result.value; let root = doc.root(); let count = root.array_len().unwrap_or(0); let closed = doc.close(); count == 3 and closed and restored_result.value == source.used_len(); } else { false; }; } else { false; }; } else { false; };
    let ok = parsed_ok and compressed_result.value > source.used_len() and too_small == STATUS_BUFFER_TOO_SMALL() and invalid_status == STATUS_PARSE();
    invalid.free();
    tiny.free();
    restored.free();
    compressed.free();
    source.free();
    if ok { 0; } else { 1; };
}