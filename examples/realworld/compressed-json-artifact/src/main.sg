import std::compress;

import std::json;

import std::status;

def compressed_json_artifact_smoke() -> i64 {
    let source = ffi_buffer_from_bytes("[1,2,3]").unwrap_or(Buffer { handle: 0 });
    let compressed = ffi_buffer_new(128).unwrap_or(Buffer { handle: 0 });
    let compressed_again = ffi_buffer_new(128).unwrap_or(Buffer { handle: 0 });
    let restored = ffi_buffer_new(128).unwrap_or(Buffer { handle: 0 });
    let tiny = ffi_buffer_new(8).unwrap_or(Buffer { handle: 0 });
    let invalid = ffi_buffer_from_bytes("not-gzip").unwrap_or(Buffer { handle: 0 });
    let compressed_len = match compress_gzip_buffer(source, source.used_len(), compressed) {
        Ok(value) => value,
        Err(_) => -1,
    };
    let compressed_again_len = match compress_gzip_buffer(source, source.used_len(), compressed_again) {
        Ok(value) => value,
        Err(_) => -1,
    };
    let too_small = compress_gzip_buffer(source, source.used_len(), tiny).err().unwrap_or(0);
    let invalid_status = decompress_gzip_buffer(invalid, invalid.used_len(), restored).err().unwrap_or(0);
    let parsed_ok = if compressed_len >= 0 {
        match decompress_gzip_buffer(compressed, compressed_len, restored) {
            Ok(restored_len) => match json_parse_buffer(restored, restored_len) {
                Ok(doc) => {
                    let root = doc.root();
                    let count = root.array_len().unwrap_or(0);
                    let closed = doc.close();
                    count == 3 and closed and restored_len == source.used_len()
                },
                Err(_) => false,
            },
            Err(_) => false,
        }
    } else {
        false
    };
    let deterministic_len = compressed_len >= 0 and compressed_again_len >= 0 and compressed_len == compressed_again_len;
    let gzip_shape = compressed_len > source.used_len();
    let ok = parsed_ok and deterministic_len and gzip_shape and too_small == STATUS_BUFFER_TOO_SMALL() and invalid_status == STATUS_PARSE();
    invalid.free();
    tiny.free();
    restored.free();
    compressed_again.free();
    compressed.free();
    source.free();
    if ok { 0; } else { 1; };
}

def main() -> i64 {
    compressed_json_artifact_smoke();
}
