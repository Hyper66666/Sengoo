import std::async;

import std::status;

async def fast_value() -> i64 {
    await sleep(1);
    5;
}

async def slow_value() -> i64 {
    await sleep(5);
    9;
}

async def channel_round_trip() -> i64 {
    let pair = channel_bounded(2);
    if not pair.is_ok { return pair.error; };
    let sender = channel_pair_sender(pair.value);
    let receiver = channel_pair_receiver(pair.value);
    let sent = await channel_send_i64(sender, 64);
    let received = await channel_recv_i64(receiver);
    channel_sender_drop(sender);
    channel_pair_drop(pair.value);
    if not sent.is_ok { return sent.error; };
    if received.is_ok { received.value; } else { received.error; };
}

async def mutex_score() -> i64 {
    let mutex = mutex_new_i64(20);
    let locked = await mutex_lock_async(mutex);
    if not locked.is_ok { return locked.error; };
    let unlocked = mutex_unlock_i64(mutex, locked.value + 2);
    mutex_drop(mutex);
    if unlocked.is_ok { unlocked.value; } else { unlocked.error; };
}

async def main() -> i64 {
    let invalid_channel = channel_bounded(0);
    let invalid_status = not invalid_channel.is_ok and invalid_channel.error == STATUS_INVALID_ARGUMENT();
    let channel_value = await channel_round_trip();
    let mutex_value = await mutex_score();
    let first = spawn(fast_value());
    let second = spawn(slow_value());
    let selected = select(first, second);
    if not invalid_status { return 1; };
    if channel_value != 64 { return 2; };
    if mutex_value != 22 { return 3; };
    if selected != 5 { return selected; };
    0;
}