import std::async;

import std::status;

async def immediate() -> i64 {
    7;
}

async def delayed() -> i64 {
    await sleep(4);
    11;
}

async def main() -> i64 {
    match channel_bounded(0) {
        Ok(pair) => {
            channel_pair_drop(pair);
            return 1;
        },
        Err(error) => {
            if error != STATUS_INVALID_ARGUMENT() { return 2; }
        },
    }
    let pair = match channel_bounded(1) {
        Ok(value) => value,
        Err(_) => return 3,
    };
    let sender = channel_pair_sender(pair);
    let receiver = channel_pair_receiver(pair);
    let sent = await channel_send_i64(sender, 42);
    if not sent.is_ok {
        return 4;
    }
    let received = await channel_recv_i64(receiver);
    channel_sender_drop(sender);
    channel_pair_drop(pair);
    if not received.is_ok {
        return 5;
    }
    let received_value = received.value;
    if received_value != 42 { return 6; };
    let mutex = mutex_new_i64(3);
    let locked = await mutex_lock_async(mutex);
    if not locked.is_ok {
        return 7;
    }
    let locked_value = locked.value;
    if locked_value != 3 { return 8; };
    let unlocked = mutex_unlock_i64(mutex, 8);
    mutex_drop(mutex);
    let unlocked = match unlocked {
        Ok(value) => value,
        Err(_) => return 9,
    };
    if unlocked != 8 { return 10; };
    let first = spawn(immediate());
    let second = spawn(delayed());
    if select(first, second) == 7 { 0; } else { 11; };
}
