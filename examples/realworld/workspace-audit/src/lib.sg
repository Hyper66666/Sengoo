import std::dir;

import std::collections;

import std::async;

import std::file;

import std::json;

import std::path;

import std::status;

import std::string;

struct AuditConfig {
    max_depth: i64,
    require_tests: bool,
}

trait AuditCheck {
    def score(self) -> i64 {
    }
}

struct WorkspaceSummary {
    source_files: i64,
    test_files: i64,
    manifests: i64,
    bytes: i64,
}

impl AuditCheck for WorkspaceSummary {
    def score(self) -> i64 {
        self.source_files * 10 + self.test_files * 7 + self.manifests * 5 + if self.bytes > 0 { 3; } else { 0; };
    }
}

def default_config() -> AuditConfig {
    AuditConfig { max_depth: 3, require_tests: true };
}

def load_config(path_name: &str) -> AuditConfig {
    if not file_exists(path_name) { default_config(); } else { let len = file_len(path_name).unwrap_or(0); if len <= 0 { default_config(); } else { let buffer_result = ffi_buffer_new(len + 1); if buffer_result.is_ok { let buffer = buffer_result.value; let read = file_read_into(path_name, buffer).unwrap_or(0); let doc_result = json_parse_buffer(buffer, read); if doc_result.is_ok { let doc = doc_result.value; let root = doc.root(); let max_depth_value = if root.object_has("max_depth") { root.object_get("max_depth").unwrap_or(JsonValue { doc_handle: 0, node_id: 0 }).number_i64().unwrap_or(3); } else { 3; }; let require_tests_value = if root.object_has("require_tests") { root.object_get("require_tests").unwrap_or(JsonValue { doc_handle: 0, node_id: 0 }).bool_value().unwrap_or(true); } else { true; }; AuditConfig { max_depth: max_depth_value, require_tests: require_tests_value }; } else { default_config(); }; } else { default_config(); }; }; };
}

def empty_summary() -> WorkspaceSummary {
    WorkspaceSummary { source_files: 0, test_files: 0, manifests: 0, bytes: 0 };
}

def summarize_workspace(root: &str, config: AuditConfig) -> Result<WorkspaceSummary, i64> {
    if config.max_depth < 0 {
        return Result { is_ok: true, value: empty_summary(), error: 0 };
    }

    let walk_result = dir_walk(root, config.max_depth);
    if walk_result.is_err() {
        return Result { is_ok: false, value: empty_summary(), error: walk_result.error };
    }

    let walk = walk_result.value;
    let mut source_files = 0;
    let mut test_files = 0;
    let mut manifests = 0;
    let mut bytes = 0;
    let mut done = false;
    while !done {
        let next = walk.next_string();
        if next.is_ok {
            let path_name = next.value;
            let path_view = path_name.as_str();
            if str_ends_with(path_view, ".sg") {
                source_files = source_files + 1;
                if str_contains(path_view, "tests") {
                    test_files = test_files + 1;
                }
            }
            if str_ends_with(path_view, "Sengoo.toml") {
                manifests = manifests + 1;
            }
            bytes = bytes + file_len(path_view).unwrap_or(0);
        } else if next.error == STATUS_NOT_FOUND() {
            done = true;
        } else {
            return Result { is_ok: false, value: empty_summary(), error: next.error };
        }
    }

    Result {
        is_ok: true,
        value: WorkspaceSummary {
            source_files: source_files,
            test_files: test_files,
            manifests: manifests,
            bytes: bytes,
        },
        error: 0,
    }
}

def write_json_report(path_name: &str, summary: WorkspaceSummary) -> Result<i64, i64> {
    let counts: HashMap<String, i64> = hashmap_new();
    counts.insert("source_files", summary.source_files);
    counts.insert("test_files", summary.test_files);
    counts.insert("manifests", summary.manifests);
    counts.insert("bytes", summary.bytes);
    let doc = json_doc_object()?;
    let root = doc.root();
    root.object_set(
        "source_files",
        doc.new_number(counts.get("source_files").unwrap_or(0) as f64)?,
    )?;
    root.object_set(
        "test_files",
        doc.new_number(counts.get("test_files").unwrap_or(0) as f64)?,
    )?;
    root.object_set(
        "manifests",
        doc.new_number(counts.get("manifests").unwrap_or(0) as f64)?,
    )?;
    root.object_set(
        "bytes",
        doc.new_number(counts.get("bytes").unwrap_or(0) as f64)?,
    )?;
    root.object_set("score", doc.new_number(summary.score() as f64)?)?;
    let rendered = doc.serialize_string()?;
    file_write_str(path_name, rendered.as_str())
}

def parallel_score(summary: WorkspaceSummary) -> Result<i64, i64> {
    runtime_enable_thread_pool(2)?;
    let counter = arc_mutex_new_i64(0);
    let source_job = spawn_shared_counter_i64(
        counter.clone_arc_mutex(),
        10,
        summary.source_files,
    )?;
    let test_job = spawn_shared_counter_i64(
        counter.clone_arc_mutex(),
        7,
        summary.test_files,
    )?;
    let manifest_job = spawn_shared_counter_i64(
        counter.clone_arc_mutex(),
        5,
        summary.manifests,
    )?;
    let byte_job = spawn_shared_counter_i64(
        counter.clone_arc_mutex(),
        3,
        if summary.bytes > 0 { 1 } else { 0 },
    )?;
    source_job.join();
    test_job.join();
    manifest_job.join();
    byte_job.join();
    Result { is_ok: true, value: counter.get(), error: 0 }
}

def audit_workspace(root: &str, config_path: &str, report_path: &str) -> Result<i64, i64> {
    let config = load_config(config_path);
    let summary = summarize_workspace(root, config)?;
    if config.require_tests && summary.test_files == 0 {
        return Result { is_ok: false, value: 0, error: STATUS_NOT_FOUND() };
    }

    let concurrent_score = parallel_score(summary)?;
    if concurrent_score != summary.score() {
        return Result { is_ok: false, value: 0, error: STATUS_UNKNOWN() };
    }

    let text = format(
        "workspace-audit: sources={} tests={} manifests={} bytes={} score={}",
        summary.source_files,
        summary.test_files,
        summary.manifests,
        summary.bytes,
        concurrent_score,
    );
    let wrote_text = file_write_str(report_path, text.as_str())?;
    let json_report_path = if str_eq(root, "fixture") {
        "fixture/audit-report.json"
    } else {
        "audit-report.json"
    };
    let wrote_json = write_json_report(json_report_path, summary)?;
    Result {
        is_ok: true,
        value: wrote_text + wrote_json + concurrent_score,
        error: 0,
    }
}
