// examples/stdlib/24_compress.sg
//
// Demonstrates: importing std::compress gzip Buffer helpers for JSON bytes.
//
// Run: sgc run examples/stdlib/24_compress.sg
// Expected output: 24

import std::compress;

import std::json;

import std::status;

def main() -> i64 {
    let source = ffi_buffer_from_bytes("[1,2,3]").unwrap_or(Buffer { handle: 0 });
    let compressed = ffi_buffer_new(128).unwrap_or(Buffer { handle: 0 });
    let restored = ffi_buffer_new(128).unwrap_or(Buffer { handle: 0 });
    let tiny = ffi_buffer_new(8).unwrap_or(Buffer { handle: 0 });

    let mut compressed_ok = false;
    let mut restored_ok = false;
    let mut count = 0;
    match compress_gzip_buffer(source, source.used_len(), compressed) {
        Ok(compressed_len) => {
            compressed_ok = true;
            match decompress_gzip_buffer(compressed, compressed_len, restored) {
                Ok(restored_len) => {
                    restored_ok = true;
                    match json_parse_buffer(restored, restored_len) {
                        Ok(doc) => {
                            let root = doc.root();
                            count = root.array_len().unwrap_or(0);
                            let ignored = doc.close();
                        },
                        Err(_) => {},
                    }
                },
                Err(_) => {},
            }
        },
        Err(_) => {},
    }
    let too_small = compress_gzip_buffer(source, source.used_len(), tiny).err().unwrap_or(0);

    tiny.free();
    restored.free();
    compressed.free();
    source.free();

    if compressed_ok
        and restored_ok
        and count == 3
        and too_small == STATUS_BUFFER_TOO_SMALL() {
        print(24);
    } else {
        print(0);
    }
    0
}
