// examples/stdlib/04_option_result.sg
//
// Demonstrates: bool std::option/std::result constructors, unwrap helpers, and projections.
//
// Run: sgc run examples/stdlib/04_option_result.sg
// Expected output: 7

import std::option;
import std::result;

def main() -> i64 {
    let some_flag: Option<bool> = option_some_bool(true);
    let none_flag: Option<bool> = option_none_bool();
    let ok_flag: Result<bool, i64> = result_ok_bool(true);
    let err_flag: Result<bool, i64> = result_err_bool(7);
    let option_value = some_flag.unwrap();
    let expected_result = ok_flag.expect("result bool ok");

    let ok = option_value
        && none_flag.is_none()
        && expected_result
        && err_flag.err().unwrap_or(0) == 7;

    if ok {
        print(7);
    } else {
        print(0);
    }
    0
}
