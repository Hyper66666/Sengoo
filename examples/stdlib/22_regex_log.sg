// examples/stdlib/22_regex_log.sg
//
// Demonstrates: importing std::regex and std::log helpers.
//
// Run: sgc run examples/stdlib/22_regex_log.sg
// Expected output: 22

import std::regex;
import std::log;

def main() -> i64 {
    match log_set_level(2) {
        Ok(_) => {},
        Err(_) => return 1,
    }
    let pattern = match regex_compile("^sengoo$") {
        Ok(value) => value,
        Err(_) => return 1,
    };
    let matched = match pattern.is_match("sengoo") {
        Ok(value) => value,
        Err(_) => return 1,
    };
    pattern.drop();
    if matched {
        print(22);
        0
    } else {
        1
    }
}
