// examples/stdlib/25_formatting.sg
//
// Demonstrates: owned String formatting, Debug, positional placeholders, width, precision, and f-strings.
//
// Run: sgc run examples/stdlib/25_formatting.sg
// Expected output: 25

import std::string;

struct Point {
    x: i64,
    ok: bool,
}

struct CustomTag {
    id: i64,
}

impl Debug for CustomTag {
    def to_string(&self) -> String {
        string_from_str("custom").value
    }
}

#[derive(Debug)]
enum MaybeNumber {
    Empty,
    Value(i64),
}

def main() -> i64 {
    let label_result = string_from_str("main");
    if label_result.is_ok == false {
        return 1;
    }

    let label = label_result.value;
    let pushed = label.push_char('!');
    if pushed.is_ok == false {
        return 1;
    }

    let rendered = format("{1}:{0:?}", 7, label);
    if rendered.len() != 7 {
        return 1;
    }

    let padded = format("{:>4}", 7);
    if padded.len() != 4 {
        return 1;
    }

    let rounded = format("{:.2}", 3.14159);
    if rounded.len() != 4 {
        return 1;
    }

    let padded_round = format("{:>6.2}", 3.14159);
    if padded_round.len() != 6 {
        return 1;
    }

    let point = Point { x: 7, ok: true };
    let debugged = format("{:?}", point);
    if debugged.len() != 24 {
        return 1;
    }

    let custom = CustomTag { id: 9 };
    let custom_debug = format("{:?}", custom);
    if custom_debug.len() != 6 {
        return 1;
    }

    let payload = MaybeNumber::Value(42);
    let payload_debug = format("{:?}", payload);
    if payload_debug.len() != 22 {
        return 1;
    }

    let n = 3;
    let interpolated = f"n={n}";
    if interpolated.len() != 3 {
        return 1;
    }

    print(25);
    0
}
