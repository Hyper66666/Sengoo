// examples/stdlib/15_dir_listing.sg
//
// Demonstrates: importing std::dir helpers for deterministic non-recursive directory listing.
//
// Run: sgc run examples/stdlib/15_dir_listing.sg
// Expected output: 15

import std::dir;
import std::file;

def main() -> i64 {
    let root = "sengoo_tmp_dir_listing_example";
    let a = "sengoo_tmp_dir_listing_example/a.txt";
    let b = "sengoo_tmp_dir_listing_example/b.txt";
    file_remove(a);
    file_remove(b);
    dir_remove(root);

    let made = dir_create(root).unwrap_or(false);
    let wrote_b = file_write_str(b, "b").unwrap_or(0);
    let wrote_a = file_write_str(a, "a").unwrap_or(0);
    let buffer = ffi_buffer_new(16).unwrap_or(Buffer { handle: 0 });
    let count = dir_entry_count(root).unwrap_or(0);
    let first_len = dir_entry_name(root, 0, buffer).unwrap_or(0);
    let missing = dir_entry_name(root, 2, buffer).is_err();

    buffer.free();
    file_remove(a);
    file_remove(b);
    let removed = dir_remove(root).unwrap_or(false);

    print(if made && wrote_a == 1 && wrote_b == 1 && count == 2 && first_len == 5 && missing && removed {
        15
    } else {
        0
    });
    0
}
