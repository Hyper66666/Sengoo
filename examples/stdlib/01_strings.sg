// examples/stdlib/01_strings.sg
//
// Demonstrates: importing std::string helper functions.
//
// Run: sgc run examples/stdlib/01_strings.sg
// Expected output: 8

import std::string;

def main() -> i64 {
    let word = str_append("sen", "goo");
    let repeated = str_repeat("ha", 2);
    let trimmed = str_trim("  sengoo\n").unwrap_or(String { handle: 0 });
    let upper = str_to_ascii_upper("senGoo").unwrap_or(String { handle: 0 });
    let lower = str_to_ascii_lower("SenGOO").unwrap_or(String { handle: 0 });
    let score = if str_eq(word, "sengoo")
        && str_ne(word, repeated)
        && str_contains(word, "goo")
        && str_starts_with(word, "sen")
        && str_ends_with(word, "goo")
        && str_index_of(word, "goo") == 3
        && str_is_empty("")
        && str_is_not_empty(repeated)
        && trimmed.len() == 6
        && upper.len() == 6
        && lower.len() == 6 {
        str_len(word) + str_len(repeated) - 2
    } else {
        0
    };

    print(score);
    0
}
