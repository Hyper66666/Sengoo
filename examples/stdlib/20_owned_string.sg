// examples/stdlib/20_owned_string.sg
//
// Demonstrates: importing std::string owned String helpers.
//
// Run: sgc run examples/stdlib/20_owned_string.sg
// Expected output: 20

import std::string;
import std::ffi;

def main() -> i64 {
    let owned = match string_from_str("hello") {
        Ok(value) => value,
        Err(_) => return 1,
    };
    if owned.len() != 5 {
        return 1;
    }
    match owned.push_str("!") {
        Ok(_) => {},
        Err(_) => return 1,
    }
    if owned.len() != 6 {
        return 1;
    }
    let copy = match owned.clone() {
        Ok(value) => value,
        Err(_) => return 1,
    };
    let buffer = match ffi_buffer_new(16) {
        Ok(value) => value,
        Err(_) => return 1,
    };
    let copied = match copy.copy_to_buffer(buffer) {
        Ok(value) => value,
        Err(_) => return 1,
    };
    if copied != 6 {
        return 1;
    }
    print(20);
    0
}
