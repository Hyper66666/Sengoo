// examples/stdlib/20_owned_string.sg
//
// Demonstrates: importing std::string owned String helpers with auto-drop.
//
// Run: sgc run examples/stdlib/20_owned_string.sg
// Expected output:
// sengoo
// 20

import std::string;

def main() -> i64 {
    let prefix = string_from_str("sen");
    if prefix.is_ok == false {
        return 1;
    }
    let base = prefix.value;
    let text: String = base + "goo";
    if text.len() != 6 || !text.contains("eng") {
        return 1;
    }
    if !text.starts_with("sen") || !text.ends_with("goo") {
        return 1;
    }

    let same = string_from_str("sengoo");
    let different = string_from_str("sengo");
    if !same.is_ok || !different.is_ok {
        return 1;
    }
    if !(text == same.value) {
        return 1;
    }
    if text == different.value {
        return 1;
    }

    print(text);
    print(20);
    0
}
