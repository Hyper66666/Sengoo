// examples/stdlib/23_config_hash.sg
//
// Demonstrates: importing std::config and std::hash helpers with Buffer output.
//
// Run: sgc run examples/stdlib/23_config_hash.sg
// Expected output: 23

import std::config;
import std::hash;
import std::ffi;

def main() -> i64 {
    let doc = match ini_parse("tool=sengoo") {
        Ok(value) => value,
        Err(_) => return 1,
    };
    let buffer = ffi_buffer_new(256).unwrap_or(Buffer { handle: 0 });
    let digest = hash_sha256_str("sengoo", buffer);
    doc.drop();
    buffer.free();
    let digest_len = match digest {
        Ok(value) => value,
        Err(_) => return 1,
    };
    if digest_len == 64 {
        print(23);
        0
    } else {
        1
    }
}
