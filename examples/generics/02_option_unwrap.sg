// examples/generics/02_option_unwrap.sg
//
// Demonstrates: Option<T> with unwrap_or on Some and None values.
//
// Run: sgc run examples/generics/02_option_unwrap.sg
// Expected output: 9

enum Option<T> {
    None,
    Some(T),
}

def some_i64(value: i64) -> Option<i64> {
    Some(value)
}

def none_i64() -> Option<i64> {
    None
}

impl<T> Option<T> {
    def unwrap_or(self, fallback: T) -> T {
        match self {
            Some(value) => value,
            None => fallback,
        }
    }
}

def main() -> i64 {
    let present = some_i64(9);
    let missing = none_i64();
    let value = present.unwrap_or(0) + missing.unwrap_or(0);
    print(value);
    0
}
