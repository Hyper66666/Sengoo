import std::ffi;

def main() -> i64 {
    let lib = ffi_open("self://builtin");
    if lib.is_err() {
        0
    } else {
        let loaded = lib.unwrap_or(CLib { handle: 0 });
        let value = loaded.call_i64_2("sengoo_ffi_builtin_add2", 10, 32);
        loaded.close();
        value.unwrap_or(0)
    }
}
