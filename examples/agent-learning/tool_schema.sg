import sgschema;

import std::args;

import std::string;

def schema_input() -> Result<String, i64> {
    let length = arg_len(0)?;
    if length > 4096 { return string_result_err(13); };
    let bytes = ffi_buffer_new(length)?;
    let copied = arg_copy(0, bytes)?;
    string_from_utf8(bytes, copied);
}

def schema_tool() -> Result<i64, i64> {
    let source = schema_input()?;
    let input = json_parse_limits(source.as_str(), 4096, 256)?;
    let schema = json_parse("{\"type\":\"object\",\"properties\":{\"count\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10}},\"required\":[\"count\"],\"additionalProperties\":false}")?;
    let checked = schema_validate(schema.root(), input.root())?;
    let output = json_doc_object()?;
    output.root().object_set("ok", output.new_bool(checked.valid)?)?;
    output.root().object_set("stage", output.new_string(checked.stage.as_str())?)?;
    output.root().object_set("pointer", output.new_string(checked.pointer.as_str())?)?;
    output.root().object_set("keyword", output.new_string(checked.keyword.as_str())?)?;
    let encoded = output.serialize_string()?;
    println(encoded.as_str());
    Result { is_ok: true, value: if checked.valid { 0; } else { 2; }, error: 0 };
}

def main() -> i64 {
    let result = schema_tool();
    if not result.is_ok() { print("{\"ok\":false,\"code\":"); print(result.error); println("}"); return 1; };
    result.value;
}
