// Sengoo 方法调用测试

impl i64 {
    def abs(self) -> i64 {
        if self < 0 {
            -self
        } else {
            self
        }
    }

    def add(self, other: i64) -> i64 {
        self + other
    }
}

impl bool {
    def to_int(self) -> i64 {
        if self {
            1
        } else {
            0
        }
    }
}

def main() -> i64 {
    let x = -21;
    let abs_x = x.abs();
    let sum = abs_x.add(21);
    let b = true;
    let int_b = b.to_int();
    sum + int_b  // 应该是 42 + 1 = 43
}
