import selfhost_core;

import std::assert;

import std::file;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def sh_test_sources() -> Result<bool, i64> {
    let sources = sh_sources_new(3, 262144);
    let text = string_from_str("a中😀z")?;
    let first = sh_source_add(&sources, &text)?;
    assert_eq_i64(first, 0, "core.sg", 15);
    text.clear();
    assert_eq_i64(sh_source_len(&sources, first)?, 9, "core.sg", 17);
    let chinese = sh_span_make(&sources, first, 1, 4)?;
    let emoji = sh_span_make(&sources, first, 4, 8)?;
    assert_eq_str(sh_span_text(&sources, chinese)?.as_str(), "中", "core.sg", 20);
    assert_eq_str(sh_span_text(&sources, emoji)?.as_str(), "😀", "core.sg", 21);
    assert_true(sh_span_make(&sources, first, 9, 9).is_ok(), "core.sg", 22);
    assert_eq_i64(sh_span_make(&sources, first, 2, 4).error, 1003, "core.sg", 23);
    assert_eq_i64(sh_span_make(&sources, first, 1, 6).error, 1003, "core.sg", 24);
    assert_eq_i64(sh_span_make(&sources, first, -1, 4).error, 1002, "core.sg", 25);
    assert_eq_i64(sh_span_make(&sources, first, 8, 4).error, 1002, "core.sg", 26);
    assert_eq_i64(sh_span_make(&sources, first, 0, 10).error, 1002, "core.sg", 27);
    assert_eq_i64(sh_source_len(&sources, -1).error, 1001, "core.sg", 28);
    assert_eq_i64(sh_source_len(&sources, 1).error, 1001, "core.sg", 29);
    let big = string_new();
    let mut index = 0;
    while index < 16384 { big.push_str("abcdefghijklmnop")?; index = index + 1; };
    assert_eq_i64(sh_source_add(&sources, &big)?, 1, "core.sg", 33);
    assert_eq_i64(sh_source_len(&sources, 0)?, 9, "core.sg", 34);
    assert_eq_i64(sh_source_len(&sources, 1)?, 262144, "core.sg", 35);
    big.push_str("x")?;
    assert_eq_i64(sh_source_add(&sources, &big).error, 1004, "core.sg", 37);
    assert_eq_i64(sh_source_count(&sources), 2, "core.sg", 38);
    let empty = string_new();
    assert_eq_i64(sh_source_add(&sources, &empty)?, 2, "core.sg", 40);
    assert_eq_i64(sh_source_add(&sources, &empty).error, 1004, "core.sg", 41);
    assert_eq_i64(sh_span_text(&sources, chinese)?.len(), 3, "core.sg", 42);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_symbols() -> Result<bool, i64> {
    let symbols = sh_symbols_new(2);
    let a = string_from_str("alpha")?;
    let b = string_from_str("中😀")?;
    assert_eq_i64(sh_intern(&symbols, &a)?, 0, "core.sg", 50);
    assert_eq_i64(sh_intern(&symbols, &b)?, 1, "core.sg", 51);
    assert_eq_i64(sh_intern(&symbols, &a)?, 0, "core.sg", 52);
    assert_eq_i64(sh_symbol_count(&symbols), 2, "core.sg", 53);
    let other = string_from_str("other")?;
    assert_eq_i64(sh_intern(&symbols, &other).error, 1004, "core.sg", 55);
    a.clear();
    let copy = sh_symbol_text(&symbols, 0)?;
    assert_eq_str(copy.as_str(), "alpha", "core.sg", 58);
    copy.clear();
    assert_eq_str(sh_symbol_text(&symbols, 0)?.as_str(), "alpha", "core.sg", 60);
    assert_eq_i64(sh_symbol_text(&symbols, -1).error, 1006, "core.sg", 61);
    assert_eq_i64(sh_symbol_text(&symbols, 2).error, 1006, "core.sg", 62);
    let second = sh_symbols_new(2);
    assert_eq_i64(sh_intern(&second, &b)?, 0, "core.sg", 64);
    assert_eq_i64(sh_intern(&second, &other)?, 1, "core.sg", 65);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_nodes() -> Result<bool, i64> {
    let sources = sh_sources_new(1, 100);
    let text = string_from_str("node")?;
    let source = sh_source_add(&sources, &text)?;
    let span = sh_span_make(&sources, source, 0, 4)?;
    let nodes = sh_nodes_new(4096);
    let mut index = 0;
    while index < 4096 { let child = index - 1; let id = sh_node_add(&nodes, &sources, ShNode { kind: 7, span: span, payload: index * 3, child: child })?; assert_eq_i64(id, index, "core.sg", 80); index = index + 1; };
    assert_eq_i64(sh_node_count(&nodes), 4096, "core.sg", 83);
    let first = sh_node_get(&nodes, 0)?;
    let last = sh_node_get(&nodes, 4095)?;
    assert_eq_i64(first.child, -1, "core.sg", 86);
    assert_eq_i64(first.kind, 7, "core.sg", 87);
    assert_eq_i64(last.child, 4094, "core.sg", 88);
    assert_eq_i64(last.payload, 12285, "core.sg", 89);
    assert_eq_i64(last.span.end, 4, "core.sg", 90);
    assert_eq_i64(sh_node_get(&nodes, -1).error, 1005, "core.sg", 91);
    assert_eq_i64(sh_node_get(&nodes, 4096).error, 1005, "core.sg", 92);
    assert_eq_i64(sh_node_add(&nodes, &sources, ShNode { kind: 7, span: span, payload: 0, child: -1 }).error, 1004, "core.sg", 93);
    assert_eq_i64(sh_node_add(&nodes, &sources, ShNode { kind: 7, span: span, payload: 0, child: 4096 }).error, 1005, "core.sg", 94);
    let invalid = ShSpan { source: source, start: 3, end: 2 };
    assert_eq_i64(sh_node_add(&nodes, &sources, ShNode { kind: 7, span: invalid, payload: 0, child: -1 }).error, 1002, "core.sg", 96);
    assert_eq_i64(sh_node_count(&nodes), 4096, "core.sg", 97);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_lifecycle() -> Result<bool, i64> {
    let sources = sh_sources_new(1, 100);
    let text = string_from_str("lifecycle")?;
    let id = sh_source_add(&sources, &text)?;
    let span = sh_span_make(&sources, id, 0, 9)?;
    let symbols = sh_symbols_new(1);
    sh_intern(&symbols, &text)?;
    let nodes = sh_nodes_new(1);
    sh_node_add(&nodes, &sources, ShNode { kind: 1, span: span, payload: 0, child: -1 })?;
    assert_eq_i64(sh_source_add(&sources, &text).error, 1004, "core.sg", 111);
    assert_eq_i64(sh_symbol_text(&symbols, 1).error, 1006, "core.sg", 112);
    assert_eq_i64(sh_span_make(&sources, id, 0, 10).error, 1002, "core.sg", 113);
    let files = sh_sources_new(1, 64);
    assert_eq_i64(sh_source_load(&files, "selfhost/tests/fixtures/missing-never-created.sg").error, 1007, "core.sg", 114);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_files() -> Result<bool, i64> {
    let sources = sh_sources_new(3, 64);
    let id = sh_source_load(&sources, "selfhost/tests/fixtures/utf8.txt")?;
    assert_eq_i64(id, 0, "core.sg", 121);
    assert_eq_i64(sh_source_len(&sources, id)?, 9, "core.sg", 122);
    let span = sh_span_make(&sources, id, 1, 8)?;
    assert_eq_str(sh_span_text(&sources, span)?.as_str(), "中😀", "core.sg", 124);
    assert_eq_i64(sh_source_load(&sources, "selfhost/tests/fixtures/missing-never-created.sg").error, 1007, "core.sg", 125);
    let small = sh_sources_new(1, 3);
    assert_eq_i64(sh_source_load(&small, "selfhost/tests/fixtures/utf8.txt").error, 1004, "core.sg", 127);
    let invalid = ffi_buffer_from_bytes("中")?;
    file_write_str_raw(sengoo_stdlib_str_ptr("target/selfhost-invalid-source.sg"), invalid.ptr() + 1, 1)?;
    assert_eq_i64(sh_source_load(&sources, "target/selfhost-invalid-source.sg").error, 1003, "core.sg", 130);
    assert_eq_i64(sh_source_count(&sources), 1, "core.sg", 131);
    file_write_str("target/selfhost-empty-source.sg", "")?;
    assert_eq_i64(sh_source_load(&sources, "target/selfhost-empty-source.sg")?, 1, "core.sg", 133);
    assert_eq_i64(sh_source_len(&sources, 1)?, 0, "core.sg", 134);
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let snapshots = sengoo_file_snapshot_live_handle_count();
    let snapshot_bytes = sengoo_file_snapshot_live_bytes();
    let result = sh_test_sources();
    if not result.is_ok() { println(result.error); return 1; };
    let symbols = sh_test_symbols();
    if not symbols.is_ok() { println(symbols.error); return 2; };
    let nodes = sh_test_nodes();
    if not nodes.is_ok() { println(nodes.error); return 3; };
    let files = sh_test_files();
    if not files.is_ok() { println(files.error); return 5; };
    let mut index = 0;
    while index < 100 { let lifecycle = sh_test_lifecycle(); if not lifecycle.is_ok() { println(lifecycle.error); return 4; }; index = index + 1; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "core.sg", 135);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "core.sg", 136);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "core.sg", 137);
    assert_eq_i64(sengoo_file_snapshot_live_handle_count(), snapshots, "core.sg", 138);
    assert_eq_i64(sengoo_file_snapshot_live_bytes(), snapshot_bytes, "core.sg", 139);
    println("sources, UTF-8 spans, symbols, 4096 nodes, file errors, 100 resource rounds passed");
    println("selfhost core: ok");
    0;
}
