import selfhost_mir_lower;

import std::assert;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def sh_detach_round() -> Result<bool, i64> {
    let text = string_from_str("struct Buffer{handle:i64}\nstruct Destination{handle:i64}\nextern \"C\"{fn sg_acquire()->i64;fn sengoo_ffi_buffer_free(handle:i64)->i64;fn sg_destination_drop(handle:i64);fn sg_counts(round:i64)->i64;fn sengoo_ffi_buffer_len(handle:i64)->i64;}\nimpl Drop for Buffer{def drop(&mut self){sengoo_ffi_buffer_free(self.handle);}}\nimpl Drop for Destination{def drop(&mut self){sg_destination_drop(self.handle);}}\ndef exercise()->i64{let mut source=Buffer{handle:sg_acquire()};let raw=source.handle;source.handle=0;let destination=Destination{handle:raw};if sengoo_ffi_buffer_len(destination.handle)!=16{return 1;};42}\ndef main()->i64{let mut round=0;while round<100{if exercise()!=42{return 2;};round=round+1;if sg_counts(round)!=42{return 3;};};42}\n")?;
    let parsed = sh_parse(&text, 0, 10000);
    assert_eq_i64(parsed.error, 0, "detach.sg", 1);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "detach.sg", 2);
    let hir = sh_hir_lift(&text, &parsed.ast, &checked, 10000);
    if hir.error != 0 { println("lift"); println(hir.error); return result_err_bool(hir.error); };
    assert_eq_i64(hir.schema, 5, "detach.sg", 3);
    let mut action = 0;
    let mut found = -1;
    while action < sh_ownership_action_count(&hir.ownership) { if sh_ownership_action(&hir.ownership, action, 2) == 10 { assert_eq_i64(found, -1, "detach.sg", 4); found = action; }; action = action + 1; };
    assert_true(found >= 0, "detach.sg", 5);
    let node = sh_ownership_action(&hir.ownership, found, 0);
    let binding = sh_ownership_action(&hir.ownership, found, 1);
    let path = sh_ownership_action_path(&hir.ownership, found);
    let prior = sh_b_detach_previous(&hir.ownership, binding, found);
    assert_true(prior >= 0, "detach.sg", 6);
    let root_type = sh_s_resolve(&hir.checked, sh_binding_word(&hir.checked, binding, 3));
    let mut declaration = 0;
    let mut drop_self = -1;
    while declaration < sh_binding_count(&hir.checked) { if sh_binding_word(&hir.checked, declaration, 2) == 2 { let label = sh_symbol_text(&hir.checked.symbols, sh_binding_word(&hir.checked, declaration, 0))?; let signature = sh_s_resolve(&hir.checked, sh_binding_word(&hir.checked, declaration, 3)); let first = sh_s_resolve(&hir.checked, sh_s_argument(&hir.checked, signature, 0)); if sh_s_text_equal(&label, "drop") and sh_s_kind(&hir.checked, first) == 6 and sh_s_nominal(&hir.checked, sh_s_resolve(&hir.checked, sh_s_argument(&hir.checked, first, 0))) == sh_s_nominal(&hir.checked, root_type) { drop_self = first; }; }; declaration = declaration + 1; };
    assert_true(drop_self >= 0, "detach.sg", 49);
    hir.checked.types.words.set(drop_self * 6 + 2, 0);
    assert_false(sh_hir_detach_valid(&hir, found), "detach.sg", 50);
    hir.checked.types.words.set(drop_self * 6 + 2, 1);
    assert_true(sh_hir_detach_valid(&hir, found), "detach.sg", 51);
    let types_before = sh_type_count(&hir.checked.types);
    assert_eq_i64(sh_hir_validate(&hir), 0, "detach.sg", 7);
    assert_eq_i64(sh_type_count(&hir.checked.types), types_before, "detach.sg", 8);
    hir.ownership.actions.set(found * 5 + 4, 1);
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 9);
    hir.ownership.actions.set(found * 5 + 4, 0);
    hir.ownership.action_paths.set(found, sh_ownership_path_word(&hir.ownership, path, 1));
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 10);
    hir.ownership.action_paths.set(found, path);
    hir.ownership.actions.set(prior * 5 + 2, 1);
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 11);
    hir.ownership.actions.set(prior * 5 + 2, 2);
    hir.ownership.actions.set(found * 5, node + 1);
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 12);
    hir.ownership.actions.set(found * 5, node);
    assert_eq_i64(sh_hir_validate(&hir), 0, "detach.sg", 13);
    let root_path = sh_ownership_path_word(&hir.ownership, path, 1);
    let original_field = sh_ownership_path_word(&hir.ownership, path, 2);
    let original_root_type = sh_ownership_path_word(&hir.ownership, root_path, 3);
    let original_path_type = sh_ownership_path_word(&hir.ownership, path, 3);
    let target = sh_ast_child(&hir.ast, node, 0);
    let producer = sh_ownership_action(&hir.ownership, prior, 0);
    let original_target_type = sh_node_type(&hir.checked, target);
    let original_producer_type = sh_node_type(&hir.checked, producer);
    let root_owner = sh_adt_binding(&hir.checked, root_type);
    let mut foreign_field = -1;
    let mut candidate = 0;
    while candidate < sh_binding_count(&hir.checked) { if sh_binding_word(&hir.checked, candidate, 2) == 6 and sh_binding_word(&hir.checked, candidate, 6) != root_owner and sh_binding_word(&hir.checked, candidate, 7) == 0 { let label = sh_symbol_text(&hir.checked.symbols, sh_binding_word(&hir.checked, candidate, 0))?; if sh_s_text_equal(&label, "handle") { foreign_field = candidate; }; }; candidate = candidate + 1; };
    assert_true(foreign_field >= 0, "detach.sg", 52);
    hir.ownership.paths.set(path * 4 + 2, foreign_field);
    hir.checked.resolution.set(target, foreign_field);
    hir.checked.resolution.set(producer, foreign_field);
    assert_false(sh_hir_detach_valid(&hir, found), "detach.sg", 53);
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 54);
    assert_eq_i64(sh_type_count(&hir.checked.types), types_before, "detach.sg", 55);
    hir.ownership.paths.set(path * 4 + 2, original_field);
    hir.checked.resolution.set(target, original_field);
    hir.checked.resolution.set(producer, original_field);
    let foreign_type = sh_binding_word(&hir.checked, sh_binding_word(&hir.checked, foreign_field, 6), 3);
    hir.ownership.paths.set(root_path * 4 + 3, foreign_type);
    assert_false(sh_hir_detach_valid(&hir, found), "detach.sg", 56);
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 57);
    hir.ownership.paths.set(root_path * 4 + 3, original_root_type);
    hir.ownership.paths.set(path * 4 + 3, hir.checked.bool_type);
    assert_false(sh_hir_detach_valid(&hir, found), "detach.sg", 58);
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 59);
    hir.ownership.paths.set(path * 4 + 3, original_path_type);
    hir.checked.node_types.set(target, hir.checked.bool_type);
    assert_false(sh_hir_detach_valid(&hir, found), "detach.sg", 60);
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 61);
    hir.checked.node_types.set(target, original_target_type);
    hir.checked.node_types.set(producer, hir.checked.bool_type);
    assert_false(sh_hir_detach_valid(&hir, found), "detach.sg", 62);
    assert_eq_i64(sh_hir_validate(&hir), 5506, "detach.sg", 63);
    hir.checked.node_types.set(producer, original_producer_type);
    assert_eq_i64(sh_hir_validate(&hir), 0, "detach.sg", 64);
    assert_eq_i64(sh_type_count(&hir.checked.types), types_before, "detach.sg", 65);
    let encoded = sh_hir_encode(&hir, 1000000);
    assert_eq_i64(encoded.error, 0, "detach.sg", 14);
    encoded.words.set(1, 4);
    let old_schema = sh_hir_decode(&encoded.words, 1000000);
    assert_eq_i64(old_schema.error, 5502, "detach.sg", 40);
    encoded.words.set(1, 5);
    let decoded = sh_hir_decode(&encoded.words, 1000000);
    assert_eq_i64(decoded.error, 0, "detach.sg", 15);
    let reencoded = sh_hir_encode(&decoded, 1000000);
    assert_eq_i64(reencoded.error, 0, "detach.sg", 16);
    assert_eq_i64(encoded.words.len(), reencoded.words.len(), "detach.sg", 17);
    let mut word = 0;
    while word < encoded.words.len() { assert_eq_i64(encoded.words.get(word).unwrap_or(-1), reencoded.words.get(word).unwrap_or(-2), "detach.sg", 18); word = word + 1; };
    let lowered = sh_lower_hir(&decoded, 10000);
    if lowered.error != 0 { println("lower"); println(lowered.error); println(lowered.start); return result_err_bool(lowered.error); };
    let mut source_local = -1;
    let mut local = 0;
    while local < sh_mir_local_count(&lowered.mir) { let label = sh_symbol_text(&lowered.mir.symbols, sh_mir_local(&lowered.mir, local, 2)); if label.is_ok() and sh_s_text_equal(&label.value, "source") { assert_eq_i64(source_local, -1, "detach.sg", 42); source_local = local; }; local = local + 1; };
    assert_true(source_local >= 0, "detach.sg", 43);
    let mut initialized = 0;
    let mut moved = 0;
    let mut zero_site_flags = 0;
    let mut source_drops = 0;
    let mut store_zero = 0;
    let mut instruction = 0;
    while instruction < sh_mir_inst_count(&lowered.mir) { let opcode = sh_mir_inst(&lowered.mir, instruction, 2); let start = sh_mir_inst(&lowered.mir, instruction, 10); let end = sh_mir_inst(&lowered.mir, instruction, 11); if opcode == 25 and sh_mir_inst(&lowered.mir, instruction, 6) == source_local { if sh_mir_inst(&lowered.mir, instruction, 7) == 1 { initialized = initialized + 1; } else { moved = moved + 1; }; if start == sh_ast_word(&hir.ast, node, 2) and end == sh_ast_word(&hir.ast, node, 3) { zero_site_flags = zero_site_flags + 1; }; }; if opcode == 21 and sh_mir_inst(&lowered.mir, instruction, 6) == source_local { source_drops = source_drops + 1; }; if opcode == 15 and start == sh_ast_word(&hir.ast, node, 2) and end == sh_ast_word(&hir.ast, node, 3) { let rhs = sh_mir_inst_arg(&lowered.mir, instruction, 1); if sh_mir_inst(&lowered.mir, rhs, 2) == 4 and sh_mir_inst(&lowered.mir, rhs, 6) == 0 { store_zero = store_zero + 1; }; }; instruction = instruction + 1; };
    assert_eq_i64(initialized, 1, "detach.sg", 44);
    assert_eq_i64(moved, 1, "detach.sg", 45);
    assert_eq_i64(zero_site_flags, 0, "detach.sg", 46);
    assert_eq_i64(source_drops, 0, "detach.sg", 47);
    assert_eq_i64(store_zero, 1, "detach.sg", 48);
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let mut round = 0;
    while round < 20 { let result = sh_detach_round(); if not result.is_ok() { return 1; }; round = round + 1; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "detach.sg", 30);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "detach.sg", 31);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "detach.sg", 32);
    println("detach HIR facts: ok");
    0;
}
