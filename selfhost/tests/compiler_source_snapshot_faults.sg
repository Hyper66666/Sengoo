import selfhost_compiler_source_snapshot;

import std::assert;

import std::args;

extern "C" {
    fn sengoo_compiler_snapshot_test_fault(mode: i64) -> i64;
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_bytes() -> i64;
    fn sengoo_compiler_snapshot_test_handle_count() -> i64;
}

def sh_cssf_scope(path: &String, mode: i64, checking: bool) -> Result<i64, i64> {
    let mut arena = sh_compiler_snapshot_arena(2, 4096, 32768);
    sengoo_compiler_snapshot_test_fault(0);
    if checking { let id = sh_compiler_snapshot_open(&mut arena, path)?; sengoo_compiler_snapshot_test_fault(mode); let result = sh_compiler_snapshot_matches(&arena, id); sengoo_compiler_snapshot_test_fault(0); assert_true(result.is_ok() and result.value == (mode == 4), "snapshot-faults", 1); assert_eq_i64(arena.snapshots.len(), 1, "snapshot-faults", 2); assert_true(sh_compiler_snapshot_matches(&arena, id)?, "snapshot-faults", 3); } else { sengoo_compiler_snapshot_test_fault(mode); let result = sh_compiler_snapshot_open(&mut arena, path); sengoo_compiler_snapshot_test_fault(0); if mode == 4 { assert_true(result.is_ok(), "snapshot-faults", 4); assert_eq_i64(arena.snapshots.len(), 1, "snapshot-faults", 5); assert_true(sh_compiler_snapshot_matches(&arena, result.value)?, "snapshot-faults", 6); } else { assert_true(not result.is_ok() and result.error == 9, "snapshot-faults", 7); assert_eq_i64(arena.snapshots.len(), 0, "snapshot-faults", 8); assert_eq_i64(arena.bytes, 0, "snapshot-faults", 9); assert_eq_i64(arena.path_bytes, 0, "snapshot-faults", 10); let restored = sh_compiler_snapshot_open(&mut arena, path)?; assert_true(sh_compiler_snapshot_matches(&arena, restored)?, "snapshot-faults", 11); }; };
    sh_css_ok(42);
}

def main() -> i64 {
    let length = arg_len(0);
    if not length.is_ok() { return 64; };
    let bytes = ffi_buffer_new(length.value);
    if not bytes.is_ok() { return 64; };
    let copied = arg_copy(0, bytes.value);
    if not copied.is_ok() { return 64; };
    let path = string_from_utf8(bytes.value, copied.value);
    if not path.is_ok() { return 64; };
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let snapshots = sengoo_file_snapshot_live_handle_count();
    let snapshot_bytes = sengoo_file_snapshot_live_bytes();
    let handles = sengoo_compiler_snapshot_test_handle_count();
    let mut round = 0;
    while round < 3 { let mut index = 0; while index < 10 { { let result = sh_cssf_scope(&path.value, index / 2 + 1, index % 2 == 1); if not result.is_ok() { println(result.error); return 65; }; }; assert_eq_i64(sengoo_string_live_handle_count(), strings, "snapshot-fault-resources", 1); assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "snapshot-fault-resources", 2); assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "snapshot-fault-resources", 3); assert_eq_i64(sengoo_file_snapshot_live_handle_count(), snapshots, "snapshot-fault-resources", 4); assert_eq_i64(sengoo_file_snapshot_live_bytes(), snapshot_bytes, "snapshot-fault-resources", 5); assert_eq_i64(sengoo_compiler_snapshot_test_handle_count(), handles, "snapshot-fault-resources", 6); index = index + 1; }; round = round + 1; };
    42;
}
