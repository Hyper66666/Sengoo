requested, 0)); assert_eq_i64(sh_collection_effect_ownership_validate(&scope, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &requested, 1000, true), 6120, "collection_effects.sg", 34); requested.pop(); outer_poisons = outer_poisons + 1; assert_eq_i64(sh_collection_effect_ownership_validate(&scope, &provider, &mapping, provider_root.as_str(), "bad independent caller pin", artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &requested, 1000, true), 6120, "collection_effects.sg", 35); outer_poisons = outer_poisons + 1; assert_eq_i64(sh_collection_effect_ownership_validate(&scope, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &requested, 1000, false), 6120, "collection_effects.sg", 36); outer_poisons = outer_poisons + 1; };
    let denied_mutable = vec_new_i64();
    denied_mutable.push(sh_o_unique(&analyzed, graph.root, "mutated_option", 2));
    assert_true(sh_origin_at(&denied_mutable, 0) >= 0, "collection_effects.sg", 38);
    let denied_mutable_result = sh_check_ownership_collection_effect_functions(&provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &denied_mutable, 1000, true);
    assert_true(denied_mutable_result.error != 0, "collection_effects.sg", 39);
    let mut node = 0;
    let mut guarded_payloads = 0;
    while node < sh_ast_count(&analyzed.front.parsed.ast) { if sh_ch_owner(&analyzed.checked, node) == sh_origin_at(&denied_mutable, 0) and sh_ast_word(&analyzed.front.parsed.ast, node, 0) == 55 and sh_binding_word(&analyzed.checked, sh_node_binding(&analyzed.checked, node), 6) == loans.option_binding and sh_binding_word(&analyzed.checked, sh_node_binding(&analyzed.checked, node), 7) == 1 { assert_true(not sh_ce_payload_guard(&effects, &loans, &analyzed.checked, &analyzed.front.parsed.ast, node), "collection_effects.sg", 40); guarded_payloads = guarded_payloads + 1; }; node = node + 1; };
    assert_eq_i64(guarded_payloads, 1, "collection_effects.sg", 41);
    let unknown_drop = sh_o_unique(&analyzed, graph.root, "unknown_drop_effect", 2);
    assert_true(unknown_drop >= 0, "collection_effects.sg", 42);
    let push_call = sh_ht_call(&analyzed, "unknown_drop_effect", "push");
    assert_true(push_call >= 0, "collection_effects.sg", 43);
    let mut op = 0;
    while op < effects.operations.len() / 16 { assert_true(sh_ce_at(&effects, op, 0) != push_call, "collection_effects.sg", 44); op = op + 1; };
    assert_true(sh_collection_effect_function_error(&effects, &nll, &loans, unknown_drop) != 0, "collection_effects.sg", 45);
    let base_class = sh_o_unique(&analyzed, graph.root, "EffectBase", 3);
    let derived_class = sh_o_unique(&analyzed, graph.root, "EffectDerived", 3);
    let data_enum = sh_o_unique(&analyzed, graph.root, "EffectEnum", 4);
    assert_true(base_class >= 0 and derived_class >= 0 and data_enum >= 0, "collection_effects.sg", 46);
    assert_true(not sh_ce_owned_element(&analyzed, sh_binding_word(&analyzed.checked, base_class, 3), 0), "collection_effects.sg", 47);
    assert_true(not sh_ce_owned_element(&analyzed, sh_binding_word(&analyzed.checked, derived_class, 3), 0), "collection_effects.sg", 48);
    assert_true(not sh_ce_owned_element(&analyzed, sh_binding_word(&analyzed.checked, data_enum, 3), 0), "collection_effects.sg", 49);
    let inherited = sh_o_unique(&analyzed, graph.root, "inherited_drop_effect", 2);
    let inherited_push = sh_ht_call(&analyzed, "inherited_drop_effect", "push");
    assert_true(inherited >= 0 and inherited_push >= 0, "collection_effects.sg", 50);
    op = 0;
    while op < effects.operations.len() / 16 { assert_true(sh_ce_at(&effects, op, 0) != inherited_push, "collection_effects.sg", 51); op = op + 1; };
    assert_true(sh_collection_effect_function_error(&effects, &nll, &loans, inherited) != 0, "collection_effects.sg", 52);
    let sites = sh_collection_effect_sites(&effects, &nll, &loans, &requested);
    assert_true(sites.is_ok(), "collection_effects.sg", 4);
    if poison { println("collection_effect_counts"); println(effects.operations.len() / 16); println(effects.supersessions.len() / 8); println(effects.loan_supersessions.len() / 6); println(sites.value.len() / 7); println(effect_poisons); println(outer_poisons); println(requested.len()); println(scope.coverage.len() / 8); };
    let rejected = sh_o_unique(&analyzed, graph.root, "push_live", 2);
    assert_true(rejected >= 0, "collection_effects.sg", 9);
    assert_true(sh_collection_effect_function_error(&effects, &nll, &loans, rejected) != 0, "collection_effects.sg", 5);
    let rejected = sh_o_unique(&analyzed, graph.root, "fallback_dead", 2);
    assert_true(rejected >= 0, "collection_effects.sg", 9);
    assert_true(sh_collection_effect_function_error(&effects, &nll, &loans, rejected) != 0, "collection_effects.sg", 5);
    let rejected = sh_o_unique(&analyzed, graph.root, "owner_live", 2);
    assert_true(rejected >= 0, "collection_effects.sg", 9);
    assert_true(sh_collection_effect_function_error(&effects, &nll, &loans, rejected) != 0, "collection_effects.sg", 5);
    assert_true(sh_o_equal(&words, &analyzed.checked.types.words), "collection_effects.sg", 6);
    assert_true(sh_o_equal(&arguments, &analyzed.checked.types.arguments), "collection_effects.sg", 7);
    let after = sh_et_input(&graph, &analyzed);
    assert_true(sh_o_equal(&frozen, &after), "collection_effects.sg", 37);
    result_ok_bool(true);
}

def main() -> i64 {
    if args_len() == 1 { let flag = sh_ht_arg(0); if flag.is_ok() { if flag.value.as_str() == "--fail-equality" { assert_eq_i64(1, 2, "collection_effects.sg", 98); (); }; if flag.value.as_str() == "--fail-truth" { assert_true(false, "collection_effects.sg", 99); (); }; }; return 64; };
    if args_len() != 4 { return 64; };
    let root = sh_ht_arg(0);
    let manifest = sh_ht_arg(1);
    let object = sh_ht_arg(2);
    let source = sh_ht_arg(3);
    if not root.is_ok() or not manifest.is_ok() or not object.is_ok() or not source.is_ok() { return 65; };
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let files = sengoo_file_snapshot_live_handle_count();
    let bytes = sengoo_file_snapshot_live_bytes();
    let mut round = 0;
    while round < 3 { let result = sh_ht_scope(&root.value, &manifest.value, &object.value, &source.value, round == 0); if not result.is_ok() { println(result.error); return 65; }; assert_eq_i64(sengoo_string_live_handle_count(), strings, "collection_effects.sg", 10); assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "collection_effects.sg", 11); assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "collection_effects.sg", 12); assert_eq_i64(sengoo_file_snapshot_live_handle_count(), files, "collection_effects.sg", 13); assert_eq_i64(sengoo_file_snapshot_live_bytes(), bytes, "collection_effects.sg", 14); round = round + 1; };
    println("collection effects: three first-call resource scopes passed");
    42;
}
