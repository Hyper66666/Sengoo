import selfhost_semantic_collection_effect_ownership;

import std::args;

import std::assert;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_bytes() -> i64;
}

def sh_ht_arg(i: i64) -> Result<String, i64> {
    let b = ffi_buffer_new(arg_len(i)?)?;
    let n = arg_copy(i, b)?;
    string_from_utf8(b, n);
}

def sh_ht_call(analyzed: &ShModuleChecked, owner: &str, target: &str) -> i64 {
    let checked = &analyzed.checked;
    let function = sh_o_unique(analyzed, analyzed.front.source, owner, 2);
    let mut node = 0;
    let mut result = -1;
    while node < sh_ast_count(&analyzed.front.parsed.ast) { if sh_ast_word(&analyzed.front.parsed.ast, node, 0) == 53 and sh_ch_owner(checked, node) == function and sh_o_name(checked, sh_node_binding(checked, node), target) { if result >= 0 { return -1; }; result = node; }; node = node + 1; };
    result;
}

def sh_ht_case(facts: &ShCollectionHandles, analyzed: &ShModuleChecked, function: &str, target: &str, status: i64, code: i64) {
    let node = sh_ht_call(analyzed, function, target);
    assert_true(node >= 0, "collection_handles.sg", 1);
    let actual = sh_collection_handle_status(facts, node);
    let owner = sh_ch_owner(&analyzed.checked, node);
    let error = sh_collection_handle_function_error(facts, owner);
    if actual != status or error != code { println(function); println(actual); println(status); println(error); println(code); };
    assert_eq_i64(actual, status, "collection_handles.sg", 2);
    assert_eq_i64(error, code, "collection_handles.sg", 3);
    ();
}

def sh_ht_copy(values: &Vec<i64>) -> Vec<i64> {
    let copy = vec_new_i64();
    let mut i = 0;
    while i < values.len() { copy.push(sh_origin_at(values, i)); i = i + 1; };
    copy;
}

def sh_et_vec(out: &Vec<i64>, values: &Vec<i64>) {
    out.push(values.handle);
    out.push(values.marker);
    out.push(values.len());
    let mut at = 0;
    while at < values.len() { out.push(sh_origin_at(values, at)); at = at + 1; };
    ();
}

def sh_et_text(out: &Vec<i64>, text: &String) {
    out.push(text.handle);
    out.push(text.len());
    let bytes = sh_lex_bytes(text);
    assert_true(bytes.is_ok(), "collection_effects.sg", 90);
    let mut at = 0;
    while at < text.len() { out.push(sh_lex_byte(&bytes.value, at)); at = at + 1; };
    ();
}

def sh_et_input(graph: &ShModules, analyzed: &ShModuleChecked) -> Vec<i64> {
    let out = vec_new_i64();
    sh_et_vec(&out, &analyzed.checked.node_types);
    sh_et_vec(&out, &analyzed.checked.call_types);
    sh_et_vec(&out, &analyzed.checked.deferred_types);
    sh_et_vec(&out, &analyzed.checked.builtin_calls);
    sh_et_vec(&out, &analyzed.checked.resolution);
    sh_et_vec(&out, &analyzed.checked.node_scopes);
    sh_et_vec(&out, &analyzed.checked.bindings);
    sh_et_vec(&out, &analyzed.checked.scopes);
    sh_et_vec(&out, &analyzed.checked.substitutions);
    sh_et_vec(&out, &analyzed.checked.generic_parameters);
    sh_et_vec(&out, &analyzed.checked.constraints);
    sh_et_vec(&out, &analyzed.checked.trait_types);
    sh_et_vec(&out, &analyzed.checked.class_parents);
    sh_et_vec(&out, &analyzed.checked.propagation);
    sh_et_vec(&out, &analyzed.checked.loop_values);
    out.push(analyzed.checked.async_depth);
    out.push(analyzed.checked.unsafe_depth);
    out.push(analyzed.checked.error);
    out.push(analyzed.checked.start);
    out.push(analyzed.checked.end);
    out.push(analyzed.checked.diagnostic_limit);
    out.push(analyzed.checked.current_scope);
    out.push(analyzed.checked.current_owner);
    out.push(analyzed.checked.current_return);
    out.push(analyzed.checked.loop_depth);
    out.push(analyzed.checked.depth);
    out.push(analyzed.checked.unit_type);
    out.push(analyzed.checked.bool_type);
    out.push(analyzed.checked.integer_type);
    out.push(analyzed.checked.float_type);
    out.push(analyzed.checked.char_type);
    out.push(analyzed.checked.str_type);
    out.push(analyzed.checked.never_type);
    out.push(analyzed.checked.error_type);
    sh_et_vec(&out, &analyzed.checked.types.words);
    sh_et_vec(&out, &analyzed.checked.types.arguments);
    out.push(analyzed.checked.types.limit);
    out.push(analyzed.checked.symbols.limit);
    out.push(analyzed.checked.symbols.names.handle);
    out.push(analyzed.checked.symbols.names.marker);
    let mut at = 0;
    while at < analyzed.checked.symbols.names.len() { sh_et_text(&out, &analyzed.checked.symbols.names.get(at).text); at = at + 1; };
    out.push(analyzed.checked.diagnostics.handle);
    out.push(analyzed.checked.diagnostics.marker);
    out.push(analyzed.checked.diagnostics.len());
    at = 0;
    while at < analyzed.checked.diagnostics.len() { let d = analyzed.checked.diagnostics.get(at); out.push(d.code); out.push(d.severity); out.push(d.node); out.push(d.start); out.push(d.end); out.push(d.expected); out.push(d.actual); at = at + 1; };
    sh_et_vec(&out, &analyzed.node_modules);
    sh_et_vec(&out, &analyzed.binding_modules);
    sh_et_vec(&out, &analyzed.scope_modules);
    sh_et_vec(&out, &analyzed.module_scopes);
    sh_et_vec(&out, &analyzed.module_bindings);
    sh_et_vec(&out, &analyzed.exports);
    sh_et_vec(&out, &analyzed.front.parsed.ast.words);
    sh_et_vec(&out, &analyzed.front.parsed.ast.edges);
    sh_et_vec(&out, &analyzed.front.expanded.mapping.words);
    out.push(analyzed.error);
    out.push(analyzed.source);
    out.push(analyzed.start);
    out.push(analyzed.end);
    out.push(analyzed.front.error);
    out.push(analyzed.front.source);
    out.push(analyzed.front.start);
    out.push(analyzed.front.end);
    out.push(analyzed.front.parsed.error);
    out.push(analyzed.front.parsed.start);
    out.push(analyzed.front.parsed.end);
    out.push(analyzed.front.parsed.ast.root);
    out.push(analyzed.front.expanded.error);
    out.push(analyzed.front.expanded.start);
    out.push(analyzed.front.expanded.end);
    sh_et_text(&out, &analyzed.front.expanded.text);
    sh_et_text(&out, &graph.text);
    sh_et_vec(&out, &graph.mapping);
    out.push(graph.sources.texts.handle);
    out.push(graph.sources.texts.marker);
    out.push(graph.sources.limit);
    out.push(graph.sources.max_bytes);
    at = 0;
    while at < graph.sources.texts.len() { sh_et_text(&out, &graph.sources.texts.get(at).text); at = at + 1; };
    out;
}

def sh_ht_scope(provider_root: &String, manifest_sha: &String, artifact_sha: &String, program: &String, poison: bool) -> Result<bool, i64> {
    let manifest = path_join_string(provider_root.as_str(), "selfhost/sdk/collections_x64_abi1/manifest.json")?;
    let stdlib = path_join_string(provider_root.as_str(), "tools/stdlib")?;
    let prelude = path_join_string(provider_root.as_str(), "selfhost/sdk/collections_x64_abi1/prelude.sg")?;
    let collection = path_join_string(provider_root.as_str(), "tools/stdlib/collections.sg")?;
    let option = path_join_string(provider_root.as_str(), "tools/stdlib/option.sg")?;
    let cs = file_snapshot_open(collection.as_str(), 1048576)?;
    let identity = cs.identity()?;
    let digest = cs.sha256()?;
    let os = file_snapshot_open(option.as_str(), 1048576)?;
    let option_identity = os.identity()?;
    let option_digest = os.sha256()?;
    let provider = sh_collection_provider_load(provider_root.as_str(), manifest.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), "x86_64-pc-windows-msvc", 1, true);
    assert_eq_i64(provider.error, 0, "collection_handles.sg", 4);
    let config = string_from_str("collection_runtime=")?;
    config.push_str(prelude.as_str())?;
    let graph = sh_modules_load(program.as_str(), stdlib.as_str(), &config, 64, 1048576);
    assert_eq_i64(graph.error, 0, "collection_handles.sg", 5);
    let analyzed = sh_modules_check(&graph, 100000, 1000);
    if analyzed.error != 0 { println(analyzed.error); println(analyzed.start); };
    assert_eq_i64(analyzed.error, 0, "collection_handles.sg", 6);
    let prepared = sh_collection_ownership_finalize(&analyzed.checked, &analyzed.front.parsed.ast, 100000, 1000000);
    assert_eq_i64(prepared.error, 0, "collection_effects.sg", 19);
    let idempotent = sh_collection_ownership_finalize(&analyzed.checked, &analyzed.front.parsed.ast, 100000, 1000000);
    assert_eq_i64(idempotent.error, 0, "collection_effects.sg", 20);
    assert_eq_i64(idempotent.before_types, idempotent.after_types, "collection_effects.sg", 21);
    let frozen = sh_et_input(&graph, &analyzed);
    let words = sh_ht_copy(&analyzed.checked.types.words);
    let arguments = sh_ht_copy(&analyzed.checked.types.arguments);
    let mapping = sh_collection_provider_map(&provider, provider_root.as_str(), &graph, &analyzed, manifest_sha.as_str(), artifact_sha.as_str(), identity.as_str(), digest.as_str(), "x86_64-pc-windows-msvc", 1, true);
    assert_eq_i64(mapping.error, 0, "collection_handles.sg", 7);
    let proto = "fn sengoo_raw_vec_iter_new(handle: i64) -> i64;";
    let origins = sh_origins_analyze(&graph, &analyzed, identity.as_str(), digest.as_str(), proto, 100000);
    assert_eq_i64(origins.error, 0, "collection_handles.sg", 8);
    let loans = sh_loans_analyze(&origins, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), 100000, 1);
    assert_eq_i64(loans.error, 0, "collection_handles.sg", 9);
    let nll = sh_loan_liveness(&origins, &loans, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), 20000);
    if nll.error != 0 { println(nll.error); };
    assert_eq_i64(nll.error, 0, "collection_handles.sg", 10);
    let mut facts = sh_collection_handles(&provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), 100000, true);
    if facts.error != 0 { println("handles fatal"); println(facts.error); };
    assert_eq_i64(facts.error, 0, "collection_handles.sg", 11);
    assert_eq_i64(sh_collection_handles_validate(&facts, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 0, "collection_handles.sg", 12);
    let mut effects = sh_collection_effects(&provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), 20000, true);
    assert_eq_i64(effects.error, 0, "collection_effects.sg", 1);
    assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 0, "collection_effects.sg", 2);
    let requested = vec_new_i64();
    requested.push(sh_o_unique(&analyzed, graph.root, "good_i64", 2));
    requested.push(sh_o_unique(&analyzed, graph.root, "good_bool", 2));
    requested.push(sh_o_unique(&analyzed, graph.root, "pushed", 2));
    requested.push(sh_o_unique(&analyzed, graph.root, "owner_next", 2));
    requested.push(sh_o_unique(&analyzed, graph.root, "pushed_bool", 2));
    requested.push(sh_o_unique(&analyzed, graph.root, "named_before_push", 2));
    let mut i = 0;
    while i < requested.len() { let f = sh_origin_at(&requested, i); assert_true(f >= 0, "collection_effects.sg", 3); assert_eq_i64(sh_collection_effect_function_error(&effects, &nll, &loans, f), 0, "collection_effects.sg", 3); i = i + 1; };
    let mut scope = sh_check_ownership_collection_effect_functions(&provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &requested, 1000, true);
    assert_eq_i64(scope.error, 0, "collection_effects.sg", 15);
    let denied_roots = vec_new_i64();
    denied_roots.push(sh_o_unique(&analyzed, graph.root, "named_after_push", 2));
    let denied = sh_check_ownership_collection_effect_functions(&provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &denied_roots, 1000, true);
    assert_eq_i64(denied.error, 6101, "collection_effects.sg", 17);
    let denied_roots = vec_new_i64();
    denied_roots.push(sh_o_unique(&analyzed, graph.root, "unguarded_owner", 2));
    let denied = sh_check_ownership_collection_effect_functions(&provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &denied_roots, 1000, true);
    assert_eq_i64(denied.error, 6124, "collection_effects.sg", 17);
    let denied_roots = vec_new_i64();
    denied_roots.push(sh_o_unique(&analyzed, graph.root, "false_owner", 2));
    let denied = sh_check_ownership_collection_effect_functions(&provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &denied_roots, 1000, true);
    assert_eq_i64(denied.error, 6124, "collection_effects.sg", 17);
    let denied_roots = vec_new_i64();
    denied_roots.push(sh_o_unique(&analyzed, graph.root, "unguarded_store", 2));
    let denied = sh_check_ownership_collection_effect_functions(&provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &effects, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), &denied_roots, 1000, true);
    assert_eq_i64(denied.error, 6124, "collection_effects.sg", 17);
    let mut effect_poisons = 0;
    let mut outer_poisons = 0;
    if poison { assert_true(effects.operations.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 5008, "collection_effects.sg", 23); effects.operations.pop(); effect_poisons = effect_poisons + 1; assert_true(effects.leases.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 5008, "collection_effects.sg", 23); effects.leases.pop(); effect_poisons = effect_poisons + 1; assert_true(effects.call_events.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 5008, "collection_effects.sg", 23); effects.call_events.pop(); effect_poisons = effect_poisons + 1; assert_true(effects.supersessions.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 5008, "collection_effects.sg", 23); effects.supersessions.pop(); effect_poisons = effect_poisons + 1; assert_true(effects.loan_supersessions.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 5008, "collection_effects.sg", 23); effects.loan_supersessions.pop(); effect_poisons = effect_poisons + 1; assert_true(effects.old_diagnostics.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 5008, "collection_effects.sg", 23); effects.old_diagnostics.pop(); effect_poisons = effect_poisons + 1; assert_true(effects.adjusted.nodes.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 5008, "collection_effects.sg", 23); effects.adjusted.nodes.pop(); effect_poisons = effect_poisons + 1; assert_true(effects.adjusted.tokens.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provider_root.as_str(), manifest_sha.as_str(), artifact_sha.as_str(), &origins, &loans, &nll, &facts, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, option_identity.as_str(), option_digest.as_str(), true), 5008, "collection_effects.sg", 23); effects.adjusted.tokens.pop(); effect_poisons = effect_poisons + 1; assert_true(effects.adjusted.effects.push(1234567), "collection_effects.sg", 22); assert_eq_i64(sh_collection_effects_validate(&effects, &provider, &mapping, provid