def h6_validate(hir: &ShHir, graph: &ShModules, analyzed: &ShModuleChecked, ownership: &ShOwnership, col: &String, digest: &String, opt: &String, optsha: &String) -> i64 {
    sh_hir_validate_modules(hir, graph, analyzed, ownership, col.as_str(), digest.as_str(), "fn sengoo_raw_vec_iter_new(handle: i64) -> i64;", opt.as_str(), optsha.as_str());
}

def h6_real() -> Result<bool, i64> {
    let source = h6_arg(0)?;
    let library = h6_arg(1)?;
    let colpath = h6_arg(2)?;
    let digest = h6_arg(3)?;
    let optpath = h6_arg(4)?;
    let optsha = h6_arg(5)?;
    let mode = h6_arg(6)?;
    let col = file_snapshot_open(colpath.as_str(), 1048576)?;
    let opt = file_snapshot_open(optpath.as_str(), 1048576)?;
    let identity = col.identity()?;
    let optid = opt.identity()?;
    let config = string_new();
    let graph = sh_modules_load(source.as_str(), library.as_str(), &config, 64, 1048576);
    assert_eq_i64(graph.error, 0, "hir_origins.sg", 36);
    let analyzed = sh_modules_check(&graph, 100000, 1000);
    assert_eq_i64(analyzed.error, 0, "hir_origins.sg", 37);
    let ownership = sh_check_ownership(&analyzed.front.expanded.text, &analyzed.front.parsed.ast, &analyzed.checked, 1000);
    let saved_source = graph.sources.texts.get(graph.root).text.clone()?;
    graph.sources.texts.get(graph.root).text.push_str("// forged nonphysical text")?;
    let forged = sh_hir_origins_capture_absent(&graph, &analyzed, 100000);
    assert_eq_i64(forged.error, 5509, "hir_origins.sg", 95);
    let invalid_source = sh_hir_origins_module_input(&graph, &analyzed, 4000000);
    assert_eq_i64(invalid_source.error, 5509, "hir_origins.sg", 96);
    assert_eq_i64(sengoo_string_clear_status(graph.sources.texts.get(graph.root).text.handle), 0, "hir_origins.sg", 97);
    assert_eq_i64(sengoo_string_push_padded_string_status(graph.sources.texts.get(graph.root).text.handle, saved_source.handle, 1, 0), 0, "hir_origins.sg", 98);
    let before = h6_actual_state(&graph, &analyzed, &ownership);
    assert_eq_i64(before.error, 0, "hir_origins.sg", 86);
    let proto = "fn sengoo_raw_vec_iter_new(handle: i64) -> i64;";
    let facts = if mode.as_str() == "absent" { sh_hir_origins_capture_absent(&graph, &analyzed, 100000); } else { sh_hir_origins_capture(&graph, &analyzed, identity.as_str(), digest.as_str(), proto, optid.as_str(), optsha.as_str(), 100000); };
    assert_eq_i64(facts.error, 0, "hir_origins.sg", 38);
    let preclone_budget = sh_hir_input_budget(&analyzed.front.expanded.text, &analyzed.front.parsed.ast, &analyzed.checked, &ownership, &facts, 100000, 4000000, 4000000);
    assert_eq_i64(preclone_budget, 5501, "hir_origins.sg", 99);
    let after_budget = h6_actual_state(&graph, &analyzed, &ownership);
    assert_eq_i64(after_budget.error, 0, "hir_origins.sg", 100);
    assert_true(sh_o_equal(&before.words, &after_budget.words), "hir_origins.sg", 101);
    if mode.as_str() == "stdlib" { assert_eq_i64(ownership.error, 6101, "hir_origins.sg", 39); assert_eq_i64(ownership.diagnostics.len(), 112, "hir_origins.sg", 40); let raw = sh_hir_origins_encode(&facts, 4000000); assert_eq_i64(raw.error, 0, "hir_origins.sg", 41); let decoded = sh_hir_origins_decode(&raw.words, 4000000); assert_eq_i64(decoded.error, 0, "hir_origins.sg", 42); assert_eq_i64(sh_hir_origins_validate(&decoded, &graph, &analyzed, identity.as_str(), digest.as_str(), proto, optid.as_str(), optsha.as_str()), 0, "hir_origins.sg", 43); assert_true(sh_o_equal(&facts.loans.diagnostics, &decoded.loans.diagnostics), "hir_origins.sg", 44); assert_true(decoded.loans.diagnostics.len() > 0, "hir_origins.sg", 45); let failed = sh_hir_lift_modules(&graph, &analyzed, &ownership, &facts, identity.as_str(), digest.as_str(), proto, optid.as_str(), optsha.as_str(), 100000); assert_eq_i64(failed.error, 5502, "hir_origins.sg", 46); assert_true(sh_hir_ownership_equal(&failed.ownership, &ownership), "hir_origins.sg", 47); let after = h6_actual_state(&graph, &analyzed, &ownership); assert_eq_i64(after.error, 0, "hir_origins.sg", 89); assert_true(sh_o_equal(&before.words, &after.words), "hir_origins.sg", 90); println("stdlib|ownership=6101|diagnostics=112"); println(sh_ast_count(&analyzed.front.parsed.ast)); println(facts.origins.input.len()); println(facts.loans.origin_input.len()); println(facts.module_input.len()); println(raw.words.len()); return result_ok_bool(true); };
    assert_eq_i64(ownership.error, 0, "hir_origins.sg", 48);
    let hir = sh_hir_lift_modules(&graph, &analyzed, &ownership, &facts, identity.as_str(), digest.as_str(), proto, optid.as_str(), optsha.as_str(), 100000);
    assert_eq_i64(hir.error, 0, "hir_origins.sg", 49);
    assert_eq_i64(h6_validate(&hir, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha), 0, "hir_origins.sg", 50);
    h6_exact(&hir);
    let wire = sh_hir_encode(&hir, 4000000);
    assert_eq_i64(wire.error, 0, "hir_origins.sg", 51);
    let decoded = sh_hir_decode(&wire.words, 4000000);
    assert_eq_i64(decoded.error, 0, "hir_origins.sg", 52);
    h6_deep(&hir, &decoded);
    assert_true(sh_hir_checked_equal(&hir.checked, &decoded.checked), "hir_origins.sg", 53);
    assert_true(sh_hir_ownership_equal(&hir.ownership, &decoded.ownership), "hir_origins.sg", 54);
    assert_eq_i64(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha), 0, "hir_origins.sg", 55);
    let clone = sh_hir_clone(&hir, 4000000);
    assert_eq_i64(clone.error, 0, "hir_origins.sg", 56);
    h6_deep(&hir, &clone);
    let clonewire = sh_hir_encode(&clone, 4000000);
    assert_true(sh_o_equal(&wire.words, &clonewire.words), "hir_origins.sg", 57);
    let clean_again = sh_hir_encode(&hir, 4000000);
    assert_true(sh_o_equal(&wire.words, &clean_again.words), "hir_origins.sg", 84);
    let denied = sh_lower_hir(&decoded, 100000);
    assert_eq_i64(denied.error, 5008, "hir_origins.sg", 58);
    let legacy = sh_hir_lift(&analyzed.front.expanded.text, &analyzed.front.parsed.ast, &analyzed.checked, 100000);
    assert_eq_i64(legacy.error, 5008, "hir_origins.sg", 59);
    if mode.as_str() == "absent" { assert_eq_i64(hir.origins.present, 0, "hir_origins.sg", 60); let after = h6_actual_state(&graph, &analyzed, &ownership); assert_eq_i64(after.error, 0, "hir_origins.sg", 91); assert_true(sh_o_equal(&before.words, &after.words), "hir_origins.sg", 92); println("module absent: actual unused standard declarations preserved, no lower authority"); return result_ok_bool(true); };
    assert_true(hir.origins.loans.diagnostics.len() > 0, "hir_origins.sg", 61);
    assert_true(sh_o_equal(&hir.origins.loans.diagnostics, &decoded.origins.loans.diagnostics), "hir_origins.sg", 62);
    let mut missing = sh_hir_origins_absent(100000);
    let witness = sh_hir_origins_module_input(&graph, &analyzed, 4000000);
    missing.module_input = witness.words;
    let nofacts = sh_hir_lift_modules(&graph, &analyzed, &ownership, &missing, "", "", proto, "", "", 100000);
    assert_eq_i64(nofacts.error, 5008, "hir_origins.sg", 63);
    if graph.mapping.len() > 0 { let saved = sh_origin_at(&graph.mapping, 0); graph.mapping.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 93); graph.mapping.set(0, saved); (); };
    if graph.edges.len() > 0 { let saved = sh_origin_at(&graph.edges, 0); graph.edges.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 93); graph.edges.set(0, saved); (); };
    if graph.states.len() > 0 { let saved = sh_origin_at(&graph.states, 0); graph.states.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 93); graph.states.set(0, saved); (); };
    if graph.order.len() > 0 { let saved = sh_origin_at(&graph.order, 0); graph.order.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 93); graph.order.set(0, saved); (); };
    if graph.local_order.len() > 0 { let saved = sh_origin_at(&graph.local_order, 0); graph.local_order.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 93); graph.local_order.set(0, saved); (); };
    if graph.requests.len() > 0 { let saved = sh_origin_at(&graph.requests, 0); graph.requests.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 93); graph.requests.set(0, saved); (); };
    if graph.standard_ids.len() > 0 { let saved = sh_origin_at(&graph.standard_ids, 0); graph.standard_ids.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 93); graph.standard_ids.set(0, saved); (); };
    if analyzed.node_modules.len() > 0 { let saved = sh_origin_at(&analyzed.node_modules, 0); analyzed.node_modules.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 94); analyzed.node_modules.set(0, saved); (); };
    if analyzed.binding_modules.len() > 0 { let saved = sh_origin_at(&analyzed.binding_modules, 0); analyzed.binding_modules.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 94); analyzed.binding_modules.set(0, saved); (); };
    if analyzed.scope_modules.len() > 0 { let saved = sh_origin_at(&analyzed.scope_modules, 0); analyzed.scope_modules.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 94); analyzed.scope_modules.set(0, saved); (); };
    if analyzed.module_scopes.len() > 0 { let saved = sh_origin_at(&analyzed.module_scopes, 0); analyzed.module_scopes.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 94); analyzed.module_scopes.set(0, saved); (); };
    if analyzed.module_bindings.len() > 0 { let saved = sh_origin_at(&analyzed.module_bindings, 0); analyzed.module_bindings.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 94); analyzed.module_bindings.set(0, saved); (); };
    if analyzed.exports.len() > 0 { let saved = sh_origin_at(&analyzed.exports, 0); analyzed.exports.set(0, saved + 1); assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha) != 0, "hir_origins.sg", 94); analyzed.exports.set(0, saved); (); };
    let wrong = string_from_str("wrong-independent-pin")?;
    assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &wrong, &optid, &optsha) != 0, "hir_origins.sg", 64);
    assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &wrong, &digest, &optid, &optsha) != 0, "hir_origins.sg", 65);
    assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &wrong, &optsha) != 0, "hir_origins.sg", 66);
    assert_true(h6_validate(&decoded, &graph, &analyzed, &ownership, &identity, &digest, &optid, &wrong) != 0, "hir_origins.sg", 67);
    let mut index = 1;
    while index <= 120 { let mut copy = sh_hir_clone(&hir, 4000000); h6_poison(&mut copy, index); let result = h6_validate(&copy, &graph, &analyzed, &ownership, &identity, &digest, &optid, &optsha); if result == 0 { println("unrejected-field"); println(index); }; assert_true(result != 0, "hir_origins.sg", 68); index = index + 1; };
    let trailing = sh_ho_words(&wire.words, 4000000, &mut missing.error);
    trailing.push(0);
    let bad = sh_hir_decode(&trailing, 4000000);
    assert_true(bad.error != 0, "hir_origins.sg", 69);
    wire.words.set(1, 5);
    let old = sh_hir_decode(&wire.words, 4000000);
    assert_eq_i64(old.error, 5502, "hir_origins.sg", 70);
    wire.words.set(1, 6);
    let short = sh_hir_encode(&hir, 10);
    assert_eq_i64(short.error, 5501, "hir_origins.sg", 71);
    let raw = sh_hir_origins_encode(&facts, 4000000);
    let mut poison = 0;
    while poison < 8 { let mut error = 0; let changed = sh_ho_words(&raw.words, 4000000, &mut error); let at = if poison < 6 { poison; } else if poison == 6 { 13; } else { 12; }; let replacement = if poison == 0 { 0; } else if poison == 1 { 2; } else if poison == 2 { 2; } else if poison == 3 { 0; } else if poison == 4 { 100001; } else if poison == 5 { 999; } else if poison == 6 { 1114112; } else { 0; }; changed.set(at, replacement); let invalid = sh_hir_origins_decode(&changed, 4000000); assert_true(invalid.error != 0, "hir_origins.sg", 80); poison = poison + 1; };
    let mut cut = 0;
    while cut < raw.words.len() { if cut < 70 or cut % 997 == 0 or cut == raw.words.len() - 1 { let words = vec_new_i64(); let mut i = 0; while i < cut { words.push(sh_origin_at(&raw.words, i)); i = i + 1; }; let bad = sh_hir_origins_decode(&words, 4000000); assert_true(bad.error != 0, "hir_origins.sg", 72); (); }; cut = cut + 1; };
    let still_clean = sh_hir_encode(&hir, 4000000);
    assert_true(sh_o_equal(&wire.words, &still_clean.words), "hir_origins.sg", 85);
    let after = h6_actual_state(&graph, &analyzed, &ownership);
    assert_eq_i64(after.error, 0, "hir_origins.sg", 87);
    assert_true(sh_o_equal(&before.words, &after.words), "hir_origins.sg", 88);
    println("module candidates: complete owning codec, actual source pins, all field poisons, no lower authority");
    println(wire.words.len());
    result_ok_bool(true);
}

def main() -> i64 {
    if args_len() > 0 { let first = h6_arg(0); if first.is_ok() and first.value.as_str() == "--fail-equality" { assert_eq_i64(1, 0, "hir_origins.sg", 73); (); }; if first.is_ok() and first.value.as_str() == "--fail-truth" { assert_true(false, "hir_origins.sg", 74); (); }; };
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let files = sengoo_file_snapshot_live_handle_count();
    let bytes = sengoo_file_snapshot_live_bytes();
    let mut i = 0;
    let scopes = if args_len() > 0 { let mode = h6_arg(6); if mode.is_ok() and mode.value.as_str() == "stdlib" { 1; } else { 3; }; } else { 10; };
    while i < scopes { { let result = if args_len() > 0 { h6_real(); } else { h6_ordinary(); }; if args_len() == 0 { let shadow = h6_shadow(); if not shadow.is_ok() { println(shadow.error); return 65; }; }; if not result.is_ok() { println(result.error); return 65; }; }; assert_eq_i64(sengoo_string_live_handle_count(), strings, "hir_origins.sg", 75); assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "hir_origins.sg", 76); assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "hir_origins.sg", 77); assert_eq_i64(sengoo_file_snapshot_live_handle_count(), files, "hir_origins.sg", 78); assert_eq_i64(sengoo_file_snapshot_live_bytes(), bytes, "hir_origins.sg", 79); i = i + 1; };
    println("HIR6 exact first-call resources passed");
    0;
}
