import selfhost_mir_lower;

import std::assert;

import std::args;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_bytes() -> i64;
}

def h6_arg(index: i64) -> Result<String, i64> {
    let storage = ffi_buffer_new(arg_len(index)?)?;
    let copied = arg_copy(index, storage)?;
    string_from_utf8(storage, copied);
}

def h6_words(a: &Vec<i64>, b: &Vec<i64>) {
    assert_true(a.handle != b.handle, "hir_origins.sg", 1);
    assert_true(sh_o_equal(a, b), "hir_origins.sg", 2);
    ();
}

def h6_ordinary() -> Result<bool, i64> {
    let text = string_from_str("// 世界 &\ndef main()->i64{let a=40; a+2}")?;
    let parsed = sh_parse(&text, 0, 1000);
    let checked = sh_check(&text, &parsed.ast, 100);
    let ownership = sh_check_ownership(&text, &parsed.ast, &checked, 100);
    let hir = sh_hir_lift(&text, &parsed.ast, &checked, 1000);
    assert_eq_i64(hir.error, 0, "hir_origins.sg", 3);
    assert_eq_i64(hir.schema, 6, "hir_origins.sg", 4);
    assert_eq_i64(hir.checked.types.limit, checked.types.limit, "hir_origins.sg", 5);
    assert_eq_i64(hir.checked.symbols.limit, checked.symbols.limit, "hir_origins.sg", 6);
    assert_true(sh_hir_ownership_equal(&hir.ownership, &ownership), "hir_origins.sg", 7);
    let image = sh_hir_encode(&hir, 1000000);
    assert_eq_i64(image.error, 0, "hir_origins.sg", 8);
    let restored = sh_hir_decode(&image.words, 1000000);
    assert_eq_i64(restored.error, 0, "hir_origins.sg", 9);
    assert_true(sh_hir_checked_equal(&hir.checked, &restored.checked), "hir_origins.sg", 10);
    assert_true(sh_hir_ownership_equal(&hir.ownership, &restored.ownership), "hir_origins.sg", 11);
    h6_words(&hir.ownership.last_uses, &restored.ownership.last_uses);
    h6_words(&hir.ownership.contracts, &restored.ownership.contracts);
    let again = sh_hir_encode(&restored, 1000000);
    assert_true(sh_o_equal(&image.words, &again.words), "hir_origins.sg", 12);
    image.words.set(1, 5);
    let old = sh_hir_decode(&image.words, 1000000);
    assert_eq_i64(old.error, 5502, "hir_origins.sg", 13);
    image.words.set(1, 6);
    let lowered = sh_lower_hir(&restored, 1000);
    assert_eq_i64(lowered.error, 0, "hir_origins.sg", 14);
    h6_exact(&hir);
    let mut header = sh_hir_clone(&hir, 4000000);
    header.start = 2;
    header.end = 7;
    let headerwire = sh_hir_encode(&header, 4000000);
    assert_eq_i64(headerwire.error, 0, "hir_origins.sg", 125);
    let headercopy = sh_hir_decode(&headerwire.words, 4000000);
    assert_eq_i64(headercopy.start, 2, "hir_origins.sg", 126);
    assert_eq_i64(headercopy.end, 7, "hir_origins.sg", 127);
    let headerclone = sh_hir_clone(&header, headerwire.words.len());
    assert_eq_i64(headerclone.start, 2, "hir_origins.sg", 128);
    assert_eq_i64(headerclone.end, 7, "hir_origins.sg", 129);
    let vectors = vec_new_i64();
    vectors.push(hir.ast.words.len());
    vectors.push(hir.ast.edges.len());
    vectors.push(hir.checked.types.words.len());
    vectors.push(hir.checked.types.arguments.len());
    vectors.push(hir.origins.module_input.len());
    vectors.push(hir.checked.node_types.len());
    vectors.push(hir.checked.call_types.len());
    vectors.push(hir.checked.deferred_types.len());
    vectors.push(hir.checked.builtin_calls.len());
    vectors.push(hir.checked.resolution.len());
    vectors.push(hir.checked.node_scopes.len());
    vectors.push(hir.checked.bindings.len());
    vectors.push(hir.checked.scopes.len());
    vectors.push(hir.checked.diagnostics.len());
    vectors.push(hir.checked.substitutions.len());
    vectors.push(hir.checked.generic_parameters.len());
    vectors.push(hir.checked.constraints.len());
    vectors.push(hir.checked.trait_types.len());
    vectors.push(hir.checked.class_parents.len());
    vectors.push(hir.checked.propagation.len());
    vectors.push(hir.checked.loop_values.len());
    vectors.push(hir.ownership.diagnostics.len());
    vectors.push(hir.ownership.actions.len());
    vectors.push(hir.ownership.action_paths.len());
    vectors.push(hir.ownership.paths.len());
    vectors.push(hir.ownership.state.len());
    vectors.push(hir.ownership.loans.len());
    vectors.push(hir.ownership.loan_parents.len());
    vectors.push(hir.ownership.last_uses.len());
    vectors.push(hir.ownership.loops.len());
    vectors.push(hir.ownership.definitions.len());
    vectors.push(hir.ownership.contracts.len());
    vectors.push(hir.ownership.try_scopes.len());
    vectors.push(hir.origins.origins.canonical.len());
    vectors.push(hir.origins.origins.factories.len());
    vectors.push(hir.origins.origins.nodes.len());
    vectors.push(hir.origins.origins.bindings.len());
    vectors.push(hir.origins.origins.returns.len());
    vectors.push(hir.origins.origins.obligations.len());
    vectors.push(hir.origins.origins.calls.len());
    vectors.push(hir.origins.origins.diagnostics.len());
    vectors.push(hir.origins.origins.input.len());
    vectors.push(hir.origins.loans.nodes.len());
    vectors.push(hir.origins.loans.leases.len());
    vectors.push(hir.origins.loans.effects.len());
    vectors.push(hir.origins.loans.summaries.len());
    vectors.push(hir.origins.loans.returns.len());
    vectors.push(hir.origins.loans.calls.len());
    vectors.push(hir.origins.loans.diagnostics.len());
    vectors.push(hir.origins.loans.admissions.len());
    vectors.push(hir.origins.loans.origin_input.len());
    vectors.push(hir.origins.loans.bindings.len());
    vectors.push(hir.origins.loans.active.len());
    let mut greatest = hir.source.len();
    let mut i = 0;
    while i < vectors.len() { let n = sh_origin_at(&vectors, i); if n > greatest { greatest = n; }; i = i + 1; };
    let cap = greatest + 100;
    assert_true(cap < image.words.len(), "hir_origins.sg", 130);
    let limited = sh_hir_clone(&hir, cap);
    assert_eq_i64(limited.error, 5501, "hir_origins.sg", 102);
    assert_eq_i64(limited.ast.words.len(), 0, "hir_origins.sg", 103);
    assert_eq_i64(sh_symbol_count(&limited.checked.symbols), 0, "hir_origins.sg", 104);
    let budget = sh_hir_input_budget(&hir.source, &hir.ast, &hir.checked, &hir.ownership, &hir.origins, hir.limit, 0, cap);
    assert_eq_i64(budget, 5501, "hir_origins.sg", 105);
    let original = sh_hir_encode(&hir, 1000000);
    assert_true(sh_o_equal(&image.words, &original.words), "hir_origins.sg", 106);
    result_ok_bool(true);
}

def h6_exact(hir: &ShHir) {
    let wire = sh_hir_encode(hir, 4000000);
    assert_eq_i64(wire.error, 0, "hir_origins.sg", 107);
    let total = wire.words.len();
    assert_eq_i64(sh_hir_input_budget(&hir.source, &hir.ast, &hir.checked, &hir.ownership, &hir.origins, hir.limit, 0, total), 0, "hir_origins.sg", 108);
    assert_eq_i64(sh_hir_input_budget(&hir.source, &hir.ast, &hir.checked, &hir.ownership, &hir.origins, hir.limit, 0, total - 1), 5501, "hir_origins.sg", 109);
    let exact = sh_hir_encode(hir, total);
    assert_eq_i64(exact.error, 0, "hir_origins.sg", 110);
    assert_true(sh_o_equal(&wire.words, &exact.words), "hir_origins.sg", 111);
    let insufficient = sh_hir_encode(hir, total - 1);
    assert_eq_i64(insufficient.error, 5501, "hir_origins.sg", 112);
    assert_eq_i64(insufficient.words.len(), 0, "hir_origins.sg", 113);
    let copied = sh_hir_clone(hir, total);
    assert_eq_i64(copied.error, 0, "hir_origins.sg", 114);
    let copiedwire = sh_hir_encode(&copied, total);
    assert_true(sh_o_equal(&wire.words, &copiedwire.words), "hir_origins.sg", 115);
    let failed = sh_hir_clone(hir, total - 1);
    assert_eq_i64(failed.error, 5501, "hir_origins.sg", 116);
    assert_eq_i64(failed.ast.words.len(), 0, "hir_origins.sg", 117);
    let decoded = sh_hir_decode(&wire.words, total);
    assert_eq_i64(decoded.error, 0, "hir_origins.sg", 118);
    let decodedwire = sh_hir_encode(&decoded, total);
    assert_true(sh_o_equal(&wire.words, &decodedwire.words), "hir_origins.sg", 119);
    let raw = sh_hir_origins_encode(&hir.origins, 4000000);
    let count = sh_hir_origins_word_count(&hir.origins);
    assert_true(count.is_ok(), "hir_origins.sg", 120);
    assert_eq_i64(count.value, raw.words.len(), "hir_origins.sg", 121);
    let rawexact = sh_hir_origins_encode(&hir.origins, count.value);
    assert_eq_i64(rawexact.error, 0, "hir_origins.sg", 122);
    let rawshort = sh_hir_origins_encode(&hir.origins, count.value - 1);
    assert_eq_i64(rawshort.error, 5501, "hir_origins.sg", 123);
    let mut field = 7;
    while field < 10 { let mut error = 0; let changed = sh_hir_words(&wire.words, 4000000, &mut error); changed.set(field, if field == 7 { 1; } else if field == 8 { -1; } else { hir.source.len() + 1; }); let invalid = sh_hir_decode(&changed, 4000000); assert_eq_i64(invalid.error, 5502, "hir_origins.sg", 124); field = field + 1; };
    ();
}

def h6_shadow() -> Result<bool, i64> {
    let text = string_from_str("struct Vec<T>{handle:i64,marker:i64} def vec_new()->Vec<i64>{Vec{handle:42,marker:0}} def main()->i64{let values=vec_new();values.handle}")?;
    let parsed = sh_parse(&text, 0, 1000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "hir_origins.sg", 81);
    let hir = sh_hir_lift(&text, &parsed.ast, &checked, 1000);
    assert_eq_i64(hir.error, 0, "hir_origins.sg", 82);
    let lowered = sh_lower_hir(&hir, 1000);
    assert_eq_i64(lowered.error, 0, "hir_origins.sg", 83);
    result_ok_bool(true);
}

def h6_invalid_utf8(input: &String) {
    input.push_str("!");
    ();
}

def h6_mutate(words: &Vec<i64>) {
    if words.len() > 0 { words.set(0, sh_origin_at(words, 0) + 1); (); } else { words.push(0); (); };
}

def h6_deep(input: &ShHir, copy: &ShHir) {
    assert_true(input.source.handle != copy.source.handle, "hir_origins.sg", 30);
    h6_words(&input.ast.words, &copy.ast.words);
    h6_words(&input.ast.edges, &copy.ast.edges);
    h6_words(&input.origins.module_input, &copy.origins.module_input);
    h6_words(&input.checked.types.words, &copy.checked.types.words);
    h6_words(&input.checked.types.arguments, &copy.checked.types.arguments);
    assert_true(input.checked.symbols.names.handle != copy.checked.symbols.names.handle, "hir_origins.sg", 34);
    let mut symbol = 0;
    while symbol < sh_symbol_count(&input.checked.symbols) { assert_true(input.checked.symbols.names.get(symbol).text.handle != copy.checked.symbols.names.get(symbol).text.handle, "hir_origins.sg", 35); symbol = symbol + 1; };
    h6_words(&input.checked.node_types, &copy.checked.node_types);
    h6_words(&input.checked.call_types, &copy.checked.call_types);
    h6_words(&input.checked.deferred_types, &copy.checked.deferred_types);
    h6_words(&input.checked.builtin_calls, &copy.checked.builtin_calls);
    h6_words(&input.checked.resolution, &copy.checked.resolution);
    h6_words(&input.checked.node_scopes, &copy.checked.node_scopes);
    h6_words(&input.checked.bindings, &copy.checked.bindings);
    h6_words(&input.checked.scopes, &copy.checked.scopes);
    assert_true(input.checked.diagnostics.handle != copy.checked.diagnostics.handle, "hir_origins.sg", 31);
    h6_words(&input.checked.substitutions, &copy.checked.substitutions);
    h6_words(&input.checked.generic_parameters, &copy.checked.generic_parameters);
    h6_words(&input.checked.constraints, &copy.checked.constraints);
    h6_words(&input.checked.trait_types, &copy.checked.trait_types);
    h6_words(&input.checked.class_parents, &copy.checked.class_parents);
    h6_words(&input.checked.propagation, &copy.checked.propagation);
    h6_words(&input.checked.loop_values, &copy.checked.loop_values);
    assert_true(input.ownership.diagnostics.handle != copy.ownership.diagnostics.handle, "hir_origins.sg", 31);
    h6_words(&input.ownership.actions, &copy.ownership.actions);
    h6_words(&input.ownership.action_paths, &copy.ownership.action_paths);
    h6_words(&input.ownership.paths, &copy.ownership.paths);
    h6_words(&input.ownership.state, &copy.ownership.state);
    h6_words(&input.ownership.loans, &copy.ownership.loans);
    h6_words(&input.ownership.loan_parents, &copy.ownership.loan_parents);
    h6_words(&input.ownership.last_uses, &copy.ownership.last_uses);
    h6_words(&input.ownership.loops, &copy.ownership.loops);
    h6_words(&input.ownership.definitions, &copy.ownership.definitions);
    h6_words(&input.ownership.contracts, &copy.ownership.contracts);
    h6_words(&input.ownership.try_scopes, &copy.ownership.try_scopes);
    assert_true(input.origins.origins.identity.handle != copy.origins.origins.identity.handle, "hir_origins.sg", 32);
    assert_true(input.origins.origins.identity.as_str() == copy.origins.origins.identity.as_str(), "hir_origins.sg", 33);
    assert_true(input.origins.origins.digest.handle != copy.origins.origins.digest.handle, "hir_origins.sg", 32);
    assert_true(input.origins.origins.digest.as_str() == copy.origins.origins.digest.as_str(), "hir_origins.sg", 33);
    assert_true(input.origins.origins.prototype.handle != copy.origins.origins.prototype.handle, "hir_origins.sg", 32);
    assert_true(input.origins.origins.prototype.as_str() == copy.origins.origins.prototype.as_str(), "hir_origins.sg", 33);
    assert_true(input.origins.origins.text.handle != copy.origins.origins.text.handle, "hir_origins.sg", 32);
    assert_true(input.origins.origins.text.as_str() == copy.origins.origins.text.as_str(), "hir_origins.sg", 33);
    h6_words(&input.origins.origins.canonical, &copy.origins.origins.canonical);
    h6_words(&input.origins.origins.factories, &copy.origins.origins.factories);
    h6_words(&input.origins.origins.nodes, &copy.origins.origins.nodes);
    h6_words(&input.origins.origins.bindings, &copy.origins.origins.bindings);
    h6_words(&input.origins.origins.returns, &copy.origins.origins.returns);
    h6_words(&input.origins.origins.obligations, &copy.origins.origins.obligations);
    h6_words(&input.origins.origins.calls, &copy.origins.origins.calls);
    h6_words(&input.origins.origins.diagnostics, &copy.origins.origins.diagnostics);
    h6_words(&input.origins.origins.input, &copy.origins.origins.input);
    assert_true(input.origins.loans.option_identity.handle != copy.origins.loans.option_identity.handle, "hir_origins.sg", 32);
    assert_true(input.origins.loans.option_identity.as_str() == copy.origins.loans.option_identity.as_str(), "hir_origins.sg", 33);
    assert_true(input.origins.loans.option_digest.handle != copy.origins.loans.option_digest.handle, "hir_origins.sg", 32);
    assert_true(input.origins.loans.option_digest.as_str() == copy.origins.loans.option_digest.as_str(), "hir_origins.sg", 33);
    h6_words(&input.origins.loans.nodes, &copy.origins.loans.nodes);
    h6_words(&input.origins.loans.leases, &copy.origins.loans.leases);
    h6_words(&input.origins.loans.effects, &copy.origins.loans.effects);
    h6_words(&input.origins.loans.summaries, &copy.origins.loans.summaries);
    h6_words(&input.origins.loans.returns, &copy.origins.loans.returns);
    h6_words(&input.origins.loans.calls, &copy.origins.loans.calls);
    h6_words(&input.origins.loans.diagnostics, &copy.origins.loans.diagnostics);
    h6_words(&input.origins.loans.admissions, &copy.origins.loans.admissions);
    h6_words(&input.origins.loans.origin_input, &copy.origins.loans.origin_input);
    h6_words(&input.origins.loans.bindings, &copy.origins.loans.bindings);
    h6_words(&input.origins.loans.active, &copy.origins.loans.active);
    ();
}

def h6_state_word(output: &mut ShHirOriginsImage, values: &Vec<i64>) {
    sh_ho_put(output, values.handle, 4000000);
    sh_ho_put(output, values.marker, 4000000);
    sh_ho_put_vector(output, values, 4000000);
    ();
}

def h6_actual_state(graph: &ShModules, analyzed: &ShModuleChecked, ownership: &ShOwnership) -> ShHirOriginsImage {
    let mut output = sh_hir_origins_module_input(graph, analyzed, 4000000);
    sh_ho_put(&mut output, analyzed.checked.types.limit, 4000000);
    h6_state_word(&mut output, &analyzed.checked.types.words);
    h6_state_word(&mut output, &analyzed.checked.types.arguments);
    sh_ho_put(&mut output, analyzed.checked.symbols.limit, 4000000);
    sh_ho_put(&mut output, analyzed.checked.symbols.names.handle, 4000000);
    sh_ho_put(&mut output, analyzed.checked.symbols.names.marker, 4000000);
    sh_ho_put(&mut output, sh_symbol_count(&analyzed.checked.symbols), 4000000);
    let mut i = 0;
    while i < sh_symbol_count(&analyzed.checked.symbols) { sh_ho_put(&mut output, analyzed.checked.symbols.names.get(i).text.handle, 4000000); sh_ho_put_text(&mut output, &analyzed.checked.symbols.names.get(i).text, 4000000); i = i + 1; };
    h6_state_word(&mut output, &analyzed.checked.node_types);
    h6_state_word(&mut output, &analyzed.checked.call_types);
    h6_state_word(&mut output, &analyzed.checked.deferred_types);
    h6_state_word(&mut output, &analyzed.checked.builtin_calls);
    h6_state_word(&mut output, &analyzed.checked.resolution);
    h6_state_word(&mut output, &analyzed.checked.node_scopes);
    h6_state_word(&mut output, &analyzed.checked.bindings);
    h6_state_word(&mut output, &analyzed.checked.scopes);
    sh_ho_put(&mut output, analyzed.checked.diagnostics.handle, 4000000);
    sh_ho_put(&mut output, analyzed.checked.diagnostics.marker, 4000000);
    sh_ho_put(&mut output, analyzed.checked.diagnostics.len(), 4000000);
    let mut item = 0;
    while item < analyzed.checked.diagnostics.len() { let d = analyzed.checked.diagnostics.get(item); sh_ho_put(&mut output, d.code, 4000000); sh_ho_put(&mut output, d.severity, 4000000); sh_ho_put(&mut output, d.node, 4000000); sh_ho_put(&mut output, d.start, 4000000); sh_ho_put(&mut output, d.end, 4000000); sh_ho_put(&mut output, d.expected, 4000000); sh_ho_put(&mut output, d.actual, 4000000); item = item + 1; };
    h6_state_word(&mut output, &analyzed.checked.substitutions);
    h6_state_word(&mut output, &analyzed.checked.generic_parameters);
    h6_state_word(&mut output, &analyzed.checked.constraints);
    h6_state_word(&mut output, &analyzed.checked.trait_types);
    h6_state_word(&mut output, &analyzed.checked.class_parents);
    h6_state_word(&mut output, &analyzed.checked.propagation);
    h6_state_word(&mut output, &analyzed.checked.loop_values);
    sh_ho_put(&mut output, analyzed.checked.async_depth, 4000000);
    sh_ho_put(&mut output, analyzed.checked.unsafe_depth, 4000000);
    sh_ho_put(&mut output, analyzed.checked.error, 4000000);
    sh_ho_put(&mut output, analyzed.checked.start, 4000000);
    sh_ho_put(&mut output, analyzed.checked.end, 4000000);
    sh_ho_put(&mut output, analyzed.checked.diagnostic_limit, 4000000);
    sh_ho_put(&mut output, analyzed.checked.current_scope, 4000000);
    sh_ho_put(&mut output, analyzed.checked.current_owner, 4000000);
    sh_ho_put(&mut output, analyzed.checked.current_return, 4000000);
    sh_ho_put(&mut output, analyzed.checked.loop_depth, 4000000);
    sh_ho_put(&mut output, analyzed.checked.depth, 4000000);
    sh_ho_put(&mut output, analyzed.checked.unit_type, 4000000);
    sh_ho_put(&mut output, analyzed.checked.bool_type, 4000000);
    sh_ho_put(&mut output, analyzed.checked.integer_type, 4000000);
    sh_ho_put(&mut output, analyzed.checked.float_type, 4000000);
    sh_ho_put(&mut output, analyzed.checked.char_type, 4000000);
    sh_ho_put(&mut output, analyzed.checked.str_type, 4000000);
    sh_ho_put(&mut output, analyzed.checked.never_type, 4000000);
    sh_ho_put(&mut output, analyzed.checked.error_type, 4000000);
    sh_ho_put(&mut output, ownership.diagnostics.handle, 4000000);
    sh_ho_put(&mut output, ownership.diagnostics.marker, 4000000);
    sh_ho_put(&mut output, ownership.diagnostics.len(), 4000000);
    let mut item = 0;
    while item < ownership.diagnostics.len() { let d = ownership.diagnostics.get(item); sh_ho_put(&mut output, d.code, 4000000); sh_ho_put(&mut output, d.severity, 4000000); sh_ho_put(&mut output, d.node, 4000000); sh_ho_put(&mut output, d.start, 4000000); sh_ho_put(&mut output, d.end, 4000000); sh_ho_put(&mut output, d.expected, 4000000); sh_ho_put(&mut output, d.actual, 4000000); item = item + 1; };
    h6_state_word(&mut output, &ownership.actions);
    h6_state_word(&mut output, &ownership.action_paths);
    h6_state_word(&mut output, &ownership.paths);
    h6_state_word(&mut output, &ownership.state);
    h6_state_word(&mut output, &ownership.loans);
    h6_state_word(&mut output, &ownership.loan_parents);
    sh_ho_put(&mut output, ownership.access_mode, 4000000);
    h6_state_word(&mut output, &ownership.last_uses);
    h6_state_word(&mut output, &ownership.loops);
    h6_state_word(&mut output, &ownership.definitions);
    h6_state_word(&mut output, &ownership.contracts);
    sh_ho_put(&mut output, ownership.projection_context, 4000000);
    h6_state_word(&mut output, &ownership.try_scopes);
    sh_ho_put(&mut output, ownership.error, 4000000);
    sh_ho_put(&mut output, ownership.start, 4000000);
    sh_ho_put(&mut output, ownership.end, 4000000);
    sh_ho_put(&mut output, ownership.limit, 4000000);
    sh_ho_put(&mut output, ownership.function, 4000000);
    sh_ho_put(&mut output, ownership.scope, 4000000);
    sh_ho_put(&mut output, ownership.flow, 4000000);
    sh_ho_put(&mut output, ownership.depth, 4000000);
    output;
}

def h6_poison(copy: &mut ShHir, mode: i64) {
    if mode == 1 { copy.error = 1; (); };
    if mode == 2 { copy.start = -1; (); };
    if mode == 3 { copy.end = copy.source.len() + 1; (); };
