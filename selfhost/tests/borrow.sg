    sh_borrow_case("struct Buffer{handle:i64} impl Drop for Buffer{def drop(&mut self){}} extern \"C\"{fn sengoo_ffi_buffer_ptr(handle:i64)->i64;fn sengoo_ffi_buffer_len(handle:i64)->i64;fn sengoo_ffi_buffer_get_u8(handle:i64,index:i64)->i64;} def ptr(value:Buffer)->i64{sengoo_ffi_buffer_ptr(value.handle)} def f(){let buffer=Buffer{handle:1};let raw=ptr(buffer);let again=buffer;();}", 6101)?;
    sh_borrow_case("struct Buffer{handle:i64} impl Drop for Buffer{def drop(&mut self){}} extern \"C\"{fn sengoo_ffi_buffer_ptr(handle:i64)->i64;fn sengoo_ffi_buffer_len(handle:i64)->i64;fn sengoo_ffi_buffer_get_u8(handle:i64,index:i64)->i64;} extern \"C\"{fn sengoo_unicode_version_copy(output:i64,capacity:i64)->i64;} def wrapper(buffer:Buffer)->i64{sengoo_unicode_version_copy(sengoo_ffi_buffer_ptr(buffer.handle),sengoo_ffi_buffer_len(buffer.handle))} def f(){let buffer=Buffer{handle:1};wrapper(buffer);wrapper(buffer);();}", 0)?;
    sh_borrow_case("struct Buffer{handle:i64} impl Drop for Buffer{def drop(&mut self){}} extern \"C\"{fn sengoo_ffi_buffer_ptr(handle:i64)->i64;fn sengoo_ffi_buffer_len(handle:i64)->i64;fn sengoo_ffi_buffer_get_u8(handle:i64,index:i64)->i64;} extern \"C\"{fn sengoo_unicode_provenance_copy(output:i64,capacity:i64)->i64;} def wrapper(buffer:Buffer)->i64{sengoo_unicode_provenance_copy(sengoo_ffi_buffer_ptr(buffer.handle),sengoo_ffi_buffer_len(buffer.handle))} def f(){let buffer=Buffer{handle:1};wrapper(buffer);wrapper(buffer);();}", 0)?;
    sh_borrow_case("struct Buffer{handle:i64} impl Drop for Buffer{def drop(&mut self){}} extern \"C\"{fn sengoo_ffi_buffer_ptr(handle:i64)->i64;fn sengoo_ffi_buffer_len(handle:i64)->i64;fn sengoo_ffi_buffer_get_u8(handle:i64,index:i64)->i64;} extern \"C\"{fn sengoo_ffi_last_error_copy(output:i64,capacity:i64)->i64;} def wrapper(buffer:Buffer)->i64{sengoo_ffi_last_error_copy(sengoo_ffi_buffer_ptr(buffer.handle),sengoo_ffi_buffer_len(buffer.handle))} def f(){let buffer=Buffer{handle:1};wrapper(buffer);wrapper(buffer);();}", 0)?;
