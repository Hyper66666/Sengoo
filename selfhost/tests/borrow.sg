def sh_test_propagation_cleanup() -> Result<bool, i64> {
    let text = string_from_str("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } struct Result<T,E> { is_ok: bool, value: T, error: E, } def fail() -> Result<i64,i64> { Result { is_ok: false, value: 0, error: 42 }; } def f() -> Result<i64,i64> { let owner = Owner { value: 1 }; let value = fail()?; Result { is_ok: true, value: value, error: 0 }; }")?;
    let parsed = sh_parse(&text, 0, 10000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "propagation.sg", 11);
    let facts = sh_check_ownership(&text, &parsed.ast, &checked, 100);
    assert_eq_i64(facts.error, 0, "propagation.sg", 13);
    let mut failure = 0;
    let mut normal = 0;
    let mut index = 0;
    let mut owner = -1;
    while index < sh_ownership_action_count(&facts) { let kind = sh_ownership_action(&facts, index, 2); if kind == 7 { assert_eq_i64(sh_ast_word(&parsed.ast, sh_ownership_action(&facts, index, 0), 0), 56, "propagation.sg", 16); owner = sh_ownership_action(&facts, index, 1); failure = failure + 1; (); }; index = index + 1; };
    index = 0;
    while index < sh_ownership_action_count(&facts) { if sh_ownership_action(&facts, index, 2) == 3 and sh_ownership_action(&facts, index, 1) == owner { normal = normal + 1; }; index = index + 1; };
    assert_eq_i64(failure, 1, "propagation.sg", 19);
    assert_eq_i64(normal, 1, "propagation.sg", 20);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_native_input_signatures() -> Result<bool, i64> {
    let text = string_from_str("extern \"C\"{fn sengoo_ffi_buffer_ptr(value:i64)->i64;fn sengoo_unicode_version_copy(output:i64,capacity:i64)->i64;}")?;
    let parsed = sh_parse(&text, 0, 10000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "native-input.sg", 1);
    let mut index = 0;
    let mut count = 0;
    while index < sh_binding_count(&checked) { if sh_binding_word(&checked, index, 2) == 2 and (sh_binding_word(&checked, index, 5) & 8) != 0 { let ty = sh_s_resolve(&checked, sh_binding_word(&checked, index, 3)); let projects = sh_b_native_projects(&checked, index, 0); let observes = sh_b_native_contract(&checked, index, 0); assert_true(projects or observes, "native-input.sg", 2); checked.types.words.set(ty * 6 + 2, 1); assert_true(not sh_b_native_projects(&checked, index, 0), "native-input.sg", 3); assert_true(not sh_b_native_contract(&checked, index, 0), "native-input.sg", 4); checked.types.words.set(ty * 6 + 2, 0); assert_eq_i64(if sh_b_native_projects(&checked, index, 0) { 1; } else { 0; }, if projects { 1; } else { 0; }, "native-input.sg", 5); assert_eq_i64(if sh_b_native_contract(&checked, index, 0) { 1; } else { 0; }, if observes { 1; } else { 0; }, "native-input.sg", 6); count = count + 1; }; index = index + 1; };
    assert_eq_i64(count, 2, "native-input.sg", 7);
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let mut round = 0;
    while round < 50 { let native_signatures = sh_test_native_input_signatures(); if not native_signatures.is_ok() { return 12; }; let propagation = sh_test_propagation_cleanup(); if not propagation.is_ok() { return 11; }; let logical = sh_test_logical_cleanup(); if not logical.is_ok() { return 9; }; let identity = sh_test_raw_identity_transfer(); if not identity.is_ok() { return 10; }; let contract = sh_test_observed_contract(); if not contract.is_ok() { return 8; }; let facts = sh_test_facts_constructor(); if not facts.is_ok() { return 7; }; let result = sh_test_borrow_round(); if not result.is_ok() { return 1; }; let lifetimes = sh_test_temporary_lifetimes(); if not lifetimes.is_ok() { return 6; }; round = round + 1; };
    let overwrite = sh_test_overwrite_phase();
    if not overwrite.is_ok() { return 4; };
    let precise = sh_test_exact_move_span();
    if not precise.is_ok() { return 5; };
    let temporary = sh_test_temporary_actions();
    if not temporary.is_ok() { return 3; };
    let actions = sh_test_borrow_actions();
    if not actions.is_ok() { return 2; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "borrow.sg", 83);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "borrow.sg", 84);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "borrow.sg", 85);
    println("selfhost ownership: ok");
    0;
}
