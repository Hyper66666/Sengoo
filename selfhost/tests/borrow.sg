    sh_borrow_case("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } struct Pair { left: Owner, right: Owner, } def consume(value: Owner) {} def consume_pair(value: Pair) {} def f() { let mut pair = Pair { left: Owner { value: 1 }, right: Owner { value: 2 } }; consume(pair.left); pair.left = Owner { value: 3 }; consume_pair(pair); }", 0)?;
    sh_borrow_case("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } struct Pair { left: Owner, right: Owner, } def consume(value: Pair) {} def f() { let mut pair = Pair { left: Owner { value: 1 }, right: Owner { value: 2 } }; consume(pair); pair.left = Owner { value: 3 }; }", 6101)?;
    sh_borrow_case("def f(value: i64) -> i64 { match value { item => item } }", 0)?;
    sh_borrow_case("def f() { for value in [1, 2] { let copy = value; } }", 0)?;
    sh_borrow_case("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } enum Choice { Value(Owner), Empty, } def consume(value: Owner) {} def f(choice: Choice) { match choice { Choice::Value(value) => consume(value), Choice::Empty => {} } }", 6111)?;
    sh_borrow_case("def read(value: i64) {} def mutate(value: &mut i64) {} def f() { let mut value = 1; let alias = &mut value; read(value); mutate(alias); }", 6103)?;
    sh_borrow_case("def mutate(value: &mut i64) {} def f() { let mut value = 1; let first = &mut value; let second = first; mutate(second); mutate(first); }", 6101)?;
    sh_borrow_case("def mutate(value: &mut i64) {} def f() { let mut value = 1; let first = &mut value; let second = first; mutate(second); }", 0)?;
    sh_borrow_case("def mutate(value: &mut i64) {} def f() { let mut value = 1; let first = &mut value; let second = &mut *first; mutate(second); mutate(first); }", 0)?;
    sh_borrow_case("def mutate(value: &mut i64) {} def f() { let mut value = 1; let first = &mut value; let second = &mut *first; mutate(first); mutate(second); }", 6102)?;
    sh_borrow_case("def mutate(left: &mut i64, right: &mut i64) {} def f() { let mut value = 1; let alias = &mut value; mutate(alias, alias); }", 6102)?;
    sh_borrow_case("def f(value: &mut i64) { let alias = &mut *value; *alias = 3; }", 0)?;
    sh_borrow_case("struct Pair { left: i64, right: i64, } def mutate(left: &mut i64, right: &mut i64) {} def f() { let mut pair = Pair { left: 1, right: 2 }; let left = &mut pair.left; let right = &mut pair.right; mutate(left, right); }", 0)?;
    sh_borrow_case("def mutate(value: &mut i64) {} def f() { let mut value = 1; let first = &mut value; let second = &mut *first; let copy = *first; mutate(second); }", 6103)?;
    sh_borrow_case("def mutate(value: &mut i64) {} def f() { let mut value = 1; let first = &mut value; let second = &mut *first; *first = 2; mutate(second); }", 6106)?;
    sh_borrow_case("def mutate(left: &mut i64, right: &mut i64) {} def f() { let mut value = 1; mutate(&mut value, &mut value); }", 6102)?;
    sh_borrow_case("def nested(value: &mut i64) -> i64 { 0 } def mutate(left: &mut i64, middle: i64, right: &mut i64) {} def f() { let mut first = 1; let mut second = 2; mutate(&mut first, nested(&mut second), &mut first); }", 6102)?;
    sh_borrow_case("def identity(value: &i64) -> &i64 { value } def observe(value: &i64) {} def f() { let mut value = 1; let alias = identity(&value); value = 2; observe(alias); }", 6106)?;
    sh_borrow_case("def identity(value: &i64) -> &i64 { value } def observe(value: &i64, other: &mut i64) {} def f() { let mut value = 1; observe(identity(&value), &mut value); }", 6103)?;
    sh_borrow_case("struct Owner { value: i64, } impl Owner { def borrow(&self) -> &i64 { &self.value } } def observe(value: &i64, other: &mut Owner) {} def f() { let mut owner = Owner { value: 1 }; observe(owner.borrow(), &mut owner); }", 6103)?;
    sh_borrow_case("def f(flag: bool) { let mut first = 1; let mut second = 2; let alias = if flag { &mut first } else { &mut second }; let copied = *alias; (); }", 6111)?;
    sh_borrow_case("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } def consume(value: Owner) {} def f(value: &Owner) { consume(*value); }", 6112)?;
    sh_borrow_case("struct String { handle: i64, } extern \"C\" { fn sengoo_string_len(value: i64) -> i64; } def length(value: String) -> i64 { sengoo_string_len(value.handle) } def f() { let owner = String { handle: 1 }; length(owner); length(owner); (); }", 0)?;
    sh_borrow_case("struct String { handle: i64, } extern \"C\" { fn sengoo_string_len(value: i64) -> i64; } def outer(value: String) -> i64 { inner(value) } def inner(value: String) -> i64 { sengoo_string_len(value.handle) } def f() { let owner = String { handle: 1 }; outer(owner); outer(owner); (); }", 0)?;
    sh_borrow_case("struct String { handle: i64, } def unused(value: String) {} def f() { let owner = String { handle: 1 }; unused(owner); unused(owner); (); }", 0)?;
    sh_borrow_case("struct String { handle: i64, } def sengoo_string_len(value: i64) -> i64 { value } def length(value: String) -> i64 { sengoo_string_len(value.handle) } def f() { let owner = String { handle: 1 }; length(owner); length(owner); (); }", 6101)?;
    sh_borrow_case("struct String { handle: i64, } extern \"C\" { fn sengoo_string_len(value: i64, other: i64) -> i64; } def length(value: String) -> i64 { sengoo_string_len(value.handle, 0) } def f() { let owner = String { handle: 1 }; length(owner); length(owner); (); }", 6101)?;
    sh_borrow_case("struct String { handle: i64, } extern \"C\" { fn sengoo_string_len(value: i64) -> i64; } def length(value: String) -> i64 { let alias = value.handle; sengoo_string_len(alias) } def f() { let owner = String { handle: 1 }; length(owner); length(owner); (); }", 6101)?;
    sh_borrow_case("struct String { handle: i64, } def equal(left: String, right: String) -> bool { left.handle == right.handle } def f() { let owner = String { handle: 1 }; equal(owner, owner); equal(owner, owner); (); }", 0)?;
    sh_borrow_case("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } def consume(value: Owner) -> bool { true } def f(flag: bool) { let owner = Owner { value: 1 }; flag and consume(owner); consume(owner); (); }", 6101)?;
    sh_borrow_case("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } def consume(value: Owner) -> bool { true } def f(flag: bool) -> bool { let owner = Owner { value: 1 }; flag and { consume(owner); return true; }; consume(owner); false }", 0)?;
    sh_borrow_case("struct String { handle: i64, } def equal(left: String, right: String) -> bool { left == right } def f() { let owner = String { handle: 1 }; equal(owner, owner); equal(owner, owner); (); }", 0)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_borrow_actions() -> Result<bool, i64> {
    let text = string_from_str("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } def f() { let first = Owner { value: 1 }; let second = Owner { value: 2 }; }")?;
    let parsed = sh_parse(&text, 0, 10000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "borrow.sg", 46);
    let ownership = sh_check_ownership(&text, &parsed.ast, &checked, 100);
    assert_eq_i64(ownership.error, 0, "borrow.sg", 48);
    let mut initializations = 0;
    let mut drops = 0;
    let mut last = 9223372036854775807;
    let mut index = 0;
    while index < sh_ownership_action_count(&ownership) { let kind = sh_ownership_action(&ownership, index, 2); let binding = sh_ownership_action(&ownership, index, 1); if kind == 1 and sh_binding_word(&checked, binding, 2) == 0 { initializations = initializations + 1; }; if kind == 3 { assert_true(binding < last, "borrow.sg", 58); assert_eq_i64(sh_ownership_action(&ownership, index, 4), 0, "borrow.sg", 59); last = binding; drops = drops + 1; }; index = index + 1; };
    assert_eq_i64(initializations, 2, "borrow.sg", 65);
    assert_eq_i64(drops, 2, "borrow.sg", 66);
    assert_eq_i64(sh_ownership_action(&ownership, -1, 0), -1, "borrow.sg", 67);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_temporary_actions() -> Result<bool, i64> {
    let text = string_from_str("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } struct Pair { left: Owner, right: Owner, } def make() -> Pair { Pair { left: Owner { value: 1 }, right: Owner { value: 2 } } } def f() { let moved = make().left; }")?;
    let parsed = sh_parse(&text, 0, 10000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "temp.sg", 1);
    let ownership = sh_check_ownership(&text, &parsed.ast, &checked, 100);
    assert_eq_i64(ownership.error, 0, "temp.sg", 2);
    let mut temporary_drops = 0;
    let mut local_drops = 0;
    let mut index = 0;
    while index < sh_ownership_action_count(&ownership) { if sh_ownership_action(&ownership, index, 2) == 3 { let binding = sh_ownership_action(&ownership, index, 1); if binding < 0 { let path = sh_ownership_action_path(&ownership, index); assert_true(path >= 0, "temp.sg", 3); assert_true(sh_ownership_path_word(&ownership, path, 1) >= 0, "temp.sg", 4); temporary_drops = temporary_drops + 1; } else { local_drops = local_drops + 1; }; }; index = index + 1; };
    assert_eq_i64(temporary_drops, 1, "temp.sg", 5);
    assert_eq_i64(local_drops, 1, "temp.sg", 6);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_overwrite_phase() -> Result<bool, i64> {
    let text = string_from_str("struct Owner { value: i64, } impl Drop for Owner { def drop(&mut self) {} } def f() { let mut owner = Owner { value: 1 }; owner = Owner { value: 2 }; }")?;
    let parsed = sh_parse(&text, 0, 10000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "borrow.sg", 111);
    let ownership = sh_check_ownership(&text, &parsed.ast, &checked, 100);
    assert_eq_i64(ownership.error, 0, "borrow.sg", 113);
    let mut before_store = 0;
    let mut after_store = 0;
    let mut index = 0;
    while index < sh_ownership_action_count(&ownership) { let kind = sh_ownership_action(&ownership, index, 2); if kind == 6 { assert_eq_i64(sh_ast_word(&parsed.ast, sh_ownership_action(&ownership, index, 0), 0), 52, "borrow.sg", 117); before_store = before_store + 1; }; if kind == 3 { after_store = after_store + 1; }; index = index + 1; };
    assert_eq_i64(before_store, 1, "borrow.sg", 120);
    assert_eq_i64(after_store, 1, "borrow.sg", 121);
