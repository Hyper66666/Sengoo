import selfhost_borrow;

import std::assert;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def sh_borrow_case(raw: &str, expected: i64) -> Result<bool, i64> {
    let text = string_from_str(raw)?;
    let parsed = sh_parse(&text, 0, 10000);
    if parsed.error != 0 { println(raw); };
    assert_eq_i64(parsed.error, 0, "borrow.sg", 14);
    let checked = sh_check(&text, &parsed.ast, 100);
    if checked.error != 0 { println(checked.error); println(checked.start); println(raw); return result_err_bool(checked.error); };
    let ownership = sh_check_ownership(&text, &parsed.ast, &checked, 100);
    if ownership.error != expected { println(ownership.error); println(ownership.start); println(raw); };
    assert_eq_i64(ownership.error, expected, "borrow.sg", 19);
    if expected != 0 { assert_true(ownership.diagnostics.len() > 0, "borrow.sg", 21); assert_true(ownership.start >= 0 and ownership.end > ownership.start, "borrow.sg", 22); (); };
    Result { is_ok: true, value: true, error: 0 };
}

