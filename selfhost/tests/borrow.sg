}

def sh_test_raw_identity_transfer() -> Result<bool, i64> {
    let text = string_from_str("struct String { handle: i64, } def identity(value: String) -> i64 { value.handle } def f() { let owner = String { handle: 1 }; identity(owner); (); }")?;
    let parsed = sh_parse(&text, 0, 10000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "observe.sg", 21);
    let ownership = sh_check_ownership(&text, &parsed.ast, &checked, 100);
    assert_eq_i64(ownership.error, 0, "observe.sg", 22);
    let mut drops = 0;
    let mut index = 0;
    while index < sh_ownership_action_count(&ownership) { if sh_ownership_action(&ownership, index, 2) == 3 { drops = drops + 1; }; index = index + 1; };
    assert_eq_i64(drops, 0, "observe.sg", 23);
