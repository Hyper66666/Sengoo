import selfhost_types;

import std::assert;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def sh_test_types() -> Result<bool, i64> {
    let types = sh_types_new(12);
    let unit = sh_type_primitive(&types, 0, 0, 0)?;
    let signed = sh_type_primitive(&types, 2, 64, 1)?;
    let unsigned = sh_type_primitive(&types, 2, 64, 0)?;
    assert_eq_i64(sh_type_primitive(&types, 2, 64, 1)?, signed, "types.sg", 17);
    assert_true(signed != unsigned, "types.sg", 18);
    let pointer_signed = sh_type_primitive(&types, 2, 64, 3)?;
    let pointer_unsigned = sh_type_primitive(&types, 2, 64, 2)?;
    assert_true(pointer_signed != signed and pointer_unsigned != unsigned, "types.sg", 19);
    assert_true(pointer_signed != pointer_unsigned, "types.sg", 20);
    let arguments = vec_new_i64();
    arguments.push(signed);
    let reference = sh_type_intern(&types, 6, 0, 0, -1, &arguments)?;
    let mutable = sh_type_intern(&types, 6, 0, 1, -1, &arguments)?;
    assert_true(reference != mutable, "types.sg", 23);
    assert_eq_i64(sh_type_argument(&types, reference, 0)?, signed, "types.sg", 24);
    arguments.push(unsigned);
    let pair = sh_type_intern(&types, 10, 0, 0, -1, &arguments)?;
    arguments.set(0, unsigned);
    arguments.set(1, signed);
    let reversed = sh_type_intern(&types, 10, 0, 0, -1, &arguments)?;
    assert_true(pair != reversed, "types.sg", 30);
    let nominal = sh_type_intern(&types, 12, 0, 0, 42, &arguments)?;
    let other_nominal = sh_type_intern(&types, 12, 0, 0, 43, &arguments)?;
    assert_true(nominal != other_nominal, "types.sg", 33);
    arguments.push(unit);
    let function = sh_type_intern(&types, 11, 0, 0, -1, &arguments)?;
    assert_eq_i64(sh_type_argument(&types, function, 2)?, unit, "types.sg", 36);
    assert_eq_i64(sh_type_count(&types), 12, "types.sg", 37);
    assert_eq_i64(sh_type_primitive(&types, 2, 64, 1)?, signed, "types.sg", 38);
    assert_eq_i64(sh_type_primitive(&types, 1, 0, 0).error, 4001, "types.sg", 39);
    assert_eq_i64(sh_type_word(&types, 9223372036854775807, 0).error, 4002, "types.sg", 40);
    assert_eq_i64(sh_type_argument(&types, function, -1).error, 4002, "types.sg", 41);
    let absent = vec_new_i64();
    absent.push(999);
    assert_eq_i64(sh_type_intern(&types, 6, 0, 0, -1, &absent).error, 4002, "types.sg", 44);
    assert_eq_i64(sh_type_primitive(&types, 2, 65, 1).error, 4003, "types.sg", 45);
    assert_eq_i64(sh_type_count(&types), 12, "types.sg", 46);
    let negative = sh_types_new(-1);
    assert_eq_i64(sh_type_primitive(&negative, 0, 0, 0).error, 4001, "types.sg", 48);
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let mut round = 0;
    while round < 100 { let result = sh_test_types(); if not result.is_ok() { println(result.error); return 1; }; let dynamic = sh_test_dyn_types(); if not dynamic.is_ok() { println(dynamic.error); return 2; }; round = round + 1; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "types.sg", 64);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "types.sg", 65);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "types.sg", 66);
    println("selfhost types: ok");
    0;
}

def sh_test_dyn_types() -> Result<bool, i64> {
    let types = sh_types_new(30);
    let integer = sh_type_primitive(&types, 2, 64, 1)?;
    let empty = vec_new_i64();
    let value = vec_new_i64();
    value.push(integer);
    let projection = sh_type_intern(&types, 15, 100, 0, 101, &value)?;
    let fixed = sh_type_intern(&types, 15, 100, 1, 101, &value)?;
    assert_true(projection != fixed, "types.sg", 82);
    let entries = vec_new_i64();
    entries.push(fixed);
    let dynamic = sh_type_intern(&types, 14, 0, 1, 100, &entries)?;
    assert_eq_i64(sh_type_argument(&types, dynamic, 0)?, fixed, "types.sg", 84);
    assert_eq_i64(sh_type_intern(&types, 14, 0, 1, 100, &entries)?, dynamic, "types.sg", 85);
    let ordinary = sh_type_intern(&types, 14, 0, 0, 100, &value)?;
    assert_true(ordinary != dynamic, "types.sg", 87);
    assert_eq_i64(sh_type_intern(&types, 14, 0, 1, 100, &value).error, 4003, "types.sg", 88);
    assert_eq_i64(sh_type_intern(&types, 14, 0, 1, 102, &entries).error, 4003, "types.sg", 89);
    entries.push(fixed);
    assert_eq_i64(sh_type_intern(&types, 14, 0, 1, 100, &entries).error, 4003, "types.sg", 91);
    assert_eq_i64(sh_type_intern(&types, 14, 0, 2, 100, &empty).error, 4003, "types.sg", 92);
    assert_eq_i64(sh_type_intern(&types, 15, 100, 2, 101, &value).error, 4003, "types.sg", 93);
    assert_eq_i64(sh_type_intern(&types, 15, 100, 0, 101, &empty).error, 4003, "types.sg", 94);
    let nested = vec_new_i64();
    nested.push(fixed);
    assert_eq_i64(sh_type_intern(&types, 15, 100, 1, 103, &nested).error, 4003, "types.sg", 96);
    assert_eq_i64(sh_type_intern(&types, 13, 7, 1, 101, &empty).error, 4003, "types.sg", 97);
    assert_eq_i64(sh_type_intern(&types, 12, 0, 1, 101, &empty).error, 4003, "types.sg", 98);
    Result { is_ok: true, value: true, error: 0 };
}
