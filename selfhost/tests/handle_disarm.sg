struct Buffer {
    handle: i64,
}

struct Destination {
    handle: i64,
}

extern "C" {
    fn sg_acquire() -> i64;
    fn sengoo_ffi_buffer_free(handle: i64) -> i64;
    fn sg_destination_drop(handle: i64);
    fn sg_counts(round: i64) -> i64;
    fn sengoo_ffi_buffer_len(handle: i64) -> i64;
}

impl Drop for Buffer {
    def drop(&mut self) {
        sengoo_ffi_buffer_free(self.handle);
    }
}

impl Drop for Destination {
    def drop(&mut self) {
        sg_destination_drop(self.handle);
    }
}

def exercise() -> i64 {
    let mut source = Buffer { handle: sg_acquire() };
    let raw = source.handle;
    source.handle = 0;
    let destination = Destination { handle: raw };
    if sengoo_ffi_buffer_len(destination.handle) != 16 { return 1; };
    42;
}

def main() -> i64 {
    let mut round = 0;
    while round < 100 { if exercise() != 42 { return 2; }; round = round + 1; if sg_counts(round) != 42 { return 3; }; };
    42;
}
