import selfhost_link_codeview;

import selfhost_link_pe;

import std::file;

import std::args;

import std::io;

import std::assert;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_bytes() -> i64;
}

def sh_lpt_argument(index: i64) -> Result<String, i64> {
    let buffer = ffi_buffer_new(arg_len(index).unwrap_or(0))?;
    let length = arg_copy(index, buffer)?;
    string_from_utf8(buffer, length);
}

def sh_lpt_run() -> Result<i64, i64> {
    if args_len() != 4 { return sh_i64_ok(64); };
    let source_path = sh_lpt_argument(0)?;
    let object_path = sh_lpt_argument(1)?;
    let image_path = sh_lpt_argument(2)?;
    let pdb_path = sh_lpt_argument(3)?;
    let source = sh_link_load(source_path.as_str(), 1048576)?;
    let object = sh_object_new(16384);
    let code = sh_binary_new(128);
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 131)?;
    sh_binary_byte(&code, 236)?;
    sh_binary_byte(&code, 40)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 17)?;
    sh_binary_byte(&code, 68)?;
    sh_binary_byte(&code, 36)?;
    sh_binary_byte(&code, 24)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 17)?;
    sh_binary_byte(&code, 76)?;
    sh_binary_byte(&code, 36)?;
    sh_binary_byte(&code, 32)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 16)?;
    sh_binary_byte(&code, 68)?;
    sh_binary_byte(&code, 36)?;
    sh_binary_byte(&code, 24)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 88)?;
    sh_binary_byte(&code, 68)?;
    sh_binary_byte(&code, 36)?;
    sh_binary_byte(&code, 32)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 17)?;
    sh_binary_byte(&code, 68)?;
    sh_binary_byte(&code, 36)?;
    sh_binary_byte(&code, 16)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 184)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 64)?;
    sh_binary_byte(&code, 102)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 110)?;
    sh_binary_byte(&code, 200)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 88)?;
    sh_binary_byte(&code, 193)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 17)?;
    sh_binary_byte(&code, 68)?;
    sh_binary_byte(&code, 36)?;
    sh_binary_byte(&code, 16)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 16)?;
    sh_binary_byte(&code, 68)?;
    sh_binary_byte(&code, 36)?;
    sh_binary_byte(&code, 16)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 131)?;
    sh_binary_byte(&code, 196)?;
    sh_binary_byte(&code, 40)?;
    sh_binary_byte(&code, 195)?;
    sh_binary_align(&code, 16, 144)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 131)?;
    sh_binary_byte(&code, 236)?;
    sh_binary_byte(&code, 40)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 184)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 52)?;
    sh_binary_byte(&code, 64)?;
    sh_binary_byte(&code, 102)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 110)?;
    sh_binary_byte(&code, 192)?;
    sh_binary_byte(&code, 102)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 110)?;
    sh_binary_byte(&code, 200)?;
    sh_binary_byte(&code, 232)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 0)?;
    sh_binary_byte(&code, 242)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 15)?;
    sh_binary_byte(&code, 44)?;
    sh_binary_byte(&code, 192)?;
    sh_binary_byte(&code, 72)?;
    sh_binary_byte(&code, 131)?;
    sh_binary_byte(&code, 196)?;
    sh_binary_byte(&code, 40)?;
    sh_binary_byte(&code, 195)?;
    let text_name = string_from_str(".text")?;
    let text = sh_object_add_section(&object, &text_name, &code, 1610612768, 16)?;
    let add_name = string_from_str("add_values")?;
    let add = sh_object_add_symbol(&object, &add_name, 0, text + 1, true, 2)?;
    let main_name = string_from_str("main")?;
    let main = sh_object_add_symbol(&object, &main_name, 80, text + 1, true, 2)?;
    sh_object_add_relocation(&object, text, 105, add, 4)?;
    let unwind = sh_binary_new(8);
    sh_binary_unsigned(&unwind, 66561, 4)?;
    sh_binary_unsigned(&unwind, 16900, 4)?;
    let unwind_name = string_from_str(".xdata")?;
    let unwind_section = sh_object_add_section(&object, &unwind_name, &unwind, 1073741888, 4)?;
    let unwind_symbol_name = string_from_str("typed_unwind")?;
    let unwind_symbol = sh_object_add_symbol(&object, &unwind_symbol_name, 0, unwind_section + 1, false, 3)?;
    let pdata = sh_binary_new(24);
    sh_binary_unsigned(&pdata, 0, 4)?;
    sh_binary_unsigned(&pdata, 70, 4)?;
    sh_binary_unsigned(&pdata, 0, 4)?;
    sh_binary_unsigned(&pdata, 0, 4)?;
    sh_binary_unsigned(&pdata, 39, 4)?;
    sh_binary_unsigned(&pdata, 0, 4)?;
    let pdata_name = string_from_str(".pdata")?;
    let pdata_section = sh_object_add_section(&object, &pdata_name, &pdata, 1073741888, 4)?;
    sh_object_add_relocation(&object, pdata_section, 0, add, 3)?;
    sh_object_add_relocation(&object, pdata_section, 4, add, 3)?;
    sh_object_add_relocation(&object, pdata_section, 8, unwind_symbol, 3)?;
    sh_object_add_relocation(&object, pdata_section, 12, main, 3)?;
    sh_object_add_relocation(&object, pdata_section, 16, main, 3)?;
    sh_object_add_relocation(&object, pdata_section, 20, unwind_symbol, 3)?;
    let mut debug = sh_link_debug_new();
    sh_link_debug_source(&mut debug, &source_path, &source)?;
    let arguments = vec_new_i64();
    arguments.push(65);
    arguments.push(65);
    let function = sh_link_debug_typed_function(&debug, &add_name, 1, 0, 70, 40, 4, 65, 65, &arguments)?;
    let left = string_from_str("left")?;
    let right = string_from_str("right")?;
    let answer = string_from_str("answer")?;
    sh_link_debug_parameter(&debug, function, &left, 65, 24, 10, 55)?;
    sh_link_debug_parameter(&debug, function, &right, 65, 32, 16, 49)?;
    sh_link_debug_local(&debug, function, &answer, 65, 16, 34, 31)?;
    sh_link_debug_line(&debug, function, 0, 1)?;
    sh_link_debug_line(&debug, function, 16, 2)?;
    sh_link_debug_line(&debug, function, 34, 3)?;
    sh_link_debug_line(&debug, function, 59, 4)?;
    let entry = sh_link_debug_function(&debug, &main_name, 1, 80, 39, 40, 4, 34)?;
    sh_link_debug_line(&debug, entry, 0, 6)?;
    sh_link_debug_line(&debug, entry, 4, 7)?;
    sh_link_debug_line(&debug, entry, 29, 8)?;
    sh_link_codeview_attach(&object, &debug)?;
    let raw = sh_object_emit(&object)?;
    let mut link = sh_link_new(1048576);
    let object_id = sh_link_coff(&mut link, &raw)?;
    let image = sh_link_pe(&mut link, &main_name)?;
    let mut decoded = sh_link_debug_new();
    sh_link_debug_source(&mut decoded, &source_path, &source)?;
    sh_link_codeview_read(&decoded, &link, &image, object_id)?;
    let linked = sh_link_debug_image(&decoded, &image, &pdb_path)?;
    let pdb = sh_link_pdb(&decoded, &image, &pdb_path)?;
    let a = sh_binary_buffer(&raw)?;
    let b = sh_binary_buffer(&linked)?;
    let c = sh_binary_buffer(&pdb)?;
    file_write_str_raw(sengoo_stdlib_str_ptr(object_path.as_str()), a.ptr(), a.used_len())?;
    file_write_str_raw(sengoo_stdlib_str_ptr(image_path.as_str()), b.ptr(), b.used_len())?;
    file_write_str_raw(sengoo_stdlib_str_ptr(pdb_path.as_str()), c.ptr(), c.used_len())?;
    println("selfhost SG typed CodeView/PDB: ok");
    sh_i64_ok(0);
}

def main() -> i64 {
    let result = sh_lpt_run();
    if not result.is_ok() { println(result.error); return 65; };
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let snapshots = sengoo_file_snapshot_live_handle_count();
    let snapshot_bytes = sengoo_file_snapshot_live_bytes();
    let mut round = 0;
    while round < 20 { let scoped = sh_lpt_run(); if not scoped.is_ok() { println(scoped.error); return 65; }; round = round + 1; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "link_cv_types_debug.sg", 1);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "link_cv_types_debug.sg", 1);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "link_cv_types_debug.sg", 1);
    assert_eq_i64(sengoo_file_snapshot_live_handle_count(), snapshots, "link_cv_types_debug.sg", 1);
    assert_eq_i64(sengoo_file_snapshot_live_bytes(), snapshot_bytes, "link_cv_types_debug.sg", 1);
    println("selfhost SG typed parameter/local PDB exact resources: ok");
    result.value;
}
