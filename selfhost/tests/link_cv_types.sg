import selfhost_link_cv_types;

import std::assert;

import std::io;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def sh_ltt_scope() -> Result<i64, i64> {
    let types = sh_link_cv_types_new();
    let arguments = vec_new_i64();
    assert_eq_i64(sh_link_cv_type_procedure(&types, 19, &arguments)?, 4097, "link_cv_types.sg", 1);
    arguments.push(64);
    arguments.push(65);
    assert_eq_i64(sh_link_cv_type_procedure(&types, 65, &arguments)?, 4099, "link_cv_types.sg", 1);
    assert_eq_i64(sh_link_cv_type_procedure(&types, 65, &arguments)?, 4099, "link_cv_types.sg", 1);
    let input = sh_binary_new(256);
    sh_binary_unsigned(&input, 4, 4)?;
    let mut index = 0;
    while index < sh_binary_len(&types.records) { sh_binary_byte(&input, sh_binary_get(&types.records, index)?)?; index = index + 1; };
    let remapped = sh_link_cv_types_new();
    arguments.clear();
    arguments.push(19);
    assert_eq_i64(sh_link_cv_type_procedure(&remapped, 48, &arguments)?, 4097, "link_cv_types.sg", 1);
    let mapping = sh_link_cv_types_read(&remapped, &input)?;
    assert_eq_i64(mapping.len(), 4, "link_cv_types.sg", 1);
    index = 0;
    while index < mapping.len() { assert_eq_i64(sengoo_vec_get_or_default_i64(mapping.handle, index, -1), 4098 + index, "link_cv_types.sg", 1); index = index + 1; };
    sh_binary_patch(&input, 22, 1, 2)?;
    let bad_count = sh_link_cv_types_read(&remapped, &input);
    assert_eq_i64(bad_count.error, 7321, "link_cv_types.sg", 1);
    sh_binary_patch(&input, 22, 0, 2)?;
    sh_binary_patch(&input, 6, 5381, 2)?;
    let unknown = sh_link_cv_types_read(&remapped, &input);
    assert_eq_i64(unknown.error, 7323, "link_cv_types.sg", 1);
    arguments.clear();
    arguments.push(3);
    assert_eq_i64(sh_link_cv_type_arguments(&types, &arguments).error, 7323, "link_cv_types.sg", 1);
    sh_i64_ok(0);
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let mut round = 0;
    while round < 100 { let scoped = sh_ltt_scope(); if not scoped.is_ok() { println(scoped.error); return 1; }; round = round + 1; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "link_cv_types.sg", 1);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "link_cv_types.sg", 1);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "link_cv_types.sg", 1);
    println("selfhost SG CodeView primitive signature remapping: ok");
    0;
}
