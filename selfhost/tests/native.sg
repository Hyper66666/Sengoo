import selfhost_native;

import std::assert;

import std::args;

import std::file;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def sh_nt_fn(mir: &ShMir, name: &str, args: &Vec<i64>, result: i64, abi: i64, foreign: bool) -> Result<i64, i64> {
    let arguments = vec_new_i64();
    let mut index = 0;
    while index < args.len() { arguments.push(sh_native_at(args, index)); index = index + 1; };
    arguments.push(result);
    let signature = sh_type_intern(&mir.types, 11, abi, 0, -1, &arguments)?;
    let text = string_from_str(name)?;
    sh_mir_add_function(mir, &text, signature, if foreign { 1; } else { 0; }, -1, 0, 0);
}

def sh_nt_block(mir: &ShMir, function: i64, scope: i64) -> Result<i64, i64> {
    sh_mir_add_block(mir, function, scope, 0, -1, 0, 0);
}

def sh_nt_inst(mir: &ShMir, block: i64, opcode: i64, ty: i64, args: &Vec<i64>, aux: i64, extra: i64) -> Result<i64, i64> {
    sh_mir_add_instruction(mir, block, opcode, ty, args, aux, extra, 0, -1, 0, 0);
}

def sh_nt_binary(mir: &ShMir, block: i64, ty: i64, lhs: i64, rhs: i64, operator: &str) -> Result<i64, i64> {
    let args = vec_new_i64();
    args.push(lhs);
    args.push(rhs);
    sh_nt_inst(mir, block, 11, ty, &args, sh_kind(operator), 0);
}

def sh_nt_return(mir: &ShMir, block: i64, value: i64) -> Result<i64, i64> {
    sh_mir_add_terminator(mir, block, 3, value, -1, 0, 0);
}

def sh_nt_binary_function(mir: &ShMir, name: &str, ty: i64, result_type: i64, operator: &str) -> Result<i64, i64> {
    let args = vec_new_i64();
    args.push(ty);
    args.push(ty);
    let function = sh_nt_fn(mir, name, &args, result_type, 0, false)?;
    let scope = sh_mir_add_scope(mir, function, -1, 0)?;
    let block = sh_nt_block(mir, function, scope)?;
    args.clear();
    let lhs = sh_nt_inst(mir, block, 1, ty, &args, 0, 0)?;
    let rhs = sh_nt_inst(mir, block, 1, ty, &args, 1, 0)?;
    let result = sh_nt_binary(mir, block, result_type, lhs, rhs, operator)?;
    sh_nt_return(mir, block, result);
}

def sh_nt_swap(mir: &ShMir, integer: i64, boolean: i64) -> Result<bool, i64> {
    let empty = vec_new_i64();
    let args = vec_new_i64();
    args.push(integer);
    let function = sh_nt_fn(mir, "sg_native_swap", &args, integer, 0, false)?;
    let scope = sh_mir_add_scope(mir, function, -1, 0)?;
    let entry = sh_nt_block(mir, function, scope)?;
    let header = sh_nt_block(mir, function, scope)?;
    let body = sh_nt_block(mir, function, scope)?;
    let exit = sh_nt_block(mir, function, scope)?;
    let x = sh_nt_inst(mir, header, 2, integer, &empty, 0, 0)?;
    let y = sh_nt_inst(mir, header, 2, integer, &empty, 1, 0)?;
    let i = sh_nt_inst(mir, header, 2, integer, &empty, 2, 0)?;
    let n = sh_nt_inst(mir, entry, 1, integer, &empty, 0, 0)?;
    let zero = sh_nt_inst(mir, entry, 4, integer, &empty, 0, 0)?;
    let one = sh_nt_inst(mir, entry, 4, integer, &empty, 1, 0)?;
    let two = sh_nt_inst(mir, entry, 4, integer, &empty, 2, 0)?;
    let ten = sh_nt_inst(mir, entry, 4, integer, &empty, 10, 0)?;
    let begin = sh_mir_add_terminator(mir, entry, 1, -1, -1, 0, 0)?;
    args.clear();
    args.push(one);
    args.push(two);
    args.push(zero);
    sh_mir_add_edge(mir, begin, header, &args, 0, 0)?;
    let condition = sh_nt_binary(mir, header, boolean, i, n, "<")?;
    let branch = sh_mir_add_terminator(mir, header, 2, condition, -1, 0, 0)?;
    sh_mir_add_edge(mir, branch, body, &empty, 0, 0)?;
    sh_mir_add_edge(mir, branch, exit, &empty, 0, 0)?;
    let next = sh_nt_binary(mir, body, integer, i, one, "+")?;
    let back = sh_mir_add_terminator(mir, body, 1, -1, -1, 0, 0)?;
    args.clear();
    args.push(y);
    args.push(x);
    args.push(next);
    sh_mir_add_edge(mir, back, header, &args, 0, 0)?;
    let tens = sh_nt_binary(mir, exit, integer, x, ten, "*")?;
    let result = sh_nt_binary(mir, exit, integer, tens, y, "+")?;
    sh_nt_return(mir, exit, result)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_floats(mir: &ShMir, integer: i64, boolean: i64) -> Result<bool, i64> {
    let f64_type = sh_type_primitive(&mir.types, 3, 64, 0)?;
    let f32_type = sh_type_primitive(&mir.types, 3, 32, 0)?;
    sh_nt_binary_function(mir, "sg_native_fadd", f64_type, f64_type, "+")?;
    sh_nt_binary_function(mir, "sg_native_fsub", f64_type, f64_type, "-")?;
    sh_nt_binary_function(mir, "sg_native_fmul", f64_type, f64_type, "*")?;
    sh_nt_binary_function(mir, "sg_native_fdiv", f64_type, f64_type, "/")?;
    sh_nt_binary_function(mir, "sg_native_f32add", f32_type, f32_type, "+")?;
    sh_nt_binary_function(mir, "sg_native_feq", f64_type, boolean, "==")?;
    sh_nt_binary_function(mir, "sg_native_fne", f64_type, boolean, "!=")?;
    sh_nt_binary_function(mir, "sg_native_flt", f64_type, boolean, "<")?;
    sh_nt_binary_function(mir, "sg_native_fle", f64_type, boolean, "<=")?;
    sh_nt_binary_function(mir, "sg_native_fgt", f64_type, boolean, ">")?;
    sh_nt_binary_function(mir, "sg_native_fge", f64_type, boolean, ">=")?;
    let args = vec_new_i64();
    let empty = vec_new_i64();
    let constant = sh_nt_fn(mir, "sg_native_fconstant", &args, f64_type, 0, false)?;
    let scope = sh_mir_add_scope(mir, constant, -1, 0)?;
    let block = sh_nt_block(mir, constant, scope)?;
    let value = sh_nt_inst(mir, block, 5, f64_type, &empty, 4631107791820423168, 0)?;
    sh_nt_return(mir, block, value)?;
    args.push(integer);
    args.push(f64_type);
    args.push(integer);
    args.push(f32_type);
    args.push(f64_type);
    args.push(integer);
    let external = sh_nt_fn(mir, "sg_native_float_external6", &args, f64_type, 1, true)?;
    let caller = sh_nt_fn(mir, "sg_native_float_call6", &args, f64_type, 0, false)?;
    let caller_scope = sh_mir_add_scope(mir, caller, -1, 0)?;
    let caller_block = sh_nt_block(mir, caller, caller_scope)?;
    let values = vec_new_i64();
    let mut index = 0;
    while index < args.len() { let value = sh_nt_inst(mir, caller_block, 1, sh_native_at(&args, index), &empty, index, 0)?; values.push(value); index = index + 1; };
    let called = sh_nt_inst(mir, caller_block, 20, f64_type, &values, external, 1)?;
    sh_nt_return(mir, caller_block, called)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_cast_function(mir: &ShMir, name: &str, input: i64, target: i64) -> Result<i64, i64> {
    let types = vec_new_i64();
    types.push(input);
    let function = sh_nt_fn(mir, name, &types, target, 0, false)?;
    let scope = sh_mir_add_scope(mir, function, -1, 0)?;
    let block = sh_nt_block(mir, function, scope)?;
    types.clear();
    let parameter = sh_nt_inst(mir, block, 1, input, &types, 0, 0)?;
    types.push(parameter);
    let value = sh_nt_inst(mir, block, 12, target, &types, 0, 0)?;
    sh_nt_return(mir, block, value);
}

def sh_nt_casts(mir: &ShMir, integer: i64) -> Result<bool, i64> {
    let f64_type = sh_type_primitive(&mir.types, 3, 64, 0)?;
    let f32_type = sh_type_primitive(&mir.types, 3, 32, 0)?;
    let unsigned = sh_type_primitive(&mir.types, 2, 64, 0)?;
    let i8_type = sh_type_primitive(&mir.types, 2, 8, 1)?;
    let u8_type = sh_type_primitive(&mir.types, 2, 8, 0)?;
    sh_nt_cast_function(mir, "sg_cast_f64_i64", f64_type, integer)?;
    sh_nt_cast_function(mir, "sg_cast_f64_u64", f64_type, unsigned)?;
    sh_nt_cast_function(mir, "sg_cast_f64_i8", f64_type, i8_type)?;
    sh_nt_cast_function(mir, "sg_cast_f64_u8", f64_type, u8_type)?;
    sh_nt_cast_function(mir, "sg_cast_f32_i64", f32_type, integer)?;
    sh_nt_cast_function(mir, "sg_cast_f32_u64", f32_type, unsigned)?;
    sh_nt_cast_function(mir, "sg_cast_i64_f64", integer, f64_type)?;
    sh_nt_cast_function(mir, "sg_cast_u64_f64", unsigned, f64_type)?;
    sh_nt_cast_function(mir, "sg_cast_u64_f32", unsigned, f32_type)?;
    sh_nt_cast_function(mir, "sg_cast_f64_f32", f64_type, f32_type)?;
    sh_nt_cast_function(mir, "sg_cast_f32_f64", f32_type, f64_type)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_aggregates(mir: &ShMir, integer: i64) -> Result<bool, i64> {
    let types = vec_new_i64();
    types.push(integer);
    types.push(integer);
    let pair = sh_type_intern(&mir.types, 10, 0, 0, -1, &types)?;
    let empty = vec_new_i64();
    let make = sh_nt_fn(mir, "sg_native_pair", &types, pair, 0, false)?;
    let scope = sh_mir_add_scope(mir, make, -1, 0)?;
    let block = sh_nt_block(mir, make, scope)?;
    let a = sh_nt_inst(mir, block, 1, integer, &empty, 0, 0)?;
    let b = sh_nt_inst(mir, block, 1, integer, &empty, 1, 0)?;
    let args = vec_new_i64();
    args.push(a);
    args.push(b);
    let value = sh_nt_inst(mir, block, 16, pair, &args, 0, 0)?;
    sh_nt_return(mir, block, value)?;
    types.clear();
    types.push(pair);
    let sum = sh_nt_fn(mir, "sg_native_pair_sum", &types, integer, 0, false)?;
    let sum_scope = sh_mir_add_scope(mir, sum, -1, 0)?;
    let sum_block = sh_nt_block(mir, sum, sum_scope)?;
    let parameter = sh_nt_inst(mir, sum_block, 1, pair, &empty, 0, 0)?;
    args.clear();
    args.push(parameter);
    let x = sh_nt_inst(mir, sum_block, 18, integer, &args, 0, -1)?;
    let y = sh_nt_inst(mir, sum_block, 18, integer, &args, 1, -1)?;
    let added = sh_nt_binary(mir, sum_block, integer, x, y, "+")?;
    sh_nt_return(mir, sum_block, added)?;
    let external = sh_nt_fn(mir, "sg_native_pair_external", &types, pair, 1, true)?;
    let caller = sh_nt_fn(mir, "sg_native_pair_call", &types, pair, 0, false)?;
    let caller_scope = sh_mir_add_scope(mir, caller, -1, 0)?;
    let caller_block = sh_nt_block(mir, caller, caller_scope)?;
    let input = sh_nt_inst(mir, caller_block, 1, pair, &empty, 0, 0)?;
    args.clear();
    args.push(input);
    let called = sh_nt_inst(mir, caller_block, 20, pair, &args, external, 1)?;
    sh_nt_return(mir, caller_block, called)?;
    types.clear();
    types.push(integer);
    let small = sh_type_intern(&mir.types, 10, 0, 0, -1, &types)?;
    types.clear();
    types.push(small);
    let small_fn = sh_nt_fn(mir, "sg_native_small", &types, small, 0, false)?;
    let small_scope = sh_mir_add_scope(mir, small_fn, -1, 0)?;
    let small_block = sh_nt_block(mir, small_fn, small_scope)?;
    let small_param = sh_nt_inst(mir, small_block, 1, small, &empty, 0, 0)?;
    sh_nt_return(mir, small_block, small_param)?;
    let boolean = sh_type_primitive(&mir.types, 1, 0, 0)?;
    types.clear();
    types.push(boolean);
    types.push(pair);
    types.push(pair);
    let select = sh_nt_fn(mir, "sg_native_pair_select", &types, pair, 0, false)?;
    let select_scope = sh_mir_add_scope(mir, select, -1, 0)?;
    let entry = sh_nt_block(mir, select, select_scope)?;
    let left = sh_nt_block(mir, select, select_scope)?;
    let right = sh_nt_block(mir, select, select_scope)?;
    let join = sh_nt_block(mir, select, select_scope)?;
    let merged = sh_nt_inst(mir, join, 2, pair, &empty, 0, 0)?;
    let condition = sh_nt_inst(mir, entry, 1, boolean, &empty, 0, 0)?;
    let lhs = sh_nt_inst(mir, entry, 1, pair, &empty, 1, 0)?;
    let rhs = sh_nt_inst(mir, entry, 1, pair, &empty, 2, 0)?;
    let branch = sh_mir_add_terminator(mir, entry, 2, condition, -1, 0, 0)?;
    sh_mir_add_edge(mir, branch, left, &empty, 0, 0)?;
    sh_mir_add_edge(mir, branch, right, &empty, 0, 0)?;
    let lterm = sh_mir_add_terminator(mir, left, 1, -1, -1, 0, 0)?;
    args.clear();
    args.push(lhs);
    sh_mir_add_edge(mir, lterm, join, &args, 0, 0)?;
    let rterm = sh_mir_add_terminator(mir, right, 1, -1, -1, 0, 0)?;
    args.clear();
    args.push(rhs);
    sh_mir_add_edge(mir, rterm, join, &args, 0, 0)?;
    sh_nt_return(mir, join, merged)?;
    let byte = sh_type_primitive(&mir.types, 2, 8, 0)?;
    types.clear();
    types.push(byte);
    types.push(byte);
    types.push(byte);
    let odd = sh_type_intern(&mir.types, 10, 0, 0, -1, &types)?;
    types.clear();
    types.push(odd);
    let echo = sh_nt_fn(mir, "sg_native_odd", &types, odd, 0, false)?;
    let echo_scope = sh_mir_add_scope(mir, echo, -1, 0)?;
    let echo_block = sh_nt_block(mir, echo, echo_scope)?;
    let odd_param = sh_nt_inst(mir, echo_block, 1, odd, &empty, 0, 0)?;
    sh_nt_return(mir, echo_block, odd_param)?;
    let enum_name = string_from_str("NativeChoice")?;
    let enum_symbol = sh_intern(&mir.symbols, &enum_name)?;
    let enumeration = sh_type_intern(&mir.types, 12, 1, 0, enum_symbol, &empty)?;
    let offsets = vec_new_i64();
    offsets.push(-1);
    offsets.push(-1);
    types.clear();
    types.push(integer);
    types.push(byte);
    sh_mir_add_layout(mir, enumeration, 1, &types, &offsets, -1, -1, -1)?;
    sh_mir_add_layout(mir, enumeration, 0, &empty, &empty, -1, -1, -1)?;
    let enum_fn = sh_nt_fn(mir, "sg_native_enum", &empty, enumeration, 0, false)?;
    let enum_scope = sh_mir_add_scope(mir, enum_fn, -1, 0)?;
    let enum_block = sh_nt_block(mir, enum_fn, enum_scope)?;
    let payload_x = sh_nt_inst(mir, enum_block, 4, integer, &empty, 42, 0)?;
    let payload_y = sh_nt_inst(mir, enum_block, 4, byte, &empty, 9, 0)?;
    args.clear();
    args.push(payload_x);
    args.push(payload_y);
    let enum_value = sh_nt_inst(mir, enum_block, 24, enumeration, &args, 1, 0)?;
    sh_nt_return(mir, enum_block, enum_value)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_memmove_function(mir: &ShMir, name: &str, element: i64, length: i64, unit: i64) -> Result<i64, i64> {
    let types = vec_new_i64();
    types.push(element);
    let destination_type = sh_type_intern(&mir.types, 7, 0, 1, -1, &types)?;
    let source_type = sh_type_intern(&mir.types, 7, 0, 0, -1, &types)?;
    types.clear();
    types.push(destination_type);
    types.push(source_type);
    types.push(length);
    let function = sh_nt_fn(mir, name, &types, unit, 0, false)?;
    let scope = sh_mir_add_scope(mir, function, -1, 0)?;
    let block = sh_nt_block(mir, function, scope)?;
    let empty = vec_new_i64();
    let destination = sh_nt_inst(mir, block, 1, destination_type, &empty, 0, 0)?;
    let source = sh_nt_inst(mir, block, 1, source_type, &empty, 1, 0)?;
    let count = sh_nt_inst(mir, block, 1, length, &empty, 2, 0)?;
    types.clear();
    types.push(destination);
    types.push(source);
    types.push(count);
    let moved = sh_mir_add_instruction(mir, block, 22, unit, &types, 0, 0, 1, -1, 0, 0)?;
    sh_nt_return(mir, block, moved);
}

def sh_nt_index_function(mir: &ShMir, name: &str, base: i64, element: i64, integer: i64, kind: i64) -> Result<i64, i64> {
    let types = vec_new_i64();
    types.push(base);
    let input = sh_type_intern(&mir.types, kind, 0, 1, -1, &types)?;
    types.clear();
    types.push(element);
    let output = sh_type_intern(&mir.types, kind, 0, 1, -1, &types)?;
    types.clear();
    types.push(input);
    types.push(integer);
    let function = sh_nt_fn(mir, name, &types, output, 0, false)?;
    let scope = sh_mir_add_scope(mir, function, -1, 0)?;
    let block = sh_nt_block(mir, function, scope)?;
    let empty = vec_new_i64();
    let address = sh_nt_inst(mir, block, 1, input, &empty, 0, 0)?;
    let index = sh_nt_inst(mir, block, 1, integer, &empty, 1, 0)?;
    types.clear();
    types.push(address);
    types.push(index);
    let result = sh_nt_inst(mir, block, 19, output, &types, 0, 0)?;
    sh_nt_return(mir, block, result);
}

def sh_nt_memory_ranges(mir: &ShMir, integer: i64, unit: i64) -> Result<bool, i64> {
    let byte = sh_type_primitive(&mir.types, 2, 8, 0)?;
    let length = sh_type_primitive(&mir.types, 2, 64, 0)?;
    let empty = vec_new_i64();
    let name = string_from_str("IndexPair")?;
    let nominal = sh_intern(&mir.symbols, &name)?;
    let pair = sh_type_intern(&mir.types, 12, 0, 0, nominal, &empty)?;
    let fields = vec_new_i64();
    fields.push(integer);
    fields.push(integer);
    let offsets = vec_new_i64();
    offsets.push(-1);
    offsets.push(-1);
    sh_mir_add_layout(mir, pair, -1, &fields, &offsets, -1, -1, -1)?;
    let odd_name = string_from_str("IndexOdd")?;
    let odd_symbol = sh_intern(&mir.symbols, &odd_name)?;
    let odd = sh_type_intern(&mir.types, 12, 0, 0, odd_symbol, &empty)?;
    fields.clear();
    fields.push(byte);
    fields.push(byte);
    fields.push(byte);
    offsets.push(-1);
    sh_mir_add_layout(mir, odd, -1, &fields, &offsets, -1, -1, -1)?;
    sh_nt_memmove_function(mir, "sg_native_memmove_u8", byte, length, unit)?;
    sh_nt_memmove_function(mir, "sg_native_memmove_u64", length, length, unit)?;
    sh_nt_memmove_function(mir, "sg_native_memmove_pair", pair, length, unit)?;
    sh_nt_index_function(mir, "sg_native_index_bytes", byte, byte, integer, 7)?;
    sh_nt_index_function(mir, "sg_native_index_pairs", pair, pair, integer, 7)?;
    sh_nt_index_function(mir, "sg_native_index_odd", odd, odd, integer, 7)?;
    fields.clear();
    fields.push(integer);
    let array = sh_type_intern(&mir.types, 8, 3, 0, -1, &fields)?;
    sh_nt_index_function(mir, "sg_native_index_array", array, integer, integer, 6)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_string_function(mir: &ShMir, name: &str, text: &String, ty: i64) -> Result<i64, i64> {
    let empty = vec_new_i64();
    let function = sh_nt_fn(mir, name, &empty, ty, 0, false)?;
    let scope = sh_mir_add_scope(mir, function, -1, 0)?;
    let block = sh_nt_block(mir, function, scope)?;
    let symbol = sh_intern(&mir.symbols, text)?;
    let value = sh_nt_inst(mir, block, 8, ty, &empty, symbol, 0)?;
    sh_nt_return(mir, block, value);
}

def sh_nt_strings(mir: &ShMir) -> Result<bool, i64> {
    let string_type = sh_type_primitive(&mir.types, 5, 0, 0)?;
    let args = vec_new_i64();
    args.push(string_type);
    let reference = sh_type_intern(&mir.types, 6, 0, 0, -1, &args)?;
    let utf8 = string_from_str("世界 &\n\t\"\\\r😀")?;
    let empty = string_new();
    let nul = string_from_str("A")?;
    nul.push_char('␀')?;
    nul.push_str("B")?;
    sh_nt_string_function(mir, "sg_native_string_utf8", &utf8, reference)?;
    sh_nt_string_function(mir, "sg_native_string_same", &utf8, reference)?;
    sh_nt_string_function(mir, "sg_native_string_empty", &empty, string_type)?;
    sh_nt_string_function(mir, "sg_native_string_nul", &nul, reference)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_cleanup(mir: &ShMir, integer: i64, boolean: i64, unit: i64) -> Result<bool, i64> {
    let name = string_from_str("TestOwner")?;
    let symbol = sh_intern(&mir.symbols, &name)?;
    let empty = vec_new_i64();
    let owner = sh_type_intern(&mir.types, 12, 0, 0, symbol, &empty)?;
    let types = vec_new_i64();
    types.push(owner);
    let reference = sh_type_intern(&mir.types, 6, 0, 1, -1, &types)?;
    types.clear();
    types.push(reference);
    let destructor = sh_nt_fn(mir, "sg_drop_test_owner", &types, unit, 0, true)?;
    types.clear();
    types.push(integer);
    let offsets = vec_new_i64();
    offsets.push(-1);
    sh_mir_add_layout(mir, owner, -1, &types, &offsets, destructor, -1, -1)?;
    types.clear();
    types.push(boolean);
    let function = sh_nt_fn(mir, "sg_native_cleanup", &types, integer, 0, false)?;
    let scope = sh_mir_add_scope(mir, function, -1, 0)?;
    let entry = sh_nt_block(mir, function, scope)?;
    let create = sh_nt_block(mir, function, scope)?;
    let skip = sh_nt_block(mir, function, scope)?;
    let join = sh_nt_block(mir, function, scope)?;
    let local = sh_mir_add_local(mir, function, owner, -1, 0, 3, scope, -1, -1, 0, 0)?;
    let condition = sh_nt_inst(mir, entry, 1, boolean, &empty, 0, 0)?;
    let branch = sh_mir_add_terminator(mir, entry, 2, condition, -1, 0, 0)?;
    sh_mir_add_edge(mir, branch, create, &empty, 0, 0)?;
    sh_mir_add_edge(mir, branch, skip, &empty, 0, 0)?;
    let value = sh_nt_inst(mir, create, 4, integer, &empty, 42, 0)?;
    let args = vec_new_i64();
    args.push(value);
    let aggregate = sh_nt_inst(mir, create, 16, owner, &args, 0, 0)?;
    let pointer = sh_nt_inst(mir, create, 13, reference, &empty, local, 0)?;
    args.clear();
    args.push(pointer);
    args.push(aggregate);
    sh_nt_inst(mir, create, 15, unit, &args, 0, 0)?;
    sh_nt_inst(mir, create, 25, unit, &empty, local, 1)?;
    let created = sh_mir_add_terminator(mir, create, 1, -1, -1, 0, 0)?;
    sh_mir_add_edge(mir, created, join, &empty, 0, 0)?;
    let skipped = sh_mir_add_terminator(mir, skip, 1, -1, -1, 0, 0)?;
    sh_mir_add_edge(mir, skipped, join, &empty, 0, 0)?;
    let root = sh_nt_inst(mir, join, 13, reference, &empty, local, 0)?;
    args.clear();
    args.push(root);
    sh_mir_add_instruction(mir, join, 21, unit, &args, local, owner, 1, -1, 0, 0)?;
    let result = sh_nt_inst(mir, join, 4, integer, &empty, 42, 0)?;
    sh_nt_return(mir, join, result)?;
    types.clear();
    types.push(owner);
    types.push(owner);
    let pair = sh_type_intern(&mir.types, 10, 0, 0, -1, &types)?;
    types.clear();
    types.push(owner);
    let array = sh_type_intern(&mir.types, 8, 2, 0, -1, &types)?;
    let mut variant = 0;
    while variant < 2 { let nested = if variant == 0 { pair; } else { array; }; let nested_fn = sh_nt_fn(mir, if variant == 0 { "sg_native_nested_cleanup"; } else { "sg_native_array_cleanup"; }, &empty, integer, 0, false)?; let nested_scope = sh_mir_add_scope(mir, nested_fn, -1, 0)?; let nested_block = sh_nt_block(mir, nested_fn, nested_scope)?; let first_value = sh_nt_inst(mir, nested_block, 4, integer, &empty, 1, 0)?; let second_value = sh_nt_inst(mir, nested_block, 4, integer, &empty, 2, 0)?; args.clear(); args.push(first_value); let first_owner = sh_nt_inst(mir, nested_block, 16, owner, &args, 0, 0)?; args.clear(); args.push(second_value); let second_owner = sh_nt_inst(mir, nested_block, 16, owner, &args, 0, 0)?; args.clear(); args.push(first_owner); args.push(second_owner); let nested_value = sh_nt_inst(mir, nested_block, 16, nested, &args, 0, 0)?; sh_nt_owned_finish(mir, nested_fn, nested_scope, nested_block, nested, nested_value, integer, unit)?; variant = variant + 1; };
    let enum_name = string_from_str("DropChoice")?;
    let enum_symbol = sh_intern(&mir.symbols, &enum_name)?;
    let choice = sh_type_intern(&mir.types, 12, 1, 0, enum_symbol, &empty)?;
    types.clear();
    types.push(owner);
    sh_mir_add_layout(mir, choice, 1, &types, &offsets, -1, -1, -1)?;
    sh_mir_add_layout(mir, choice, 0, &empty, &empty, -1, -1, -1)?;
    types.clear();
    types.push(choice);
    let enum_fn = sh_nt_fn(mir, "sg_native_enum_cleanup", &types, integer, 0, false)?;
    let enum_scope = sh_mir_add_scope(mir, enum_fn, -1, 0)?;
    let enum_block = sh_nt_block(mir, enum_fn, enum_scope)?;
    let enum_value = sh_nt_inst(mir, enum_block, 1, choice, &empty, 0, 0)?;
    sh_nt_owned_finish(mir, enum_fn, enum_scope, enum_block, choice, enum_value, integer, unit)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_owned_finish(mir: &ShMir, function: i64, scope: i64, block: i64, ty: i64, value: i64, integer: i64, unit: i64) -> Result<i64, i64> {
    let empty = vec_new_i64();
    let types = vec_new_i64();
    types.push(ty);
    let reference = sh_type_intern(&mir.types, 6, 0, 1, -1, &types)?;
    let local = sh_mir_add_local(mir, function, ty, -1, 0, 3, scope, -1, -1, 0, 0)?;
    let pointer = sh_nt_inst(mir, block, 13, reference, &empty, local, 0)?;
    let args = vec_new_i64();
    args.push(pointer);
    args.push(value);
    sh_nt_inst(mir, block, 15, unit, &args, 0, 0)?;
    sh_nt_inst(mir, block, 25, unit, &empty, local, 1)?;
    args.pop();
    sh_mir_add_instruction(mir, block, 21, unit, &args, local, ty, 0, -1, 0, 0)?;
    sh_mir_add_instruction(mir, block, 21, unit, &args, local, ty, 1, -1, 0, 0)?;
    let result = sh_nt_inst(mir, block, 4, integer, &empty, 42, 0)?;
    sh_nt_return(mir, block, result);
}

def sh_nt_fixture(mir: &ShMir) -> Result<bool, i64> {
    let integer = sh_type_primitive(&mir.types, 2, 64, 1)?;
    let boolean = sh_type_primitive(&mir.types, 1, 0, 0)?;
    let unit = sh_type_primitive(&mir.types, 0, 0, 0)?;
    let empty = vec_new_i64();
    let args = vec_new_i64();
    args.push(integer);
    args.push(integer);
    let add = sh_nt_fn(mir, "sg_native_add", &args, integer, 0, false)?;
    let scope = sh_mir_add_scope(mir, add, -1, 0)?;
    let block = sh_nt_block(mir, add, scope)?;
    let lhs = sh_nt_inst(mir, block, 1, integer, &empty, 0, 0)?;
    let rhs = sh_nt_inst(mir, block, 1, integer, &empty, 1, 0)?;
    let sum = sh_nt_binary(mir, block, integer, lhs, rhs, "+")?;
    sh_nt_return(mir, block, sum)?;
    args.clear();
    let mut index = 0;
    while index < 6 { args.push(integer); index = index + 1; };
    let external = sh_nt_fn(mir, "sg_native_external6", &args, integer, 1, true)?;
    args.clear();
    args.push(integer);
    let caller = sh_nt_fn(mir, "sg_native_call6", &args, integer, 0, false)?;
    let call_scope = sh_mir_add_scope(mir, caller, -1, 0)?;
    let call_block = sh_nt_block(mir, caller, call_scope)?;
    let last = sh_nt_inst(mir, call_block, 1, integer, &empty, 0, 0)?;
    args.clear();
    index = 1;
    while index < 6 { let value = sh_nt_inst(mir, call_block, 4, integer, &empty, index, 0)?; args.push(value); index = index + 1; };
    args.push(last);
    let called = sh_nt_inst(mir, call_block, 20, integer, &args, external, 1)?;
    sh_nt_return(mir, call_block, called)?;
    args.clear();
    args.push(integer);
    let looping = sh_nt_fn(mir, "sg_native_loop", &args, integer, 0, false)?;
    let loop_scope = sh_mir_add_scope(mir, looping, -1, 0)?;
    let entry = sh_nt_block(mir, looping, loop_scope)?;
    let header = sh_nt_block(mir, looping, loop_scope)?;
    let body = sh_nt_block(mir, looping, loop_scope)?;
    let exit = sh_nt_block(mir, looping, loop_scope)?;
    let induction = sh_nt_inst(mir, header, 2, integer, &empty, 0, 0)?;
    let total = sh_nt_inst(mir, header, 2, integer, &empty, 1, 0)?;
    let n = sh_nt_inst(mir, entry, 1, integer, &empty, 0, 0)?;
    let zero = sh_nt_inst(mir, entry, 4, integer, &empty, 0, 0)?;
    let one = sh_nt_inst(mir, entry, 4, integer, &empty, 1, 0)?;
    let begin = sh_mir_add_terminator(mir, entry, 1, -1, -1, 0, 0)?;
    args.clear();
    args.push(zero);
    args.push(zero);
    sh_mir_add_edge(mir, begin, header, &args, 0, 0)?;
    let condition = sh_nt_binary(mir, header, boolean, induction, n, "<")?;
    let branch = sh_mir_add_terminator(mir, header, 2, condition, -1, 0, 0)?;
    sh_mir_add_edge(mir, branch, body, &empty, 0, 0)?;
    sh_mir_add_edge(mir, branch, exit, &empty, 0, 0)?;
    let advanced = sh_nt_binary(mir, body, integer, induction, one, "+")?;
    let accumulated = sh_nt_binary(mir, body, integer, total, induction, "+")?;
    let back = sh_mir_add_terminator(mir, body, 1, -1, -1, 0, 0)?;
    args.clear();
    args.push(advanced);
    args.push(accumulated);
    sh_mir_add_edge(mir, back, header, &args, 0, 0)?;
    sh_nt_return(mir, exit, total)?;
    args.clear();
    args.push(integer);
    args.push(integer);
    args.push(integer);
    let c_signature = sh_type_intern(&mir.types, 11, 1, 0, -1, &args)?;
    args.clear();
    args.push(c_signature);
    args.push(integer);
    args.push(integer);
    let indirect = sh_nt_fn(mir, "sg_native_indirect", &args, integer, 0, false)?;
    let indirect_scope = sh_mir_add_scope(mir, indirect, -1, 0)?;
    let indirect_block = sh_nt_block(mir, indirect, indirect_scope)?;
    let callee = sh_nt_inst(mir, indirect_block, 1, c_signature, &empty, 0, 0)?;
    let a = sh_nt_inst(mir, indirect_block, 1, integer, &empty, 1, 0)?;
    let b = sh_nt_inst(mir, indirect_block, 1, integer, &empty, 2, 0)?;
    args.clear();
    args.push(callee);
    args.push(a);
    args.push(b);
    let indirect_value = sh_nt_inst(mir, indirect_block, 20, integer, &args, -1, 1)?;
    sh_nt_return(mir, indirect_block, indirect_value)?;
    args.clear();
    let address = sh_nt_fn(mir, "sg_native_address", &args, sh_mir_fn(mir, add, 1), 0, false)?;
    let address_scope = sh_mir_add_scope(mir, address, -1, 0)?;
    let address_block = sh_nt_block(mir, address, address_scope)?;
    let function_pointer = sh_nt_inst(mir, address_block, 9, sh_mir_fn(mir, add, 1), &empty, add, 0)?;
    sh_nt_return(mir, address_block, function_pointer)?;
    let byte = sh_type_primitive(&mir.types, 2, 8, 1)?;
    args.clear();
    args.push(byte);
    let pointer = sh_type_intern(&mir.types, 7, 0, 1, -1, &args)?;
    args.clear();
    args.push(pointer);
    let memory = sh_nt_fn(mir, "sg_native_memory", &args, integer, 0, false)?;
    let memory_scope = sh_mir_add_scope(mir, memory, -1, 0)?;
    let memory_block = sh_nt_block(mir, memory, memory_scope)?;
    let p = sh_nt_inst(mir, memory_block, 1, pointer, &empty, 0, 0)?;
    args.clear();
    args.push(p);
    let loaded = sh_nt_inst(mir, memory_block, 14, byte, &args, 0, 0)?;
    let increment = sh_nt_inst(mir, memory_block, 4, byte, &empty, 1, 0)?;
    let updated = sh_nt_binary(mir, memory_block, byte, loaded, increment, "+")?;
    args.clear();
    args.push(p);
    args.push(updated);
    sh_nt_inst(mir, memory_block, 15, unit, &args, 0, 0)?;
    args.clear();
    args.push(updated);
    let widened = sh_nt_inst(mir, memory_block, 12, integer, &args, 0, 0)?;
    sh_nt_return(mir, memory_block, widened)?;
    let short = sh_type_primitive(&mir.types, 2, 16, 1)?;
    args.clear();
    args.push(short);
    let short_ref = sh_type_intern(&mir.types, 6, 0, 1, -1, &args)?;
    args.clear();
    let local_fn = sh_nt_fn(mir, "sg_native_local", &args, integer, 0, false)?;
    let local_scope = sh_mir_add_scope(mir, local_fn, -1, 0)?;
    let local_block = sh_nt_block(mir, local_fn, local_scope)?;
    let local = sh_mir_add_local(mir, local_fn, short, -1, 0, 1, local_scope, -1, -1, 0, 0)?;
    let local_pointer = sh_nt_inst(mir, local_block, 13, short_ref, &empty, local, 0)?;
    let local_value = sh_nt_inst(mir, local_block, 4, short, &empty, -123, 0)?;
    args.clear();
    args.push(local_pointer);
    args.push(local_value);
    sh_nt_inst(mir, local_block, 15, unit, &args, 0, 0)?;
    sh_nt_inst(mir, local_block, 25, unit, &empty, local, 1)?;
    args.clear();
    args.push(local_pointer);
    let local_read = sh_nt_inst(mir, local_block, 14, short, &args, 0, 0)?;
    args.clear();
    args.push(local_read);
    let local_result = sh_nt_inst(mir, local_block, 12, integer, &args, 0, 0)?;
    sh_nt_return(mir, local_block, local_result)?;
    sh_nt_swap(mir, integer, boolean)?;
    sh_nt_binary_function(mir, "sg_native_mul", integer, integer, "*")?;
    sh_nt_binary_function(mir, "sg_native_sub", integer, integer, "-")?;
    sh_nt_binary_function(mir, "sg_native_div", integer, integer, "/")?;
    sh_nt_binary_function(mir, "sg_native_rem", integer, integer, "%")?;
    sh_nt_binary_function(mir, "sg_native_shift", integer, integer, ">>")?;
    sh_nt_binary_function(mir, "sg_native_less", integer, boolean, "<")?;
    let unsigned = sh_type_primitive(&mir.types, 2, 64, 0)?;
    sh_nt_binary_function(mir, "sg_native_uadd", unsigned, unsigned, "+")?;
    sh_nt_binary_function(mir, "sg_native_umul", unsigned, unsigned, "*")?;
    sh_nt_binary_function(mir, "sg_native_udiv", unsigned, unsigned, "/")?;
    sh_nt_binary_function(mir, "sg_native_urem", unsigned, unsigned, "%")?;
    args.clear();
    index = 0;
    while index < 6 { args.push(integer); index = index + 1; };
    let large = sh_nt_fn(mir, "sg_native_large", &args, integer, 0, false)?;
    let large_scope = sh_mir_add_scope(mir, large, -1, 0)?;
    let large_block = sh_nt_block(mir, large, large_scope)?;
    let mut last_local = -1;
    index = 0;
    while index < 600 { last_local = sh_mir_add_local(mir, large, integer, -1, 2, 1, large_scope, -1, -1, 0, 0)?; index = index + 1; };
    args.clear();
    let mut total_value = -1;
    index = 0;
    while index < 6 { let parameter = sh_nt_inst(mir, large_block, 1, integer, &empty, index, 0)?; total_value = if total_value < 0 { parameter; } else { sh_nt_binary(mir, large_block, integer, total_value, parameter, "+")?; }; index = index + 1; };
    let constant = sh_nt_inst(mir, large_block, 4, integer, &empty, 21, 0)?;
    let total_result = sh_nt_binary(mir, large_block, integer, total_value, constant, "+")?;
    args.push(integer);
    let local_ptr_type = sh_type_intern(&mir.types, 6, 0, 1, -1, &args)?;
    let ptr = sh_nt_inst(mir, large_block, 13, local_ptr_type, &empty, last_local, 0)?;
    args.clear();
    args.push(ptr);
    args.push(total_result);
    sh_nt_inst(mir, large_block, 15, unit, &args, 0, 0)?;
    args.clear();
    args.push(ptr);
    let restored = sh_nt_inst(mir, large_block, 14, integer, &args, 0, 0)?;
    sh_nt_return(mir, large_block, restored)?;
    sh_nt_floats(mir, integer, boolean)?;
    sh_nt_casts(mir, integer)?;
    sh_nt_aggregates(mir, integer)?;
    sh_nt_cleanup(mir, integer, boolean, unit)?;
    sh_nt_memory_ranges(mir, integer, unit)?;
    sh_nt_strings(mir)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_test_native() -> Result<bool, i64> {
    let short_move = sh_binary_new(20);
    sh_binary_byte(&short_move, 42)?;
    assert_eq_i64(sh_x64_memmove(&short_move).error, 6001, "native.sg", 1151);
    assert_eq_i64(sh_binary_len(&short_move), 1, "native.sg", 1152);
    assert_eq_i64(sh_binary_get(&short_move, 0)?, 42, "native.sg", 1153);
    let unwind = sh_binary_new(32);
    assert_eq_i64(sh_unwind_fixed(&unwind, 128, 11)?, 0, "native.sg", 165);
    assert_true(sh_unwind_fixed(&unwind, 144, 11)? > 0, "native.sg", 165);
    assert_true(sh_unwind_fixed(&unwind, 524288, 22)? > 0, "native.sg", 165);
    assert_eq_i64(sh_unwind_fixed(&unwind, 17, 11).error, 6601, "native.sg", 165);
    assert_eq_i64(sh_unwind_fixed(&unwind, 16, 0).error, 6601, "native.sg", 165);
    let truncated = sh_binary_new(7);
    assert_eq_i64(sh_unwind_fixed(&truncated, 16, 11).error, 6001, "native.sg", 165);
    assert_eq_i64(sh_binary_len(&truncated), 0, "native.sg", 165);
    sh_binary_byte(&truncated, 1)?;
    assert_eq_i64(sh_unwind_fixed(&truncated, 16, 11).error, 6601, "native.sg", 165);
    assert_eq_i64(sh_binary_len(&truncated), 1, "native.sg", 165);
    let probe = sh_binary_new(64);
    assert_eq_i64(sh_x64_probe_stack(&probe, 4096).error, 6101, "native.sg", 165);
    assert_eq_i64(sh_x64_probe_stack(&probe, 4112)?, 0, "native.sg", 165);
    assert_true(sh_binary_len(&probe) > 0, "native.sg", 165);
    let mir = sh_mir_new(2000);
    sh_nt_fixture(&mir)?;
    assert_eq_i64(sh_mir_validate(&mir).error, 0, "native.sg", 168);
    let checked = sh_native_object(&mir, 65536, true)?;
    let repeated = sh_native_object(&mir, 65536, true)?;
    assert_eq_i64(sh_binary_len(&checked), sh_binary_len(&repeated), "native.sg", 171);
    let mut index = 0;
    while index < sh_binary_len(&checked) { assert_eq_i64(sh_binary_get(&checked, index)?, sh_binary_get(&repeated, index)?, "native.sg", 173); index = index + 1; };
    let small = sh_native_object(&mir, 8, true);
    assert_eq_i64(small.error, 6001, "native.sg", 175);
    mir.instructions.set(26, 999);
    let malformed = sh_native_object(&mir, 65536, true);
    assert_eq_i64(malformed.error, 5003, "native.sg", 178);
    mir.instructions.set(26, 11);
    let mut local = 0;
    while local < 500 { sh_mir_add_local(&mir, 0, sh_mir_type_arg(&mir, sh_mir_fn(&mir, 0, 1), 0), -1, 2, 1, 0, -1, -1, 0, 0)?; local = local + 1; };
    let large = sh_native_object(&mir, 65536, true);
    assert_eq_i64(large.error, 0, "native.sg", 184);
    let unsupported_mir = sh_mir_new(20);
    let floating = sh_type_primitive(&unsupported_mir.types, 3, 64, 0)?;
    let empty = vec_new_i64();
    let function = sh_nt_fn(&unsupported_mir, "unsupported_float", &empty, floating, 0, false)?;
    let scope = sh_mir_add_scope(&unsupported_mir, function, -1, 0)?;
    let block = sh_nt_block(&unsupported_mir, function, scope)?;
    let literal_text = string_from_str("invalid")?;
    let literal = sh_intern(&unsupported_mir.symbols, &literal_text)?;
    let value = sh_mir_add_instruction(&unsupported_mir, block, 5, floating, &empty, literal, 0, 1, -1, 0, 0)?;
    sh_nt_return(&unsupported_mir, block, value)?;
    let unsupported = sh_native_object(&unsupported_mir, 65536, true);
    assert_eq_i64(unsupported.error, 6801, "native.sg", 185);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_emit() -> Result<bool, i64> {
    let path_bytes = ffi_buffer_new(arg_len(0).unwrap_or(0))?;
    let copied = arg_copy(0, path_bytes)?;
    let path = string_from_utf8(path_bytes, copied)?;
    let mir = sh_mir_new(2000);
    sh_nt_fixture(&mir)?;
    let object = sh_native_object(&mir, 65536, args_len() == 1)?;
    let buffer = sh_binary_buffer(&object)?;
    file_write_str_raw(sengoo_stdlib_str_ptr(path.as_str()), buffer.ptr(), buffer.used_len())?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_nt_pending() -> Result<bool, i64> {
    let mir = sh_mir_new(100);
    let integer = sh_type_primitive(&mir.types, 2, 64, 1)?;
    let unit = sh_type_primitive(&mir.types, 0, 0, 0)?;
    let text = string_from_str("PendingOwner")?;
    let symbol = sh_intern(&mir.symbols, &text)?;
    let empty = vec_new_i64();
    let ty = sh_type_intern(&mir.types, 12, 0, 0, symbol, &empty)?;
    let fields = vec_new_i64();
    fields.push(integer);
    let offsets = vec_new_i64();
    offsets.push(-1);
    sh_mir_add_layout(&mir, ty, -1, &fields, &offsets, -2, -1, -1)?;
    mir.drop_glues.push(ty);
    mir.drop_glues.push(4);
    mir.drop_glues.push(-1);
    let function = sh_nt_fn(&mir, "pending_cleanup", &empty, integer, 0, false)?;
    let scope = sh_mir_add_scope(&mir, function, -1, 0)?;
    let block = sh_nt_block(&mir, function, scope)?;
    let value = sh_nt_inst(&mir, block, 4, integer, &empty, 0, 0)?;
    fields.clear();
    fields.push(value);
    let aggregate = sh_nt_inst(&mir, block, 16, ty, &fields, 0, 0)?;
    sh_nt_owned_finish(&mir, function, scope, block, ty, aggregate, integer, unit)?;
    let emitted = sh_native_object(&mir, 65536, true);
    assert_eq_i64(emitted.error, 6502, "native.sg", 1110);
    let reference_args = vec_new_i64();
    reference_args.push(ty);
    let reference = sh_type_intern(&mir.types, 6, 0, 1, -1, &reference_args)?;
    reference_args.clear();
    reference_args.push(reference);
    let destructor = sh_nt_fn(&mir, "delegating_drop", &reference_args, unit, 0, false)?;
    let drop_scope = sh_mir_add_scope(&mir, destructor, -1, 0)?;
    let drop_block = sh_nt_block(&mir, destructor, drop_scope)?;
    let receiver = sh_nt_inst(&mir, drop_block, 1, reference, &empty, 0, 0)?;
    reference_args.clear();
    reference_args.push(receiver);
    let delegated = sh_nt_inst(&mir, drop_block, 20, unit, &reference_args, destructor, 0)?;
    sh_nt_return(&mir, drop_block, delegated)?;
    mir.layouts.set(4, destructor);
    mir.drop_glues.set(1, 1);
    mir.drop_glues.set(2, destructor);
    assert_eq_i64(sh_mir_validate(&mir).error, 5007, "native.sg", 1128);
    let unsafe_cleanup = sh_native_object(&mir, 65536, true);
    assert_eq_i64(unsafe_cleanup.error, 5007, "native.sg", 1130);
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    if args_len() > 0 { let emitted = sh_nt_emit(); if not emitted.is_ok() { println(emitted.error); return 1; }; return 0; };
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let mut round = 0;
    while round < 10 { let result = sh_test_native(); if not result.is_ok() { println(result.error); return 1; }; let pending = sh_nt_pending(); if not pending.is_ok() { println(pending.error); return 1; }; round = round + 1; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "native.sg", 210);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "native.sg", 211);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "native.sg", 212);
    println("selfhost scalar MIR native objects: ok");
    0;
}
