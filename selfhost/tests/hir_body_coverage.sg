import selfhost_hir;

import selfhost_semantic_collection_borrow;

import std::args;

import std::assert;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_handle_count() -> i64;
    fn sengoo_file_snapshot_live_bytes() -> i64;
}

def hb_arg(i: i64) -> Result<String, i64> {
    let b = ffi_buffer_new(arg_len(i)?)?;
    let n = arg_copy(i, b)?;
    string_from_utf8(b, n);
}

def hb_small() -> Result<bool, i64> {
    let text = string_from_str("trait Deferred{def hidden(&self)->i64{unresolved_default()}} def identity(value:i64)->i64{value} def main()->i64{identity(42)}")?;
    let parsed = sh_parse(&text, 0, 1000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "hb", 1);
    let hir = sh_hir_lift(&text, &parsed.ast, &checked, 1000);
    assert_eq_i64(hir.error, 0, "hb", 2);
    let map = sh_hir_deferred_body_map(&hir);
    assert_true(map.is_ok(), "hb", 3);
    let mut deferred = -1;
    let mut ordinary = -1;
    let mut node = 0;
    while node < sh_ast_count(&hir.ast) { if sh_ast_word(&hir.ast, node, 0) == 53 { if map.value.get(node).unwrap_or(-1) >= 0 { deferred = node; } else { ordinary = node; }; }; node = node + 1; };
    assert_true(deferred >= 0 and ordinary >= 0, "hb", 4);
    let function = map.value.get(deferred).unwrap_or(-1);
    assert_eq_i64(sh_hir_function_body_state(&hir.ast, &hir.checked, function), 2, "hb", 5);
    assert_eq_i64(sh_hir_function_body_state(&hir.ast, &hir.checked, sh_node_binding(&hir.checked, sh_ast_child(&hir.ast, ordinary, 0))), 1, "hb", 6);
    assert_eq_i64(sh_hir_function_body_state(&hir.ast, &hir.checked, -1), -1, "hb", 7);
    let words = sh_cb_words(&hir.checked.types.words);
    let arguments = sh_cb_words(&hir.checked.types.arguments);
    let original_callable = sh_node_callable_type(&hir.checked, ordinary);
    hir.checked.call_types.set(ordinary, -1);
    assert_eq_i64(sh_hir_validate(&hir), 5503, "hb", 8);
    hir.checked.call_types.set(ordinary, original_callable);
    hir.checked.call_types.set(deferred, original_callable);
    assert_eq_i64(sh_hir_validate(&hir), 5503, "hb", 9);
    hir.checked.call_types.set(deferred, -1);
    hir.checked.node_types.set(deferred, sh_type_count(&hir.checked.types));
    assert_eq_i64(sh_hir_validate(&hir), 5503, "hb", 10);
    hir.checked.node_types.set(deferred, -1);
    let owner = sh_binding_word(&hir.checked, function, 6);
    hir.checked.bindings.set(function * 8 + 6, -1);
    assert_true(sh_hir_validate(&hir) != 0, "hb", 11);
    hir.checked.bindings.set(function * 8 + 6, owner);
    let declaration = sh_binding_word(&hir.checked, function, 4);
    let trait_declaration = sh_binding_word(&hir.checked, owner, 4);
    let first = sh_ast_word(&hir.ast, trait_declaration, 5);
    let count = sh_ast_word(&hir.ast, trait_declaration, 6);
    let mut edge = 0;
    while edge < count and sh_ast_child(&hir.ast, trait_declaration, edge) != declaration { edge = edge + 1; };
    assert_true(edge < count, "hb", 12);
    hir.ast.edges.set(first + edge, sh_ast_child(&hir.ast, deferred, 0));
    assert_true(sh_hir_validate(&hir) != 0, "hb", 13);
    hir.ast.edges.set(first + edge, declaration);
    assert_eq_i64(sh_hir_validate(&hir), 0, "hb", 14);
    let root_edge = sh_ast_word(&hir.ast, hir.ast.root, 5);
    let root_arity = sh_ast_word(&hir.ast, hir.ast.root, 6);
    let mut root_index = 0;
    while root_index < root_arity and sh_ast_word(&hir.ast, sh_ast_child(&hir.ast, hir.ast.root, root_index), 0) != 20 { root_index = root_index + 1; };
    assert_true(root_index < root_arity, "hb", 23);
    let original_root_child = sh_ast_child(&hir.ast, hir.ast.root, root_index);
    hir.ast.edges.set(root_edge + root_index, declaration);
    assert_eq_i64(sh_hir_validate(&hir), 5504, "hb", 24);
    hir.ast.edges.set(root_edge + root_index, original_root_child);
    assert_eq_i64(sh_hir_validate(&hir), 0, "hb", 25);
    let image = sh_hir_encode(&hir, 4000000);
    assert_eq_i64(image.error, 0, "hb", 15);
    let decoded = sh_hir_decode(&image.words, 4000000);
    assert_eq_i64(decoded.error, 0, "hb", 16);
    assert_true(sh_hir_checked_equal(&hir.checked, &decoded.checked) and sh_hir_ownership_equal(&hir.ownership, &decoded.ownership), "hb", 17);
    let clone = sh_hir_clone(&hir, 4000000);
    assert_eq_i64(sh_hir_validate(&clone), 0, "hb", 18);
    assert_true(sh_hir_checked_equal(&hir.checked, &clone.checked), "hb", 19);
    let oldschema = image.words.get(1).unwrap_or(-1);
    assert_eq_i64(oldschema, 6, "hb", 20);
    image.words.set(1, 5);
    let old = sh_hir_decode(&image.words, 4000000);
    assert_eq_i64(old.error, 5502, "hb", 21);
    assert_true(sh_o_equal(&words, &hir.checked.types.words) and sh_o_equal(&arguments, &hir.checked.types.arguments), "hb", 22);
    result_ok_bool(true);
}

def hb_full(root: &String, mp: &String, ap: &String, source: &String) -> Result<bool, i64> {
    let manifest = path_join_string(root.as_str(), "selfhost/sdk/collections_x64_abi1/manifest.json")?;
    let stdlib = path_join_string(root.as_str(), "tools/stdlib")?;
    let prelude = path_join_string(root.as_str(), "selfhost/sdk/collections_x64_abi1/prelude.sg")?;
    let collection = path_join_string(root.as_str(), "tools/stdlib/collections.sg")?;
    let option = path_join_string(root.as_str(), "tools/stdlib/option.sg")?;
    let cs = file_snapshot_open(collection.as_str(), 1048576)?;
    let ci = cs.identity()?;
    let ch = cs.sha256()?;
    let os = file_snapshot_open(option.as_str(), 1048576)?;
    let oi = os.identity()?;
    let oh = os.sha256()?;
    let provider = sh_collection_provider_load(root.as_str(), manifest.as_str(), mp.as_str(), ap.as_str(), "x86_64-pc-windows-msvc", 1, true);
    assert_eq_i64(provider.error, 0, "collection_borrow.sg", 6);
    let config = string_from_str("collection_runtime=")?;
    config.push_str(prelude.as_str())?;
    let graph = sh_modules_load(source.as_str(), stdlib.as_str(), &config, 64, 1048576);
    assert_eq_i64(graph.error, 0, "collection_borrow.sg", 7);
    let analyzed = sh_modules_check(&graph, 100000, 1000);
    if analyzed.error != 0 { println(analyzed.error); println(analyzed.start); };
    assert_eq_i64(analyzed.error, 0, "collection_borrow.sg", 8);
    let prefix_words = sh_cb_words(&analyzed.checked.types.words);
    let prefix_arguments = sh_cb_words(&analyzed.checked.types.arguments);
    if true { let capped = sh_collection_ownership_finalize(&analyzed.checked, &analyzed.front.parsed.ast, sh_type_count(&analyzed.checked.types) - 1, 1000000); assert_eq_i64(capped.error, 6123, "collection_borrow.sg", 9); let zero_budget = sh_collection_ownership_finalize(&analyzed.checked, &analyzed.front.parsed.ast, 100000, 0); assert_eq_i64(zero_budget.error, 6123, "collection_borrow.sg", 10); (); };
    let prepared = sh_collection_ownership_finalize(&analyzed.checked, &analyzed.front.parsed.ast, 100000, 1000000);
    assert_eq_i64(prepared.error, 0, "collection_borrow.sg", 11);
    assert_true(prepared.after_types >= prepared.before_types, "collection_borrow.sg", 12);
    let mut prefix = 0;
    while prefix < prefix_words.len() { assert_eq_i64(sh_origin_at(&prefix_words, prefix), sh_origin_at(&analyzed.checked.types.words, prefix), "collection_borrow.sg", 13); prefix = prefix + 1; };
    prefix = 0;
    while prefix < prefix_arguments.len() { assert_eq_i64(sh_origin_at(&prefix_arguments, prefix), sh_origin_at(&analyzed.checked.types.arguments, prefix), "collection_borrow.sg", 14); prefix = prefix + 1; };
    let idempotent = sh_collection_ownership_finalize(&analyzed.checked, &analyzed.front.parsed.ast, 100000, 1000000);
    assert_eq_i64(idempotent.error, 0, "collection_borrow.sg", 15);
    assert_eq_i64(idempotent.before_types, idempotent.after_types, "collection_borrow.sg", 16);
    assert_true(sh_o_equal(&prepared.fields, &idempotent.fields) and sh_o_equal(&prepared.reachable_types, &idempotent.reachable_types), "collection_borrow.sg", 17);
    let frozen_words = sh_cb_words(&analyzed.checked.types.words);
    let frozen_arguments = sh_cb_words(&analyzed.checked.types.arguments);
    let mapping = sh_collection_provider_map(&provider, root.as_str(), &graph, &analyzed, mp.as_str(), ap.as_str(), ci.as_str(), ch.as_str(), "x86_64-pc-windows-msvc", 1, true);
    assert_eq_i64(mapping.error, 0, "collection_borrow.sg", 18);
    let proto = "fn sengoo_raw_vec_iter_new(handle: i64) -> i64;";
    let origins = sh_origins_analyze(&graph, &analyzed, ci.as_str(), ch.as_str(), proto, 100000);
    assert_eq_i64(origins.error, 0, "collection_borrow.sg", 19);
    let loans = sh_loans_analyze(&origins, &graph, &analyzed, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str(), 100000, 1);
    assert_eq_i64(loans.error, 0, "collection_borrow.sg", 20);
    let nll = sh_loan_liveness(&origins, &loans, &graph, &analyzed, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str(), 20000);
    assert_eq_i64(nll.error, 0, "collection_borrow.sg", 21);
    let mut handles = sh_collection_handles(&provider, &mapping, root.as_str(), mp.as_str(), ap.as_str(), &origins, &loans, &nll, &graph, &analyzed, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str(), 100000, true);
    assert_eq_i64(handles.error, 0, "collection_borrow.sg", 22);
    let requested = vec_new_i64();
    let selected = sh_o_unique(&analyzed, graph.root, "construct", 2);
    assert_true(selected >= 0, "hbfull", 1);
    requested.push(selected);
    let scoped = sh_check_ownership_collection_functions(&provider, &mapping, root.as_str(), mp.as_str(), ap.as_str(), &origins, &loans, &nll, &handles, &graph, &analyzed, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str(), &requested, 10000, true);
    assert_eq_i64(scoped.error, 0, "hbfull", 2);
    assert_eq_i64(sh_collection_ownership_validate(&scoped, &provider, &mapping, root.as_str(), mp.as_str(), ap.as_str(), &origins, &loans, &nll, &handles, &graph, &analyzed, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str(), &requested, 10000, true), 0, "hbfull", 3);
    let captured = sh_hir_origins_capture(&graph, &analyzed, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str(), 100000);
    assert_eq_i64(captured.error, 0, "hbfull", 4);
    let mut hir = sh_hir_lift_modules(&graph, &analyzed, &scoped.ownership, &captured, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str(), 100000);
    if hir.error != 0 { println("fullhir-error"); println(hir.error); };
    assert_eq_i64(hir.error, 0, "hbfull", 5);
    assert_eq_i64(sh_hir_validate_modules(&hir, &graph, &analyzed, &scoped.ownership, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str()), 0, "hbfull", 6);
    assert_eq_i64(sh_hir_function_body_state(&hir.ast, &hir.checked, selected), 1, "hbfull", 7);
    let saved_projection = hir.ownership.projection_context;
    hir.ownership.projection_context = saved_projection + 1;
    assert_eq_i64(sh_hir_validate_modules(&hir, &graph, &analyzed, &scoped.ownership, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str()), 5509, "hbfull", 23);
    hir.ownership.projection_context = saved_projection;
    let witness_word = hir.origins.module_input.get(0).unwrap_or(-1);
    hir.origins.module_input.set(0, witness_word + 1);
    assert_true(sh_hir_validate_modules(&hir, &graph, &analyzed, &scoped.ownership, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str()) != 0, "hbfull", 24);
    hir.origins.module_input.set(0, witness_word);
    let deferred = sh_hir_deferred_body_map(&hir);
    assert_true(deferred.is_ok(), "hbfull", 8);
    let mut deferred_functions = 0;
    let mut binding = 0;
    while binding < sh_binding_count(&hir.checked) { if sh_hir_function_body_state(&hir.ast, &hir.checked, binding) == 2 { deferred_functions = deferred_functions + 1; }; binding = binding + 1; };
    assert_eq_i64(deferred_functions, 10, "hbfull", 9);
    let mut deferred_calls = 0;
    let mut equivalent_signatures = 0;
    let mut node = 0;
    while node < sh_ast_count(&hir.ast) { if sh_ast_word(&hir.ast, node, 0) == 53 { if deferred.value.get(node).unwrap_or(-1) >= 0 { deferred_calls = deferred_calls + 1; } else { let callee = sh_ast_child(&hir.ast, node, 0); let signature = sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, callee)); let callable = sh_s_resolve(&hir.checked, sh_node_callable_type(&hir.checked, node)); if signature != callable { assert_true(sh_hir_types_equal(&hir.checked, signature, callable, 0), "hbfull", 10); let abi_index = callable * 6 + 1; let saved_abi = hir.checked.types.words.get(abi_index).unwrap_or(-1); hir.checked.types.words.set(abi_index, 1 - saved_abi); assert_eq_i64(sh_hir_validate(&hir), 5503, "hbfull", 20); hir.checked.types.words.set(abi_index, saved_abi); let arguments_index = sh_hir_type_word(&hir, callable, 4) + sh_s_arity(&hir.checked, callable) - 1; let saved_argument = hir.checked.types.arguments.get(arguments_index).unwrap_or(-1); hir.checked.types.arguments.set(arguments_index, hir.checked.bool_type); assert_false(sh_hir_types_equal(&hir.checked, signature, callable, 0), "hbfull", 21); assert_eq_i64(sh_hir_validate(&hir), 5503, "hbfull", 22); hir.checked.types.arguments.set(arguments_index, saved_argument); equivalent_signatures = equivalent_signatures + 1; }; }; }; node = node + 1; };
    assert_eq_i64(deferred_calls, 4, "hbfull", 11);
    assert_eq_i64(equivalent_signatures, 2, "hbfull", 12);
    let image = sh_hir_encode(&hir, 4000000);
    assert_eq_i64(image.error, 0, "hbfull", 13);
    let restored = sh_hir_decode(&image.words, 4000000);
    assert_eq_i64(restored.error, 0, "hbfull", 14);
    assert_eq_i64(sh_hir_validate_modules(&restored, &graph, &analyzed, &scoped.ownership, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str()), 0, "hbfull", 15);
    assert_true(sh_hir_checked_equal(&hir.checked, &restored.checked) and sh_hir_ownership_equal(&hir.ownership, &restored.ownership), "hbfull", 16);
    assert_true(sh_o_equal(&hir.ast.words, &restored.ast.words) and sh_o_equal(&hir.ast.edges, &restored.ast.edges), "hbfull", 17);
    let cloned = sh_hir_clone(&hir, 4000000);
    assert_eq_i64(sh_hir_validate_modules(&cloned, &graph, &analyzed, &scoped.ownership, ci.as_str(), ch.as_str(), proto, oi.as_str(), oh.as_str()), 0, "hbfull", 18);
    assert_true(sh_o_equal(&frozen_words, &analyzed.checked.types.words) and sh_o_equal(&frozen_arguments, &analyzed.checked.types.arguments), "hbfull", 19);
    result_ok_bool(true);
}

def main() -> i64 {
    let root = hb_arg(0);
    let mp = hb_arg(1);
    let ap = hb_arg(2);
    let source = hb_arg(3);
    if not root.is_ok() or not mp.is_ok() or not ap.is_ok() or not source.is_ok() { return 64; };
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let files = sengoo_file_snapshot_live_handle_count();
    let bytes = sengoo_file_snapshot_live_bytes();
    let mut round = 0;
    while round < 3 { { let r = hb_small(); if not r.is_ok() { println(r.error); return 1; }; let full = hb_full(&root.value, &mp.value, &ap.value, &source.value); if not full.is_ok() { println(full.error); return 2; }; }; assert_eq_i64(sengoo_string_live_handle_count(), strings, "hb", 40); assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "hb", 41); assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "hb", 42); assert_eq_i64(sengoo_file_snapshot_live_handle_count(), files, "hb", 43); assert_eq_i64(sengoo_file_snapshot_live_bytes(), bytes, "hb", 44); round = round + 1; };
    println("hir body coverage: three first-call resource scopes passed");
    0;
}
