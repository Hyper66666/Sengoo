import selfhost_binary;

import std::assert;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def sh_test_binary() -> Result<bool, i64> {
    let bytes = sh_binary_new(32);
    assert_eq_i64(sh_binary_unsigned(&bytes, 4660, 2)?, 0, "binary.sg", 14);
    assert_eq_i64(sh_binary_get(&bytes, 0)?, 52, "binary.sg", 15);
    assert_eq_i64(sh_binary_get(&bytes, 1)?, 18, "binary.sg", 16);
    assert_eq_i64(sh_binary_i32(&bytes, -2)?, 2, "binary.sg", 17);
    assert_eq_i64(sh_binary_get(&bytes, 2)?, 254, "binary.sg", 18);
    assert_eq_i64(sh_binary_get(&bytes, 5)?, 255, "binary.sg", 19);
    assert_eq_i64(sh_binary_unsigned(&bytes, -9223372036854775807 - 1, 8)?, 6, "binary.sg", 20);
    assert_eq_i64(sh_binary_get(&bytes, 13)?, 128, "binary.sg", 21);
    sh_binary_patch(&bytes, 0, 4294967295, 4)?;
    assert_eq_i64(sh_binary_get(&bytes, 0)?, 255, "binary.sg", 23);
    assert_eq_i64(sh_binary_align(&bytes, 16, 204)?, 16, "binary.sg", 24);
    assert_eq_i64(sh_binary_get(&bytes, 15)?, 204, "binary.sg", 25);
    let buffer = sh_binary_buffer(&bytes)?;
    assert_eq_i64(buffer.used_len(), 16, "binary.sg", 27);
    assert_eq_i64(buffer.get_u8(13)?, 128, "binary.sg", 28);
    assert_eq_i64(sh_binary_byte(&bytes, 256).error, 6002, "binary.sg", 29);
    assert_eq_i64(sh_binary_unsigned(&bytes, 1, 9223372036854775807).error, 6002, "binary.sg", 30);
    assert_eq_i64(sh_binary_patch(&bytes, 9223372036854775807, 1, 8).error, 6003, "binary.sg", 31);
    assert_eq_i64(sh_binary_patch(&bytes, -1, 1, 1).error, 6003, "binary.sg", 32);
    assert_eq_i64(sh_binary_patch(&bytes, 15, 1, 2).error, 6003, "binary.sg", 33);
    assert_eq_i64(sh_binary_i32(&bytes, 2147483648).error, 6002, "binary.sg", 34);
    assert_eq_i64(sh_binary_align(&bytes, 3, 0).error, 6002, "binary.sg", 35);
    assert_eq_i64(sh_binary_len(&bytes), 16, "binary.sg", 36);
    let full = sh_binary_new(1);
    sh_binary_byte(&full, 42)?;
    assert_eq_i64(sh_binary_unsigned(&full, 1, 8).error, 6001, "binary.sg", 39);
    assert_eq_i64(sh_binary_align(&full, 2, 0).error, 6001, "binary.sg", 40);
    assert_eq_i64(sh_binary_len(&full), 1, "binary.sg", 41);
    assert_eq_i64(sh_binary_get(&full, 0)?, 42, "binary.sg", 42);
    let invalid = sh_binary_new(-1);
    assert_eq_i64(sh_binary_byte(&invalid, 1).error, 6001, "binary.sg", 44);
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let mut round = 0;
    while round < 100 { let result = sh_test_binary(); if not result.is_ok() { println(result.error); return 1; }; round = round + 1; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "binary.sg", 58);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "binary.sg", 59);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "binary.sg", 60);
    println("selfhost binary: ok");
    0;
}
