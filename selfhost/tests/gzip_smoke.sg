extern "C" {
    unsafe fn sengoo_sg_gzip_decode(source: * const u8, length: i64, target: * mut u8, capacity: i64,
    mode: i64) -> i64;
    unsafe fn sengoo_gzip_fixture_input(kind: i64) -> * const u8;
    unsafe fn sengoo_gzip_fixture_output() -> * mut u8;
    fn sengoo_gzip_fixture_length(kind: i64) -> i64;
    fn sengoo_gzip_fixture_check(kind: i64, mode: i64, result: i64) -> i64;
    fn sengoo_gzip_fixture_output_byte(index: i64) -> u8;
}
pub unsafe extern "C" fn main() -> i64 {
    let target = sengoo_gzip_fixture_output();
    let mut kind = 0;
    while kind < 3 {
        let mut mode = 0;
        while mode < 3 {
            let source = sengoo_gzip_fixture_input(kind);
            let length = sengoo_gzip_fixture_length(kind);
            let result = sengoo_sg_gzip_decode(source, length, target, 8192, mode);
            if sengoo_gzip_fixture_check(kind, mode, result) != 1 {
                return 1;
            };
            if result >= 0 {
                let expected = [102, 105, 114, 115, 116, 115, 101, 99, 111, 110, 100];
                let count = result & 134217727;
                let mut index = 0;
                let mut letter = 65;
                while index < count {
                    let byte = sengoo_gzip_fixture_output_byte(index) as i64;
                    let wanted = if kind == 2 {
                        letter;
                    } else {
                        expected [index];
                    };
                    if byte != wanted {
                        return 2;
                    };
                    letter = letter + 1;
                    if letter == 70 {
                        letter = 65;
                    };
                    index = index + 1;
                };
            };
            mode = mode + 1;
        };
        kind = kind + 1;
    };
    42;
}
