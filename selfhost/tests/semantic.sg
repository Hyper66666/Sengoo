    sh_semantic_case("trait Iterator {type Item;} struct Counter{} impl Iterator for Counter{type Item=i64;} def select<T:Iterator>(owner:T,value:T::Item)->T::Item{value} def main()->i64{select(Counter{},42)}", 0)?;
    sh_semantic_case("trait Show{} struct Value{} impl Show for Value{} struct Holder<T:Show>{value:T} def main(){let h=Holder{value:Value{}};}", 0)?;
    sh_semantic_case("unsafe extern \"C\" fn read(value:*mut u8)->i64{0} def bridge(value:*mut u8)->i64{read(value)}", 0)?;
    sh_semantic_case("def main()->i64{42}", 0)?;
    sh_semantic_case("def add(a:i64,b:i64)->i64{a+b} def main()->i64{add(20,22)}", 0)?;
    sh_semantic_case("def main()->i64{later(41)} def later(x:i64)->i64{x+1}", 0)?;
