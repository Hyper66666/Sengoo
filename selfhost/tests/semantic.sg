    sh_semantic_case("enum Value{None,Some(i64)} def main()->i64{let x=Value::None();42}", 0)?;
    sh_semantic_case("struct Counter{n:i64} impl Counter{def bump(&mut self){self.n=self.n+1;true}} def main(){let mut c=Counter{n:0};c.bump();}", 0)?;
    sh_semantic_case("trait Add<Rhs,Output>{def add(self,rhs:Rhs)->Output{}} struct Value{n:i64} impl Add<Value,Value> for Value{def add(self,rhs:Value)->Value{Value{n:self.n+rhs.n}}} def main()->i64{let a=Value{n:20};let b=Value{n:22};(a+b).n}", 0)?;
    sh_semantic_case("trait Add<Rhs,Output>{def add(self,rhs:Rhs)->Output{}} struct Value{n:i64} impl Add<Value,i64> for Value{def add(self,rhs:Value)->i64{self.n+rhs.n}} def add_values<T>(a:T,b:T)->i64 where T:Add<T,i64>{a+b} def main()->i64{add_values(Value{n:20},Value{n:22})}", 0)?;
    sh_semantic_case("trait Neg<Output>{def neg(self)->Output{}} struct Value{n:i64} impl Neg<i64> for Value{def neg(self)->i64{-(self.n)}} def main()->i64{-Value{n:42}}", 0)?;
    sh_semantic_case("trait Show{def show(&self)->i64{}} struct Value{n:i64} impl Show for Value{def show(&self)->i64{self.n}} def read(x:&dyn Show)->i64{x.show()} def main()->i64{let v=Value{n:42};read(&v)}", 0)?;
    sh_semantic_case("trait Source{type Item;def value(&self)->Self::Item{}} struct Number{n:i64} impl Source for Number{type Item=i64;def value(&self)->Self::Item{self.n}} def read(x:dyn Source<Item=i64>)->i64{x.value()} def main()->i64{read(Number{n:42})}", 0)?;
    sh_semantic_case("async def child()->i64{42} async def main()->i64{let future=child();await future}", 0)?;
    sh_semantic_case("async def main()->i64{let timer=sleep(1);await timer;42}", 0)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} impl AsyncContext{def wake(&self)->bool{true}} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Pending{} impl Future<i64> for Pending{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{ctx.wake();Poll{is_ready:false,value:0}}} async def main()->i64{await Pending{}}", 0)?;
    sh_semantic_case("trait Show{def show(&self)->i64{}} struct Value{n:i64} impl Show for Value{def show(&self)->i64{self.n}} def take(x:dyn Show)->i64{x.show()} def main()->i64{take(Value{n:42})}", 0)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Ready{} impl Future<i64> for Ready{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{Poll{is_ready:true,value:42}}} async def main()->i64{let ready=Ready{};await ready}", 0)?;
