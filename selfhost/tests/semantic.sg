import selfhost_semantic;

import std::assert;

extern "C" {
    fn sengoo_string_live_handle_count() -> i64;
    fn sengoo_buffer_live_handle_count() -> i64;
    fn sengoo_opaque_live_handle_count() -> i64;
}

def sh_semantic_case(source: &str, expected: i64) -> Result<bool, i64> {
    let text = string_from_str(source)?;
    let parsed = sh_parse(&text, 0, 100000);
    if parsed.error != 0 { println("semantic fixture parse error"); println(source); println(parsed.error); return Result { is_ok: false, value: false, error: parsed.error }; };
    let checked = sh_check(&text, &parsed.ast, 1000);
    if checked.error != expected { println("semantic fixture unexpected result"); println(source); println(checked.error); println(expected); let mut index = 0; while index < checked.diagnostics.len() { let diagnostic = checked.diagnostics.get(index); println(diagnostic.code); println(diagnostic.start); println(diagnostic.end); index = index + 1; }; return Result { is_ok: false, value: false, error: 99 }; };
    assert_true(checked.node_types.len() == sh_ast_count(&parsed.ast), "semantic.sg", 24);
    assert_true(checked.call_types.len() == sh_ast_count(&parsed.ast), "semantic.sg", 25);
    assert_true(checked.resolution.len() == sh_ast_count(&parsed.ast), "semantic.sg", 25);
    assert_true(checked.node_scopes.len() == sh_ast_count(&parsed.ast), "semantic.sg", 26);
    if expected != 0 { assert_true(checked.start >= 0 and checked.end >= checked.start and checked.end <= text.len(), "semantic.sg", 27); (); };
    Result { is_ok: true, value: true, error: 0 };
}

def sh_semantic_positive() -> Result<bool, i64> {
    sh_semantic_case("def take(value:Future<i64>){} def main()->i64{42}", 0)?;
    sh_semantic_case("struct Poll<T>{value:T,is_ready:bool} struct AsyncContext{handle:i64} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Ready{} impl Future<i64> for Ready{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{Poll{value:42,is_ready:true}}} async def main()->i64{await Ready{}}", 5120)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} impl AsyncContext{def wake(&self)->bool{true}def wake_after(&self,delay:i64)->bool{true}} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Pending{} impl Future<i64> for Pending{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{if true{ctx.wake();}else{ctx.wake_after(1);}Poll{is_ready:false,value:0}}}", 0)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} trait Future<T>{def poll(&self,ctx:AsyncContext)->Poll<T>{}}", 5120)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} trait Future<T>{def poll(self,ctx:AsyncContext)->Poll<T>{}}", 5120)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} trait Future<T>{def poll(ctx:AsyncContext)->Poll<T>{}}", 5120)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} impl AsyncContext{def wake(&self)->bool{true}} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Pending{} impl Future<i64> for Pending{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{while false{ctx.wake();}Poll{is_ready:false,value:0}}}", 5125)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} impl AsyncContext{def wake(&self)->bool{true}} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Pending{} impl Future<i64> for Pending{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{let callback=| |{ctx.wake();};Poll{is_ready:false,value:0}}}", 5125)?;
    sh_semantic_case("async def child()->i64{42} async def main()->i64{let future:Future<i64> =child();await future}", 0)?;
    sh_semantic_case("struct Option<T>{is_some:bool,value:T} trait Source{type Item;def next(&self)->Option<Self::Item>{}} struct Iter<T>{value:T} impl<T> Source for Iter<T>{type Item=T;def next(&self)->Option<T>{Option{is_some:true,value:self.value}}} struct Take<I:Source,T>{inner:I,marker:T} impl<I:Source,T> Take<I,T>{def next(&self)->Option<T>{self.inner.next()}} def main()->i64{let t=Take{inner:Iter{value:42},marker:0};t.next().value}", 0)?;
    sh_semantic_case("struct Option<T>{is_some:bool,value:T} trait Source{type Item;def next(&self)->Option<Self::Item>{}} struct Iter<T>{value:T} impl<T> Source for Iter<T>{type Item=T;def next(&self)->Option<T>{Option{is_some:true,value:self.value}}} struct Take<I:Source,T>{inner:I,marker:T} impl<I:Source,T> Take<I,T>{def next(&self)->Option<T>{self.inner.next()}} def main(){let t=Take{inner:Iter{value:42},marker:true};t.next();();}", 5104)?;
    sh_semantic_case("def main()->i64{let t=Take{inner:Iter{value:42},marker:0};t.next().value} struct Option<T>{is_some:bool,value:T} trait Source{type Item;def next(&self)->Option<Self::Item>{}} struct Iter<T>{value:T} impl<T> Source for Iter<T>{type Item=T;def next(&self)->Option<T>{Option{is_some:true,value:self.value}}} struct Take<I:Source,T>{inner:I,marker:T} impl<I:Source,T> Take<I,T>{def next(&self)->Option<T>{self.inner.next()}} ", 0)?;
    sh_semantic_case("def main(){let t=Take{inner:Iter{value:42},marker:true};read(t);();} def read<U:Source,V>(value:Take<U,V>)->Option<V>{value.next()} struct Option<T>{is_some:bool,value:T} trait Source{type Item;def next(&self)->Option<Self::Item>{}} struct Iter<T>{value:T} impl<T> Source for Iter<T>{type Item=T;def next(&self)->Option<T>{Option{is_some:true,value:self.value}}} struct Take<I:Source,T>{inner:I,marker:T} impl<I:Source,T> Take<I,T>{def next(&self)->Option<T>{self.inner.next()}} ", 5104)?;
    sh_semantic_case("def insert()->bool{true} struct State{} impl State{def run(&self)->i64{let mut done=false;while !done{if done{done=true}else{done=true;insert();}}42}} def main()->i64{let s=State{};s.run()}", 0)?;
    sh_semantic_case("def insert()->bool{true} struct State{} impl State{def run(&self)->i64{let mut done=false;while !done{if !done{done=true;insert();}}42}} def main()->i64{let s=State{};s.run()}", 0)?;
    sh_semantic_case("def main(){let s=format(\"{0} {0}\",42);}", 0)?;
    sh_semantic_case("def main(){let s=format(\"{} {1:?} {0:>8.2}\",1,2);}", 0)?;
    sh_semantic_case("def main(){let s=format(\"{{{0}}}\",42);}", 0)?;
    sh_semantic_case("def main(){let s=format(\"{name}\",42);}", 5121)?;
    sh_semantic_case("def main(){let s=format(\"{:bogus}\",42);}", 5121)?;
    sh_semantic_case("def main(){let s=format(\"{:.}\",42);}", 5121)?;
    sh_semantic_case("def main(){let s=format(\"{0}\",1,2);}", 5105)?;
    sh_semantic_case("def main()->i64{match 42{a|a=>a,_=>0}}", 0)?;
    sh_semantic_case("trait Greet{def greet(self)->i64{42}} trait Loud:Greet{} impl Greet for i64{} impl Loud for i64{} def say<T:Loud>(value:T)->i64{value.greet()} def main()->i64{say(42)}", 0)?;
    sh_semantic_case("trait Add<Rhs,Output>{def add(self,rhs:Rhs)->Output{}} def sum<T>(a:T,b:T)->T where T:Add<T,T>{a+b} def main()->i64{sum(20,22)}", 0)?;
