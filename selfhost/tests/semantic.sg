    sh_semantic_case("def add8(a:i8,b:i8)->i8{a+b} def main()->i64{let x=40i8;let y=2i8;let z=add8(x,y);z as i64}", 0)?;
    sh_semantic_case("def ret()->f32{1.5f32} def main()->i64{ret() as i64}", 0)?;
