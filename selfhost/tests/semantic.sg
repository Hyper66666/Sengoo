    sh_semantic_case("trait Value {def value(&self)->i64{}} struct Point{x:i64} impl Value for Point {def value(&self)->i64{self.x}} def main()->i64{let p=Point{x:42};p.value()}", 0)?;
    sh_semantic_case("trait Value {def value(&self)->i64{}} def read<T:Value>(x:&T)->i64{x.value()}", 0)?;
