    sh_semantic_case("async def child()->bool{true} async def main()->bool{let scope=task_scope();scope_spawn(&scope,child());join(child(),child());if await timeout(child(),1){select_cancel(child(),child(),child())}else{false}}", 0)?;
    sh_semantic_case("def main()->i64{let add=|x|x+1;let text=\"hello\"+\" world\";add(text.len())}", 0)?;
    sh_semantic_case("struct Point{x:i64} def main(){print(Point{x:42});}", 0)?;
    sh_semantic_case("trait Convert<T>{def convert(self)->T{}} impl Convert<i64> for i32 {def convert(self)->i64{self as i64}}", 0)?;
    sh_semantic_case("extern \"C\"{fn small()->i32;} def main()->i64{let y:i64=100;small()+y}", 0)?;
    sh_semantic_case("struct Result<T,E>{is_ok:bool,value:T,error:E} def answer()->Result<i64,i64>{Result{is_ok:true,value:42,error:0}} def main()->i64{let r=try {let n=answer()?;n};r.value}", 0)?;
    sh_semantic_case("struct Option<T>{is_some:bool,value:T} def answer()->Option<i64>{Option{is_some:true,value:42}} def main()->i64{let r=try {let n=answer()?;n};r.value}", 0)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_semantic_negative() -> Result<bool, i64> {
    sh_semantic_case("extern \"C\"{fn raw(handle:i64)->i64;} def bad()->&str{raw(1) as &str}", 5113)?;
    sh_semantic_case("def take(value:Future){}", 5114)?;
    sh_semantic_case("def take(value:Future<i64,bool>){}", 5114)?;
    sh_semantic_case("struct LocalOnly{value:i64} impl !Send for LocalOnly{} def consume(value:LocalOnly)->i64{value.value} def spawn_blocking_i64(callback:fn()->i64)->i64{callback()} def main()->i64{let local=LocalOnly{value:42};spawn_blocking_i64(| |consume(local))}", 5115)?;
    sh_semantic_case("def insert()->bool{true} def main()->i64{let mut done=false;while !done{if !done{done=true;insert();}}42}", 5118)?;
    sh_semantic_case("struct State{} impl State{def run(&self)->bool{if true{42}else{true}}}", 5104)?;
    sh_semantic_case("class Counter{n:i64;def bump(&mut self){self.n=self.n+1;true}}", 5104)?;
    sh_semantic_case("def main()->i64{match 42{a|b=>a,_=>0}}", 5110)?;
    sh_semantic_case("def main()->i64{match (1,2){(a,_)|(_,b)=>a,_=>0}}", 5110)?;
    sh_semantic_case("trait Greet{} trait Loud:Greet{} impl Loud for i64{}", 5115)?;
    sh_semantic_case("trait Loud:Missing{}", 5115)?;
    sh_semantic_case("trait A:B{} trait B:A{}", 5115)?;
    sh_semantic_case("def answer()->i64 requires 123 {0}", 5104)?;
    sh_semantic_case("def answer()->i64 ensures result==7 {42}", 5127)?;
    sh_semantic_case("def answer()->i64 ensures false {42}", 5127)?;
    sh_semantic_case("def wrong(){true}", 5104)?;
    sh_semantic_case("struct Counter{} impl Counter{def wrong()->(){true}}", 5104)?;
    sh_semantic_case("struct Counter{} impl Counter{def wrong(){return true;}}", 5104)?;
    sh_semantic_case("trait Add<Rhs,Output>{def add(self,rhs:Rhs)->i64{}}", 5123)?;
    sh_semantic_case("trait Add<Rhs,Output>{def add(self,rhs:Rhs)->Output{}} struct Value{n:i64} impl Add<Value,i64> for Value{def add(self,rhs:Value)->i64{self.n+rhs.n}} def add_values<T>(a:T,b:T)->T where T:Add<T,T>{a+b} def main(){add_values(Value{n:20},Value{n:22});();}", 5115)?;
    sh_semantic_case("def main()->i64{match 1{_=>1,0=>2}}", 5112)?;
    sh_semantic_case("trait Source{def same(&self,x:Self)->i64{0}} def read(x:dyn Source){}", 5116)?;
    sh_semantic_case("trait Source{def same(&self)->Self{}} def read(x:dyn Source){}", 5116)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} impl AsyncContext{def wake(&self)->bool{true}} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Pending{} impl Future<i64> for Pending{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{if true{ctx.wake();Poll{is_ready:true,value:1}}else{Poll{is_ready:false,value:0}}}}", 5125)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} struct Other{} impl Other{def wake(&self)->bool{true}} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Pending{} impl Future<i64> for Pending{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{let other=Other{};other.wake();Poll{is_ready:false,value:0}}}", 5125)?;
    sh_semantic_case("trait Source{type Item;} struct Number{} impl Source for Number{type Item=i64;} def read(x:dyn Source<Item=bool>){} def main(){read(Number{});}", 5104)?;
    sh_semantic_case("trait Show{} struct Number{} impl Show for Number{} def read(x:dyn Show){} def main(){let n=Number{};read(&n);}", 5104)?;
    sh_semantic_case("trait Source{type Item;} def read(x:dyn Source){}", 5123)?;
    sh_semantic_case("trait Factory{def create()->i64{42}} def read(x:dyn Factory){}", 5116)?;
    sh_semantic_case("trait Mapper{def map<T>(&self,x:T)->T{x}} def read(x:dyn Mapper){}", 5116)?;
    sh_semantic_case("trait Source{type Item;} def read(x:dyn Source<Item=i64,Item=bool>){}", 5123)?;
    sh_semantic_case("trait Source{type Item;} def read(x:dyn Source<Other=i64>){}", 5123)?;
    sh_semantic_case("struct AsyncContext{handle:i64} def main(){let context=AsyncContext{handle:0};}", 5120)?;
    sh_semantic_case("struct AsyncContext{handle:i64} def leak(ctx:AsyncContext)->AsyncContext{ctx}", 5120)?;
    sh_semantic_case("struct AsyncContext{handle:i64} def equal(ctx:AsyncContext)->bool{ctx==ctx}", 5120)?;
    sh_semantic_case("async def child()->i64{42} async def main(){let values=[child()];}", 5124)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Pending{} impl Future<i64> for Pending{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{Poll{is_ready:false,value:0}}} async def main()->i64{await Pending{}}", 5125)?;
    sh_semantic_case("struct Poll<T>{value:T} struct AsyncContext{handle:i64} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Bad{} impl Future<i64> for Bad{def poll(&mut self,ctx:AsyncContext)->Poll<i64>{Poll{value:42}}}", 5120)?;
    sh_semantic_case("trait Read{} trait Write{} def stream(x:dyn Read+Write)->i64{0}", 5116)?;
    sh_semantic_case("struct Poll<T>{is_ready:bool,value:T} struct AsyncContext{handle:i64} trait Future<T>{def poll(&mut self,ctx:AsyncContext)->Poll<T>{}} struct Bad{} impl Future<i64> for Bad{def poll(&self,ctx:AsyncContext)->i64{42}}", 5120)?;
    sh_semantic_case("trait A{def show(self)->i64{1}} trait B{def show(self)->i64{2}} impl A for i64{} impl B for i64{} def main()->i64{42.show()}", 5123)?;
    sh_semantic_case("def main()->i64{let x:i8=40;let y:i8=2;(x+y) as i64}", 5104)?;
    sh_semantic_case("def arg(x:i8){} def main(){arg(40);}", 5104)?;
    sh_semantic_case("def ret()->i8{40}", 5104)?;
    sh_semantic_case("def ret()->f32{1.5}", 5104)?;
    sh_semantic_case("def main(){let x:f32=1.5;}", 5104)?;
    sh_semantic_case("def main(){let x:u64=42;}", 5104)?;
    sh_semantic_case("def unsupported(x:i128){}", 5126)?;
    sh_semantic_case("def unsupported(x:u128){}", 5126)?;
    sh_semantic_case("class A{} class B{} class C:A,B{}", 5123)?;
    sh_semantic_case("class A{} trait T{} class C:T,A{}", 5123)?;
    sh_semantic_case("class A:B{} class B:A{}", 5123)?;
    sh_semantic_case("class A{x:i64;} class B:A{x:i64;}", 5123)?;
    sh_semantic_case("class A{x:i64;} class B:A{} def main(){let b=B{};}", 5106)?;
    sh_semantic_case("def missing()->i64{}", 5104)?;
    sh_semantic_case("trait Show {def show(&self)->i64{}} def take<T:Show>(x:T)->i64{0} def main()->i64{take(42)}", 5115)?;
    sh_semantic_case("trait Show {def show(&self)->i64{}} def take<T>(x:T)->i64 where T:Show {0} def main()->i64{take(42)}", 5115)?;
    sh_semantic_case("struct Local{} impl !Send for Local{} def take<T:Send>(x:T)->i64{0} def main()->i64{take(Local{})}", 5115)?;
    sh_semantic_case("trait Show{} struct Holder<T:Show>{value:T} def take(h:Holder<i64>){}", 5115)?;
    sh_semantic_case("extern \"stdcall\" {fn wrong()->i64;}", 5122)?;
    sh_semantic_case("extern \"C\" fn generic<T>(x:T)->T{x}", 5122)?;
    sh_semantic_case("struct Pair{x:i64} extern \"C\" {fn wrong(x:Pair)->i64;}", 5122)?;
    sh_semantic_case("extern \"C\" {fn wrong(x:*mut u8)->i64;}", 5122)?;
    sh_semantic_case("extern \"C\" {fn wrong(x:&mut str)->i64;}", 5122)?;
    sh_semantic_case("struct Value{} impl Drop for Value {def drop(&self){}}", 5123)?;
    sh_semantic_case("struct Value{} impl Drop for Value {def drop(&mut self,n:i64){}}", 5123)?;
    sh_semantic_case("struct Value{} impl Drop for Value {}", 5123)?;
    sh_semantic_case("struct Value{} impl Drop for Value{def drop(&mut self){}} def main(){let mut v=Value{};v.drop();}", 5123)?;
    sh_semantic_case("struct Value{} impl Drop for Value {def drop(&mut self){}} impl Copy for Value{}", 5123)?;
    sh_semantic_case("trait Drop {def drop(&mut self){}}", 5123)?;
    sh_semantic_case("trait Copy {}", 5123)?;
    sh_semantic_case("struct Value{} impl Display for Value{}", 5123)?;
    sh_semantic_case("struct Value{} impl Debug for Value{def to_string(&self)->i64{0}}", 5123)?;
    sh_semantic_case("struct Value{} impl !Send for Value{def wrong(&self){}}", 5123)?;
    sh_semantic_case("def main()->i64{missing}", 5101)?;
    sh_semantic_case("def main(x:Missing)->i64{42}", 5102)?;
    sh_semantic_case("def same()->i64{1} def same()->i64{2}", 0)?;
    sh_semantic_case("def main()->bool{42}", 5104)?;
    sh_semantic_case("def add(a:i64,b:i64)->i64{a+b} def main()->i64{add(1)}", 5105)?;
    sh_semantic_case("struct Pair{x:i64} def main()->i64{let p=Pair{x:42};p.absent}", 5106)?;
    sh_semantic_case("struct Pair{x:i64,y:i64} def main()->Pair{Pair{x:1}}", 5106)?;
    sh_semantic_case("def main()->i64{let x=0;x=42;x}", 5107)?;
    sh_semantic_case("def main()->i64{break;42}", 5109)?;
    sh_semantic_case("def main()->i64{match true {true=>42}}", 5111)?;
    sh_semantic_case("def main()->i64{true as f64}", 5113)?;
    sh_semantic_case("struct Cell<T>{value:T} def main(x:Cell)->i64{42}", 5114)?;
    sh_semantic_case("def main()->i64{let a=[1,2];a[2]}", 5119)?;
    sh_semantic_case("async def answer()->i64{42} def main()->i64{await answer()}", 5120)?;
    sh_semantic_case("def main()->i64{let x:isize=1isize;x+1i64}", 5104)?;
    sh_semantic_case("def id<T>(x:T)->T{x} def main()->i64{id::<bool>(42)}", 5101)?;
    sh_semantic_case("trait Value {def value(&self)->i64{}} struct Point{x:i64} impl Value for Point {}", 5115)?;
    sh_semantic_case("trait Value {def value(&self)->i64{}} struct Point{x:i64} impl Value for Point {def value(&self)->bool{true}}", 5104)?;
    sh_semantic_case("def main(){println(1,2);}", 5105)?;
    sh_semantic_case("def main(){sleep(1);}", 5120)?;
    sh_semantic_case("async def main(){sleep(true);}", 5104)?;
    sh_semantic_case("async def main(){select(1,2);}", 5104)?;
    sh_semantic_case("async def main(){select(sleep(1));}", 5105)?;
    sh_semantic_case("async def child()->bool{true} async def main(){select(child(),sleep(1));}", 5104)?;
    sh_semantic_case("async def child(x:&i64)->i64{*x} async def main(){let x=42;spawn(child(&x));}", 5115)?;
    sh_semantic_case("async def child()->i64{42} async def main(){let f=child();spawn(f);}", 5115)?;
    Result { is_ok: true, value: true, error: 0 };
}

def sh_semantic_deferred_facts() -> Result<bool, i64> {
    let text = string_from_str("struct Option<T>{is_some:bool,value:T} trait Source{type Item;def next(&self)->Option<Self::Item>{}} struct Take<I:Source,T>{inner:I,marker:T} impl<I:Source,T> Take<I,T>{def next(&self)->Option<T>{self.inner.next()}}")?;
    let parsed = sh_parse(&text, 0, 100000);
    let checked = sh_check(&text, &parsed.ast, 1000);
    assert_eq_i64(checked.error, 0, "semantic.sg", 140);
    assert_true(sh_deferred_type_count(&checked) > 0, "semantic.sg", 141);
    let owner = sh_deferred_type_word(&checked, 0, 0);
    assert_eq_i64(sh_binding_word(&checked, owner, 2), 2, "semantic.sg", 142);
    assert_true(sh_deferred_type_word(&checked, 0, 3) >= 0, "semantic.sg", 143);
    assert_eq_i64(sh_deferred_type_word(&checked, -1, 0), -1, "semantic.sg", 144);
    assert_eq_i64(sh_deferred_type_word(&checked, 0, 4), -1, "semantic.sg", 145);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_semantic_asstr_facts() -> Result<bool, i64> {
    let text = string_from_str("struct String{handle:i64} def shared(value:&String)->&str{value.as_str()} def unique(value:&mut String)->&str{value.as_str()} def owned(value:String)->i64{let text=value.as_str();text.len()}")?;
    let parsed = sh_parse(&text, 0, 10000);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, 0, "asstr-facts.sg", 1);
    let mut node = 0;
    let mut seen = 0;
    while node < sh_ast_count(&parsed.ast) { if sh_ast_word(&parsed.ast, node, 0) == 53 { let callee = sh_ast_child(&parsed.ast, node, 0); if sh_ast_word(&parsed.ast, callee, 0) == 55 { let name = sh_s_name(&text, &parsed.ast, sh_ast_child(&parsed.ast, callee, 1))?; if sh_s_text_equal(&name, "as_str") { let signature = sh_node_callable_type(&checked, node); let receiver = sh_s_argument(&checked, signature, 0); assert_eq_i64(sh_s_kind(&checked, receiver), 6, "asstr-facts.sg", 2); assert_eq_i64(sh_s_flags(&checked, receiver), 0, "asstr-facts.sg", 3); assert_eq_i64(sh_s_kind(&checked, sh_s_argument(&checked, receiver, 0)), 12, "asstr-facts.sg", 4); seen = seen + 1; }; }; }; node = node + 1; };
    assert_eq_i64(seen, 3, "asstr-facts.sg", 5);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_semantic_builtin_case(source: &str, expected: i64, records: i64) -> Result<bool, i64> {
    let text = string_from_str(source)?;
    let parsed = sh_parse(&text, 0, 10000);
    assert_eq_i64(parsed.error, 0, "builtin-call-facts.sg", 1);
    let checked = sh_check(&text, &parsed.ast, 100);
    assert_eq_i64(checked.error, expected, "builtin-call-facts.sg", 2);
    assert_eq_i64(sh_builtin_call_count(&checked), records, "builtin-call-facts.sg", 3);
    if records > 0 { let node = sh_builtin_call_word(&checked, 0, 0); assert_eq_i64(sh_builtin_call_for_node(&checked, node), 0, "builtin-call-facts.sg", 4); assert_eq_i64(sh_builtin_call_word(&checked, 0, 1), 1, "builtin-call-facts.sg", 5); let runtime = sh_builtin_call_word(&checked, 0, 3); assert_true((sh_binding_word(&checked, runtime, 5) & 8) != 0, "builtin-call-facts.sg", 6); assert_eq_i64(sh_builtin_call_word(&checked, 0, 4), sh_node_callable_type(&checked, node), "builtin-call-facts.sg", 7); let types_before_validation = sh_type_count(&checked.types); assert_true(sh_builtin_call_valid(&checked, &text, &parsed.ast, 0), "builtin-call-facts.sg", 13); let mut field = 0; while field < 6 { let original = sh_builtin_call_word(&checked, 0, field); checked.builtin_calls.set(field, -1); assert_true(not sh_builtin_call_valid(&checked, &text, &parsed.ast, 0), "builtin-call-facts.sg", 14); checked.builtin_calls.set(field, original); field = field + 1; }; assert_true(sh_builtin_call_valid(&checked, &text, &parsed.ast, 0), "builtin-call-facts.sg", 15); assert_eq_i64(sh_type_count(&checked.types), types_before_validation, "builtin-call-facts.sg", 16); (); };
    assert_eq_i64(sh_builtin_call_word(&checked, -1, 0), -1, "builtin-call-facts.sg", 8);
    assert_eq_i64(sh_builtin_call_word(&checked, 0, 6), -1, "builtin-call-facts.sg", 9);
    Result { is_ok: true, value: true, error: 0 };
}

def sh_semantic_builtin_facts() -> Result<bool, i64> {
    sh_semantic_builtin_case("extern \"C\"{fn sengoo_string_as_str_ptr(handle:i64)->i64;} struct String{handle:i64} def view(value:&String)->&str{value.as_str()}", 0, 1)?;
    sh_semantic_builtin_case("struct String{handle:i64} def view(value:&String)->&str{value.as_str()}", 0, 0)?;
    sh_semantic_builtin_case("extern \"C\"{fn sengoo_string_as_str_ptr(handle:bool)->i64;} struct String{handle:i64} def view(value:&String)->&str{value.as_str()}", 5122, 0)?;
    sh_semantic_builtin_case("extern \"C\"{fn sengoo_string_as_str_ptr(handle:i64)->i64;} struct String{handle:bool} def view(value:&String)->&str{value.as_str()}", 5122, 0)?;
    sh_semantic_builtin_case("def sengoo_string_as_str_ptr(handle:i64)->i64{handle} struct String{handle:i64} def view(value:&String)->&str{value.as_str()}", 5122, 0)?;
    sh_semantic_builtin_case("extern \"C\"{fn sengoo_string_as_str_ptr(handle:i64)->i32;} struct String{handle:i64} def view(value:&String)->&str{value.as_str()}", 5122, 0)?;
    Result { is_ok: true, value: true, error: 0 };
}

def main() -> i64 {
    let strings = sengoo_string_live_handle_count();
    let buffers = sengoo_buffer_live_handle_count();
    let opaque = sengoo_opaque_live_handle_count();
    let intrinsic = sh_semantic_builtin_facts();
    if not intrinsic.is_ok() { return 7; };
    let asstr = sh_semantic_asstr_facts();
    if not asstr.is_ok() { return 6; };
    let deferred = sh_semantic_deferred_facts();
    if not deferred.is_ok() { return 5; };
    let positive = sh_semantic_positive();
    if not positive.is_ok() { return 1; };
    let negative = sh_semantic_negative();
    if not negative.is_ok() { return 2; };
    let mut round = 0;
    while round < 100 { let result = sh_semantic_case("def identity<T>(x:T)->T{x} def main()->i64{identity(42)}", 0); if not result.is_ok() { return 3; }; let rejected = sh_semantic_case("def main()->i64{let x=true;x+42}", 5104); if not rejected.is_ok() { return 4; }; round = round + 1; };
    assert_eq_i64(sengoo_string_live_handle_count(), strings, "semantic.sg", 100);
    assert_eq_i64(sengoo_buffer_live_handle_count(), buffers, "semantic.sg", 101);
    assert_eq_i64(sengoo_opaque_live_handle_count(), opaque, "semantic.sg", 102);
    println("selfhost semantic: ok");
    0;
}
