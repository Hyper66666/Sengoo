import selfhost_mir_validate;

import selfhost_semantic;

import selfhost_borrow;

import selfhost_hir;

struct ShMirLower {
    mir: ShMir,
    type_map: Vec<i64>,
    functions: Vec<i64>,
    locals: Vec<i64>,
    scopes: Vec<i64>,
    addresses: Vec<i64>,
    temporaries: Vec<i64>,
    loops: Vec<i64>,
    try_blocks: Vec<i64>,
    generic_keys: Vec<i64>,
    generic_values: Vec<i64>,
    template_types: Vec<i64>,
    class_symbols: Vec<i64>,
    jobs: Vec<i64>,
    job_substitutions: Vec<i64>,
    function: i64,
    block: i64,
    scope: i64,
    depth: i64,
    error: i64,
    start: i64,
    end: i64,
}

def sh_l_fail(lower: &mut ShMirLower, ast: &ShAst, node: i64, code: i64) -> i64 {
    if lower.error == 0 { lower.error = code; lower.start = sh_ast_word(ast, node, 2); lower.end = sh_ast_word(ast, node, 3); };
    -1;
}

def sh_l_store(lower: &mut ShMirLower, ast: &ShAst, node: i64, result: Result<i64, i64>) -> i64 {
    if not result.is_ok() { return sh_l_fail(lower, ast, node, result.error); };
    result.value;
}

def sh_l_type(lower: &mut ShMirLower, checked: &ShChecked, input: i64, depth: i64) -> i64 {
    let applied = if lower.generic_keys.len() > 0 { sh_s_type_replace(checked, input, &lower.generic_keys, &lower.generic_values, 0); } else { input; };
    let ty = sh_s_resolve(checked, applied);
    if depth > 128 or ty < 0 or ty >= sh_type_count(&checked.types) { return -1; };
    while lower.type_map.len() <= ty { if not lower.type_map.push(-1) { return -1; }; };
    let existing = lower.type_map.get(ty).unwrap_or(-1);
    if existing >= 0 { return existing; };
    let arguments = vec_new_i64();
    let mut i = 0;
    while i < sh_s_arity(checked, ty) { let value = sh_l_type(lower, checked, sh_s_argument(checked, ty, i), depth + 1); if value < 0 or not arguments.push(value) { return -1; }; i = i + 1; };
    let kind = sh_s_kind(checked, ty);
    let owner = if kind == 12 { sh_adt_binding(checked, ty); } else { -1; };
    let data = if kind == 12 and sh_binding_word(checked, owner, 2) == 4 { 1; } else { if kind == 12 and lower.class_symbols.contains(sh_s_nominal(checked, ty)) { 2; } else { sh_s_data(checked, ty); }; };
    let result = sh_type_intern(&lower.mir.types, kind, data, sh_s_flags(checked, ty), sh_s_nominal(checked, ty), &arguments);
    if not result.is_ok() { return -1; };
    if not lower.type_map.set(ty, result.value) { return -1; };
    result.value;
}

def sh_l_node_type(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, node: i64) -> i64 {
    let ty = sh_l_type(lower, checked, sh_node_type(checked, node), 0);
    if ty < 0 { return sh_l_fail(lower, ast, node, 5003); };
    ty;
}

def sh_l_has_parameter(checked: &ShChecked, input: i64, depth: i64) -> bool {
    if depth >= 128 { return true; };
    let ty = sh_s_resolve(checked, input);
    let kind = sh_s_kind(checked, ty);
    if kind == 13 or kind == 19 or kind == 15 and sh_s_flags(checked, ty) == 0 { return true; };
    let mut argument = 0;
    while argument < sh_s_arity(checked, ty) { if sh_l_has_parameter(checked, sh_s_argument(checked, ty, argument), depth + 1) { return true; }; argument = argument + 1; };
    false;
}

def sh_l_deferred(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, binding: i64) -> bool {
    let mut row = 0;
    while row < checked.deferred_types.len() / 4 { if checked.deferred_types.get(row * 4).unwrap_or(-1) == binding { let origin = checked.deferred_types.get(row * 4 + 3).unwrap_or(-1); let expected = sh_s_normalize(checked, sh_s_type_replace(checked, checked.deferred_types.get(row * 4 + 1).unwrap_or(-1), &lower.generic_keys, &lower.generic_values, 0)); let actual = sh_s_normalize(checked, sh_s_type_replace(checked, checked.deferred_types.get(row * 4 + 2).unwrap_or(-1), &lower.generic_keys, &lower.generic_values, 0)); if expected < 0 or actual < 0 or expected != actual or sh_l_has_parameter(checked, expected, 0) or sh_l_has_parameter(checked, actual, 0) { sh_l_fail(lower, ast, origin, 5009); return false; }; }; row = row + 1; };
    true;
}

def sh_l_function_name(checked: &ShChecked, binding: i64) -> Result<String, i64> {
    let source = sh_symbol_text(&checked.symbols, sh_binding_word(checked, binding, 0))?;
    let owner = sh_binding_word(checked, binding, 6);
    let owner_kind = sh_binding_word(checked, owner, 2);
    let signature = sh_s_resolve(checked, sh_binding_word(checked, binding, 3));
    if sh_s_data(checked, signature) == 0 and (owner_kind == 3 or owner_kind == 7 or owner_kind == 14) { let output = string_from_str("__sg_method_")?; output.push_i64(owner)?; output.push_str("_")?; string_copy_result(sengoo_string_push_padded_string_status(output.handle, source.handle, 1, 0))?; return Result { is_ok: true, value: output, error: 0 }; };
    Result { is_ok: true, value: source, error: 0 };
}

def sh_l_job(lower: &mut ShMirLower, ast: &ShAst, node: i64, function: i64, binding: i64, signature: i64, first: i64, count: i64) {
    if lower.jobs.len() / 5 >= lower.mir.limit or not lower.jobs.push(function) or not lower.jobs.push(binding) or not lower.jobs.push(signature) or not lower.jobs.push(first) or not lower.jobs.push(count) { sh_l_fail(lower, ast, node, 5001); (); };
}

def sh_l_instance(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, node: i64, binding: i64, declared: i64) -> i64 {
    if sh_s_child_kind(ast, sh_binding_word(checked, binding, 4), 40) < 0 { return sh_l_fail(lower, ast, node, 5009); };
    let actual = if lower.generic_keys.len() > 0 { sh_s_type_replace(checked, declared, &lower.generic_keys, &lower.generic_values, 0); } else { sh_s_resolve(checked, declared); };
    if sh_s_kind(checked, actual) != 11 or sh_l_has_parameter(checked, actual, 0) { return sh_l_fail(lower, ast, node, 5009); };
    let signature = sh_l_type(lower, checked, actual, 0);
    let template = lower.template_types.get(binding).unwrap_or(-1);
    let symbol = sh_binding_word(checked, binding, 0);
    let mut instance = 0;
    while instance < sh_mir_instance_count(&lower.mir) { let function = sh_mir_instance(&lower.mir, instance, 0); if sh_mir_instance(&lower.mir, instance, 1) == symbol and sh_mir_instance(&lower.mir, instance, 2) == template and sh_mir_fn(&lower.mir, function, 1) == signature { return function; }; instance = instance + 1; };
    let keys = vec_new_i64();
    let values = vec_new_i64();
    if not sh_s_pattern_keys(checked, sh_binding_word(checked, binding, 3), actual, &keys, &values, 0) or keys.len() != values.len() { return sh_l_fail(lower, ast, node, 5009); };
    let mut pair = 0;
    while pair < values.len() { if sh_ownership_needs_drop(text, ast, checked, values.get(pair).unwrap_or(-1)) { return sh_l_fail(lower, ast, node, 5009); }; pair = pair + 1; };
    let name = sh_l_function_name(checked, binding);
    if not name.is_ok() { return sh_l_fail(lower, ast, node, 5003); };
    name.value.push_str("__sg_instance_");
    name.value.push_i64(sh_mir_fn_count(&lower.mir));
    let declaration = sh_binding_word(checked, binding, 4);
    let made = sh_mir_add_function(&lower.mir, &name.value, signature, if sh_s_child_kind(ast, declaration, 40) < 0 { 1; } else { 0; }, sh_ast_word(ast, declaration, 1), sh_ast_word(ast, declaration, 2), sh_ast_word(ast, declaration, 3));
    let function = sh_l_store(lower, ast, node, made);
    let job_first = lower.job_substitutions.len() / 2;
    let mir_first = lower.mir.substitutions.len() / 2;
    pair = 0;
    while pair < keys.len() { let key = keys.get(pair).unwrap_or(-1); let value = values.get(pair).unwrap_or(-1); let source_type = lower.type_map.get(sh_s_resolve(checked, key)).unwrap_or(-1); let target_type = sh_l_type(lower, checked, value, 0); if source_type < 0 or target_type < 0 or lower.mir.substitutions.len() > lower.mir.limit * 2 - 2 or not lower.job_substitutions.push(key) or not lower.job_substitutions.push(value) or not lower.mir.substitutions.push(source_type) or not lower.mir.substitutions.push(target_type) { return sh_l_fail(lower, ast, node, 5001); }; pair = pair + 1; };
    let row = vec_new_i64();
    row.push(function);
    row.push(symbol);
    row.push(template);
    row.push(mir_first);
    row.push(keys.len());
    let recorded = sh_mir_record(&lower.mir, &lower.mir.instances, 5, &row);
    if not recorded.is_ok() { return sh_l_fail(lower, ast, node, recorded.error); };
    sh_l_job(lower, ast, node, function, binding, actual, job_first, keys.len());
    function;
}

def sh_l_drop_function(lower: &ShMirLower, checked: &ShChecked, ty: i64) -> i64 {
    let mut record = 0;
    while record < checked.constraints.len() { if checked.constraints.get(record + 2).unwrap_or(0) == -2 { let target = checked.constraints.get(record).unwrap_or(-1); let name = sh_symbol_text(&checked.symbols, checked.constraints.get(record + 1).unwrap_or(-1)); if sh_s_nominal(checked, sh_s_resolve(checked, target)) == sh_s_nominal(checked, sh_s_resolve(checked, ty)) and name.is_ok() and sh_s_text_equal(&name.value, "Drop") { let owner = checked.constraints.get(record + 3).unwrap_or(-1); let mut binding = 0; while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 2 and sh_binding_word(checked, binding, 6) == owner { let method = sh_symbol_text(&checked.symbols, sh_binding_word(checked, binding, 0)); if method.is_ok() and sh_s_text_equal(&method.value, "drop") { let function = lower.functions.get(binding).unwrap_or(-1); return if function >= 0 { function; } else { -2; }; }; }; binding = binding + 1; }; }; }; record = record + 4; };
    -1;
}

def sh_l_drop_nested(checked: &ShChecked, ast: &ShAst, node: i64, depth: i64) -> bool {
    if node < 0 { return false; };
    let count = sh_ast_count(ast);
    if count < 0 or node >= count { return true; };
    let seen = vec_new_i64();
    let queue = vec_new_i64();
    let mut index = 0;
    while index < count { if not seen.push(0) { return true; }; index = index + 1; };
    if not seen.set(node, 1) or not queue.push(node) { return true; };
    index = 0;
    while index < queue.len() { let current = queue.get(index).unwrap_or(-1); if sh_ast_word(ast, current, 0) == 53 { let binding = sh_node_binding(checked, current); if binding < 0 { return true; }; if sh_binding_word(checked, binding, 2) == 2 { let owner = sh_binding_word(checked, binding, 6); let trait_name = sh_symbol_text(&checked.symbols, sh_s_impl_symbol(checked, owner)); let method = sh_symbol_text(&checked.symbols, sh_binding_word(checked, binding, 0)); if trait_name.is_ok() and method.is_ok() and sh_s_text_equal(&trait_name.value, "Drop") and sh_s_text_equal(&method.value, "drop") { return true; }; let body = sh_s_child_kind(ast, sh_binding_word(checked, binding, 4), 40); if body >= count { return true; }; if body >= 0 and seen.get(body).unwrap_or(0) == 0 { if not seen.set(body, 1) or not queue.push(body) { return true; }; }; }; }; let mut child = 0; while child < sh_ast_word(ast, current, 6) { let next = sh_ast_child(ast, current, child); if next < 0 or next >= count { return true; }; if seen.get(next).unwrap_or(0) == 0 { if not seen.set(next, 1) or not queue.push(next) { return true; }; }; child = child + 1; }; index = index + 1; };
    false;
}

def sh_l_field_type(lower: &mut ShMirLower, checked: &ShChecked, adt: i64, field: i64) -> i64 {
    let actual = sh_resolved_field_type(checked, adt, field);
    sh_l_type(lower, checked, actual, 0);
}

def sh_l_layout(lower: &mut ShMirLower, checked: &ShChecked, adt: i64, owner: i64, variant: i64) {
    let ty = sh_l_type(lower, checked, adt, 0);
    let mut existing = 0;
    while existing < sh_mir_count(&lower.mir.layouts, 7) { if sh_mir_word(&lower.mir.layouts, 7, existing, 0) == ty and sh_mir_word(&lower.mir.layouts, 7, existing, 1) == variant { return; }; existing = existing + 1; };
    let members = vec_new_i64();
    let offsets = vec_new_i64();
    let mut ordinal = 0;
    if variant < 0 { let count = sh_layout_field_count(checked, adt); if count < 0 { lower.error = 5003; return; }; while ordinal < count { let field = sh_layout_field_binding(checked, adt, ordinal); let actual = sh_l_field_type(lower, checked, adt, field); if actual < 0 or not members.push(actual) or not offsets.push(-1) { lower.error = 5003; return; }; ordinal = ordinal + 1; }; } else { let mut searching = true; while searching { searching = false; let mut field = 0; while field < sh_binding_count(checked) { if sh_binding_word(checked, field, 2) == 6 and sh_binding_word(checked, field, 6) == owner and sh_binding_word(checked, field, 7) == ordinal { let actual = sh_l_field_type(lower, checked, adt, field); if actual < 0 or not members.push(actual) or not offsets.push(-1) { lower.error = 5003; return; }; ordinal = ordinal + 1; searching = true; break; }; field = field + 1; }; }; };
    let destructor = if sh_mir_drop_kind(&lower.mir, ty) == 4 { -2; } else { sh_l_drop_function(lower, checked, adt); };
    let stored = sh_mir_add_layout(&lower.mir, ty, variant, &members, &offsets, destructor, -1, -1);
    if not stored.is_ok() { lower.error = stored.error; };
    if variant < 0 { let parent = sh_class_parent(checked, adt); if parent >= 0 and sh_mir_parent(&lower.mir, ty) < 0 { let parent_type = sh_l_type(lower, checked, parent, 0); let row = vec_new_i64(); row.push(ty); row.push(parent_type); let recorded = sh_mir_record(&lower.mir, &lower.mir.parents, 2, &row); if not recorded.is_ok() { lower.error = recorded.error; }; }; };
}

def sh_l_drop_glue(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, adt: i64) {
    let ty = sh_l_type(lower, checked, adt, 0);
    if sh_mir_drop_kind(&lower.mir, ty) >= 0 { return; };
    let owner = sh_adt_binding(checked, adt);
    if owner < 0 { let row = vec_new_i64(); row.push(ty); row.push(4); row.push(-1); let stored = sh_mir_record(&lower.mir, &lower.mir.drop_glues, 3, &row); if not stored.is_ok() { lower.error = stored.error; }; return; };
    let destructor = sh_l_drop_function(lower, checked, adt);
    let mut nested = false;
    if destructor >= 0 { let mut binding = 0; while binding < sh_binding_count(checked) { if lower.functions.get(binding).unwrap_or(-1) == destructor { let body = sh_s_child_kind(ast, sh_binding_word(checked, binding, 4), 40); nested = sh_l_drop_nested(checked, ast, body, 0); break; }; binding = binding + 1; }; };
    let mut kind = 0;
    if destructor >= 0 and not nested { kind = 1; } else { if destructor == -2 or nested or sh_b_runtime_owner(checked, adt) or sh_s_legacy_handle(checked, adt) { kind = 4; } else { if sh_ownership_needs_drop(text, ast, checked, adt) { let mut structural = false; let mut field = 0; while field < sh_binding_count(checked) { let field_owner = sh_binding_word(checked, field, 6); if sh_binding_word(checked, field, 2) == 6 and ((sh_binding_word(checked, owner, 2) == 4 and sh_binding_word(checked, field_owner, 2) == 5 and sh_binding_word(checked, field_owner, 6) == owner) or sh_s_class_ancestor(checked, adt, field_owner) >= 0) { if sh_ownership_needs_drop(text, ast, checked, sh_resolved_field_type(checked, adt, field)) { structural = true; }; }; field = field + 1; }; kind = if structural { if sh_binding_word(checked, owner, 2) == 4 { 3; } else { 2; }; } else { 4; }; }; }; };
    let row = vec_new_i64();
    row.push(ty);
    row.push(kind);
    row.push(if kind == 1 { destructor; } else { -1; });
    let stored = sh_mir_record(&lower.mir, &lower.mir.drop_glues, 3, &row);
    if not stored.is_ok() { lower.error = stored.error; };
}

def sh_l_scope(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, semantic_scope: i64, node: i64, depth: i64) -> i64 {
    if depth >= 128 or semantic_scope < 0 or semantic_scope >= lower.scopes.len() { return sh_l_fail(lower, ast, node, 5002); };
    let existing = lower.scopes.get(semantic_scope).unwrap_or(-1);
    if existing >= 0 { return existing; };
    let parent = sh_scope_word(checked, semantic_scope, 0);
    let owner = sh_scope_word(checked, semantic_scope, 1);
    let mut mapped_parent = sh_mir_fn(&lower.mir, lower.function, 7);
    if parent >= 0 and sh_scope_word(checked, parent, 1) == owner { mapped_parent = sh_l_scope(lower, checked, ast, parent, node, depth + 1); };
    let result = sh_mir_add_scope(&lower.mir, lower.function, mapped_parent, sh_scope_word(checked, semantic_scope, 2));
    let id = sh_l_store(lower, ast, node, result);
    lower.scopes.set(semantic_scope, id);
    id;
}

def sh_l_capture_temporary(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64, value: i64) -> i64 {
    if value < 0 or lower.error != 0 or lower.block < 0 { return value; };
    let mut needed = false;
    let mut owner_scope = lower.scope;
    let mut action = 0;
    while action < sh_ownership_action_count(ownership) { if sh_ownership_action(ownership, action, 1) == -node - 1 { needed = true; if sh_ownership_action(ownership, action, 2) == 1 { owner_scope = sh_l_scope(lower, checked, ast, sh_ownership_action(ownership, action, 3), node, 0); }; }; action = action + 1; };
    if not needed { return value; };
    let ty = sh_mir_value_type(&lower.mir, value);
    let added = sh_mir_add_local(&lower.mir, lower.function, ty, -1, 2, 3, owner_scope, -1, sh_ast_word(ast, node, 1), sh_ast_word(ast, node, 2), sh_ast_word(ast, node, 3));
    let local = sh_l_store(lower, ast, node, added);
    lower.temporaries.set(node, local);
    let address = sh_l_address(lower, checked, ast, node, local, true);
    let args = vec_new_i64();
    args.push(address);
    args.push(value);
    let unit_type = sh_l_type(lower, checked, checked.unit_type, 0);
    sh_l_emit(lower, ast, node, 15, unit_type, &args, 0, 0, 0);
    args.clear();
    sh_l_emit(lower, ast, node, 25, unit_type, &args, local, 1, 0);
    value;
}

def sh_l_unit(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, node: i64) -> i64 {
    let ty = sh_l_type(lower, checked, checked.unit_type, 0);
    let operands = vec_new_i64();
    sh_l_emit(lower, ast, node, 3, ty, &operands, 0, 0, 0);
}

def sh_l_emit(lower: &mut ShMirLower, ast: &ShAst, node: i64, opcode: i64, ty: i64, operands: &Vec<i64>, aux: i64, extra: i64, flags: i64) -> i64 {
    if lower.error != 0 or lower.block < 0 { return -1; };
    let result = sh_mir_add_instruction(&lower.mir, lower.block, opcode, ty, operands, aux, extra, flags, sh_ast_word(ast, node, 1), sh_ast_word(ast, node, 2), sh_ast_word(ast, node, 3));
    sh_l_store(lower, ast, node, result);
}

def sh_l_block(lower: &mut ShMirLower, ast: &ShAst, node: i64, cleanup: bool) -> i64 {
    let result = sh_mir_add_block(&lower.mir, lower.function, lower.scope, if cleanup { 1; } else { 0; }, sh_ast_word(ast, node, 1), sh_ast_word(ast, node, 2), sh_ast_word(ast, node, 3));
    sh_l_store(lower, ast, node, result);
}

def sh_l_term(lower: &mut ShMirLower, ast: &ShAst, node: i64, kind: i64, value: i64) -> i64 {
    if lower.error != 0 or lower.block < 0 { return -1; };
    let result = sh_mir_add_terminator(&lower.mir, lower.block, kind, value, sh_ast_word(ast, node, 1), sh_ast_word(ast, node, 2), sh_ast_word(ast, node, 3));
    sh_l_store(lower, ast, node, result);
}

def sh_l_edge(lower: &mut ShMirLower, ast: &ShAst, node: i64, term: i64, target: i64, value: i64) -> i64 {
    let operands = vec_new_i64();
    if value >= 0 { operands.push(value); (); };
    let result = sh_mir_add_edge(&lower.mir, term, target, &operands, 0, 0);
    sh_l_store(lower, ast, node, result);
}

def sh_l_local(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, binding: i64) -> i64 {
    if binding < 0 or binding >= lower.locals.len() { return -1; };
    lower.locals.get(binding).unwrap_or(-1);
}

def sh_l_address(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, node: i64, local: i64, mutable: bool) -> i64 {
    if local < 0 or local >= sh_mir_local_count(&lower.mir) { return sh_l_fail(lower, ast, node, 5002); };
    let args = vec_new_i64();
    args.push(sh_mir_local(&lower.mir, local, 1));
    let reference = sh_type_intern(&lower.mir.types, 6, 0, if mutable { 1; } else { 0; }, -1, &args);
    if not reference.is_ok() { return sh_l_fail(lower, ast, node, 5001); };
    let operands = vec_new_i64();
    sh_l_emit(lower, ast, node, 13, reference.value, &operands, local, 0, 0);
}

def sh_l_ownership_place(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, ownership: &ShOwnership, node: i64, path: i64, depth: i64) -> i64 {
    if depth >= 128 { return sh_l_fail(lower, ast, node, 5001); };
    let parent = sh_ownership_path_word(ownership, path, 1);
    let binding = sh_ownership_path_word(ownership, path, 0);
    if parent < 0 { let local = if binding >= 0 { sh_l_local(lower, checked, ast, binding); } else { lower.temporaries.get(-binding - 1).unwrap_or(-1); }; return sh_l_address(lower, checked, ast, node, local, true); };
    let base = sh_l_ownership_place(lower, checked, ast, ownership, node, parent, depth + 1);
    let field = sh_ownership_path_word(ownership, path, 2);
    if field == -2 { let reference = sh_mir_type_arg(&lower.mir, sh_mir_value_type(&lower.mir, base), 0); let args = vec_new_i64(); args.push(base); return sh_l_emit(lower, ast, node, 14, reference, &args, 0, 0, 0); };
    let ty = sh_l_type(lower, checked, sh_ownership_path_word(ownership, path, 3), 0);
    let args = vec_new_i64();
    args.push(ty);
    let pointer = sh_type_intern(&lower.mir.types, 6, 0, 1, -1, &args);
    if not pointer.is_ok() { return sh_l_fail(lower, ast, node, 5003); };
    args.clear();
    args.push(base);
    let field_owner = sh_binding_word(checked, field, 6);
    let variant = if sh_binding_word(checked, field_owner, 2) == 5 { sh_binding_word(checked, field_owner, 7); } else { -1; };
    let ordinal = if variant >= 0 { sh_binding_word(checked, field, 7); } else { sh_l_member_ordinal(lower, checked, sh_ownership_path_word(ownership, parent, 3), field); };
    sh_l_emit(lower, ast, node, 17, pointer.value, &args, ordinal, variant, 0);
}

def sh_l_actions_phase(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, ownership: &ShOwnership, node: i64, phase: i64) {
    if lower.block < 0 or lower.error != 0 { return; };
    let mut missing = 0;
    while missing < sh_ownership_action_count(ownership) { let kind = sh_ownership_action(ownership, missing, 2); if sh_ownership_action(ownership, missing, 0) == node and ((kind == 3 and phase == 1) or (kind == 6 and phase == 2) or (kind == 7 and phase == 3) or (kind == 1 or kind == 2) and phase == 0) { let binding = sh_ownership_action(ownership, missing, 1); let local = if binding >= 0 { sh_l_local(lower, checked, ast, binding); } else { lower.temporaries.get(-binding - 1).unwrap_or(-1); }; if local < 0 { sh_l_fail(lower, ast, node, 5008); return; }; }; missing = missing + 1; };
    let mut i = 0;
    while i < sh_ownership_action_count(ownership) { if sh_ownership_action(ownership, i, 0) == node { let kind = sh_ownership_action(ownership, i, 2); let binding = sh_ownership_action(ownership, i, 1); let local = if binding >= 0 { sh_l_local(lower, checked, ast, binding); } else { lower.temporaries.get(-binding - 1).unwrap_or(-1); }; if local >= 0 and ((kind == 3 and phase == 1) or (kind == 6 and phase == 2) or (kind == 7 and phase == 3) or (kind == 1 or kind == 2) and phase == 0) { let unit_ty = sh_l_type(lower, checked, checked.unit_type, 0); let operands = vec_new_i64(); if kind == 3 or kind == 6 or kind == 7 { let cleanup = sh_l_block(lower, ast, node, true); let term = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, term, cleanup, -1); lower.block = cleanup; let path = sh_ownership_action_path(ownership, i); if path >= 0 and sh_ownership_path_word(ownership, path, 1) >= 0 and sh_ownership_action(ownership, i, 4) != 0 { sh_l_fail(lower, ast, node, 5008); return; }; let address = if path >= 0 { sh_l_ownership_place(lower, checked, ast, ownership, node, path, 0); } else { sh_l_address(lower, checked, ast, node, local, true); }; operands.push(address); let drop_type = sh_mir_type_arg(&lower.mir, sh_mir_value_type(&lower.mir, address), 0); sh_l_emit(lower, ast, node, 21, unit_ty, &operands, if path >= 0 { -1; } else { local; }, drop_type, sh_ownership_action(ownership, i, 4)); (); } else { let action_path = sh_ownership_action_path(ownership, i); if action_path < 0 or sh_ownership_path_word(ownership, action_path, 1) < 0 { sh_l_emit(lower, ast, node, 25, unit_ty, &operands, local, if kind == 1 { 1; } else { 0; }, 0); (); }; }; }; }; i = i + 1; };
}

def sh_l_actions(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, ownership: &ShOwnership, node: i64, drops: bool) {
    sh_l_actions_phase(lower, checked, ast, ownership, node, if drops { 1; } else { 0; });
}

def sh_l_literal(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, node: i64) -> i64 {
    let ty = sh_l_node_type(lower, checked, ast, node);
    sh_l_literal_as(lower, text, ast, checked, node, ty);
}

def sh_l_literal_as(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, node: i64, ty: i64) -> i64 {
    let kind = sh_mir_type_word(&lower.mir, ty, 0);
    let token_kind = sh_ast_word(ast, node, 4);
    let args = vec_new_i64();
    if kind == 1 { return sh_l_emit(lower, ast, node, 6, ty, &args, if token_kind == sh_kind("true") { 1; } else { 0; }, 0, 0); (); };
    let token = ShToken { kind: token_kind, start: sh_ast_word(ast, node, 2), end: sh_ast_word(ast, node, 3) };
    if kind == 4 or kind == 5 or kind == 6 or kind == 9 { let decoded = sh_literal_decode(text, token); if not decoded.is_ok() { return sh_l_fail(lower, ast, node, 5003); }; if kind == 4 { let bytes = sh_lex_bytes(&decoded.value); if not bytes.is_ok() { return sh_l_fail(lower, ast, node, 5001); }; let scalar = sh_lex_utf8(&bytes.value, 0); return sh_l_emit(lower, ast, node, 7, ty, &args, scalar.value, 0, 0); (); }; let symbol = sh_intern(&lower.mir.symbols, &decoded.value); if not symbol.is_ok() { return sh_l_fail(lower, ast, node, 5001); }; return sh_l_emit(lower, ast, node, 8, ty, &args, symbol.value, 0, 0); (); };
    let raw = sh_s_name(text, ast, node);
    if not raw.is_ok() { return sh_l_fail(lower, ast, node, 5002); };
    if kind == 3 { let symbol = sh_intern(&lower.mir.symbols, &raw.value); if not symbol.is_ok() { return sh_l_fail(lower, ast, node, 5001); }; return sh_l_emit(lower, ast, node, 5, ty, &args, symbol.value, 0, 1); (); };
    if kind != 2 { return sh_l_fail(lower, ast, node, 5008); };
    let bytes = sh_lex_bytes(&raw.value);
    if not bytes.is_ok() { return sh_l_fail(lower, ast, node, 5001); };
    let mut index = 0;
    let mut base: u64 = 10 as u64;
    if raw.value.len() > 2 and sh_lex_byte(&bytes.value, 0) == 48 { let prefix = sh_lex_byte(&bytes.value, 1); if prefix == 120 or prefix == 88 { base = 16 as u64; index = 2; }; if prefix == 98 or prefix == 66 { base = 2 as u64; index = 2; }; if prefix == 111 or prefix == 79 { base = 8 as u64; index = 2; }; };
    let mut value: u64 = 0 as u64;
    let mut digits = 0;
    while index < raw.value.len() { let byte = sh_lex_byte(&bytes.value, index); if byte == 95 { index = index + 1; continue; }; let digit = sh_lex_hex(byte); if digit < 0 or digit as u64 >= base { break; }; value = value * base + digit as u64; digits = digits + 1; index = index + 1; };
    if digits == 0 { return sh_l_fail(lower, ast, node, 5003); };
    sh_l_emit(lower, ast, node, 4, ty, &args, value as i64, 0, 0);
}

def sh_l_member_ordinal(lower: &ShMirLower, checked: &ShChecked, input: i64, binding: i64) -> i64 {
    let applied = if lower.generic_keys.len() > 0 { sh_s_type_replace(checked, input, &lower.generic_keys, &lower.generic_values, 0); } else { input; };
    let actual = sh_s_resolve(checked, applied);
    let base = if sh_s_kind(checked, actual) == 6 or sh_s_kind(checked, actual) == 7 { sh_s_argument(checked, actual, 0); } else { actual; };
    let count = sh_layout_field_count(checked, base);
    let mut index = 0;
    while index < count { if sh_layout_field_binding(checked, base, index) == binding { return index; }; index = index + 1; };
    -1;
}

def sh_l_field_ordinal(lower: &ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, node: i64) -> i64 {
    let binding = sh_node_binding(checked, node);
    if binding >= 0 and sh_binding_word(checked, binding, 2) == 6 { return sh_l_member_ordinal(lower, checked, sh_node_type(checked, sh_ast_child(ast, node, 0)), binding); };
    let name = sh_s_name(text, ast, sh_ast_child(ast, node, 1));
    if not name.is_ok() { return -1; };
    let bytes = sh_lex_bytes(&name.value);
    if not bytes.is_ok() { return -1; };
    let mut value = 0;
    let mut index = 0;
    while index < name.value.len() { let byte = sh_lex_byte(&bytes.value, index); if not sh_lex_digit(byte) or value > 100000 { return -1; }; value = value * 10 + byte - 48; index = index + 1; };
    value;
}

def sh_l_place(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64, mutable: bool) -> i64 {
    let kind = sh_ast_word(ast, node, 0);
    if kind == 12 { let local = sh_l_local(lower, checked, ast, sh_node_binding(checked, node)); return sh_l_address(lower, checked, ast, node, local, mutable); };
    if kind == 50 and sh_ast_word(ast, node, 4) % 1000 == sh_kind("*") { return sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0)); };
    if kind == 55 or kind == 54 { let base_node = sh_ast_child(ast, node, 0); let base_type = sh_s_resolve(checked, sh_node_type(checked, base_node)); let base = if sh_s_kind(checked, base_type) == 6 or sh_s_kind(checked, base_type) == 7 { sh_l_expr(lower, text, ast, checked, ownership, base_node); } else { sh_l_place(lower, text, ast, checked, ownership, base_node, mutable); }; let ty = sh_l_node_type(lower, checked, ast, node); let params = vec_new_i64(); params.push(ty); let pointer_kind = sh_mir_type_word(&lower.mir, sh_mir_value_type(&lower.mir, base), 0); let pointer = sh_type_intern(&lower.mir.types, pointer_kind, 0, if mutable { 1; } else { 0; }, -1, &params); if not pointer.is_ok() { return sh_l_fail(lower, ast, node, 5003); }; let operands = vec_new_i64(); operands.push(base); if kind == 55 { let binding = sh_node_binding(checked, node); return sh_l_emit(lower, ast, node, 17, pointer.value, &operands, sh_l_field_ordinal(lower, text, ast, checked, node), -1, 0); (); }; let index = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 1)); operands.push(index); return sh_l_emit(lower, ast, node, 19, pointer.value, &operands, 0, 0, 0); (); };
    let value = sh_l_expr(lower, text, ast, checked, ownership, node);
    let temporary = lower.temporaries.get(node).unwrap_or(-1);
    if value >= 0 and temporary >= 0 { return sh_l_address(lower, checked, ast, node, temporary, mutable); };
    sh_l_fail(lower, ast, node, 5008);
}

def sh_l_if(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64) -> i64 {
    let condition = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0));
    let left = sh_l_block(lower, ast, node, false);
    let right = sh_l_block(lower, ast, node, false);
    let join = sh_l_block(lower, ast, node, false);
    let ty = sh_l_node_type(lower, checked, ast, node);
    let empty = vec_new_i64();
    let old = lower.block;
    lower.block = join;
    let merged = if sh_mir_type_word(&lower.mir, ty, 0) != 17 { sh_l_emit(lower, ast, node, 2, ty, &empty, 0, 0, 0); } else { -1; };
    lower.block = old;
    let term = sh_l_term(lower, ast, node, 2, condition);
    sh_l_edge(lower, ast, node, term, left, -1);
    sh_l_edge(lower, ast, node, term, right, -1);
    lower.block = left;
    let mut left_value = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 1));
    if lower.block >= 0 { if sh_mir_type_word(&lower.mir, ty, 0) == 0 { left_value = sh_l_unit(lower, checked, ast, node); }; let leave = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, leave, join, left_value); (); };
    lower.block = right;
    let right_node = sh_ast_child(ast, node, 2);
    let mut right_value = if right_node >= 0 { sh_l_expr(lower, text, ast, checked, ownership, right_node); } else { sh_l_unit(lower, checked, ast, node); };
    if lower.block >= 0 { if sh_mir_type_word(&lower.mir, ty, 0) == 0 { right_value = sh_l_unit(lower, checked, ast, node); }; let leave = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, leave, join, right_value); (); };
    lower.block = join;
    if merged < 0 { sh_l_term(lower, ast, node, 4, -1); lower.block = -1; };
    merged;
}

def sh_l_loop(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64) -> i64 {
    let kind = sh_ast_word(ast, node, 0);
    let header = sh_l_block(lower, ast, node, false);
    let body = sh_l_block(lower, ast, node, false);
    let exit = sh_l_block(lower, ast, node, false);
    let old = lower.block;
    let ty = sh_l_node_type(lower, checked, ast, node);
    let empty = vec_new_i64();
    lower.block = exit;
    let result = if sh_mir_type_word(&lower.mir, ty, 0) != 17 { sh_l_emit(lower, ast, node, 2, ty, &empty, 0, 0, 0); } else { -1; };
    lower.block = old;
    let enter = sh_l_term(lower, ast, node, 1, -1);
    sh_l_edge(lower, ast, node, enter, header, -1);
    lower.block = header;
    if kind == 62 { let condition = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0)); let unit = sh_l_unit(lower, checked, ast, node); let branch = sh_l_term(lower, ast, node, 2, condition); sh_l_edge(lower, ast, node, branch, body, -1); sh_l_edge(lower, ast, node, branch, exit, unit); (); } else { let branch = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, branch, body, -1); (); };
    let loop_start = lower.loops.len();
    lower.loops.push(header);
    lower.loops.push(exit);
    lower.loops.push(ty);
    lower.block = body;
    sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, if kind == 62 { 1; } else { 0; }));
    if lower.block >= 0 { let back = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, back, header, -1); (); };
    sh_mir_trim(&lower.loops, loop_start);
    lower.block = exit;
    if result < 0 { sh_l_term(lower, ast, node, 4, -1); lower.block = -1; };
    result;
}

def sh_l_jump(lower: &mut ShMirLower, ast: &ShAst, node: i64, target: i64) {
    let term = sh_l_term(lower, ast, node, 1, -1);
    sh_l_edge(lower, ast, node, term, target, -1);
    ();
}

def sh_l_test(lower: &mut ShMirLower, ast: &ShAst, node: i64, condition: i64, yes: i64, no: i64) {
    let term = sh_l_term(lower, ast, node, 2, condition);
    sh_l_edge(lower, ast, node, term, yes, -1);
    sh_l_edge(lower, ast, node, term, no, -1);
    ();
}

def sh_l_binary(lower: &mut ShMirLower, ast: &ShAst, node: i64, ty: i64, op: i64, a: i64, b: i64) -> i64 {
    let args = vec_new_i64();
    args.push(a);
    args.push(b);
    sh_l_emit(lower, ast, node, 11, ty, &args, op, 0, 0);
}

def sh_l_pattern(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, pattern: i64, value: i64, yes: i64, no: i64, depth: i64) {
    if lower.error != 0 { return; };
    if depth >= 128 { sh_l_fail(lower, ast, pattern, 5001); return; };
    let kind = sh_ast_word(ast, pattern, 0);
    let payload = sh_ast_word(ast, pattern, 4);
    let first = sh_ast_child(ast, pattern, 0);
    let mut binding = sh_node_binding(checked, pattern);
    if binding < 0 { binding = sh_node_binding(checked, first); };
    if kind == 10 or kind == 80 and payload == 0 and sh_binding_word(checked, binding, 2) == 0 { let local = sh_l_local(lower, checked, ast, binding); let address = sh_l_address(lower, checked, ast, pattern, local, true); let args = vec_new_i64(); args.push(address); args.push(value); let unit_ty = sh_l_type(lower, checked, checked.unit_type, 0); sh_l_emit(lower, ast, pattern, 15, unit_ty, &args, 0, 0, 0); args.clear(); sh_l_emit(lower, ast, pattern, 25, unit_ty, &args, local, 1, 0); sh_l_jump(lower, ast, pattern, yes); return; };
    if kind != 80 { sh_l_fail(lower, ast, pattern, 5008); return; };
    if payload == 2 { sh_l_jump(lower, ast, pattern, yes); return; };
    let boolean = sh_l_type(lower, checked, checked.bool_type, 0);
    if sh_ast_word(ast, first, 0) == 11 { let value_type = sh_mir_value_type(&lower.mir, value); let literal = sh_l_literal_as(lower, text, ast, checked, first, value_type); let condition = sh_l_binary(lower, ast, pattern, boolean, sh_kind("=="), value, literal); sh_l_test(lower, ast, pattern, condition, yes, no); return; };
    let tuple = payload == sh_kind("(") or payload == sh_kind("[");
    let variant = if sh_binding_word(checked, binding, 2) == 5 { sh_binding_word(checked, binding, 7); } else { -1; };
    if not tuple and variant < 0 { sh_l_fail(lower, ast, pattern, 5008); return; };
    if variant >= 0 { let args = vec_new_i64(); args.push(value); let integer = sh_l_type(lower, checked, checked.integer_type, 0); let tag = sh_l_emit(lower, ast, pattern, 23, integer, &args, 0, 0, 0); args.clear(); let ordinal = sh_l_emit(lower, ast, pattern, 4, integer, &args, variant, 0, 0); let condition = sh_l_binary(lower, ast, pattern, boolean, sh_kind("=="), tag, ordinal); let matched = sh_l_block(lower, ast, pattern, false); sh_l_test(lower, ast, pattern, condition, matched, no); lower.block = matched; };
    let mut index = if tuple { 0; } else { 1; };
    let count = sh_ast_word(ast, pattern, 6);
    let mut ordinal = 0;
    while lower.error == 0 and index < count { let child = sh_ast_child(ast, pattern, index); let ty = sh_mir_field_type(&lower.mir, sh_mir_value_type(&lower.mir, value), variant, ordinal); let args = vec_new_i64(); args.push(value); let field = sh_l_emit(lower, ast, child, 18, ty, &args, ordinal, variant, 0); let next = if index + 1 == count { yes; } else { sh_l_block(lower, ast, child, false); }; sh_l_pattern(lower, text, ast, checked, ownership, child, field, next, no, depth + 1); if index + 1 < count { lower.block = next; }; index = index + 1; ordinal = ordinal + 1; };
    let minimum = if tuple { 0; } else { 1; };
    if count == minimum { sh_l_jump(lower, ast, pattern, yes); };
}

def sh_l_match(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64) -> i64 {
    let subject = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0));
    let ty = sh_l_node_type(lower, checked, ast, node);
    let join = sh_l_block(lower, ast, node, false);
    let saved = lower.block;
    lower.block = join;
    let args = vec_new_i64();
    let result = if sh_mir_type_word(&lower.mir, ty, 0) != 17 { sh_l_emit(lower, ast, node, 2, ty, &args, 0, 0, 0); } else { -1; };
    lower.block = saved;
    let mut index = 1;
    while lower.error == 0 and index < sh_ast_word(ast, node, 6) { let arm = sh_ast_child(ast, node, index); let body = sh_l_block(lower, ast, arm, false); let next = sh_l_block(lower, ast, arm, false); sh_l_pattern(lower, text, ast, checked, ownership, sh_ast_child(ast, arm, 0), subject, body, next, 0); lower.block = body; let count = sh_ast_word(ast, arm, 6); if count == 3 { let guard = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, arm, 1)); let accepted = sh_l_block(lower, ast, arm, false); sh_l_test(lower, ast, arm, guard, accepted, next); lower.block = accepted; }; sh_l_actions(lower, checked, ast, ownership, arm, false); let value = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, arm, count - 1)); if lower.block >= 0 { sh_l_actions(lower, checked, ast, ownership, arm, true); let leave = sh_l_term(lower, ast, arm, 1, -1); sh_l_edge(lower, ast, arm, leave, join, value); (); }; lower.block = next; index = index + 1; };
    sh_l_term(lower, ast, node, 4, -1);
    lower.block = join;
    if result < 0 { sh_l_term(lower, ast, node, 4, -1); lower.block = -1; };
    result;
}

def sh_l_call(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64, ty: i64) -> i64 {
    let declared = sh_node_callable_type(checked, node);
    let concrete = if lower.generic_keys.len() > 0 { sh_s_type_replace(checked, declared, &lower.generic_keys, &lower.generic_values, 0); } else { sh_s_resolve(checked, declared); };
    let binding = sh_l_resolved_callable(lower, checked, ast, node, concrete);
    let mut function = lower.functions.get(binding).unwrap_or(-1);
    if function < 0 and sh_binding_word(checked, binding, 2) == 2 { function = sh_l_instance(lower, text, ast, checked, node, binding, concrete); };
    let constructor = sh_binding_word(checked, binding, 2) == 5;
    let operands = vec_new_i64();
    let callee = sh_ast_child(ast, node, 0);
    let mut signature = -1;
    if function >= 0 { signature = sh_mir_fn(&lower.mir, function, 1); if sh_ast_word(ast, callee, 0) == 55 { let receiver = sh_ast_child(ast, callee, 0); let actual = sh_l_node_type(lower, checked, ast, receiver); let required = sh_mir_type_arg(&lower.mir, signature, 0); let value_raw = if sh_mir_type_word(&lower.mir, required, 0) == 6 and sh_mir_type_word(&lower.mir, actual, 0) != 6 { sh_l_place(lower, text, ast, checked, ownership, receiver, sh_mir_type_word(&lower.mir, required, 2) == 1); } else { sh_l_expr(lower, text, ast, checked, ownership, receiver); }; let value = sh_l_coerce(lower, ast, receiver, value_raw, required); operands.push(value); (); }; } else { if not constructor { let value = sh_l_expr(lower, text, ast, checked, ownership, callee); operands.push(value); signature = sh_mir_value_type(&lower.mir, value); }; };
    let mut index = 1;
    while index < sh_ast_word(ast, node, 6) { let argument = sh_ast_child(ast, node, index); if sh_ast_word(ast, argument, 0) == 10 { return sh_l_fail(lower, ast, node, 5008); }; let raw = sh_l_expr(lower, text, ast, checked, ownership, argument); let ordinal = index - 1 + if sh_ast_word(ast, callee, 0) == 55 { 1; } else { 0; }; let required = if signature >= 0 and ordinal < sh_mir_type_word(&lower.mir, signature, 5) - 1 { sh_mir_type_arg(&lower.mir, signature, ordinal); } else { sh_mir_value_type(&lower.mir, raw); }; let value = sh_l_coerce(lower, ast, argument, raw, required); operands.push(value); index = index + 1; };
    if constructor { return sh_l_emit(lower, ast, node, 24, ty, &operands, sh_binding_word(checked, binding, 7), 0, 0); };
    sh_l_emit(lower, ast, node, 20, ty, &operands, function, sh_mir_type_word(&lower.mir, signature, 1), 0);
}

def sh_l_resolved_callable(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, node: i64, signature: i64) -> i64 {
    let selected = sh_node_binding(checked, node);
    let owner = sh_binding_word(checked, selected, 6);
    if sh_binding_word(checked, owner, 2) != 7 { return selected; };
    let trait_symbol = sh_binding_word(checked, owner, 0);
    let method_symbol = sh_binding_word(checked, selected, 0);
    let left = sh_s_argument(checked, signature, 0);
    let actual = if sh_s_kind(checked, left) == 6 { sh_s_argument(checked, left, 0); } else { left; };
    let mut found = -1;
    let mut record = 0;
    while record < checked.constraints.len() { if checked.constraints.get(record + 1).unwrap_or(-1) == trait_symbol and checked.constraints.get(record + 2).unwrap_or(0) == -2 { let implementation = checked.constraints.get(record + 3).unwrap_or(-1); let keys = vec_new_i64(); let values = vec_new_i64(); if (sh_binding_word(checked, implementation, 5) & 8) == 0 and sh_s_pattern_keys(checked, checked.constraints.get(record).unwrap_or(-1), actual, &keys, &values, 0) { let mut binding = 0; while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 2 and sh_binding_word(checked, binding, 6) == implementation and sh_binding_word(checked, binding, 0) == method_symbol { let pattern = sh_s_type_replace(checked, sh_binding_word(checked, binding, 3), &keys, &values, 0); let fn_keys = vec_new_i64(); let fn_values = vec_new_i64(); if sh_s_pattern_keys(checked, pattern, signature, &fn_keys, &fn_values, 0) { if found >= 0 and found != binding { return sh_l_fail(lower, ast, node, 5009); }; found = binding; }; }; binding = binding + 1; }; }; }; record = record + 4; };
    if found < 0 { sh_l_fail(lower, ast, node, 5009); } else { found; };
}

def sh_l_operator(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64, ty: i64) -> i64 {
    let declared = sh_node_callable_type(checked, node);
    let signature = if lower.generic_keys.len() > 0 { sh_s_type_replace(checked, declared, &lower.generic_keys, &lower.generic_values, 0); } else { sh_s_resolve(checked, declared); };
    let count = sh_ast_word(ast, node, 6);
    let first_type = sh_l_node_type(lower, checked, ast, sh_ast_child(ast, node, 0));
    let primitive = sh_mir_type_word(&lower.mir, first_type, 0);
    if primitive == 2 or primitive == 3 { let operands = vec_new_i64(); let mut index = 0; while index < count { operands.push(sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, index))); index = index + 1; }; return sh_l_emit(lower, ast, node, if count == 1 { 10; } else { 11; }, ty, &operands, sh_ast_word(ast, node, 4), 0, 0); };
    let binding = sh_l_resolved_callable(lower, checked, ast, node, signature);
    if binding < 0 { return -1; };
    let mut function = lower.functions.get(binding).unwrap_or(-1);
    if function < 0 { function = sh_l_instance(lower, text, ast, checked, node, binding, signature); };
    if function < 0 { return -1; };
    let mir_signature = sh_mir_fn(&lower.mir, function, 1);
    let operands = vec_new_i64();
    let mut index = 0;
    while index < count { let operand = sh_ast_child(ast, node, index); let actual = sh_l_node_type(lower, checked, ast, operand); let required = sh_mir_type_arg(&lower.mir, mir_signature, index); let raw = if sh_mir_type_word(&lower.mir, required, 0) == 6 and sh_mir_type_word(&lower.mir, actual, 0) != 6 { sh_l_place(lower, text, ast, checked, ownership, operand, sh_mir_type_word(&lower.mir, required, 2) == 1); } else { sh_l_expr(lower, text, ast, checked, ownership, operand); }; operands.push(sh_l_coerce(lower, ast, operand, raw, required)); index = index + 1; };
    sh_l_emit(lower, ast, node, 20, ty, &operands, function, sh_mir_type_word(&lower.mir, mir_signature, 1), 0);
}

def sh_l_coerce(lower: &mut ShMirLower, ast: &ShAst, node: i64, value: i64, expected: i64) -> i64 {
    let actual = sh_mir_value_type(&lower.mir, value);
    if actual == expected or expected < 0 { return value; };
    if sh_mir_type_word(&lower.mir, actual, 0) == 6 and sh_mir_type_word(&lower.mir, expected, 0) == 6 and sh_mir_type_word(&lower.mir, expected, 2) <= sh_mir_type_word(&lower.mir, actual, 2) { let source = sh_mir_type_arg(&lower.mir, actual, 0); let target = sh_mir_type_arg(&lower.mir, expected, 0); if sh_mir_type_word(&lower.mir, source, 1) == 2 and sh_mir_type_word(&lower.mir, target, 1) == 2 and sh_mir_class_ancestor(&lower.mir, source, target) { let operands = vec_new_i64(); operands.push(value); return sh_l_emit(lower, ast, node, 12, expected, &operands, 0, 0, 2); }; };
    value;
}

def sh_l_internal(lower: &mut ShMirLower, ast: &ShAst, node: i64, ty: i64) -> i64 {
    let added = sh_mir_add_local(&lower.mir, lower.function, ty, -1, 2, 1, lower.scope, -1, sh_ast_word(ast, node, 1), sh_ast_word(ast, node, 2), sh_ast_word(ast, node, 3));
    sh_l_store(lower, ast, node, added);
}

def sh_l_write(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, node: i64, local: i64, value: i64) {
    let address = sh_l_address(lower, checked, ast, node, local, true);
    let args = vec_new_i64();
    args.push(address);
    args.push(value);
    let unit_ty = sh_l_type(lower, checked, checked.unit_type, 0);
    sh_l_emit(lower, ast, node, 15, unit_ty, &args, 0, 0, 0);
    ();
}

def sh_l_for(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64) -> i64 {
    let source = sh_ast_child(ast, node, 1);
    let source_type = sh_s_resolve(checked, sh_node_type(checked, source));
    let base_type = if sh_s_kind(checked, source_type) == 6 { sh_s_argument(checked, source_type, 0); } else { source_type; };
    let range = sh_ast_word(ast, source, 0) == 51 and (sh_ast_word(ast, source, 4) == sh_kind("..") or sh_ast_word(ast, source, 4) == 1242);
    let array = sh_s_kind(checked, base_type) == 8;
    if not range and not array { return sh_l_fail(lower, ast, source, 5008); };
    let mut initial = -1;
    let mut end = -1;
    let mut array_address = -1;
    let mut integer = sh_l_type(lower, checked, checked.integer_type, 0);
    let empty = vec_new_i64();
    if range { initial = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, source, 0)); end = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, source, 1)); integer = sh_mir_value_type(&lower.mir, initial); } else { let actual = sh_l_expr(lower, text, ast, checked, ownership, source); let element = sh_s_argument(checked, base_type, 0); if sh_ownership_needs_drop(text, ast, checked, element) { return sh_l_fail(lower, ast, source, 5008); }; if sh_s_kind(checked, source_type) == 6 { array_address = actual; } else { let actual_type = sh_mir_value_type(&lower.mir, actual); let local = sh_l_internal(lower, ast, source, actual_type); sh_l_write(lower, checked, ast, source, local, actual); array_address = sh_l_address(lower, checked, ast, source, local, false); }; initial = sh_l_emit(lower, ast, node, 4, integer, &empty, 0, 0, 0); end = sh_l_emit(lower, ast, node, 4, integer, &empty, sh_s_data(checked, base_type), 0, 0); };
    let counter = sh_l_internal(lower, ast, node, integer);
    sh_l_write(lower, checked, ast, node, counter, initial);
    let header = sh_l_block(lower, ast, node, false);
    let body = sh_l_block(lower, ast, node, false);
    let advance = sh_l_block(lower, ast, node, false);
    let exit = sh_l_block(lower, ast, node, false);
    let bad_pattern = sh_l_block(lower, ast, node, false);
    sh_l_jump(lower, ast, node, header);
    lower.block = header;
    let address = sh_l_address(lower, checked, ast, node, counter, false);
    let args = vec_new_i64();
    args.push(address);
    let current = sh_l_emit(lower, ast, node, 14, integer, &args, 0, 0, 0);
    let boolean = sh_l_type(lower, checked, checked.bool_type, 0);
    let inclusive = range and sh_ast_word(ast, source, 4) == 1242;
    let condition = sh_l_binary(lower, ast, node, boolean, if inclusive { sh_kind("<="); } else { sh_kind("<"); }, current, end);
    sh_l_test(lower, ast, node, condition, body, exit);
    let stack = lower.loops.len();
    lower.loops.push(advance);
    lower.loops.push(exit);
    let loop_unit = sh_l_type(lower, checked, checked.unit_type, 0);
    lower.loops.push(loop_unit);
    lower.block = body;
    let mut item = current;
    if array { let element = sh_l_type(lower, checked, sh_s_argument(checked, base_type, 0), 0); let pointers = vec_new_i64(); pointers.push(element); let pointer = sh_type_intern(&lower.mir.types, 6, 0, 0, -1, &pointers); if not pointer.is_ok() { return sh_l_fail(lower, ast, node, 5003); }; args.clear(); args.push(array_address); args.push(current); let place = sh_l_emit(lower, ast, node, 19, pointer.value, &args, 0, 0, 0); args.clear(); args.push(place); item = sh_l_emit(lower, ast, node, 14, element, &args, 0, 0, 0); };
    let actual_body = sh_l_block(lower, ast, node, false);
    sh_l_pattern(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0), item, actual_body, bad_pattern, 0);
    lower.block = actual_body;
    sh_l_actions(lower, checked, ast, ownership, node, false);
    sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 2));
    if lower.block >= 0 { sh_l_jump(lower, ast, node, advance); };
    sh_mir_trim(&lower.loops, stack);
    lower.block = bad_pattern;
    sh_l_term(lower, ast, node, 4, -1);
    lower.block = advance;
    let mut incoming = false;
    let mut edge = 0;
    while edge < sh_mir_edge_count(&lower.mir) { if sh_mir_edge(&lower.mir, edge, 1) == advance { incoming = true; }; edge = edge + 1; };
    if incoming { if inclusive { let done = sh_l_binary(lower, ast, node, boolean, sh_kind("=="), current, end); let increment = sh_l_block(lower, ast, node, false); sh_l_test(lower, ast, node, done, exit, increment); lower.block = increment; }; let one = sh_l_emit(lower, ast, node, 4, integer, &empty, 1, 0, 0); let next = sh_l_binary(lower, ast, node, integer, sh_kind("+"), current, one); sh_l_write(lower, checked, ast, node, counter, next); sh_l_jump(lower, ast, node, header); } else { sh_l_term(lower, ast, node, 4, -1); (); };
    lower.block = exit;
    sh_l_unit(lower, checked, ast, node);
}

def sh_l_wrapper_kind(lower: &ShMirLower, ty: i64) -> i64 {
    if sh_mir_type_word(&lower.mir, ty, 0) != 12 or sh_mir_type_word(&lower.mir, ty, 1) != 0 { return -1; };
    let name = sh_symbol_text(&lower.mir.symbols, sh_mir_type_word(&lower.mir, ty, 3));
    if not name.is_ok() { return -1; };
    if sh_s_text_equal(&name.value, "Result") and sh_mir_type_word(&lower.mir, ty, 5) == 2 { return 1; };
    if sh_s_text_equal(&name.value, "Option") and sh_mir_type_word(&lower.mir, ty, 5) == 1 { return 2; };
    -1;
}

def sh_l_wrapper_field(lower: &ShMirLower, checked: &ShChecked, ty: i64, role: i64) -> i64 {
    let mode = sh_l_wrapper_kind(lower, ty);
    if mode < 0 { return -1; };
    let symbol = sh_mir_type_word(&lower.mir, ty, 3);
    let mut owner = sh_binding_count(checked) - 1;
    while owner >= 0 { if sh_binding_word(checked, owner, 2) == 3 and sh_binding_word(checked, owner, 0) == symbol { break; }; owner = owner - 1; };
    if owner < 0 or sh_mir_field_count(&lower.mir, ty, -1) != if mode == 1 { 3; } else { 2; } { return -1; };
    let label = if role == 0 { if mode == 1 { "is_ok"; } else { "is_some"; }; } else { if role == 1 { "value"; } else { "error"; }; };
    let mut field = 0;
    while field < sh_binding_count(checked) { if sh_binding_word(checked, field, 2) == 6 and sh_binding_word(checked, field, 6) == owner { let name = sh_symbol_text(&checked.symbols, sh_binding_word(checked, field, 0)); if name.is_ok() and sh_s_text_equal(&name.value, label) { return sh_binding_word(checked, field, 7); }; }; field = field + 1; };
    -1;
}

def sh_l_extract(lower: &mut ShMirLower, ast: &ShAst, node: i64, value: i64, field: i64) -> i64 {
    let aggregate_type = sh_mir_value_type(&lower.mir, value);
    let ty = sh_mir_field_type(&lower.mir, aggregate_type, -1, field);
    let args = vec_new_i64();
    args.push(value);
    sh_l_emit(lower, ast, node, 18, ty, &args, field, -1, 0);
}

def sh_l_zero(lower: &mut ShMirLower, ast: &ShAst, node: i64, ty: i64, depth: i64) -> i64 {
    if depth >= 128 { return sh_l_fail(lower, ast, node, 5001); };
    let kind = sh_mir_type_word(&lower.mir, ty, 0);
    let empty = vec_new_i64();
    if kind == 0 { return sh_l_emit(lower, ast, node, 3, ty, &empty, 0, 0, 0); };
    if kind == 1 { return sh_l_emit(lower, ast, node, 6, ty, &empty, 0, 0, 0); };
    if kind == 2 { return sh_l_emit(lower, ast, node, 4, ty, &empty, 0, 0, 0); };
    if kind == 3 { return sh_l_emit(lower, ast, node, 5, ty, &empty, 0, 0, 0); };
    if kind == 4 { return sh_l_emit(lower, ast, node, 7, ty, &empty, 0, 0, 0); };
    if kind != 8 and kind != 10 and kind != 12 { return sh_l_fail(lower, ast, node, 5008); };
    let variant = if kind == 12 and sh_mir_type_word(&lower.mir, ty, 1) == 1 { 0; } else { -1; };
    let count = sh_mir_field_count(&lower.mir, ty, variant);
    if count < 0 or count > lower.mir.limit { return sh_l_fail(lower, ast, node, 5003); };
    let mut field = 0;
    while lower.error == 0 and field < count { let member = sh_mir_field_type(&lower.mir, ty, variant, field); let value = sh_l_zero(lower, ast, node, member, depth + 1); if not empty.push(value) { return sh_l_fail(lower, ast, node, 5001); }; field = field + 1; };
    sh_l_emit(lower, ast, node, if variant >= 0 { 24; } else { 16; }, ty, &empty, variant, 0, 0);
}

def sh_l_wrap(lower: &mut ShMirLower, checked: &ShChecked, ast: &ShAst, node: i64, ty: i64, success: bool, value: i64, error: i64) -> i64 {
    let mode = sh_l_wrapper_kind(lower, ty);
    let flag_field = sh_l_wrapper_field(lower, checked, ty, 0);
    let value_field = sh_l_wrapper_field(lower, checked, ty, 1);
    let error_field = if mode == 1 { sh_l_wrapper_field(lower, checked, ty, 2); } else { -1; };
    if mode < 0 or flag_field < 0 or value_field < 0 or mode == 1 and error_field < 0 { return sh_l_fail(lower, ast, node, 5008); };
    let flag_type = sh_mir_field_type(&lower.mir, ty, -1, flag_field);
    if sh_mir_type_word(&lower.mir, flag_type, 0) != 1 { return sh_l_fail(lower, ast, node, 5003); };
    let args = vec_new_i64();
    let mut field = 0;
    while field < sh_mir_field_count(&lower.mir, ty, -1) { args.push(-1); field = field + 1; };
    let empty = vec_new_i64();
    let flag = sh_l_emit(lower, ast, node, 6, flag_type, &empty, if success { 1; } else { 0; }, 0, 0);
    args.set(flag_field, flag);
    let payload = if success { value; } else { let member = sh_mir_field_type(&lower.mir, ty, -1, value_field); sh_l_zero(lower, ast, node, member, 0); };
    args.set(value_field, payload);
    if mode == 1 { let failure = if success { let member = sh_mir_field_type(&lower.mir, ty, -1, error_field); sh_l_zero(lower, ast, node, member, 0); } else { error; }; args.set(error_field, failure); (); };
    sh_l_emit(lower, ast, node, 16, ty, &args, -1, 0, 0);
}

def sh_l_question(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64) -> i64 {
    let operand = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0));
    let operand_type = sh_mir_value_type(&lower.mir, operand);
    let mode = sh_l_wrapper_kind(lower, operand_type);
    let flag_field = sh_l_wrapper_field(lower, checked, operand_type, 0);
    let value_field = sh_l_wrapper_field(lower, checked, operand_type, 1);
    if mode < 0 or flag_field < 0 or value_field < 0 { return sh_l_fail(lower, ast, node, 5008); };
    let flag = sh_l_extract(lower, ast, node, operand, flag_field);
    let success = sh_l_block(lower, ast, node, false);
    let failure = sh_l_block(lower, ast, node, false);
    sh_l_test(lower, ast, node, flag, success, failure);
    lower.block = failure;
    let in_try = lower.try_blocks.len() >= 2;
    let signature = sh_mir_fn(&lower.mir, lower.function, 1);
    let target = if in_try { lower.try_blocks.get(lower.try_blocks.len() - 1).unwrap_or(-1); } else { sh_mir_type_arg(&lower.mir, signature, sh_mir_type_word(&lower.mir, signature, 5) - 1); };
    let mut returned = operand;
    if target != operand_type { let error = if mode == 1 { let field = sh_l_wrapper_field(lower, checked, operand_type, 2); sh_l_extract(lower, ast, node, operand, field); } else { -1; }; returned = sh_l_wrap(lower, checked, ast, node, target, false, -1, error); };
    sh_l_actions_phase(lower, checked, ast, ownership, node, 3);
    if in_try { let join = lower.try_blocks.get(lower.try_blocks.len() - 2).unwrap_or(-1); let leave = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, leave, join, returned); (); } else { sh_l_term(lower, ast, node, 3, returned); (); };
    lower.block = success;
    sh_l_extract(lower, ast, node, operand, value_field);
}

def sh_l_try_block(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64) -> i64 {
    let ty = sh_l_node_type(lower, checked, ast, node);
    if sh_l_wrapper_kind(lower, ty) < 0 { return sh_l_fail(lower, ast, node, 5008); };
    let join = sh_l_block(lower, ast, node, false);
    let previous = lower.block;
    lower.block = join;
    let empty = vec_new_i64();
    let result = sh_l_emit(lower, ast, node, 2, ty, &empty, 0, 0, 0);
    lower.block = previous;
    let stack = lower.try_blocks.len();
    lower.try_blocks.push(join);
    lower.try_blocks.push(ty);
    let value = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0));
    if lower.block >= 0 { let body_type = sh_mir_value_type(&lower.mir, value); let wrapped = if body_type == ty { value; } else { sh_l_wrap(lower, checked, ast, node, ty, true, value, -1); }; let leave = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, leave, join, wrapped); (); };
    sh_mir_trim(&lower.try_blocks, stack);
    lower.block = join;
    result;
}

def sh_l_expr(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64) -> i64 {
    if lower.error != 0 or lower.block < 0 { return -1; };
    if node < 0 or node >= sh_ast_count(ast) or lower.depth >= 128 { return sh_l_fail(lower, ast, node, 5001); };
    lower.depth = lower.depth + 1;
    let raw_result = sh_l_expr_inner(lower, text, ast, checked, ownership, node);
    let result = sh_l_capture_temporary(lower, text, ast, checked, ownership, node, raw_result);
    lower.depth = lower.depth - 1;
    if lower.error == 0 and lower.block >= 0 { sh_l_actions(lower, checked, ast, ownership, node, false); if sh_ast_word(ast, node, 0) == 52 { sh_l_actions(lower, checked, ast, ownership, node, true); (); }; };
    result;
}

def sh_l_expr_inner(lower: &mut ShMirLower, text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, node: i64) -> i64 {
    let kind = sh_ast_word(ast, node, 0);
    let ty = sh_l_node_type(lower, checked, ast, node);
    if lower.error != 0 { return -1; };
    if kind == 11 { return sh_l_literal(lower, text, ast, checked, node); };
    if (kind == 50 or kind == 51) and sh_node_callable_type(checked, node) >= 0 { return sh_l_operator(lower, text, ast, checked, ownership, node, ty); };
    if kind == 12 { let binding = sh_node_binding(checked, node); let binding_kind = sh_binding_word(checked, binding, 2); let args = vec_new_i64(); if binding_kind == 5 and sh_mir_type_word(&lower.mir, ty, 0) == 12 { return sh_l_emit(lower, ast, node, 24, ty, &args, sh_binding_word(checked, binding, 7), 0, 0); }; if binding_kind == 2 { return sh_l_emit(lower, ast, node, 9, ty, &args, lower.functions.get(binding).unwrap_or(-1), 0, 0); (); }; let address = sh_l_place(lower, text, ast, checked, ownership, node, false); args.push(address); return sh_l_emit(lower, ast, node, 14, ty, &args, 0, 0, 0); (); };
    if kind == 40 { let old_scope = lower.scope; lower.scope = sh_l_scope(lower, checked, ast, sh_node_scope(checked, node), node, 0); let mut value = sh_l_unit(lower, checked, ast, node); let mut i = 0; while lower.error == 0 and lower.block >= 0 and i < sh_ast_word(ast, node, 6) { let statement = sh_ast_child(ast, node, i); let statement_kind = sh_ast_word(ast, statement, 0); if statement_kind == 41 or statement_kind == 44 { let mut expression = -1; let mut child = 1; while child < sh_ast_word(ast, statement, 6) { let current = sh_ast_child(ast, statement, child); let child_kind = sh_ast_word(ast, current, 0); if child_kind < 70 or child_kind > 76 { expression = current; }; child = child + 1; }; if expression >= 0 { let initializer = sh_l_expr(lower, text, ast, checked, ownership, expression); let binding = sh_node_binding(checked, sh_ast_child(ast, statement, 0)); let local = sh_l_local(lower, checked, ast, binding); let address = sh_l_address(lower, checked, ast, statement, local, true); let operands = vec_new_i64(); operands.push(address); operands.push(initializer); let unit_ty = sh_l_type(lower, checked, checked.unit_type, 0); sh_l_emit(lower, ast, statement, 15, unit_ty, &operands, 0, 0, 0); sh_l_actions(lower, checked, ast, ownership, statement, false); sh_l_actions(lower, checked, ast, ownership, statement, true); (); }; } else { value = sh_l_expr(lower, text, ast, checked, ownership, if statement_kind == 43 { sh_ast_child(ast, statement, 0); } else { statement; }); if statement_kind == 43 { sh_l_actions(lower, checked, ast, ownership, statement, true); (); }; }; i = i + 1; }; if lower.block >= 0 { sh_l_actions(lower, checked, ast, ownership, node, true); (); }; lower.scope = old_scope; return value; };
    if kind == 50 { let operation = sh_ast_word(ast, node, 4); let op = operation % 1000; let child = sh_ast_child(ast, node, 0); if op == sh_kind("&") { let child_type = sh_l_node_type(lower, checked, ast, child); if child_type == ty and sh_mir_type_word(&lower.mir, ty, 0) == 6 { return sh_l_expr(lower, text, ast, checked, ownership, child); }; return sh_l_place(lower, text, ast, checked, ownership, child, operation >= 1000); }; let input = sh_l_expr(lower, text, ast, checked, ownership, child); let args = vec_new_i64(); args.push(input); return sh_l_emit(lower, ast, node, if op == sh_kind("*") { 14; } else { 10; }, ty, &args, op, 0, 0); (); };
    if kind == 51 { let op = sh_ast_word(ast, node, 4); let left_node = sh_ast_child(ast, node, 0); let right_node = sh_ast_child(ast, node, 1); let left = sh_l_expr(lower, text, ast, checked, ownership, left_node); if op == sh_kind("and") or op == sh_kind("or") or op == sh_kind("&&") or op == sh_kind("||") { let right_block = sh_l_block(lower, ast, node, false); let shortcut = sh_l_block(lower, ast, node, false); let join = sh_l_block(lower, ast, node, false); let old = lower.block; let empty = vec_new_i64(); lower.block = join; let result = sh_l_emit(lower, ast, node, 2, ty, &empty, 0, 0, 0); lower.block = old; let branch = sh_l_term(lower, ast, node, 2, left); let and_op = op == sh_kind("and") or op == sh_kind("&&"); sh_l_edge(lower, ast, node, branch, if and_op { right_block; } else { shortcut; }, -1); sh_l_edge(lower, ast, node, branch, if and_op { shortcut; } else { right_block; }, -1); lower.block = shortcut; let leave = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, leave, join, left); lower.block = right_block; let right = sh_l_expr(lower, text, ast, checked, ownership, right_node); if lower.block >= 0 { let end = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, end, join, right); (); }; lower.block = join; return result; }; let right = sh_l_expr(lower, text, ast, checked, ownership, right_node); let args = vec_new_i64(); args.push(left); args.push(right); return sh_l_emit(lower, ast, node, 11, ty, &args, op, 0, 0); (); };
    if kind == 52 { let left = sh_ast_child(ast, node, 0); let right = sh_ast_child(ast, node, 1); let address = sh_l_place(lower, text, ast, checked, ownership, left, true); let mut value = sh_l_expr(lower, text, ast, checked, ownership, right); let op = sh_ast_word(ast, node, 4); if op != sh_kind("=") { let target_ty = sh_l_node_type(lower, checked, ast, left); let args = vec_new_i64(); args.push(address); let loaded = sh_l_emit(lower, ast, left, 14, target_ty, &args, 0, 0, 0); args.clear(); args.push(loaded); args.push(value); let simple = if op >= sh_kind("+=") and op <= sh_kind("%=") { op - sh_kind("+=") + sh_kind("+"); } else { if op >= sh_kind("&=") and op <= sh_kind(">>=") { op - sh_kind("&=") + sh_kind("&"); } else { -1; }; }; value = sh_l_emit(lower, ast, node, 11, target_ty, &args, simple, 0, 0); (); }; sh_l_actions_phase(lower, checked, ast, ownership, node, 2); let args = vec_new_i64(); args.push(address); args.push(value); return sh_l_emit(lower, ast, node, 15, ty, &args, 0, 0, 0); (); };
    if kind == 53 { return sh_l_call(lower, text, ast, checked, ownership, node, ty); };
    if kind == 54 or kind == 55 { let base = sh_ast_child(ast, node, 0); let base_ty = sh_s_resolve(checked, sh_node_type(checked, base)); let args = vec_new_i64(); if kind == 55 and sh_s_kind(checked, base_ty) != 6 and sh_s_kind(checked, base_ty) != 7 { let value = sh_l_expr(lower, text, ast, checked, ownership, base); args.push(value); return sh_l_emit(lower, ast, node, 18, ty, &args, sh_l_field_ordinal(lower, text, ast, checked, node), -1, 0); (); }; let place = sh_l_place(lower, text, ast, checked, ownership, node, false); args.push(place); return sh_l_emit(lower, ast, node, 14, ty, &args, 0, 0, 0); (); };
    if kind == 57 { let value = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0)); let args = vec_new_i64(); args.push(value); return sh_l_emit(lower, ast, node, 12, ty, &args, 0, 0, if checked.unsafe_depth > 0 { 1; } else { 0; }); (); };
    if kind == 58 or kind == 59 or kind == 60 { let args = vec_new_i64(); if kind == 60 { let expected = sh_mir_field_count(&lower.mir, ty, -1); if expected < 0 { return sh_l_fail(lower, ast, node, 5003); }; let values = vec_new_i64(); let mut i = 0; while i < expected { values.push(-1); i = i + 1; }; i = 1; while i < sh_ast_word(ast, node, 6) { let field = sh_ast_child(ast, node, i); if sh_ast_word(ast, field, 4) == 1 { return sh_l_fail(lower, ast, field, 5008); }; let mut binding = sh_node_binding(checked, field); if binding < 0 { binding = sh_node_binding(checked, sh_ast_child(ast, field, 0)); }; let ordinal = sh_l_member_ordinal(lower, checked, sh_node_type(checked, node), binding); let expression = sh_ast_child(ast, field, 1); if expression < 0 { return sh_l_fail(lower, ast, field, 5008); }; let value = sh_l_expr(lower, text, ast, checked, ownership, expression); if ordinal < 0 or ordinal >= expected or not values.set(ordinal, value) { return sh_l_fail(lower, ast, field, 5003); }; i = i + 1; }; i = 0; while i < expected { let value = values.get(i).unwrap_or(-1); if value < 0 { return sh_l_fail(lower, ast, node, 5003); }; args.push(value); i = i + 1; }; } else { if kind == 58 and sh_ast_word(ast, node, 4) == 0 { return sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, 0)); }; if kind == 58 and sh_ast_word(ast, node, 6) == 0 { return sh_l_unit(lower, checked, ast, node); }; let mut i = 0; while i < sh_ast_word(ast, node, 6) { let value = sh_l_expr(lower, text, ast, checked, ownership, sh_ast_child(ast, node, i)); args.push(value); i = i + 1; }; if kind == 59 and sh_ast_word(ast, node, 4) == 1 { return sh_l_fail(lower, ast, node, 5008); }; }; return sh_l_emit(lower, ast, node, 16, ty, &args, -1, 0, 0); (); };
    if kind == 56 { return sh_l_question(lower, text, ast, checked, ownership, node); };
    if kind == 68 and sh_ast_word(ast, node, 4) == sh_kind("try") { return sh_l_try_block(lower, text, ast, checked, ownership, node); };
    if kind == 63 { return sh_l_for(lower, text, ast, checked, ownership, node); };
    if kind == 65 { return sh_l_match(lower, text, ast, checked, ownership, node); };
    if kind == 61 { return sh_l_if(lower, text, ast, checked, ownership, node); };
    if kind == 62 or kind == 64 { return sh_l_loop(lower, text, ast, checked, ownership, node); };
    if kind == 42 { let operation = sh_ast_word(ast, node, 4); let child = sh_ast_child(ast, node, 0); let value = if child >= 0 { sh_l_expr(lower, text, ast, checked, ownership, child); } else { sh_l_unit(lower, checked, ast, node); }; sh_l_actions(lower, checked, ast, ownership, node, true); if operation == sh_kind("return") { sh_l_term(lower, ast, node, 3, value); lower.block = -1; return -1; }; if operation == sh_kind("break") or operation == sh_kind("continue") { if lower.loops.len() < 3 { return sh_l_fail(lower, ast, node, 5004); }; let index = lower.loops.len() - 3; let target = lower.loops.get(index + if operation == sh_kind("break") { 1; } else { 0; }).unwrap_or(-1); let term = sh_l_term(lower, ast, node, 1, -1); sh_l_edge(lower, ast, node, term, target, if operation == sh_kind("break") and sh_mir_block(&lower.mir, target, 3) > 0 { value; } else { -1; }); lower.block = -1; return -1; }; };
    sh_l_fail(lower, ast, node, 5008);
}

def sh_lower_parts(text: &String, ast: &ShAst, checked: &ShChecked, ownership: &ShOwnership, max_items: i64) -> ShLowered {
    let mut lower = ShMirLower { mir: sh_mir_new(max_items), type_map: vec_new_i64(), functions: vec_new_i64(), locals: vec_new_i64(), scopes: vec_new_i64(), addresses: vec_new_i64(), temporaries: vec_new_i64(), loops: vec_new_i64(), try_blocks: vec_new_i64(), generic_keys: vec_new_i64(), generic_values: vec_new_i64(), template_types: vec_new_i64(), class_symbols: vec_new_i64(), jobs: vec_new_i64(), job_substitutions: vec_new_i64(), function: -1, block: -1, scope: -1, depth: 0, error: 0, start: 0, end: 0 };
    if not sh_mir_limit(&lower.mir) { return ShLowered { mir: lower.mir, error: 5001, start: 0, end: 0 }; };
    if checked.error != 0 { return ShLowered { mir: lower.mir, error: checked.error, start: checked.start, end: checked.end }; };
    if ownership.error != 0 { return ShLowered { mir: lower.mir, error: ownership.error, start: ownership.start, end: ownership.end }; };
    let mut i = 0;
    while i < sh_symbol_count(&checked.symbols) { let name = sh_symbol_text(&checked.symbols, i); if not name.is_ok() { lower.error = 5001; break; }; let symbol = sh_intern(&lower.mir.symbols, &name.value); if not symbol.is_ok() or symbol.value != i { lower.error = 5001; break; }; i = i + 1; };
    i = 0;
    while i < sh_binding_count(checked) { lower.functions.push(-1); lower.locals.push(-1); lower.template_types.push(-1); if sh_binding_word(checked, i, 2) == 3 and sh_ast_word(ast, sh_binding_word(checked, i, 4), 0) == 32 { lower.class_symbols.push(sh_binding_word(checked, i, 0)); (); }; i = i + 1; };
    i = 0;
    while i < sh_scope_count(checked) { lower.scopes.push(-1); i = i + 1; };
    i = 0;
    while i < sh_ast_count(ast) { lower.temporaries.push(-1); i = i + 1; };
    let source = sh_mir_source(&lower.mir, sh_ast_word(ast, ast.root, 1), text.len());
    if not source.is_ok() { lower.error = source.error; };
    i = 0;
    while lower.error == 0 and i < sh_binding_count(checked) { if sh_binding_word(checked, i, 2) == 2 and sh_binding_word(checked, i, 4) >= 0 { let node = sh_binding_word(checked, i, 4); let declared = sh_binding_word(checked, i, 3); let signature = sh_l_type(&mut lower, checked, declared, 0); lower.template_types.set(i, signature); if not sh_l_has_parameter(checked, declared, 0) { let name = sh_l_function_name(checked, i); if not name.is_ok() { sh_l_fail(&mut lower, ast, node, 5003); break; }; let created = sh_mir_add_function(&lower.mir, &name.value, signature, if sh_s_child_kind(ast, node, 40) < 0 { 1; } else { 0; }, sh_ast_word(ast, node, 1), sh_ast_word(ast, node, 2), sh_ast_word(ast, node, 3)); let function = sh_l_store(&mut lower, ast, node, created); lower.functions.set(i, function); sh_l_job(&mut lower, ast, node, function, i, declared, -1, 0); }; }; i = i + 1; };
    i = 0;
    while lower.error == 0 and i < sh_type_count(&checked.types) { if sh_s_kind(checked, i) == 12 { let owner = sh_adt_binding(checked, i); sh_l_drop_glue(&mut lower, text, ast, checked, i); if owner >= 0 { if sh_binding_word(checked, owner, 2) == 4 { let mut variant = 0; while variant < sh_binding_count(checked) { if sh_binding_word(checked, variant, 2) == 5 and sh_binding_word(checked, variant, 6) == owner { sh_l_layout(&mut lower, checked, i, variant, sh_binding_word(checked, variant, 7)); (); }; variant = variant + 1; }; } else { sh_l_layout(&mut lower, checked, i, owner, -1); }; }; }; i = i + 1; };
    let mut job = 0;
    while lower.error == 0 and job < lower.jobs.len() / 5 { let function = lower.jobs.get(job * 5).unwrap_or(-1); let binding = lower.jobs.get(job * 5 + 1).unwrap_or(-1); lower.generic_keys.clear(); lower.generic_values.clear(); let first = lower.jobs.get(job * 5 + 3).unwrap_or(-1); let count = lower.jobs.get(job * 5 + 4).unwrap_or(0); let mut pair = 0; while pair < count { lower.generic_keys.push(lower.job_substitutions.get((first + pair) * 2).unwrap_or(-1)); lower.generic_values.push(lower.job_substitutions.get((first + pair) * 2 + 1).unwrap_or(-1)); pair = pair + 1; }; if not sh_l_deferred(&mut lower, checked, ast, binding) { break; }; let mut reset = 0; while reset < lower.locals.len() { lower.locals.set(reset, -1); reset = reset + 1; }; reset = 0; while reset < lower.scopes.len() { lower.scopes.set(reset, -1); reset = reset + 1; }; reset = 0; while reset < lower.temporaries.len() { lower.temporaries.set(reset, -1); reset = reset + 1; }; if sh_mir_fn(&lower.mir, function, 3) % 2 == 0 { let node = sh_binding_word(checked, binding, 4); let body = sh_s_child_kind(ast, node, 40); lower.function = function; let root_scope = sh_mir_add_scope(&lower.mir, function, -1, 0); lower.scope = sh_l_store(&mut lower, ast, node, root_scope); lower.scopes.set(sh_binding_word(checked, binding, 7), lower.scope); lower.block = sh_l_block(&mut lower, ast, node, false); let mut local_binding = 0; while lower.error == 0 and local_binding < sh_binding_count(checked) { let kind = sh_binding_word(checked, local_binding, 2); if (kind == 0 or kind == 1) and sh_binding_word(checked, local_binding, 6) == binding { let declaration = sh_binding_word(checked, local_binding, 4); let ty_input = sh_binding_word(checked, local_binding, 3); let ty = sh_l_type(&mut lower, checked, ty_input, 0); let needs_drop = sh_ownership_needs_drop(text, ast, checked, ty_input) and not sh_ownership_parameter_observed(ownership, local_binding); let local_scope = sh_l_scope(&mut lower, checked, ast, sh_binding_word(checked, local_binding, 1), declaration, 0); let added = sh_mir_add_local(&lower.mir, function, ty, sh_binding_word(checked, local_binding, 0), if kind == 1 { 1; } else { 0; }, if needs_drop { 3; } else { 1; }, local_scope, if kind == 1 { sh_binding_word(checked, local_binding, 7); } else { -1; }, sh_ast_word(ast, declaration, 1), sh_ast_word(ast, declaration, 2), sh_ast_word(ast, declaration, 3)); let local = sh_l_store(&mut lower, ast, declaration, added); lower.locals.set(local_binding, local); if kind == 1 { let operands = vec_new_i64(); let value = sh_l_emit(&mut lower, ast, declaration, 1, ty, &operands, sh_binding_word(checked, local_binding, 7), 0, 0); let address = sh_l_address(&mut lower, checked, ast, declaration, local, true); operands.push(address); operands.push(value); let unit_ty = sh_l_type(&mut lower, checked, checked.unit_type, 0); sh_l_emit(&mut lower, ast, declaration, 15, unit_ty, &operands, 0, 0, 0); operands.clear(); sh_l_emit(&mut lower, ast, declaration, 25, unit_ty, &operands, local, 1, 0); (); }; }; local_binding = local_binding + 1; }; let mut result = sh_l_expr(&mut lower, text, ast, checked, ownership, body); let signature = sh_mir_fn(&lower.mir, function, 1); let returned = sh_mir_type_arg(&lower.mir, signature, sh_mir_type_word(&lower.mir, signature, 5) - 1); if lower.error == 0 and lower.block >= 0 and sh_mir_type_word(&lower.mir, sh_mir_value_type(&lower.mir, result), 0) == 0 and sh_mir_type_word(&lower.mir, returned, 0) == 2 { let name = sh_symbol_text(&lower.mir.symbols, sh_mir_fn(&lower.mir, function, 0)); if name.is_ok() and sh_s_text_equal(&name.value, "main") and sh_binding_word(checked, binding, 1) == 0 { let empty = vec_new_i64(); result = sh_l_emit(&mut lower, ast, node, 4, returned, &empty, 0, 0, 0); }; }; let return_kind = sh_mir_type_word(&lower.mir, returned, 0); if lower.error == 0 and lower.block >= 0 { if return_kind == 0 { result = sh_l_unit(&mut lower, checked, ast, node); }; sh_l_actions(&mut lower, checked, ast, ownership, node, true); sh_l_term(&mut lower, ast, node, 3, result); (); }; }; job = job + 1; };
    if lower.error == 0 { let validation = sh_mir_validate(&lower.mir); if validation.error != 0 { lower.error = validation.error; lower.start = validation.start; lower.end = validation.end; }; };
    ShLowered { mir: lower.mir, error: lower.error, start: lower.start, end: lower.end };
}

def sh_lower_hir(hir: &ShHir, max_items: i64) -> ShLowered {
    let error = if hir.error != 0 { hir.error; } else { sh_hir_validate(hir); };
    if error != 0 { return ShLowered { mir: sh_mir_new(max_items), error: error, start: hir.start, end: hir.end }; };
    sh_lower_parts(&hir.source, &hir.ast, &hir.checked, &hir.ownership, max_items);
}

def sh_lower(text: &String, ast: &ShAst, checked: &ShChecked, max_items: i64) -> ShLowered {
    if max_items < 0 or max_items > 100000 { return ShLowered { mir: sh_mir_new(max_items), error: 5001, start: 0, end: 0 }; };
    let hir = sh_hir_lift(text, ast, checked, max_items);
    sh_lower_hir(&hir, max_items);
}
