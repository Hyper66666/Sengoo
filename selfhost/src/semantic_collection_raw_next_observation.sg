import selfhost_semantic_collection_effects;

def sh_collection_raw_next_observes(effects: &ShCollectionEffects, loans: &ShBackingLoans, checked: &ShChecked, ast: &ShAst, call: i64, argument: i64, ordinal: i64) -> bool {
    if effects.schema != 1 or effects.unlowerable != 1 or effects.error != 0 or effects.operations.len() % 16 != 0 or effects.call_events.len() != effects.operations.len() / 16 or effects.handles.schema != 1 or effects.handles.unlowerable != 1 or effects.handles.error != 0 or ordinal != 0 { return false; };
    if sh_ast_word(ast, call, 0) != 53 or sh_ast_word(ast, call, 6) != 2 or sh_ast_child(ast, call, 1) != argument or sh_ast_word(ast, argument, 0) != 55 or not sh_o_i64(checked, sh_node_type(checked, argument)) or sh_node_binding(checked, call) != effects.handles.raw_next { return false; };
    let signature = sh_s_resolve(checked, sh_node_callable_type(checked, call));
    let element = sh_bl_option_ref(loans, checked, sh_node_type(checked, call));
    if element < 0 or sh_s_kind(checked, signature) != 11 or sh_s_data(checked, signature) != 0 or sh_s_flags(checked, signature) != 0 or sh_s_arity(checked, signature) != 2 or not sh_o_i64(checked, sh_s_argument(checked, signature, 0)) or sh_s_resolve(checked, sh_s_argument(checked, signature, 1)) != sh_s_resolve(checked, sh_node_type(checked, call)) { return false; };
    let base = sh_ast_child(ast, argument, 0);
    let base_type = sh_o_base(checked, sh_node_type(checked, base));
    let family = sh_adt_binding(checked, base_type);
    let field = sh_node_binding(checked, argument);
    if sh_s_kind(checked, base_type) != 12 or sh_s_arity(checked, base_type) != 1 or sh_o_element(checked, base_type) != element or not (family == sh_origin_at(&effects.handles.canonical, 1) or family == sh_origin_at(&effects.handles.canonical, 2)) or sh_binding_word(checked, field, 2) != 6 or sh_binding_word(checked, field, 6) != family or sh_binding_word(checked, field, 7) != 0 or not sh_o_i64(checked, sh_binding_word(checked, field, 3)) { return false; };
    if effects.handles.provider_rows.len() != 48 or sh_ch_at(&effects.handles.provider_rows, 2, 8, 0) != 2 or sh_ch_at(&effects.handles.provider_rows, 2, 8, 1) != 2 { return false; };
    let provider = sh_ch_at(&effects.handles.provider_rows, 2, 8, 2);
    let provider_type = sh_s_resolve(checked, sh_binding_word(checked, provider, 3));
    let pointer = sh_s_argument(checked, provider_type, 1);
    let byte = sh_s_argument(checked, pointer, 0);
    if sh_binding_word(checked, provider, 2) != 2 or provider_type != sh_s_resolve(checked, sh_ch_at(&effects.handles.provider_rows, 2, 8, 5)) or sh_s_kind(checked, provider_type) != 11 or sh_s_data(checked, provider_type) != 1 or sh_s_flags(checked, provider_type) != 0 or sh_s_arity(checked, provider_type) != 2 or not sh_o_i64(checked, sh_s_argument(checked, provider_type, 0)) or sh_s_kind(checked, pointer) != 7 or sh_s_flags(checked, pointer) != 1 or sh_s_arity(checked, pointer) != 1 or sh_s_kind(checked, byte) != 2 or sh_s_data(checked, byte) != 8 or sh_s_flags(checked, byte) != 0 { return false; };
    let mut matched = 0;
    let mut op = 0;
    while op < effects.operations.len() / 16 { if sh_ce_at(effects, op, 0) == call { if sh_ce_at(effects, op, 1) != 3 or sh_ce_at(effects, op, 2) != sh_ch_owner(checked, call) or sh_ce_at(effects, op, 3) != sh_ast_word(ast, call, 1) or sh_ce_at(effects, op, 4) != sh_node_binding(checked, call) or sh_ce_at(effects, op, 5) != signature or sh_ce_at(effects, op, 6) != element or sh_ce_at(effects, op, 7) != argument or sh_ce_at(effects, op, 8) != base or sh_ce_at(effects, op, 11) != field or sh_ce_at(effects, op, 12) != provider or sh_ce_at(effects, op, 13) != effects.handles.raw_next or sh_ce_at(effects, op, 14) != -1 or sh_ce_at(effects, op, 15) != 0 or not sh_ce_call_live(effects, op) { return false; }; let token = sh_ce_at(effects, op, 10); let role = sh_nll_node(&effects.adjusted, base, 2); if token < 0 or sh_nll_node(&effects.adjusted, base, 0) != token or sh_nll_node(&effects.adjusted, base, 1) != sh_ce_at(effects, op, 9) or sh_nll_node(&effects.adjusted, base, 3) != element or sh_nll_node(&effects.adjusted, base, 4) != 1 or not (role == 2 or role == 3) or sh_nll_token(&effects.adjusted, token, 0) != sh_ce_at(effects, op, 2) or sh_nll_token(&effects.adjusted, token, 1) != sh_ce_at(effects, op, 9) or sh_nll_token(&effects.adjusted, token, 2) != element or sh_nll_token(&effects.adjusted, token, 6) != 1 or sh_nll_token(&effects.adjusted, token, 7) != 1 { return false; }; matched = matched + 1; }; op = op + 1; };
    matched == 1;
}
