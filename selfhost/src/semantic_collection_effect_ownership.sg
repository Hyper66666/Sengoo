def sh_ce_ow_call(effects: &ShCollectionEffects, loans: &ShBackingLoans, fresh: &ShCollectionHandles, result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64, holder: i64) {
    let first_loan = result.loans.len();
    let target = sh_ast_child(ast, node, 0);
    let function = sh_node_binding(checked, node);
    let target_type = sh_s_resolve(checked, sh_node_type(checked, target));
    let fn_type = if sh_s_kind(checked, target_type) == 11 { target_type; } else { sh_s_resolve(checked, sh_binding_word(checked, function, 3)); };
    let member = sh_ast_word(ast, target, 0) == 55;
    let mut receiver = -1;
    if member { let base = sh_ast_child(ast, target, 0); if sh_b_alias_ambiguous(result, sh_node_binding(checked, base)) { sh_b_error(result, ast, base, 6111, sh_node_binding(checked, base), -1); }; let self_type = sh_s_resolve(checked, sh_s_argument(checked, fn_type, 0)); let previous_mode = result.access_mode; if sh_s_kind(checked, self_type) == 6 { result.access_mode = 1; }; sh_ce_ow_walk(effects, loans, fresh, result, text, checked, ast, base, not (sh_s_kind(checked, self_type) == 6 or sh_b_contract_observes(result, checked, ast, node, 0)), -1); result.access_mode = previous_mode; let base_is_ref = sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, base))) == 6; let receiver_alias = if base_is_ref { sh_node_binding(checked, base); } else { sh_b_access_alias(checked, ast, base, 0); }; let parent = sh_b_alias_loan(result, receiver_alias); receiver = if base_is_ref and parent >= 0 { result.loans.get(parent * 5).unwrap_or(-1); } else { sh_b_place(result, checked, ast, base); }; if sh_s_kind(checked, self_type) == 6 { sh_b_loan_from(result, checked, ast, node, receiver, -1, sh_s_flags(checked, self_type) == 1, parent); }; };
    let mut index = 1;
    while index < sh_ast_word(ast, node, 6) { let argument = sh_ast_child(ast, node, index); let ordinal = index - 1 + if member { 1; } else { 0; }; let parameter = sh_s_resolve(checked, sh_s_argument(checked, fn_type, ordinal)); let consumes = sh_ce_push_value(effects, ast, node, argument); let observes = not consumes and (sh_s_kind(checked, parameter) == 6 or sh_b_contract_observes(result, checked, ast, node, ordinal) or sh_b_native_projects(checked, function, ordinal) or sh_cb_argument(fresh, checked, ast, node, argument, ordinal)); let previous_projection = result.projection_context; result.projection_context = if observes { 1; } else { 0; }; sh_ce_ow_walk(effects, loans, fresh, result, text, checked, ast, argument, not observes, -1); result.projection_context = previous_projection; let projected = sh_b_place(result, checked, ast, argument); if observes and sh_s_kind(checked, parameter) == 6 { let alias = sh_node_binding(checked, argument); let parent_count = result.loans.len(); let mut parent_at = 0; while alias >= 0 and parent_at < parent_count { if result.loans.get(parent_at + 1).unwrap_or(-1) == alias and result.loans.get(parent_at + 4).unwrap_or(0) != 0 { let owner = result.loans.get(parent_at).unwrap_or(-1); sh_b_loan_from(result, checked, ast, argument, owner, -1, sh_s_flags(checked, parameter) == 1, parent_at / 5); }; parent_at = parent_at + 5; }; }; index = index + 1; };
    let return_type = sh_s_resolve(checked, sh_node_type(checked, node));
    let last_argument_loan = result.loans.len();
    if sh_b_carries_borrow(checked, return_type, 0) { let mut argument_loan = first_loan; while argument_loan < last_argument_loan { if result.loans.get(argument_loan + 1).unwrap_or(-1) == -1 and result.loans.get(argument_loan + 4).unwrap_or(0) != 0 { let owner = result.loans.get(argument_loan).unwrap_or(-1); sh_b_loan_from(result, checked, ast, node, owner, holder, result.loans.get(argument_loan + 2).unwrap_or(0) != 0 and sh_b_carries_mutable_borrow(checked, return_type, 0), argument_loan / 5); }; argument_loan = argument_loan + 5; }; };
    let mut loan = first_loan;
    while loan < last_argument_loan { if result.loans.get(loan + 1).unwrap_or(-1) == -1 { result.loans.set(loan + 4, 0); (); }; loan = loan + 5; };
}

def sh_ce_ow_operator(effects: &ShCollectionEffects, loans: &ShBackingLoans, fresh: &ShCollectionHandles, result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64, holder: i64) {
    let first = result.loans.len();
    let signature = sh_s_resolve(checked, sh_node_callable_type(checked, node));
    let function = sh_node_binding(checked, node);
    let mut index = 0;
    while index < sh_ast_word(ast, node, 6) { let argument = sh_ast_child(ast, node, index); let parameter = sh_s_resolve(checked, sh_s_argument(checked, signature, index)); let reference = sh_s_kind(checked, parameter) == 6; let parameter_binding = sh_b_contract_parameter(checked, function, index); let observes = reference or parameter_binding >= 0 and (result.contracts.get(parameter_binding).unwrap_or(0) & 1) != 0; let previous = result.access_mode; if reference { result.access_mode = 1; }; sh_ce_ow_walk(effects, loans, fresh, result, text, checked, ast, argument, not observes, -1); result.access_mode = previous; if reference { let is_ref = sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, argument))) == 6; let alias = if is_ref { sh_node_binding(checked, argument); } else { sh_b_access_alias(checked, ast, argument, 0); }; let parent = sh_b_alias_loan(result, alias); if sh_b_alias_ambiguous(result, alias) { sh_b_error(result, ast, argument, 6111, alias, -1); }; let path = if is_ref and parent >= 0 { result.loans.get(parent * 5).unwrap_or(-1); } else { sh_b_place(result, checked, ast, argument); }; sh_b_loan_from(result, checked, ast, node, path, -1, sh_s_flags(checked, parameter) == 1, parent); }; index = index + 1; };
    let end = result.loans.len();
    let returned = sh_node_type(checked, node);
    let mut loan = first;
    if sh_b_carries_borrow(checked, returned, 0) { while loan < end { if result.loans.get(loan + 1).unwrap_or(-1) == -1 and result.loans.get(loan + 4).unwrap_or(0) != 0 { sh_b_loan_from(result, checked, ast, node, result.loans.get(loan).unwrap_or(-1), holder, result.loans.get(loan + 2).unwrap_or(0) != 0 and sh_b_carries_mutable_borrow(checked, returned, 0), loan / 5); }; loan = loan + 5; }; };
    loan = first;
    while loan < end { if result.loans.get(loan + 1).unwrap_or(-1) == -1 { result.loans.set(loan + 4, 0); (); }; loan = loan + 5; };
}

def sh_ce_ow_analyze(effects: &ShCollectionEffects, loans: &ShBackingLoans, fresh: &ShCollectionHandles, analyzed: &ShModuleChecked, selected: &Vec<i64>, all_functions: bool, text: &String, ast: &ShAst, checked: &ShChecked, max_diagnostics: i64) -> ShOwnership {
    let mut result = sh_ownership_from_facts(vec_new_i64(), vec_new_i64(), vec_new_i64(), max_diagnostics);
    if max_diagnostics < 1 or max_diagnostics > 1000000 { result.error = 6110; return result; };
    if checked.error != 0 { result.error = checked.error; result.start = checked.start; result.end = checked.end; return result; };
    let mut binding = 0;
    while binding < sh_binding_count(checked) { result.last_uses.push(-1); binding = binding + 1; };
    let mut node = 0;
    while node < sh_ast_count(ast) { let resolved = sh_node_binding(checked, node); if resolved >= 0 and sh_ast_word(ast, node, 0) == 12 { let end = sh_ast_word(ast, node, 3); if end > result.last_uses.get(resolved).unwrap_or(-1) { result.last_uses.set(resolved, end); (); }; }; node = node + 1; };
    sh_b_infer_contracts(&result, checked, ast);
    binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 2 and (all_functions or sh_cb_in(selected, binding)) { result.function = binding; result.scope = sh_binding_word(checked, binding, 7); result.flow = 0; result.loans.clear(); result.loan_parents.clear(); let function = sh_binding_word(checked, binding, 4); let body = sh_s_child_kind(ast, function, 40); if body >= 0 and sh_binding_word(checked, sh_binding_word(checked, binding, 6), 2) != 7 { let mut param = 0; while param < sh_binding_count(checked) { if sh_binding_word(checked, param, 2) == 1 and sh_binding_word(checked, param, 6) == binding { sh_b_initialize(&mut result, checked, ast, sh_binding_word(checked, param, 4), param); }; param = param + 1; }; if sh_cb_complete_helper(fresh, checked, ast, binding) { let mut local = 0; while local < sh_binding_count(checked) { if sh_binding_word(checked, local, 2) == 0 and sh_binding_word(checked, local, 6) == binding { sh_b_initialize(&mut result, checked, ast, sh_binding_word(checked, local, 4), local); }; local = local + 1; }; } else { let fn_type = sh_s_resolve(checked, sh_binding_word(checked, binding, 3)); let return_type = sh_s_argument(checked, fn_type, sh_s_arity(checked, fn_type) - 1); let tail_return = sh_s_kind(checked, sh_s_resolve(checked, return_type)) != 0; sh_ce_ow_walk(effects, loans, fresh, &mut result, text, checked, ast, body, tail_return, -1); if tail_return { sh_ce_escape(effects, loans, &mut result, checked, ast, body); }; if result.flow == 0 { let scope = result.scope; sh_b_cleanup(&mut result, checked, ast, body, scope, true); }; }; }; }; binding = binding + 1; };
    result;
}

def sh_ce_push_value(effects: &ShCollectionEffects, ast: &ShAst, call: i64, argument: i64) -> bool {
    let mut row = 0;
    while row < effects.operations.len() / 16 { if sh_ce_at(effects, row, 0) == call and sh_ce_at(effects, row, 1) == 1 { let callee = sh_ast_child(ast, call, 0); let actual = if sh_ast_word(ast, callee, 0) == 55 { sh_ast_child(ast, call, 1); } else { sh_ast_child(ast, call, 2); }; return actual == argument; }; row = row + 1; };
    false;
}

def sh_ce_contains(ast: &ShAst, tree: i64, node: i64, depth: i64) -> bool {
    if tree == node { return true; };
    if depth >= 128 or tree < 0 or node < 0 or node > tree { return false; };
    let mut child = 0;
    while child < sh_ast_word(ast, tree, 6) { if sh_ce_contains(ast, sh_ast_child(ast, tree, child), node, depth + 1) { return true; }; child = child + 1; };
    false;
}

def sh_ce_scalar_observation(effects: &ShCollectionEffects, loans: &ShBackingLoans, checked: &ShChecked, ast: &ShAst, node: i64) -> bool {
    let kind = sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, node)));
    kind >= 1 and kind <= 4 and sh_ce_payload_guard(effects, loans, checked, ast, node);
}

def sh_ce_payload_guard(effects: &ShCollectionEffects, loans: &ShBackingLoans, checked: &ShChecked, ast: &ShAst, node: i64) -> bool {
    let mut payload = node;
    let mut depth = 0;
    while depth < 64 { let kind = sh_ast_word(ast, payload, 0); let binding = sh_node_binding(checked, payload); if kind == 55 and sh_binding_word(checked, binding, 2) == 6 and sh_binding_word(checked, binding, 6) == loans.option_binding and sh_binding_word(checked, binding, 7) == 1 { break; }; if kind == 55 or kind == 50 and sh_ast_word(ast, payload, 4) % 1000 == sh_kind("*") { payload = sh_ast_child(ast, payload, 0); } else { return false; }; depth = depth + 1; };
    let reference = sh_s_resolve(checked, sh_node_type(checked, payload));
    let element = sh_s_argument(checked, reference, 0);
    let base = sh_ast_child(ast, payload, 0);
    let local = sh_node_binding(checked, base);
    let token = sh_nll_node(&effects.adjusted, payload, 0);
    if depth >= 64 or sh_s_kind(checked, reference) != 6 or sh_s_flags(checked, reference) != 0 or sh_ast_word(ast, base, 0) != 12 or sh_binding_word(checked, local, 2) != 0 or sh_binding_word(checked, local, 5) != 0 or token < 0 or sh_nll_token(&effects.adjusted, token, 7) != 2 or sh_nll_token(&effects.adjusted, token, 2) != element or not sh_ce_live_at(effects, payload, token) { return false; };
    let producer = sh_nll_token(&effects.adjusted, token, 3);
    let declaration = sh_binding_word(checked, local, 4);
    if sh_ast_word(ast, declaration, 0) != 41 or sh_ast_word(ast, declaration, 6) < 2 or sh_node_binding(checked, sh_ast_child(ast, declaration, 0)) != local or sh_ch_unwrap(ast, sh_ast_child(ast, declaration, sh_ast_word(ast, declaration, 6) - 1)) != producer { return false; };
    let function = sh_ch_owner(checked, node);
    let mut matched = false;
    let mut row = 0;
    while row < effects.operations.len() / 16 { if sh_ce_at(effects, row, 0) == producer and sh_ce_at(effects, row, 1) == 3 and sh_ce_at(effects, row, 2) == function and sh_ce_at(effects, row, 6) == element and sh_ce_call_live(effects, row) { matched = true; }; row = row + 1; };
    if not matched { return false; };
    row = 0;
    while row < sh_ast_count(ast) { if sh_ast_word(ast, row, 0) == 61 and sh_ast_word(ast, row, 6) == 3 and sh_ch_owner(checked, row) == function { let condition = sh_ast_child(ast, row, 0); let tag = sh_node_binding(checked, condition); if sh_ast_word(ast, condition, 0) == 55 and sh_ast_word(ast, sh_ast_child(ast, condition, 0), 0) == 12 and sh_binding_word(checked, tag, 6) == loans.option_binding and sh_binding_word(checked, tag, 7) == 0 and sh_node_binding(checked, sh_ast_child(ast, condition, 0)) == local and sh_ce_contains(ast, sh_ast_child(ast, row, 1), node, 0) and not sh_ce_contains(ast, sh_ast_child(ast, row, 2), node, 0) { return true; }; }; row = row + 1; };
    false;
}

def sh_ce_escape(effects: &ShCollectionEffects, loans: &ShBackingLoans, result: &mut ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64) {
    let kind = sh_ast_word(ast, node, 0);
    if kind == 40 { let tail = sh_ast_child(ast, node, sh_ast_word(ast, node, 6) - 1); if tail >= 0 { sh_ce_escape(effects, loans, result, checked, ast, tail); }; return; };
    if kind == 43 or kind == 58 or kind == 59 or kind == 60 or kind == 23 or kind == 66 { let mut at = if kind == 60 { 1; } else { 0; }; while at < sh_ast_word(ast, node, 6) { sh_ce_escape(effects, loans, result, checked, ast, sh_ast_child(ast, node, at)); at = at + 1; }; return; };
    if kind == 61 or kind == 65 { let mut at = 1; while at < sh_ast_word(ast, node, 6) { sh_ce_escape(effects, loans, result, checked, ast, sh_ast_child(ast, node, at)); at = at + 1; }; return; };
    if sh_ce_scalar_observation(effects, loans, checked, ast, node) { return; };
    sh_b_escape(result, checked, ast, node);
}
