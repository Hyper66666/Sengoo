.unwrap_or(0) & 1) != 0 and sh_b_drop_inner(checked, sh_node_type(checked, target), 0) { let first = sh_ownership_action_count(result); sh_b_drop_path(result, checked, ast, node, target_path, result.scope, 0, 0); let mut action = first; while action < sh_ownership_action_count(result) { if result.actions.get(action * 5 + 2).unwrap_or(0) == 3 { result.actions.set(action * 5 + 2, 6); (); }; action = action + 1; }; }; let mut child = 0; while child < result.state.len() { if child != target_path and sh_b_path_contains(result, target_path, child) { result.state.set(child, 1); (); }; child = child + 1; }; result.state.set(target_path, 1); sh_b_action(result, ast, node, target_binding, 1, result.scope, 0); result.action_paths.set(result.action_paths.len() - 1, target_path); (); }; } else if kind == 61 or kind == 65 { let condition = sh_ast_child(ast, node, 0); sh_ce_ow_walk(effects, loans, fresh, result, text, checked, ast, condition, false, -1); let before = sh_b_state_copy(result); let before_loans = sh_b_loans_copy(result); let joined = vec_new_i64(); let joined_loans = vec_new_i64(); let mut falling = 0; let mut index = 1; while index < sh_ast_word(ast, node, 6) { sh_b_state_restore(result, &before); sh_b_loans_restore(result, &before_loans); result.flow = 0; sh_ce_ow_walk(effects, loans, fresh, result, text, checked, ast, sh_ast_child(ast, node, index), moving, holder); if result.flow == 0 { let mut at = 0; while at < result.state.len() { let state = result.state.get(at).unwrap_or(0); if at >= joined.len() { joined.push(if falling == 0 { state; } else { sh_b_join_state(sh_b_saved_state(result, &before, at), state); }); (); } else { joined.set(at, sh_b_join_state(joined.get(at).unwrap_or(0), state)); (); }; at = at + 1; }; at = 0; while at < result.loans.len() / 5 { let active = result.loans.get(at * 5 + 4).unwrap_or(0); if at >= joined_loans.len() { joined_loans.push(active); (); } else { joined_loans.set(at, joined_loans.get(at).unwrap_or(0) | active); (); }; at = at