def sh_check_ownership_collection_effect_functions(provider: &ShCollectionProvider, mapping: &ShCollectionProviders, provider_root: &str, manifest_pin: &str, artifact_pin: &str, origins: &ShOriginFacts, loans: &ShBackingLoans, nll: &ShLoanLiveness, handles: &ShCollectionHandles, effects: &ShCollectionEffects, graph: &ShModules, analyzed: &ShModuleChecked, identity: &str, digest: &str, prototype: &str, option_identity: &str, option_digest: &str, requested: &Vec<i64>, max_diagnostics: i64, development: bool) -> ShCollectionOwnership {
    let functions = vec_new_i64();
    let coverage = vec_new_i64();
    let mut ownership = sh_ownership_from_facts(vec_new_i64(), vec_new_i64(), vec_new_i64(), max_diagnostics);
    if requested.len() < 1 or requested.len() > 100000 or sh_collection_effects_validate(effects, provider, mapping, provider_root, manifest_pin, artifact_pin, origins, loans, nll, handles, graph, analyzed, identity, digest, prototype, option_identity, option_digest, development) != 0 { ownership.error = 6120; return ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: 6120 }; };
    let checked = &analyzed.checked;
    let ast = &analyzed.front.parsed.ast;
    let mut at = 0;
    while at < requested.len() { let function = sh_origin_at(requested, at); let declaration = sh_binding_word(checked, function, 4); let body = sh_s_child_kind(ast, declaration, 40); if sh_binding_word(checked, function, 2) != 2 or body < 0 or sh_module_binding_source(analyzed, function) != graph.root or sh_cb_in(&functions, function) or sh_binding_word(checked, sh_binding_word(checked, function, 6), 2) == 7 or sh_collection_effect_function_error(effects, nll, loans, function) != 0 { ownership.error = 6120; return ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: 6120 }; }; if not functions.push(function) { ownership.error = 6110; return ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: 6110 }; }; at = at + 1; };
    let frozen_words = sh_cb_words(&checked.types.words);
    let frozen_arguments = sh_cb_words(&checked.types.arguments);
    ownership = sh_ce_ow_analyze(effects, loans, &effects.handles, analyzed, &functions, false, &analyzed.front.expanded.text, ast, checked, max_diagnostics);
    at = 0;
    while at < effects.handles.diagnostics.len() / 5 { let owner = sh_ch_at(&effects.handles.diagnostics, at, 5, 0); if sh_cb_in(&functions, owner) { sh_b_error(&mut ownership, ast, sh_ch_at(&effects.handles.diagnostics, at, 5, 2), 6121, owner, sh_ch_at(&effects.handles.diagnostics, at, 5, 1)); }; at = at + 1; };
    at = 0;
    while at < functions.len() { let function = sh_origin_at(&functions, at); let declaration = sh_binding_word(checked, function, 4); let body = sh_s_child_kind(ast, declaration, 40); let mut code = 0; let mut row = 0; while row < ownership.diagnostics.len() { let diagnostic = ownership.diagnostics.get(row); if sh_ch_owner(checked, diagnostic.node) == function and code == 0 { code = diagnostic.code; }; row = row + 1; }; if not (coverage.push(function) and coverage.push(declaration) and coverage.push(body) and coverage.push(graph.root) and coverage.push(sh_binding_word(checked, function, 3)) and coverage.push(3) and coverage.push(0) and coverage.push(code)) { ownership.error = 6110; }; at = at + 1; };
    if not sh_o_equal(&frozen_words, &checked.types.words) or not sh_o_equal(&frozen_arguments, &checked.types.arguments) { ownership.error = 6123; };
    let code = ownership.error;
    ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: code };
}

def sh_collection_effect_ownership_validate(saved: &ShCollectionOwnership, provider: &ShCollectionProvider, mapping: &ShCollectionProviders, provider_root: &str, manifest_pin: &str, artifact_pin: &str, origins: &ShOriginFacts, loans: &ShBackingLoans, nll: &ShLoanLiveness, handles: &ShCollectionHandles, effects: &ShCollectionEffects, graph: &ShModules, analyzed: &ShModuleChecked, identity: &str, digest: &str, prototype: &str, option_identity: &str, option_digest: &str, requested: &Vec<i64>, max_diagnostics: i64, development: bool) -> i64 {
    let actual = sh_check_ownership_collection_effect_functions(provider, mapping, provider_root, manifest_pin, artifact_pin, origins, loans, nll, handles, effects, graph, analyzed, identity, digest, prototype, option_identity, option_digest, requested, max_diagnostics, development);
    if actual.error != 0 { return actual.error; };
    if saved.error != actual.error or not sh_o_equal(&saved.functions, &actual.functions) or not sh_o_equal(&saved.coverage, &actual.coverage) or not sh_collection_ownership_equal(&saved.ownership, &actual.ownership) { return 6122; };
    0;
}

def sh_ce_ow_logical(effects: &ShCollectionEffects, loans: &ShBackingLoans, fresh: &ShCollectionHandles, result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64) {
    sh_ce_ow_walk(effects, loans, fresh, result, text, checked, ast, sh_ast_child(ast, node, 0), false, -1);
    if result.flow != 0 { return; };
    let before = sh_b_state_copy(result);
    let before_loans = sh_b_loans_copy(result);
    sh_ce_ow_walk(effects, loans, fresh, result, text, checked, ast, sh_ast_child(ast, node, 1), false, -1);
    if result.flow != 0 { sh_b_state_restore(result, &before); sh_b_loans_restore(result, &before_loans); } else { let mut index = 0; while index < result.state.len() { result.state.set(index, sh_b_join_state(result.state.get(index).unwrap_or(0), sh_b_saved_state(result, &before, index))); index = index + 1; }; index = 0; while index < result.loans.len() { result.loans.set(index + 4, result.loans.get(index + 4).unwrap_or(0) | sengoo_vec_get_or_default_i64(before_loans.handle, index / 5, 0)); index = index + 5; }; };
    result.flow = 0;
}

def sh_ce_ow_walk(effects: &ShCollectionEffects, loans: &ShBackingLoans, fresh: &ShCollectionHandles, result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64, moving: bool, holder: i64) {
