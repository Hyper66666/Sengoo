import selfhost_x64;

def sh_x64_scalar_memory(output: &ShBinary, store: bool, register: i64, base: i64, displacement: i64, width: i64, signed: bool) -> Result<i64, i64> {
    if not sh_x64_register(register) or not sh_x64_register(base) or displacement < -2147483648 or displacement > 2147483647 or width != 1 and width != 2 and width != 4 and width != 8 { return sh_i64_error(6101); };
    let start = sh_binary_len(output);
    let mut valid = true;
    if store and width == 2 { valid = sh_binary_byte(output, 102).is_ok(); };
    let wide = if width == 8 or not store and (signed or width < 4) { 8; } else { 0; };
    valid = valid and sh_binary_byte(output, 64 | wide | ((register >> 3) << 2) | (base >> 3)).is_ok();
    if store { valid = valid and sh_binary_byte(output, if width == 1 { 136; } else { 137; }).is_ok(); } else { if width < 4 { valid = valid and sh_binary_byte(output, 15).is_ok() and sh_binary_byte(output, if signed { if width == 1 { 190; } else { 191; }; } else { if width == 1 { 182; } else { 183; }; }).is_ok(); } else { valid = valid and sh_binary_byte(output, if width == 4 and signed { 99; } else { 139; }).is_ok(); }; };
    valid = valid and sh_binary_byte(output, 128 | ((register & 7) << 3) | (base & 7)).is_ok();
    if (base & 7) == 4 { valid = valid and sh_binary_byte(output, 36).is_ok(); };
    valid = valid and sh_binary_i32(output, displacement).is_ok();
    if not valid { return sh_x64_rewind(output, start, 6001); };
    sh_i64_ok(start);
}

def sh_x64_stack_adjust(output: &ShBinary, bytes: i64, restore: bool) -> Result<i64, i64> {
    if bytes < 0 or bytes > 2147483647 { return sh_i64_error(6101); };
    let start = sh_binary_len(output);
    let valid = sh_binary_byte(output, 72).is_ok() and sh_binary_byte(output, 129).is_ok() and sh_binary_byte(output, if restore { 196; } else { 236; }).is_ok() and sh_binary_i32(output, bytes).is_ok();
    if not valid { return sh_x64_rewind(output, start, 6001); };
    sh_i64_ok(start);
}

def sh_x64_shift(output: &ShBinary, operation: i64, register: i64, immediate: i64) -> Result<i64, i64> {
    if not sh_x64_register(register) or operation < 0 or operation > 2 or immediate < -1 or immediate > 63 { return sh_i64_error(6101); };
    let start = sh_binary_len(output);
    let group = if operation == 0 { 4; } else { if operation == 1 { 5; } else { 7; }; };
    let mut valid = sh_binary_byte(output, 72 | (register >> 3)).is_ok() and sh_binary_byte(output, if immediate < 0 { 211; } else { 193; }).is_ok() and sh_binary_byte(output, 192 | (group << 3) | (register & 7)).is_ok();
    if immediate >= 0 { valid = valid and sh_binary_byte(output, immediate).is_ok(); };
    if not valid { return sh_x64_rewind(output, start, 6001); };
    sh_i64_ok(start);
}

def sh_x64_unary(output: &ShBinary, operation: i64, register: i64) -> Result<i64, i64> {
    if not sh_x64_register(register) or operation < 0 or operation > 3 { return sh_i64_error(6101); };
    let group = if operation == 0 { 2; } else { if operation == 1 { 3; } else { if operation == 2 { 4; } else { 7; }; }; };
    let start = sh_binary_len(output);
    let valid = sh_binary_byte(output, 72 | (register >> 3)).is_ok() and sh_binary_byte(output, 247).is_ok() and sh_binary_byte(output, 192 | (group << 3) | (register & 7)).is_ok();
    if not valid { return sh_x64_rewind(output, start, 6001); };
    sh_i64_ok(start);
}

def sh_x64_set_condition(output: &ShBinary, condition: i64, register: i64) -> Result<i64, i64> {
    if not sh_x64_register(register) or condition < 0 or condition > 15 { return sh_i64_error(6101); };
    let start = sh_binary_len(output);
    let valid = sh_x64_mov_imm(output, register, 0).is_ok() and sh_binary_byte(output, 64 | (register >> 3)).is_ok() and sh_binary_byte(output, 15).is_ok() and sh_binary_byte(output, 144 + condition).is_ok() and sh_binary_byte(output, 192 | (register & 7)).is_ok();
    if not valid { return sh_x64_rewind(output, start, 6001); };
    sh_i64_ok(start);
}

def sh_x64_call_register(output: &ShBinary, register: i64) -> Result<i64, i64> {
    if not sh_x64_register(register) { return sh_i64_error(6101); };
    let start = sh_binary_len(output);
    let valid = sh_binary_byte(output, 64 | (register >> 3)).is_ok() and sh_binary_byte(output, 255).is_ok() and sh_binary_byte(output, 208 | (register & 7)).is_ok();
    if not valid { return sh_x64_rewind(output, start, 6001); };
    sh_i64_ok(start);
}

def sh_x64_probe_stack(output: &ShBinary, frame: i64) -> Result<i64, i64> {
    if frame <= 4096 or frame > 2147483632 or frame % 16 != 0 { return sh_i64_error(6101); };
    let start = sh_binary_len(output);
    let valid = sh_x64_mov_imm(output, 0, frame).is_ok() and sh_x64_branch(output, 1, 0).is_ok() and sh_binary_byte(output, 72).is_ok() and sh_binary_byte(output, 41).is_ok() and sh_binary_byte(output, 196).is_ok();
    if not valid { return sh_x64_rewind(output, start, 6001); };
    sh_i64_ok(start);
}

def sh_x64_rip_address(output: &ShBinary, register: i64) -> Result<i64, i64> {
    if not sh_x64_register(register) { return sh_i64_error(6101); };
    let start = sh_binary_len(output);
    let valid = sh_binary_byte(output, 72 | ((register >> 3) << 2)).is_ok() and sh_binary_byte(output, 141).is_ok() and sh_binary_byte(output, 5 | ((register & 7) << 3)).is_ok();
    let offset = sh_binary_len(output);
    if not valid or not sh_binary_unsigned(output, 0, 4).is_ok() { return sh_x64_rewind(output, start, 6001); };
    sh_i64_ok(offset);
}
