import selfhost_mir;

import selfhost_lexer;

def sh_mir_problem(mir: &ShMir, error: i64, function: i64, block: i64, instruction: i64) -> ShMirValidation {
    let mut source = -1;
    let mut start = 0;
    let mut end = 0;
    if instruction >= 0 and instruction < sh_mir_inst_count(mir) { source = sh_mir_inst(mir, instruction, 9); start = sh_mir_inst(mir, instruction, 10); end = sh_mir_inst(mir, instruction, 11); } else { if block >= 0 and block < sh_mir_block_count(mir) { let span = sh_mir_block(mir, block, 6); source = sh_mir_word(&mir.spans, 3, span, 0); start = sh_mir_word(&mir.spans, 3, span, 1); end = sh_mir_word(&mir.spans, 3, span, 2); }; };
    ShMirValidation { error: error, function: function, block: block, instruction: instruction, source: source, start: start, end: end };
}

def sh_mir_reachable(mir: &ShMir, entry: i64, target: i64, avoid: i64) -> i64 {
    let count = sh_mir_block_count(mir);
    if entry < 0 or entry >= count or target < 0 or target >= count or avoid < -1 or avoid >= count { return -1; };
    if entry == avoid { return 0; };
    if entry == target { return 1; };
    let seen = vec_new_i64();
    let queue = vec_new_i64();
    let mut index = 0;
    while index < count { if not seen.push(0) { return -1; }; index = index + 1; };
    if not seen.set(entry, 1) or not queue.push(entry) { return -1; };
    let function = sh_mir_block(mir, entry, 0);
    index = 0;
    while index < queue.len() { let block = sengoo_vec_get_or_default_i64(queue.handle, index, -1); let term = sh_mir_block(mir, block, 4); if term < 0 or term >= sh_mir_term_count(mir) { return -1; }; let first = sh_mir_term(mir, term, 4); let edges = sh_mir_term(mir, term, 5); if first < 0 or edges < 0 or first > sh_mir_edge_count(mir) or edges > sh_mir_edge_count(mir) - first { return -1; }; let mut edge = 0; while edge < edges { let next = sh_mir_edge(mir, first + edge, 1); if next < 0 or next >= count or sh_mir_block(mir, next, 0) != function { return -1; }; if next != avoid { if next == target { return 1; }; if sengoo_vec_get_or_default_i64(seen.handle, next, -1) == 0 { if not seen.set(next, 1) or not queue.push(next) { return -1; }; }; }; edge = edge + 1; }; index = index + 1; };
    0;
}

def sh_mir_use_valid(mir: &ShMir, value: i64, function: i64, block: i64, before: i64) -> i64 {
    if value < 0 or value >= sh_mir_inst_count(mir) or sh_mir_inst(mir, value, 0) != function { return 5005; };
    let defined = sh_mir_inst(mir, value, 1);
    if defined == block { if value >= before { return 5005; }; return 0; };
    let accessible = sh_mir_reachable(mir, sh_mir_fn(mir, function, 2), block, -1);
    if accessible < 0 { return 5004; };
    if accessible == 0 { return 5005; };
    let reaches = sh_mir_reachable(mir, sh_mir_fn(mir, function, 2), block, defined);
    if reaches < 0 { return 5004; };
    if reaches == 1 { return 5005; };
    0;
}

def sh_mir_pointer(mir: &ShMir, ty: i64) -> bool {
    let kind = sh_mir_type_word(mir, ty, 0);
    kind == 6 or kind == 7;
}

def sh_mir_layout_id(mir: &ShMir, ty: i64) -> i64 {
    let mut row = 0;
    while row < sh_mir_count(&mir.layouts, 7) { if sh_mir_word(&mir.layouts, 7, row, 0) == ty and sh_mir_word(&mir.layouts, 7, row, 1) == -1 { return row; }; row = row + 1; };
    -1;
}

def sh_mir_validate_parents(mir: &ShMir) -> i64 {
    let count = sh_mir_count(&mir.parents, 2);
    if count < 0 or count > mir.limit { return 5001; };
    let mut row = 0;
    while row < count { let child = sh_mir_word(&mir.parents, 2, row, 0); let parent = sh_mir_word(&mir.parents, 2, row, 1); if child == parent or sh_mir_type_word(mir, child, 0) != 12 or sh_mir_type_word(mir, parent, 0) != 12 or sh_mir_type_word(mir, child, 1) != 2 or sh_mir_type_word(mir, parent, 1) != 2 or sh_mir_type_word(mir, child, 3) == sh_mir_type_word(mir, parent, 3) { return 5003; }; let mut previous = 0; while previous < row { if sh_mir_word(&mir.parents, 2, previous, 0) == child { return 5003; }; previous = previous + 1; }; if sh_mir_class_ancestor(mir, parent, child) { return 5003; }; let child_layout = sh_mir_layout_id(mir, child); let parent_layout = sh_mir_layout_id(mir, parent); if child_layout < 0 or parent_layout < 0 or sh_mir_field_count(mir, child, -1) < sh_mir_field_count(mir, parent, -1) { return 5003; }; let mut field = 0; while field < sh_mir_field_count(mir, parent, -1) { if sh_mir_field_type(mir, child, -1, field) != sh_mir_field_type(mir, parent, -1, field) { return 5003; }; let child_offset = sh_mir_word(&mir.fields, 2, sh_mir_word(&mir.layouts, 7, child_layout, 2) + field, 1); let parent_offset = sh_mir_word(&mir.fields, 2, sh_mir_word(&mir.layouts, 7, parent_layout, 2) + field, 1); if child_offset != parent_offset { return 5003; }; field = field + 1; }; let child_size = sh_mir_word(&mir.layouts, 7, child_layout, 5); let parent_size = sh_mir_word(&mir.layouts, 7, parent_layout, 5); let child_align = sh_mir_word(&mir.layouts, 7, child_layout, 6); let parent_align = sh_mir_word(&mir.layouts, 7, parent_layout, 6); if child_size >= 0 and parent_size >= 0 and child_size < parent_size or child_align >= 0 and parent_align >= 0 and child_align < parent_align { return 5003; }; row = row + 1; };
    0;
}

def sh_mir_validate_types(mir: &ShMir) -> i64 {
    if sh_mir_count(&mir.types.words, 6) < 0 or mir.types.arguments.len() > mir.limit { return 5001; };
    let mut ty = 0;
    while ty < sh_type_count(&mir.types) { let kind = sh_mir_type_word(mir, ty, 0); let data = sh_mir_type_word(mir, ty, 1); let flags = sh_mir_type_word(mir, ty, 2); let nominal = sh_mir_type_word(mir, ty, 3); let first = sh_mir_type_word(mir, ty, 4); let count = sh_mir_type_word(mir, ty, 5); if first < 0 or count < 0 or first > mir.types.arguments.len() or count > mir.types.arguments.len() - first or not sh_type_shape(kind, data, flags, nominal, count) { return 5003; }; if kind >= 12 and kind <= 15 and nominal >= sh_symbol_count(&mir.symbols) { return 5003; }; let mut argument = 0; while argument < count { let value = sh_mir_type_arg(mir, ty, argument); if value < 0 or value >= ty { return 5003; }; argument = argument + 1; }; ty = ty + 1; };
    let mut layout = 0;
    while layout < sh_mir_count(&mir.layouts, 7) { let layout_type = sh_mir_word(&mir.layouts, 7, layout, 0); let variant = sh_mir_word(&mir.layouts, 7, layout, 1); let first = sh_mir_word(&mir.layouts, 7, layout, 2); let count = sh_mir_word(&mir.layouts, 7, layout, 3); let destructor = sh_mir_word(&mir.layouts, 7, layout, 4); let size = sh_mir_word(&mir.layouts, 7, layout, 5); let alignment = sh_mir_word(&mir.layouts, 7, layout, 6); if sh_mir_type_word(mir, layout_type, 0) != 12 or variant < -1 or (sh_mir_type_word(mir, layout_type, 1) == 1) != (variant >= 0) or first < 0 or count < 0 or first > sh_mir_count(&mir.fields, 2) or count > sh_mir_count(&mir.fields, 2) - first or destructor < -2 or destructor >= sh_mir_fn_count(mir) or size < -1 or alignment < -1 or (size >= 0 and alignment <= 0) or alignment > 4096 { return 5003; }; let mut power = 1; while power < alignment { power = power * 2; }; if alignment > 0 and power != alignment { return 5003; }; let mut previous = 0; while previous < layout { if sh_mir_word(&mir.layouts, 7, previous, 0) == layout_type and sh_mir_word(&mir.layouts, 7, previous, 1) == variant { return 5003; }; previous = previous + 1; }; let mut field = 0; while field < count { let field_type = sh_mir_word(&mir.fields, 2, first + field, 0); let offset = sh_mir_word(&mir.fields, 2, first + field, 1); if not sh_mir_valid_type(mir, field_type) or offset < -1 or size >= 0 and (offset < 0 or offset > size) { return 5003; }; field = field + 1; }; if destructor >= 0 { let signature = sh_mir_fn(mir, destructor, 1); let parameter = sh_mir_type_arg(mir, signature, 0); let result = sh_mir_type_arg(mir, signature, 1); if sh_mir_type_word(mir, signature, 0) != 11 or sh_mir_type_word(mir, signature, 1) != 0 or sh_mir_type_word(mir, signature, 5) != 2 or sh_mir_type_word(mir, parameter, 0) != 6 or sh_mir_type_word(mir, parameter, 2) != 1 or sh_mir_type_arg(mir, parameter, 0) != layout_type or sh_mir_type_word(mir, result, 0) != 0 { return 5007; }; }; layout = layout + 1; };
    let mut field = 0;
    while field < sh_mir_count(&mir.fields, 2) { if not sh_mir_valid_type(mir, sh_mir_word(&mir.fields, 2, field, 0)) or sh_mir_word(&mir.fields, 2, field, 1) < -1 { return 5003; }; let mut owners = 0; layout = 0; while layout < sh_mir_count(&mir.layouts, 7) { let first = sh_mir_word(&mir.layouts, 7, layout, 2); if field >= first and field - first < sh_mir_word(&mir.layouts, 7, layout, 3) { owners = owners + 1; }; layout = layout + 1; }; if owners != 1 { return 5003; }; field = field + 1; };
    0;
}

def sh_mir_value_type(mir: &ShMir, value: i64) -> i64 {
    sh_mir_inst(mir, value, 3);
}

def sh_mir_runtime_pointer(mir: &ShMir, id: i64) -> i64 {
    let returned = sh_mir_inst_arg(mir, id, 0);
    let receiver = sh_mir_inst_arg(mir, id, 1);
    let ty = sh_mir_inst(mir, id, 3);
    let receiver_type = sh_mir_value_type(mir, receiver);
    let nominal = sh_mir_type_arg(mir, receiver_type, 0);
    let function = sh_mir_inst(mir, id, 7);
    if sh_mir_inst(mir, id, 5) != 2 or sh_mir_inst(mir, id, 6) != 1 or sh_mir_inst(mir, id, 8) != 0 or sh_mir_type_word(mir, ty, 0) != 6 or sh_mir_type_word(mir, ty, 2) != 0 or sh_mir_type_word(mir, sh_mir_type_arg(mir, ty, 0), 0) != 5 or sh_mir_type_word(mir, receiver_type, 0) != 6 or sh_mir_type_word(mir, receiver_type, 2) != 0 or sh_mir_type_word(mir, nominal, 0) != 12 or sh_mir_type_word(mir, nominal, 1) != 0 { return 5007; };
    let label = sh_symbol_text(&mir.symbols, sh_mir_type_word(mir, nominal, 3));
    if not label.is_ok() or label.value.as_str() != "String" { return 5007; };
    if function < 0 or function >= sh_mir_fn_count(mir) or sh_mir_fn(mir, function, 3) % 2 != 1 { return 5006; };
    let name = sh_symbol_text(&mir.symbols, sh_mir_fn(mir, function, 0));
    let signature = sh_mir_fn(mir, function, 1);
    let argument = sh_mir_type_arg(mir, signature, 0);
    if not name.is_ok() or name.value.as_str() != "sengoo_string_as_str_ptr" or sh_mir_type_word(mir, signature, 0) != 11 or sh_mir_type_word(mir, signature, 1) != 1 or sh_mir_type_word(mir, signature, 2) != 0 or sh_mir_type_word(mir, signature, 5) != 2 or argument != sh_mir_type_arg(mir, signature, 1) or sh_mir_type_word(mir, argument, 0) != 2 or sh_mir_type_word(mir, argument, 1) != 64 or sh_mir_type_word(mir, argument, 2) != 1 { return 5006; };
    if sh_mir_inst(mir, returned, 2) != 20 or sh_mir_inst(mir, returned, 3) != argument or sh_mir_inst(mir, returned, 5) != 1 or sh_mir_inst(mir, returned, 6) != function or sh_mir_inst(mir, returned, 7) != 1 or sh_mir_inst(mir, returned, 8) != 0 { return 5007; };
    let loaded = sh_mir_inst_arg(mir, returned, 0);
    let field = sh_mir_inst_arg(mir, loaded, 0);
    let pointer = sh_mir_value_type(mir, field);
    if sh_mir_inst(mir, loaded, 2) != 14 or sh_mir_inst(mir, loaded, 3) != argument or sh_mir_inst(mir, loaded, 5) != 1 or sh_mir_inst(mir, field, 2) != 17 or sh_mir_inst(mir, field, 5) != 1 or sh_mir_inst(mir, field, 6) != 0 or sh_mir_inst(mir, field, 7) != -1 or sh_mir_inst(mir, field, 8) != 0 or sh_mir_inst_arg(mir, field, 0) != receiver or sh_mir_type_word(mir, pointer, 0) != 6 or sh_mir_type_word(mir, pointer, 2) != 0 or sh_mir_type_arg(mir, pointer, 0) != argument or sh_mir_field_type(mir, nominal, -1, 0) != argument { return 5007; };
    0;
}

def sh_mir_callback_byte_pointer(mir: &ShMir, ty: i64) -> bool {
    if sh_mir_type_word(mir, ty, 0) != 7 or sh_mir_type_word(mir, ty, 1) != 0 or sh_mir_type_word(mir, ty, 2) != 1 or sh_mir_type_word(mir, ty, 3) != -1 or sh_mir_type_word(mir, ty, 5) != 1 { return false; };
    let byte = sh_mir_type_arg(mir, ty, 0);
    sh_mir_type_word(mir, byte, 0) == 2 and sh_mir_type_word(mir, byte, 1) == 8 and sh_mir_type_word(mir, byte, 2) == 0 and sh_mir_type_word(mir, byte, 3) == -1 and sh_mir_type_word(mir, byte, 5) == 0;
}

def sh_mir_callback_erasure(mir: &ShMir, id: i64) -> i64 {
    let kind = sh_mir_inst(mir, id, 6);
    let output = sh_mir_inst(mir, id, 3);
    if sh_mir_inst(mir, id, 5) != 1 or (kind != 1 and kind != 2) or sh_mir_inst(mir, id, 7) != 0 or sh_mir_inst(mir, id, 8) != 0 or not sh_mir_callback_byte_pointer(mir, output) { return 5006; };
    let address = sh_mir_inst_arg(mir, id, 0);
    if address < 0 or address >= sh_mir_inst_count(mir) or sh_mir_inst(mir, address, 2) != 9 or sh_mir_inst(mir, address, 5) != 0 or sh_mir_inst(mir, address, 7) != 0 or sh_mir_inst(mir, address, 8) != 0 { return 5006; };
    let target = sh_mir_inst(mir, address, 6);
    if target < 0 or target >= sh_mir_fn_count(mir) or sh_mir_fn(mir, target, 3) != 0 { return 5006; };
    let signature = sh_mir_fn(mir, target, 1);
    let count = if kind == 1 { 2; } else { 1; };
    if sh_mir_inst(mir, address, 3) != signature or sh_mir_type_word(mir, signature, 0) != 11 or sh_mir_type_word(mir, signature, 1) != 1 or sh_mir_type_word(mir, signature, 2) != 0 or sh_mir_type_word(mir, signature, 5) != count + 1 { return 5006; };
    let entry = sh_mir_fn(mir, target, 2);
    if entry < 0 or entry >= sh_mir_block_count(mir) or sh_mir_block(mir, entry, 0) != target or sh_mir_block(mir, entry, 4) < 0 { return 5006; };
    let mut index = 0;
    while index < count { if sh_mir_type_arg(mir, signature, index) != output { return 5006; }; index = index + 1; };
    let returned = sh_mir_type_arg(mir, signature, count);
    if sh_mir_type_word(mir, returned, 0) != 0 { return 5006; };
    0;
}

def sh_mir_inst_typecheck(mir: &ShMir, id: i64) -> i64 {
    let opcode = sh_mir_inst(mir, id, 2);
    let ty = sh_mir_inst(mir, id, 3);
    let count = sh_mir_inst(mir, id, 5);
    let aux = sh_mir_inst(mir, id, 6);
    let extra = sh_mir_inst(mir, id, 7);
    let flags = sh_mir_inst(mir, id, 8);
    let kind = sh_mir_type_word(mir, ty, 0);
    let function = sh_mir_inst(mir, id, 0);
    let block = sh_mir_inst(mir, id, 1);
    let first = sh_mir_inst_arg(mir, id, 0);
    let second = sh_mir_inst_arg(mir, id, 1);
    let a = sh_mir_value_type(mir, first);
    let b = sh_mir_value_type(mir, second);
    if opcode == 1 { let signature = sh_mir_fn(mir, function, 1); let parameters = sh_mir_type_word(mir, signature, 5) - 1; if count != 0 or aux < 0 or aux >= parameters or block != sh_mir_fn(mir, function, 2) or ty != sh_mir_type_arg(mir, signature, aux) { return 5006; }; return 0; };
    if opcode == 2 { if count != 0 or aux < 0 or sh_mir_parameter(mir, block, aux) != id { return 5003; }; return 0; };
    if opcode == 3 { return if count == 0 and kind == 0 { 0; } else { 5003; }; };
    if opcode == 4 { return if count == 0 and kind == 2 { 0; } else { 5003; }; };
    if opcode == 5 { return if count == 0 and kind == 3 and (flags == 0 or flags == 1 and aux >= 0 and aux < sh_symbol_count(&mir.symbols)) { 0; } else { 5003; }; };
    if opcode == 6 { return if count == 0 and kind == 1 and (aux == 0 or aux == 1) { 0; } else { 5003; }; };
    if opcode == 7 { return if count == 0 and kind == 4 and aux >= 0 and aux <= 1114111 and not (aux >= 55296 and aux <= 57343) { 0; } else { 5003; }; };
    if opcode == 8 { return if count == 0 and (kind == 5 or kind == 6 and sh_mir_type_word(mir, sh_mir_type_arg(mir, ty, 0), 0) == 5 or kind == 9 and sh_mir_type_word(mir, sh_mir_type_arg(mir, ty, 0), 0) == 2) and aux >= 0 and aux < sh_symbol_count(&mir.symbols) { 0; } else { 5003; }; };
    if opcode == 9 { return if count == 0 and kind == 11 and aux >= 0 and aux < sh_mir_fn_count(mir) and ty == sh_mir_fn(mir, aux, 1) { 0; } else { 5006; }; };
    if opcode == 10 { if count != 1 or a != ty { return 5003; }; if aux == sh_kind("-") { return if kind == 2 or kind == 3 { 0; } else { 5003; }; }; if aux == sh_kind("!") or aux == sh_kind("not") { return if kind == 1 { 0; } else { 5003; }; }; if aux == sh_kind("~") { return if kind == 2 { 0; } else { 5003; }; }; return 5003; };
    if opcode == 11 { if count != 2 or a != b { return 5003; }; let input_kind = sh_mir_type_word(mir, a, 0); if aux == sh_kind("==") or aux == sh_kind("!=") or aux == sh_kind("<") or aux == sh_kind("<=") or aux == sh_kind(">") or aux == sh_kind(">=") { return if kind == 1 and (input_kind >= 1 and input_kind <= 4 or input_kind == 6 or input_kind == 7 or input_kind == 11) { 0; } else { 5003; }; }; if aux == sh_kind("&&") or aux == sh_kind("||") or aux == sh_kind("and") or aux == sh_kind("or") { return if kind == 1 and input_kind == 1 { 0; } else { 5003; }; }; if a != ty { return 5003; }; if aux == sh_kind("+") or aux == sh_kind("-") or aux == sh_kind("*") or aux == sh_kind("/") or aux == sh_kind("%") { return if kind == 2 or kind == 3 { 0; } else { 5003; }; }; if aux == sh_kind("&") or aux == sh_kind("|") or aux == sh_kind("^") or aux == sh_kind("<<") or aux == sh_kind(">>") { return if kind == 2 { 0; } else { 5003; }; }; return 5003; };
    if opcode == 12 { if count != 1 or flags < 0 or flags > 2 { return 5003; }; let input_kind = sh_mir_type_word(mir, a, 0); if flags == 2 { let source = sh_mir_type_arg(mir, a, 0); let target = sh_mir_type_arg(mir, ty, 0); return if kind == 6 and input_kind == 6 and sh_mir_type_word(mir, ty, 2) <= sh_mir_type_word(mir, a, 2) and (source == target or sh_mir_type_word(mir, source, 0) == 12 and sh_mir_type_word(mir, target, 0) == 12 and sh_mir_type_word(mir, source, 1) == 2 and sh_mir_type_word(mir, target, 1) == 2 and sh_mir_class_ancestor(mir, source, target)) { 0; } else { 5003; }; }; if kind >= 1 and kind <= 4 and input_kind >= 1 and input_kind <= 4 { return 0; }; if flags == 1 and (kind == 7 or kind == 2 and sh_mir_type_word(mir, ty, 1) == 64) and (input_kind == 7 or input_kind == 2 and sh_mir_type_word(mir, a, 1) == 64) { return 0; }; return 5003; };
    if opcode == 13 { if count != 0 or not sh_mir_pointer(mir, ty) or aux < 0 or aux >= sh_mir_local_count(mir) or sh_mir_local(mir, aux, 0) != function or sh_mir_type_arg(mir, ty, 0) != sh_mir_local(mir, aux, 1) { return 5007; }; if sh_mir_type_word(mir, ty, 2) % 2 == 1 and sh_mir_local(mir, aux, 4) % 2 == 0 { return 5007; }; return 0; };
    if opcode == 14 { return if count == 1 and sh_mir_pointer(mir, a) and sh_mir_type_arg(mir, a, 0) == ty { 0; } else { 5007; }; };
    if opcode == 15 { return if count == 2 and kind == 0 and sh_mir_pointer(mir, a) and sh_mir_type_word(mir, a, 2) % 2 == 1 and sh_mir_type_arg(mir, a, 0) == b { 0; } else { 5007; }; };
    if opcode == 16 or opcode == 24 { let variant = if opcode == 24 { aux; } else { -1; }; let fields = sh_mir_field_count(mir, ty, variant); if fields < 0 or count != fields or opcode == 24 and (kind != 12 or sh_mir_type_word(mir, ty, 1) != 1) { return 5003; }; let mut i = 0; while i < count { if sh_mir_value_type(mir, sh_mir_inst_arg(mir, id, i)) != sh_mir_field_type(mir, ty, variant, i) { return 5003; }; i = i + 1; }; return 0; };
    if opcode == 17 { if count != 1 or not sh_mir_pointer(mir, a) or not sh_mir_pointer(mir, ty) or sh_mir_type_word(mir, a, 0) != kind { return 5007; }; if sh_mir_type_word(mir, ty, 2) > sh_mir_type_word(mir, a, 2) { return 5007; }; return if sh_mir_type_arg(mir, ty, 0) == sh_mir_field_type(mir, sh_mir_type_arg(mir, a, 0), extra, aux) { 0; } else { 5007; }; };
    if opcode == 18 { return if count == 1 and ty == sh_mir_field_type(mir, a, extra, aux) { 0; } else { 5003; }; };
    if opcode == 19 { if count != 2 or not sh_mir_pointer(mir, a) or not sh_mir_pointer(mir, ty) or sh_mir_type_word(mir, b, 0) != 2 or sh_mir_type_word(mir, a, 0) != kind { return 5007; }; let base = sh_mir_type_arg(mir, a, 0); let base_kind = sh_mir_type_word(mir, base, 0); let element = if base_kind == 8 or base_kind == 9 { sh_mir_type_arg(mir, base, 0); } else { base; }; if base_kind != 8 and base_kind != 9 and sh_mir_type_word(mir, a, 0) != 7 { return 5007; }; return if element == sh_mir_type_arg(mir, ty, 0) and sh_mir_type_word(mir, ty, 2) <= sh_mir_type_word(mir, a, 2) { 0; } else { 5007; }; };
    if opcode == 20 { let signature = if aux >= 0 and aux < sh_mir_fn_count(mir) { sh_mir_fn(mir, aux, 1); } else { a; }; let prefix = if aux == -1 { 1; } else { 0; }; if aux < -1 or aux >= sh_mir_fn_count(mir) or sh_mir_type_word(mir, signature, 0) != 11 or extra != sh_mir_type_word(mir, signature, 1) { return 5006; }; let parameters = sh_mir_type_word(mir, signature, 5) - 1; let variadic = sh_mir_type_word(mir, signature, 2) % 2 == 1; if count - prefix < parameters or not variadic and count - prefix != parameters or variadic and extra != 1 or ty != sh_mir_type_arg(mir, signature, parameters) { return 5006; }; let mut i = 0; while i < parameters { if sh_mir_value_type(mir, sh_mir_inst_arg(mir, id, i + prefix)) != sh_mir_type_arg(mir, signature, i) { return 5006; }; i = i + 1; }; while i < count - prefix { let promoted = sh_mir_value_type(mir, sh_mir_inst_arg(mir, id, i + prefix)); let promoted_kind = sh_mir_type_word(mir, promoted, 0); if not (promoted_kind == 2 and sh_mir_type_word(mir, promoted, 1) >= 32 or promoted_kind == 3 and sh_mir_type_word(mir, promoted, 1) == 64 or promoted_kind == 7 or promoted_kind == 11) { return 5006; }; i = i + 1; }; return 0; };
    if opcode == 21 { if count != 1 or kind != 0 or not sh_mir_pointer(mir, a) or sh_mir_type_word(mir, a, 2) != 1 or extra != sh_mir_type_arg(mir, a, 0) or flags < 0 or flags > 1 { return 5007; }; if aux >= 0 and (aux >= sh_mir_local_count(mir) or sh_mir_local(mir, aux, 0) != function or sh_mir_local(mir, aux, 1) != extra or sh_mir_local(mir, aux, 4) < 2 or sh_mir_inst(mir, first, 2) != 13 or sh_mir_inst(mir, first, 6) != aux) { return 5007; }; if aux < -1 { return 5007; }; return 0; };
