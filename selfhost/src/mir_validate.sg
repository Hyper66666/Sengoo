2 == 1 { defaults = defaults + 1; }; let mut arg = 0; while arg < arguments { let operand = sh_mir_edge_arg(mir, id, arg); let parameter = sh_mir_parameter(mir, target, arg); if operand < 0 or operand >= sh_mir_inst_count(mir) or sh_mir_inst(mir, operand, 0) != function { return sh_mir_problem(mir, 5005, function, block, operand); }; if sh_mir_value_type(mir, operand) != sh_mir_value_type(mir, parameter) { return sh_mir_problem(mir, 5003, function, block, operand); }; arg = arg + 1; }; edge = edge + 1; }; if kind == 5 and defaults != 1 { return sh_mir_problem(mir, 5004, function, block, -1); }; if kind == 2 and sh_mir_type_word(mir, sh_mir_value_type(mir, value), 0) != 1 { return sh_mir_problem(mir, 5003, function, block, value); }; if kind == 5 and sh_mir_type_word(mir, sh_mir_value_type(mir, value), 0) != 2 { return sh_mir_problem(mir, 5003, function, block, value); }; if kind == 3 { let signature = sh_mir_fn(mir, function, 1); let expected = sh_mir_type_arg(mir, signature, sh_mir_type_word(mir, signature, 5) - 1); if value == -1 and sh_mir_type_word(mir, expected, 0) != 0 or value >= 0 and sh_mir_value_type(mir, value) != expected { return sh_mir_problem(mir, 5003, function, block, value); }; }; i = i + 1; };
    i = 0;
    while i < sh_mir_inst_count(mir) { let function = sh_mir_inst(mir, i, 0); let block = sh_mir_inst(mir, i, 1); let first = sh_mir_inst(mir, i, 4); let count = sh_mir_inst(mir, i, 5); if function < 0 or function >= sh_mir_fn_count(mir) or block < 0 or block >= sh_mir_block_count(mir) or sh_mir_block(mir, block, 0) != function or not sh_mir_valid_type(mir, sh_mir_inst(mir, i, 3)) or first < 0 or count < 0 or first > mir.operands.len() or count > mir.operands.len() - first or i >= sh_mir_term(mir, sh_mir_block(mir, block, 4), 6) { return sh_mir_problem(mir, 5002, function, block, i); }; if not sh_mir_span_valid(mir, sh_mir_inst(mir, i, 9), sh_mir_inst(mir, i, 10), sh_mir_inst(mir, i, 11)) { return sh_mir_problem(mir, 5002, function, block, i); }; let mut arg = 0; while arg < count { let problem = sh_mir_use_valid(mir, sh_mir_inst_arg(mir, i, arg), function, block, i); if problem != 0 { return sh_mir_problem(mir, problem, function, block, i); }; arg = arg + 1; }; let problem = sh_mir_inst_typecheck(mir, i); if problem != 0 { return sh_mir_problem(mir, problem, function, block, i); }; i = i + 1; };
    i = 0;
    while i < sh_mir_term_count(mir) { let function = sh_mir_term(mir, i, 0); let block = sh_mir_term(mir, i, 1); let value = sh_mir_term(mir, i, 3); let watermark = sh_mir_term(mir, i, 6); if value >= 0 { let problem = sh_mir_use_valid(mir, value, function, block, watermark); if problem != 0 { return sh_mir_problem(mir, problem, function, block, value); }; }; let mut edge = 0; while edge < sh_mir_term(mir, i, 5) { let id = sh_mir_term(mir, i, 4) + edge; let mut arg = 0; while arg < sh_mir_edge(mir, id, 3) { let operand = sh_mir_edge_arg(mir, id, arg); let problem = sh_mir_use_valid(mir, operand, function, block, watermark); if problem != 0 { return sh_mir_problem(mir, problem, function, block, operand); }; arg = arg + 1; }; edge = edge + 1; }; i = i + 1; };
    sh_mir_problem(mir, 0, -1, -1, -1);
}
