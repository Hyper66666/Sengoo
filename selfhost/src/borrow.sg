def sh_b_native_contract(checked: &ShChecked, function: i64, position: i64) -> bool {
    let ty = sh_s_resolve(checked, sh_binding_word(checked, function, 3));
    if sh_binding_word(checked, function, 2) != 2 or (sh_binding_word(checked, function, 5) & 8) == 0 or sh_s_kind(checked, ty) != 11 or sh_s_data(checked, ty) != 1 or sh_s_flags(checked, ty) != 0 { return false; };
    let arity = sh_s_arity(checked, ty) - 1;
    let mut index = 0;
    while index <= arity { let argument = sh_s_resolve(checked, sh_s_argument(checked, ty, index)); if sh_s_kind(checked, argument) != 2 or sh_s_data(checked, argument) != 64 or sh_s_flags(checked, argument) != 1 { return false; }; index = index + 1; };
    let symbol = sh_symbol_text(&checked.symbols, sh_binding_word(checked, function, 0));
    if not symbol.is_ok() { return false; };
    let name = symbol.value.as_str();
    if name == "sengoo_unicode_version_copy" or name == "sengoo_unicode_provenance_copy" or name == "sengoo_ffi_last_error_copy" { return arity == 2 and position == 0; };
    if name == "sengoo_string_eq" or name == "sengoo_string_compare" or name == "sengoo_string_copy_to_buffer" { return arity == 2 and position < 2; };
    if name == "sengoo_string_len" or name == "sengoo_string_is_empty" or name == "sengoo_ffi_buffer_len" or name == "sengoo_ffi_buffer_capacity" or name == "sengoo_ffi_buffer_used_len" or name == "sengoo_ffi_buffer_is_utf8" { return arity == 1 and position == 0; };
    if name == "sengoo_string_from_buffer" or name == "sengoo_string_from_utf8" or name == "sengoo_string_from_bytes_copy" or name == "sengoo_ffi_buffer_get_u8" or name == "sengoo_ffi_buffer_commit_used_len" or name == "sengoo_ffi_buffer_consume" { return arity == 2 and position == 0; };
    if name == "sengoo_hash_sha256" { return arity == 4 and (position == 0 or position == 2); };
    if name == "sengoo_hash_sha256_bounded" { return arity == 5 and (position == 0 or position == 3); };
    if name == "sengoo_ffi_buffer_copy_range" { return arity == 4 and (position == 0 or position == 3); };
    if name == "sengoo_arg_copy" { return arity == 3 and position == 1; };
    if name == "sengoo_ffi_buffer_copy_in" or name == "sengoo_ffi_buffer_copy_out" or name == "sengoo_env_var_copy" or name == "sengoo_file_read_into" or name == "sengoo_net_stream_read" or name == "sengoo_ffi_buffer_append" or name == "sengoo_ffi_buffer_index_of_bytes" { return arity == 3 and (position == 0 or position == 1); };
    false;
}

def sh_b_native_projects(checked: &ShChecked, function: i64, position: i64) -> bool {
    let signature = sh_s_resolve(checked, sh_binding_word(checked, function, 3));
    if position != 0 or sh_binding_word(checked, function, 2) != 2 or (sh_binding_word(checked, function, 5) & 8) == 0 or sh_s_kind(checked, signature) != 11 or sh_s_data(checked, signature) != 1 or sh_s_flags(checked, signature) != 0 or sh_s_arity(checked, signature) != 2 { return false; };
    let mut index = 0;
    while index < 2 { let ty = sh_s_argument(checked, signature, index); if sh_s_kind(checked, ty) != 2 or sh_s_data(checked, ty) != 64 or sh_s_flags(checked, ty) != 1 { return false; }; index = index + 1; };
    let name = sh_symbol_text(&checked.symbols, sh_binding_word(checked, function, 0));
    name.is_ok() and sh_s_text_equal(&name.value, "sengoo_ffi_buffer_ptr");
}

def sh_ownership_parameter_projected(result: &ShOwnership, binding: i64) -> bool {
    let mut index = 0;
    while index < sh_ownership_action_count(result) { if sh_ownership_action(result, index, 1) == binding and sh_ownership_action(result, index, 2) == 9 { return true; }; index = index + 1; };
    false;
}

def sh_ownership_parameter_borrowed(result: &ShOwnership, binding: i64) -> bool {
    sh_ownership_parameter_observed(result, binding) or sh_ownership_parameter_projected(result, binding);
}

def sh_ownership_parameter_observed(result: &ShOwnership, binding: i64) -> bool {
    let mut index = 0;
    while index < sh_ownership_action_count(result) { if sh_ownership_action(result, index, 1) == binding and sh_ownership_action(result, index, 2) == 8 { return true; }; index = index + 1; };
    false;
}

def sh_ownership_observed_contracts_valid(result: &ShOwnership, checked: &ShChecked, ast: &ShAst) -> bool {
    let certificate = sh_ownership_from_facts(vec_new_i64(), vec_new_i64(), vec_new_i64(), 100);
    sh_b_infer_contracts(&certificate, checked, ast);
    let mut binding = 0;
    while binding < sh_binding_count(checked) { let inferred = certificate.contracts.get(binding).unwrap_or(0); if sh_ownership_parameter_observed(result, binding) and (inferred & 1) == 0 or sh_ownership_parameter_projected(result, binding) and (inferred & 2) == 0 { return false; }; binding = binding + 1; };
    binding = 0;
    while binding < sh_binding_count(checked) { if sh_ownership_parameter_borrowed(result, binding) { let function = sh_binding_word(checked, binding, 6); let signature = sh_s_resolve(checked, sh_binding_word(checked, function, 3)); let returned = sh_s_argument(checked, signature, sh_s_arity(checked, signature) - 1); let body = sh_s_child_kind(ast, sh_binding_word(checked, function, 4), 40); let projected = sh_ownership_parameter_projected(result, binding); if sh_binding_word(checked, binding, 2) != 1 or not sh_b_profile_parameter(checked, ast, binding) or sh_binding_word(checked, function, 2) != 2 or (sh_binding_word(checked, function, 5) & 8) != 0 or body < 0 or sh_b_carries_borrow(checked, returned, 0) or projected and (sh_s_kind(checked, returned) != 2 or sh_s_data(checked, returned) != 64 or sh_s_flags(checked, returned) != 1) or not sh_b_contract_expr(&certificate, checked, ast, body, binding, projected, projected, 0) { return false; }; }; binding = binding + 1; };
    true;
}

def sh_b_contract_parameter(checked: &ShChecked, function: i64, ordinal: i64) -> i64 {
    let mut binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 1 and sh_binding_word(checked, binding, 6) == function and sh_binding_word(checked, binding, 7) == ordinal { return binding; }; binding = binding + 1; };
    -1;
}

def sh_b_contract_observes_mode(result: &ShOwnership, checked: &ShChecked, ast: &ShAst, call: i64, ordinal: i64, projected: bool) -> bool {
    let function = sh_node_binding(checked, call);
    if sh_b_native_contract(checked, function, ordinal) or projected and sh_b_native_projects(checked, function, ordinal) { return true; };
    let target = sh_ast_child(ast, call, 0);
    let ty = sh_s_resolve(checked, sh_node_type(checked, target));
    if sh_s_kind(checked, ty) != 11 { return false; };
    if sh_s_kind(checked, sh_s_resolve(checked, sh_s_argument(checked, ty, ordinal))) == 6 { return true; };
    let binding = sh_b_contract_parameter(checked, function, ordinal);
    let flags = result.contracts.get(binding).unwrap_or(0);
    binding >= 0 and ((flags & 1) != 0 or projected and (flags & 2) != 0);
}

def sh_b_contract_observes(result: &ShOwnership, checked: &ShChecked, ast: &ShAst, call: i64, ordinal: i64) -> bool {
    sh_b_contract_observes_mode(result, checked, ast, call, ordinal, result.projection_context != 0);
}

def sh_b_legacy_parameter(checked: &ShChecked, input: i64) -> bool {
    let ty = sh_s_resolve(checked, input);
    if sh_s_kind(checked, ty) == 2 and sh_s_data(checked, ty) == 64 and sh_s_flags(checked, ty) == 1 { return true; };
    sh_s_legacy_handle(checked, ty) and not sh_b_named(checked, ty, "JsonDoc");
}

def sh_b_contract_expr(result: &ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64, parameter: i64, borrowed: bool, projection: bool, depth: i64) -> bool {
    if node < 0 { return true; };
    if depth > 256 { return false; };
    let kind = sh_ast_word(ast, node, 0);
    let count = sh_ast_word(ast, node, 6);
    if kind == 12 or kind == 10 { return sh_node_binding(checked, node) != parameter or borrowed; };
