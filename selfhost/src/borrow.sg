    if kind == 52 { return sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, 0), parameter, false, projection, depth + 1) and sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, 1), parameter, false, projection, depth + 1); };
    if kind == 54 { return sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, 0), parameter, borrowed, projection, depth + 1) and sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, 1), parameter, true, projection, depth + 1); };
