def sh_b_profile_parameter(checked: &ShChecked, ast: &ShAst, binding: i64) -> bool {
    let function = sh_binding_word(checked, binding, 6);
    let owner = sh_binding_word(checked, function, 6);
    let declaration = sh_binding_word(checked, binding, 4);
    let receiver = sh_ast_word(ast, declaration, 0) == 21 and (sh_ast_word(ast, declaration, 4) & 4) != 0;
    if receiver { let name = sh_symbol_text(&checked.symbols, sh_binding_word(checked, function, 0)); if name.is_ok() and (sh_s_text_equal(&name.value, "drop") or sh_s_text_equal(&name.value, "free") or sh_s_text_equal(&name.value, "close") or sh_s_text_equal(&name.value, "into_iter")) { return false; }; };
    sh_b_legacy_parameter(checked, sh_binding_word(checked, binding, 3));
}

def sh_b_infer_contracts(result: &ShOwnership, checked: &ShChecked, ast: &ShAst) {
    let mut binding = 0;
    while binding < sh_binding_count(checked) { result.contracts.push(0); binding = binding + 1; };
    let mut changed = true;
    let mut profile_pass = 0;
    while changed and profile_pass <= sh_binding_count(checked) { changed = false; binding = 0; while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 1 and sh_b_profile_parameter(checked, ast, binding) { let function = sh_binding_word(checked, binding, 6); let ty = sh_s_resolve(checked, sh_binding_word(checked, function, 3)); let returned = sh_s_argument(checked, ty, sh_s_arity(checked, ty) - 1); let body = sh_s_child_kind(ast, sh_binding_word(checked, function, 4), 40); let flags = result.contracts.get(binding).unwrap_or(0); let mut next = flags; if sh_binding_word(checked, function, 2) == 2 and (sh_binding_word(checked, function, 5) & 8) == 0 and body >= 0 and not sh_b_carries_borrow(checked, returned, 0) { if (flags & 1) == 0 and sh_b_contract_expr(result, checked, ast, body, binding, false, false, 0) { next = next | 1; }; if (flags & 2) == 0 and sh_s_kind(checked, returned) == 2 and sh_s_data(checked, returned) == 64 and sh_s_flags(checked, returned) == 1 and sh_b_contract_expr(result, checked, ast, body, binding, true, true, 0) { next = next | 2; }; if next != flags { result.contracts.set(binding, next); changed = true; }; }; }; binding = binding + 1; }; profile_pass = profile_pass + 1; };
}

def sh_b_call(result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64, holder: i64) {
    let first_loan = result.loans.len();
    let target = sh_ast_child(ast, node, 0);
    let function = sh_node_binding(checked, node);
    let target_type = sh_s_resolve(checked, sh_node_type(checked, target));
    let fn_type = if sh_s_kind(checked, target_type) == 11 { target_type; } else { sh_s_resolve(checked, sh_binding_word(checked, function, 3)); };
    let member = sh_ast_word(ast, target, 0) == 55;
    let mut receiver = -1;
    if member { let base = sh_ast_child(ast, target, 0); if sh_b_alias_ambiguous(result, sh_node_binding(checked, base)) { sh_b_error(result, ast, base, 6111, sh_node_binding(checked, base), -1); }; let self_type = sh_s_resolve(checked, sh_s_argument(checked, fn_type, 0)); let previous_mode = result.access_mode; if sh_s_kind(checked, self_type) == 6 { result.access_mode = 1; }; sh_b_walk(result, text, checked, ast, base, not sh_b_contract_observes(result, checked, ast, node, 0), -1); result.access_mode = previous_mode; let base_is_ref = sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, base))) == 6; let receiver_alias = if base_is_ref { sh_node_binding(checked, base); } else { sh_b_access_alias(checked, ast, base, 0); }; let parent = sh_b_alias_loan(result, receiver_alias); receiver = if base_is_ref and parent >= 0 { result.loans.get(parent * 5).unwrap_or(-1); } else { sh_b_place(result, checked, ast, base); }; if sh_s_kind(checked, self_type) == 6 { sh_b_loan_from(result, checked, ast, node, receiver, -1, sh_s_flags(checked, self_type) == 1, parent); }; };
    let mut index = 1;
    while index < sh_ast_word(ast, node, 6) { let argument = sh_ast_child(ast, node, index); let ordinal = index - 1 + if member { 1; } else { 0; }; let parameter = sh_s_resolve(checked, sh_s_argument(checked, fn_type, ordinal)); let observes = sh_s_kind(checked, parameter) == 6 or sh_b_contract_observes(result, checked, ast, node, ordinal) or sh_b_native_projects(checked, function, ordinal); let previous_projection = result.projection_context; result.projection_context = if observes { 1; } else { 0; }; sh_b_walk(result, text, checked, ast, argument, not observes, -1); result.projection_context = previous_projection; let projected = sh_b_place(result, checked, ast, argument); if observes and sh_s_kind(checked, parameter) == 6 { let alias = sh_node_binding(checked, argument); let parent_count = result.loans.len(); let mut parent_at = 0; while alias >= 0 and parent_at < parent_count { if result.loans.get(parent_at + 1).unwrap_or(-1) == alias and result.loans.get(parent_at + 4).unwrap_or(0) != 0 { let owner = result.loans.get(parent_at).unwrap_or(-1); sh_b_loan_from(result, checked, ast, argument, owner, -1, sh_s_flags(checked, parameter) == 1, parent_at / 5); }; parent_at = parent_at + 5; }; }; index = index + 1; };
    let return_type = sh_s_resolve(checked, sh_node_type(checked, node));
    let last_argument_loan = result.loans.len();
    if sh_b_carries_borrow(checked, return_type, 0) { let mut argument_loan = first_loan; while argument_loan < last_argument_loan { if result.loans.get(argument_loan + 1).unwrap_or(-1) == -1 and result.loans.get(argument_loan + 4).unwrap_or(0) != 0 { let owner = result.loans.get(argument_loan).unwrap_or(-1); sh_b_loan_from(result, checked, ast, node, owner, holder, result.loans.get(argument_loan + 2).unwrap_or(0) != 0 and sh_b_carries_mutable_borrow(checked, return_type, 0), argument_loan / 5); }; argument_loan = argument_loan + 5; }; };
    let mut loan = first_loan;
    while loan < last_argument_loan { if result.loans.get(loan + 1).unwrap_or(-1) == -1 { result.loans.set(loan + 4, 0); (); }; loan = loan + 5; };
}

def sh_b_operator(result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64, holder: i64) {
    let first = result.loans.len();
    let signature = sh_s_resolve(checked, sh_node_callable_type(checked, node));
    let function = sh_node_binding(checked, node);
    let mut index = 0;
    while index < sh_ast_word(ast, node, 6) { let argument = sh_ast_child(ast, node, index); let parameter = sh_s_resolve(checked, sh_s_argument(checked, signature, index)); let reference = sh_s_kind(checked, parameter) == 6; let parameter_binding = sh_b_contract_parameter(checked, function, index); let observes = reference or parameter_binding >= 0 and (result.contracts.get(parameter_binding).unwrap_or(0) & 1) != 0; let previous = result.access_mode; if reference { result.access_mode = 1; }; sh_b_walk(result, text, checked, ast, argument, not observes, -1); result.access_mode = previous; if reference { let is_ref = sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, argument))) == 6; let alias = if is_ref { sh_node_binding(checked, argument); } else { sh_b_access_alias(checked, ast, argument, 0); }; let parent = sh_b_alias_loan(result, alias); if sh_b_alias_ambiguous(result, alias) { sh_b_error(result, ast, argument, 6111, alias, -1); }; let path = if is_ref and parent >= 0 { result.loans.get(parent * 5).unwrap_or(-1); } else { sh_b_place(result, checked, ast, argument); }; sh_b_loan_from(result, checked, ast, node, path, -1, sh_s_flags(checked, parameter) == 1, parent); }; index = index + 1; };
    let end = result.loans.len();
    let returned = sh_node_type(checked, node);
    let mut loan = first;
    if sh_b_carries_borrow(checked, returned, 0) { while loan < end { if result.loans.get(loan + 1).unwrap_or(-1) == -1 and result.loans.get(loan + 4).unwrap_or(0) != 0 { sh_b_loan_from(result, checked, ast, node, result.loans.get(loan).unwrap_or(-1), holder, result.loans.get(loan + 2).unwrap_or(0) != 0 and sh_b_carries_mutable_borrow(checked, returned, 0), loan / 5); }; loan = loan + 5; }; };
    loan = first;
    while loan < end { if result.loans.get(loan + 1).unwrap_or(-1) == -1 { result.loans.set(loan + 4, 0); (); }; loan = loan + 5; };
}

def sh_ownership_from_facts(actions: Vec<i64>, action_paths: Vec<i64>, paths: Vec<i64>, limit: i64) -> ShOwnership {
    let diagnostics: Vec<ShDiagnostic> = vec_new();
    let mut result = ShOwnership { diagnostics: diagnostics, actions: actions, action_paths: action_paths, paths: paths, state: vec_new_i64(), loans: vec_new_i64(), loan_parents: vec_new_i64(), access_mode: 0, last_uses: vec_new_i64(), loops: vec_new_i64(), definitions: vec_new_i64(), contracts: vec_new_i64(), projection_context: 0, try_scopes: vec_new_i64(), error: 0, start: 0, end: 0, limit: limit, function: -1, scope: 0, flow: 0, depth: 0 };
    if limit < 1 or limit > 1000000 or result.actions.len() % 5 != 0 or result.paths.len() % 4 != 0 or result.action_paths.len() != result.actions.len() / 5 or result.actions.len() > 5000000 or result.paths.len() > 4000000 { result.error = 6110; };
    result;
}

def sh_check_ownership(text: &String, ast: &ShAst, checked: &ShChecked, max_diagnostics: i64) -> ShOwnership {
    let mut result = sh_ownership_from_facts(vec_new_i64(), vec_new_i64(), vec_new_i64(), max_diagnostics);
    if max_diagnostics < 1 or max_diagnostics > 1000000 { result.error = 6110; return result; };
    if checked.error != 0 { result.error = checked.error; result.start = checked.start; result.end = checked.end; return result; };
    let mut binding = 0;
    while binding < sh_binding_count(checked) { result.last_uses.push(-1); binding = binding + 1; };
    let mut node = 0;
    while node < sh_ast_count(ast) { let resolved = sh_node_binding(checked, node); if resolved >= 0 and sh_ast_word(ast, node, 0) == 12 { let end = sh_ast_word(ast, node, 3); if end > result.last_uses.get(resolved).unwrap_or(-1) { result.last_uses.set(resolved, end); (); }; }; node = node + 1; };
    sh_b_infer_contracts(&result, checked, ast);
    binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 2 { result.function = binding; result.scope = sh_binding_word(checked, binding, 7); result.flow = 0; result.loans.clear(); result.loan_parents.clear(); let function = sh_binding_word(checked, binding, 4); let body = sh_s_child_kind(ast, function, 40); if body >= 0 and sh_binding_word(checked, sh_binding_word(checked, binding, 6), 2) != 7 { let mut param = 0; while param < sh_binding_count(checked) { if sh_binding_word(checked, param, 2) == 1 and sh_binding_word(checked, param, 6) == binding { sh_b_initialize(&mut result, checked, ast, sh_binding_word(checked, param, 4), param); }; param = param + 1; }; let fn_type = sh_s_resolve(checked, sh_binding_word(checked, binding, 3)); let return_type = sh_s_argument(checked, fn_type, sh_s_arity(checked, fn_type) - 1); let tail_return = sh_s_kind(checked, sh_s_resolve(checked, return_type)) != 0; sh_b_walk(&mut result, text, checked, ast, body, tail_return, -1); if tail_return { sh_b_escape(&mut result, checked, ast, body); }; if result.flow == 0 { let scope = result.scope; sh_b_cleanup(&mut result, checked, ast, body, scope, true); }; }; }; binding = binding + 1; };
    result;
}

def sh_ownership(text: &String, ast: &ShAst, checked: &ShChecked, max_diagnostics: i64) -> ShOwnership {
    sh_check_ownership(text, ast, checked, max_diagnostics);
}
