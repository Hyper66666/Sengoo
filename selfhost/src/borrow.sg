def sh_b_escape(result: &mut ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64) {
    let kind = sh_ast_word(ast, node, 0);
    if kind == 40 { let tail = sh_ast_child(ast, node, sh_ast_word(ast, node, 6) - 1); if tail >= 0 { sh_b_escape(result, checked, ast, tail); }; return; };
