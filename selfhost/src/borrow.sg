import selfhost_semantic;

struct ShOwnership {
    diagnostics: Vec<ShDiagnostic>,
    actions: Vec<i64>,
    action_paths: Vec<i64>,
    paths: Vec<i64>,
    state: Vec<i64>,
    loans: Vec<i64>,
    loan_parents: Vec<i64>,
    access_mode: i64,
    last_uses: Vec<i64>,
    loops: Vec<i64>,
    definitions: Vec<i64>,
    contracts: Vec<i64>,
    projection_context: i64,
    try_scopes: Vec<i64>,
    error: i64,
    start: i64,
    end: i64,
    limit: i64,
    function: i64,
    scope: i64,
    flow: i64,
    depth: i64,
}

def sh_ownership_action_count(result: &ShOwnership) -> i64 {
    result.actions.len() / 5;
}

def sh_ownership_action(result: &ShOwnership, index: i64, field: i64) -> i64 {
    if index < 0 or index >= sh_ownership_action_count(result) or field < 0 or field > 4 { return -1; };
    result.actions.get(index * 5 + field).unwrap_or(-1);
}

def sh_ownership_action_path(result: &ShOwnership, action: i64) -> i64 {
    result.action_paths.get(action).unwrap_or(-1);
}

def sh_ownership_path_word(result: &ShOwnership, path: i64, field: i64) -> i64 {
    if path < 0 or path >= result.paths.len() / 4 or field < 0 or field > 3 { return -1; };
    result.paths.get(path * 4 + field).unwrap_or(-1);
}

def sh_b_custom_drop(checked: &ShChecked, ty_input: i64) -> bool {
    let ty = sh_s_resolve(checked, ty_input);
    if sh_s_kind(checked, ty) != 12 { return false; };
    let mut index = 0;
    while index < checked.constraints.len() { if checked.constraints.get(index + 2).unwrap_or(0) == -2 { let target = checked.constraints.get(index).unwrap_or(-1); let trait_name = sh_symbol_text(&checked.symbols, checked.constraints.get(index + 1).unwrap_or(-1)); if sh_s_nominal(checked, sh_s_resolve(checked, target)) == sh_s_nominal(checked, ty) and trait_name.is_ok() and sh_s_text_equal(&trait_name.value, "Drop") { return true; }; }; index = index + 4; };
    false;
}

def sh_b_named(checked: &ShChecked, ty: i64, name: &str) -> bool {
    let symbol = sh_s_nominal(checked, sh_s_resolve(checked, ty));
    let text = sh_symbol_text(&checked.symbols, symbol);
    text.is_ok() and sh_s_text_equal(&text.value, name);
}

def sh_b_runtime_owner(checked: &ShChecked, ty: i64) -> bool {
    sh_b_named(checked, ty, "String") or sh_b_named(checked, ty, "Buffer") or sh_b_named(checked, ty, "Vec") or sh_b_named(checked, ty, "VecDeque") or sh_b_named(checked, ty, "HashMap") or sh_b_named(checked, ty, "BTreeMap") or sh_b_named(checked, ty, "HashSet") or sh_b_named(checked, ty, "Rc") or sh_b_named(checked, ty, "Arc") or sh_b_named(checked, ty, "Mutex") or sh_b_named(checked, ty, "RwLock") or sh_b_named(checked, ty, "Box");
}

def sh_b_drop_inner(checked: &ShChecked, ty_input: i64, depth: i64) -> bool {
    if depth > 64 { return true; };
    let ty = sh_s_resolve(checked, ty_input);
    let kind = sh_s_kind(checked, ty);
    if kind == 8 or kind == 9 or kind == 10 or kind == 16 { let mut index = 0; while index < sh_s_arity(checked, ty) { if sh_b_drop_inner(checked, sh_s_argument(checked, ty, index), depth + 1) { return true; }; index = index + 1; }; return false; };
    if kind != 12 { return false; };
    if sh_b_runtime_owner(checked, ty) { return true; };
    let mut index = 0;
    while index < checked.constraints.len() { if checked.constraints.get(index + 2).unwrap_or(0) == -2 { let target = checked.constraints.get(index).unwrap_or(-1); let trait_name = sh_symbol_text(&checked.symbols, checked.constraints.get(index + 1).unwrap_or(-1)); if sh_s_nominal(checked, sh_s_resolve(checked, target)) == sh_s_nominal(checked, ty) and trait_name.is_ok() and sh_s_text_equal(&trait_name.value, "Drop") { return true; }; }; index = index + 4; };
    let owner = sh_adt_binding(checked, ty);
    index = 0;
    if sh_binding_word(checked, owner, 2) == 4 { while index < sh_binding_count(checked) { let field_owner = sh_binding_word(checked, index, 6); if sh_binding_word(checked, index, 2) == 6 and sh_binding_word(checked, field_owner, 2) == 5 and sh_binding_word(checked, field_owner, 6) == owner { if sh_b_drop_inner(checked, sh_resolved_field_type(checked, ty, index), depth + 1) { return true; }; }; index = index + 1; }; } else { let fields = sh_layout_field_count(checked, ty); while index < fields { let field = sh_layout_field_binding(checked, ty, index); if sh_b_drop_inner(checked, sh_resolved_field_type(checked, ty, field), depth + 1) { return true; }; index = index + 1; }; };
    false;
}

def sh_ownership_needs_drop(text: &String, ast: &ShAst, checked: &ShChecked, ty: i64) -> bool {
    sh_b_drop_inner(checked, ty, 0);
}

def sh_b_error(result: &mut ShOwnership, ast: &ShAst, node: i64, code: i64, owner: i64, prior: i64) {
    let start = sh_ast_word(ast, node, 2);
    let end = sh_ast_word(ast, node, 3);
    if result.error == 0 { result.error = code; result.start = start; result.end = end; };
    if result.diagnostics.len() < result.limit { let diagnostic = ShDiagnostic { code: code, severity: 1, node: node, start: start, end: end, expected: owner, actual: prior }; result.diagnostics.push(diagnostic); (); };
}

def sh_b_action(result: &mut ShOwnership, ast: &ShAst, node: i64, binding: i64, kind: i64, scope: i64, conditional: i64) {
    if sh_ownership_action_count(result) > 1000000 { sh_b_error(result, ast, node, 6110, binding, -1); return; };
    let stored = result.actions.push(node) and result.actions.push(binding) and result.actions.push(kind) and result.actions.push(scope) and result.actions.push(conditional) and result.action_paths.push(-1);
    if not stored { sh_b_error(result, ast, node, 6110, binding, -1); };
}

def sh_b_path(result: &ShOwnership, root: i64, parent: i64, field: i64, ty: i64) -> i64 {
    let mut index = 0;
    while index < result.paths.len() / 4 { if result.paths.get(index * 4).unwrap_or(-1) == root and result.paths.get(index * 4 + 1).unwrap_or(-1) == parent and result.paths.get(index * 4 + 2).unwrap_or(-1) == field { return index; }; index = index + 1; };
    result.paths.push(root);
    result.paths.push(parent);
    result.paths.push(field);
    result.paths.push(ty);
    result.state.push(if parent >= 0 { result.state.get(parent).unwrap_or(0); } else { 0; });
    index;
}

def sh_b_path_root(result: &ShOwnership, path: i64) -> i64 {
    result.paths.get(path * 4).unwrap_or(-1);
}

def sh_b_path_contains(result: &ShOwnership, parent: i64, child: i64) -> bool {
    let mut cursor = child;
    while cursor >= 0 { if cursor == parent { return true; }; cursor = result.paths.get(cursor * 4 + 1).unwrap_or(-1); };
    false;
}

def sh_b_overlap(result: &ShOwnership, left: i64, right: i64) -> bool {
    if left < 0 or right < 0 or sh_b_path_root(result, left) != sh_b_path_root(result, right) { return false; };
    let mut cursor = left;
    while cursor >= 0 { if cursor == right { return true; }; cursor = result.paths.get(cursor * 4 + 1).unwrap_or(-1); };
    cursor = right;
    while cursor >= 0 { if cursor == left { return true; }; cursor = result.paths.get(cursor * 4 + 1).unwrap_or(-1); };
    false;
}

def sh_b_loan_ancestor(result: &ShOwnership, ancestor: i64, child: i64) -> bool {
    let mut current = child;
    let mut count = 0;
    while current >= 0 and count <= result.loan_parents.len() { if current == ancestor { return true; }; current = result.loan_parents.get(current).unwrap_or(-1); count = count + 1; };
    false;
}

def sh_b_alias_loan(result: &ShOwnership, alias: i64) -> i64 {
    if alias < 0 { return -1; };
    let mut index = result.loans.len() - 5;
    while index >= 0 { if result.loans.get(index + 1).unwrap_or(-1) == alias and result.loans.get(index + 4).unwrap_or(0) != 0 { return index / 5; }; index = index - 5; };
    -1;
}

def sh_b_alias_ambiguous(result: &ShOwnership, alias: i64) -> bool {
    if alias < 0 { return false; };
    let mut path = -1;
    let mut index = 0;
    while index < result.loans.len() { if result.loans.get(index + 1).unwrap_or(-1) == alias and result.loans.get(index + 4).unwrap_or(0) != 0 { let owner = result.loans.get(index).unwrap_or(-1); if path >= 0 and path != owner { return true; }; path = owner; }; index = index + 5; };
    false;
}

def sh_b_access_alias(checked: &ShChecked, ast: &ShAst, node: i64, depth: i64) -> i64 {
    if depth > 128 { return -1; };
    let kind = sh_ast_word(ast, node, 0);
    if kind == 50 and sh_ast_word(ast, node, 4) % 1000 == sh_kind("*") { return sh_node_binding(checked, sh_ast_child(ast, node, 0)); };
    if kind == 55 or kind == 54 { let base = sh_ast_child(ast, node, 0); if sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, base))) == 6 { return sh_node_binding(checked, base); }; return sh_b_access_alias(checked, ast, base, depth + 1); };
    if kind == 58 and sh_ast_word(ast, node, 4) == 0 { return sh_b_access_alias(checked, ast, sh_ast_child(ast, node, 0), depth + 1); };
    -1;
}

def sh_b_place(result: &ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64) -> i64 {
    let kind = sh_ast_word(ast, node, 0);
    if kind == 10 or kind == 12 { let binding = sh_node_binding(checked, node); let category = sh_binding_word(checked, binding, 2); if category != 0 and category != 1 { return -1; }; return sh_b_path(result, binding, -1, -1, sh_node_type(checked, node)); };
    if kind == 50 and sh_ast_word(ast, node, 4) % 1000 == sh_kind("*") { let alias = sh_node_binding(checked, sh_ast_child(ast, node, 0)); let loan = sh_b_alias_loan(result, alias); if loan >= 0 { return result.loans.get(loan * 5).unwrap_or(-1); }; return -1; };
    if kind == 55 { let base = sh_ast_child(ast, node, 0); let alias = if sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, base))) == 6 { sh_b_alias_loan(result, sh_node_binding(checked, base)); } else { -1; }; let parent = if alias >= 0 { result.loans.get(alias * 5).unwrap_or(-1); } else { sh_b_place(result, checked, ast, base); }; let field = sh_node_binding(checked, node); if parent < 0 or field < 0 { return -1; }; return sh_b_path(result, sh_b_path_root(result, parent), parent, field, sh_node_type(checked, node)); };
    if kind == 58 and sh_ast_word(ast, node, 4) == 0 { return sh_b_place(result, checked, ast, sh_ast_child(ast, node, 0)); };
    let mut temporary = 0;
    while temporary < result.paths.len() / 4 { if sh_b_path_root(result, temporary) == -node - 1 and result.paths.get(temporary * 4 + 1).unwrap_or(-1) == -1 { return temporary; }; temporary = temporary + 1; };
    -1;
}

def sh_b_definition(result: &ShOwnership, binding: i64, path: i64, scope: i64, keeper: i64) {
    let mut index = 0;
    while index < result.definitions.len() { if result.definitions.get(index).unwrap_or(0) == binding and result.definitions.get(index + 3).unwrap_or(-1) == result.function { return; }; index = index + 5; };
    result.definitions.push(binding);
    result.definitions.push(path);
    result.definitions.push(scope);
    result.definitions.push(result.function);
    result.definitions.push(keeper);
    ();
}

def sh_b_carries_borrow(checked: &ShChecked, input: i64, depth: i64) -> bool {
    if depth > 64 { return true; };
    let ty = sh_s_resolve(checked, input);
    let kind = sh_s_kind(checked, ty);
    if kind == 5 or kind == 6 or kind == 9 or kind == 13 or kind == 16 or kind == 19 { return true; };
    if kind == 8 or kind == 10 or kind == 12 { let mut index = 0; while index < sh_s_arity(checked, ty) { if sh_b_carries_borrow(checked, sh_s_argument(checked, ty, index), depth + 1) { return true; }; index = index + 1; }; if kind == 12 { let owner = sh_adt_binding(checked, ty); index = 0; while index < sh_binding_count(checked) { let parent = sh_binding_word(checked, index, 6); let member = parent == owner or sh_binding_word(checked, parent, 2) == 5 and sh_binding_word(checked, parent, 6) == owner; if sh_binding_word(checked, index, 2) == 6 and member and sh_b_carries_borrow(checked, sh_resolved_field_type(checked, ty, index), depth + 1) { return true; }; index = index + 1; }; }; };
    false;
}

def sh_b_carries_mutable_borrow(checked: &ShChecked, input: i64, depth: i64) -> bool {
    if depth >= 64 { return true; };
    let ty = sh_s_resolve(checked, input);
    let kind = sh_s_kind(checked, ty);
    if kind == 6 { return sh_s_flags(checked, ty) == 1; };
    if kind == 13 or kind == 19 { return true; };
    if kind == 8 or kind == 9 or kind == 10 or kind == 12 { let mut argument = 0; while argument < sh_s_arity(checked, ty) { if sh_b_carries_mutable_borrow(checked, sh_s_argument(checked, ty, argument), depth + 1) { return true; }; argument = argument + 1; }; if kind == 12 { let owner = sh_adt_binding(checked, ty); let mut field = 0; while field < sh_binding_count(checked) { let parent = sh_binding_word(checked, field, 6); let member = parent == owner or sh_binding_word(checked, parent, 2) == 5 and sh_binding_word(checked, parent, 6) == owner or sh_s_class_ancestor(checked, ty, parent) >= 0; if sh_binding_word(checked, field, 2) == 6 and member and sh_b_carries_mutable_borrow(checked, sh_resolved_field_type(checked, ty, field), depth + 1) { return true; }; field = field + 1; }; }; };
    false;
}

def sh_b_temporary(result: &mut ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64, moving: bool, holder: i64) {
    let kind = sh_ast_word(ast, node, 0);
    let produces = kind == 53 or kind == 60 or kind == 59 or kind == 56 or kind == 68 and sh_ast_word(ast, node, 4) == sh_kind("try") or kind == 58 and sh_ast_word(ast, node, 4) == 1;
    let ty = sh_node_type(checked, node);
    let type_kind = sh_s_kind(checked, sh_s_resolve(checked, ty));
    let borrowed_storage = not moving and result.access_mode == 1 and type_kind != 5 and type_kind != 6 and type_kind != 9;
    if not produces or not (sh_b_drop_inner(checked, ty, 0) or borrowed_storage) or result.flow != 0 { return; };
    let binding = -node - 1;
    let path = sh_b_path(result, binding, -1, -1, ty);
    result.state.set(path, 1);
    let keeper = if not moving and holder >= 0 and sh_b_carries_borrow(checked, sh_binding_word(checked, holder, 3), 0) { holder; } else { -1; };
    let scope = if keeper >= 0 { sh_binding_word(checked, keeper, 1); } else { result.scope; };
    sh_b_definition(result, binding, path, scope, keeper);
    sh_b_action(result, ast, node, binding, 1, scope, 0);
    if moving { sh_b_path_use(result, checked, ast, node, path, true); };
}

def sh_b_keeper_live(result: &ShOwnership, checked: &ShChecked, keeper: i64, at: i64) -> bool {
    if keeper < 0 { return false; };
    if sh_b_drop_inner(checked, sh_binding_word(checked, keeper, 3), 0) { return true; };
    let last = result.last_uses.get(keeper).unwrap_or(-1);
    if last > at { return true; };
    let mut frame = 0;
    while frame < result.loops.len() { if last >= result.loops.get(frame).unwrap_or(0) and last <= result.loops.get(frame + 1).unwrap_or(0) { return true; }; frame = frame + 3; };
    false;
}

def sh_b_temporaries_end(result: &mut ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64) {
    let mut expression_loan = 0;
    while expression_loan < result.loans.len() { if result.loans.get(expression_loan + 1).unwrap_or(-1) == -1 { result.loans.set(expression_loan + 4, 0); (); }; expression_loan = expression_loan + 5; };
    let mut index = result.definitions.len() - 5;
    while index >= 0 { let binding = result.definitions.get(index).unwrap_or(0); let keeper = result.definitions.get(index + 4).unwrap_or(-1); let keep_live = sh_b_keeper_live(result, checked, keeper, sh_ast_word(ast, node, 3)); if binding < 0 and result.definitions.get(index + 3).unwrap_or(-1) == result.function and not keep_live { let path = result.definitions.get(index + 1).unwrap_or(-1); if (result.state.get(path).unwrap_or(0) & 1) != 0 { let mut loan = 0; while loan < result.loans.len() { if sh_b_path_root(result, result.loans.get(loan).unwrap_or(-1)) == binding { result.loans.set(loan + 4, 0); (); }; loan = loan + 5; }; if sh_b_drop_inner(checked, result.paths.get(path * 4 + 3).unwrap_or(-1), 0) { sh_b_drop_path(result, checked, ast, node, path, result.definitions.get(index + 2).unwrap_or(result.scope), 0, 0); } else { result.state.set(path, 0); (); }; }; }; index = index - 5; };
}

def sh_b_join_state(left: i64, right: i64) -> i64 {
    let combined = left | right;
    if (left == 0 or right == 0) and (combined & 1) != 0 { return combined | 2; };
    combined;
}

def sh_b_state_copy(result: &ShOwnership) -> Vec<i64> {
    let copy = vec_new_i64();
    let mut index = 0;
    while index < result.state.len() { copy.push(result.state.get(index).unwrap_or(0)); index = index + 1; };
    copy;
}

def sh_b_saved_state(result: &ShOwnership, saved: &Vec<i64>, path: i64) -> i64 {
    let mut current = path;
    let mut depth = 0;
    while current >= 0 and depth <= result.paths.len() / 4 { if current < saved.len() { return sengoo_vec_get_or_default_i64(saved.handle, current, 0); }; current = result.paths.get(current * 4 + 1).unwrap_or(-1); depth = depth + 1; };
    0;
}

def sh_b_state_restore(result: &ShOwnership, saved: &Vec<i64>) {
    let mut index = 0;
    while index < result.state.len() { result.state.set(index, sh_b_saved_state(result, saved, index)); index = index + 1; };
}

def sh_b_loans_copy(result: &ShOwnership) -> Vec<i64> {
    let saved = vec_new_i64();
    let mut index = 0;
    while index < result.loans.len() { saved.push(result.loans.get(index + 4).unwrap_or(0)); index = index + 5; };
    saved;
}

def sh_b_loans_restore(result: &ShOwnership, saved: &Vec<i64>) {
    let mut index = 0;
    while index < result.loans.len() { result.loans.set(index + 4, sengoo_vec_get_or_default_i64(saved.handle, index / 5, 0)); index = index + 5; };
}

def sh_b_scope_inside(checked: &ShChecked, scope: i64, parent: i64) -> bool {
    let mut current = scope;
    let mut depth = 0;
    while current >= 0 and depth <= sh_scope_count(checked) { if current == parent { return true; }; current = sh_scope_word(checked, current, 0); depth = depth + 1; };
    false;
}

def sh_b_drop_path(result: &mut ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64, path: i64, scope: i64, conditional: i64, depth: i64) {
    if depth > 64 { sh_b_error(result, ast, node, 6110, sh_b_path_root(result, path), -1); return; };
    let state = result.state.get(path).unwrap_or(0);
    if state == 2 { return; };
    let ty = result.paths.get(path * 4 + 3).unwrap_or(-1);
    let mut partial = false;
    let mut index = 0;
    while index < result.state.len() { if index != path and sh_b_path_contains(result, path, index) and (result.state.get(index).unwrap_or(0) & 2) != 0 { partial = true; }; index = index + 1; };
    if partial { if sh_b_custom_drop(checked, ty) { sh_b_error(result, ast, node, 6107, sh_b_path_root(result, path), path); return; }; let owner = sh_adt_binding(checked, ty); if sh_binding_word(checked, owner, 2) == 4 { sh_b_error(result, ast, node, 6111, sh_b_path_root(result, path), path); return; }; let mut index = sh_layout_field_count(checked, ty) - 1; while index >= 0 { let field = sh_layout_field_binding(checked, ty, index); let field_type = sh_resolved_field_type(checked, ty, field); if sh_b_drop_inner(checked, field_type, 0) { let child = sh_b_path(result, sh_b_path_root(result, path), path, field, field_type); sh_b_drop_path(result, checked, ast, node, child, scope, conditional, depth + 1); }; index = index - 1; }; } else { sh_b_action(result, ast, node, sh_b_path_root(result, path), 3, scope, if (state & 2) != 0 { 1; } else { conditional; }); if result.paths.get(path * 4 + 1).unwrap_or(-1) >= 0 { result.action_paths.set(result.action_paths.len() - 1, path); (); }; };
    result.state.set(path, 0);
    ();
}

def sh_b_cleanup(result: &mut ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64, scope: i64, descendants: bool) {
    let mut index = result.definitions.len() - 5;
    while index >= 0 { let binding_scope = result.definitions.get(index + 2).unwrap_or(-1); let inside = if descendants { sh_b_scope_inside(checked, binding_scope, scope); } else { binding_scope == scope; }; if inside and result.definitions.get(index + 3).unwrap_or(-1) == result.function { let path = result.definitions.get(index + 1).unwrap_or(-1); let state = result.state.get(path).unwrap_or(0); let ty = result.paths.get(path * 4 + 3).unwrap_or(-1); if (state & 1) != 0 and sh_b_drop_inner(checked, ty, 0) { sh_b_drop_path(result, checked, ast, node, path, binding_scope, if (state & 2) != 0 { 1; } else { 0; }, 0); }; }; index = index - 5; };
}

def sh_b_block_scope(checked: &ShChecked, ast: &ShAst, node: i64) -> i64 {
    let first = sh_ast_child(ast, node, 0);
    if first >= 0 { return sh_node_scope(checked, first); };
    sh_node_scope(checked, node);
}

def sh_b_expire(result: &mut ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64) {
    let at = sh_ast_word(ast, node, 2);
    let mut index = 0;
    while index < result.loans.len() { let holder = result.loans.get(index + 1).unwrap_or(-1); let active = result.loans.get(index + 4).unwrap_or(0); let mut loop_live = false; let mut frame = 0; let last = result.last_uses.get(holder).unwrap_or(-1); while frame < result.loops.len() { if last >= result.loops.get(frame).unwrap_or(0) and last <= result.loops.get(frame + 1).unwrap_or(0) { loop_live = true; }; frame = frame + 3; }; if active != 0 and holder >= 0 and not loop_live and not sh_b_drop_inner(checked, sh_binding_word(checked, holder, 3), 0) and last < at { result.loans.set(index + 4, 0); sh_b_action(result, ast, node, holder, 5, result.scope, 0); }; index = index + 5; };
}

def sh_b_loan_from(result: &mut ShOwnership, checked: &ShChecked, ast: &ShAst, node: i64, path: i64, holder: i64, mutable: bool, parent: i64) {
    if path < 0 { return; };
    let root = sh_b_path_root(result, path);
    if root < 0 and holder >= 0 { let mut definition = 0; while definition < result.definitions.len() { if result.definitions.get(definition).unwrap_or(0) == root { let prior = result.definitions.get(definition + 4).unwrap_or(-1); if prior < 0 or result.last_uses.get(holder).unwrap_or(-1) > result.last_uses.get(prior).unwrap_or(-1) { result.definitions.set(definition + 4, holder); (); }; let current_scope = result.definitions.get(definition + 2).unwrap_or(-1); let holder_scope = sh_binding_word(checked, holder, 1); if sh_b_scope_inside(checked, current_scope, holder_scope) { result.definitions.set(definition + 2, holder_scope); (); }; }; definition = definition + 5; }; };
    let mut index = 0;
