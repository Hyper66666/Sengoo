    if kind == 61 or kind == 65 { let mut index = 1; while index < sh_ast_word(ast, node, 6) { sh_b_escape(result, checked, ast, sh_ast_child(ast, node, index)); index = index + 1; }; return; };
    if (kind == 53 or kind == 50 or kind == 51) and sh_b_carries_borrow(checked, sh_node_type(checked, node), 0) { let mut loan = 0; while loan < result.loans.len() { if result.loans.get(loan + 1).unwrap_or(-1) == -1 and result.loans.get(loan + 3).unwrap_or(-1) == node { let owner = sh_b_path_root(result, result.loans.get(loan).unwrap_or(-1)); if owner < 0 or sh_binding_word(checked, owner, 2) == 0 or sh_binding_word(checked, owner, 2) == 1 and sh_s_kind(checked, sh_s_resolve(checked, sh_binding_word(checked, owner, 3))) != 6 { sh_b_error(result, ast, node, 6105, owner, node); }; }; loan = loan + 5; }; };
    let path = sh_b_place(result, checked, ast, node);
    if path >= 0 { let binding = sh_b_path_root(result, path); let mut index = 0; while index < result.loans.len() { if result.loans.get(index + 1).unwrap_or(-1) == binding { let owner = sh_b_path_root(result, result.loans.get(index).unwrap_or(-1)); if owner < 0 or sh_binding_word(checked, owner, 2) == 0 or sh_binding_word(checked, owner, 2) == 1 and sh_s_kind(checked, sh_s_resolve(checked, sh_binding_word(checked, owner, 3))) != 6 { sh_b_error(result, ast, node, 6105, owner, result.loans.get(index + 3).unwrap_or(-1)); }; }; index = index + 5; }; };
