    if kind == 55 or kind == 50 or kind == 56 or kind == 57 { return sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, 0), parameter, borrowed, projection, depth + 1); };
    if kind == 53 { let target = sh_ast_child(ast, node, 0); let member = sh_ast_word(ast, target, 0) == 55; if member { let observes = sh_b_contract_observes_mode(result, checked, ast, node, 0, projection and borrowed); if not sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, target, 0), parameter, observes, if observes { true; } else { projection; }, depth + 1) { return false; }; }; let mut index = 1; while index < count { let ordinal = index - 1 + if member { 1; } else { 0; }; let observes = sh_b_contract_observes_mode(result, checked, ast, node, ordinal, projection and borrowed); if not sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, index), parameter, observes, if observes { true; } else { projection; }, depth + 1) { return false; }; index = index + 1; }; return true; };
    if kind == 40 { let mut index = 0; while index < count { let child = sh_ast_child(ast, node, index); let tail = index + 1 == count and sh_ast_word(ast, child, 0) == 43; let observes = if sh_ast_word(ast, child, 0) == 43 and not tail { true; } else { borrowed and tail; }; if not sh_b_contract_expr(result, checked, ast, child, parameter, observes, projection, depth + 1) { return false; }; index = index + 1; }; return true; };
    if kind == 41 or kind == 44 { let mut index = 1; while index < count { let child = sh_ast_child(ast, node, index); if sh_ast_word(ast, child, 0) < 70 and not sh_b_contract_expr(result, checked, ast, child, parameter, false, projection, depth + 1) { return false; }; index = index + 1; }; return true; };
    if kind == 43 { return sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, 0), parameter, borrowed, projection, depth + 1); };
    if kind == 61 or kind == 65 { if not sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, 0), parameter, kind == 61, projection, depth + 1) { return false; }; let mut index = 1; while index < count { if not sh_b_contract_expr(result, checked, ast, sh_ast_child(ast, node, index), parameter, borrowed, projection, depth + 1) { return false; }; index = index + 1; }; return true; };
