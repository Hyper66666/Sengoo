    sh_i64_ok(row);
}

def sh_native_emit(native: &mut ShNative, mir: &ShMir) -> Result<ShBinary, i64> {
    let checked = sh_mir_validate(mir);
    if checked.error != 0 { return sh_coff_error(checked.error); };
    let mut index = 0;
    while index < sh_mir_inst_count(mir) { if not native.values.push(-1) { return sh_coff_error(6503); }; index = index + 1; };
    index = 0;
    while index < sh_mir_local_count(mir) { if not native.initialized.push(-1) or not native.locals.push(-1) { return sh_coff_error(6503); }; index = index + 1; };
    index = 0;
    while index < sh_mir_block_count(mir) { if not native.blocks.push(-1) { return sh_coff_error(6503); }; index = index + 1; };
    index = 0;
    while index < sh_mir_fn_count(mir) { if not native.functions.push(-1) or not native.ends.push(-1) or not native.frames.push(-1) { return sh_coff_error(6503); }; index = index + 1; };
    index = 0;
    while index < sh_mir_fn_count(mir) { if sh_mir_fn(mir, index, 3) == 0 { let emitted = sh_native_function(native, mir, index); if not emitted.is_ok() { return sh_coff_error(emitted.error); }; }; index = index + 1; };
    if sh_binary_len(&native.code) == 0 { return sh_coff_error(6502); };
    index = 0;
    while index < native.branches.len() { let patch = sh_native_at(&native.branches, index); let target = sh_native_at(&native.blocks, sh_native_at(&native.branches, index + 1)); let fixed = sh_x64_fix_branch(&native.code, patch, target); if not fixed.is_ok() { return sh_coff_error(fixed.error); }; index = index + 2; };
    let object = sh_object_new(native.code.limit);
    let name = string_from_str(".text");
    if not name.is_ok() { return sh_coff_error(6503); };
    let section = sh_object_add_section(&object, &name.value, &native.code, 1610612768, 16);
    if not section.is_ok() { return sh_coff_error(section.error); };
    let symbol_ids = vec_new_i64();
    index = 0;
    while index <= sh_mir_fn_count(mir) + 2 { let mut used = index < sh_mir_fn_count(mir) and (sh_mir_fn(mir, index, 3) & 2) == 0; if index >= sh_mir_fn_count(mir) { let mut call = 0; while call < native.calls.len() { if sh_native_at(&native.calls, call + 1) == index { used = true; }; call = call + 2; }; }; let mut symbol = -1; if used { let text = if index == sh_mir_fn_count(mir) { string_from_str("sengoo_panic_integer_overflow"); } else { if index == sh_mir_fn_count(mir) + 1 { string_from_str("__chkstk"); } else { if index == sh_mir_fn_count(mir) + 2 { string_from_str("sengoo_panic_division_by_zero"); } else { sh_symbol_text(&mir.symbols, sh_mir_fn(mir, index, 0)); }; }; }; if not text.is_ok() { return sh_coff_error(6501); }; let offset = sh_native_at(&native.functions, index); let added = sh_object_add_symbol(&object, &text.value, if offset >= 0 { offset; } else { 0; }, if offset >= 0 { 1; } else { 0; }, true, 2); if not added.is_ok() { return sh_coff_error(added.error); }; symbol = added.value; }; if not symbol_ids.push(symbol) { return sh_coff_error(6503); }; index = index + 1; };
    index = 0;
    while index < native.calls.len() { let symbol = sh_native_at(&symbol_ids, sh_native_at(&native.calls, index + 1)); if symbol < 0 { return sh_coff_error(6502); }; let added = sh_object_add_relocation(&object, 0, sh_native_at(&native.calls, index), symbol, 4); if not added.is_ok() { return sh_coff_error(added.error); }; (); index = index + 2; };
    let unwind = sh_native_unwind(native, &object, mir, &symbol_ids);
    if not unwind.is_ok() { return sh_coff_error(unwind.error); };
    sh_object_emit(&object);
}

def sh_native_object(mir: &ShMir, maximum: i64, checked: bool) -> Result<ShBinary, i64> {
    let mut native = ShNative { code: sh_binary_new(maximum), values: vec_new_i64(), locals: vec_new_i64(), initialized: vec_new_i64(), functions: vec_new_i64(), ends: vec_new_i64(), frames: vec_new_i64(), blocks: vec_new_i64(), branches: vec_new_i64(), calls: vec_new_i64(), layout: sh_target_layout_cache(mir, 2147483647), result_mode: 0, result_pointer: 0, copies_base: 0, drop_base: 0, frame: 0, edge_base: 0, checked: checked };
    sh_native_emit(&mut native, mir);
}
