    sh_i64_ok(start);
}

def sh_native_unwind(native: &ShNative, object: &ShObject, mir: &ShMir, symbol_ids: &Vec<i64>) -> Result<i64, i64> {
    let xdata = sh_binary_new(native.code.limit);
    let pdata = sh_binary_new(native.code.limit);
    let mut function = 0;
    while function < sh_mir_fn_count(mir) { let start = sh_native_at(&native.functions, function); if start >= 0 { let end = sh_native_at(&native.ends, function); let frame = sh_native_at(&native.frames, function); if end <= start { return sh_i64_error(6601); }; let unwind = sh_unwind_fixed(&xdata, frame, if frame > 4096 { 22; } else { 11; })?; sh_binary_unsigned(&pdata, 0, 4)?; (); sh_binary_unsigned(&pdata, end - start, 4)?; (); sh_binary_unsigned(&pdata, unwind, 4)?; (); }; function = function + 1; };
    let xname = string_from_str(".xdata")?;
    let pname = string_from_str(".pdata")?;
    let xsection_result = sh_object_add_section(object, &xname, &xdata, 1073741888, 4)?;
    let xsection = xsection_result;
    let psection_result = sh_object_add_section(object, &pname, &pdata, 1073741888, 4)?;
    let psection = psection_result;
    let xsymbol = sh_object_add_symbol(object, &xname, 0, xsection + 1, false, 3)?;
