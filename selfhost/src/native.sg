def sh_native_function(native: &mut ShNative, mir: &ShMir, function: i64) -> Result<i64, i64> {
    let signature = sh_mir_fn(mir, function, 1);
    let abi = sh_windows_abi(mir, signature, 2147483647);
    if abi.error != 0 { return sh_i64_error(abi.error); };
    if sh_mir_type_word(mir, signature, 2) != 0 { return sh_i64_error(6502); };
    sh_native_prepare(native, mir, function, &abi)?;
