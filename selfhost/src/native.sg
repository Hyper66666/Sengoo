import selfhost_mir_validate;

import selfhost_x64_scalar;

import selfhost_object;

import selfhost_unwind;

import selfhost_x64_sse;

import selfhost_abi;

import selfhost_float_literal;

struct ShNative {
    code: ShBinary,
    values: Vec<i64>,
    locals: Vec<i64>,
    initialized: Vec<i64>,
    functions: Vec<i64>,
    ends: Vec<i64>,
    frames: Vec<i64>,
    blocks: Vec<i64>,
    branches: Vec<i64>,
    calls: Vec<i64>,
    layout: ShTargetLayout,
    result_mode: i64,
    result_pointer: i64,
    copies_base: i64,
    drop_base: i64,
    frame: i64,
    edge_base: i64,
    checked: bool,
}

def sh_native_at(values: &Vec<i64>, id: i64) -> i64 {
    sengoo_vec_get_or_default_i64(values.handle, id, -1);
}

def sh_native_width(mir: &ShMir, ty: i64) -> i64 {
    let kind = sh_mir_type_word(mir, ty, 0);
    if kind == 0 { return 0; };
    if kind == 1 { return 1; };
    if kind == 2 or kind == 3 { return sh_mir_type_word(mir, ty, 1) / 8; };
    if kind == 4 { return 4; };
    if kind == 6 and sh_mir_type_word(mir, sh_mir_type_arg(mir, ty, 0), 0) == 14 { return -1; };
    if kind == 5 or kind == 6 or kind == 7 or kind == 11 or kind == 16 { return 8; };
    -1;
}

def sh_native_signed(mir: &ShMir, ty: i64) -> bool {
    sh_mir_type_word(mir, ty, 0) == 2 and (sh_mir_type_word(mir, ty, 2) & 1) == 1;
}

def sh_native_size(native: &ShNative, mir: &ShMir, ty: i64) -> Result<i64, i64> {
    let error = sh_layout_visit(&native.layout, mir, ty, 0);
    if error != 0 { return sh_i64_error(error); };
    sh_i64_ok(sh_layout_at(&native.layout.sizes, ty));
}

def sh_native_address(native: &ShNative, id: i64, register: i64) -> Result<i64, i64> {
    let offset = sh_native_at(&native.values, id);
    if offset < 8 { return sh_i64_error(6501); };
    sh_x64_memory(&native.code, 2, register, 5, -offset);
}

def sh_native_copy(native: &ShNative, size: i64) -> Result<i64, i64> {
    if size < 0 or size > 2147483647 { return sh_i64_error(6503); };
    let start = sh_binary_len(&native.code);
    let count = size / 8;
    if count > 0 { sh_x64_mov_imm(&native.code, 1, count)?; let head = sh_binary_len(&native.code); sh_x64_memory(&native.code, 0, 0, 10, 0)?; sh_x64_memory(&native.code, 1, 0, 11, 0)?; sh_x64_mov_imm(&native.code, 2, 8)?; sh_x64_binary(&native.code, 0, 10, 2)?; sh_x64_binary(&native.code, 0, 11, 2)?; sh_x64_mov_imm(&native.code, 2, 1)?; sh_x64_binary(&native.code, 1, 1, 2)?; let back = sh_x64_branch(&native.code, 2, 5)?; sh_x64_fix_branch(&native.code, back, head)?; (); };
    let mut index = 0;
    while index < size % 8 { sh_x64_scalar_memory(&native.code, false, 0, 10, index, 1, false)?; sh_x64_scalar_memory(&native.code, true, 0, 11, index, 1, false)?; index = index + 1; };
    sh_i64_ok(start);
}

def sh_native_value_copy(native: &ShNative, mir: &ShMir, source: i64, destination: i64, offset: i64) -> Result<i64, i64> {
    sh_native_address(native, source, 10)?;
    sh_native_address(native, destination, 11)?;
    if offset != 0 { sh_x64_mov_imm(&native.code, 0, offset)?; sh_x64_binary(&native.code, 0, 11, 0)?; (); };
    sh_native_copy(native, sh_native_size(native, mir, sh_mir_value_type(mir, source))?);
}

def sh_native_normalize(native: &ShNative, mir: &ShMir, ty: i64, register: i64) -> Result<i64, i64> {
    let width = sh_native_width(mir, ty);
    if width < 0 { return sh_i64_error(6502); };
    if width == 0 { return sh_x64_mov_imm(&native.code, register, 0); };
    if width < 8 { let bits = if sh_mir_type_word(mir, ty, 0) == 1 { 1; } else { width * 8; }; sh_x64_shift(&native.code, 0, register, 64 - bits)?; return sh_x64_shift(&native.code, if sh_native_signed(mir, ty) { 2; } else { 1; }, register, 64 - bits); };
    sh_i64_ok(0);
}

def sh_native_load(native: &ShNative, id: i64, register: i64) -> Result<i64, i64> {
    let offset = sh_native_at(&native.values, id);
    if offset < 8 { return sh_i64_error(6501); };
    sh_x64_memory(&native.code, 0, register, 5, -offset);
}

def sh_native_save(native: &ShNative, id: i64, register: i64) -> Result<i64, i64> {
    let offset = sh_native_at(&native.values, id);
    if offset < 8 { return sh_i64_error(6501); };
    sh_x64_memory(&native.code, 1, register, 5, -offset);
}

def sh_native_call_fixup(native: &ShNative, function: i64) -> Result<i64, i64> {
    let offset = sh_x64_branch(&native.code, 1, 0)?;
    if not native.calls.push(offset) or not native.calls.push(function) { return sh_i64_error(6503); };
    sh_i64_ok(offset);
}

def sh_native_aggregate(native: &ShNative, mir: &ShMir, id: i64) -> Result<i64, i64> {
    let ty = sh_mir_value_type(mir, id);
    let variant = if sh_mir_inst(mir, id, 2) == 24 { sh_mir_inst(mir, id, 6); } else { -1; };
    let size = sh_native_size(native, mir, ty)?;
    let mut offset = 0;
    sh_native_address(native, id, 11)?;
    sh_x64_mov_imm(&native.code, 0, 0)?;
    while offset < size { sh_x64_scalar_memory(&native.code, true, 0, 11, offset, 1, false)?; offset = offset + 1; };
    let mut index = 0;
    while index < sh_mir_inst(mir, id, 5) { let field = sh_target_field_offset(&native.layout, mir, ty, variant, index)?; sh_native_value_copy(native, mir, sh_mir_inst_arg(mir, id, index), id, field)?; index = index + 1; };
    if variant >= 0 { sh_native_address(native, id, 11)?; sh_x64_mov_imm(&native.code, 0, variant)?; sh_x64_memory(&native.code, 1, 0, 11, 0)?; (); };
    sh_i64_ok(0);
}

def sh_native_field(native: &ShNative, mir: &ShMir, id: i64) -> Result<i64, i64> {
    let first = sh_mir_inst_arg(mir, id, 0);
    let input_type = sh_mir_value_type(mir, first);
    let pointer = sh_mir_inst(mir, id, 2) == 17;
    let base_type = if pointer { sh_mir_type_arg(mir, input_type, 0); } else { input_type; };
    sh_native_size(native, mir, base_type)?;
    let offset = sh_target_field_offset(&native.layout, mir, base_type, sh_mir_inst(mir, id, 7), sh_mir_inst(mir, id, 6))?;
    if pointer { sh_native_load(native, first, 0)?; sh_x64_mov_imm(&native.code, 10, offset)?; sh_x64_binary(&native.code, 0, 0, 10)?; return sh_native_save(native, id, 0); };
    sh_native_address(native, first, 10)?;
    sh_x64_mov_imm(&native.code, 0, offset)?;
    sh_x64_binary(&native.code, 0, 10, 0)?;
    sh_native_address(native, id, 11)?;
    sh_native_copy(native, sh_native_size(native, mir, sh_mir_value_type(mir, id))?);
}

def sh_native_edge(native: &ShNative, mir: &ShMir, edge: i64) -> Result<i64, i64> {
    let target = sh_mir_edge(mir, edge, 1);
    let count = sh_mir_edge(mir, edge, 3);
    let offsets = vec_new_i64();
    let mut next = native.edge_base;
    let mut index = 0;
    while index < count { let value = sh_mir_edge_arg(mir, edge, index); let size = sh_native_size(native, mir, sh_mir_value_type(mir, value))?; next = ((next + if size < 8 { 8; } else { size; } + 15) / 16) * 16; if not offsets.push(next) { return sh_i64_error(6503); }; sh_native_address(native, value, 10)?; sh_x64_memory(&native.code, 2, 11, 5, -next)?; sh_native_copy(native, size)?; index = index + 1; };
    index = 0;
    while index < count { let parameter = sh_mir_parameter(mir, target, index); sh_x64_memory(&native.code, 2, 10, 5, -sh_native_at(&offsets, index))?; sh_native_address(native, parameter, 11)?; sh_native_copy(native, sh_native_size(native, mir, sh_mir_value_type(mir, parameter))?)?; index = index + 1; };
    let patch = sh_x64_branch(&native.code, 0, 0)?;
    if not native.branches.push(patch) or not native.branches.push(target) { return sh_i64_error(6503); };
    sh_i64_ok(patch);
}

def sh_native_float_load(native: &ShNative, mir: &ShMir, id: i64, xmm: i64) -> Result<i64, i64> {
    let offset = sh_native_at(&native.values, id);
    if offset < 8 { return sh_i64_error(6501); };
    sh_x64_sse_memory(&native.code, false, sh_native_width(mir, sh_mir_value_type(mir, id)) == 4, xmm, 5, -offset);
}

def sh_native_float_save(native: &ShNative, mir: &ShMir, id: i64, xmm: i64) -> Result<i64, i64> {
    let offset = sh_native_at(&native.values, id);
    if offset < 8 { return sh_i64_error(6501); };
    sh_x64_sse_memory(&native.code, true, sh_native_width(mir, sh_mir_value_type(mir, id)) == 4, xmm, 5, -offset);
}

def sh_native_float_binary(native: &ShNative, mir: &ShMir, id: i64) -> Result<i64, i64> {
    let lhs = sh_mir_inst_arg(mir, id, 0);
    let rhs = sh_mir_inst_arg(mir, id, 1);
    let operator = sh_mir_inst(mir, id, 6);
    let single = sh_native_width(mir, sh_mir_value_type(mir, lhs)) == 4;
    sh_native_float_load(native, mir, lhs, 0)?;
    sh_native_float_load(native, mir, rhs, 1)?;
    let arithmetic = if operator == sh_kind("+") { 0; } else { if operator == sh_kind("-") { 1; } else { if operator == sh_kind("*") { 2; } else { if operator == sh_kind("/") { 3; } else { -1; }; }; }; };
    if arithmetic >= 0 { sh_x64_sse_binary(&native.code, single, arithmetic, 0, 1)?; return sh_native_float_save(native, mir, id, 0); };
    let condition = if operator == sh_kind("==") { 4; } else { if operator == sh_kind("!=") { 5; } else { if operator == sh_kind("<") { 2; } else { if operator == sh_kind("<=") { 6; } else { if operator == sh_kind(">") { 7; } else { if operator == sh_kind(">=") { 3; } else { -1; }; }; }; }; }; };
    if condition < 0 { return sh_i64_error(6502); };
    sh_x64_sse_compare(&native.code, single, 0, 1)?;
    sh_x64_set_condition(&native.code, condition, 0)?;
    if condition == 4 or condition == 2 or condition == 6 { sh_x64_set_condition(&native.code, 11, 10)?; sh_x64_binary(&native.code, 2, 0, 10)?; (); };
    if condition == 5 { sh_x64_set_condition(&native.code, 10, 10)?; sh_x64_binary(&native.code, 3, 0, 10)?; (); };
    sh_native_save(native, id, 0);
}

def sh_native_division(native: &ShNative, mir: &ShMir, id: i64) -> Result<i64, i64> {
    let lhs = sh_mir_inst_arg(mir, id, 0);
    let rhs = sh_mir_inst_arg(mir, id, 1);
    let ty = sh_mir_value_type(mir, id);
    let remainder = sh_mir_inst(mir, id, 6) == sh_kind("%");
    if native.checked { sh_native_load(native, rhs, 1)?; sh_native_call_fixup(native, sh_mir_fn_count(mir) + 2)?; (); };
    sh_native_load(native, lhs, 0)?;
    sh_native_load(native, rhs, 10)?;
    let mut overflow_done = -1;
    let signed = sh_native_signed(mir, ty);
    if signed { let bits = sh_mir_type_word(mir, ty, 1); let minimum = if bits == 64 { -9223372036854775807 - 1; } else { -(1 << (bits - 1)); }; sh_x64_mov_imm(&native.code, 11, minimum)?; sh_x64_binary(&native.code, 5, 0, 11)?; let regular_lhs = sh_x64_branch(&native.code, 2, 5)?; sh_x64_mov_imm(&native.code, 11, -1)?; sh_x64_binary(&native.code, 5, 10, 11)?; let regular_rhs = sh_x64_branch(&native.code, 2, 5)?; if native.checked { sh_x64_mov_imm(&native.code, 1, 1)?; sh_native_call_fixup(native, sh_mir_fn_count(mir))?; (); }; sh_x64_mov_imm(&native.code, 0, if remainder { 0; } else { minimum; })?; overflow_done = sh_x64_branch(&native.code, 0, 0)?; sh_x64_fix_branch(&native.code, regular_lhs, sh_binary_len(&native.code))?; sh_x64_fix_branch(&native.code, regular_rhs, sh_binary_len(&native.code))?; sh_binary_byte(&native.code, 72)?; sh_binary_byte(&native.code, 153)?; sh_x64_unary(&native.code, 3, 10)?; (); } else { sh_x64_binary(&native.code, 4, 2, 2)?; sh_x64_unary(&native.code, 4, 10)?; (); };
    if remainder { sh_x64_mov(&native.code, 0, 2)?; (); };
    if overflow_done >= 0 { sh_x64_fix_branch(&native.code, overflow_done, sh_binary_len(&native.code))?; (); };
    sh_native_finish(native, mir, id);
}

def sh_native_binary(native: &ShNative, mir: &ShMir, id: i64) -> Result<i64, i64> {
    let lhs = sh_mir_inst_arg(mir, id, 0);
    let rhs = sh_mir_inst_arg(mir, id, 1);
    let ty = sh_mir_value_type(mir, lhs);
    if sh_mir_type_word(mir, ty, 0) == 3 { return sh_native_float_binary(native, mir, id); };
    if sh_mir_inst(mir, id, 6) == sh_kind("/") or sh_mir_inst(mir, id, 6) == sh_kind("%") { return sh_native_division(native, mir, id); };
    let operator = sh_mir_inst(mir, id, 6);
    if sh_native_width(mir, ty) < 0 { return sh_i64_error(6502); };
    sh_native_load(native, lhs, 0)?;
    sh_native_load(native, rhs, 10)?;
    let comparison = operator == sh_kind("==") or operator == sh_kind("!=") or operator == sh_kind("<") or operator == sh_kind("<=") or operator == sh_kind(">") or operator == sh_kind(">=");
    if comparison { sh_x64_binary(&native.code, 5, 0, 10)?; let signed = sh_native_signed(mir, ty); let condition = if operator == sh_kind("==") { 4; } else { if operator == sh_kind("!=") { 5; } else { if operator == sh_kind("<") { if signed { 12; } else { 2; }; } else { if operator == sh_kind("<=") { if signed { 14; } else { 6; }; } else { if operator == sh_kind(">") { if signed { 15; } else { 7; }; } else { if signed { 13; } else { 3; }; }; }; }; }; }; sh_x64_set_condition(&native.code, condition, 0)?; return sh_native_save(native, id, 0); };
    let arithmetic = operator == sh_kind("+") or operator == sh_kind("-") or operator == sh_kind("*");
    if arithmetic { let operation = if operator == sh_kind("+") { 0; } else { if operator == sh_kind("-") { 1; } else { 6; }; }; if operator == sh_kind("*") and not sh_native_signed(mir, ty) and sh_native_width(mir, ty) == 8 { sh_x64_unary(&native.code, 2, 10)?; } else { sh_x64_binary(&native.code, operation, 0, 10)?; }; if native.checked { if sh_native_width(mir, ty) == 8 { sh_x64_set_condition(&native.code, if sh_native_signed(mir, ty) { 0; } else { 2; }, 1)?; } else { sh_x64_mov(&native.code, 11, 0)?; sh_native_normalize(native, mir, ty, 0)?; sh_x64_binary(&native.code, 5, 0, 11)?; sh_x64_set_condition(&native.code, 5, 1)?; }; sh_native_save(native, id, 0)?; sh_native_call_fixup(native, sh_mir_fn_count(mir))?; sh_native_load(native, id, 0)?; (); }; return sh_native_finish(native, mir, id); };
    let operation = if operator == sh_kind("&") or operator == sh_kind("&&") or operator == sh_kind("and") { 2; } else { if operator == sh_kind("|") or operator == sh_kind("||") or operator == sh_kind("or") { 3; } else { if operator == sh_kind("^") { 4; } else { -1; }; }; };
    if operation >= 0 { sh_x64_binary(&native.code, operation, 0, 10)?; return sh_native_finish(native, mir, id); };
    if operator == sh_kind("<<") or operator == sh_kind(">>") { sh_x64_mov(&native.code, 1, 10)?; sh_x64_mov_imm(&native.code, 11, if sh_native_width(mir, ty) == 8 { 63; } else { 31; })?; sh_x64_binary(&native.code, 2, 1, 11)?; sh_x64_shift(&native.code, if operator == sh_kind("<<") { 0; } else { if sh_native_signed(mir, ty) { 2; } else { 1; }; }, 0, -1)?; return sh_native_finish(native, mir, id); };
    sh_i64_error(6502);
}

def sh_native_finish(native: &ShNative, mir: &ShMir, id: i64) -> Result<i64, i64> {
    sh_native_normalize(native, mir, sh_mir_value_type(mir, id), 0)?;
    sh_native_save(native, id, 0);
}

def sh_native_float_power(native: &ShNative, single: bool, exponent: i64, negative: bool) -> Result<i64, i64> {
    let bits = if single { (exponent + 127) << 23; } else { (exponent + 1023) << 52; };
    let sign = if negative { if single { 2147483648; } else { -9223372036854775807 - 1; }; } else { 0; };
    sh_x64_mov_imm(&native.code, 0, bits | sign)?;
    sh_x64_sse_movq(&native.code, 1, 0);
}

def sh_native_float_integer(native: &ShNative, mir: &ShMir, id: i64, source: i64) -> Result<i64, i64> {
    let single = sh_native_width(mir, sh_mir_value_type(mir, source)) == 4;
    let target = sh_mir_value_type(mir, id);
    let bits = sh_mir_type_word(mir, target, 1);
    let signed = sh_native_signed(mir, target);
    let maximum = if bits == 64 { if signed { 9223372036854775807; } else { -1; }; } else { (1 << (bits - if signed { 1; } else { 0; })) - 1; };
    let minimum = if signed { if bits == 64 { -9223372036854775807 - 1; } else { -(1 << (bits - 1)); }; } else { 0; };
    sh_native_float_load(native, mir, source, 0)?;
    sh_x64_sse_compare(&native.code, single, 0, 0)?;
    let nan = sh_x64_branch(&native.code, 2, 10)?;
    sh_native_float_power(native, single, bits - if signed { 1; } else { 0; }, false)?;
    sh_x64_sse_compare(&native.code, single, 0, 1)?;
    let upper = sh_x64_branch(&native.code, 2, 3)?;
    if signed { sh_native_float_power(native, single, bits - 1, true)?; } else { sh_x64_mov_imm(&native.code, 0, 0)?; sh_x64_sse_movq(&native.code, 1, 0)?; };
    sh_x64_sse_compare(&native.code, single, 0, 1)?;
    let lower = sh_x64_branch(&native.code, 2, 6)?;
    if not signed and bits == 64 { sh_native_float_power(native, single, 63, false)?; sh_x64_sse_compare(&native.code, single, 0, 1)?; let small = sh_x64_branch(&native.code, 2, 2)?; sh_x64_sse_binary(&native.code, single, 1, 0, 1)?; sh_x64_sse_convert(&native.code, 1, single, 0, 0)?; sh_x64_mov_imm(&native.code, 10, -9223372036854775807 - 1)?; sh_x64_binary(&native.code, 3, 0, 10)?; let joined = sh_x64_branch(&native.code, 0, 0)?; sh_x64_fix_branch(&native.code, small, sh_binary_len(&native.code))?; sh_x64_sse_convert(&native.code, 1, single, 0, 0)?; sh_x64_fix_branch(&native.code, joined, sh_binary_len(&native.code))?; (); } else { sh_x64_sse_convert(&native.code, 1, single, 0, 0)?; (); };
    let success = sh_x64_branch(&native.code, 0, 0)?;
    sh_x64_fix_branch(&native.code, upper, sh_binary_len(&native.code))?;
    sh_x64_mov_imm(&native.code, 0, maximum)?;
    let max_join = sh_x64_branch(&native.code, 0, 0)?;
    sh_x64_fix_branch(&native.code, lower, sh_binary_len(&native.code))?;
    sh_x64_mov_imm(&native.code, 0, minimum)?;
    let min_join = sh_x64_branch(&native.code, 0, 0)?;
    sh_x64_fix_branch(&native.code, nan, sh_binary_len(&native.code))?;
    sh_x64_mov_imm(&native.code, 0, 0)?;
    let done = sh_binary_len(&native.code);
    sh_x64_fix_branch(&native.code, success, done)?;
    sh_x64_fix_branch(&native.code, max_join, done)?;
    sh_x64_fix_branch(&native.code, min_join, done)?;
    sh_native_finish(native, mir, id);
}

def sh_native_cast(native: &ShNative, mir: &ShMir, id: i64) -> Result<i64, i64> {
    let source = sh_mir_inst_arg(mir, id, 0);
    let input = sh_mir_value_type(mir, source);
    let target = sh_mir_value_type(mir, id);
    let input_kind = sh_mir_type_word(mir, input, 0);
    let target_kind = sh_mir_type_word(mir, target, 0);
    let single = sh_native_width(mir, target) == 4;
    if input_kind == 3 and target_kind == 2 { return sh_native_float_integer(native, mir, id, source); };
    if input_kind == 3 and target_kind == 3 { sh_native_float_load(native, mir, source, 0)?; if sh_native_width(mir, input) != sh_native_width(mir, target) { sh_x64_sse_convert(&native.code, 2, not single, 0, 0)?; (); }; return sh_native_float_save(native, mir, id, 0); };
    if input_kind == 2 and target_kind == 3 { sh_native_load(native, source, 0)?; if not sh_native_signed(mir, input) and sh_native_width(mir, input) == 8 { sh_x64_mov_imm(&native.code, 10, 0)?; sh_x64_binary(&native.code, 5, 0, 10)?; let nonnegative = sh_x64_branch(&native.code, 2, 9)?; sh_x64_mov(&native.code, 10, 0)?; sh_x64_shift(&native.code, 1, 0, 1)?; sh_x64_mov_imm(&native.code, 11, 1)?; sh_x64_binary(&native.code, 2, 10, 11)?; sh_x64_binary(&native.code, 3, 0, 10)?; sh_x64_sse_convert(&native.code, 0, single, 0, 0)?; sh_x64_sse_binary(&native.code, single, 0, 0, 0)?; let joined = sh_x64_branch(&native.code, 0, 0)?; sh_x64_fix_branch(&native.code, nonnegative, sh_binary_len(&native.code))?; sh_x64_sse_convert(&native.code, 0, single, 0, 0)?; sh_x64_fix_branch(&native.code, joined, sh_binary_len(&native.code))?; (); } else { sh_x64_sse_convert(&native.code, 0, single, 0, 0)?; (); }; return sh_native_float_save(native, mir, id, 0); };
    if input_kind == 3 or target_kind == 3 { return sh_i64_error(6502); };
    sh_native_load(native, source, 0)?;
    sh_native_finish(native, mir, id);
}

def sh_native_drop_type(native: &ShNative, mir: &ShMir, ty: i64, depth: i64) -> Result<i64, i64> {
    if depth < 0 or depth >= 64 { return sh_i64_error(6503); };
    let glue = sh_mir_drop_kind(mir, ty);
    if glue == 4 { return sh_i64_error(6502); };
    if glue == 0 { return sh_i64_ok(0); };
    let kind = sh_mir_type_word(mir, ty, 0);
    if kind == 16 or kind == 14 { return sh_i64_error(6502); };
    if kind != 12 and kind != 10 and kind != 8 { return sh_i64_ok(0); };
    let saved = native.drop_base + depth * 16 + 8;
    sh_x64_memory(&native.code, 1, 10, 5, -saved)?;
    let mut count = 0;
