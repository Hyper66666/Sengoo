def sh_s_printable(checked: &ShChecked, ty: i64) -> bool {
    let visiting = vec_new_i64();
    sh_s_printable_inner(checked, ty, &visiting, 0);
}

def sh_s_printable_inner(checked: &ShChecked, ty: i64, visiting: &Vec<i64>, depth: i64) -> bool {
    if depth > 128 { return false; };
    let base = sh_s_base_type(checked, ty);
    let kind = sh_s_kind(checked, base);
    if kind == 1 or kind == 2 or kind == 3 or kind == 5 or kind == 13 or kind == 18 { return true; };
    let display = sh_s_named_symbol(checked, "Display");
    if sh_s_implements(checked, base, display) { return true; };
    if kind != 12 { return false; };
    let name = sh_s_symbol_text(checked, sh_s_nominal(checked, base));
    if name.is_ok() and sh_s_text_equal(&name.value, "String") { return true; };
    let owner = sh_adt_binding(checked, base);
    if owner < 0 { return false; };
    if sh_binding_word(checked, owner, 2) == 4 { return true; };
    let mut seen_at = 0;
    while seen_at < visiting.len() { if sh_s_vector(visiting, seen_at) == base { return true; }; seen_at = seen_at + 1; };
    visiting.push(base);
    let mut binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 6 and sh_binding_word(checked, binding, 6) == owner { let field_type = sh_resolved_field_type(checked, base, binding); if not sh_s_printable_inner(checked, field_type, visiting, depth + 1) { visiting.pop(); return false; }; }; binding = binding + 1; };
    visiting.pop();
    true;
}

def sh_s_builtin_call(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64, builtin: i64) -> i64 {
    let count = sh_ast_word(ast, node, 6) - 1;
    if builtin >= 10 { return sh_s_async_builtin(checked, text, ast, node, builtin); };
    if builtin <= 3 { if count != 1 { sh_s_diagnose(checked, ast, node, 5105, 1, 1, count); }; let mut index = 1; while index <= count { let child = sh_ast_child(ast, node, index); let ty = sh_s_expr(checked, text, ast, child, -1); if not sh_s_printable(checked, ty) { sh_s_diagnose(checked, ast, child, 5115, 1, -1, ty); }; index = index + 1; }; return checked.unit_type; };
