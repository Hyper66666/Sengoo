    let empty = vec_new_i64();
    sh_s_type(checked, 12, 0, 0, sh_s_named_symbol(checked, "String"), &empty);
}

def sh_s_runtime_adt(checked: &ShChecked, name: &str) -> i64 {
    let empty = vec_new_i64();
    sh_s_type(checked, 12, 0, 0, sh_s_named_symbol(checked, name), &empty);
}

def sh_s_send_type(checked: &ShChecked, original: i64, visiting: &Vec<i64>, depth: i64) -> bool {
    sh_s_auto_marker(checked, original, sh_s_named_symbol(checked, "Send"), visiting, depth);
