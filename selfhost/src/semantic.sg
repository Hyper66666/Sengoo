def sh_s_fill_bounds(checked: &mut ShChecked, text: &String, ast: &ShAst, owner: i64) {
    let declaration = sh_binding_word(checked, owner, 4);
    let scope = sh_binding_word(checked, owner, 7);
    let old = checked.current_scope;
    checked.current_scope = scope;
    let mut record = 0;
    while record < checked.generic_parameters.len() { if checked.generic_parameters.get(record).unwrap_or(-1) == owner { let param_binding = checked.generic_parameters.get(record + 1).unwrap_or(-1); let param_type = checked.generic_parameters.get(record + 2).unwrap_or(-1); let param_node = sh_binding_word(checked, param_binding, 4); let flags = sh_ast_word(ast, param_node, 4); if (flags & 1) != 0 { let mut index = 1; let end = sh_ast_word(ast, param_node, 6) - if (flags & 2) != 0 { 1; } else { 0; }; while index < end { let bound_node = sh_ast_child(ast, param_node, index); let bound = sh_s_type_ast(checked, text, ast, bound_node); if sh_s_kind(checked, bound) != 14 { sh_s_diagnose(checked, ast, bound_node, 5115, 1, -1, bound); } else { checked.constraints.push(param_type); checked.constraints.push(sh_s_nominal(checked, bound)); checked.constraints.push(bound_node); checked.constraints.push(owner); (); }; index = index + 1; }; }; }; record = record + 3; };
