    sh_s_builtin_trait(checked, "Ord");
    sh_s_builtin_trait(checked, "Default");
    sh_s_builtin_trait(checked, "Display");
    sh_s_builtin_trait(checked, "Debug");
    sh_s_builtin_trait(checked, "Send");
    sh_s_builtin_trait(checked, "Sync");
    sh_s_builtin_trait(checked, "Add");
    sh_s_builtin_trait(checked, "Sub");
    sh_s_builtin_trait(checked, "Mul");
    sh_s_builtin_trait(checked, "Div");
    sh_s_builtin_trait(checked, "Rem");
    sh_s_builtin_trait(checked, "Neg");
    sh_s_builtin_trait(checked, "Hash");
    sh_s_builtin_trait(checked, "Iterator");
    sh_s_builtin_trait(checked, "IntoIterator");
    sh_s_builtin_function(checked, "print", 1);
    sh_s_builtin_function(checked, "println", 2);
    sh_s_builtin_function(checked, "eprintln", 3);
    sh_s_builtin_function(checked, "format", 4);
    sh_s_builtin_function(checked, "sleep", 10);
    sh_s_builtin_function(checked, "timeout", 11);
    sh_s_builtin_function(checked, "timeout_cancel", 12);
    sh_s_builtin_function(checked, "spawn", 13);
    sh_s_builtin_function(checked, "spawn_task", 14);
    sh_s_builtin_function(checked, "join", 15);
    sh_s_builtin_function(checked, "cancel_task", 16);
    sh_s_builtin_function(checked, "task_status", 17);
    sh_s_builtin_function(checked, "select", 18);
    sh_s_builtin_function(checked, "select_cancel", 19);
    sh_s_builtin_function(checked, "scope_spawn", 20);
    sh_s_builtin_function(checked, "task_scope", 21);
    sh_s_builtin_function(checked, "spawn_blocking_future_i64", 22);
    sh_s_builtin_function(checked, "channel_send_i64", 23);
