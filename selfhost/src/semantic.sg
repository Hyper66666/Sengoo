def sh_s_integer_value(text: &String, ast: &ShAst, node: i64) -> i64 {
    let raw = sh_s_name(text, ast, node);
    if not raw.is_ok() { return -1; };
    let bytes = sh_lex_bytes(&raw.value);
    if not bytes.is_ok() { return -1; };
    let mut index = 0;
    let mut base = 10;
    let mut result = 0;
    if raw.value.len() >= 2 and sh_lex_byte(&bytes.value, 0) == 48 { let second = sh_lex_byte(&bytes.value, 1); if second == 120 { base = 16; index = 2; }; if second == 98 { base = 2; index = 2; }; if second == 111 { base = 8; index = 2; }; };
    while index < raw.value.len() { let byte = sh_lex_byte(&bytes.value, index); if byte != 95 { let digit = sh_lex_hex(byte); if digit < 0 or digit >= base { break; }; if result > (9223372036854775807 - digit) / base { return -1; }; result = result * base + digit; }; index = index + 1; };
    result;
}

def sh_s_alias(checked: &mut ShChecked, text: &String, ast: &ShAst, binding: i64) -> i64 {
