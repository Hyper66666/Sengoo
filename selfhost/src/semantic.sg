def sh_s_instantiate_call(checked: &mut ShChecked, text: &String, ast: &ShAst, callee: i64, original: i64) -> i64 {
    let binding = sh_node_binding(checked, callee);
    let parameters = vec_new_i64();
    sh_s_parameter_types(checked, binding, &parameters);
    let explicit_types = vec_new_i64();
    sh_s_explicit_types(checked, text, ast, callee, &explicit_types);
    if explicit_types.len() > parameters.len() { sh_s_diagnose(checked, ast, callee, 5114, 1, parameters.len(), explicit_types.len()); return checked.error_type; };
    let mut index = explicit_types.len();
