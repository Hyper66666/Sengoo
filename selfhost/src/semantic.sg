    checked.current_scope = old_scope;
    if ty < 0 { ty = sh_s_fresh(checked); };
    sh_s_binding_set(checked, binding, 3, ty);
    sh_s_binding_set(checked, binding, 5, flags | 2048);
    sh_s_set_type(checked, declaration, ty);
