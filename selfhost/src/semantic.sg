def sh_s_auto_marker(checked: &ShChecked, original: i64, marker: i64, visiting: &Vec<i64>, depth: i64) -> bool {
    if depth > 128 { return false; };
    let ty = sh_s_resolve(checked, original);
    let kind = sh_s_kind(checked, ty);
    if kind == 0 or kind == 1 or kind == 2 or kind == 3 or kind == 5 or kind == 11 or kind == 18 { return true; };
    if kind == 13 { return sh_s_implements(checked, ty, marker); };
    if kind != 8 and kind != 9 and kind != 10 and kind != 12 { return false; };
    let mut seen = 0;
    while seen < visiting.len() { if sh_s_vector(visiting, seen) == ty { return true; }; seen = seen + 1; };
    if kind == 12 { let name = sh_s_symbol_text(checked, sh_s_nominal(checked, ty)); if name.is_ok() and sh_s_text_equal(&name.value, "AsyncContext") { return false; }; let send = marker; let mut record = 0; while record < checked.constraints.len() { if checked.constraints.get(record + 2).unwrap_or(-1) == -2 and checked.constraints.get(record + 1).unwrap_or(-1) == send { let target = checked.constraints.get(record).unwrap_or(-1); let implementation = checked.constraints.get(record + 3).unwrap_or(-1); if (sh_binding_word(checked, implementation, 5) & 8) != 0 and sh_s_nominal(checked, target) == sh_s_nominal(checked, ty) { return false; }; }; record = record + 4; }; };
    visiting.push(ty);
    let mut index = 0;
    while index < sh_s_arity(checked, ty) { if not sh_s_auto_marker(checked, sh_s_argument(checked, ty, index), marker, visiting, depth + 1) { visiting.pop(); return false; }; index = index + 1; };
    if kind == 12 { let owner = sh_adt_binding(checked, ty); let mut binding = 0; while binding < sh_binding_count(checked) { let field_owner = sh_binding_word(checked, binding, 6); if sh_binding_word(checked, binding, 2) == 6 and owner >= 0 and (field_owner == owner or sh_binding_word(checked, field_owner, 2) == 5 and sh_binding_word(checked, field_owner, 6) == owner) { let field_type = sh_resolved_field_type(checked, ty, binding); if not sh_s_auto_marker(checked, field_type, marker, visiting, depth + 1) { visiting.pop(); return false; }; }; binding = binding + 1; }; };
    let parent = sh_class_parent(checked, ty);
    if parent >= 0 and not sh_s_auto_marker(checked, parent, marker, visiting, depth + 1) { visiting.pop(); return false; };
    visiting.pop();
    true;
}

def sh_s_send_captures(checked: &mut ShChecked, ast: &ShAst, node: i64, boundary: i64, depth: i64) {
    if depth > 128 { sh_s_diagnose(checked, ast, node, 5117, 1, -1, -1); return; };
    if sh_ast_word(ast, node, 0) == 12 { let binding = sh_node_binding(checked, node); let kind = sh_binding_word(checked, binding, 2); let declaration = sh_binding_word(checked, binding, 4); if (kind == 0 or kind == 1) and sh_ast_word(ast, declaration, 2) < sh_ast_word(ast, boundary, 2) { let visiting = vec_new_i64(); let ty = sh_binding_word(checked, binding, 3); if not sh_s_send_type(checked, ty, &visiting, 0) { sh_s_diagnose(checked, ast, node, 5115, 1, -1, ty); }; }; };
    let mut index = 0;
    while index < sh_ast_word(ast, node, 6) { sh_s_send_captures(checked, ast, sh_ast_child(ast, node, index), boundary, depth + 1); index = index + 1; };
    ();
}

def sh_s_spawn_send(checked: &mut ShChecked, ast: &ShAst, future_node: i64) {
    let kind = sh_ast_word(ast, future_node, 0);
    if kind == 68 and (sh_ast_word(ast, future_node, 4) == sh_kind("async") or sh_ast_word(ast, future_node, 4) == sh_kind("parallel")) { sh_s_send_captures(checked, ast, future_node, future_node, 0); return; };
    if kind != 53 { sh_s_diagnose(checked, ast, future_node, 5115, 1, -1, -1); return; };
    let callee = sh_ast_child(ast, future_node, 0);
    let binding = sh_node_binding(checked, callee);
    let binding_kind = sh_binding_word(checked, binding, 2);
    if sh_ast_word(ast, callee, 0) != 12 or binding_kind != 2 and binding_kind != 13 { sh_s_diagnose(checked, ast, future_node, 5115, 1, -1, -1); return; };
    let mut index = 1;
    while index < sh_ast_word(ast, future_node, 6) { let argument = sh_ast_child(ast, future_node, index); let visiting = vec_new_i64(); let ty = sh_node_type(checked, argument); if not sh_s_send_type(checked, ty, &visiting, 0) { sh_s_diagnose(checked, ast, argument, 5115, 1, -1, ty); }; index = index + 1; };
