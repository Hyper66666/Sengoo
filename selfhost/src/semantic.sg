def sh_s_implements(checked: &ShChecked, original: i64, trait_symbol: i64) -> bool {
    sh_s_implements_depth(checked, original, trait_symbol, 0);
}

def sh_s_implements_depth(checked: &ShChecked, original: i64, trait_symbol: i64, depth: i64) -> bool {
    if depth > 128 { return false; };
    let ty = sh_s_resolve(checked, original);
    let kind = sh_s_kind(checked, ty);
    if kind == 18 or kind == 19 { return true; };
    let mut record = 0;
    while record < checked.constraints.len() { if checked.constraints.get(record + 1).unwrap_or(-1) == trait_symbol { let target = checked.constraints.get(record).unwrap_or(-1); let source = checked.constraints.get(record + 2).unwrap_or(-1); if source != -2 { if target == ty { return true; }; } else { let binding = checked.constraints.get(record + 3).unwrap_or(-1); if (sh_binding_word(checked, binding, 5) & 8) == 0 and sh_s_nominal(checked, target) == sh_s_nominal(checked, ty) and sh_s_kind(checked, target) == kind { return true; }; }; }; record = record + 4; };
    let label = sh_s_symbol_text(checked, trait_symbol);
    if not label.is_ok() { return false; };
    if kind == 2 or kind == 3 or kind == 1 or kind == 4 or kind == 5 or kind == 6 { let name = label.value.as_str(); if name == "Clone" or name == "Copy" or name == "PartialEq" or name == "Eq" or name == "PartialOrd" or name == "Ord" or name == "Default" or name == "Display" or name == "Debug" or name == "Send" or name == "Sync" or name == "Hash" { return true; }; if kind == 2 or kind == 3 { return name == "Add" or name == "Sub" or name == "Mul" or name == "Div" or name == "Rem" or name == "Neg"; }; };
    if kind == 12 { let parent = sh_class_parent(checked, ty); if parent >= 0 { return sh_s_implements_depth(checked, parent, trait_symbol, depth + 1); }; };
    false;
}

def sh_s_validate_impls(checked: &mut ShChecked, text: &String, ast: &ShAst) {
    let mut implementation = 0;
    while implementation < sh_binding_count(checked) { if sh_binding_word(checked, implementation, 2) == 14 and (sh_binding_word(checked, implementation, 5) & 8) == 0 { let mut record = 0; let mut trait_symbol = -1; while record < checked.constraints.len() { if checked.constraints.get(record + 2).unwrap_or(-1) == -2 and checked.constraints.get(record + 3).unwrap_or(-1) == implementation { trait_symbol = checked.constraints.get(record + 1).unwrap_or(-1); break; }; record = record + 4; }; if trait_symbol >= 0 { let trait_binding = sh_s_lookup(checked, trait_symbol, 0, true); let mut method = 0; while method < sh_binding_count(checked) { if sh_binding_word(checked, method, 2) == 2 and sh_binding_word(checked, method, 6) == trait_binding { let mut candidate = 0; let mut found = -1; while candidate < sh_binding_count(checked) { if sh_binding_word(checked, candidate, 2) == 2 and sh_binding_word(checked, candidate, 6) == implementation and sh_binding_word(checked, candidate, 0) == sh_binding_word(checked, method, 0) { found = candidate; break; }; candidate = candidate + 1; }; let required_node = sh_binding_word(checked, method, 4); if found < 0 { let required_body = sh_s_child_kind(ast, required_node, 40); if required_node >= 0 and (required_body < 0 or sh_ast_word(ast, required_body, 6) == 0) { let declaration = sh_binding_word(checked, implementation, 4); sh_s_diagnose(checked, ast, declaration, 5115, 1, method, -1); }; } else { let keys = vec_new_i64(); let values = vec_new_i64(); let self_name = sh_s_named_symbol(checked, "Self"); let self_binding = sh_s_lookup(checked, self_name, sh_binding_word(checked, trait_binding, 7), true); if self_binding >= 0 { keys.push(sh_binding_word(checked, self_binding, 3)); values.push(sh_binding_word(checked, implementation, 3)); (); }; let mut trait_actual = -1; let mut trait_at = 0; while trait_at < checked.trait_types.len() { if checked.trait_types.get(trait_at).unwrap_or(-1) == implementation { trait_actual = checked.trait_types.get(trait_at + 1).unwrap_or(-1); break; }; trait_at = trait_at + 2; }; let mut generic_at = 0; let mut ordinal = 0; while generic_at < checked.generic_parameters.len() { if checked.generic_parameters.get(generic_at).unwrap_or(-1) == trait_binding { keys.push(checked.generic_parameters.get(generic_at + 2).unwrap_or(-1)); values.push(sh_s_argument(checked, trait_actual, ordinal)); ordinal = ordinal + 1; }; generic_at = generic_at + 3; }; let wanted = sh_s_type_replace(checked, sh_binding_word(checked, method, 3), &keys, &values, 0); let actual = sh_binding_word(checked, found, 3); let declaration = sh_binding_word(checked, found, 4); sh_s_expect(checked, ast, declaration, wanted, actual); (); }; }; method = method + 1; }; }; }; implementation = implementation + 1; };
    ();
}

def sh_s_instantiate(checked: &ShChecked, original: i64) -> i64 {
    let source_keys = vec_new_i64();
    let target_values = vec_new_i64();
    let pending = vec_new_i64();
    pending.push(original);
    let mut cursor = 0;
    while cursor < pending.len() { let ty = pending.get(cursor).unwrap_or(checked.error_type); if sh_s_kind(checked, ty) == 13 { if not source_keys.contains(ty) { source_keys.push(ty); target_values.push(sh_s_fresh(checked)); (); }; } else { let mut index = 0; while index < sh_s_arity(checked, ty) { pending.push(sh_s_argument(checked, ty, index)); index = index + 1; }; }; cursor = cursor + 1; };
    sh_s_type_replace(checked, original, &source_keys, &target_values, 0);
}

def sh_s_literal(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64, expected: i64) -> i64 {
    let payload = sh_ast_word(ast, node, 4);
    if payload == sh_kind("true") or payload == sh_kind("false") { return checked.bool_type; };
    if payload == 5 or payload == 6 { return sh_s_unary_type(checked, 6, 0, 0, checked.str_type); };
    if payload == 8 { return checked.char_type; };
    if payload == 7 { let byte = sh_s_primitive(checked, 2, 8, 0); return sh_s_unary_type(checked, 9, 0, 0, byte); };
    if payload == sh_kind("null") or payload == sh_kind("none") { let symbol = sh_s_named_symbol(checked, "Option"); if expected >= 0 and sh_s_kind(checked, expected) == 12 and sh_s_nominal(checked, expected) == symbol { return expected; }; let args = vec_new_i64(); return sh_s_type(checked, 12, 0, 0, symbol, &args); };
    let raw = sh_s_name(text, ast, node);
    if not raw.is_ok() { return checked.error_type; };
    let spelling = raw.value.as_str();
    if payload == 2 { let mut suffix = -1; if str_ends_with(spelling, "isize") { suffix = sh_s_primitive(checked, 2, 64, 3); } else if str_ends_with(spelling, "usize") { suffix = sh_s_primitive(checked, 2, 64, 2); } else { let mut width = 8; while width <= 64 { let name = string_from_str("i"); if name.is_ok() { name.value.push_i64(width); if str_ends_with(spelling, name.value.as_str()) { suffix = sh_s_primitive(checked, 2, width, 1); }; }; let other = string_from_str("u"); if other.is_ok() { other.value.push_i64(width); if str_ends_with(spelling, other.value.as_str()) { suffix = sh_s_primitive(checked, 2, width, 0); }; }; width = width * 2; }; }; if suffix >= 0 { return suffix; }; return checked.integer_type; };
    if payload == 3 { if str_ends_with(spelling, "f32") { return sh_s_primitive(checked, 3, 32, 0); }; if str_ends_with(spelling, "f64") { return checked.float_type; }; return checked.float_type; };
    sh_s_diagnose(checked, ast, node, 5116, 1, -1, -1);
    checked.error_type;
}

def sh_s_path(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64) -> i64 {
    let symbol = sh_s_path_symbol(checked, text, ast, node);
    let mut binding = sh_s_lookup(checked, symbol, checked.current_scope, false);
    if binding < 0 { binding = sh_s_lookup(checked, symbol, checked.current_scope, true); };
    if binding < 0 { let mut candidate = 0; while candidate < sh_binding_count(checked) { if sh_binding_word(checked, candidate, 2) == 5 and sh_binding_word(checked, candidate, 0) == symbol { binding = candidate; break; }; candidate = candidate + 1; }; };
    if binding < 0 and sh_ast_word(ast, node, 6) >= 2 { let name_node = sh_ast_child(ast, node, sh_ast_word(ast, node, 6) - 1); if sh_ast_word(ast, name_node, 0) == 10 { let member = sh_s_symbol(checked, text, ast, name_node); let prefix = sh_ast_child(ast, node, 0); let prefix_symbol = if sh_ast_word(ast, prefix, 0) == 10 { sh_s_symbol(checked, text, ast, prefix); } else { sh_s_path_symbol(checked, text, ast, prefix); }; let owner_binding = sh_s_lookup(checked, prefix_symbol, checked.current_scope, true); if owner_binding >= 0 { let target_type = sh_binding_word(checked, owner_binding, 3); let nominal = sh_s_nominal(checked, target_type); let mut candidate = 0; while candidate < sh_binding_count(checked) { if sh_binding_word(checked, candidate, 2) == 2 and sh_binding_word(checked, candidate, 0) == member { let owner = sh_binding_word(checked, candidate, 6); let owner_type = sh_binding_word(checked, owner, 3); if sh_s_nominal(checked, owner_type) == nominal and owner >= 0 { binding = candidate; break; }; }; candidate = candidate + 1; }; }; }; };
    if binding < 0 { sh_s_diagnose(checked, ast, node, 5101, 1, -1, -1); return checked.error_type; };
    sh_s_bind_node(checked, node, binding);
    let first = sh_ast_child(ast, node, 0);
    if sh_ast_word(ast, first, 0) == 10 { sh_s_bind_node(checked, first, binding); };
    sh_binding_word(checked, binding, 3);
}

def sh_s_base_type(checked: &ShChecked, original: i64) -> i64 {
    let mut ty = sh_s_resolve(checked, original);
    let mut depth = 0;
    while sh_s_kind(checked, ty) == 6 and depth < 128 { ty = sh_s_resolve(checked, sh_s_argument(checked, ty, 0)); depth = depth + 1; };
    ty;
}

def sh_s_find_field(checked: &ShChecked, owner: i64, symbol: i64) -> i64 {
    let mut current = owner;
    let mut depth = 0;
    while current >= 0 and depth < 128 { let mut field = 0; while field < sh_binding_count(checked) { if sh_binding_word(checked, field, 2) == 6 and sh_binding_word(checked, field, 6) == current and sh_binding_word(checked, field, 0) == symbol { return field; }; field = field + 1; }; current = sh_adt_binding(checked, sh_class_parent(checked, sh_binding_word(checked, current, 3))); depth = depth + 1; };
    -1;
}

def sh_s_field_expr(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64) -> i64 {
    let receiver = sh_ast_child(ast, node, 0);
    let raw = sh_s_expr(checked, text, ast, receiver, -1);
    let ty = sh_s_base_type(checked, raw);
    let member = sh_ast_child(ast, node, 1);
    let name = sh_s_name(text, ast, member);
    if not name.is_ok() { return checked.error_type; };
    if sh_s_kind(checked, ty) == 10 { let index = sh_s_integer_value(text, ast, member); let inner = sh_s_argument(checked, ty, index); if inner < 0 { sh_s_diagnose(checked, ast, member, 5106, 1, -1, -1); return checked.error_type; }; return inner; };
    let owner = sh_adt_binding(checked, ty);
    let symbol = sh_intern(&checked.symbols, &name.value).unwrap_or(-1);
    let field = sh_s_find_field(checked, owner, symbol);
    if owner < 0 or field < 0 { sh_s_diagnose(checked, ast, member, 5106, 1, -1, -1); return checked.error_type; };
    sh_s_bind_node(checked, member, field);
    sh_s_bind_node(checked, node, field);
    sh_resolved_field_type(checked, ty, field);
}

def sh_s_mutable_place(checked: &ShChecked, ast: &ShAst, node: i64) -> bool {
    let kind = sh_ast_word(ast, node, 0);
    if kind == 58 and sh_ast_word(ast, node, 4) == 0 and sh_ast_word(ast, node, 6) == 1 { return sh_s_mutable_place(checked, ast, sh_ast_child(ast, node, 0)); };
    if kind == 12 { let binding = sh_node_binding(checked, node); if binding < 0 { return false; }; return (sh_binding_word(checked, binding, 5) & 1) != 0; };
    if kind == 50 and sh_ast_word(ast, node, 4) % 1000 == sh_kind("*") { let ty = sh_s_resolve(checked, sh_node_type(checked, sh_ast_child(ast, node, 0))); return (sh_s_kind(checked, ty) == 6 or sh_s_kind(checked, ty) == 7) and sh_s_flags(checked, ty) == 1; };
    if kind == 54 or kind == 55 { let base = sh_ast_child(ast, node, 0); let ty = sh_s_resolve(checked, sh_node_type(checked, base)); if sh_s_kind(checked, ty) == 6 { return sh_s_flags(checked, ty) == 1; }; return sh_s_mutable_place(checked, ast, base); };
    false;
}

def sh_s_fresh_place(checked: &ShChecked, ast: &ShAst, node: i64) -> bool {
    let kind = sh_ast_word(ast, node, 0);
    if kind == 58 and sh_ast_word(ast, node, 4) == 0 and sh_ast_word(ast, node, 6) == 1 { return sh_s_fresh_place(checked, ast, sh_ast_child(ast, node, 0)); };
    if kind == 54 or kind == 55 { return sh_s_fresh_place(checked, ast, sh_ast_child(ast, node, 0)); };
    if kind == 12 or kind == 10 or kind == 50 and sh_ast_word(ast, node, 4) % 1000 == sh_kind("*") { return false; };
    let ty = sh_s_resolve(checked, sh_node_type(checked, node));
    sh_s_kind(checked, ty) == 12 or sh_s_kind(checked, ty) == 8 or sh_s_kind(checked, ty) == 10;
}

def sh_s_future_result(checked: &ShChecked, actual: i64) -> i64 {
    let future_symbol = sh_s_named_symbol(checked, "Future");
    let input = sh_s_normalize(checked, actual);
    let mut record = 0;
    while record < checked.constraints.len() { if checked.constraints.get(record + 1).unwrap_or(-1) == future_symbol and checked.constraints.get(record + 2).unwrap_or(-1) == -2 { let target = checked.constraints.get(record).unwrap_or(-1); let keys = vec_new_i64(); let values = vec_new_i64(); if sh_s_pattern_keys(checked, target, input, &keys, &values, 0) { let implementation = checked.constraints.get(record + 3).unwrap_or(-1); let trait_type = sh_s_trait_actual_for(checked, implementation, future_symbol); if sh_s_kind(checked, trait_type) == 14 and sh_s_arity(checked, trait_type) >= 1 { return sh_s_type_replace(checked, sh_s_argument(checked, trait_type, 0), &keys, &values, 0); }; }; }; record = record + 4; };
    -1;
}

def sh_s_escape_kind(checked: &ShChecked, ty: i64, depth: i64) -> i64 {
    if depth > 128 { return 5124; };
    let value = sh_s_resolve(checked, ty);
    let kind = sh_s_kind(checked, value);
    if kind == 16 { return 5124; };
    if kind == 12 { let label = sh_s_symbol_text(checked, sh_s_nominal(checked, value)); if label.is_ok() and sh_s_text_equal(&label.value, "AsyncContext") { return 5120; }; if label.is_ok() and sh_s_text_equal(&label.value, "TaskScope") { return 5124; }; };
    let mut index = 0;
    while index < sh_s_arity(checked, value) { let found = sh_s_escape_kind(checked, sh_s_argument(checked, value, index), depth + 1); if found != 0 { return found; }; index = index + 1; };
    0;
}

def sh_s_direct_task_scope(checked: &ShChecked, text: &String, ast: &ShAst, node: i64) -> bool {
    if node < 0 or sh_ast_word(ast, node, 0) != 53 or sh_ast_word(ast, node, 6) != 1 { return false; };
    let callee = sh_ast_child(ast, node, 0);
    let symbol = sh_s_path_symbol(checked, text, ast, callee);
    symbol == sh_s_named_symbol(checked, "task_scope");
}

def sh_s_type_named(checked: &ShChecked, ty: i64, name: &str) -> bool {
    if sh_s_kind(checked, ty) != 12 { return false; };
    let label = sh_s_symbol_text(checked, sh_s_nominal(checked, ty));
    label.is_ok() and sh_s_text_equal(&label.value, name);
}

def sh_s_contains_future(checked: &ShChecked, ty: i64, depth: i64) -> bool {
    if depth > 128 { return true; };
    let value = sh_s_resolve(checked, ty);
    if sh_s_kind(checked, value) == 16 { return true; };
    let mut index = 0;
    while index < sh_s_arity(checked, value) { if sh_s_contains_future(checked, sh_s_argument(checked, value, index), depth + 1) { return true; }; index = index + 1; };
    false;
}

def sh_s_destructor_field(checked: &ShChecked, ast: &ShAst, receiver: i64) -> bool {
    let implementation = sh_binding_word(checked, checked.current_owner, 6);
    if sh_s_impl_symbol(checked, implementation) != sh_s_named_symbol(checked, "Drop") or sh_ast_word(ast, receiver, 0) != 55 { return false; };
    let mut root = receiver;
    let mut depth = 0;
    while depth < 128 { let kind = sh_ast_word(ast, root, 0); if kind == 55 or kind == 54 or kind == 58 and sh_ast_word(ast, root, 4) == 0 and sh_ast_word(ast, root, 6) == 1 { root = sh_ast_child(ast, root, 0); } else { break; }; depth = depth + 1; };
    let binding = sh_node_binding(checked, root);
    let declaration = sh_binding_word(checked, binding, 4);
    sh_binding_word(checked, binding, 2) == 1 and sh_binding_word(checked, binding, 6) == checked.current_owner and (sh_ast_word(ast, declaration, 4) & 4) != 0;
}

def sh_s_bind_pattern(checked: &mut ShChecked, text: &String, ast: &ShAst, pattern: i64, ty: i64, mutable: bool, declaration: i64) {
    let kind = sh_ast_word(ast, pattern, 0);
    sh_s_set_type(checked, pattern, ty);
    if kind == 10 { let symbol = sh_s_symbol(checked, text, ast, pattern); let binding = sh_s_binding(checked, symbol, checked.current_scope, 0, ty, declaration, if mutable { 1; } else { 0; }, checked.current_owner, 0); sh_s_bind_node(checked, pattern, binding); return; };
    if kind == 81 { let first = sh_binding_count(checked); sh_s_bind_pattern(checked, text, ast, sh_ast_child(ast, pattern, 0), ty, mutable, declaration); let end = sh_binding_count(checked); let seen = vec_new_i64(); sh_s_pattern_alternative(checked, text, ast, sh_ast_child(ast, pattern, 1), ty, &seen); let mut binding = first; while binding < end { if sh_binding_word(checked, binding, 2) == 0 and not seen.contains(binding) { sh_s_diagnose(checked, ast, pattern, 5110, 1, binding, -1); }; binding = binding + 1; }; return; };
    if kind != 80 { sh_s_diagnose(checked, ast, pattern, 5110, 1, -1, -1); return; };
    let payload = sh_ast_word(ast, pattern, 4);
    if payload == 2 or payload == 3 { return; };
    let count = sh_ast_word(ast, pattern, 6);
    if payload == sh_kind("(") or payload == sh_kind("[") { let target = sh_s_resolve(checked, ty); let mut index = 0; while index < count { let inner = if payload == sh_kind("(") { sh_s_argument(checked, target, index); } else { sh_s_argument(checked, target, 0); }; sh_s_bind_pattern(checked, text, ast, sh_ast_child(ast, pattern, index), inner, mutable, declaration); index = index + 1; }; return; };
    let first = sh_ast_child(ast, pattern, 0);
    if sh_ast_word(ast, first, 0) == 11 { let actual = sh_s_literal(checked, text, ast, first, ty); sh_s_expect(checked, ast, first, ty, actual); return; };
    if payload == 0 and sh_ast_word(ast, first, 0) == 12 and sh_ast_word(ast, first, 6) == 1 { let name_node = sh_ast_child(ast, first, 0); let symbol = sh_s_symbol(checked, text, ast, name_node); let binding = sh_s_binding(checked, symbol, checked.current_scope, 0, ty, declaration, if mutable { 1; } else { 0; }, checked.current_owner, 0); sh_s_bind_node(checked, name_node, binding); sh_s_bind_node(checked, first, binding); sh_s_bind_node(checked, pattern, binding); return; };
    let constructor = sh_s_path(checked, text, ast, first);
    let instance = sh_s_instantiate(checked, constructor);
    let result = if sh_s_kind(checked, instance) == 11 { sh_s_argument(checked, instance, sh_s_arity(checked, instance) - 1); } else { instance; };
    sh_s_expect(checked, ast, pattern, ty, result);
    let mut index = 1;
    while index < count { let inner = sh_s_argument(checked, instance, index - 1); sh_s_bind_pattern(checked, text, ast, sh_ast_child(ast, pattern, index), inner, mutable, declaration); index = index + 1; };
    ();
}

def sh_s_struct(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64, expected: i64) -> i64 {
    let path = sh_ast_child(ast, node, 0);
    let declared = sh_s_path(checked, text, ast, path);
    let ty = sh_s_instantiate(checked, declared);
    let owner = sh_adt_binding(checked, ty);
    if owner < 0 { sh_s_diagnose(checked, ast, node, 5106, 1, -1, -1); return checked.error_type; };
    if sh_s_type_named(checked, ty, "AsyncContext") or sh_s_type_named(checked, ty, "TaskScope") { sh_s_diagnose(checked, ast, node, 5120, 1, -1, ty); };
    if expected >= 0 { sh_s_expect(checked, ast, node, expected, ty); (); };
    let seen = vec_new_i64();
    let mut index = 1;
    let mut update = false;
    while index < sh_ast_word(ast, node, 6) { let field_node = sh_ast_child(ast, node, index); if sh_ast_word(ast, field_node, 4) == 1 { let base = sh_s_expr(checked, text, ast, sh_ast_child(ast, field_node, 0), ty); sh_s_expect(checked, ast, field_node, ty, base); update = true; } else { let name_node = sh_ast_child(ast, field_node, 0); let symbol = sh_s_field_symbol(checked, text, ast, name_node); let binding = sh_s_find_field(checked, owner, symbol); if binding < 0 { sh_s_diagnose(checked, ast, name_node, 5106, 1, -1, -1); } else { if seen.contains(binding) { sh_s_diagnose(checked, ast, name_node, 5103, 1, binding, binding); }; seen.push(binding); sh_s_bind_node(checked, field_node, binding); sh_s_bind_node(checked, name_node, binding); let required = sh_resolved_field_type(checked, ty, binding); let mut value = checked.error_type; if sh_ast_word(ast, field_node, 6) > 1 { value = sh_s_expr(checked, text, ast, sh_ast_child(ast, field_node, 1), required); } else { let local = sh_s_lookup(checked, symbol, checked.current_scope, false); if local < 0 { sh_s_diagnose(checked, ast, name_node, 5101, 1, -1, -1); } else { value = sh_binding_word(checked, local, 3); sh_s_bind_node(checked, name_node, local); }; }; let escape = sh_s_escape_kind(checked, value, 0); if escape != 0 { sh_s_diagnose(checked, ast, field_node, escape, 1, -1, value); }; sh_s_expect(checked, ast, field_node, required, value); sh_s_set_type(checked, field_node, required); (); }; }; index = index + 1; };
    if not update { let mut index = 0; let count = sh_layout_field_count(checked, ty); while index < count { let field = sh_layout_field_binding(checked, ty, index); if not seen.contains(field) { sh_s_diagnose(checked, ast, node, 5106, 1, field, -1); }; index = index + 1; }; };
    ty;
}

def sh_s_legacy_handle(checked: &ShChecked, ty: i64) -> bool {
    let label = sh_s_symbol_text(checked, sh_s_nominal(checked, ty));
    if not label.is_ok() { return false; };
    if sh_s_text_equal(&label.value, "Hasher") { return true; };
    let name = label.value.as_str();
    name == "String" or name == "Buffer" or name == "JsonDoc" or name == "ProcessCommand" or name == "ProcessOutput" or name == "ProcessHandle" or name == "TcpStream" or name == "UdpSocket" or name == "HttpClient" or name == "HttpServer" or name == "HttpServerRequest" or name == "WsClient" or name == "TextList" or name == "TextListIter" or name == "StringMapI64" or name == "StringMapBool" or name == "StringMapKeyIter" or name == "StringMapString" or name == "StringMapStringKeyIter" or name == "VecStringIter" or name == "Vec" or name == "VecIter" or name == "HashMap" or name == "HashMapIter";
}

def sh_s_types_compatible(checked: &ShChecked, expected: i64, actual: i64, depth: i64) -> bool {
    if depth > 128 { return false; };
    let left = sh_s_normalize(checked, expected);
    let right = sh_s_normalize(checked, actual);
    if left == right { return true; };
    let a = sh_s_kind(checked, left);
    let b = sh_s_kind(checked, right);
    if a == 19 or b == 19 or a == 18 or b == 18 or a == 17 or b == 17 or a == 15 or b == 15 { return true; };
    if a == 2 and sh_s_data(checked, left) == 64 and sh_s_flags(checked, left) == 1 and b == 11 { return true; };
    if a != b or sh_s_data(checked, left) != sh_s_data(checked, right) or sh_s_nominal(checked, left) != sh_s_nominal(checked, right) or sh_s_arity(checked, left) != sh_s_arity(checked, right) { return false; };
    if sh_s_flags(checked, left) != sh_s_flags(checked, right) and not (a == 6 and sh_s_flags(checked, left) == 0 and sh_s_flags(checked, right) == 1) { return false; };
    let mut index = 0;
    while index < sh_s_arity(checked, left) { if not sh_s_types_compatible(checked, sh_s_argument(checked, left, index), sh_s_argument(checked, right, index), depth + 1) { return false; }; index = index + 1; };
    true;
}

def sh_s_method(checked: &mut ShChecked, text: &String, ast: &ShAst, field: i64, call: i64, expected: i64) -> i64 {
    let receiver = sh_ast_child(ast, field, 0);
    let actual = sh_s_expr(checked, text, ast, receiver, -1);
    let base = sh_s_base_type(checked, actual);
    let nominal = sh_s_nominal(checked, base);
    let member = sh_ast_child(ast, field, 1);
