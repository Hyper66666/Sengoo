def sh_s_builtin_trait(checked: &ShChecked, name: &str) {
    let symbol = sh_s_named_symbol(checked, name);
    let empty = vec_new_i64();
    let ty = sh_s_type(checked, 14, 0, 0, symbol, &empty);
    let binding = sh_s_binding(checked, symbol, 0, 7, ty, -1, 4096, -1, -1);
    let scope = sh_s_scope(checked, 0, binding, 0);
    sh_s_binding_set(checked, binding, 7, scope);
    let self_name = sh_s_named_symbol(checked, "Self");
    let self_args = vec_new_i64();
    let self_type = sh_s_type(checked, 13, scope, 0, self_name, &self_args);
    sh_s_self_alias(checked, scope, binding, self_type);
    if name == "Hash" { let args = vec_new_i64(); args.push(sh_s_unary_type(checked, 6, 0, 0, self_type)); args.push(checked.integer_type); let fn_type = sh_s_type(checked, 11, 0, 0, -1, &args); let method = sh_s_binding(checked, sh_s_named_symbol(checked, "hash"), scope, 2, fn_type, -1, 4096, binding, -1); let method_scope = sh_s_scope(checked, scope, method, 0); sh_s_binding_set(checked, method, 7, method_scope); (); };
    if name == "Iterator" or name == "IntoIterator" { sh_s_binding(checked, sh_s_named_symbol(checked, "Item"), scope, 8, checked.error_type, -1, 4096, binding, scope); if name == "IntoIterator" { sh_s_binding(checked, sh_s_named_symbol(checked, "IntoIter"), scope, 8, checked.error_type, -1, 4096, binding, scope); (); }; };
    ();
}

def sh_s_support_type(checked: &ShChecked, name: &str) {
    let symbol = sh_s_named_symbol(checked, name);
    let ty = sh_s_runtime_adt(checked, name);
    let binding = sh_s_binding(checked, symbol, 0, 3, ty, -1, 4096, -1, -1);
    let scope = sh_s_scope(checked, 0, binding, 0);
    sh_s_binding_set(checked, binding, 7, scope);
    sh_s_self_alias(checked, scope, binding, ty);
    ();
}

def sh_s_builtin_function(checked: &ShChecked, name: &str, code: i64) {
    let symbol = sh_s_named_symbol(checked, name);
    let args = vec_new_i64();
    args.push(checked.unit_type);
    let ty = sh_s_type(checked, 11, 0, 1, -1, &args);
    sh_s_binding(checked, symbol, 0, 13, ty, -1, 4096, -1, code);
    ();
}

def sh_s_builtins(checked: &ShChecked) {
    sh_s_support_type(checked, "Ordering");
    sh_s_support_type(checked, "Formatter");
    sh_s_support_type(checked, "Hasher");
    sh_s_builtin_trait(checked, "Drop");
    sh_s_builtin_trait(checked, "Clone");
