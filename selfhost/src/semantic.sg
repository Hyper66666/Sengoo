    sh_s_builtin_function(checked, "mutex_lock_async", 25);
    sh_s_builtin_function(checked, "raw_channel_send", 26);
    sh_s_builtin_function(checked, "raw_channel_recv", 27);
    sh_s_builtin_function(checked, "raw_rwlock_read_async", 28);
    sh_s_builtin_function(checked, "raw_rwlock_write_async", 29);
    sh_s_builtin_function(checked, "raw_mutex_lock_async", 30);
    sh_s_builtin_function(checked, "HttpServer_next_request_async", 32);
    sh_s_builtin_function(checked, "HttpServer_next_request_router_async", 33);
    sh_s_builtin_function(checked, "sengoo_http_server_next_request_async__start", 34);
    sh_s_builtin_function(checked, "sengoo_http_server_next_request_router_async__start", 35);
    ();
}

def sh_s_ffi_safe(checked: &ShChecked, ty: i64, depth: i64) -> bool {
    if depth > 128 { return false; };
    let resolved = sh_s_resolve(checked, ty);
    let kind = sh_s_kind(checked, resolved);
    if kind == 0 or kind == 1 or kind == 2 or kind == 3 or kind == 4 { return true; };
    if kind == 7 { return sh_s_ffi_safe(checked, sh_s_argument(checked, resolved, 0), depth + 1); };
    kind == 6 and sh_s_flags(checked, resolved) == 0 and sh_s_kind(checked, sh_s_argument(checked, resolved, 0)) == 5;
}

def sh_s_has_pointer(checked: &ShChecked, ty: i64, depth: i64) -> bool {
    if depth > 128 { return true; };
    if sh_s_kind(checked, ty) == 7 { return true; };
    let mut index = 0;
    while index < sh_s_arity(checked, ty) { if sh_s_has_pointer(checked, sh_s_argument(checked, ty, index), depth + 1) { return true; }; index = index + 1; };
    false;
}

def sh_s_impl_symbol(checked: &ShChecked, implementation: i64) -> i64 {
    let mut record = 0;
    while record < checked.constraints.len() { if checked.constraints.get(record + 2).unwrap_or(-1) == -2 and checked.constraints.get(record + 3).unwrap_or(-1) == implementation { return checked.constraints.get(record + 1).unwrap_or(-1); }; record = record + 4; };
    -1;
}

def sh_s_copy_type(checked: &ShChecked, ty: i64, depth: i64) -> bool {
    if depth > 128 { return false; };
    let actual = sh_s_resolve(checked, ty);
    let kind = sh_s_kind(checked, actual);
    if kind == 0 or kind == 1 or kind == 2 or kind == 3 or kind == 4 or kind == 7 or kind == 11 or kind == 18 { return true; };
    if kind == 6 { return sh_s_flags(checked, actual) == 0; };
    if kind == 8 or kind == 10 { let mut index = 0; while index < sh_s_arity(checked, actual) { if not sh_s_copy_type(checked, sh_s_argument(checked, actual, index), depth + 1) { return false; }; index = index + 1; }; return true; };
    sh_s_implements(checked, actual, sh_s_named_symbol(checked, "Copy")) and not sh_s_implements(checked, actual, sh_s_named_symbol(checked, "Drop"));
}

def sh_s_core_contracts(checked: &mut ShChecked, ast: &ShAst) {
    let drop = sh_s_named_symbol(checked, "Drop");
    let copy = sh_s_named_symbol(checked, "Copy");
    let mut implementation = 0;
    while implementation < sh_binding_count(checked) { if sh_binding_word(checked, implementation, 2) == 14 { let trait_symbol = sh_s_impl_symbol(checked, implementation); let target = sh_binding_word(checked, implementation, 3); let declaration = sh_binding_word(checked, implementation, 4); let trait_binding = sh_s_lookup(checked, trait_symbol, 0, true); let label = sh_s_symbol_text(checked, trait_symbol); let negative = (sh_binding_word(checked, implementation, 5) & 8) != 0; if trait_symbol >= 0 { if sh_s_kind(checked, target) != 12 and (sh_binding_word(checked, trait_binding, 5) & 4096) != 0 { sh_s_diagnose(checked, ast, declaration, 5123, 1, -1, target); }; let mut method = 0; let mut items = 0; let mut drops = 0; let mut rendered = false; while method < sh_binding_count(checked) { if sh_binding_word(checked, method, 6) == implementation { let kind = sh_binding_word(checked, method, 2); let method_node = sh_binding_word(checked, method, 4); let name = sh_s_symbol_text(checked, sh_binding_word(checked, method, 0)); if (kind == 2 or kind == 8) and method_node >= 0 { items = items + 1; }; if kind == 2 and name.is_ok() { let fn_type = sh_binding_word(checked, method, 3); if trait_symbol == drop { drops = drops + 1; let param = sh_s_child_kind(ast, method_node, 21); let receiver = sh_s_argument(checked, fn_type, 0); let result = sh_s_argument(checked, fn_type, sh_s_arity(checked, fn_type) - 1); let mut has_return = false; let mut child = 0; while child < sh_ast_word(ast, method_node, 6) { let part = sh_ast_child(ast, method_node, child); let part_kind = sh_ast_word(ast, part, 0); if part_kind >= 70 and part_kind <= 76 { has_return = true; }; child = child + 1; }; if not sh_s_text_equal(&name.value, "drop") or sh_ast_word(ast, param, 4) != 7 or sh_s_arity(checked, fn_type) != 2 or sh_s_kind(checked, receiver) != 6 or sh_s_flags(checked, receiver) != 1 or sh_s_kind(checked, result) != 0 or has_return or (sh_binding_word(checked, method, 5) & 12) != 0 { sh_s_diagnose(checked, ast, method_node, 5123, 1, -1, fn_type); }; if trait_symbol == sh_s_named_symbol(checked, "Future") and sh_s_text_equal(&name.value, "poll") { let poll_name = sh_s_symbol_text(checked, sh_s_nominal(checked, result)); if sh_s_arity(checked, fn_type) < 3 or sh_s_kind(checked, receiver) != 6 or sh_s_flags(checked, receiver) != 1 or not poll_name.is_ok() or not sh_s_text_equal(&poll_name.value, "Poll") { sh_s_diagnose(checked, ast, method_node, 5120, 1, -1, result); }; }; }; if sh_s_text_equal(&name.value, "__derived_debug_marker") and label.is_ok() and sh_s_text_equal(&label.value, "Debug") { rendered = true; }; if sh_s_text_equal(&name.value, "to_string") { let receiver = sh_s_child_kind(ast, method_node, 21); let result = sh_s_argument(checked, fn_type, sh_s_arity(checked, fn_type) - 1); let result_name = sh_s_symbol_text(checked, sh_s_nominal(checked, result)); if (sh_ast_word(ast, receiver, 4) & 4) != 0 and result_name.is_ok() and sh_s_text_equal(&result_name.value, "String") { rendered = true; }; }; }; if kind == 8 and method_node >= 0 { let name = sh_binding_word(checked, method, 0); let member = sh_s_lookup_scope(checked, name, sh_binding_word(checked, trait_binding, 7), true); if member < 0 or sh_binding_word(checked, member, 2) != 8 { sh_s_diagnose(checked, ast, method_node, 5123, 1, -1, name); }; }; }; method = method + 1; }; if negative { if not label.is_ok() or not (sh_s_text_equal(&label.value, "Send") or sh_s_text_equal(&label.value, "Sync")) or items != 0 or sh_s_arity(checked, sh_s_trait_actual(checked, implementation)) != 0 { sh_s_diagnose(checked, ast, declaration, 5123, 1, 0, items); }; } else { if trait_symbol == drop and drops != 1 { sh_s_diagnose(checked, ast, declaration, 5123, 1, 1, drops); }; if trait_symbol == drop or trait_symbol == copy { if sh_s_implements(checked, target, drop) and sh_s_implements(checked, target, copy) { sh_s_diagnose(checked, ast, declaration, 5123, 1, -1, target); }; }; if trait_symbol == copy { let owner = sh_adt_binding(checked, target); let mut field = 0; while field < sh_binding_count(checked) { let field_owner = sh_binding_word(checked, field, 6); if sh_binding_word(checked, field, 2) == 6 and (field_owner == owner or sh_binding_word(checked, field_owner, 2) == 5 and sh_binding_word(checked, field_owner, 6) == owner) { let ty = sh_resolved_field_type(checked, target, field); if not sh_s_copy_type(checked, ty, 0) { sh_s_diagnose(checked, ast, declaration, 5123, 1, -1, ty); }; }; field = field + 1; }; }; if label.is_ok() and (sh_s_text_equal(&label.value, "Display") or sh_s_text_equal(&label.value, "Debug")) and not rendered { sh_s_diagnose(checked, ast, declaration, 5123, 1, -1, target); }; let mut member = 0; while member < sh_binding_count(checked) { if sh_binding_word(checked, member, 2) == 8 and sh_binding_word(checked, member, 6) == trait_binding and sh_binding_word(checked, member, 0) != sh_s_named_symbol(checked, "Self") { let name = sh_binding_word(checked, member, 0); let found = sh_s_lookup_scope(checked, name, sh_binding_word(checked, implementation, 7), true); if found < 0 { sh_s_diagnose(checked, ast, declaration, 5123, 1, name, -1); }; }; member = member + 1; }; }; let mut other = 0; while other < implementation { if sh_binding_word(checked, other, 2) == 14 and sh_s_impl_symbol(checked, other) == trait_symbol { let keys = vec_new_i64(); let values = vec_new_i64(); let other_target = sh_binding_word(checked, other, 3); if sh_s_pattern_keys(checked, other_target, target, &keys, &values, 0) { let other_trait = sh_s_type_replace(checked, sh_s_trait_actual(checked, other), &keys, &values, 0); if other_trait == sh_s_trait_actual(checked, implementation) { sh_s_diagnose(checked, ast, declaration, 5123, 1, other, implementation); }; }; }; other = other + 1; }; }; }; implementation = implementation + 1; };
    ();
}

def sh_s_validate_ffi(checked: &mut ShChecked, text: &String, ast: &ShAst) {
    let mut node = 0;
    while node < sh_ast_count(ast) { if sh_ast_word(ast, node, 0) == 31 { let abi = sh_s_child_kind(ast, node, 11); let token = ShToken { kind: 5, start: sh_ast_word(ast, abi, 2), end: sh_ast_word(ast, abi, 3) }; let label = sh_literal_decode(text, token); if not label.is_ok() or not (sh_s_text_equal(&label.value, "C") or sh_s_text_equal(&label.value, "cdecl") or sh_s_text_equal(&label.value, "system")) { sh_s_diagnose(checked, ast, node, 5122, 1, -1, -1); }; }; node = node + 1; };
    let mut binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 2 and (sh_binding_word(checked, binding, 5) & 8) != 0 { let declaration = sh_binding_word(checked, binding, 4); let fn_type = sh_binding_word(checked, binding, 3); let generic = vec_new_i64(); sh_s_parameter_types(checked, binding, &generic); if generic.len() != 0 { sh_s_diagnose(checked, ast, declaration, 5122, 1, 0, generic.len()); }; let mut index = 0; while index < sh_s_arity(checked, fn_type) { let ty = sh_s_argument(checked, fn_type, index); if not sh_s_ffi_safe(checked, ty, 0) { sh_s_diagnose(checked, ast, declaration, 5122, 1, -1, ty); }; index = index + 1; }; if (sh_binding_word(checked, binding, 5) & 2) == 0 and sh_s_has_pointer(checked, fn_type, 0) { sh_s_diagnose(checked, ast, declaration, 5122, 1, -1, fn_type); }; }; binding = binding + 1; };
    ();
}

def sh_s_contract_literal_equal(checked: &ShChecked, text: &String, ast: &ShAst, left: i64, right: i64) -> bool {
    let kind = sh_ast_word(ast, left, 4);
    if kind != sh_ast_word(ast, right, 4) { return false; };
    if kind == 2 { return sh_s_integer_value(text, ast, left) == sh_s_integer_value(text, ast, right); };
    if kind == sh_kind("true") or kind == sh_kind("false") or kind == sh_kind("null") { return true; };
    let a = sh_s_name(text, ast, left);
    let b = sh_s_name(text, ast, right);
    a.is_ok() and b.is_ok() and sengoo_string_eq(a.value.handle, b.value.handle) != 0;
}

def sh_s_contracts(checked: &mut ShChecked, text: &String, ast: &ShAst, binding: i64, result: i64) {
    let declaration = sh_binding_word(checked, binding, 4);
    let body = sh_s_child_kind(ast, declaration, 40);
    let last = sh_ast_child(ast, body, sh_ast_word(ast, body, 6) - 1);
    let mut returned = sh_ast_child(ast, last, 0);
    if sh_ast_word(ast, returned, 0) == 42 and sh_ast_word(ast, returned, 4) == sh_kind("return") { returned = sh_ast_child(ast, returned, 0); };
    let mut index = 0;
    while index < sh_ast_word(ast, declaration, 6) { let contract = sh_ast_child(ast, declaration, index); let operation = sh_ast_word(ast, contract, 4); if sh_ast_word(ast, contract, 0) == 35 and (operation == sh_kind("requires") or operation == sh_kind("ensures")) { let old_scope = checked.current_scope; checked.current_scope = sh_s_scope(checked, old_scope, binding, 0); if operation == sh_kind("ensures") { sh_s_binding(checked, sh_s_named_symbol(checked, "result"), checked.current_scope, 0, result, contract, 0, binding, 0); (); }; let expression = sh_ast_child(ast, contract, 0); let ty = sh_s_expr(checked, text, ast, expression, checked.bool_type); sh_s_expect(checked, ast, expression, checked.bool_type, ty); sh_s_set_type(checked, contract, checked.bool_type); if operation == sh_kind("ensures") { if sh_ast_word(ast, expression, 0) == 11 and sh_ast_word(ast, expression, 4) == sh_kind("false") { sh_s_diagnose(checked, ast, expression, 5127, 1, -1, -1); }; if sh_ast_word(ast, expression, 0) == 51 and sh_ast_word(ast, returned, 0) == 11 { let comparison = sh_ast_word(ast, expression, 4); let left = sh_ast_child(ast, expression, 0); let right = sh_ast_child(ast, expression, 1); let left_symbol = if sh_ast_word(ast, left, 0) == 12 { sh_s_path_symbol(checked, text, ast, left); } else { -1; }; let right_symbol = if sh_ast_word(ast, right, 0) == 12 { sh_s_path_symbol(checked, text, ast, right); } else { -1; }; let literal = if left_symbol == sh_s_named_symbol(checked, "result") { right; } else { if right_symbol == sh_s_named_symbol(checked, "result") { left; } else { -1; }; }; if sh_ast_word(ast, literal, 0) == 11 and (comparison == sh_kind("==") or comparison == sh_kind("!=")) { let same = sh_s_contract_literal_equal(checked, text, ast, returned, literal); if comparison == sh_kind("==") and not same or comparison == sh_kind("!=") and same { sh_s_diagnose(checked, ast, expression, 5127, 1, -1, -1); }; }; }; }; checked.current_scope = old_scope; }; index = index + 1; };
    ();
}

def sh_s_impl_effects(checked: &ShChecked) -> bool {
    sh_binding_word(checked, sh_binding_word(checked, checked.current_owner, 6), 2) == 14;
}

def sh_s_check_function(checked: &mut ShChecked, text: &String, ast: &ShAst, binding: i64) {
    let declaration = sh_binding_word(checked, binding, 4);
    let body = sh_s_child_kind(ast, declaration, 40);
    if body < 0 { return; };
    let trait_owner = sh_binding_word(checked, binding, 6);
    if sh_binding_word(checked, trait_owner, 2) == 7 { return; };
    let old_scope = checked.current_scope;
    let old_owner = checked.current_owner;
    let old_return = checked.current_return;
    let old_async = checked.async_depth;
    let old_unsafe = checked.unsafe_depth;
    let function_type = sh_binding_word(checked, binding, 3);
    let flags = sh_binding_word(checked, binding, 5);
    let mut result = sh_s_argument(checked, function_type, sh_s_arity(checked, function_type) - 1);
    if (flags & 4) != 0 { result = sh_s_argument(checked, result, 0); };
    checked.current_scope = sh_binding_word(checked, binding, 7);
    checked.current_owner = binding;
    checked.current_return = result;
    sh_s_contracts(checked, text, ast, binding, result);
    let escape = sh_s_escape_kind(checked, result, 0);
    if escape != 0 { sh_s_diagnose(checked, ast, declaration, escape, 1, -1, result); };
    checked.async_depth = if (flags & 4) != 0 { 1; } else { 0; };
    checked.unsafe_depth = if (flags & 2) != 0 { 1; } else { 0; };
    let owner_kind = sh_binding_word(checked, trait_owner, 2);
    let mut has_return_type = false;
    let mut child_at = 0;
    while child_at < sh_ast_word(ast, declaration, 6) { let child = sh_ast_child(ast, declaration, child_at); let kind = sh_ast_word(ast, child, 0); if kind >= 70 and kind <= 76 { has_return_type = true; }; child_at = child_at + 1; };
    let effect_tail = owner_kind == 14 and not has_return_type and sh_s_kind(checked, result) == 0;
    let actual = sh_s_block(checked, text, ast, body, if effect_tail { -2; } else { result; });
    let function_name = sh_s_symbol_text(checked, sh_binding_word(checked, binding, 0));
    let implicit_main = function_name.is_ok() and sh_s_text_equal(&function_name.value, "main") and sh_binding_word(checked, binding, 6) < 0 and sh_s_kind(checked, actual) == 0 and sh_s_kind(checked, result) == 2;
    if not implicit_main and not effect_tail { sh_s_expect(checked, ast, body, result, actual); (); };
    checked.current_scope = old_scope;
    checked.current_owner = old_owner;
    checked.current_return = old_return;
    checked.async_depth = old_async;
    checked.unsafe_depth = old_unsafe;
    ();
}

def sh_check(text: &String, ast: &ShAst, max_diagnostics: i64) -> ShChecked {
    let mut checked = sh_s_new(ast, max_diagnostics);
    if checked.error != 0 { return checked; };
    if ast.root < 0 or sh_ast_word(ast, ast.root, 0) != 1 { checked.error = 5117; return checked; };
    sh_s_builtins(&checked);
    sh_s_collect(&mut checked, text, ast, ast.root, 0, -1, 0);
    sh_s_class_headers(&mut checked, text, ast);
    let mut binding = 0;
    while binding < sh_binding_count(&checked) { let binding_kind = sh_binding_word(&checked, binding, 2); if binding_kind == 14 { sh_s_fill_impl(&mut checked, text, ast, binding); }; binding = binding + 1; };
    binding = 0;
    while binding < sh_binding_count(&checked) { let kind = sh_binding_word(&checked, binding, 2); let declaration = sh_binding_word(&checked, binding, 4); if declaration >= 0 { if kind == 3 or kind == 4 { sh_s_fill_nominal(&mut checked, text, ast, binding); }; if kind == 8 { sh_s_alias(&mut checked, text, ast, binding); (); }; }; binding = binding + 1; };
    binding = 0;
    while binding < sh_binding_count(&checked) { let binding_kind = sh_binding_word(&checked, binding, 2); if binding_kind == 2 { sh_s_fill_function(&mut checked, text, ast, binding); }; binding = binding + 1; };
    let declaration_count = sh_binding_count(&checked);
    binding = 0;
    while binding < declaration_count { let node = sh_binding_word(&checked, binding, 4); if node >= 0 { sh_s_fill_bounds(&mut checked, text, ast, binding); }; binding = binding + 1; };
    sh_s_supertraits(&mut checked, text, ast);
    sh_s_validate_dyn(&mut checked, ast);
    sh_s_future_contracts(&mut checked, text, ast, false);
    sh_s_validate_classes(&mut checked, ast);
    sh_s_operator_contracts(&mut checked, ast);
    sh_s_validate_impls(&mut checked, text, ast);
    sh_s_validate_ffi(&mut checked, text, ast);
    sh_s_core_contracts(&mut checked, ast);
    binding = 0;
    while binding < declaration_count { let kind = sh_binding_word(&checked, binding, 2); if kind == 2 { sh_s_check_function(&mut checked, text, ast, binding); }; if kind == 10 { let node = sh_binding_word(&checked, binding, 4); let old = checked.current_scope; checked.current_scope = sh_binding_word(&checked, binding, 7); let ty = sh_s_type_ast(&mut checked, text, ast, sh_ast_child(ast, node, 1)); let value = sh_s_expr(&mut checked, text, ast, sh_ast_child(ast, node, 2), ty); sh_s_expect(&mut checked, ast, node, ty, value); sh_s_binding_set(&checked, binding, 3, ty); sh_s_set_type(&checked, node, ty); checked.current_scope = old; }; binding = binding + 1; };
    sh_s_deferred_calls(&mut checked, ast);
    sh_s_future_contracts(&mut checked, text, ast, true);
    let empty = vec_new_i64();
    let mut node = 0;
    while node < sh_ast_count(ast) { let original = sh_node_type(&checked, node); if original >= 0 { let resolved = sh_s_type_replace(&checked, original, &empty, &empty, 0); checked.node_types.set(node, resolved); sh_s_type_bounds(&mut checked, ast, node, resolved); (); }; node = node + 1; };
    binding = 0;
    while binding < sh_binding_count(&checked) { let original = sh_binding_word(&checked, binding, 3); if original >= 0 { let resolved = sh_s_type_replace(&checked, original, &empty, &empty, 0); sh_s_binding_set(&checked, binding, 3, resolved); (); }; binding = binding + 1; };
    checked;
}

def sh_s_poll_wakes(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64, context: i64, registered: bool, depth: i64) -> bool {
    if node < 0 { return registered; };
    if depth > 128 { sh_s_diagnose(checked, ast, node, 5117, 1, -1, -1); return registered; };
    let kind = sh_ast_word(ast, node, 0);
    let count = sh_ast_word(ast, node, 6);
    if kind == 67 or kind == 68 and (sh_ast_word(ast, node, 4) == sh_kind("async") or sh_ast_word(ast, node, 4) == sh_kind("parallel")) { return registered; };
    if kind == 61 { let incoming = sh_s_poll_wakes(checked, text, ast, sh_ast_child(ast, node, 0), context, registered, depth + 1); let left = sh_s_poll_wakes(checked, text, ast, sh_ast_child(ast, node, 1), context, incoming, depth + 1); let right = if count > 2 { sh_s_poll_wakes(checked, text, ast, sh_ast_child(ast, node, 2), context, incoming, depth + 1); } else { incoming; }; return left and right; };
    if kind == 62 or kind == 63 or kind == 64 { let mut state = registered; let mut index = 0; while index < count { let updated = sh_s_poll_wakes(checked, text, ast, sh_ast_child(ast, node, index), context, state, depth + 1); if index + 1 < count { state = updated; }; index = index + 1; }; return state; };
    if kind == 65 { let incoming = sh_s_poll_wakes(checked, text, ast, sh_ast_child(ast, node, 0), context, registered, depth + 1); let mut all = count > 1; let mut index = 1; while index < count { let arm = sh_ast_child(ast, node, index); let mut state = incoming; let mut child = 1; while child < sh_ast_word(ast, arm, 6) { state = sh_s_poll_wakes(checked, text, ast, sh_ast_child(ast, arm, child), context, state, depth + 1); child = child + 1; }; all = all and state; index = index + 1; }; return incoming or all; };
    let mut state = registered;
    let mut index = 0;
    while index < count { state = sh_s_poll_wakes(checked, text, ast, sh_ast_child(ast, node, index), context, state, depth + 1); index = index + 1; };
    if kind == 53 { let callee = sh_ast_child(ast, node, 0); if sh_ast_word(ast, callee, 0) == 55 { let receiver = sh_ast_child(ast, callee, 0); let member = sh_ast_child(ast, callee, 1); let name = sh_s_name(text, ast, member); if sh_node_binding(checked, receiver) == context and name.is_ok() and (sh_s_text_equal(&name.value, "wake") or sh_s_text_equal(&name.value, "wake_after")) { return true; }; }; };
    if kind == 60 { let path = sh_ast_child(ast, node, 0); let name = sh_s_path_name(checked, text, ast, path); if name.is_ok() and sh_s_text_equal(&name.value, "Poll") { index = 1; while index < count { let field = sh_ast_child(ast, node, index); let key = sh_ast_child(ast, field, 0); let symbol = sh_s_field_symbol(checked, text, ast, key); let value = sh_ast_child(ast, field, 1); if symbol == sh_s_named_symbol(checked, "is_ready") and sh_ast_word(ast, value, 0) == 11 and sh_ast_word(ast, value, 4) == sh_kind("false") and not state { sh_s_diagnose(checked, ast, node, 5125, 1, -1, -1); }; index = index + 1; }; }; };
    state;
}

def sh_s_future_contracts(checked: &mut ShChecked, text: &String, ast: &ShAst, check_wakes: bool) {
    let future = sh_s_named_symbol(checked, "Future");
    let mut method = 0;
    while method < sh_binding_count(checked) { let implementation = sh_binding_word(checked, method, 6); if sh_binding_word(checked, method, 2) == 2 and sh_binding_word(checked, method, 0) == sh_s_named_symbol(checked, "poll") and sh_s_impl_symbol(checked, implementation) == future { let declaration = sh_binding_word(checked, method, 4); let signature = sh_binding_word(checked, method, 3); let receiver = sh_s_argument(checked, signature, 0); let result = sh_s_argument(checked, signature, sh_s_arity(checked, signature) - 1); let returned = sh_s_symbol_text(checked, sh_s_nominal(checked, result)); let context_type = sh_s_argument(checked, signature, 1); let context_name = sh_s_symbol_text(checked, sh_s_nominal(checked, context_type)); let mut valid = sh_s_arity(checked, signature) == 3 and sh_s_kind(checked, receiver) == 6 and sh_s_flags(checked, receiver) == 1 and returned.is_ok() and sh_s_text_equal(&returned.value, "Poll") and context_name.is_ok() and sh_s_text_equal(&context_name.value, "AsyncContext"); let result_field = sh_layout_field_binding(checked, result, 0); let payload_field = sh_layout_field_binding(checked, result, 1); let payload_type = sh_resolved_field_type(checked, result, payload_field); let actual_result = sh_s_argument(checked, sh_s_trait_actual_for(checked, implementation, future), 0); valid = valid and sh_layout_field_count(checked, result) >= 2 and sh_binding_word(checked, result_field, 0) == sh_s_named_symbol(checked, "is_ready") and sh_binding_word(checked, payload_field, 0) == sh_s_named_symbol(checked, "value") and sh_s_kind(checked, sh_resolved_field_type(checked, result, result_field)) == 1 and sh_s_types_compatible(checked, actual_result, payload_type, 0); if not valid { sh_s_diagnose(checked, ast, declaration, 5120, 1, actual_result, result); }; if check_wakes and valid { let mut context = -1; let mut binding = 0; while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 1 and sh_binding_word(checked, binding, 6) == method and sh_binding_word(checked, binding, 7) == 1 { context = binding; break; }; binding = binding + 1; }; sh_s_poll_wakes(checked, text, ast, sh_s_child_kind(ast, declaration, 40), context, false, 0); (); }; }; method = method + 1; };
    ();
}

def sh_s_operator_contracts(checked: &mut ShChecked, ast: &ShAst) {
    let mut binding = 0;
    while binding < sh_binding_count(checked) { let kind = sh_binding_word(checked, binding, 2); let declaration = sh_binding_word(checked, binding, 4); if kind == 7 or kind == 14 { let name = sh_s_symbol_text(checked, if kind == 7 { sh_binding_word(checked, binding, 0); } else { sh_s_impl_symbol(checked, binding); }); if name.is_ok() { let label = name.value.as_str(); let mut operation = -1; if label == "Add" { operation = sh_kind("+"); }; if label == "Sub" { operation = sh_kind("-"); }; if label == "Mul" { operation = sh_kind("*"); }; if label == "Div" { operation = sh_kind("/"); }; if label == "Rem" { operation = sh_kind("%"); }; if label == "Neg" { operation = sh_kind("-"); }; if operation >= 0 and declaration >= 0 { let unary = label == "Neg"; let arguments = vec_new_i64(); if kind == 7 { sh_s_parameter_types(checked, binding, &arguments); } else { let trait_type = sh_s_trait_actual(checked, binding); let mut index = 0; while index < sh_s_arity(checked, trait_type) { arguments.push(sh_s_argument(checked, trait_type, index)); index = index + 1; }; }; let required_count = if unary { 1; } else { 2; }; if arguments.len() != required_count { sh_s_diagnose(checked, ast, declaration, 5123, 1, required_count, arguments.len()); } else { let method_symbol = sh_s_named_symbol(checked, sh_s_operator_method(operation, unary)); let method = sh_s_lookup_scope(checked, method_symbol, sh_binding_word(checked, binding, 7), false); if method < 0 { if kind == 7 { sh_s_diagnose(checked, ast, declaration, 5123, 1, method_symbol, -1); }; } else { let method_node = sh_binding_word(checked, method, 4); let receiver = sh_s_child_kind(ast, method_node, 21); let signature = sh_binding_word(checked, method, 3); let output = sh_s_argument(checked, signature, sh_s_arity(checked, signature) - 1); if receiver < 0 or (sh_ast_word(ast, receiver, 4) & 4) == 0 or sh_s_arity(checked, signature) != if unary { 2; } else { 3; } or output != arguments.get(required_count - 1).unwrap_or(-1) or not unary and sh_s_argument(checked, signature, 1) != arguments.get(0).unwrap_or(-1) { sh_s_diagnose(checked, ast, method_node, 5123, 1, -1, signature); }; }; }; }; }; }; binding = binding + 1; };
    ();
}

def sh_s_operator_label(operation: i64, unary: bool) -> &str {
    if unary { return "Neg"; };
    if operation == sh_kind("+") { return "Add"; };
    if operation == sh_kind("-") { return "Sub"; };
    if operation == sh_kind("*") { return "Mul"; };
    if operation == sh_kind("/") { return "Div"; };
    "Rem";
}

def sh_s_operator_method(operation: i64, unary: bool) -> &str {
    if unary { return "neg"; };
    if operation == sh_kind("+") { return "add"; };
    if operation == sh_kind("-") { return "sub"; };
    if operation == sh_kind("*") { return "mul"; };
    if operation == sh_kind("/") { return "div"; };
    "rem";
}

def sh_s_operator(checked: &mut ShChecked, ast: &ShAst, node: i64, operation: i64, left: i64, right: i64, unary: bool) -> i64 {
    let trait_symbol = sh_s_named_symbol(checked, sh_s_operator_label(operation, unary));
    let method_symbol = sh_s_named_symbol(checked, sh_s_operator_method(operation, unary));
    let input = sh_s_normalize(checked, left);
    let actual_rhs = if unary { -1; } else { sh_s_normalize(checked, right); };
    let mut selected = -1;
    let mut selected_type = -1;
    let mut output = checked.error_type;
    let mut matches = 0;
    let mut record = 0;
    while record < checked.constraints.len() { if checked.constraints.get(record + 1).unwrap_or(-1) == trait_symbol { let target = checked.constraints.get(record).unwrap_or(-1); let source = checked.constraints.get(record + 2).unwrap_or(-1); let owner = checked.constraints.get(record + 3).unwrap_or(-1); let keys = vec_new_i64(); let values = vec_new_i64(); let applicable = if source >= 0 { target == input; } else { source == -2 and (sh_binding_word(checked, owner, 5) & 8) == 0 and sh_s_pattern_keys(checked, target, input, &keys, &values, 0); }; if applicable { let template = if source >= 0 { sh_node_type(checked, source); } else { sh_s_trait_actual_for(checked, owner, trait_symbol); }; let bound = sh_s_type_replace(checked, template, &keys, &values, 0); let count = sh_s_arity(checked, bound); if count == if unary { 1; } else { 2; } and (unary or sh_s_normalize(checked, sh_s_argument(checked, bound, 0)) == actual_rhs) { let method_owner = if source >= 0 { sh_s_lookup(checked, trait_symbol, 0, true); } else { owner; }; let method = sh_s_lookup_scope(checked, method_symbol, sh_binding_word(checked, method_owner, 7), false); if method >= 0 and sh_binding_word(checked, method, 2) == 2 { let trait_owner = sh_s_lookup(checked, trait_symbol, 0, true); let self_binding = sh_s_lookup_scope(checked, sh_s_named_symbol(checked, "Self"), sh_binding_word(checked, trait_owner, 7), true); if self_binding >= 0 { keys.push(sh_binding_word(checked, self_binding, 3)); values.push(input); (); }; let generic = vec_new_i64(); sh_s_parameter_types(checked, trait_owner, &generic); let mut index = 0; while index < generic.len() { keys.push(generic.get(index).unwrap_or(-1)); values.push(sh_s_argument(checked, bound, index)); index = index + 1; }; selected_type = sh_s_type_replace(checked, sh_binding_word(checked, method, 3), &keys, &values, 0); selected = method; output = sh_s_argument(checked, bound, count - 1); matches = matches + 1; }; }; }; }; record = record + 4; };
    if matches != 1 { sh_s_diagnose(checked, ast, node, 5115, 1, 1, matches); return checked.error_type; };
    sh_s_bind_node(checked, node, selected);
    checked.call_types.set(node, sh_s_normalize(checked, selected_type));
    sh_s_normalize(checked, output);
}

def sh_s_supertrait_nodes(checked: &ShChecked, ast: &ShAst, owner: i64, output: &Vec<i64>) {
    let declaration = sh_binding_word(checked, owner, 4);
    let mut index = 0;
    while index < sh_ast_word(ast, declaration, 6) { let child = sh_ast_child(ast, declaration, index); if sh_ast_word(ast, child, 0) == 70 { output.push(child); (); }; index = index + 1; };
    ();
}

def sh_s_supertraits(checked: &mut ShChecked, text: &String, ast: &ShAst) {
    let mut binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 7 { let parents = vec_new_i64(); sh_s_supertrait_nodes(checked, ast, binding, &parents); let old = checked.current_scope; checked.current_scope = sh_binding_word(checked, binding, 7); let mut index = 0; while index < parents.len() { let node = parents.get(index).unwrap_or(-1); let path = sh_ast_child(ast, node, 0); let symbol = sh_s_symbol(checked, text, ast, sh_ast_child(ast, path, 0)); let parent = sh_s_lookup(checked, symbol, 0, true); if sh_ast_word(ast, path, 6) != 1 or sh_binding_word(checked, parent, 2) != 7 { sh_s_diagnose(checked, ast, node, 5115, 1, 7, parent); } else { sh_s_type_ast(checked, text, ast, node); (); }; index = index + 1; }; checked.current_scope = old; }; binding = binding + 1; };
    binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 7 { let queue = vec_new_i64(); let seen = vec_new_i64(); queue.push(binding); let mut cursor = 0; while cursor < queue.len() { let current = queue.get(cursor).unwrap_or(-1); let parents = vec_new_i64(); sh_s_supertrait_nodes(checked, ast, current, &parents); let mut index = 0; while index < parents.len() { let parent_type = sh_node_type(checked, parents.get(index).unwrap_or(-1)); let parent = sh_s_lookup(checked, sh_s_nominal(checked, parent_type), 0, true); if parent == binding { let declaration = sh_binding_word(checked, binding, 4); sh_s_diagnose(checked, ast, declaration, 5115, 1, -1, parent); } else if parent >= 0 and not seen.contains(parent) { seen.push(parent); queue.push(parent); (); }; index = index + 1; }; cursor = cursor + 1; }; let symbol = sh_binding_word(checked, binding, 0); let mut record = 0; while record < checked.constraints.len() { if checked.constraints.get(record + 1).unwrap_or(-1) == symbol and checked.constraints.get(record + 2).unwrap_or(-1) == -2 { let implementation = checked.constraints.get(record + 3).unwrap_or(-1); if (sh_binding_word(checked, implementation, 5) & 8) == 0 { let actual = checked.constraints.get(record).unwrap_or(-1); let mut index = 0; while index < seen.len() { let parent = seen.get(index).unwrap_or(-1); let wanted = sh_binding_word(checked, parent, 0); if not sh_s_implements(checked, actual, wanted) { let declaration = sh_binding_word(checked, implementation, 4); sh_s_diagnose(checked, ast, declaration, 5115, 1, wanted, actual); }; index = index + 1; }; }; }; record = record + 4; }; }; binding = binding + 1; };
    let mut record = 0;
    while record < checked.constraints.len() { let source = checked.constraints.get(record + 2).unwrap_or(-1); if source >= 0 { let symbol = checked.constraints.get(record + 1).unwrap_or(-1); let owner = sh_s_lookup(checked, symbol, 0, true); let parents = vec_new_i64(); sh_s_supertrait_nodes(checked, ast, owner, &parents); let mut index = 0; while index < parents.len() { let node = parents.get(index).unwrap_or(-1); let ty = sh_node_type(checked, node); let target = checked.constraints.get(record).unwrap_or(-1); let parent_symbol = sh_s_nominal(checked, ty); let record_owner = checked.constraints.get(record + 3).unwrap_or(-1); let mut found = false; let mut probe = 0; while probe < checked.constraints.len() { if checked.constraints.get(probe).unwrap_or(-1) == target and checked.constraints.get(probe + 1).unwrap_or(-1) == parent_symbol and checked.constraints.get(probe + 3).unwrap_or(-1) == record_owner { found = true; }; probe = probe + 4; }; if sh_s_kind(checked, ty) == 14 and not found { checked.constraints.push(target); checked.constraints.push(parent_symbol); checked.constraints.push(node); checked.constraints.push(record_owner); (); }; index = index + 1; }; }; record = record + 4; };
    ();
}

def sh_s_pattern_alternative(checked: &mut ShChecked, text: &String, ast: &ShAst, pattern: i64, ty: i64, seen: &Vec<i64>) {
    let kind = sh_ast_word(ast, pattern, 0);
    let payload = sh_ast_word(ast, pattern, 4);
    let count = sh_ast_word(ast, pattern, 6);
    sh_s_set_type(checked, pattern, ty);
    if kind == 81 { let left = vec_new_i64(); let right = vec_new_i64(); sh_s_pattern_alternative(checked, text, ast, sh_ast_child(ast, pattern, 0), ty, &left); sh_s_pattern_alternative(checked, text, ast, sh_ast_child(ast, pattern, 1), ty, &right); let mut index = 0; while index < left.len() { let item = left.get(index).unwrap_or(-1); if not right.contains(item) { sh_s_diagnose(checked, ast, pattern, 5110, 1, item, -1); }; if sengoo_vec_contains_i64(seen.handle, item) == 0 { seen.push(item); (); }; index = index + 1; }; if left.len() != right.len() { sh_s_diagnose(checked, ast, pattern, 5110, 1, left.len(), right.len()); }; return; };
    let first = if kind == 10 { pattern; } else { sh_ast_child(ast, pattern, 0); };
    if kind == 10 or kind == 80 and payload == 0 and sh_ast_word(ast, first, 0) == 12 and sh_ast_word(ast, first, 6) == 1 { let name = if kind == 10 { pattern; } else { sh_ast_child(ast, first, 0); }; let symbol = sh_s_symbol(checked, text, ast, name); let binding = sh_s_lookup_scope(checked, symbol, checked.current_scope, false); if binding < 0 or sh_binding_word(checked, binding, 2) != 0 { sh_s_diagnose(checked, ast, pattern, 5110, 1, -1, symbol); } else { let wanted = sh_binding_word(checked, binding, 3); if not sh_s_types_compatible(checked, wanted, ty, 0) { sh_s_diagnose(checked, ast, pattern, 5110, 1, wanted, ty); }; sh_s_bind_node(checked, name, binding); sh_s_bind_node(checked, first, binding); sh_s_bind_node(checked, pattern, binding); if sengoo_vec_contains_i64(seen.handle, binding) == 0 { seen.push(binding); (); }; }; return; };
    if kind != 80 { sh_s_diagnose(checked, ast, pattern, 5110, 1, -1, kind); return; };
    if payload == 2 or payload == 3 { return; };
    if payload == sh_kind("(") or payload == sh_kind("[") { let target = sh_s_resolve(checked, ty); let mut index = 0; while index < count { let inner = if payload == sh_kind("(") { sh_s_argument(checked, target, index); } else { sh_s_argument(checked, target, 0); }; sh_s_pattern_alternative(checked, text, ast, sh_ast_child(ast, pattern, index), inner, seen); index = index + 1; }; return; };
    if sh_ast_word(ast, first, 0) == 11 { let actual = sh_s_literal(checked, text, ast, first, ty); sh_s_expect(checked, ast, first, ty, actual); return; };
    let constructor = sh_s_path(checked, text, ast, first);
    let instance = sh_s_instantiate(checked, constructor);
    let result = if sh_s_kind(checked, instance) == 11 { sh_s_argument(checked, instance, sh_s_arity(checked, instance) - 1); } else { instance; };
    sh_s_expect(checked, ast, pattern, ty, result);
    let mut index = 1;
    while index < count { let inner = sh_s_argument(checked, instance, index - 1); sh_s_pattern_alternative(checked, text, ast, sh_ast_child(ast, pattern, index), inner, seen); index = index + 1; };
    ();
}

def sh_s_format_integer(bytes: &Buffer, begin: i64, end: i64) -> i64 {
    let mut index = begin;
    if sh_lex_byte(bytes, index) == 43 { index = index + 1; };
    if index >= end { return -1; };
    let mut value = 0;
    while index < end { let byte = sh_lex_byte(bytes, index); if byte < 48 or byte > 57 or value > (9223372036854775807 - (byte - 48)) / 10 { return -1; }; value = value * 10 + byte - 48; index = index + 1; };
    value;
}

def sh_s_format_position(bytes: &Buffer, begin: i64, end: i64) -> i64 {
    let mut colon = begin;
    while colon < end and sh_lex_byte(bytes, colon) != 58 { colon = colon + 1; };
    let position = if colon == begin { -1; } else { sh_s_format_integer(bytes, begin, colon); };
    if colon != begin and position < 0 { return -2; };
    if colon == end { return position; };
    let spec = colon + 1;
    if spec == end or spec + 1 == end and sh_lex_byte(bytes, spec) == 63 { return position; };
    let mut dot = spec;
    while dot < end and sh_lex_byte(bytes, dot) != 46 { dot = dot + 1; };
    if dot < end and sh_s_format_integer(bytes, dot + 1, end) < 0 { return -2; };
    if dot > spec and (sh_lex_byte(bytes, spec) != 62 or sh_s_format_integer(bytes, spec + 1, dot) < 0) { return -2; };
    position;
}

def sh_s_call_deferred(checked: &mut ShChecked, ast: &ShAst, call: i64, target: i64, keys: &Vec<i64>, values: &Vec<i64>) {
    let count = sh_deferred_type_count(checked);
    let mut index = 0;
    while index < count { if sh_deferred_type_word(checked, index, 0) == target { let expected = sh_s_normalize(checked, sh_s_type_replace(checked, sh_deferred_type_word(checked, index, 1), keys, values, 0)); let actual = sh_s_normalize(checked, sh_s_type_replace(checked, sh_deferred_type_word(checked, index, 2), keys, values, 0)); if not sh_s_unify(checked, expected, actual, 0) { if checked.current_owner >= 0 and (sh_s_pending_projection(checked, expected, 0) or sh_s_pending_projection(checked, actual, 0)) and sh_s_defer_shape(checked, expected, actual, 0) { let stored = sh_s_defer_record(checked, checked.current_owner, expected, actual, call); if not stored { let limit = checked.node_types.len(); sh_s_diagnose(checked, ast, call, 5117, 1, limit, limit); }; (); } else { sh_s_diagnose(checked, ast, call, 5104, 1, expected, actual); }; }; }; index = index + 1; };
    ();
}

def sh_s_deferred_calls(checked: &mut ShChecked, ast: &ShAst) {
    let old_scope = checked.current_scope;
    let old_owner = checked.current_owner;
    let mut previous = -1;
    let mut passes = 0;
    while previous != checked.deferred_types.len() and passes < 128 { previous = checked.deferred_types.len(); let mut node = 0; while node < sh_ast_count(ast) { let kind = sh_ast_word(ast, node, 0); let signature = sh_node_callable_type(checked, node); let target = sh_node_binding(checked, node); if (kind == 53 or kind == 50 or kind == 51) and target >= 0 and sh_s_kind(checked, signature) == 11 { let mut scope = sh_node_scope(checked, node); let mut owner = -1; let mut depth = 0; while scope >= 0 and depth < 128 { let candidate = sh_scope_word(checked, scope, 1); let binding_kind = sh_binding_word(checked, candidate, 2); if binding_kind == 2 or binding_kind == 15 { owner = candidate; break; }; scope = sh_scope_word(checked, scope, 0); depth = depth + 1; }; checked.current_scope = sh_node_scope(checked, node); checked.current_owner = owner; let keys = vec_new_i64(); let values = vec_new_i64(); if sh_s_pattern_keys(checked, sh_binding_word(checked, target, 3), signature, &keys, &values, 0) { sh_s_call_deferred(checked, ast, node, target, &keys, &values); }; }; node = node + 1; }; passes = passes + 1; };
    if passes >= 128 and previous != checked.deferred_types.len() { sh_s_diagnose(checked, ast, ast.root, 5117, 1, 128, passes); };
    checked.current_scope = old_scope;
    checked.current_owner = old_owner;
    ();
}
