import selfhost_semantic_base;

def sh_s_child_kind(ast: &ShAst, node: i64, kind: i64) -> i64 {
    let mut index = 0;
    while index < sh_ast_word(ast, node, 6) { let child = sh_ast_child(ast, node, index); if sh_ast_word(ast, child, 0) == kind { return child; }; index = index + 1; };
    -1;
}

def sh_s_name_child(ast: &ShAst, node: i64) -> i64 {
    sh_s_child_kind(ast, node, 10);
}

def sh_s_text_equal(text: &String, expected: &str) -> bool {
    let value = string_from_str(expected);
    value.is_ok() and sengoo_string_eq(text.handle, value.value.handle) != 0;
}

def sh_s_named_symbol(checked: &ShChecked, value: &str) -> i64 {
    let name = string_from_str(value);
    if not name.is_ok() { return -1; };
    sh_intern(&checked.symbols, &name.value).unwrap_or(-1);
}

def sh_s_field_symbol(checked: &ShChecked, text: &String, ast: &ShAst, node: i64) -> i64 {
    if sh_ast_word(ast, node, 0) == 11 and sh_ast_word(ast, node, 4) == 5 { let token = ShToken { kind: 5, start: sh_ast_word(ast, node, 2), end: sh_ast_word(ast, node, 3) }; let value = sh_literal_decode(text, token); if not value.is_ok() { return -1; }; return sh_intern(&checked.symbols, &value.value).unwrap_or(-1); };
    sh_s_symbol(checked, text, ast, node);
}

def sh_s_builtin_type(checked: &ShChecked, name: &String) -> i64 {
    if sh_s_text_equal(name, "bool") { return checked.bool_type; };
    if sh_s_text_equal(name, "str") { return checked.str_type; };
    if sh_s_text_equal(name, "char") { return checked.char_type; };
    if sh_s_text_equal(name, "isize") { return sh_s_primitive(checked, 2, 64, 3); };
    if sh_s_text_equal(name, "usize") { return sh_s_primitive(checked, 2, 64, 2); };
    if sh_s_text_equal(name, "f32") { return sh_s_primitive(checked, 3, 32, 0); };
    if sh_s_text_equal(name, "f64") { return checked.float_type; };
    let bytes = sh_lex_bytes(name);
    if not bytes.is_ok() { return -1; };
    let first = sh_lex_byte(&bytes.value, 0);
    if first != 105 and first != 117 { return -1; };
    let width = name.get(1, name.len());
    if not width.is_ok() { return -1; };
    let mut bits = 0;
    if sh_s_text_equal(&width.value, "8") { bits = 8; };
    if sh_s_text_equal(&width.value, "16") { bits = 16; };
    if sh_s_text_equal(&width.value, "32") { bits = 32; };
    if sh_s_text_equal(&width.value, "64") { bits = 64; };
    if bits == 0 { return -1; };
    sh_s_primitive(checked, 2, bits, if first == 105 { 1; } else { 0; });
}

def sh_adt_binding(checked: &ShChecked, input_type: i64) -> i64 {
    let ty = sh_s_resolve(checked, input_type);
    if sh_s_kind(checked, ty) != 12 { return -1; };
    let symbol = sh_s_nominal(checked, ty);
    let mut id = sh_binding_count(checked) - 1;
    while id >= 0 { let kind = sh_binding_word(checked, id, 2); if (kind == 3 or kind == 4) and sh_binding_word(checked, id, 0) == symbol { return id; }; id = id - 1; };
    -1;
}

def sh_s_type_replace(checked: &ShChecked, original: i64, source_keys: &Vec<i64>, target_values: &Vec<i64>, depth: i64) -> i64 {
    if depth > 128 { return checked.error_type; };
    let ty = sh_s_resolve(checked, original);
    let mut index = 0;
    while index < source_keys.len() { if sh_s_vector(source_keys, index) == ty { return sh_s_vector(target_values, index); }; index = index + 1; };
    let count = sh_s_arity(checked, ty);
    if count == 0 { return ty; };
    let args = vec_new_i64();
    index = 0;
    while index < count { let inner = sh_s_type_replace(checked, sh_s_argument(checked, ty, index), source_keys, target_values, depth + 1); args.push(inner); index = index + 1; };
    let result = sh_s_type(checked, sh_s_kind(checked, ty), sh_s_data(checked, ty), sh_s_flags(checked, ty), sh_s_nominal(checked, ty), &args);
    if sh_s_kind(checked, result) == 15 { return sh_s_projection_resolve(checked, result); };
    result;
}

def sh_s_projection_resolve(checked: &ShChecked, projection: i64) -> i64 {
    if sh_s_flags(checked, projection) == 1 { return projection; };
    let base = sh_s_argument(checked, projection, 0);
    let resolved = sh_s_resolve(checked, base);
    if sh_s_kind(checked, resolved) == 14 and sh_s_flags(checked, resolved) == 1 { let mut index = 0; while index < sh_s_arity(checked, resolved) { let binding = sh_s_argument(checked, resolved, index); if sh_s_kind(checked, binding) == 15 and sh_s_flags(checked, binding) == 1 and sh_s_nominal(checked, binding) == sh_s_nominal(checked, projection) and sh_s_data(checked, binding) == sh_s_data(checked, projection) { return sh_s_argument(checked, binding, 0); }; index = index + 1; }; return projection; };
    if sh_s_kind(checked, resolved) != 12 { return projection; };
    let trait_name = sh_s_data(checked, projection);
    let item_name = sh_s_nominal(checked, projection);
    let mut record = 0;
    while record < checked.constraints.len() { if checked.constraints.get(record + 2).unwrap_or(-1) == -2 and checked.constraints.get(record + 1).unwrap_or(-1) == trait_name { let target = checked.constraints.get(record).unwrap_or(-1); let owner = checked.constraints.get(record + 3).unwrap_or(-1); if sh_s_nominal(checked, target) == sh_s_nominal(checked, resolved) { let mut binding = 0; while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 8 and sh_binding_word(checked, binding, 6) == owner and sh_binding_word(checked, binding, 0) == item_name { let ty = sh_binding_word(checked, binding, 3); if sh_s_kind(checked, ty) != 19 { let keys = vec_new_i64(); let values = vec_new_i64(); if sh_s_pattern_keys(checked, target, resolved, &keys, &values, 0) { return sh_s_type_replace(checked, ty, &keys, &values, 0); }; }; }; binding = binding + 1; }; }; }; record = record + 4; };
    projection;
}

def sh_s_projection_ast(checked: &mut ShChecked, text: &String, ast: &ShAst, path: i64) -> i64 {
    let count = sh_ast_word(ast, path, 6);
    if count != 2 { return -1; };
    let first = sh_ast_child(ast, path, 0);
    let last = sh_ast_child(ast, path, 1);
    if sh_ast_word(ast, first, 0) != 10 or sh_ast_word(ast, last, 0) != 10 { return -1; };
    let symbol = sh_s_symbol(checked, text, ast, first);
    let item = sh_s_symbol(checked, text, ast, last);
    let binding = sh_s_lookup(checked, symbol, checked.current_scope, true);
    if binding < 0 { return -1; };
    let base = sh_binding_word(checked, binding, 3);
    let mut trait_symbol = -1;
    let mut owner = -1;
    let mut scope = checked.current_scope;
    while scope >= 0 { let candidate = sh_scope_word(checked, scope, 1); if sh_binding_word(checked, candidate, 2) == 7 { trait_symbol = sh_binding_word(checked, candidate, 0); owner = candidate; break; }; scope = sh_scope_word(checked, scope, 0); };
    let mut record = 0;
    while record < checked.constraints.len() { if checked.constraints.get(record).unwrap_or(-1) == base { let bound_trait = checked.constraints.get(record + 1).unwrap_or(-1); let trait_binding = sh_s_lookup(checked, bound_trait, 0, true); if trait_binding >= 0 { trait_symbol = bound_trait; owner = trait_binding; }; }; record = record + 4; };
    if owner < 0 and sh_binding_word(checked, binding, 2) == 9 { let parameter_node = sh_binding_word(checked, binding, 4); if (sh_ast_word(ast, parameter_node, 4) & 1) != 0 { let bound_node = sh_ast_child(ast, parameter_node, 1); let bound = sh_s_type_ast(checked, text, ast, bound_node); if sh_s_kind(checked, bound) == 14 { trait_symbol = sh_s_nominal(checked, bound); owner = sh_s_lookup(checked, trait_symbol, 0, true); }; }; };
    if owner < 0 { return -1; };
    let member = sh_s_lookup_scope(checked, item, sh_binding_word(checked, owner, 7), true);
    if member < 0 or sh_binding_word(checked, member, 2) != 8 { return -1; };
    let args = vec_new_i64();
    args.push(base);
    sh_s_bind_node(checked, path, member);
    let projection = sh_s_type(checked, 15, trait_symbol, 0, item, &args);
    sh_s_projection_resolve(checked, projection);
}

def sh_class_parent(checked: &ShChecked, actual: i64) -> i64 {
    let owner = sh_adt_binding(checked, actual);
    let mut index = 0;
    while index < checked.class_parents.len() { if checked.class_parents.get(index).unwrap_or(-1) == owner { let keys = vec_new_i64(); sh_s_parameter_types(checked, owner, &keys); let values = vec_new_i64(); let mut argument = 0; while argument < sh_s_arity(checked, actual) { values.push(sh_s_argument(checked, actual, argument)); argument = argument + 1; }; return sh_s_type_replace(checked, checked.class_parents.get(index + 1).unwrap_or(-1), &keys, &values, 0); }; index = index + 2; };
    -1;
}

def sh_s_class_ancestor(checked: &ShChecked, actual: i64, ancestor: i64) -> i64 {
    let mut current = actual;
    let mut depth = 0;
    while current >= 0 and depth < 128 { if sh_adt_binding(checked, current) == ancestor { return current; }; current = sh_class_parent(checked, current); depth = depth + 1; };
    -1;
}

def sh_layout_field_count(checked: &ShChecked, actual: i64) -> i64 {
    if sh_s_kind(checked, actual) != 12 or sh_adt_binding(checked, actual) < 0 { return -1; };
    let mut current = actual;
    let mut depth = 0;
    let mut count = 0;
    while current >= 0 and depth < 128 { let owner = sh_adt_binding(checked, current); let mut binding = 0; while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 6 and sh_binding_word(checked, binding, 6) == owner { count = count + 1; }; binding = binding + 1; }; current = sh_class_parent(checked, current); depth = depth + 1; };
    if current >= 0 { return -1; };
    count;
}

def sh_layout_field_binding(checked: &ShChecked, actual: i64, index: i64) -> i64 {
    if index < 0 { return -1; };
    let chain = vec_new_i64();
    let mut current = actual;
    let mut depth = 0;
    while current >= 0 and depth < 128 { chain.push(current); current = sh_class_parent(checked, current); depth = depth + 1; };
    if current >= 0 { return -1; };
    let mut at = chain.len() - 1;
    let mut ordinal = 0;
    while at >= 0 { let owner = sh_adt_binding(checked, chain.get(at).unwrap_or(-1)); let mut binding = 0; while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 6 and sh_binding_word(checked, binding, 6) == owner { if ordinal == index { return binding; }; ordinal = ordinal + 1; }; binding = binding + 1; }; at = at - 1; };
    -1;
}

def sh_resolved_field_type(checked: &ShChecked, adt_type: i64, field: i64) -> i64 {
    let mut actual = adt_type;
    let mut owner = sh_adt_binding(checked, actual);
    let field_owner = sh_binding_word(checked, field, 6);
    let variant_field = sh_binding_word(checked, field_owner, 2) == 5 and sh_binding_word(checked, field_owner, 6) == owner;
    if field_owner != owner and not variant_field { actual = sh_s_class_ancestor(checked, actual, field_owner); owner = sh_adt_binding(checked, actual); };
    if owner < 0 or field_owner != owner and not variant_field or sh_binding_word(checked, field, 2) != 6 { return checked.error_type; };
    let source_keys = vec_new_i64();
    let target_values = vec_new_i64();
    let mut record = 0;
    let mut index = 0;
    while record < checked.generic_parameters.len() { if checked.generic_parameters.get(record).unwrap_or(-1) == owner { source_keys.push(checked.generic_parameters.get(record + 2).unwrap_or(-1)); target_values.push(sh_s_argument(checked, actual, index)); index = index + 1; }; record = record + 3; };
    sh_s_type_replace(checked, sh_binding_word(checked, field, 3), &source_keys, &target_values, 0);
}

def sh_s_path_name(checked: &ShChecked, text: &String, ast: &ShAst, node: i64) -> Result<String, i64> {
    let kind = sh_ast_word(ast, node, 0);
    if kind == 10 { return sh_s_name(text, ast, node); };
    if kind != 12 { return Result { is_ok: false, value: String { handle: 0 }, error: 5101 }; };
    let name = string_new();
    let mut index = 0;
    while index < sh_ast_word(ast, node, 6) { let child = sh_ast_child(ast, node, index); let child_kind = sh_ast_word(ast, child, 0); if child_kind == 10 or child_kind == 12 { let part = sh_s_path_name(checked, text, ast, child)?; if name.len() > 0 { name.push_str("::")?; (); }; string_copy_result(sengoo_string_push_padded_string_status(name.handle, part.handle, 1, 0))?; (); }; index = index + 1; };
    Result { is_ok: true, value: name, error: 0 };
}

def sh_s_path_symbol(checked: &ShChecked, text: &String, ast: &ShAst, node: i64) -> i64 {
    let name = sh_s_path_name(checked, text, ast, node);
    if not name.is_ok() { return -1; };
    sh_intern(&checked.symbols, &name.value).unwrap_or(-1);
}

def sh_s_decl_kind(kind: i64) -> i64 {
    if kind == 20 { return 2; };
    if kind == 22 or kind == 32 { return 3; };
    if kind == 24 { return 4; };
    if kind == 27 { return 7; };
    if kind == 28 { return 8; };
    if kind == 29 { return 10; };
    -1;
}

def sh_s_register(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64, scope: i64, owner: i64, extra_flags: i64) -> i64 {
    let kind = sh_s_decl_kind(sh_ast_word(ast, node, 0));
    let name_node = sh_s_name_child(ast, node);
    if kind < 0 or name_node < 0 { sh_s_diagnose(checked, ast, node, 5116, 1, -1, -1); return -1; };
    let symbol = sh_s_symbol(checked, text, ast, name_node);
    if kind == 7 { let label = sh_s_symbol_text(checked, symbol); if label.is_ok() and (sh_s_text_equal(&label.value, "Drop") or sh_s_text_equal(&label.value, "Copy")) { sh_s_diagnose(checked, ast, node, 5123, 1, -1, -1); }; };
    let previous = sh_s_lookup_scope(checked, symbol, scope, sh_s_type_binding_kind(kind));
    if previous >= 0 and kind != 2 and sh_binding_word(checked, previous, 2) != 13 and (sh_binding_word(checked, previous, 5) & 4096) == 0 { sh_s_diagnose(checked, ast, name_node, 5103, 1, previous, -1); return previous; };
    let flags = sh_ast_word(ast, node, 4) | extra_flags;
    let binding = sh_s_binding(checked, symbol, scope, kind, sh_s_fresh(checked), node, flags, owner, -1);
    if binding < 0 { sh_s_diagnose(checked, ast, node, 5117, 1, -1, -1); return -1; };
    sh_s_bind_node(checked, name_node, binding);
    let local = sh_s_scope(checked, scope, binding, 0);
    sh_s_binding_set(checked, binding, 7, local);
    if kind == 3 or kind == 4 { let args = vec_new_i64(); let ty = sh_s_type(checked, 12, 0, 0, symbol, &args); sh_s_binding_set(checked, binding, 3, ty); sh_s_set_type(checked, node, ty); (); };
    sh_s_generics(checked, text, ast, node, binding, local);
    if kind == 3 or kind == 4 { let args = vec_new_i64(); let mut record = 0; while record < checked.generic_parameters.len() { if checked.generic_parameters.get(record).unwrap_or(-1) == binding { args.push(checked.generic_parameters.get(record + 2).unwrap_or(-1)); (); }; record = record + 3; }; let ty = sh_s_type(checked, 12, 0, 0, symbol, &args); sh_s_binding_set(checked, binding, 3, ty); sh_s_set_type(checked, node, ty); (); };
    binding;
}

def sh_s_generics(checked: &mut ShChecked, text: &String, ast: &ShAst, declaration: i64, owner: i64, scope: i64) {
    let generics = sh_s_child_kind(ast, declaration, 34);
    if generics < 0 { return; };
    let mut index = 0;
    while index < sh_ast_word(ast, generics, 6) { let param = sh_ast_child(ast, generics, index); let name = sh_s_name_child(ast, param); let symbol = sh_s_symbol(checked, text, ast, name); if sh_s_lookup_scope(checked, symbol, scope, true) >= 0 { sh_s_diagnose(checked, ast, name, 5103, 1, -1, -1); } else { let args = vec_new_i64(); let ty = sh_s_type(checked, 13, scope, 0, symbol, &args); let binding = sh_s_binding(checked, symbol, scope, 9, ty, param, sh_ast_word(ast, param, 4), owner, index); sh_s_bind_node(checked, name, binding); sh_s_set_type(checked, param, ty); checked.generic_parameters.push(owner); checked.generic_parameters.push(binding); checked.generic_parameters.push(ty); (); }; index = index + 1; };
    ();
}

def sh_s_parameter_types(checked: &ShChecked, binding: i64, args: &Vec<i64>) {
    let mut record = 0;
    while record < checked.generic_parameters.len() { if checked.generic_parameters.get(record).unwrap_or(-1) == binding { args.push(checked.generic_parameters.get(record + 2).unwrap_or(-1)); (); }; record = record + 3; };
    ();
}

def sh_s_dyn_coercion(checked: &ShChecked, dynamic: i64, actual: i64) -> bool {
    let trait_symbol = sh_s_nominal(checked, dynamic);
    if sh_s_kind(checked, actual) != 12 or not sh_s_implements(checked, actual, trait_symbol) { return false; };
    let mut index = 0;
    while index < sh_s_arity(checked, dynamic) { let binding = sh_s_argument(checked, dynamic, index); let args = vec_new_i64(); args.push(actual); let projection = sh_s_type(checked, 15, trait_symbol, 0, sh_s_nominal(checked, binding), &args); let resolved = sh_s_normalize(checked, projection); if sh_s_kind(checked, resolved) == 15 or not sh_s_unify(checked, sh_s_argument(checked, binding, 0), resolved, 0) { return false; }; index = index + 1; };
    true;
}

def sh_s_dyn_type(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64) -> i64 {
    let count = sh_ast_word(ast, node, 6);
    if count != 1 { sh_s_diagnose(checked, ast, node, 5116, 1, 1, count); return checked.error_type; };
    let bound = sh_ast_child(ast, node, 0);
    let path = sh_ast_child(ast, bound, 0);
    let symbol = sh_s_path_symbol(checked, text, ast, path);
    let owner = sh_s_lookup(checked, symbol, checked.current_scope, true);
    if owner < 0 or sh_binding_word(checked, owner, 2) != 7 { sh_s_diagnose(checked, ast, node, 5102, 1, -1, symbol); return checked.error_type; };
    let entries = vec_new_i64();
    let seen = vec_new_i64();
    let mut index = 1;
    while index < sh_ast_word(ast, bound, 6) { let entry = sh_ast_child(ast, bound, index); if sh_ast_word(ast, entry, 0) != 76 { sh_s_diagnose(checked, ast, entry, 5116, 1, -1, -1); } else { let key_type = sh_ast_child(ast, entry, 0); let key_path = sh_ast_child(ast, key_type, 0); let key = sh_s_path_symbol(checked, text, ast, key_path); let member = sh_s_lookup_scope(checked, key, sh_binding_word(checked, owner, 7), true); if member < 0 or sh_binding_word(checked, member, 2) != 8 or key == sh_s_named_symbol(checked, "Self") or seen.contains(key) { sh_s_diagnose(checked, ast, entry, 5123, 1, -1, key); } else { let fixed = sh_s_type_ast(checked, text, ast, sh_ast_child(ast, entry, 1)); let args = vec_new_i64(); args.push(fixed); let ty = sh_s_type(checked, 15, symbol, 1, key, &args); entries.push(ty); seen.push(key); sh_s_set_type(checked, entry, ty); sh_s_bind_node(checked, key_path, member); (); }; }; index = index + 1; };
    let mut member = 0;
    while member < sh_binding_count(checked) { if sh_binding_word(checked, member, 2) == 8 and sh_binding_word(checked, member, 6) == owner { let key = sh_binding_word(checked, member, 0); if key != sh_s_named_symbol(checked, "Self") and not seen.contains(key) { sh_s_diagnose(checked, ast, node, 5123, 1, key, -1); }; }; member = member + 1; };
    sh_s_bind_node(checked, node, owner);
    sh_s_type(checked, 14, 0, 1, symbol, &entries);
}

def sh_s_contains_self(checked: &ShChecked, ty: i64, self_type: i64, indirect: bool, depth: i64) -> bool {
    if depth > 128 { return true; };
    if ty == self_type { return true; };
    let kind = sh_s_kind(checked, ty);
    if kind == 15 { return false; };
    if indirect and (kind == 6 or kind == 7) { return false; };
    let mut index = 0;
    while index < sh_s_arity(checked, ty) { if sh_s_contains_self(checked, sh_s_argument(checked, ty, index), self_type, indirect, depth + 1) { return true; }; index = index + 1; };
    false;
}

def sh_s_validate_dyn(checked: &mut ShChecked, ast: &ShAst) {
    let mut node = 0;
    while node < sh_ast_count(ast) { let ty = sh_node_type(checked, node); if sh_ast_word(ast, node, 0) == 75 and sh_s_kind(checked, ty) == 14 and sh_s_flags(checked, ty) == 1 { let owner = sh_s_lookup(checked, sh_s_nominal(checked, ty), 0, true); let self_binding = sh_s_lookup_scope(checked, sh_s_named_symbol(checked, "Self"), sh_binding_word(checked, owner, 7), true); let self_type = sh_binding_word(checked, self_binding, 3); let params = vec_new_i64(); sh_s_parameter_types(checked, owner, &params); if params.len() != 0 { sh_s_diagnose(checked, ast, node, 5116, 1, 0, params.len()); }; let mut method = 0; while method < sh_binding_count(checked) { if sh_binding_word(checked, method, 6) == owner { let kind = sh_binding_word(checked, method, 2); if kind == 10 { sh_s_diagnose(checked, ast, node, 5116, 1, -1, method); }; if kind == 2 { let declaration = sh_binding_word(checked, method, 4); let param = sh_s_child_kind(ast, declaration, 21); let generic = vec_new_i64(); sh_s_parameter_types(checked, method, &generic); if declaration >= 0 and (param < 0 or (sh_ast_word(ast, param, 4) & 4) == 0) or generic.len() != 0 { sh_s_diagnose(checked, ast, node, 5116, 1, -1, method); }; let signature = sh_binding_word(checked, method, 3); let mut index = 1; while index < sh_s_arity(checked, signature) { let part = sh_s_argument(checked, signature, index); if sh_s_contains_self(checked, part, self_type, index + 1 == sh_s_arity(checked, signature), 0) { sh_s_diagnose(checked, ast, node, 5116, 1, -1, part); }; index = index + 1; }; }; }; method = method + 1; }; }; node = node + 1; };
    ();
}

def sh_s_type_ast(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64) -> i64 {
    if node < 0 { return checked.unit_type; };
    if checked.depth >= 128 { sh_s_diagnose(checked, ast, node, 5117, 1, -1, -1); return checked.error_type; };
    checked.depth = checked.depth + 1;
    let result = sh_s_type_ast_inner(checked, text, ast, node);
    checked.depth = checked.depth - 1;
    sh_s_set_type(checked, node, result);
}

def sh_s_type_ast_inner(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64) -> i64 {
    let kind = sh_ast_word(ast, node, 0);
    let payload = sh_ast_word(ast, node, 4);
    let count = sh_ast_word(ast, node, 6);
    if kind == 71 { let inner = sh_s_type_ast(checked, text, ast, sh_ast_child(ast, node, 0)); return sh_s_unary_type(checked, if payload % 1000 == sh_kind("&") { 6; } else { 7; }, 0, if payload >= 1000 { 1; } else { 0; }, inner); };
    if kind == 72 { let args = vec_new_i64(); let mut index = 0; while index < count { let ty = sh_s_type_ast(checked, text, ast, sh_ast_child(ast, node, index)); args.push(ty); index = index + 1; }; if count == 0 { return checked.unit_type; }; return sh_s_type(checked, 10, 0, 0, -1, &args); };
