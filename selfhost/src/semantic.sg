    if binding_kind == 8 { let alias = sh_s_alias(checked, text, ast, binding); return sh_s_type_replace(checked, alias, &parameters, &args, 0); };
    if binding_kind != 3 and binding_kind != 4 and binding_kind != 7 { sh_s_diagnose(checked, ast, node, 5102, 1, -1, -1); return checked.error_type; };
