def sh_s_fill_impl(checked: &mut ShChecked, text: &String, ast: &ShAst, binding: i64) {
    let node = sh_binding_word(checked, binding, 4);
    let old_scope = checked.current_scope;
    checked.current_scope = sh_binding_word(checked, binding, 7);
    let types = vec_new_i64();
    let mut index = 0;
    while index < sh_ast_word(ast, node, 6) { let child = sh_ast_child(ast, node, index); let kind = sh_ast_word(ast, child, 0); if kind >= 70 and kind <= 76 { let ty = sh_s_type_ast(checked, text, ast, child); types.push(ty); (); }; index = index + 1; };
    let target = types.get(types.len() - 1).unwrap_or(checked.error_type);
