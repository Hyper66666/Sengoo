    let mut child_at = 1;
    while child_at < sh_ast_word(ast, node, 6) { let child = sh_ast_child(ast, node, child_at); if sh_ast_word(ast, child, 0) == 10 { child_at = child_at + 1; } else { let required = if argument < sh_s_arity(checked, fn_type) - 1 { sh_s_normalize(checked, sh_s_argument(checked, fn_type, argument)); } else { -1; }; let cached_type = sh_node_type(checked, child); let actual = if cached_type >= 0 { sh_s_normalize(checked, cached_type); } else { sh_s_expr(checked, text, ast, child, required); }; if sh_s_contains_future(checked, actual, 0) { sh_s_diagnose(checked, ast, child, 5124, 1, -1, actual); }; if required >= 0 { sh_s_expect(checked, ast, child, required, actual); (); } else { if sh_s_flags(checked, fn_type) == 0 { let required_count = sh_s_arity(checked, fn_type) - 1; sh_s_diagnose(checked, ast, child, 5105, 1, required_count, argument + 1); }; }; argument = argument + 1; child_at = child_at + 1; }; };
    if argument < sh_s_arity(checked, fn_type) - 1 { let required_count = sh_s_arity(checked, fn_type) - 1; sh_s_diagnose(checked, ast, node, 5105, 1, required_count, argument); };
    let call_name = sh_s_name(text, ast, callee);
    if not method and call_name.is_ok() and (sh_s_text_equal(&call_name.value, "spawn_blocking_i64") or sh_s_text_equal(&call_name.value, "spawn_blocking_future_i64") or sh_s_text_equal(&call_name.value, "async::spawn_blocking_i64") or sh_s_text_equal(&call_name.value, "async::spawn_blocking_future_i64")) and sh_ast_word(ast, node, 6) == 2 { let callback = sh_ast_child(ast, node, 1); if sh_ast_word(ast, callback, 0) == 67 { sh_s_send_captures(checked, ast, callback, callback, 0); } else { let visiting = vec_new_i64(); let actual = sh_node_type(checked, callback); if not sh_s_send_type(checked, actual, &visiting, 0) { sh_s_diagnose(checked, ast, callback, 5115, 1, -1, actual); }; }; };
