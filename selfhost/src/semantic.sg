    let decoded = sh_literal_decode(text, token);
    if not decoded.is_ok() { sh_s_diagnose(checked, ast, template, 5121, 1, -1, -1); return checked.error_type; };
    let bytes = sh_lex_bytes(&decoded.value);
    if not bytes.is_ok() { sh_s_diagnose(checked, ast, template, 5117, 1, -1, -1); return checked.error_type; };
    let mut index = 0;
    let mut automatic = 0;
    let mut values = 0;
