def sh_s_explicit_types(checked: &mut ShChecked, text: &String, ast: &ShAst, path: i64, arguments: &Vec<i64>) {
    let mut index = 0;
    while index < sh_ast_word(ast, path, 6) { let child = sh_ast_child(ast, path, index); let kind = sh_ast_word(ast, child, 0); if kind == 12 { sh_s_explicit_types(checked, text, ast, child, arguments); }; if kind >= 70 and kind <= 76 { let ty = sh_s_type_ast(checked, text, ast, child); arguments.push(ty); (); }; index = index + 1; };
