def sh_s_lambda(checked: &mut ShChecked, text: &String, ast: &ShAst, node: i64, expected: i64) -> i64 {
    let old_scope = checked.current_scope;
    let old_owner = checked.current_owner;
    let old_return = checked.current_return;
    let old_loop = checked.loop_depth;
    let label = string_from_str("@closure:");
    if not label.is_ok() { sh_s_diagnose(checked, ast, node, 5117, 1, -1, -1); return checked.error_type; };
    label.value.push_i64(node);
    let symbol = sh_intern(&checked.symbols, &label.value).unwrap_or(-1);
    let binding = sh_s_binding(checked, symbol, old_scope, 15, sh_s_fresh(checked), node, 0, old_owner, -1);
    let scope = sh_s_scope(checked, old_scope, binding, 0);
    sh_s_binding_set(checked, binding, 7, scope);
    sh_s_bind_node(checked, node, binding);
    checked.current_scope = scope;
    checked.current_owner = binding;
    checked.loop_depth = 0;
    let count = sh_ast_word(ast, node, 6);
    let args = vec_new_i64();
    let mut index = 0;
    while index + 1 < count { let name = sh_ast_child(ast, node, index); let name_symbol = sh_s_symbol(checked, text, ast, name); let mut ty = if sh_s_kind(checked, expected) == 11 { sh_s_argument(checked, expected, args.len()); } else { sh_s_fresh(checked); }; if index + 2 < count and sh_ast_word(ast, sh_ast_child(ast, node, index + 1), 0) >= 70 and sh_ast_word(ast, sh_ast_child(ast, node, index + 1), 0) <= 76 { index = index + 1; ty = sh_s_type_ast(checked, text, ast, sh_ast_child(ast, node, index)); }; if sh_s_lookup_scope(checked, name_symbol, scope, false) >= 0 { sh_s_diagnose(checked, ast, name, 5103, 1, -1, -1); }; let parameter = sh_s_binding(checked, name_symbol, scope, 1, ty, name, 0, binding, args.len()); sh_s_bind_node(checked, name, parameter); sh_s_set_type(checked, name, ty); args.push(ty); index = index + 1; };
    let required = if sh_s_kind(checked, expected) == 11 { sh_s_argument(checked, expected, sh_s_arity(checked, expected) - 1); } else { sh_s_fresh(checked); };
    checked.current_return = required;
    let body = sh_ast_child(ast, node, count - 1);
