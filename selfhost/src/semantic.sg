def sh_s_fill_function(checked: &mut ShChecked, text: &String, ast: &ShAst, binding: i64) {
    let node = sh_binding_word(checked, binding, 4);
    if node < 0 { return; };
    let scope = sh_binding_word(checked, binding, 7);
    let owner = sh_binding_word(checked, binding, 6);
    let old = checked.current_scope;
    checked.current_scope = scope;
    let args = vec_new_i64();
    let mut index = 0;
    let mut ordinal = 0;
    let mut result = checked.unit_type;
    while index < sh_ast_word(ast, node, 6) { let child = sh_ast_child(ast, node, index); let kind = sh_ast_word(ast, child, 0); if kind == 21 { let name = sh_s_name_child(ast, child); let symbol = sh_s_symbol(checked, text, ast, name); let mut param_ty = -1; let mut at = 0; while at < sh_ast_word(ast, child, 6) { let ty_node = sh_ast_child(ast, child, at); let ty_kind = sh_ast_word(ast, ty_node, 0); if ty_kind >= 70 and ty_kind <= 76 { param_ty = sh_s_type_ast(checked, text, ast, ty_node); break; }; at = at + 1; }; if param_ty < 0 { let self_name = sh_s_named_symbol(checked, "Self"); let self_binding = sh_s_lookup(checked, self_name, scope, true); if self_binding >= 0 { param_ty = sh_binding_word(checked, self_binding, 3); } else { param_ty = checked.error_type; sh_s_diagnose(checked, ast, child, 5102, 1, -1, -1); }; let flags = sh_ast_word(ast, child, 4); if (flags & 1) != 0 { param_ty = sh_s_unary_type(checked, 6, 0, if (flags & 2) != 0 { 1; } else { 0; }, param_ty); }; }; if sh_s_lookup_scope(checked, symbol, scope, false) >= 0 { sh_s_diagnose(checked, ast, name, 5103, 1, -1, -1); }; let param = sh_s_binding(checked, symbol, scope, 1, param_ty, child, if (sh_ast_word(ast, child, 4) & 2) != 0 { 1; } else { 0; }, binding, ordinal); sh_s_bind_node(checked, name, param); sh_s_set_type(checked, child, param_ty); args.push(param_ty); ordinal = ordinal + 1; }; if kind >= 70 and kind <= 76 { result = sh_s_type_ast(checked, text, ast, child); }; index = index + 1; };
