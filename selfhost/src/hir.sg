    index = 0;
    while reader.error == 0 and index < owned_diagnostics_count { let code = sh_hir_take(&mut reader); let severity = sh_hir_take(&mut reader); let node = sh_hir_take(&mut reader); let start = sh_hir_take(&mut reader); let end = sh_hir_take(&mut reader); let expected = sh_hir_take(&mut reader); let actual = sh_hir_take(&mut reader); let item = ShDiagnostic { code: code, severity: severity, node: node, start: start, end: end, expected: expected, actual: actual }; if not owned_diagnostics.push(item) { reader.error = 5501; }; index = index + 1; };
