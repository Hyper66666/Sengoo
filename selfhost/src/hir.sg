    let checked = ShChecked { types: ShTypes { words: types_words, arguments: types_arguments, limit: types_limit }, symbols: symbols, node_types: node_types, resolution: resolution, call_types: call_types, deferred_types: deferred_types, builtin_calls: builtin_calls, node_scopes: node_scopes, bindings: bindings, scopes: scopes, diagnostics: diagnostics, substitutions: substitutions, generic_parameters: generic_parameters, constraints: constraints, trait_types: trait_types, class_parents: class_parents, propagation: propagation, loop_values: loop_values, async_depth: c_async_depth, unsafe_depth: c_unsafe_depth, error: c_error, start: c_start, end: c_end, diagnostic_limit: c_diagnostic_limit, current_scope: c_current_scope, current_owner: c_current_owner, current_return: c_current_return, loop_depth: c_loop_depth, depth: c_depth, unit_type: c_unit_type, bool_type: c_bool_type, integer_type: c_integer_type, float_type: c_float_type, char_type: c_char_type, str_type: c_str_type, never_type: c_never_type, error_type: c_error_type };
    let ownership = ShOwnership { diagnostics: owned_diagnostics, actions: owned_actions, action_paths: owned_action_paths, paths: owned_paths, state: owned_state, loans: owned_loans, loan_parents: owned_loan_parents, access_mode: owned_access_mode, last_uses: owned_last_uses, loops: owned_loops, definitions: owned_definitions, contracts: owned_contracts, projection_context: owned_projection_context, try_scopes: owned_try_scopes, error: owned_error, start: owned_start, end: owned_end, limit: owned_limit, function: owned_function, scope: owned_scope, flow: owned_flow, depth: owned_depth };
    let mut hir = ShHir { schema: schema, target: target, runtime_abi: abi, pointer_width: pointer, limit: limit, source: source, ast: ShAst { words: ast_words, edges: ast_edges, root: root }, checked: checked, ownership: ownership, origins: origins, error: if reader.error != 0 { reader.error; } else { hir_error; }, start: hir_start, end: hir_end };
    if hir.error == 0 { hir.error = sh_hir_validate(&hir); };
