    while reader.error == 0 and index < count { let value = sh_hir_take(reader); if value < 0 or value > 1114111 or value >= 55296 and value <= 57343 or not sh_lex_scalar(&output, value) { reader.error = 5507; }; index = index + 1; };
    if output.len() != bytes { reader.error = 5507; };
    output;
}

def sh_hir_empty_checked(limit: i64) -> ShChecked {
    let diagnostics: Vec<ShDiagnostic> = vec_new();
    ShChecked { types: sh_types_new(limit), symbols: sh_symbols_new(limit), node_types: vec_new_i64(), resolution: vec_new_i64(), call_types: vec_new_i64(), deferred_types: vec_new_i64(), builtin_calls: vec_new_i64(), node_scopes: vec_new_i64(), bindings: vec_new_i64(), scopes: vec_new_i64(), diagnostics: diagnostics, substitutions: vec_new_i64(), generic_parameters: vec_new_i64(), constraints: vec_new_i64(), trait_types: vec_new_i64(), class_parents: vec_new_i64(), propagation: vec_new_i64(), loop_values: vec_new_i64(), async_depth: 0, unsafe_depth: 0, error: 0, start: 0, end: 0, diagnostic_limit: limit, current_scope: 0, current_owner: -1, current_return: -1, loop_depth: 0, depth: 0, unit_type: -1, bool_type: -1, integer_type: -1, float_type: -1, char_type: -1, str_type: -1, never_type: -1, error_type: -1 };
}

def sh_hir_snapshot_checked(input: &ShChecked, limit: i64, error: &mut i64) -> ShChecked {
    let symbols = sh_symbols_new(limit);
    let mut index = 0;
    while index < sh_symbol_count(&input.symbols) { let name = sh_symbol_text(&input.symbols, index); if not name.is_ok() { *error = 5504; break; }; let stored = sh_intern(&symbols, &name.value); if not stored.is_ok() or stored.value != index { *error = 5504; break; }; index = index + 1; };
    ShChecked { types: ShTypes { words: sh_hir_words(&input.types.words, limit * 8, error), arguments: sh_hir_words(&input.types.arguments, limit * 8, error), limit: limit }, symbols: symbols, node_types: sh_hir_words(&input.node_types, limit * 8, error), resolution: sh_hir_words(&input.resolution, limit * 8, error), call_types: sh_hir_words(&input.call_types, limit * 8, error), deferred_types: sh_hir_words(&input.deferred_types, limit * 8, error), builtin_calls: sh_hir_words(&input.builtin_calls, limit * 8, error), node_scopes: sh_hir_words(&input.node_scopes, limit * 8, error), bindings: sh_hir_words(&input.bindings, limit * 8, error), scopes: sh_hir_words(&input.scopes, limit * 8, error), diagnostics: sh_hir_diagnostics(&input.diagnostics, limit, error), substitutions: sh_hir_words(&input.substitutions, limit * 8, error), generic_parameters: sh_hir_words(&input.generic_parameters, limit * 8, error), constraints: sh_hir_words(&input.constraints, limit * 8, error), trait_types: sh_hir_words(&input.trait_types, limit * 8, error), class_parents: sh_hir_words(&input.class_parents, limit * 8, error), propagation: sh_hir_words(&input.propagation, limit * 8, error), loop_values: sh_hir_words(&input.loop_values, limit * 8, error), async_depth: input.async_depth, unsafe_depth: input.unsafe_depth, error: input.error, start: input.start, end: input.end, diagnostic_limit: input.diagnostic_limit, current_scope: input.current_scope, current_owner: input.current_owner, current_return: input.current_return, loop_depth: input.loop_depth, depth: input.depth, unit_type: input.unit_type, bool_type: input.bool_type, integer_type: input.integer_type, float_type: input.float_type, char_type: input.char_type, str_type: input.str_type, never_type: input.never_type, error_type: input.error_type };
}

def sh_hir_empty_ownership(limit: i64) -> ShOwnership {
    sh_ownership_from_facts(vec_new_i64(), vec_new_i64(), vec_new_i64(), if limit > 0 { limit; } else { 1; });
}

def sh_hir_empty(limit: i64) -> ShHir {
    ShHir { schema: 5, target: 1, runtime_abi: 1, pointer_width: 64, limit: limit, source: string_new(), ast: ShAst { words: vec_new_i64(), edges: vec_new_i64(), root: -1 }, checked: sh_hir_empty_checked(limit), ownership: sh_hir_empty_ownership(limit), error: 0, start: 0, end: 0 };
}

def sh_hir_lift(text: &String, ast: &ShAst, checked: &ShChecked, limit: i64) -> ShHir {
    if limit < 0 or limit > 100000 { let mut failed = sh_hir_empty(0); failed.error = 5501; return failed; };
    if checked.error != 0 { let mut failed = sh_hir_empty(limit); failed.error = checked.error; failed.start = checked.start; failed.end = checked.end; return failed; };
    let mut error = 0;
    let source = text.clone();
    if not source.is_ok() { let mut failed = sh_hir_empty(limit); failed.error = 5501; return failed; };
    let ownership = sh_check_ownership(text, ast, checked, 100);
    let snapshot = sh_hir_snapshot_checked(checked, limit, &mut error);
    let ast_words = sh_hir_words(&ast.words, limit * 8, &mut error);
    let ast_edges = sh_hir_words(&ast.edges, limit * 8, &mut error);
    let mut hir = ShHir { schema: 5, target: 1, runtime_abi: 1, pointer_width: 64, limit: limit, source: source.value, ast: ShAst { words: ast_words, edges: ast_edges, root: ast.root }, checked: snapshot, ownership: ownership, error: error, start: 0, end: 0 };
    if checked.error != 0 { hir.error = checked.error; hir.start = checked.start; hir.end = checked.end; } else { if hir.ownership.error != 0 { hir.error = hir.ownership.error; hir.start = hir.ownership.start; hir.end = hir.ownership.end; } else { if hir.error == 0 { hir.error = sh_hir_validate(&hir); }; }; };
    hir;
}

def sh_hir_encode(hir: &ShHir, maximum: i64) -> ShHirImage {
    let mut output = ShHirImage { words: vec_new_i64(), error: sh_hir_validate(hir) };
    if maximum < 0 or maximum > 4000000 { output.error = 5501; };
    if output.error != 0 { return output; };
    sh_hir_put(&mut output, 1397180489, maximum);
    sh_hir_put(&mut output, 5, maximum);
    sh_hir_put(&mut output, 1, maximum);
    sh_hir_put(&mut output, 1, maximum);
    sh_hir_put(&mut output, 64, maximum);
    sh_hir_put(&mut output, hir.limit, maximum);
    sh_hir_put(&mut output, hir.ast.root, maximum);
    sh_hir_put_text(&mut output, &hir.source, maximum);
    sh_hir_put_vector(&mut output, &hir.ast.words, maximum);
    sh_hir_put_vector(&mut output, &hir.ast.edges, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.types.words, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.types.arguments, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.node_types, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.resolution, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.call_types, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.deferred_types, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.builtin_calls, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.node_scopes, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.bindings, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.scopes, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.substitutions, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.generic_parameters, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.constraints, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.trait_types, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.class_parents, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.propagation, maximum);
    sh_hir_put_vector(&mut output, &hir.checked.loop_values, maximum);
    sh_hir_put(&mut output, sh_symbol_count(&hir.checked.symbols), maximum);
    let mut index = 0;
    while output.error == 0 and index < sh_symbol_count(&hir.checked.symbols) { let name = sh_symbol_text(&hir.checked.symbols, index); if not name.is_ok() { output.error = 5504; break; }; sh_hir_put_text(&mut output, &name.value, maximum); index = index + 1; };
    sh_hir_put(&mut output, hir.checked.async_depth, maximum);
    sh_hir_put(&mut output, hir.checked.unsafe_depth, maximum);
    sh_hir_put(&mut output, hir.checked.error, maximum);
    sh_hir_put(&mut output, hir.checked.start, maximum);
    sh_hir_put(&mut output, hir.checked.end, maximum);
    sh_hir_put(&mut output, hir.checked.diagnostic_limit, maximum);
    sh_hir_put(&mut output, hir.checked.current_scope, maximum);
    sh_hir_put(&mut output, hir.checked.current_owner, maximum);
    sh_hir_put(&mut output, hir.checked.current_return, maximum);
    sh_hir_put(&mut output, hir.checked.loop_depth, maximum);
    sh_hir_put(&mut output, hir.checked.depth, maximum);
    sh_hir_put(&mut output, hir.checked.unit_type, maximum);
    sh_hir_put(&mut output, hir.checked.bool_type, maximum);
    sh_hir_put(&mut output, hir.checked.integer_type, maximum);
    sh_hir_put(&mut output, hir.checked.float_type, maximum);
    sh_hir_put(&mut output, hir.checked.char_type, maximum);
    sh_hir_put(&mut output, hir.checked.str_type, maximum);
    sh_hir_put(&mut output, hir.checked.never_type, maximum);
    sh_hir_put(&mut output, hir.checked.error_type, maximum);
    sh_hir_put(&mut output, hir.checked.diagnostics.len(), maximum);
    index = 0;
    while output.error == 0 and index < hir.checked.diagnostics.len() { let diagnostic = hir.checked.diagnostics.get(index); sh_hir_put(&mut output, diagnostic.code, maximum); sh_hir_put(&mut output, diagnostic.severity, maximum); sh_hir_put(&mut output, diagnostic.node, maximum); sh_hir_put(&mut output, diagnostic.start, maximum); sh_hir_put(&mut output, diagnostic.end, maximum); sh_hir_put(&mut output, diagnostic.expected, maximum); sh_hir_put(&mut output, diagnostic.actual, maximum); index = index + 1; };
    sh_hir_put_vector(&mut output, &hir.ownership.actions, maximum);
    sh_hir_put_vector(&mut output, &hir.ownership.action_paths, maximum);
    sh_hir_put_vector(&mut output, &hir.ownership.paths, maximum);
    output;
}

def sh_hir_decode(words: &Vec<i64>, maximum: i64) -> ShHir {
    if maximum < 0 or maximum > 4000000 { let mut failed = sh_hir_empty(0); failed.error = 5501; return failed; };
    let mut error = 0;
    let copied = sh_hir_words(words, maximum, &mut error);
    let mut reader = ShHirReader { words: copied, position: 0, maximum: maximum, error: error };
    let magic = sh_hir_take(&mut reader);
    let schema = sh_hir_take(&mut reader);
    let target = sh_hir_take(&mut reader);
    let abi = sh_hir_take(&mut reader);
    let pointer = sh_hir_take(&mut reader);
    let limit = sh_hir_take(&mut reader);
    let root = sh_hir_take(&mut reader);
    if magic != 1397180489 or schema != 5 or target != 1 or abi != 1 or pointer != 64 or limit < 0 or limit > 100000 or maximum < 0 or maximum > 4000000 { reader.error = 5502; };
    if reader.error != 0 { let mut failed = sh_hir_empty(0); failed.error = reader.error; return failed; };
    let source = sh_hir_take_text(&mut reader, limit * 128);
    let ast_words = sh_hir_take_vector(&mut reader, limit * 8);
    let ast_edges = sh_hir_take_vector(&mut reader, limit * 8);
    let types_words = sh_hir_take_vector(&mut reader, limit * 8);
    let types_arguments = sh_hir_take_vector(&mut reader, limit * 8);
    let node_types = sh_hir_take_vector(&mut reader, limit * 8);
    let resolution = sh_hir_take_vector(&mut reader, limit * 8);
    let call_types = sh_hir_take_vector(&mut reader, limit * 8);
    let deferred_types = sh_hir_take_vector(&mut reader, limit * 8);
    let builtin_calls = sh_hir_take_vector(&mut reader, limit * 8);
    let node_scopes = sh_hir_take_vector(&mut reader, limit * 8);
    let bindings = sh_hir_take_vector(&mut reader, limit * 8);
    let scopes = sh_hir_take_vector(&mut reader, limit * 8);
    let substitutions = sh_hir_take_vector(&mut reader, limit * 8);
    let generic_parameters = sh_hir_take_vector(&mut reader, limit * 8);
    let constraints = sh_hir_take_vector(&mut reader, limit * 8);
    let trait_types = sh_hir_take_vector(&mut reader, limit * 8);
    let class_parents = sh_hir_take_vector(&mut reader, limit * 8);
    let propagation = sh_hir_take_vector(&mut reader, limit * 8);
    let loop_values = sh_hir_take_vector(&mut reader, limit * 8);
    let symbols = sh_symbols_new(limit);
    let names = sh_hir_take(&mut reader);
    let mut index = 0;
    if names < 0 or names > limit { reader.error = 5501; };
    while reader.error == 0 and index < names { let name = sh_hir_take_text(&mut reader, limit * 128); let stored = sh_intern(&symbols, &name); if not stored.is_ok() or stored.value != index { reader.error = 5504; }; index = index + 1; };
    let c_async_depth = sh_hir_take(&mut reader);
    let c_unsafe_depth = sh_hir_take(&mut reader);
    let c_error = sh_hir_take(&mut reader);
    let c_start = sh_hir_take(&mut reader);
    let c_end = sh_hir_take(&mut reader);
    let c_diagnostic_limit = sh_hir_take(&mut reader);
    let c_current_scope = sh_hir_take(&mut reader);
    let c_current_owner = sh_hir_take(&mut reader);
    let c_current_return = sh_hir_take(&mut reader);
    let c_loop_depth = sh_hir_take(&mut reader);
    let c_depth = sh_hir_take(&mut reader);
    let c_unit_type = sh_hir_take(&mut reader);
    let c_bool_type = sh_hir_take(&mut reader);
    let c_integer_type = sh_hir_take(&mut reader);
    let c_float_type = sh_hir_take(&mut reader);
    let c_char_type = sh_hir_take(&mut reader);
    let c_str_type = sh_hir_take(&mut reader);
    let c_never_type = sh_hir_take(&mut reader);
    let c_error_type = sh_hir_take(&mut reader);
    let diagnostics: Vec<ShDiagnostic> = vec_new();
    let diagnostic_count = sh_hir_take(&mut reader);
    if diagnostic_count < 0 or diagnostic_count > limit { reader.error = 5501; };
    index = 0;
    while reader.error == 0 and index < diagnostic_count { let c_d_code = sh_hir_take(&mut reader); let c_d_severity = sh_hir_take(&mut reader); let c_d_node = sh_hir_take(&mut reader); let c_d_start = sh_hir_take(&mut reader); let c_d_end = sh_hir_take(&mut reader); let c_d_expected = sh_hir_take(&mut reader); let c_d_actual = sh_hir_take(&mut reader); let diagnostic = ShDiagnostic { code: c_d_code, severity: c_d_severity, node: c_d_node, start: c_d_start, end: c_d_end, expected: c_d_expected, actual: c_d_actual }; if not diagnostics.push(diagnostic) { reader.error = 5501; }; index = index + 1; };
    let ownership_actions = sh_hir_take_vector(&mut reader, limit * 8);
    let ownership_action_paths = sh_hir_take_vector(&mut reader, limit * 8);
    let ownership_paths = sh_hir_take_vector(&mut reader, limit * 8);
    if reader.position != reader.words.len() { reader.error = 5502; };
    let checked = ShChecked { types: ShTypes { words: types_words, arguments: types_arguments, limit: limit }, symbols: symbols, node_types: node_types, resolution: resolution, call_types: call_types, deferred_types: deferred_types, builtin_calls: builtin_calls, node_scopes: node_scopes, bindings: bindings, scopes: scopes, diagnostics: diagnostics, substitutions: substitutions, generic_parameters: generic_parameters, constraints: constraints, trait_types: trait_types, class_parents: class_parents, propagation: propagation, loop_values: loop_values, async_depth: c_async_depth, unsafe_depth: c_unsafe_depth, error: c_error, start: c_start, end: c_end, diagnostic_limit: c_diagnostic_limit, current_scope: c_current_scope, current_owner: c_current_owner, current_return: c_current_return, loop_depth: c_loop_depth, depth: c_depth, unit_type: c_unit_type, bool_type: c_bool_type, integer_type: c_integer_type, float_type: c_float_type, char_type: c_char_type, str_type: c_str_type, never_type: c_never_type, error_type: c_error_type };
    let ownership = sh_ownership_from_facts(ownership_actions, ownership_action_paths, ownership_paths, if limit > 0 { limit; } else { 1; });
    let mut hir = ShHir { schema: schema, target: target, runtime_abi: abi, pointer_width: pointer, limit: limit, source: source, ast: ShAst { words: ast_words, edges: ast_edges, root: root }, checked: checked, ownership: ownership, error: reader.error, start: 0, end: 0 };
    if hir.error == 0 { hir.error = sh_hir_validate(&hir); };
    hir;
}
