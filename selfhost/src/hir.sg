    sh_hir_put_vector(&mut output, &hir.ownership.try_scopes, maximum);
    sh_hir_put(&mut output, hir.ownership.error, maximum);
    sh_hir_put(&mut output, hir.ownership.start, maximum);
    sh_hir_put(&mut output, hir.ownership.end, maximum);
    sh_hir_put(&mut output, hir.ownership.limit, maximum);
    sh_hir_put(&mut output, hir.ownership.function, maximum);
    sh_hir_put(&mut output, hir.ownership.scope, maximum);
    sh_hir_put(&mut output, hir.ownership.flow, maximum);
    sh_hir_put(&mut output, hir.ownership.depth, maximum);
    let origin_image = sh_hir_origins_encode(&hir.origins, maximum);
    if origin_image.error != 0 { output.error = origin_image.error; return output; };
    sh_hir_put_vector(&mut output, &origin_image.words, maximum);
    output;
}

def sh_hir_decode(words: &Vec<i64>, maximum: i64) -> ShHir {
