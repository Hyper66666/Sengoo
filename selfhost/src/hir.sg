import selfhost_borrow;

struct ShHir {
    schema: i64,
    target: i64,
    runtime_abi: i64,
    pointer_width: i64,
    limit: i64,
    source: String,
    ast: ShAst,
    checked: ShChecked,
    ownership: ShOwnership,
    error: i64,
    start: i64,
    end: i64,
}

struct ShHirImage {
    words: Vec<i64>,
    error: i64,
}

struct ShHirReader {
    words: Vec<i64>,
    position: i64,
    maximum: i64,
    error: i64,
}

def sh_hir_words(input: &Vec<i64>, limit: i64, error: &mut i64) -> Vec<i64> {
    let output = vec_new_i64();
    if input.len() > limit or limit < 0 { *error = 5501; return output; };
    let mut index = 0;
    while index < input.len() { if not output.push(sengoo_vec_get_or_default_i64(input.handle, index, -1)) { *error = 5501; return output; }; index = index + 1; };
    output;
}

def sh_hir_diagnostics(input: &Vec<ShDiagnostic>, limit: i64, error: &mut i64) -> Vec<ShDiagnostic> {
    let output: Vec<ShDiagnostic> = vec_new();
    if input.len() > limit { *error = 5501; return output; };
    let mut index = 0;
    while index < input.len() { let item = input.get(index); let copy = ShDiagnostic { code: item.code, severity: item.severity, node: item.node, start: item.start, end: item.end, expected: item.expected, actual: item.actual }; if not output.push(copy) { *error = 5501; return output; }; index = index + 1; };
    output;
}

def sh_hir_type_valid(hir: &ShHir, ty: i64) -> bool {
    ty >= 0 and ty < sh_type_count(&hir.checked.types);
}

def sh_hir_binding_valid(hir: &ShHir, binding: i64) -> bool {
    binding >= 0 and binding < sh_binding_count(&hir.checked);
}

def sh_hir_scope_valid(hir: &ShHir, scope: i64) -> bool {
    scope >= 0 and scope < sh_scope_count(&hir.checked);
}

def sh_hir_node_valid(hir: &ShHir, node: i64) -> bool {
    node >= 0 and node < sh_ast_count(&hir.ast);
}

def sh_hir_type_word(hir: &ShHir, ty: i64, field: i64) -> i64 {
    let value = sh_type_word(&hir.checked.types, ty, field);
    if value.is_ok() { value.value; } else { -1; };
}

def sh_hir_type_argument(hir: &ShHir, ty: i64, index: i64) -> i64 {
    let value = sh_type_argument(&hir.checked.types, ty, index);
    if value.is_ok() { value.value; } else { -1; };
}

def sh_hir_node_owner(hir: &ShHir, node: i64) -> i64 {
    let declaration = sh_node_binding(&hir.checked, node);
    if declaration >= 0 and sh_binding_word(&hir.checked, declaration, 4) == node { let kind = sh_binding_word(&hir.checked, declaration, 2); if kind == 2 or kind == 15 { return declaration; }; if kind == 0 or kind == 1 { return sh_binding_word(&hir.checked, declaration, 6); }; };
    let scope = sh_node_scope(&hir.checked, node);
    if not sh_hir_scope_valid(hir, scope) { return -1; };
    let mut owner = sh_scope_word(&hir.checked, scope, 1);
    let mut depth = 0;
    while owner >= 0 and depth < sh_binding_count(&hir.checked) { let kind = sh_binding_word(&hir.checked, owner, 2); if kind == 2 or kind == 15 { return owner; }; owner = sh_binding_word(&hir.checked, owner, 6); depth = depth + 1; };
    -1;
}

def sh_hir_scope_contains(hir: &ShHir, outer: i64, inner: i64) -> bool {
    let mut current = inner;
    let mut depth = 0;
    while current >= 0 and depth < sh_scope_count(&hir.checked) { if current == outer { return true; }; current = sh_scope_word(&hir.checked, current, 0); depth = depth + 1; };
    false;
}

def sh_hir_syntax_contains(ast: &ShAst, outer: i64, inner: i64, depth: i64) -> bool {
    if outer == inner { return true; };
    if depth >= 128 or inner < 0 or outer <= inner { return false; };
    let mut child = 0;
    while child < sh_ast_word(ast, outer, 6) { if sh_hir_syntax_contains(ast, sh_ast_child(ast, outer, child), inner, depth + 1) { return true; }; child = child + 1; };
    false;
}

def sh_hir_validate_calls(hir: &ShHir) -> i64 {
    let mut node = 0;
    while node < sh_ast_count(&hir.ast) { if sh_ast_word(&hir.ast, node, 0) == 53 { let callee = sh_ast_child(&hir.ast, node, 0); let target = sh_node_binding(&hir.checked, node); let resolved = sh_node_binding(&hir.checked, callee); if target != resolved { return 5504; }; let category = sh_binding_word(&hir.checked, target, 2); if target >= 0 and category != 0 and category != 1 and category != 2 and category != 5 and category != 13 and category != 15 { return 5504; }; let signature = sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, callee)); { if sh_s_kind(&hir.checked, signature) != 11 or sh_s_arity(&hir.checked, signature) < 1 { return 5503; }; let callable = sh_s_resolve(&hir.checked, sh_node_callable_type(&hir.checked, node)); if callable != signature { return 5503; }; let arity = sh_s_arity(&hir.checked, signature) - 1; if sh_s_resolve(&hir.checked, sh_s_argument(&hir.checked, signature, arity)) != sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, node)) { return 5503; }; let receiver = if sh_ast_word(&hir.ast, callee, 0) == 55 { 1; } else { 0; }; let actuals = sh_ast_word(&hir.ast, node, 6) - 1 + receiver; let variadic = (sh_s_flags(&hir.checked, signature) & 1) != 0; if actuals < arity or not variadic and actuals != arity { return 5503; }; }; }; let node_kind = sh_ast_word(&hir.ast, node, 0); let callable = sh_node_callable_type(&hir.checked, node); if (node_kind == 50 or node_kind == 51) and callable < 0 and sh_binding_word(&hir.checked, sh_node_binding(&hir.checked, node), 2) == 2 { return 5503; }; if (node_kind == 50 or node_kind == 51) and callable >= 0 { let unary = node_kind == 50; let operation = sh_ast_word(&hir.ast, node, 4); let target = sh_node_binding(&hir.checked, node); let owner = sh_binding_word(&hir.checked, target, 6); let method = sh_symbol_text(&hir.checked.symbols, sh_binding_word(&hir.checked, target, 0)); let trait_name = sh_symbol_text(&hir.checked.symbols, if sh_binding_word(&hir.checked, owner, 2) == 7 { sh_binding_word(&hir.checked, owner, 0); } else { sh_s_impl_symbol(&hir.checked, owner); }); if sh_binding_word(&hir.checked, target, 2) != 2 or not method.is_ok() or not trait_name.is_ok() or not sh_s_text_equal(&method.value, sh_s_operator_method(operation, unary)) or not sh_s_text_equal(&trait_name.value, sh_s_operator_label(operation, unary)) { return 5504; }; let signature = sh_s_resolve(&hir.checked, callable); let count = sh_ast_word(&hir.ast, node, 6); if sh_s_kind(&hir.checked, signature) != 11 or sh_s_arity(&hir.checked, signature) != count + 1 or count != if unary { 1; } else { 2; } or sh_s_argument(&hir.checked, signature, count) != sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, node)) { return 5503; }; let keys = vec_new_i64(); let values = vec_new_i64(); if not sh_s_pattern_keys(&hir.checked, sh_binding_word(&hir.checked, target, 3), signature, &keys, &values, 0) { return 5503; }; let mut operand = 0; while operand < count { let actual = sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, sh_ast_child(&hir.ast, node, operand))); let required = sh_s_resolve(&hir.checked, sh_s_argument(&hir.checked, signature, operand)); if actual != required and not (sh_s_kind(&hir.checked, required) == 6 and sh_s_argument(&hir.checked, required, 0) == actual) { return 5503; }; operand = operand + 1; }; }; node = node + 1; };
    0;
}

def sh_hir_detach_valid(hir: &ShHir, index: i64) -> bool {
    let node = sh_ownership_action(&hir.ownership, index, 0);
    let binding = sh_ownership_action(&hir.ownership, index, 1);
    let path = sh_ownership_action_path(&hir.ownership, index);
    if binding < 0 or path < 0 or sh_ownership_action(&hir.ownership, index, 4) != 0 or sh_ownership_action(&hir.ownership, index, 3) != sh_node_scope(&hir.checked, node) { return false; };
    let parent = sh_ownership_path_word(&hir.ownership, path, 1);
    if parent < 0 or sh_ownership_path_word(&hir.ownership, parent, 1) != -1 or sh_ownership_path_word(&hir.ownership, parent, 0) != binding { return false; };
    let previous = sh_b_detach_previous(&hir.ownership, binding, index);
    if previous < 0 or sh_ownership_action_path(&hir.ownership, previous) != parent or sh_ownership_action(&hir.ownership, previous, 4) != 0 { return false; };
    sh_b_detach_shape(&hir.ownership, &hir.source, &hir.checked, &hir.ast, node, path, sh_ownership_action(&hir.ownership, previous, 0));
}

def sh_hir_validate_ownership_links(hir: &ShHir) -> i64 {
    let mut index = 0;
    while index < sh_ownership_action_count(&hir.ownership) { let node = sh_ownership_action(&hir.ownership, index, 0); let binding = sh_ownership_action(&hir.ownership, index, 1); let kind = sh_ownership_action(&hir.ownership, index, 2); let scope = sh_ownership_action(&hir.ownership, index, 3); if kind == 10 and not sh_hir_detach_valid(hir, index) { return 5506; }; if kind == 7 and sh_ast_word(&hir.ast, node, 0) != 56 { return 5506; }; if kind == 8 or kind == 9 { if sh_binding_word(&hir.checked, binding, 2) != 1 or sh_binding_word(&hir.checked, binding, 4) != node or sh_binding_word(&hir.checked, binding, 1) != scope or sh_ownership_action(&hir.ownership, index, 4) != 0 or sh_ownership_action_path(&hir.ownership, index) != -1 { return 5506; }; let mut action = 0; while action < sh_ownership_action_count(&hir.ownership) { let other_kind = sh_ownership_action(&hir.ownership, action, 2); if sh_ownership_action(&hir.ownership, action, 1) == binding and (kind == 8 and other_kind == 2 or other_kind == 3 or other_kind == 6 or other_kind == 7) { return 5506; }; action = action + 1; }; }; let node_owner = sh_hir_node_owner(hir, node); let owner = if binding >= 0 { sh_binding_word(&hir.checked, binding, 6); } else { sh_hir_node_owner(hir, -binding - 1); }; if owner < 0 or node_owner != owner { return 5506; }; let scope_owner = sh_scope_word(&hir.checked, scope, 1); if scope_owner != owner { return 5506; }; if binding >= 0 { let declared_scope = sh_binding_word(&hir.checked, binding, 1); if not sh_hir_scope_contains(hir, declared_scope, sh_node_scope(&hir.checked, node)) and sh_binding_word(&hir.checked, binding, 4) != node and sh_binding_word(&hir.checked, owner, 4) != node { if sh_ast_word(&hir.ast, node, 0) != 40 or scope != declared_scope or not sh_hir_syntax_contains(&hir.ast, node, sh_binding_word(&hir.checked, binding, 4), 0) { return 5506; }; }; } else { let producer = -binding - 1; if kind == 1 or kind == 2 { if node != producer { return 5506; }; }; if kind == 1 and not sh_hir_scope_contains(hir, scope, sh_node_scope(&hir.checked, producer)) { return 5506; }; if kind == 3 or kind == 6 or kind == 7 { let mut initialized = false; let mut action = 0; while action < sh_ownership_action_count(&hir.ownership) { if sh_ownership_action(&hir.ownership, action, 1) == binding and sh_ownership_action(&hir.ownership, action, 2) == 1 { initialized = true; }; action = action + 1; }; if not initialized { return 5506; }; }; }; index = index + 1; };
    0;
}

def sh_hir_validate(hir: &ShHir) -> i64 {
    if hir.schema != 5 or hir.target != 1 or hir.runtime_abi != 1 or hir.pointer_width != 64 { return 5502; };
    if hir.limit < 0 or hir.limit > 100000 or hir.source.len() > hir.limit * 128 { return 5501; };
    if hir.error != 0 or hir.checked.error != 0 or hir.ownership.error != 0 { return 5502; };
    let count = sh_ast_count(&hir.ast);
    if hir.ast.words.len() % 7 != 0 or count <= 0 or count > hir.limit or hir.ast.edges.len() > hir.limit * 8 or not sh_hir_node_valid(hir, hir.ast.root) or sh_ast_word(&hir.ast, hir.ast.root, 0) != 1 { return 5502; };
    if hir.checked.node_types.len() != count or hir.checked.resolution.len() != count or hir.checked.call_types.len() != count or hir.checked.node_scopes.len() != count { return 5502; };
    if hir.checked.types.words.len() % 6 != 0 or sh_type_count(&hir.checked.types) > hir.limit or hir.checked.types.arguments.len() > hir.limit * 8 or sh_symbol_count(&hir.checked.symbols) > hir.limit or hir.checked.bindings.len() % 8 != 0 or sh_binding_count(&hir.checked) > hir.limit or hir.checked.scopes.len() % 3 != 0 or sh_scope_count(&hir.checked) > hir.limit { return 5501; };
    if sh_s_kind(&hir.checked, hir.checked.unit_type) != 0 or sh_s_kind(&hir.checked, hir.checked.bool_type) != 1 or sh_s_kind(&hir.checked, hir.checked.integer_type) != 2 or sh_s_kind(&hir.checked, hir.checked.float_type) != 3 or sh_s_kind(&hir.checked, hir.checked.char_type) != 4 or sh_s_kind(&hir.checked, hir.checked.str_type) != 5 or sh_s_kind(&hir.checked, hir.checked.never_type) != 17 or sh_s_kind(&hir.checked, hir.checked.error_type) != 18 { return 5503; };
    let mut index = 0;
    while index < sh_type_count(&hir.checked.types) { let kind = sh_hir_type_word(hir, index, 0); let data = sh_hir_type_word(hir, index, 1); let flags = sh_hir_type_word(hir, index, 2); let nominal = sh_hir_type_word(hir, index, 3); let first = sh_hir_type_word(hir, index, 4); let arity = sh_hir_type_word(hir, index, 5); if not sh_type_shape(kind, data, flags, nominal, arity) or first < 0 or first > hir.checked.types.arguments.len() or arity > hir.checked.types.arguments.len() - first { return 5503; }; if kind >= 12 and kind <= 15 and (nominal < 0 or nominal >= sh_symbol_count(&hir.checked.symbols)) { return 5503; }; let mut argument = 0; while argument < arity { let child = sh_hir_type_argument(hir, index, argument); if child < 0 or child >= index { return 5503; }; argument = argument + 1; }; index = index + 1; };
    index = 0;
    while index < hir.checked.substitutions.len() { let value = sengoo_vec_get_or_default_i64(hir.checked.substitutions.handle, index, -1); if index >= sh_type_count(&hir.checked.types) or value < -1 or value >= sh_type_count(&hir.checked.types) { return 5503; }; let mut cursor = index; let mut steps = 0; while cursor >= 0 { let next = sengoo_vec_get_or_default_i64(hir.checked.substitutions.handle, cursor, -1); if next < 0 or next == cursor { break; }; cursor = next; steps = steps + 1; if steps > sh_type_count(&hir.checked.types) { return 5503; }; }; index = index + 1; };
    index = 0;
    while index < sh_scope_count(&hir.checked) { let parent = sh_scope_word(&hir.checked, index, 0); let owner = sh_scope_word(&hir.checked, index, 1); if parent < -1 or parent >= index or owner < -1 or owner >= sh_binding_count(&hir.checked) { return 5505; }; index = index + 1; };
    index = 0;
    while index < sh_binding_count(&hir.checked) { let symbol = sh_binding_word(&hir.checked, index, 0); let kind = sh_binding_word(&hir.checked, index, 2); let declaration = sh_binding_word(&hir.checked, index, 4); let owner = sh_binding_word(&hir.checked, index, 6); if symbol < 0 or symbol >= sh_symbol_count(&hir.checked.symbols) or not sh_hir_scope_valid(hir, sh_binding_word(&hir.checked, index, 1)) or kind < 0 or kind > 15 or not sh_hir_type_valid(hir, sh_binding_word(&hir.checked, index, 3)) or declaration < -1 or declaration >= count or owner < -1 or owner >= sh_binding_count(&hir.checked) { return 5504; }; let mut ancestor = owner; let mut steps = 0; while ancestor >= 0 { if ancestor == index or steps >= sh_binding_count(&hir.checked) { return 5504; }; ancestor = sh_binding_word(&hir.checked, ancestor, 6); steps = steps + 1; }; index = index + 1; };
    index = 0;
    while index < count { let kind = sh_ast_word(&hir.ast, index, 0); let start = sh_ast_word(&hir.ast, index, 2); let end = sh_ast_word(&hir.ast, index, 3); let first = sh_ast_word(&hir.ast, index, 5); let arity = sh_ast_word(&hir.ast, index, 6); if kind <= 0 or kind > 91 or start < 0 or end < start or end > hir.source.len() or first < 0 or arity < 0 or first > hir.ast.edges.len() or arity > hir.ast.edges.len() - first { return 5502; }; let callable = sh_node_callable_type(&hir.checked, index); if callable < -1 or callable >= sh_type_count(&hir.checked.types) or callable >= 0 and sh_s_kind(&hir.checked, callable) != 11 { return 5503; }; let ty = sh_node_type(&hir.checked, index); let binding = sh_node_binding(&hir.checked, index); let scope = sh_node_scope(&hir.checked, index); if ty < -1 or ty >= sh_type_count(&hir.checked.types) { return 5503; }; if binding < -1 or binding >= sh_binding_count(&hir.checked) { return 5504; }; if scope < -1 or scope >= sh_scope_count(&hir.checked) { return 5505; }; let mut child = 0; while child < arity { let target = sh_ast_child(&hir.ast, index, child); if target < 0 or target >= index { return 5502; }; child = child + 1; }; index = index + 1; };
    if hir.checked.generic_parameters.len() % 3 != 0 or hir.checked.constraints.len() % 4 != 0 { return 5504; };
    index = 0;
    while index < hir.checked.generic_parameters.len() { if not sh_hir_binding_valid(hir, sengoo_vec_get_or_default_i64(hir.checked.generic_parameters.handle, index, -1)) or not sh_hir_binding_valid(hir, sengoo_vec_get_or_default_i64(hir.checked.generic_parameters.handle, index + 1, -1)) or not sh_hir_type_valid(hir, sengoo_vec_get_or_default_i64(hir.checked.generic_parameters.handle, index + 2, -1)) { return 5504; }; index = index + 3; };
    index = 0;
    while index < hir.checked.constraints.len() { let ty = sengoo_vec_get_or_default_i64(hir.checked.constraints.handle, index, -1); let trait_symbol = sengoo_vec_get_or_default_i64(hir.checked.constraints.handle, index + 1, -1); let node = sengoo_vec_get_or_default_i64(hir.checked.constraints.handle, index + 2, -1); let owner = sengoo_vec_get_or_default_i64(hir.checked.constraints.handle, index + 3, -1); if not sh_hir_type_valid(hir, ty) or trait_symbol < -1 or trait_symbol >= sh_symbol_count(&hir.checked.symbols) or (trait_symbol == -1 and (node != -2 or sh_binding_word(&hir.checked, owner, 2) != 14)) or (node != -2 and not sh_hir_node_valid(hir, node)) or not sh_hir_binding_valid(hir, owner) { return 5504; }; index = index + 4; };
    if hir.checked.trait_types.len() % 2 != 0 or hir.checked.class_parents.len() % 2 != 0 { return 5504; };
    index = 0;
    while index < hir.checked.trait_types.len() { if not sh_hir_binding_valid(hir, sengoo_vec_get_or_default_i64(hir.checked.trait_types.handle, index, -1)) or not sh_hir_type_valid(hir, sengoo_vec_get_or_default_i64(hir.checked.trait_types.handle, index + 1, -1)) { return 5504; }; index = index + 2; };
    index = 0;
    while index < hir.checked.class_parents.len() { if not sh_hir_binding_valid(hir, sengoo_vec_get_or_default_i64(hir.checked.class_parents.handle, index, -1)) or not sh_hir_type_valid(hir, sengoo_vec_get_or_default_i64(hir.checked.class_parents.handle, index + 1, -1)) { return 5504; }; index = index + 2; };
    if hir.ownership.actions.len() % 5 != 0 or hir.ownership.paths.len() % 4 != 0 or hir.ownership.action_paths.len() != sh_ownership_action_count(&hir.ownership) or hir.ownership.actions.len() > hir.limit * 8 or hir.ownership.paths.len() > hir.limit * 8 { return 5506; };
    index = 0;
    while index < hir.ownership.paths.len() / 4 { let root = sh_ownership_path_word(&hir.ownership, index, 0); let parent = sh_ownership_path_word(&hir.ownership, index, 1); let field = sh_ownership_path_word(&hir.ownership, index, 2); let ty = sh_ownership_path_word(&hir.ownership, index, 3); if (root >= 0 and (not sh_hir_binding_valid(hir, root) or sh_binding_word(&hir.checked, root, 2) > 1)) or (root < 0 and (root < -count or not sh_hir_node_valid(hir, -root - 1))) or parent < -1 or parent >= index or not sh_hir_type_valid(hir, ty) { return 5506; }; if parent < 0 { if field != -1 { return 5506; }; } else { if sh_ownership_path_word(&hir.ownership, parent, 0) != root { return 5506; }; let parent_type = sh_s_resolve(&hir.checked, sh_ownership_path_word(&hir.ownership, parent, 3)); if field == -2 { if sh_s_kind(&hir.checked, parent_type) != 6 or sh_s_resolve(&hir.checked, sh_s_argument(&hir.checked, parent_type, 0)) != sh_s_resolve(&hir.checked, ty) { return 5506; }; } else { if not sh_hir_binding_valid(hir, field) or sh_binding_word(&hir.checked, field, 2) != 6 { return 5506; }; }; }; index = index + 1; };
    index = 0;
    while index < sh_ownership_action_count(&hir.ownership) { let node = sh_ownership_action(&hir.ownership, index, 0); let binding = sh_ownership_action(&hir.ownership, index, 1); let kind = sh_ownership_action(&hir.ownership, index, 2); let scope = sh_ownership_action(&hir.ownership, index, 3); let conditional = sh_ownership_action(&hir.ownership, index, 4); let path = sh_ownership_action_path(&hir.ownership, index); if not sh_hir_node_valid(hir, node) or kind < 1 or kind > 10 or not sh_hir_scope_valid(hir, scope) or conditional < 0 or conditional > 1 or path < -1 or path >= hir.ownership.paths.len() / 4 or (binding >= 0 and (not sh_hir_binding_valid(hir, binding) or sh_binding_word(&hir.checked, binding, 2) > 1)) or (binding < 0 and (binding < -count or not sh_hir_node_valid(hir, -binding - 1))) or (path >= 0 and sh_ownership_path_word(&hir.ownership, path, 0) != binding) { return 5506; }; index = index + 1; };
    if hir.checked.deferred_types.len() % 4 != 0 or hir.checked.deferred_types.len() > hir.limit * 4 { return 5503; };
    index = 0;
    while index < hir.checked.deferred_types.len() / 4 { let first = index * 4; let owner = hir.checked.deferred_types.get(first).unwrap_or(-1); let expected = hir.checked.deferred_types.get(first + 1).unwrap_or(-1); let actual = hir.checked.deferred_types.get(first + 2).unwrap_or(-1); let origin = hir.checked.deferred_types.get(first + 3).unwrap_or(-1); let owner_kind = sh_binding_word(&hir.checked, owner, 2); if not sh_hir_binding_valid(hir, owner) or (owner_kind != 2 and owner_kind != 15) or not sh_hir_node_valid(hir, sh_binding_word(&hir.checked, owner, 4)) or not sh_hir_node_valid(hir, origin) or sh_hir_node_owner(hir, origin) != owner { return 5504; }; if not sh_hir_type_valid(hir, expected) or not sh_hir_type_valid(hir, actual) { return 5503; }; if not (sh_s_pending_projection(&hir.checked, expected, 0) or sh_s_pending_projection(&hir.checked, actual, 0)) or not sh_s_defer_shape(&hir.checked, expected, actual, 0) { return 5503; }; index = index + 1; };
    if hir.checked.builtin_calls.len() % 6 != 0 or hir.checked.builtin_calls.len() > hir.limit * 6 { return 5503; };
    index = 0;
    while index < sh_builtin_call_count(&hir.checked) { if not sh_builtin_call_valid(&hir.checked, &hir.source, &hir.ast, index) { return 5503; }; let mut previous = 0; while previous < index { if sh_builtin_call_word(&hir.checked, previous, 0) == sh_builtin_call_word(&hir.checked, index, 0) { return 5503; }; previous = previous + 1; }; index = index + 1; };
    let calls = sh_hir_validate_calls(hir);
    if calls != 0 { return calls; };
    let ownership_links = sh_hir_validate_ownership_links(hir);
    if ownership_links != 0 { return ownership_links; };
    if not sh_ownership_observed_contracts_valid(&hir.ownership, &hir.checked, &hir.ast) { return 5506; };
    0;
}

def sh_hir_put(output: &mut ShHirImage, value: i64, maximum: i64) {
    if output.error != 0 { return; };
    if output.words.len() >= maximum or not output.words.push(value) { output.error = 5501; };
}

def sh_hir_put_vector(output: &mut ShHirImage, input: &Vec<i64>, maximum: i64) {
    sh_hir_put(output, input.len(), maximum);
    let mut index = 0;
    while output.error == 0 and index < input.len() { sh_hir_put(output, sengoo_vec_get_or_default_i64(input.handle, index, -1), maximum); index = index + 1; };
}

def sh_hir_put_text(output: &mut ShHirImage, text: &String, maximum: i64) {
    let count_at = output.words.len();
    sh_hir_put(output, 0, maximum);
    sh_hir_put(output, text.len(), maximum);
    let bytes = sh_lex_bytes(text);
    if not bytes.is_ok() { output.error = 5501; return; };
    let mut offset = 0;
    let mut count = 0;
    while output.error == 0 and offset < text.len() { let scalar = sh_lex_utf8(&bytes.value, offset); if scalar.end <= offset or scalar.end > text.len() or scalar.value < 0 or scalar.value > 1114111 { output.error = 5507; return; }; sh_hir_put(output, scalar.value, maximum); offset = scalar.end; count = count + 1; };
    if output.error == 0 and not output.words.set(count_at, count) { output.error = 5501; };
}

def sh_hir_take(reader: &mut ShHirReader) -> i64 {
    if reader.error != 0 { return 0; };
    if reader.position < 0 or reader.position >= reader.words.len() { reader.error = 5502; return 0; };
    let value = sengoo_vec_get_or_default_i64(reader.words.handle, reader.position, 0);
    reader.position = reader.position + 1;
    value;
}

def sh_hir_take_vector(reader: &mut ShHirReader, maximum: i64) -> Vec<i64> {
    let output = vec_new_i64();
    let count = sh_hir_take(reader);
    if reader.error != 0 or count < 0 or count > maximum or count > reader.words.len() - reader.position { reader.error = 5501; return output; };
    let mut index = 0;
    while reader.error == 0 and index < count { let value = sh_hir_take(reader); if not output.push(value) { reader.error = 5501; }; index = index + 1; };
    output;
}

def sh_hir_take_text(reader: &mut ShHirReader, maximum: i64) -> String {
    let output = string_new();
    let count = sh_hir_take(reader);
    let bytes = sh_hir_take(reader);
    if reader.error != 0 or count < 0 or count > maximum or bytes < 0 or bytes > maximum or count > reader.words.len() - reader.position { reader.error = 5501; return output; };
