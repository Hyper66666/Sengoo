    let owned_last_uses = sh_hir_take_vector(&mut reader, 4000000);
    let owned_loops = sh_hir_take_vector(&mut reader, 4000000);
    let owned_definitions = sh_hir_take_vector(&mut reader, 4000000);
    let owned_contracts = sh_hir_take_vector(&mut reader, 4000000);
    let owned_projection_context = sh_hir_take(&mut reader);
    let owned_try_scopes = sh_hir_take_vector(&mut reader, 4000000);
    let owned_error = sh_hir_take(&mut reader);
    let owned_start = sh_hir_take(&mut reader);
    let owned_end = sh_hir_take(&mut reader);
    let owned_limit = sh_hir_take(&mut reader);
    let owned_function = sh_hir_take(&mut reader);
    let owned_scope = sh_hir_take(&mut reader);
    let owned_flow = sh_hir_take(&mut reader);
