import selfhost_borrow;

import selfhost_hir_origins;

struct ShHir {
    schema: i64,
    target: i64,
    runtime_abi: i64,
    pointer_width: i64,
    limit: i64,
    source: String,
    ast: ShAst,
    checked: ShChecked,
    ownership: ShOwnership,
    origins: ShHirOrigins,
    error: i64,
    start: i64,
    end: i64,
}

struct ShHirImage {
    words: Vec<i64>,
    error: i64,
}

struct ShHirReader {
    words: Vec<i64>,
    position: i64,
    maximum: i64,
    error: i64,
}

def sh_hir_words(input: &Vec<i64>, limit: i64, error: &mut i64) -> Vec<i64> {
    let output = vec_new_i64();
    if input.len() > limit or limit < 0 { *error = 5501; return output; };
    let mut index = 0;
    while index < input.len() { if not output.push(sengoo_vec_get_or_default_i64(input.handle, index, -1)) { *error = 5501; return output; }; index = index + 1; };
    output;
}

def sh_hir_diagnostics(input: &Vec<ShDiagnostic>, limit: i64, error: &mut i64) -> Vec<ShDiagnostic> {
    let output: Vec<ShDiagnostic> = vec_new();
    if input.len() > limit { *error = 5501; return output; };
    let mut index = 0;
    while index < input.len() { let item = input.get(index); let copy = ShDiagnostic { code: item.code, severity: item.severity, node: item.node, start: item.start, end: item.end, expected: item.expected, actual: item.actual }; if not output.push(copy) { *error = 5501; return output; }; index = index + 1; };
    output;
}

def sh_hir_type_valid(hir: &ShHir, ty: i64) -> bool {
    ty >= 0 and ty < sh_type_count(&hir.checked.types);
}

def sh_hir_binding_valid(hir: &ShHir, binding: i64) -> bool {
    binding >= 0 and binding < sh_binding_count(&hir.checked);
}

def sh_hir_scope_valid(hir: &ShHir, scope: i64) -> bool {
    scope >= 0 and scope < sh_scope_count(&hir.checked);
}

def sh_hir_node_valid(hir: &ShHir, node: i64) -> bool {
    node >= 0 and node < sh_ast_count(&hir.ast);
}

def sh_hir_type_word(hir: &ShHir, ty: i64, field: i64) -> i64 {
    let value = sh_type_word(&hir.checked.types, ty, field);
    if value.is_ok() { value.value; } else { -1; };
}

def sh_hir_type_argument(hir: &ShHir, ty: i64, index: i64) -> i64 {
    let value = sh_type_argument(&hir.checked.types, ty, index);
    if value.is_ok() { value.value; } else { -1; };
}

def sh_hir_node_owner(hir: &ShHir, node: i64) -> i64 {
    let declaration = sh_node_binding(&hir.checked, node);
    if declaration >= 0 and sh_binding_word(&hir.checked, declaration, 4) == node { let kind = sh_binding_word(&hir.checked, declaration, 2); if kind == 2 or kind == 15 { return declaration; }; if kind == 0 or kind == 1 { return sh_binding_word(&hir.checked, declaration, 6); }; };
    let scope = sh_node_scope(&hir.checked, node);
    if not sh_hir_scope_valid(hir, scope) { return -1; };
    let mut owner = sh_scope_word(&hir.checked, scope, 1);
    let mut depth = 0;
    while owner >= 0 and depth < sh_binding_count(&hir.checked) { let kind = sh_binding_word(&hir.checked, owner, 2); if kind == 2 or kind == 15 { return owner; }; owner = sh_binding_word(&hir.checked, owner, 6); depth = depth + 1; };
    -1;
}

def sh_hir_scope_contains(hir: &ShHir, outer: i64, inner: i64) -> bool {
    let mut current = inner;
    let mut depth = 0;
    while current >= 0 and depth < sh_scope_count(&hir.checked) { if current == outer { return true; }; current = sh_scope_word(&hir.checked, current, 0); depth = depth + 1; };
    false;
}

def sh_hir_syntax_contains(ast: &ShAst, outer: i64, inner: i64, depth: i64) -> bool {
    if outer == inner { return true; };
    if depth >= 128 or inner < 0 or outer <= inner { return false; };
    let mut child = 0;
    while child < sh_ast_word(ast, outer, 6) { if sh_hir_syntax_contains(ast, sh_ast_child(ast, outer, child), inner, depth + 1) { return true; }; child = child + 1; };
    false;
}

def sh_hir_type_equal_step(checked: &ShChecked, left: i64, right: i64, depth: i64, remaining: &mut i64) -> bool {
    if *remaining <= 0 { return false; };
    *remaining = *remaining - 1;
    let a = sh_s_resolve(checked, left);
    let b = sh_s_resolve(checked, right);
    if a < 0 or b < 0 or a >= sh_type_count(&checked.types) or b >= sh_type_count(&checked.types) or depth >= 128 { return false; };
    if a == b { return true; };
    if sh_s_kind(checked, a) != sh_s_kind(checked, b) or sh_s_data(checked, a) != sh_s_data(checked, b) or sh_s_flags(checked, a) != sh_s_flags(checked, b) or sh_s_nominal(checked, a) != sh_s_nominal(checked, b) or sh_s_arity(checked, a) != sh_s_arity(checked, b) { return false; };
    let mut index = 0;
    while index < sh_s_arity(checked, a) { if not sh_hir_type_equal_step(checked, sh_s_argument(checked, a, index), sh_s_argument(checked, b, index), depth + 1, remaining) { return false; }; index = index + 1; };
    true;
}

def sh_hir_types_equal(checked: &ShChecked, left: i64, right: i64, depth: i64) -> bool {
    let mut remaining = 100000;
    sh_hir_type_equal_step(checked, left, right, depth, &mut remaining);
}

def sh_hir_direct_child(ast: &ShAst, parent: i64, child: i64) -> bool {
    if parent < 0 or child < 0 or parent >= sh_ast_count(ast) or child >= parent { return false; };
    let mut index = 0;
    let mut found = 0;
    while index < sh_ast_word(ast, parent, 6) { if sh_ast_child(ast, parent, index) == child { found = found + 1; }; index = index + 1; };
    found == 1;
}

def sh_hir_function_body_state(ast: &ShAst, checked: &ShChecked, function: i64) -> i64 {
    let kind = sh_binding_word(checked, function, 2);
    let declaration = sh_binding_word(checked, function, 4);
    if kind != 2 and kind != 15 or declaration < 0 or declaration >= sh_ast_count(ast) or sh_node_binding(checked, declaration) != function { return -1; };
    let syntax = sh_ast_word(ast, declaration, 0);
    if kind == 2 and syntax != 20 or kind == 15 and syntax != 67 { return -1; };
    let signature = sh_s_resolve(checked, sh_binding_word(checked, function, 3));
    if sh_s_kind(checked, signature) != 11 or sh_s_arity(checked, signature) < 1 { return -1; };
    let body = sh_s_child_kind(ast, declaration, 40);
    if body < 0 { return 0; };
    if not sh_hir_direct_child(ast, declaration, body) { return -1; };
    let owner = sh_binding_word(checked, function, 6);
    if sh_binding_word(checked, owner, 2) == 7 { let trait_declaration = sh_binding_word(checked, owner, 4); if kind != 2 or sh_ast_word(ast, trait_declaration, 0) != 27 or sh_node_binding(checked, trait_declaration) != owner or not sh_hir_direct_child(ast, trait_declaration, declaration) { return -1; }; return 2; };
    let body_type = sh_node_type(checked, body);
    if body_type < 0 or sh_s_kind(checked, sh_s_resolve(checked, body_type)) == 18 or sh_node_scope(checked, body) < 0 { return -1; };
    1;
}

def sh_hir_deferred_error(code: i64) -> Result<Vec<i64>, i64> {
    let missing: Vec<i64> = Vec { handle: 0, marker: 0 };
    Result { is_ok: false, value: missing, error: code };
}

def sh_hir_deferred_body_map(hir: &ShHir) -> Result<Vec<i64>, i64> {
    let count = sh_ast_count(&hir.ast);
    let coverage = vec_new_i64();
    let parents = vec_new_i64();
    if count < 1 or count > hir.limit { return sh_hir_deferred_error(5501); };
    let mut index = 0;
    while index < count { if not (coverage.push(-1) and parents.push(0)) { return sh_hir_deferred_error(5501); }; index = index + 1; };
    index = 0;
    while index < count { let mut part = 0; while part < sh_ast_word(&hir.ast, index, 6) { let child = sh_ast_child(&hir.ast, index, part); if child < 0 or child >= index { return sh_hir_deferred_error(5502); }; if not parents.set(child, parents.get(child).unwrap_or(0) + 1) { return sh_hir_deferred_error(5501); }; part = part + 1; }; index = index + 1; };
    let mut function = 0;
    while function < sh_binding_count(&hir.checked) { if sh_binding_word(&hir.checked, function, 2) == 2 and sh_binding_word(&hir.checked, sh_binding_word(&hir.checked, function, 6), 2) == 7 { let declaration = sh_binding_word(&hir.checked, function, 4); let body = sh_s_child_kind(&hir.ast, declaration, 40); if body >= 0 { if sh_hir_function_body_state(&hir.ast, &hir.checked, function) != 2 or parents.get(declaration).unwrap_or(0) != 1 or coverage.get(body).unwrap_or(-1) >= 0 { return sh_hir_deferred_error(5504); }; if not coverage.set(body, function) { return sh_hir_deferred_error(5501); }; }; }; function = function + 1; };
    index = count - 1;
    while index >= 0 { let owner = coverage.get(index).unwrap_or(-1); if owner >= 0 { let mut child = 0; while child < sh_ast_word(&hir.ast, index, 6) { let next = sh_ast_child(&hir.ast, index, child); if next < 0 or next >= index { return sh_hir_deferred_error(5502); }; let prior = coverage.get(next).unwrap_or(-1); if prior >= 0 and prior != owner { return sh_hir_deferred_error(5504); }; if not coverage.set(next, owner) { return sh_hir_deferred_error(5501); }; child = child + 1; }; }; index = index - 1; };
    index = 0;
    while index < count { let owner = coverage.get(index).unwrap_or(-1); if owner >= 0 { if parents.get(index).unwrap_or(0) != 1 { return sh_hir_deferred_error(5504); }; if sh_node_type(&hir.checked, index) != -1 or sh_node_binding(&hir.checked, index) != -1 or sh_node_callable_type(&hir.checked, index) != -1 or sh_node_scope(&hir.checked, index) != -1 { return sh_hir_deferred_error(5503); }; }; let mut child = 0; while child < sh_ast_word(&hir.ast, index, 6) { let next = sh_ast_child(&hir.ast, index, child); let next_owner = coverage.get(next).unwrap_or(-1); if next_owner >= 0 and next_owner != owner { if sh_binding_word(&hir.checked, next_owner, 4) != index or sh_s_child_kind(&hir.ast, index, 40) != next { return sh_hir_deferred_error(5504); }; }; child = child + 1; }; index = index + 1; };
    Result { is_ok: true, value: coverage, error: 0 };
}

def sh_hir_validate_calls(hir: &ShHir) -> i64 {
    let deferred = sh_hir_deferred_body_map(hir);
    if not deferred.is_ok() { return deferred.error; };
    let mut node = 0;
    while node < sh_ast_count(&hir.ast) { if sengoo_vec_get_or_default_i64(deferred.value.handle, node, -1) >= 0 { node = node + 1; continue; }; if sh_ast_word(&hir.ast, node, 0) == 53 { let callee = sh_ast_child(&hir.ast, node, 0); let target = sh_node_binding(&hir.checked, node); let resolved = sh_node_binding(&hir.checked, callee); if target != resolved { return 5504; }; let category = sh_binding_word(&hir.checked, target, 2); if target >= 0 and category != 0 and category != 1 and category != 2 and category != 5 and category != 13 and category != 15 { return 5504; }; let signature = sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, callee)); { if sh_s_kind(&hir.checked, signature) != 11 or sh_s_arity(&hir.checked, signature) < 1 { return 5503; }; let callable = sh_s_resolve(&hir.checked, sh_node_callable_type(&hir.checked, node)); if not sh_hir_types_equal(&hir.checked, callable, signature, 0) { return 5503; }; let arity = sh_s_arity(&hir.checked, signature) - 1; if sh_s_resolve(&hir.checked, sh_s_argument(&hir.checked, signature, arity)) != sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, node)) { return 5503; }; let receiver = if sh_ast_word(&hir.ast, callee, 0) == 55 { 1; } else { 0; }; let actuals = sh_ast_word(&hir.ast, node, 6) - 1 + receiver; let variadic = (sh_s_flags(&hir.checked, signature) & 1) != 0; if actuals < arity or not variadic and actuals != arity { return 5503; }; }; }; let node_kind = sh_ast_word(&hir.ast, node, 0); let callable = sh_node_callable_type(&hir.checked, node); if (node_kind == 50 or node_kind == 51) and callable < 0 and sh_binding_word(&hir.checked, sh_node_binding(&hir.checked, node), 2) == 2 { return 5503; }; if (node_kind == 50 or node_kind == 51) and callable >= 0 { let unary = node_kind == 50; let operation = sh_ast_word(&hir.ast, node, 4); let target = sh_node_binding(&hir.checked, node); let owner = sh_binding_word(&hir.checked, target, 6); let method = sh_symbol_text(&hir.checked.symbols, sh_binding_word(&hir.checked, target, 0)); let trait_name = sh_symbol_text(&hir.checked.symbols, if sh_binding_word(&hir.checked, owner, 2) == 7 { sh_binding_word(&hir.checked, owner, 0); } else { sh_s_impl_symbol(&hir.checked, owner); }); if sh_binding_word(&hir.checked, target, 2) != 2 or not method.is_ok() or not trait_name.is_ok() or not sh_s_text_equal(&method.value, sh_s_operator_method(operation, unary)) or not sh_s_text_equal(&trait_name.value, sh_s_operator_label(operation, unary)) { return 5504; }; let signature = sh_s_resolve(&hir.checked, callable); let count = sh_ast_word(&hir.ast, node, 6); if sh_s_kind(&hir.checked, signature) != 11 or sh_s_arity(&hir.checked, signature) != count + 1 or count != if unary { 1; } else { 2; } or sh_s_argument(&hir.checked, signature, count) != sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, node)) { return 5503; }; let keys = vec_new_i64(); let values = vec_new_i64(); if not sh_s_pattern_keys(&hir.checked, sh_binding_word(&hir.checked, target, 3), signature, &keys, &values, 0) { return 5503; }; let mut operand = 0; while operand < count { let actual = sh_s_resolve(&hir.checked, sh_node_type(&hir.checked, sh_ast_child(&hir.ast, node, operand))); let required = sh_s_resolve(&hir.checked, sh_s_argument(&hir.checked, signature, operand)); if actual != required and not (sh_s_kind(&hir.checked, required) == 6 and sh_s_argument(&hir.checked, required, 0) == actual) { return 5503; }; operand = operand + 1; }; }; node = node + 1; };
    0;
}

def sh_hir_detach_valid(hir: &ShHir, index: i64) -> bool {
    let node = sh_ownership_action(&hir.ownership, index, 0);
    let binding = sh_ownership_action(&hir.ownership, index, 1);
    let path = sh_ownership_action_path(&hir.ownership, index);
    if binding < 0 or path < 0 or sh_ownership_action(&hir.ownership, index, 4) != 0 or sh_ownership_action(&hir.ownership, index, 3) != sh_node_scope(&hir.checked, node) { return false; };
    let parent = sh_ownership_path_word(&hir.ownership, path, 1);
    if parent < 0 or sh_ownership_path_word(&hir.ownership, parent, 1) != -1 or sh_ownership_path_word(&hir.ownership, parent, 0) != binding { return false; };
    let previous = sh_b_detach_previous(&hir.ownership, binding, index);
    if previous < 0 or sh_ownership_action_path(&hir.ownership, previous) != parent or sh_ownership_action(&hir.ownership, previous, 4) != 0 { return false; };
    sh_b_detach_shape(&hir.ownership, &hir.source, &hir.checked, &hir.ast, node, path, sh_ownership_action(&hir.ownership, previous, 0));
}

def sh_hir_validate_ownership_links(hir: &ShHir) -> i64 {
    let mut index = 0;
    while index < sh_ownership_action_count(&hir.ownership) { let node = sh_ownership_action(&hir.ownership, index, 0); let binding = sh_ownership_action(&hir.ownership, index, 1); let kind = sh_ownership_action(&hir.ownership, index, 2); let scope = sh_ownership_action(&hir.ownership, index, 3); if kind == 10 and not sh_hir_detach_valid(hir, index) { return 5506; }; if kind == 7 and sh_ast_word(&hir.ast, node, 0) != 56 { return 5506; }; if kind == 8 or kind == 9 { if sh_binding_word(&hir.checked, binding, 2) != 1 or sh_binding_word(&hir.checked, binding, 4) != node or sh_binding_word(&hir.checked, binding, 1) != scope or sh_ownership_action(&hir.ownership, index, 4) != 0 or sh_ownership_action_path(&hir.ownership, index) != -1 { return 5506; }; let mut action = 0; while action < sh_ownership_action_count(&hir.ownership) { let other_kind = sh_ownership_action(&hir.ownership, action, 2); if sh_ownership_action(&hir.ownership, action, 1) == binding and (kind == 8 and other_kind == 2 or other_kind == 3 or other_kind == 6 or other_kind == 7) { return 5506; }; action = action + 1; }; }; let node_owner = sh_hir_node_owner(hir, node); let owner = if binding >= 0 { sh_binding_word(&hir.checked, binding, 6); } else { sh_hir_node_owner(hir, -binding - 1); }; if owner < 0 or node_owner != owner { return 5506; }; let scope_owner = sh_scope_word(&hir.checked, scope, 1); if scope_owner != owner { return 5506; }; if binding >= 0 { let declared_scope = sh_binding_word(&hir.checked, binding, 1); if not sh_hir_scope_contains(hir, declared_scope, sh_node_scope(&hir.checked, node)) and sh_binding_word(&hir.checked, binding, 4) != node and sh_binding_word(&hir.checked, owner, 4) != node { if sh_ast_word(&hir.ast, node, 0) != 40 or scope != declared_scope or not sh_hir_syntax_contains(&hir.ast, node, sh_binding_word(&hir.checked, binding, 4), 0) { return 5506; }; }; } else { let producer = -binding - 1; if kind == 1 or kind == 2 { if node != producer { return 5506; }; }; if kind == 1 and not sh_hir_scope_contains(hir, scope, sh_node_scope(&hir.checked, producer)) { return 5506; }; if kind == 3 or kind == 6 or kind == 7 { let mut initialized = false; let mut action = 0; while action < sh_ownership_action_count(&hir.ownership) { if sh_ownership_action(&hir.ownership, action, 1) == binding and sh_ownership_action(&hir.ownership, action, 2) == 1 { initialized = true; }; action = action + 1; }; if not initialized { return 5506; }; }; }; index = index + 1; };
    0;
}

def sh_hir_validate(hir: &ShHir) -> i64 {
    if hir.schema != 6 or hir.target != 1 or hir.runtime_abi != 1 or hir.pointer_width != 64 { return 5502; };
    if hir.limit < 0 or hir.limit > 100000 or hir.source.len() > hir.limit * 128 { return 5501; };
    if hir.error != 0 or hir.checked.error != 0 or hir.ownership.error != 0 { return 5502; };
    if hir.start < 0 or hir.end < hir.start or hir.end > hir.source.len() { return 5502; };
    if hir.checked.types.limit < 0 or hir.checked.types.limit > 1000000 or hir.checked.symbols.limit < 0 or hir.checked.symbols.limit > 1000000 or sh_type_count(&hir.checked.types) > hir.checked.types.limit or sh_symbol_count(&hir.checked.symbols) > hir.checked.symbols.limit { return 5501; };
    if hir.ownership.limit < 1 or hir.ownership.limit > 1000000 or hir.checked.diagnostic_limit < 0 or hir.checked.diagnostic_limit > 1000000 { return 5501; };
    let budget = sh_hir_budget(hir);
    if budget != 0 { return budget; };
    let candidates = sh_hir_origins_shape(&hir.origins);
    if candidates != 0 { return candidates; };
    if hir.origins.limit != hir.limit { return 5501; };
    if hir.origins.present == 0 and hir.origins.module_input.len() == 0 and sh_hir_origins_candidate_site(&hir.source, &hir.ast, &hir.checked) >= 0 { return 5008; };
    let count = sh_ast_count(&hir.ast);
    if hir.ast.words.len() % 7 != 0 or count <= 0 or count > hir.limit or hir.ast.edges.len() > hir.limit * 8 or not sh_hir_node_valid(hir, hir.ast.root) or sh_ast_word(&hir.ast, hir.ast.root, 0) != 1 { return 5502; };
    if hir.checked.node_types.len() != count or hir.checked.resolution.len() != count or hir.checked.call_types.len() != count or hir.checked.node_scopes.len() != count { return 5502; };
    if hir.checked.types.words.len() % 6 != 0 or sh_type_count(&hir.checked.types) > hir.limit or hir.checked.types.arguments.len() > hir.limit * 8 or sh_symbol_count(&hir.checked.symbols) > hir.limit or hir.checked.bindings.len() % 8 != 0 or sh_binding_count(&hir.checked) > hir.limit or hir.checked.scopes.len() % 3 != 0 or sh_scope_count(&hir.checked) > hir.limit { return 5501; };
    if sh_s_kind(&hir.checked, hir.checked.unit_type) != 0 or sh_s_kind(&hir.checked, hir.checked.bool_type) != 1 or sh_s_kind(&hir.checked, hir.checked.integer_type) != 2 or sh_s_kind(&hir.checked, hir.checked.float_type) != 3 or sh_s_kind(&hir.checked, hir.checked.char_type) != 4 or sh_s_kind(&hir.checked, hir.checked.str_type) != 5 or sh_s_kind(&hir.checked, hir.checked.never_type) != 17 or sh_s_kind(&hir.checked, hir.checked.error_type) != 18 { return 5503; };
    let mut index = 0;
    while index < sh_type_count(&hir.checked.types) { let kind = sh_hir_type_word(hir, index, 0); let data = sh_hir_type_word(hir, index, 1); let flags = sh_hir_type_word(hir, index, 2); let nominal = sh_hir_type_word(hir, index, 3); let first = sh_hir_type_word(hir, index, 4); let arity = sh_hir_type_word(hir, index, 5); if not sh_type_shape(kind, data, flags, nominal, arity) or first < 0 or first > hir.checked.types.arguments.len() or arity > hir.checked.types.arguments.len() - first { return 5503; }; if kind >= 12 and kind <= 15 and (nominal < 0 or nominal >= sh_symbol_count(&hir.checked.symbols)) { return 5503; }; let mut argument = 0; while argument < arity { let child = sh_hir_type_argument(hir, index, argument); if child < 0 or child >= index { return 5503; }; argument = argument + 1; }; index = index + 1; };
    index = 0;
    while index < hir.checked.substitutions.len() { let value = sengoo_vec_get_or_default_i64(hir.checked.substitutions.handle, index, -1); if index >= sh_type_count(&hir.checked.types) or value < -1 or value >= sh_type_count(&hir.checked.types) { return 5503; }; let mut cursor = index; let mut steps = 0; while cursor >= 0 { let next = sengoo_vec_get_or_default_i64(hir.checked.substitutions.handle, cursor, -1); if next < 0 or next == cursor { break; }; cursor = next; steps = steps + 1; if steps > sh_type_count(&hir.checked.types) { return 5503; }; }; index = index + 1; };
    index = 0;
    while index < sh_scope_count(&hir.checked) { let parent = sh_scope_word(&hir.checked, index, 0); let owner = sh_scope_word(&hir.checked, index, 1); if parent < -1 or parent >= index or owner < -1 or owner >= sh_binding_count(&hir.checked) { return 5505; }; index = index + 1; };
    index = 0;
    while index < sh_binding_count(&hir.checked) { let symbol = sh_binding_word(&hir.checked, index, 0); let kind = sh_binding_word(&hir.checked, index, 2); let declaration = sh_binding_word(&hir.checked, index, 4); let owner = sh_binding_word(&hir.checked, index, 6); if symbol < 0 or symbol >= sh_symbol_count(&hir.checked.symbols) or not sh_hir_scope_valid(hir, sh_binding_word(&hir.checked, index, 1)) or kind < 0 or kind > 15 or not sh_hir_type_valid(hir, sh_binding_word(&hir.checked, index, 3)) or declaration < -1 or declaration >= count or owner < -1 or owner >= sh_binding_count(&hir.checked) { return 5504; }; let mut ancestor = owner; let mut steps = 0; while ancestor >= 0 { if ancestor == index or steps >= sh_binding_count(&hir.checked) { return 5504; }; ancestor = sh_binding_word(&hir.checked, ancestor, 6); steps = steps + 1; }; index = index + 1; };
    index = 0;
