    result.depth = result.depth + 1;
    sh_b_expire(result, checked, ast, node);
    let kind = sh_ast_word(ast, node, 0);
    let accessing = sh_b_access_alias(checked, ast, node, 0);
    if sh_b_alias_ambiguous(result, accessing) { sh_b_error(result, ast, node, 6111, accessing, -1); };
    if kind == 66 or kind == 63 { sh_b_pattern_initialize(result, checked, ast, node); };
    if kind == 50 and sh_ast_word(ast, node, 4) % 1000 == sh_kind("*") { sh_cb_walk(fresh, result, text, checked, ast, sh_ast_child(ast, node, 0), false, -1); };
    if kind == 55 { let base = sh_ast_child(ast, node, 0); if sh_b_place(result, checked, ast, base) < 0 or sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, base))) == 6 { sh_cb_walk(fresh, result, text, checked, ast, base, false, holder); }; };
    let producer = kind == 53 or kind == 60 or kind == 59 or kind == 58 and sh_ast_word(ast, node, 4) == 1;
    let path = if producer { -1; } else { sh_b_place(result, checked, ast, node); };
    if (kind == 50 or kind == 51) and sh_node_callable_type(checked, node) >= 0 { sh_cb_operator(fresh, result, text, checked, ast, node, holder); } else if path >= 0 { let scalar_dereference = kind == 50 and sh_ast_word(ast, node, 4) % 1000 == sh_kind("*") and not sh_b_carries_borrow(checked, sh_node_type(checked, node), 0); if not scalar_dereference { sh_b_alias(result, checked, ast, node, path, holder); }; sh_b_path_use(result, checked, ast, node, path, moving); sh_b_legacy_projection(result, checked, ast, node, path, moving); } else if kind == 56 { sh_cb_walk(fresh, result, text, checked, ast, sh_ast_child(ast, node, 0), true, -1); let state = sh_b_state_copy(result); let first = sh_ownership_action_count(result); let scope = if result.try_scopes.len() > 0 { result.try_scopes.get(result.try_scopes.len() - 1).unwrap_or(-1); } else { sh_binding_word(checked, result.function, 7); }; sh_b_cleanup(result, checked, ast, node, scope, true); let mut action = first; while action < sh_ownership_action_count(result) { if result.actions.get(action * 5 + 2).unwrap_or(0) == 3 { result.actions.set(action * 5 + 2, 7); (); }; action = action + 1; }; sh_b_state_restore(result, &state); } else if kind == 68 and sh_ast_word(ast, node, 4) == sh_kind("try") { let body = sh_ast_child(ast, node, 0); result.try_scopes.push(sh_b_block_scope(checked, ast, body)); sh_cb_walk(fresh, result, text, checked, ast, body, true, -1); result.try_scopes.pop(); (); } else if kind == 40 { let previous_scope = result.scope; result.scope = sh_b_block_scope(checked, ast, node); let mut index = 0; while result.flow == 0 and index < sh_ast_word(ast, node, 6) { let child = sh_ast_child(ast, node, index); let tail = index + 1 == sh_ast_word(ast, node, 6) and sh_ast_word(ast, child, 0) == 43; sh_cb_walk(fresh, result, text, checked, ast, child, moving and tail, if tail { holder; } else { -1; }); index = index + 1; }; if result.flow != 0 and index < sh_ast_word(ast, node, 6) { sh_b_dead_tail(result, checked, ast, node, index); }; let mut loan = 0; while loan < result.loans.len() { let alias = result.loans.get(loan + 1).unwrap_or(-1); if alias >= 0 and sh_binding_word(checked, alias, 1) == result.scope { result.loans.set(loan + 4, 0); (); }; loan = loan + 5; }; if result.flow == 0 { let scope = result.scope; sh_b_cleanup(result, checked, ast, node, scope, false); }; result.scope = previous_scope; } else if kind == 41 or kind == 44 { let binding = sh_node_binding(checked, sh_ast_child(ast, node, 0)); let mut index = 1; while index < sh_ast_word(ast, node, 6) { let child = sh_ast_child(ast, node, index); if sh_ast_word(ast, child, 0) < 70 { sh_cb_walk(fresh, result, text, checked, ast, child, true, binding); }; index = index + 1; }; sh_b_initialize(result, checked, ast, node, binding); sh_b_temporaries_end(result, checked, ast, node); } else if kind == 50 and sh_ast_word(ast, node, 4) % 1000 == sh_kind("&") { let operand = sh_ast_child(ast, node, 0); let previous_mode = result.access_mode; result.access_mode = 1; sh_cb_walk(fresh, result, text, checked, ast, operand, false, holder); result.access_mode = previous_mode; let operand_type = sh_s_resolve(checked, sh_node_type(checked, operand)); let receiver_reborrow = sh_s_kind(checked, operand_type) == 6 and operand_type == sh_s_resolve(checked, sh_node_type(checked, node)); let alias = if receiver_reborrow { sh_node_binding(checked, operand); } else { sh_b_access_alias(checked, ast, operand, 0); }; let parent = if alias >= 0 { sh_b_alias_loan(result, alias); } else { -1; }; let owner = if receiver_reborrow and parent >= 0 { result.loans.get(parent * 5).unwrap_or(-1); } else { sh_b_place(result, checked, ast, operand); }; sh_b_loan_from(result, checked, ast, node, owner, holder, sh_ast_word(ast, node, 4) >= 1000, parent); } else if kind == 51 { let op = sh_ast_word(ast, node, 4); let logical = op == sh_kind("and") or op == sh_kind("or") or op == sh_kind("&&") or op == sh_kind("||"); let compare = op == sh_kind("==") or op == sh_kind("!=") or op == sh_kind("<") or op == sh_kind(">") or op == sh_kind("<=") or op == sh_kind(">="); if logical { sh_cb_logical(fresh, result, text, checked, ast, node); } else { let mut index = 0; while index < sh_ast_word(ast, node, 6) { sh_cb_walk(fresh, result, text, checked, ast, sh_ast_child(ast, node, index), not compare, -1); index = index + 1; }; }; } else if kind == 52 { let target = sh_ast_child(ast, node, 0); let value = sh_ast_child(ast, node, 1); let target_path = sh_b_place(result, checked, ast, target); let target_binding = if target_path >= 0 { sh_b_path_root(result, target_path); } else { -1; }; let alias = sh_b_access_alias(checked, ast, target, 0); let authorized = if alias >= 0 { sh_b_alias_loan(result, alias); } else { -1; }; sh_cb_walk(fresh, result, text, checked, ast, value, true, target_binding); let disarmed = sh_b_detach_disarm(result, text, checked, ast, node, target, target_path); if disarmed { sh_b_action(result, ast, node, target_binding, 10, result.scope, 0); result.action_paths.set(result.action_paths.len() - 1, target_path); result.state.set(target_path, 0); (); }; if target_path >= 0 and not disarmed { let mut ancestor = result.paths.get(target_path * 4 + 1).unwrap_or(-1); while ancestor >= 0 { if (result.state.get(ancestor).unwrap_or(0) & 2) != 0 { sh_b_error(result, ast, target, 6101, target_binding, ancestor); }; ancestor = result.paths.get(ancestor * 4 + 1).unwrap_or(-1); }; let mut loan = 0; while loan < result.loans.len() { if result.loans.get(loan + 4).unwrap_or(0) != 0 and not sh_b_loan_ancestor(result, loan / 5, authorized) and sh_b_overlap(result, target_path, result.loans.get(loan).unwrap_or(-1)) { sh_b_error(result, ast, target, 6106, target_binding, result.loans.get(loan + 3).unwrap_or(-1)); }; loan = loan + 5; }; if (result.state.get(target_path).unwrap_or(0) & 1) != 0 and sh_b_drop_inner(checked, sh_node_type(checked, target), 0) { let first = sh_ownership_action_count(result); sh_b_drop_path(result, checked, ast, node, target_path, result.scope, 0, 0); let mut action = first; while action < sh_ownership_action_count(result) { if result.actions.get(action * 5 + 2).unwrap_or(0) == 3 { result.actions.set(action * 5 + 2, 6); (); }; action = action + 1; }; }; let mut child = 0; while child < result.state.len() { if child != target_path and sh_b_path_contains(result, target_path, child) { result.state.set(child, 1); (); }; child = child + 1; }; result.state.set(target_path, 1); sh_b_action(result, ast, node, target_binding, 1, result.scope, 0); result.action_paths.set(result.action_paths.len() - 1, target_path); (); }; } else if kind == 61 or kind == 65 { let condition = sh_ast_child(ast, node, 0); sh_cb_walk(fresh, result, text, checked, ast, condition, false, -1); let before = sh_b_state_copy(result); let before_loans = sh_b_loans_copy(result); let joined = vec_new_i64(); let joined_loans = vec_new_i64(); let mut falling = 0; let mut index = 1; while index < sh_ast_word(ast, node, 6) { sh_b_state_restore(result, &before); sh_b_loans_restore(result, &before_loans); result.flow = 0; sh_cb_walk(fresh, result, text, checked, ast, sh_ast_child(ast, node, index), moving, holder); if result.flow == 0 { let mut at = 0; while at < result.state.len() { let state = result.state.get(at).unwrap_or(0); if at >= joined.len() { joined.push(if falling == 0 { state; } else { sh_b_join_state(sh_b_saved_state(result, &before, at), state); }); (); } else { joined.set(at, sh_b_join_state(joined.get(at).unwrap_or(0), state)); (); }; at = at + 1; }; at = 0; while at < result.loans.len() / 5 { let active = result.loans.get(at * 5 + 4).unwrap_or(0); if at >= joined_loans.len() { joined_loans.push(active); (); } else { joined_loans.set(at, joined_loans.get(at).unwrap_or(0) | active); (); }; at = at + 1; }; falling = falling + 1; }; index = index + 1; }; if kind == 61 and sh_ast_word(ast, node, 6) < 3 { let mut at = 0; while at < result.state.len() { let state = sh_b_saved_state(result, &before, at); if at >= joined.len() { joined.push(if falling == 0 { state; } else { sh_b_join_state(sh_b_saved_state(result, &before, at), state); }); (); } else { joined.set(at, sh_b_join_state(joined.get(at).unwrap_or(0), state)); (); }; at = at + 1; }; at = 0; while at < result.loans.len() / 5 { let active = sengoo_vec_get_or_default_i64(before_loans.handle, at, 0); if at >= joined_loans.len() { joined_loans.push(active); (); } else { joined_loans.set(at, joined_loans.get(at).unwrap_or(0) | active); (); }; at = at + 1; }; falling = falling + 1; }; sh_b_state_restore(result, &joined); sh_b_loans_restore(result, &joined_loans); result.flow = if falling == 0 { 1; } else { 0; }; } else if kind == 62 or kind == 63 or kind == 64 { let body = sh_ast_child(ast, node, sh_ast_word(ast, node, 6) - 1); result.loops.push(sh_ast_word(ast, node, 2)); result.loops.push(sh_ast_word(ast, node, 3)); result.loops.push(sh_b_block_scope(checked, ast, body)); let before = sh_b_state_copy(result); let mut index = 0; while result.flow == 0 and index < sh_ast_word(ast, node, 6) { sh_cb_walk(fresh, result, text, checked, ast, sh_ast_child(ast, node, index), false, -1); index = index + 1; }; let after = sh_b_state_copy(result); let back_edge = result.flow == 0 or result.flow == 3; if result.flow != 1 { result.flow = 0; index = 0; while index < result.state.len() { let joined = sh_b_join_state(sh_b_saved_state(result, &before, index), sengoo_vec_get_or_default_i64(after.handle, index, 0)); result.state.set(index, joined); index = index + 1; }; let joined_state = sh_b_state_copy(result); let count = result.actions.len(); index = 0; while back_edge and result.flow == 0 and index < sh_ast_word(ast, node, 6) { sh_cb_walk(fresh, result, text, checked, ast, sh_ast_child(ast, node, index), false, -1); index = index + 1; }; while result.actions.len() > count { result.actions.pop(); }; while result.action_paths.len() > count / 5 { result.action_paths.pop(); }; sh_b_state_restore(result, &joined_state); result.flow = 0; }; if result.flow == 1 and kind != 64 { sh_b_state_restore(result, &before); result.flow = 0; }; result.loops.pop(); result.loops.pop(); result.loops.pop(); (); } else if kind == 42 { let op = sh_ast_word(ast, node, 4); let mut index = 0; while index < sh_ast_word(ast, node, 6) { let value = sh_ast_child(ast, node, index); sh_cb_walk(fresh, result, text, checked, ast, value, true, -1); if op == sh_kind("return") { sh_b_escape(result, checked, ast, value); }; index = index + 1; }; if op == sh_kind("return") { let function_scope = sh_binding_word(checked, result.function, 7); sh_b_cleanup(result, checked, ast, node, function_scope, true); result.flow = 1; } else if op == sh_kind("break") { let loop_scope = result.loops.get(result.loops.len() - 1).unwrap_or(result.scope); sh_b_cleanup(result, checked, ast, node, loop_scope, true); result.flow = 2; } else if op == sh_kind("continue") { let loop_scope = result.loops.get(result.loops.len() - 1).unwrap_or(result.scope); sh_b_cleanup(result, checked, ast, node, loop_scope, true); result.flow = 3; }; } else if kind == 53 { sh_cb_call(fresh, result, text, checked, ast, node, holder); } else if kind == 60 { let mut index = 1; while index < sh_ast_word(ast, node, 6) { let field = sh_ast_child(ast, node, index); let value = sh_ast_child(ast, field, 1); if value >= 0 { sh_cb_walk(fresh, result, text, checked, ast, value, true, holder); }; index = index + 1; }; } else { let mut index = 0; while index < sh_ast_word(ast, node, 6) { let child = sh_ast_child(ast, node, index); let child_kind = sh_ast_word(ast, child, 0); if child_kind < 70 or child_kind == 80 or child_kind == 81 { sh_cb_walk(fresh, result, text, checked, ast, child, if kind == 58 and sh_ast_word(ast, node, 4) == 1 or kind == 59 { true; } else { moving; }, holder); }; index = index + 1; }; };
