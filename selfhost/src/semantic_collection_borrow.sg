}

def sh_cb_call(fresh: &ShCollectionHandles, result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64, holder: i64) {
    let first_loan = result.loans.len();
    let target = sh_ast_child(ast, node, 0);
    let function = sh_node_binding(checked, node);
    let target_type = sh_s_resolve(checked, sh_node_type(checked, target));
    let fn_type = if sh_s_kind(checked, target_type) == 11 { target_type; } else { sh_s_resolve(checked, sh_binding_word(checked, function, 3)); };
    let member = sh_ast_word(ast, target, 0) == 55;
    let mut receiver = -1;
    if member { let base = sh_ast_child(ast, target, 0); if sh_b_alias_ambiguous(result, sh_node_binding(checked, base)) { sh_b_error(result, ast, base, 6111, sh_node_binding(checked, base), -1); }; let self_type = sh_s_resolve(checked, sh_s_argument(checked, fn_type, 0)); let previous_mode = result.access_mode; if sh_s_kind(checked, self_type) == 6 { result.access_mode = 1; }; sh_cb_walk(fresh, result, text, checked, ast, base, not (sh_s_kind(checked, self_type) == 6 or sh_b_contract_observes(result, checked, ast, node, 0)), -1); result.access_mode = previous_mode; let base_is_ref = sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, base))) == 6; let receiver_alias = if base_is_ref { sh_node_binding(checked, base); } else { sh_b_access_alias(checked, ast, base, 0); }; let parent = sh_b_alias_loan(result, receiver_alias); receiver = if base_is_ref and parent >= 0 { result.loans.get(parent * 5).unwrap_or(-1); } else { sh_b_place(result, checked, ast, base); }; if sh_s_kind(checked, self_type) == 6 { sh_b_loan_from(result, checked, ast, node, receiver, -1, sh_s_flags(checked, self_type) == 1, parent); }; };
    let mut index = 1;
    while index < sh_ast_word(ast, node, 6) { let argument = sh_ast_child(ast, node, index); let ordinal = index - 1 + if member { 1; } else { 0; }; let parameter = sh_s_resolve(checked, sh_s_argument(checked, fn_type, ordinal)); let observes = sh_s_kind(checked, parameter) == 6 or sh_b_contract_observes(result, checked, ast, node, ordinal) or sh_b_native_projects(checked, function, ordinal) or sh_cb_argument(fresh, checked, ast, node, argument, ordinal); let previous_projection = result.projection_context; result.projection_context = if observes { 1; } else { 0; }; sh_cb_walk(fresh, result, text, checked, ast, argument, not observes, -1); result.projection_context = previous_projection; let projected = sh_b_place(result, checked, ast, argument); if observes and sh_s_kind(checked, parameter) == 6 { let alias = sh_node_binding(checked, argument); let parent_count = result.loans.len(); let mut parent_at = 0; while alias >= 0 and parent_at < parent_count { if result.loans.get(parent_at + 1).unwrap_or(-1) == alias and result.loans.get(parent_at + 4).unwrap_or(0) != 0 { let owner = result.loans.get(parent_at).unwrap_or(-1); sh_b_loan_from(result, checked, ast, argument, owner, -1, sh_s_flags(checked, parameter) == 1, parent_at / 5); }; parent_at = parent_at + 5; }; }; index = index + 1; };
    let return_type = sh_s_resolve(checked, sh_node_type(checked, node));
    let last_argument_loan = result.loans.len();
    if sh_b_carries_borrow(checked, return_type, 0) { let mut argument_loan = first_loan; while argument_loan < last_argument_loan { if result.loans.get(argument_loan + 1).unwrap_or(-1) == -1 and result.loans.get(argument_loan + 4).unwrap_or(0) != 0 { let owner = result.loans.get(argument_loan).unwrap_or(-1); sh_b_loan_from(result, checked, ast, node, owner, holder, result.loans.get(argument_loan + 2).unwrap_or(0) != 0 and sh_b_carries_mutable_borrow(checked, return_type, 0), argument_loan / 5); }; argument_loan = argument_loan + 5; }; };
    let mut loan = first_loan;
    while loan < last_argument_loan { if result.loans.get(loan + 1).unwrap_or(-1) == -1 { result.loans.set(loan + 4, 0); (); }; loan = loan + 5; };
}

def sh_cb_operator(fresh: &ShCollectionHandles, result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64, holder: i64) {
    let first = result.loans.len();
    let signature = sh_s_resolve(checked, sh_node_callable_type(checked, node));
    let function = sh_node_binding(checked, node);
    let mut index = 0;
    while index < sh_ast_word(ast, node, 6) { let argument = sh_ast_child(ast, node, index); let parameter = sh_s_resolve(checked, sh_s_argument(checked, signature, index)); let reference = sh_s_kind(checked, parameter) == 6; let parameter_binding = sh_b_contract_parameter(checked, function, index); let observes = reference or parameter_binding >= 0 and (result.contracts.get(parameter_binding).unwrap_or(0) & 1) != 0; let previous = result.access_mode; if reference { result.access_mode = 1; }; sh_cb_walk(fresh, result, text, checked, ast, argument, not observes, -1); result.access_mode = previous; if reference { let is_ref = sh_s_kind(checked, sh_s_resolve(checked, sh_node_type(checked, argument))) == 6; let alias = if is_ref { sh_node_binding(checked, argument); } else { sh_b_access_alias(checked, ast, argument, 0); }; let parent = sh_b_alias_loan(result, alias); if sh_b_alias_ambiguous(result, alias) { sh_b_error(result, ast, argument, 6111, alias, -1); }; let path = if is_ref and parent >= 0 { result.loans.get(parent * 5).unwrap_or(-1); } else { sh_b_place(result, checked, ast, argument); }; sh_b_loan_from(result, checked, ast, node, path, -1, sh_s_flags(checked, parameter) == 1, parent); }; index = index + 1; };
    let end = result.loans.len();
    let returned = sh_node_type(checked, node);
    let mut loan = first;
    if sh_b_carries_borrow(checked, returned, 0) { while loan < end { if result.loans.get(loan + 1).unwrap_or(-1) == -1 and result.loans.get(loan + 4).unwrap_or(0) != 0 { sh_b_loan_from(result, checked, ast, node, result.loans.get(loan).unwrap_or(-1), holder, result.loans.get(loan + 2).unwrap_or(0) != 0 and sh_b_carries_mutable_borrow(checked, returned, 0), loan / 5); }; loan = loan + 5; }; };
    loan = first;
    while loan < end { if result.loans.get(loan + 1).unwrap_or(-1) == -1 { result.loans.set(loan + 4, 0); (); }; loan = loan + 5; };
}

def sh_cb_analyze(fresh: &ShCollectionHandles, analyzed: &ShModuleChecked, selected: &Vec<i64>, all_functions: bool, text: &String, ast: &ShAst, checked: &ShChecked, max_diagnostics: i64) -> ShOwnership {
    let mut result = sh_ownership_from_facts(vec_new_i64(), vec_new_i64(), vec_new_i64(), max_diagnostics);
    if max_diagnostics < 1 or max_diagnostics > 1000000 { result.error = 6110; return result; };
    if checked.error != 0 { result.error = checked.error; result.start = checked.start; result.end = checked.end; return result; };
    let mut binding = 0;
    while binding < sh_binding_count(checked) { result.last_uses.push(-1); binding = binding + 1; };
    let mut node = 0;
    while node < sh_ast_count(ast) { let resolved = sh_node_binding(checked, node); if resolved >= 0 and sh_ast_word(ast, node, 0) == 12 { let end = sh_ast_word(ast, node, 3); if end > result.last_uses.get(resolved).unwrap_or(-1) { result.last_uses.set(resolved, end); (); }; }; node = node + 1; };
    sh_b_infer_contracts(&result, checked, ast);
    binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 2) == 2 and (all_functions or sh_cb_in(selected, binding)) { result.function = binding; result.scope = sh_binding_word(checked, binding, 7); result.flow = 0; result.loans.clear(); result.loan_parents.clear(); let function = sh_binding_word(checked, binding, 4); let body = sh_s_child_kind(ast, function, 40); if body >= 0 and sh_binding_word(checked, sh_binding_word(checked, binding, 6), 2) != 7 { let mut param = 0; while param < sh_binding_count(checked) { if sh_binding_word(checked, param, 2) == 1 and sh_binding_word(checked, param, 6) == binding { sh_b_initialize(&mut result, checked, ast, sh_binding_word(checked, param, 4), param); }; param = param + 1; }; if sh_cb_complete_helper(fresh, checked, ast, binding) { let mut local = 0; while local < sh_binding_count(checked) { if sh_binding_word(checked, local, 2) == 0 and sh_binding_word(checked, local, 6) == binding { sh_b_initialize(&mut result, checked, ast, sh_binding_word(checked, local, 4), local); }; local = local + 1; }; } else { let fn_type = sh_s_resolve(checked, sh_binding_word(checked, binding, 3)); let return_type = sh_s_argument(checked, fn_type, sh_s_arity(checked, fn_type) - 1); let tail_return = sh_s_kind(checked, sh_s_resolve(checked, return_type)) != 0; sh_cb_walk(fresh, &mut result, text, checked, ast, body, tail_return, -1); if tail_return { sh_b_escape(&mut result, checked, ast, body); }; if result.flow == 0 { let scope = result.scope; sh_b_cleanup(&mut result, checked, ast, body, scope, true); }; }; }; }; binding = binding + 1; };
    result;
}

def sh_check_ownership_collections(provider: &ShCollectionProvider, mapping: &ShCollectionProviders, provider_root: &str, manifest_pin: &str, artifact_pin: &str, origins: &ShOriginFacts, loans: &ShBackingLoans, nll: &ShLoanLiveness, fresh: &ShCollectionHandles, graph: &ShModules, analyzed: &ShModuleChecked, identity: &str, digest: &str, prototype: &str, option_identity: &str, option_digest: &str, max_diagnostics: i64, development: bool) -> ShOwnership {
    if sh_collection_handles_validate(fresh, provider, mapping, provider_root, manifest_pin, artifact_pin, origins, loans, nll, graph, analyzed, identity, digest, prototype, option_identity, option_digest, development) != 0 { let mut denied = sh_ownership_from_facts(vec_new_i64(), vec_new_i64(), vec_new_i64(), max_diagnostics); denied.error = 6120; return denied; };
    let frozen_words = sh_cb_words(&analyzed.checked.types.words);
    let frozen_arguments = sh_cb_words(&analyzed.checked.types.arguments);
    let no_selection = vec_new_i64();
    let mut result = sh_cb_analyze(fresh, analyzed, &no_selection, true, &analyzed.front.expanded.text, &analyzed.front.parsed.ast, &analyzed.checked, max_diagnostics);
    let mut row = 0;
    while row < fresh.diagnostics.len() / 5 { let owner = sh_ch_at(&fresh.diagnostics, row, 5, 0); let node = sh_ch_at(&fresh.diagnostics, row, 5, 2); if sh_module_binding_source(analyzed, owner) == graph.root { sh_b_error(&mut result, &analyzed.front.parsed.ast, node, 6121, owner, sh_ch_at(&fresh.diagnostics, row, 5, 1)); }; row = row + 1; };
    if frozen_words.len() != analyzed.checked.types.words.len() or frozen_arguments.len() != analyzed.checked.types.arguments.len() or not sh_o_equal(&frozen_words, &analyzed.checked.types.words) or not sh_o_equal(&frozen_arguments, &analyzed.checked.types.arguments) { result.error = 6123; };
    result;
}

struct ShCollectionOwnership {
    ownership: ShOwnership,
    functions: Vec<i64>,
    coverage: Vec<i64>,
    error: i64,
}

def sh_check_ownership_collection_functions(provider: &ShCollectionProvider, mapping: &ShCollectionProviders, provider_root: &str, manifest_pin: &str, artifact_pin: &str, origins: &ShOriginFacts, loans: &ShBackingLoans, nll: &ShLoanLiveness, fresh: &ShCollectionHandles, graph: &ShModules, analyzed: &ShModuleChecked, identity: &str, digest: &str, prototype: &str, option_identity: &str, option_digest: &str, requested: &Vec<i64>, max_diagnostics: i64, development: bool) -> ShCollectionOwnership {
    let functions = vec_new_i64();
    let coverage = vec_new_i64();
    let mut ownership = sh_ownership_from_facts(vec_new_i64(), vec_new_i64(), vec_new_i64(), max_diagnostics);
    let checked = &analyzed.checked;
    let ast = &analyzed.front.parsed.ast;
    if requested.len() < 1 or requested.len() > 100000 or sh_collection_handles_validate(fresh, provider, mapping, provider_root, manifest_pin, artifact_pin, origins, loans, nll, graph, analyzed, identity, digest, prototype, option_identity, option_digest, development) != 0 { ownership.error = 6120; return ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: 6120 }; };
    let mut row = 0;
    while row < requested.len() { let function = sh_origin_at(requested, row); let decl = sh_binding_word(checked, function, 4); let body = sh_s_child_kind(ast, decl, 40); if sh_binding_word(checked, function, 2) != 2 or body < 0 or sh_module_binding_source(analyzed, function) < 0 or sh_cb_in(&functions, function) or sh_binding_word(checked, sh_binding_word(checked, function, 6), 2) == 7 { ownership.error = 6120; return ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: 6120 }; }; if not functions.push(function) { ownership.error = 6110; return ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: 6110 }; }; row = row + 1; };
    let frozen_words = sh_cb_words(&checked.types.words);
    let frozen_arguments = sh_cb_words(&checked.types.arguments);
    ownership = sh_cb_analyze(fresh, analyzed, &functions, false, &analyzed.front.expanded.text, ast, checked, max_diagnostics);
    row = 0;
    while row < fresh.diagnostics.len() / 5 { let owner = sh_ch_at(&fresh.diagnostics, row, 5, 0); if sh_cb_in(&functions, owner) { sh_b_error(&mut ownership, ast, sh_ch_at(&fresh.diagnostics, row, 5, 2), 6121, owner, sh_ch_at(&fresh.diagnostics, row, 5, 1)); }; row = row + 1; };
    row = 0;
    while row < functions.len() { let function = sh_origin_at(&functions, row); let declaration = sh_binding_word(checked, function, 4); let body = sh_s_child_kind(ast, declaration, 40); let mut pending = 0; let mut obligation = 0; while obligation < fresh.obligations.len() / 12 { if sh_ch_at(&fresh.obligations, obligation, 12, 0) == function { pending = pending + 1; }; obligation = obligation + 1; }; let mut error = 0; let mut diagnostic = 0; while diagnostic < ownership.diagnostics.len() { let item = ownership.diagnostics.get(diagnostic); let owner = sh_ch_owner(checked, item.node); if owner == function and error == 0 { error = item.code; }; diagnostic = diagnostic + 1; }; let helper = sh_cb_complete_helper(fresh, checked, ast, function); let stored = coverage.push(function) and coverage.push(declaration) and coverage.push(body) and coverage.push(sh_module_binding_source(analyzed, function)) and coverage.push(sh_binding_word(checked, function, 3)) and coverage.push(if helper { 2; } else { 1; }) and coverage.push(pending) and coverage.push(error); if not stored { ownership.error = 6110; return ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: 6110 }; }; row = row + 1; };
    if frozen_words.len() != checked.types.words.len() or frozen_arguments.len() != checked.types.arguments.len() or not sh_o_equal(&frozen_words, &checked.types.words) or not sh_o_equal(&frozen_arguments, &checked.types.arguments) { ownership.error = 6123; };
    let final_error = ownership.error;
    ShCollectionOwnership { ownership: ownership, functions: functions, coverage: coverage, error: final_error };
}

def sh_collection_ownership_equal(left: &ShOwnership, right: &ShOwnership) -> bool {
    if left.error != right.error or left.start != right.start or left.end != right.end or left.limit != right.limit or left.function != right.function or left.scope != right.scope or left.flow != right.flow or left.depth != right.depth or left.access_mode != right.access_mode or left.projection_context != right.projection_context or left.diagnostics.len() != right.diagnostics.len() { return false; };
    if not sh_o_equal(&left.actions, &right.actions) or not sh_o_equal(&left.action_paths, &right.action_paths) or not sh_o_equal(&left.paths, &right.paths) or not sh_o_equal(&left.state, &right.state) or not sh_o_equal(&left.loans, &right.loans) or not sh_o_equal(&left.loan_parents, &right.loan_parents) or not sh_o_equal(&left.last_uses, &right.last_uses) or not sh_o_equal(&left.loops, &right.loops) or not sh_o_equal(&left.definitions, &right.definitions) or not sh_o_equal(&left.contracts, &right.contracts) or not sh_o_equal(&left.try_scopes, &right.try_scopes) { return false; };
    let mut i = 0;
    while i < left.diagnostics.len() { let a = left.diagnostics.get(i); let b = right.diagnostics.get(i); if a.code != b.code or a.severity != b.severity or a.node != b.node or a.start != b.start or a.end != b.end or a.expected != b.expected or a.actual != b.actual { return false; }; i = i + 1; };
    true;
}

def sh_collection_ownership_validate(result: &ShCollectionOwnership, provider: &ShCollectionProvider, mapping: &ShCollectionProviders, provider_root: &str, manifest_pin: &str, artifact_pin: &str, origins: &ShOriginFacts, loans: &ShBackingLoans, nll: &ShLoanLiveness, fresh: &ShCollectionHandles, graph: &ShModules, analyzed: &ShModuleChecked, identity: &str, digest: &str, prototype: &str, option_identity: &str, option_digest: &str, requested: &Vec<i64>, max_diagnostics: i64, development: bool) -> i64 {
    let actual = sh_check_ownership_collection_functions(provider, mapping, provider_root, manifest_pin, artifact_pin, origins, loans, nll, fresh, graph, analyzed, identity, digest, prototype, option_identity, option_digest, requested, max_diagnostics, development);
    if actual.error != 0 { return actual.error; };
    if result.error != actual.error or not sh_o_equal(&result.functions, &actual.functions) or not sh_o_equal(&result.coverage, &actual.coverage) or not sh_collection_ownership_equal(&result.ownership, &actual.ownership) { return 6122; };
    0;
}

struct ShCollectionFinalized {
    schema: i64,
    error: i64,
    before_types: i64,
    after_types: i64,
    queries: i64,
    fields: Vec<i64>,
    reachable_types: Vec<i64>,
}

def sh_cf_enqueue(checked: &ShChecked, result: &mut ShCollectionFinalized, states: &Vec<i64>, ty: i64, max_types: i64) {
    if result.error != 0 { return; };
    let actual = sh_s_resolve(checked, ty);
    let count = sh_type_count(&checked.types);
    if actual < 0 or actual >= count or count > max_types { result.error = 6123; return; };
    while states.len() < count { if not states.push(0) { result.error = 6123; return; }; };
    if sengoo_vec_get_or_default_i64(states.handle, actual, -1) == 0 { if not (states.set(actual, 1) and result.reachable_types.push(actual)) { result.error = 6123; }; };
    ();
}

def sh_collection_ownership_finalize(checked: &ShChecked, ast: &ShAst, max_types: i64, max_queries: i64) -> ShCollectionFinalized {
    let before = sh_type_count(&checked.types);
    let mut result = ShCollectionFinalized { schema: 1, error: 0, before_types: before, after_types: before, queries: 0, fields: vec_new_i64(), reachable_types: vec_new_i64() };
    if checked.error != 0 or max_types < before or max_types > 100000 or max_queries < 1 or max_queries > 4000000 { result.error = 6123; return result; };
    let states = vec_new_i64();
    let mut binding = 0;
    while binding < sh_binding_count(checked) and result.error == 0 { let kind = sh_binding_word(checked, binding, 2); if kind == 0 or kind == 1 or kind == 2 or kind == 3 or kind == 4 or kind == 6 or kind == 8 or kind == 10 or kind == 11 or kind == 15 { sh_cf_enqueue(checked, &mut result, &states, sh_binding_word(checked, binding, 3), max_types); }; binding = binding + 1; };
    let mut node = 0;
    while node < sh_ast_count(ast) and result.error == 0 { let kind = sh_ast_word(ast, node, 0); let category = sh_binding_word(checked, sh_node_binding(checked, node), 2); if kind == 11 or kind == 12 and (category == 0 or category == 1) or kind >= 40 and kind <= 69 { let actual = sh_node_type(checked, node); if actual >= 0 { sh_cf_enqueue(checked, &mut result, &states, actual, max_types); }; }; node = node + 1; };
    let mut position = 0;
    while position < result.reachable_types.len() and result.error == 0 { let ty = sengoo_vec_get_or_default_i64(result.reachable_types.handle, position, -1); let mut argument = 0; while argument < sh_s_arity(checked, ty) and result.error == 0 { sh_cf_enqueue(checked, &mut result, &states, sh_s_argument(checked, ty, argument), max_types); argument = argument + 1; }; if sh_s_kind(checked, ty) == 12 { let owner = sh_adt_binding(checked, ty); if owner >= 0 { let template = sh_binding_word(checked, owner, 3); if sh_s_arity(checked, ty) != sh_s_arity(checked, template) { result.error = 6123; break; }; let parent_type = sh_class_parent(checked, ty); if parent_type >= 0 { sh_cf_enqueue(checked, &mut result, &states, parent_type, max_types); }; let mut field = 0; while field < sh_binding_count(checked) and result.error == 0 { let field_owner = sh_binding_word(checked, field, 6); let member = field_owner == owner or sh_binding_word(checked, field_owner, 2) == 5 and sh_binding_word(checked, field_owner, 6) == owner; if sh_binding_word(checked, field, 2) == 6 and member { if result.queries >= max_queries { result.error = 6123; break; }; let actual_field = sh_resolved_field_type(checked, ty, field); result.queries = result.queries + 1; sh_cf_enqueue(checked, &mut result, &states, actual_field, max_types); if not (result.fields.push(ty) and result.fields.push(field) and result.fields.push(actual_field)) { result.error = 6123; break; }; }; field = field + 1; }; }; }; position = position + 1; };
    result.after_types = sh_type_count(&checked.types);
    result;
}
