import selfhost_borrow;

import selfhost_semantic_collection_handles;

def sh_cb_words(values: &Vec<i64>) -> Vec<i64> {
    let copied = vec_new_i64();
    let mut i = 0;
    while i < values.len() { if not copied.push(sh_origin_at(values, i)) { copied.clear(); return copied; }; i = i + 1; };
    copied;
}

def sh_cb_in(values: &Vec<i64>, item: i64) -> bool {
    let mut i = 0;
    while i < values.len() { if sh_origin_at(values, i) == item { return true; }; i = i + 1; };
    false;
}

def sh_cb_argument(fresh: &ShCollectionHandles, checked: &ShChecked, ast: &ShAst, call: i64, argument: i64, ordinal: i64) -> bool {
    let status = sh_collection_handle_status(fresh, call);
    if status != 1 and status != 2 { return false; };
    let mut row = 0;
    while row < fresh.receipts.len() / 16 { if sh_ch_at(&fresh.receipts, row, 16, 0) == call and sh_ch_at(&fresh.receipts, row, 16, 3) == argument and sh_ch_at(&fresh.receipts, row, 16, 2) == sh_ch_param(checked, sh_node_binding(checked, call), ordinal) { let owner = sh_ch_at(&fresh.receipts, row, 16, 4); let covered = sh_ch_coverage(fresh, sh_node_binding(checked, call)); return covered >= 0 and sh_ch_at(&fresh.coverage, covered, 8, 5) == 1 and sh_ch_at(&fresh.receipts, row, 16, 4) == sh_ch_owner(checked, call) and sh_ch_at(&fresh.receipts, row, 16, 7) >= 0 and sh_ast_word(ast, argument, 0) == 55 and sh_o_i64(checked, sh_node_type(checked, argument)); }; row = row + 1; };
    false;
}

def sh_cb_complete_helper(fresh: &ShCollectionHandles, checked: &ShChecked, ast: &ShAst, function: i64) -> bool {
    let row = sh_ch_coverage(fresh, function);
    if row < 0 or sh_ch_at(&fresh.coverage, row, 8, 3) != 1 or sh_ch_at(&fresh.coverage, row, 8, 5) != 1 { return false; };
    let signature = sh_binding_word(checked, function, 3);
    if sh_s_data(checked, signature) != 0 or sh_s_flags(checked, signature) != 0 or sh_s_arity(checked, signature) != 3 or not sh_o_i64(checked, sh_s_argument(checked, signature, 0)) or not sh_o_i64(checked, sh_s_argument(checked, signature, 1)) or not sh_o_i64(checked, sh_s_argument(checked, signature, 2)) { return false; };
    let mut params = 0;
    let mut locals = 0;
    let mut binding = 0;
    while binding < sh_binding_count(checked) { if sh_binding_word(checked, binding, 6) == function { let kind = sh_binding_word(checked, binding, 2); let ty = sh_binding_word(checked, binding, 3); if kind == 1 { if not sh_o_i64(checked, ty) { return false; }; params = params + 1; } else if kind == 0 { if sh_b_drop_inner(checked, ty, 0) or sh_s_kind(checked, ty) != 12 { return false; }; locals = locals + 1; } else { return false; }; }; binding = binding + 1; };
    params == 2 and locals == 1;
}

def sh_cb_logical(fresh: &ShCollectionHandles, result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64) {
    sh_cb_walk(fresh, result, text, checked, ast, sh_ast_child(ast, node, 0), false, -1);
    if result.flow != 0 { return; };
    let before = sh_b_state_copy(result);
    let before_loans = sh_b_loans_copy(result);
    sh_cb_walk(fresh, result, text, checked, ast, sh_ast_child(ast, node, 1), false, -1);
    if result.flow != 0 { sh_b_state_restore(result, &before); sh_b_loans_restore(result, &before_loans); } else { let mut index = 0; while index < result.state.len() { result.state.set(index, sh_b_join_state(result.state.get(index).unwrap_or(0), sh_b_saved_state(result, &before, index))); index = index + 1; }; index = 0; while index < result.loans.len() { result.loans.set(index + 4, result.loans.get(index + 4).unwrap_or(0) | sengoo_vec_get_or_default_i64(before_loans.handle, index / 5, 0)); index = index + 5; }; };
    result.flow = 0;
}

def sh_cb_walk(fresh: &ShCollectionHandles, result: &mut ShOwnership, text: &String, checked: &ShChecked, ast: &ShAst, node: i64, moving: bool, holder: i64) {
    if node < 0 or result.flow != 0 { return; };
