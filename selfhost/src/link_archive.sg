import selfhost_link_coff;

import selfhost_link_imports;

struct ShLinkLibraries {
    bytes: Vec<i64>,
    ranges: Vec<i64>,
    limit: i64,
}

def sh_link_libraries_new(limit: i64) -> ShLinkLibraries {
    ShLinkLibraries { bytes: vec_new_i64(), ranges: vec_new_i64(), limit: limit };
}

def sh_link_archive_magic(bytes: &ShBinary) -> bool {
    if sh_binary_len(bytes) < 8 { return false; };
    sh_link_uint(bytes, 0, 8).unwrap_or(0) == 738142165265366049;
}

def sh_link_archive_be32(bytes: &ShBinary, at: i64) -> Result<i64, i64> {
    let mut value = 0;
    let mut index = 0;
    while index < 4 { value = value * 256 + sh_link_uint(bytes, at + index, 1)?; index = index + 1; };
    sh_i64_ok(value);
}

def sh_link_archive_decimal(bytes: &ShBinary, at: i64, length: i64) -> Result<i64, i64> {
    let mut index = 0;
    let mut value = 0;
    let mut digits = 0;
    let mut trailing = false;
    while index < length { let byte = sh_link_uint(bytes, at + index, 1)?; if byte >= 48 and byte <= 57 { if trailing or value > 67108864 { return sh_i64_error(7201); }; value = value * 10 + byte - 48; digits = digits + 1; } else { if byte != 32 { return sh_i64_error(7201); }; if digits > 0 { trailing = true; }; }; index = index + 1; };
    if digits == 0 or value > 67108864 { return sh_i64_error(7201); };
    sh_i64_ok(value);
}

def sh_link_archive_member(members: &Vec<i64>, offset: i64) -> i64 {
    let mut index = 0;
    while index < members.len() / 5 { if sh_link_word(members, 5, index, 0) == offset and sh_link_word(members, 5, index, 4) == 0 { return index; }; index = index + 1; };
    -1;
}

def sh_link_archive_headers(bytes: &ShBinary, members: &Vec<i64>) -> Result<i64, i64> {
    if not sh_link_archive_magic(bytes) { return sh_i64_error(7203); };
    let mut at = 8;
    let mut index_count = 0;
    while at < sh_binary_len(bytes) { if members.len() / 5 >= 65536 or sh_binary_len(bytes) - at < 60 { return sh_i64_error(7201); }; if sh_link_uint(bytes, at + 58, 1)? != 96 or sh_link_uint(bytes, at + 59, 1)? != 10 { return sh_i64_error(7201); }; let size = sh_link_archive_decimal(bytes, at + 48, 10)?; if size > sh_binary_len(bytes) - at - 60 { return sh_i64_error(7201); }; let first = sh_link_uint(bytes, at, 1)?; let second = sh_link_uint(bytes, at + 1, 1)?; let kind = if first == 47 and second == 32 { 1; } else { if first == 47 and second == 47 { 2; } else { 0; }; }; if first == 35 and second == 49 { return sh_i64_error(7203); }; if kind == 1 { index_count = index_count + 1; if index_count > 2 { return sh_i64_error(7203); }; }; sh_link_push(members, at)?; sh_link_push(members, at + 60)?; sh_link_push(members, size)?; sh_link_push(members, 0)?; sh_link_push(members, kind)?; at = at + 60 + size; if at % 2 != 0 { if sh_link_uint(bytes, at, 1)? != 10 { return sh_i64_error(7201); }; at = at + 1; }; };
    if at != sh_binary_len(bytes) or index_count < 1 { return sh_i64_error(7203); };
    sh_link_archive_names(bytes, members)?;
    sh_i64_ok(index_count);
}

def sh_link_archive_index(link: &ShLinker, bytes: &ShBinary, members: &Vec<i64>, names: &Vec<i64>) -> Result<i64, i64> {
    let mut member = 0;
    let mut encountered = 0;
    while member < members.len() / 5 { if sh_link_word(members, 5, member, 4) == 1 { let at = sh_link_word(members, 5, member, 1); let size = sh_link_word(members, 5, member, 2); let end = at + size; if size < 4 { return sh_i64_error(7201); }; if encountered == 0 { let count = sh_link_archive_be32(bytes, at)?; if count > 100000 or count * 4 > size - 4 { return sh_i64_error(7202); }; let mut text_at = at + 4 + count * 4; let mut index = 0; while index < count { let offset = sh_link_archive_be32(bytes, at + 4 + index * 4)?; let target = sh_link_archive_member(members, offset); if target < 0 { return sh_i64_error(7201); }; let name = sh_link_import_string(link, bytes, text_at, end)?; let text = sh_symbol_text(&link.names, name)?; text_at = text_at + text.len() + 1; sh_link_push(names, name)?; sh_link_push(names, target)?; index = index + 1; }; sh_link_archive_index_tail(bytes, text_at, end)?; } else { let object_count = sh_link_uint(bytes, at, 4)?; if object_count > 65536 or object_count * 4 > size - 4 { return sh_i64_error(7202); }; let mut object_index_check = 0; while object_index_check < object_count { if sh_link_archive_member(members, sh_link_uint(bytes, at + 4 + object_index_check * 4, 4)?) < 0 { return sh_i64_error(7201); }; object_index_check = object_index_check + 1; }; let count_at = at + 4 + object_count * 4; if count_at > end - 4 { return sh_i64_error(7201); }; let count = sh_link_uint(bytes, count_at, 4)?; if count > 100000 or count * 2 > end - count_at - 4 { return sh_i64_error(7202); }; if count != names.len() / 2 { return sh_i64_error(7201); }; let mut text_at = count_at + 4 + count * 2; let mut index = 0; while index < count { let object_index = sh_link_uint(bytes, count_at + 4 + index * 2, 2)?; if object_index < 1 or object_index > object_count { return sh_i64_error(7201); }; let offset = sh_link_uint(bytes, at + 4 + (object_index - 1) * 4, 4)?; let target = sh_link_archive_member(members, offset); if target < 0 { return sh_i64_error(7201); }; let name = sh_link_import_string(link, bytes, text_at, end)?; let text = sh_symbol_text(&link.names, name)?; text_at = text_at + text.len() + 1; let mut matched = 0; while matched < names.len() / 2 and (sh_link_word(names, 2, matched, 0) != name or sh_link_word(names, 2, matched, 1) != target) { matched = matched + 1; }; if matched == names.len() / 2 { return sh_i64_error(7201); }; index = index + 1; }; sh_link_archive_index_tail(bytes, text_at, end)?; }; encountered = encountered + 1; }; member = member + 1; };
    sh_i64_ok(names.len() / 2);
}

def sh_link_archive_available(link: &ShLinker, name: i64) -> bool {
    let imported = sh_link_import_find(link, name);
    if imported >= 0 { if sh_link_word(&link.imports, 9, imported, 5) == 0 or sh_link_word(&link.imports, 9, imported, 8) == name { return true; }; return false; };
    let mut symbol = 0;
    while symbol < link.symbols.len() / 6 { if sh_link_word(&link.symbols, 6, symbol, 1) == name and sh_link_word(&link.symbols, 6, symbol, 4) == 2 and sh_link_word(&link.symbols, 6, symbol, 3) != 0 { return true; }; symbol = symbol + 1; };
    false;
}

def sh_link_archive_select(names: &Vec<i64>, members: &Vec<i64>, name: i64) -> i64 {
    let mut index = 0;
    while index < names.len() / 2 { let member = sh_link_word(names, 2, index, 1); if sh_link_word(names, 2, index, 0) == name and sh_link_word(members, 5, member, 3) == 0 { return member; }; index = index + 1; };
    -1;
}

def sh_link_slice(bytes: &ShBinary, start: i64, length: i64, maximum: i64) -> Result<ShBinary, i64> {
    if start < 0 or length < 0 or start > sh_binary_len(bytes) or length > sh_binary_len(bytes) - start or length > maximum { return sh_coff_error(7201); };
    let output = sh_binary_new(maximum);
    let mut index = 0;
    while index < length { sh_binary_byte(&output, sh_link_uint(bytes, start + index, 1)?)?; index = index + 1; };
    Result { is_ok: true, value: output, error: 0 };
}

def sh_link_archive_apply(link: &mut ShLinker, bytes: &ShBinary, entry: &String) -> Result<i64, i64> {
    if link.linked { return sh_i64_error(7208); };
    let members = vec_new_i64();
    let names = vec_new_i64();
    sh_link_archive_headers(bytes, &members)?;
    sh_link_archive_index(link, bytes, &members, &names)?;
    let entry_name = sh_intern(&link.names, entry)?;
    let mut selected = 0;
    while true { let mut member = if not sh_link_archive_available(link, entry_name) { sh_link_archive_select(&names, &members, entry_name); } else { -1; }; let mut symbol = 0; while member < 0 and symbol < link.symbols.len() / 6 { let name = sh_link_word(&link.symbols, 6, symbol, 1); if sh_link_word(&link.symbols, 6, symbol, 3) == 0 and sh_link_word(&link.symbols, 6, symbol, 4) == 2 and not sh_link_archive_available(link, name) { member = sh_link_archive_select(&names, &members, name); }; symbol = symbol + 1; }; if member < 0 { break; }; let content = sh_link_slice(bytes, sh_link_word(&members, 5, member, 1), sh_link_word(&members, 5, member, 2), link.limit)?; if sh_link_uint(&content, 0, 2)? == 0 and sh_link_uint(&content, 2, 2)? == 65535 and sh_link_uint(&content, 4, 2)? == 0 { sh_link_import_object(link, &content)?; (); } else { sh_link_coff(link, &content)?; (); }; members.set(member * 5 + 3, 1); selected = selected + 1; if selected > 4096 { return sh_i64_error(7202); }; };
    sh_i64_ok(selected);
}

def sh_link_library_add(libraries: &ShLinkLibraries, bytes: &ShBinary) -> Result<i64, i64> {
    if libraries.limit < 0 or libraries.limit > 67108864 or libraries.ranges.len() / 2 >= 128 or libraries.bytes.len() > libraries.limit or sh_binary_len(bytes) > libraries.limit - libraries.bytes.len() { return sh_i64_error(7202); };
    if not sh_link_archive_magic(bytes) { return sh_i64_error(7203); };
    let first = libraries.bytes.len();
    let mut index = 0;
    while index < sh_binary_len(bytes) { sh_link_push(&libraries.bytes, sh_binary_get(bytes, index)?)?; index = index + 1; };
    sh_link_push(&libraries.ranges, first)?;
    sh_link_push(&libraries.ranges, sh_binary_len(bytes))?;
    sh_i64_ok(libraries.ranges.len() / 2 - 1);
}

def sh_link_libraries_resolve(link: &mut ShLinker, libraries: &ShLinkLibraries, entry: &String) -> Result<i64, i64> {
    let mut total = 0;
    let mut round = 0;
    while round < 4096 { let mut selected = 0; let mut library = 0; while library < libraries.ranges.len() / 2 { let first = sh_link_word(&libraries.ranges, 2, library, 0); let size = sh_link_word(&libraries.ranges, 2, library, 1); let bytes = sh_binary_new(libraries.limit); let mut index = 0; while index < size { sh_binary_byte(&bytes, sengoo_vec_get_or_default_i64(libraries.bytes.handle, first + index, -1))?; index = index + 1; }; selected = selected + sh_link_archive_apply(link, &bytes, entry)?; library = library + 1; }; total = total + selected; if selected == 0 { return sh_i64_ok(total); }; round = round + 1; };
    sh_i64_error(7202);
}

def sh_link_archive_names(bytes: &ShBinary, members: &Vec<i64>) -> Result<i64, i64> {
    let mut long_at = -1;
    let mut long_size = 0;
    let mut member = 0;
    while member < members.len() / 5 { if sh_link_word(members, 5, member, 4) == 2 { if long_at >= 0 { return sh_i64_error(7201); }; long_at = sh_link_word(members, 5, member, 1); long_size = sh_link_word(members, 5, member, 2); }; member = member + 1; };
    let mut long_offset = 0;
    let starts = vec_new_i64();
    while long_offset < long_size { if long_offset + 1 == long_size and starts.len() > 0 { let pad = sh_link_uint(bytes, long_at + long_offset, 1)?; if pad == 0 or pad == 10 { long_offset = long_offset + 1; break; }; }; sh_link_push(&starts, long_offset)?; let start = long_offset; while long_offset < long_size and sh_link_uint(bytes, long_at + long_offset, 1)? != 0 and sh_link_uint(bytes, long_at + long_offset, 1)? != 10 { let byte = sh_link_uint(bytes, long_at + long_offset, 1)?; if byte < 32 or byte == 127 { return sh_i64_error(7201); }; long_offset = long_offset + 1; }; if long_offset == start or long_offset == long_size { return sh_i64_error(7201); }; if sh_link_uint(bytes, long_at + long_offset, 1)? == 10 and sh_link_uint(bytes, long_at + long_offset - 1, 1)? != 47 { return sh_i64_error(7201); }; let buffer = ffi_buffer_new(long_offset - start)?; let mut utf8_at = start; while utf8_at < long_offset { buffer.push_u8(sh_link_uint(bytes, long_at + utf8_at, 1)?)?; utf8_at = utf8_at + 1; }; let decoded = string_from_utf8(buffer, long_offset - start); if not decoded.is_ok() { return sh_i64_error(7201); }; long_offset = long_offset + 1; };
    member = 0;
    while member < members.len() / 5 { let at = sh_link_word(members, 5, member, 0); let kind = sh_link_word(members, 5, member, 4); let mut length = 16; while length > 0 and sh_link_uint(bytes, at + length - 1, 1)? == 32 { length = length - 1; }; if length == 0 { return sh_i64_error(7201); }; let mut index = 0; while index < length { let byte = sh_link_uint(bytes, at + index, 1)?; if byte < 33 or byte > 126 { return sh_i64_error(7201); }; index = index + 1; }; if kind == 1 { if length != 1 or member > 1 { return sh_i64_error(7201); }; } else { if kind == 2 { if length != 2 { return sh_i64_error(7201); }; } else { if sh_link_uint(bytes, at, 1)? == 47 { if length < 2 or long_at < 0 { return sh_i64_error(7201); }; let offset = sh_link_archive_decimal(bytes, at + 1, length - 1)?; let mut found = 0; while found < starts.len() and sengoo_vec_get_or_default_i64(starts.handle, found, -1) != offset { found = found + 1; }; if found == starts.len() { return sh_i64_error(7201); }; }; }; }; member = member + 1; };
    sh_i64_ok(members.len() / 5);
}

def sh_link_archive_index_tail(bytes: &ShBinary, at: i64, end: i64) -> Result<i64, i64> {
    if at == end { return sh_i64_ok(0); };
    if at + 1 == end and sh_link_uint(bytes, at, 1)? == 0 { return sh_i64_ok(0); };
    sh_i64_error(7201);
}
