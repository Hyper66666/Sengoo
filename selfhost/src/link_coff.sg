import selfhost_link_model;

def sh_link_interval(intervals: &Vec<i64>, start: i64, length: i64, total: i64) -> Result<i64, i64> {
    if start < 0 or length < 0 or start > total or length > total - start { return sh_i64_error(7201); };
    if length == 0 { return sh_i64_ok(0); };
    let mut index = 0;
    while index < intervals.len() { let old_start = sengoo_vec_get_or_default_i64(intervals.handle, index, -1); let old_end = sengoo_vec_get_or_default_i64(intervals.handle, index + 1, -1); if start < old_end and old_start < start + length { return sh_i64_error(7201); }; index = index + 2; };
    sh_link_push(intervals, start)?;
    sh_link_push(intervals, start + length)?;
    sh_i64_ok(start);
}

def sh_link_coff_name(link: &ShLinker, bytes: &ShBinary, field: i64, strings: i64, string_length: i64, section: bool) -> Result<i64, i64> {
    let mut start = field;
    let mut end = field + 8;
    let mut long = false;
    let mut offset = 0;
    if section and sh_link_uint(bytes, field, 1)? == 47 { let mut index = 1; while index < 8 { let byte = sh_link_uint(bytes, field + index, 1)?; if byte == 0 { break; }; if byte < 48 or byte > 57 { return sh_i64_error(7201); }; offset = offset * 10 + byte - 48; index = index + 1; }; long = true; } else { if not section and sh_link_uint(bytes, field, 4)? == 0 { offset = sh_link_uint(bytes, field + 4, 4)?; long = true; }; };
    if long { if offset < 4 or offset >= string_length { return sh_i64_error(7201); }; start = strings + offset; end = strings + string_length; };
    let mut length = 0;
    while start + length < end and sh_link_uint(bytes, start + length, 1)? != 0 { length = length + 1; if length > 1048576 { return sh_i64_error(7202); }; };
    if length == 0 or long and start + length == end { return sh_i64_error(7201); };
    let buffer = ffi_buffer_new(length)?;
    let mut index = 0;
    while index < length { buffer.push_u8(sh_link_uint(bytes, start + index, 1)?)?; index = index + 1; };
    let decoded = string_from_utf8(buffer, length);
    if not decoded.is_ok() { return sh_i64_error(7201); };
    sh_intern(&link.names, &decoded.value);
}

def sh_link_coff_leaf_file(bytes: &ShBinary, at: i64, count: i64) -> Result<i64, i64> {
    if count < 1 or count > 64 { return sh_i64_error(7203); };
    let b = ffi_buffer_new(1024)?;
    let mut i = 0;
    let mut ended = false;
    while i < count * 18 { let byte = sh_link_uint(bytes, at + i, 1)?; if ended { if byte != 0 { return sh_i64_error(7201); }; } else { if byte == 0 { ended = true; } else { if i >= 1024 { return sh_i64_error(7202); }; b.push_u8(byte)?; (); }; }; i = i + 1; };
    if b.used_len() == 0 { return sh_i64_error(7201); };
    let used = b.used_len();
    let text = string_from_utf8(b, used);
    if not text.is_ok() { return sh_i64_error(7201); };
    sh_i64_ok(0);
}

def sh_link_coff_inner(link: &mut ShLinker, bytes: &ShBinary) -> Result<i64, i64> {
    let length = sh_binary_len(bytes);
    if link.error != 0 { return sh_i64_error(link.error); };
    if link.linked { return sh_i64_error(7208); };
    if link.objects >= 128 or length > link.limit or link.limit < 0 or link.limit > 67108864 { return sh_i64_error(7202); };
    if length < 20 { return sh_i64_error(7201); };
    let machine = sh_link_uint(bytes, 0, 2)?;
    if machine != 34404 or sh_link_uint(bytes, 16, 2)? != 0 or sh_link_uint(bytes, 18, 2)? != 0 { return sh_i64_error(7203); };
    let sections = sh_link_uint(bytes, 2, 2)?;
    let symbols_at = sh_link_uint(bytes, 8, 4)?;
    let symbols = sh_link_uint(bytes, 12, 4)?;
    if sections < 1 or sections > 1024 or symbols > 100000 { return sh_i64_error(7202); };
    let header_end = 20 + sections * 40;
    if header_end > length or symbols_at < header_end or symbols_at > length or symbols * 18 > length - symbols_at { return sh_i64_error(7201); };
    let strings = symbols_at + symbols * 18;
    let string_length = sh_link_uint(bytes, strings, 4)?;
    if string_length < 4 or string_length > length - strings { return sh_i64_error(7201); };
    let intervals = vec_new_i64();
    sh_link_interval(&intervals, 0, header_end, length)?;
    sh_link_interval(&intervals, symbols_at, symbols * 18 + string_length, length)?;
    let object = link.objects;
    let section_map = vec_new_i64();
    let symbol_map = vec_new_i64();
    let symbol_kind = vec_new_i64();
    let section_aux = vec_new_i64();
    let mut index = 0;
    while index < symbols { sh_link_push(&symbol_map, -1)?; sh_link_push(&symbol_kind, 0)?; index = index + 1; };
    let mut section = 0;
    while section < sections { let row = 20 + section * 40; let name = sh_link_coff_name(link, bytes, row, strings, string_length, true)?; if sh_link_name_equal(link, name, ".reloc") or sh_link_name_equal(link, name, ".idata") or sh_link_name_equal(link, name, ".drectve") { return sh_i64_error(7203); }; if sh_link_uint(bytes, row + 8, 4)? != 0 or sh_link_uint(bytes, row + 12, 4)? != 0 or sh_link_uint(bytes, row + 28, 4)? != 0 or sh_link_uint(bytes, row + 34, 2)? != 0 { return sh_i64_error(7203); }; let size = sh_link_uint(bytes, row + 16, 4)?; let raw = sh_link_uint(bytes, row + 20, 4)?; let rel_at = sh_link_uint(bytes, row + 24, 4)?; let rel_count = sh_link_uint(bytes, row + 32, 2)?; let flags = sh_link_uint(bytes, row + 36, 4)?; let metadata = sh_link_name_equal(link, name, ".llvm_addrsig"); let bss = (flags & 128) != 0; if size > link.limit or size > link.limit - link.data.len() { return sh_i64_error(7202); }; if size == 0 and rel_count > 0 { return sh_i64_error(7201); }; if metadata { if flags != 1050624 or rel_count != 0 or rel_at != 0 { return sh_i64_error(7203); }; if size > symbols * 3 { return sh_i64_error(7202); }; } else { if (flags & 16784128) != 0 or (flags & 224) == 0 { return sh_i64_error(7203); }; if bss and ((flags & 96) != 0 or (flags & 536870912) != 0 or (flags & 1073741824) == 0 or (flags & 2147483648) == 0 or raw != 0 or rel_at != 0 or rel_count != 0) { return sh_i64_error(7203); }; }; let encoded = (flags >> 20) & 15; if encoded == 15 { return sh_i64_error(7203); }; let alignment = if encoded == 0 { 16; } else { 1 << (encoded - 1); }; if not bss { if size > 0 { sh_link_interval(&intervals, raw, size, length)?; (); } else { if raw > length { return sh_i64_error(7201); }; }; }; if rel_count > 0 { sh_link_interval(&intervals, rel_at, rel_count * 10, length)?; (); } else { if rel_at > length { return sh_i64_error(7201); }; }; let content = sh_binary_new(link.limit); index = 0; if not metadata and size > 0 { while index < size { sh_binary_byte(&content, if bss { 0; } else { sh_link_uint(bytes, raw + index, 1)?; })?; index = index + 1; }; let actual = sh_link_add_section(link, object, name, &content, flags & 4279238655, alignment)?; sh_link_push(&section_map, actual)?; } else { sh_link_push(&section_map, -1)?; }; sh_link_push(&section_aux, 0)?; section = section + 1; };
    let mut symbol = 0;
    while symbol < symbols { let row = symbols_at + symbol * 18; let name = sh_link_coff_name(link, bytes, row, strings, string_length, false)?; let value = sh_link_uint(bytes, row + 8, 4)?; let signed = sh_link_uint(bytes, row + 12, 2)?; let mut sec = if signed >= 32768 { signed - 65536; } else { signed; }; let ty = sh_link_uint(bytes, row + 14, 2)?; let storage = sh_link_uint(bytes, row + 16, 1)?; let auxiliary = sh_link_uint(bytes, row + 17, 1)?; if auxiliary > symbols - symbol - 1 { return sh_i64_error(7201); }; if storage == 103 { if not sh_link_name_equal(link, name, ".file") or value != 0 or sec != -2 or ty != 0 { return sh_i64_error(7203); }; sh_link_coff_leaf_file(bytes, row + 18, auxiliary)?; symbol_kind.set(symbol, 3); } else { if ty != 0 and ty != 32 or storage != 2 and storage != 3 or sec < -1 or sec > sections or sec == 0 and value != 0 or storage == 3 and sec == 0 { return sh_i64_error(7203); }; if auxiliary != 0 { if auxiliary != 1 or storage != 3 or ty != 0 or sec <= 0 or value != 0 { return sh_i64_error(7203); }; let section_row = 20 + (sec - 1) * 40; let expected = sh_link_coff_name(link, bytes, section_row, strings, string_length, true)?; if name != expected or sengoo_vec_get_or_default_i64(section_aux.handle, sec - 1, 1) != 0 { return sh_i64_error(7201); }; let aux = row + 18; if sh_link_uint(bytes, aux, 4)? != sh_link_uint(bytes, section_row + 16, 4)? or sh_link_uint(bytes, aux + 4, 2)? != sh_link_uint(bytes, section_row + 32, 2)? or sh_link_uint(bytes, aux + 6, 2)? != 0 or sh_link_uint(bytes, aux + 12, 2)? != sec or sh_link_uint(bytes, aux + 15, 1)? != 0 or sh_link_uint(bytes, aux + 16, 2)? != 0 { return sh_i64_error(7201); }; if sh_link_uint(bytes, aux + 14, 1)? != 0 { return sh_i64_error(7203); }; section_aux.set(sec - 1, 1); (); }; if sec > 0 { let global = sengoo_vec_get_or_default_i64(section_map.handle, sec - 1, -1); if global < 0 { if auxiliary != 1 or storage != 3 { return sh_i64_error(7203); }; symbol_kind.set(symbol, 4); } else { if value > sh_link_word(&link.sections, 10, global, 3) { return sh_i64_error(7201); }; sec = global + 1; let actual = sh_link_add_symbol(link, object, name, value, sec, storage)?; symbol_map.set(symbol, actual); symbol_kind.set(symbol, 1); }; } else { let actual = sh_link_add_symbol(link, object, name, value, sec, storage)?; symbol_map.set(symbol, actual); symbol_kind.set(symbol, 1); }; }; let mut aux = 0; while aux < auxiliary { symbol_kind.set(symbol + aux + 1, 2); aux = aux + 1; }; symbol = symbol + 1 + auxiliary; };
    section = 0;
    while section < sections { let row = 20 + section * 40; let global = sengoo_vec_get_or_default_i64(section_map.handle, section, -1); let rel_at = sh_link_uint(bytes, row + 24, 4)?; let rel_count = sh_link_uint(bytes, row + 32, 2)?; if global < 0 { let raw = sh_link_uint(bytes, row + 20, 4)?; let size = sh_link_uint(bytes, row + 16, 4)?; let mut cursor = 0; let mut entries = 0; while cursor < size { if entries >= symbols { return sh_i64_error(7202); }; entries = entries + 1; let mut value = 0; let mut shift = 0; let mut ended = false; let mut groups = 0; while not ended { if cursor >= size or groups >= 3 { return sh_i64_error(7201); }; let byte = sh_link_uint(bytes, raw + cursor, 1)?; cursor = cursor + 1; groups = groups + 1; let payload = byte & 127; value = value | (payload << shift); if byte < 128 { if groups > 1 and payload == 0 { return sh_i64_error(7201); }; ended = true; } else { shift = shift + 7; }; }; if value >= symbols or sengoo_vec_get_or_default_i64(symbol_kind.handle, value, 0) != 1 { return sh_i64_error(7201); }; }; } else { let size = sh_link_word(&link.sections, 10, global, 3); let fields = vec_new_i64(); index = 0; while index < rel_count { let relocation = rel_at + index * 10; let offset = sh_link_uint(bytes, relocation, 4)?; let target = sh_link_uint(bytes, relocation + 4, 4)?; let kind = sh_link_uint(bytes, relocation + 8, 2)?; let width = sh_object_relocation_width(kind); if kind != 0 and width < 0 { return sh_i64_error(7203); }; if kind != 0 { if target >= symbols or sengoo_vec_get_or_default_i64(symbol_kind.handle, target, 0) != 1 or offset > size or width > size - offset { return sh_i64_error(7201); }; sh_link_interval(&fields, offset, width, size)?; sh_link_add_relocation(link, global, offset, sengoo_vec_get_or_default_i64(symbol_map.handle, target, -1), kind)?; (); }; index = index + 1; }; }; section = section + 1; };
    link.objects = link.objects + 1;
    sh_i64_ok(object);
}

def sh_link_coff(link: &mut ShLinker, bytes: &ShBinary) -> Result<i64, i64> {
    let result = sh_link_coff_inner(link, bytes);
    if not result.is_ok() { sh_link_fail(link, result.error, 0); (); };
    result;
}
