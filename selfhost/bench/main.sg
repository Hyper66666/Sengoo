import library;

def main() -> i64 {
    let mut index = 0;
    let mut total = 0;
    while index < 1000000 { total = total + bench_score(BenchItem { value: index % 17 }); index = index + 1; };
    if total == 24999892 and bench_revision() > 0 { println("selfhost baseline runtime: ok"); println(bench_revision()); 0; } else { 1; };
}
