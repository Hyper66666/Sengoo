import tar;
extern "C" {
    unsafe fn sengoo_ds_word_get(bytes: * mut u8, index: i64) -> i64;
    unsafe fn sengoo_ds_word_put(bytes: * mut u8, index: i64, value: i64);
    unsafe fn sengoo_ts_mut_offset(bytes: * mut u8, offset: i64) -> * mut u8;
    unsafe fn sengoo_ts_const_offset(bytes: * mut u8, offset: i64) -> * const u8;
} // prefix1024/header512/metadata1MiB/long64KiB/PAX64KiB/records480000/paths16MiB.
pub unsafe extern "C" fn sengoo_sg_tar_stream_init(state: * mut u8, extent: i64) -> i64 {
    if extent != 18438400 {
        return - 3;
    };
    let mut at = 0;
    while at < 128 {
        sengoo_ds_word_put(state, at, 0);
        at = at + 1;
    };
    sengoo_ds_word_put(state, 0, 1398030641);
    0;
}
pub unsafe extern "C" fn sengoo_sg_tar_stream_reset(state: * mut u8, extent: i64) -> i64 {
    sengoo_sg_tar_stream_init(state, extent);
}
pub unsafe extern "C" fn sengoo_sg_tar_stream_dispose(state: * mut u8, extent: i64) -> i64 {
    if extent != 18438400 {
        return - 3;
    };
    let mut at = 0;
    while at < 128 {
        sengoo_ds_word_put(state, at, 0);
        at = at + 1;
    };
    0;
}
pub unsafe extern "C" fn sengoo_sg_tar_stream_query(state: * mut u8, extent: i64, field: i64) -> i64 {
    if extent != 18438400 or field < 0 or field > 14 {
        return - 3;
    };
    if sengoo_ds_word_get(state, 0) != 1398030641 {
        return - 10;
    };
    if field == 0 {
        return sengoo_ds_word_get(state, 8);
    };
    if field == 1 {
        return sengoo_ds_word_get(state, 10);
    };
    if field == 2 {
        return sengoo_ds_word_get(state, 11);
    };
    if field == 3 {
        return sengoo_ds_word_get(state, 12);
    };
    if field == 4 {
        return sengoo_ds_word_get(state, 26);
    };
    if field == 5 {
        return sengoo_ds_word_get(state, 1);
    };
    if field == 6 {
        return 18438400;
    };
    if field < 14 {
        return sengoo_ds_word_get(state, 28 + field - 7);
    };
    sengoo_ds_word_get(state, 35);
}
unsafe extern "C" fn sh_ts_return(state: * mut u8, result: i64) -> i64 {
    sengoo_ds_word_put(state, 26, result);
    if result < 0 {
        sengoo_ds_word_put(state, 27, result);
        sengoo_ds_word_put(state, 1, 9);
    };
    result;
}
pub unsafe extern "C" fn sengoo_sg_tar_stream_ack(state: * mut u8, extent: i64, result: i64) -> i64 {
    if extent != 18438400 or (result != 0 and result != - 8 and result != - 9) {
        return - 3;
    };
    if sengoo_ds_word_get(state, 0) != 1398030641 {
        return - 10;
    };
    let phase = sengoo_ds_word_get(state, 1);
    if phase != 6 and phase != 7 {
        return - 3;
    };
    if result < 0 {
        return sh_ts_return(state, result);
    };
    sengoo_ds_word_put(state, 1, 3);
    sengoo_ds_word_put(state, 26, 0);
    0;
}
unsafe extern "C" fn sh_ts_pax(state: * mut u8, size: i64) -> i64 {
    let input = sengoo_ts_const_offset(state, 1536);
    let mut cursor = 0;
    while cursor < size {
        let begin = cursor;
        let mut digits = 0;
        let mut record = 0;
        while cursor < size {
            let byte = sengoo_tar_read(input, cursor) as i64;
            if byte == 32 {
                break;
            };
            if byte < 48 or byte > 57 or record > 1048576 {
                return - 1;
            };
            record = record * 10 + byte - 48;
            cursor = cursor + 1;
            digits = digits + 1;
        };
        if digits == 0 or record < digits + 4 or record > size - begin {
            return - 1;
        };
        let end = begin + record;
        if (sengoo_tar_read(input, end - 1) as i64) != 10 {
            return - 1;
        };
        cursor = cursor + 1;
        let key = cursor;
        while cursor < end - 1 and (sengoo_tar_read(input, cursor) as i64) != 61 {
            cursor = cursor + 1;
        };
        if cursor == key or cursor >= end - 1 {
            return - 1;
        };
        let key_size = cursor - key;
        cursor = cursor + 1;
        let value_size = end - 1 - cursor;
        if key_size == 4 {
            let a = sengoo_tar_read(input, key) as i64;
            let b = sengoo_tar_read(input, key + 1) as i64;
            let c = sengoo_tar_read(input, key + 2) as i64;
            let d = sengoo_tar_read(input, key + 3) as i64;
            if a == 112 and b == 97 and c == 116 and d == 104 and sengoo_ds_word_get(state, 21) == 0 {
                if value_size > 65535 {
                    return - 4;
                };
                let mut at = 0;
                while at < value_size {
                    sengoo_tar_write(state, 1115648 + at, sengoo_tar_read(input, cursor + at));
                    at = at + 1;
                };
                sengoo_ds_word_put(state, 21, 1);
                sengoo_ds_word_put(state, 22, value_size);
            };
            if a == 115 and b == 105 and c == 122 and d == 101 and sengoo_ds_word_get(state, 24) == 0 {
                let value = sh_tar_decimal(input, cursor, value_size);
                if value < 0 {
                    return - 1;
                };
                sengoo_ds_word_put(state, 23, value);
                sengoo_ds_word_put(state, 24, 1);
            };
        };
        cursor = end;
    };
    0;
}
unsafe extern "C" fn sh_ts_header(state: * mut u8) -> i64 {
    let header = sengoo_ts_const_offset(state, 1024);
    let mut at = 0;
    let mut sum = 0;
    let mut nonzero = false;
    while at < 512 {
        let byte = sengoo_tar_read(header, at) as i64;
        if byte != 0 {
            nonzero = true;
        };
        sum = sum + if at >= 148 and at < 156 {
            32;
        } else {
            byte;
        };
        at = at + 1;
    };
    if not nonzero {
        if sengoo_ds_word_get(state, 18) != 0 or sengoo_ds_word_get(state, 20) != 0 {
            return - 1;
        };
        sengoo_ds_word_put(state, 25, 512);
        sengoo_ds_word_put(state, 1, 5);
        return 0;
    };
    if (sengoo_tar_read(header, 148) as i64) >= 128 or sh_tar_number(header, 148, 8) != sum {
        return - 1;
    };
    let kind = sengoo_tar_read(header, 156) as i64;
    let mut size = sh_tar_number(header, 124, 12);
    if size < 0 {
        return - 1;
    };
    let ustar = (sengoo_tar_read(header, 257) as i64) == 117 and (sengoo_tar_read(header, 258) as i64) == 115 and (sengoo_tar_read(header,
    259) as i64) == 116 and (sengoo_tar_read(header, 260) as i64) == 97 and (sengoo_tar_read(header,
    261) as i64) == 114;
    let posix = ustar and (sengoo_tar_read(header, 262) as i64) == 0 and (sengoo_tar_read(header, 263) as i64) == 48 and (sengoo_tar_read(header,
    264) as i64) == 48;
    let gnu = ustar and (sengoo_tar_read(header, 262) as i64) == 32 and (sengoo_tar_read(header, 263) as i64) == 32 and (sengoo_tar_read(header,
    264) as i64) == 0;
    if (kind == 76 or kind == 120) and (posix or gnu) {
        let metadata = sengoo_ds_word_get(state, 13);
        if size > 1048576 or metadata > 16777216 - size {
            return - 7;
        };
        if kind == 76 and sengoo_ds_word_get(state, 18) != 0 {
            return - 1;
        };
        if kind == 120 and sengoo_ds_word_get(state, 20) != 0 {
            return - 1;
        };
        sengoo_ds_word_put(state, 13, metadata + size);
        sengoo_ds_word_put(state, 15, size);
        sengoo_ds_word_put(state, 16, 0);
        sengoo_ds_word_put(state, 17, kind);
        sengoo_ds_word_put(state, 1, 1);
        return 0;
    };
    if kind != 0 and kind != 48 and kind != 53 {
        return - 5;
    };
    if sengoo_ds_word_get(state, 24) == 1 {
        size = sengoo_ds_word_get(state, 23);
    };
    let count = sengoo_ds_word_get(state, 12);
    let content = sengoo_ds_word_get(state, 11);
    if count >= 10000 or size > 268435456 - content {
        return - 7;
    };
    if kind == 53 and size != 0 {
        return - 5;
    };
    let mut source = header;
    let mut name_size = sh_tar_string_length(header, 0, 100);
    let mut prefix_size = 0;
    if sengoo_ds_word_get(state, 18) == 1 {
        source = sengoo_ts_const_offset(state, 1050112);
        name_size = sengoo_ds_word_get(state, 19);
    } else if sengoo_ds_word_get(state, 21) == 1 {
        source = sengoo_ts_const_offset(state, 1115648);
        name_size = sengoo_ds_word_get(state, 22);
    } else if posix {
        prefix_size = sh_tar_string_length(header, 345, 155);
    };
    let total = name_size + if prefix_size > 0 {
        prefix_size + 1;
    } else {
        0;
    };
    let path_used = sengoo_ds_word_get(state, 14);
    if total > 65535 {
        return - 4;
    };
    if total > 16777216 - path_used {
        return - 7;
    };
    let paths = sengoo_ts_mut_offset(state, 1661184);
    at = 0;
    while at < prefix_size {
        sengoo_tar_write(paths, path_used + at, sengoo_tar_read(header, 345 + at));
        at = at + 1;
    };
    if prefix_size > 0 {
        sengoo_tar_write(paths, path_used + at, 47 as u8);
        at = at + 1;
    };
    let mut n = 0;
    while n < name_size {
        sengoo_tar_write(paths, path_used + at + n, sengoo_tar_read(source, n));
        n = n + 1;
    };
    let normalized = sh_tar_path(paths, path_used, total);
    if normalized < 0 {
        return normalized;
    };
    let table = sengoo_ts_mut_offset(state, 1181184);
    let mut previous = 0;
    let mut previous_path = 0;
    let mut first = sengoo_tar_output_read(paths, path_used) as i64;
    if first >= 65 and first <= 90 {
        first = first + 32;
    };
    while previous < count {
        let row = previous * 48;
        let old_length = (sengoo_tar_output_read(table, row + 32) as i64) | ((sengoo_tar_output_read(table,
        row + 33) as i64) << 8);
        let mut old_first = sengoo_tar_output_read(paths, previous_path) as i64;
        if old_first >= 65 and old_first <= 90 {
            old_first = old_first + 32;
        };
        if first == old_first or first >= 128 or old_first >= 128 {
            let relation = sh_tar_relation(paths, previous_path, old_length, path_used, normalized);
            if relation == 1 or (relation == 3 and kind != 53) {
                return - 6;
            };
            if relation == 2 and (sengoo_tar_output_read(table, row + 40) as i64) == 0 {
                return - 6;
            };
        };
        previous_path = previous_path + old_length;
        previous = previous + 1;
    };
    let wire = sengoo_ds_word_get(state, 10);
    let row = count * 48;
    sh_tar_put64(table, row, wire - 512);
    sh_tar_put64(table, row + 8, wire);
    sh_tar_put64(table, row + 16, size);
    sh_tar_put64(table, row + 24, path_used);
    sh_tar_put64(table, row + 32, normalized);
    sh_tar_put64(table, row + 40, if kind == 53 {
        1;
    } else {
        0;
    });
    sengoo_ds_word_put(state, 28, 1661184 + path_used);
    sengoo_ds_word_put(state, 29, normalized);
    sengoo_ds_word_put(state, 30, if kind == 53 {
        1;
    } else {
        0;
    });
    sengoo_ds_word_put(state, 31, size);
    sengoo_ds_word_put(state, 32, 0);
    sengoo_ds_word_put(state, 33, 0);
    sengoo_ds_word_put(state, 34, count);
    sengoo_ds_word_put(state, 12, count + 1);
    sengoo_ds_word_put(state, 11, content + size);
    sengoo_ds_word_put(state, 14, path_used + normalized);
    sengoo_ds_word_put(state, 15, size);
    sengoo_ds_word_put(state, 16, (512 - (size & 511)) & 511);
    sengoo_ds_word_put(state, 18, 0);
    sengoo_ds_word_put(state, 19, 0);
    sengoo_ds_word_put(state, 20, 0);
    sengoo_ds_word_put(state, 21, 0);
    sengoo_ds_word_put(state, 22, 0);
    sengoo_ds_word_put(state, 23, 0);
    sengoo_ds_word_put(state, 24, 0);
    sengoo_ds_word_put(state, 1, 6);
    return 3;
}
pub unsafe extern "C" fn sengoo_sg_tar_stream_step(state: * mut u8, extent: i64, source: * const u8,
length: i64, finish: i64) -> i64 {
    if extent != 18438400 or length < 0 or length > 67108864 or finish < 0 or finish > 1 {
        return - 3;
    };
    if sengoo_ds_word_get(state, 0) != 1398030641 {
        return - 10;
    };
    let previous = sengoo_ds_word_get(state, 1);
    if previous == 6 or previous == 7 {
        return - 3;
    };
    if sengoo_ds_word_get(state, 5) == 1 and finish == 0 {
        return - 3;
    };
    sengoo_ds_word_put(state, 5, finish);
    sengoo_ds_word_put(state, 8, 0);
    let error = sengoo_ds_word_get(state, 27);
    if error < 0 {
        return error;
    };
    loop {
        let phase = sengoo_ds_word_get(state, 1);
        let used = sengoo_ds_word_get(state, 8);
        let wire = sengoo_ds_word_get(state, 10);
        if wire < 0 or wire > 536870912 or used < 0 or used > length {
            return sh_ts_return(state, - 10);
        };
        if phase == 8 {
            return sh_ts_return(state, 2);
        };
        if phase == 0 {
            let index = sengoo_ds_word_get(state, 9);
            if index < 0 or index > 511 {
                return sh_ts_return(state, - 10);
            };
            if used == length {
                return sh_ts_return(state, if finish == 1 {
                    - 1;
                } else {
                    0;
                });
            };
            if wire == 536870912 {
                return sh_ts_return(state, - 7);
            };
            sengoo_tar_write(state, 1024 + index, sengoo_tar_read(source, used));
            sengoo_ds_word_put(state, 8, used + 1);
            sengoo_ds_word_put(state, 10, wire + 1);
            sengoo_ds_word_put(state, 9, index + 1);
            if index == 511 {
                sengoo_ds_word_put(state, 9, 0);
                let result = sh_ts_header(state);
                if result < 0 or result == 3 {
                    return sh_ts_return(state, result);
                };
            };
        } else if phase == 1 {
            let size = sengoo_ds_word_get(state, 15);
            let index = sengoo_ds_word_get(state, 16);
            if size < 0 or size > 1048576 or index < 0 or index > size {
                return sh_ts_return(state, - 10);
            };
            if index == size {
                let kind = sengoo_ds_word_get(state, 17);
                if kind == 76 {
                    if size < 1 {
                        return sh_ts_return(state, - 1);
                    };
                    let mut count = size;
                    if (sengoo_tar_output_read(state, 1536 + size - 1) as i64) == 0 {
                        count = count - 1;
                    };
                    if count > 65535 {
                        return sh_ts_return(state, - 4);
                    };
                    let mut at = 0;
                    while at < count {
                        sengoo_tar_write(state, 1050112 + at, sengoo_tar_output_read(state, 1536 + at));
                        at = at + 1;
                    };
                    sengoo_ds_word_put(state, 18, 1);
                    sengoo_ds_word_put(state, 19, count);
                } else {
                    let error = sh_ts_pax(state, size);
                    if error < 0 {
                        return sh_ts_return(state, error);
                    };
                    sengoo_ds_word_put(state, 20, 1);
                };
                sengoo_ds_word_put(state, 16, (512 - (size & 511)) & 511);
                sengoo_ds_word_put(state, 1, 2);
            } else {
                if used == length {
                    return sh_ts_return(state, if finish == 1 {
                        - 1;
                    } else {
                        0;
                    });
                };
                if wire == 536870912 {
                    return sh_ts_return(state, - 7);
                };
                sengoo_tar_write(state, 1536 + index, sengoo_tar_read(source, used));
                sengoo_ds_word_put(state, 16, index + 1);
                sengoo_ds_word_put(state, 8, used + 1);
                sengoo_ds_word_put(state, 10, wire + 1);
            };
        } else if phase == 2 or phase == 4 {
            let remaining = sengoo_ds_word_get(state, 16);
            if remaining < 0 or remaining > 511 {
                return sh_ts_return(state, - 10);
            };
            if remaining == 0 {
                sengoo_ds_word_put(state, 1, 0);
            } else {
                if used == length {
                    return sh_ts_return(state, if finish == 1 {
                        - 1;
                    } else {
                        0;
                    });
                };
                let mut amount = length - used;
                if amount > remaining {
                    amount = remaining;
                };
                if amount > 536870912 - wire {
                    return sh_ts_return(state, - 7);
                };
                sengoo_ds_word_put(state, 16, remaining - amount);
                sengoo_ds_word_put(state, 8, used + amount);
                sengoo_ds_word_put(state, 10, wire + amount);
            };
        } else if phase == 3 {
            let remaining = sengoo_ds_word_get(state, 15);
            if remaining < 0 or remaining > 268435456 {
                return sh_ts_return(state, - 10);
            };
            if remaining == 0 {
                sengoo_ds_word_put(state, 1, 4);
            } else {
                if used == length {
                    return sh_ts_return(state, if finish == 1 {
                        - 1;
                    } else {
                        0;
                    });
                };
                let mut amount = length - used;
                if amount > remaining {
                    amount = remaining;
                };
                if amount > 536870912 - wire {
                    return sh_ts_return(state, - 7);
                };
                sengoo_ds_word_put(state, 32, used);
                sengoo_ds_word_put(state, 33, amount);
                sengoo_ds_word_put(state, 15, remaining - amount);
                sengoo_ds_word_put(state, 8, used + amount);
                sengoo_ds_word_put(state, 10, wire + amount);
                sengoo_ds_word_put(state, 35, sengoo_ds_word_get(state, 35) + amount);
                sengoo_ds_word_put(state, 1, 7);
                return sh_ts_return(state, 4);
            };
        } else if phase == 5 {
            if used == length {
                if finish == 0 {
                    return sh_ts_return(state, 0);
                };
                if sengoo_ds_word_get(state, 25) < 1024 {
                    return sh_ts_return(state, - 1);
                };
                sengoo_ds_word_put(state, 1, 8);
                return sh_ts_return(state, 2);
            };
            if wire == 536870912 {
                return sh_ts_return(state, - 7);
            };
            if (sengoo_tar_read(source, used) as i64) != 0 {
                return sh_ts_return(state, - 1);
            };
            sengoo_ds_word_put(state, 25, sengoo_ds_word_get(state, 25) + 1);
            sengoo_ds_word_put(state, 8, used + 1);
            sengoo_ds_word_put(state, 10, wire + 1);
        } else {
            return sh_ts_return(state, - 10);
        };
    };
}
