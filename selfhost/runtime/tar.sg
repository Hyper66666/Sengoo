extern "C" {
    unsafe fn sengoo_tar_read(bytes: * const u8, index: i64) -> u8;
    unsafe fn sengoo_tar_output_read(bytes: * mut u8, index: i64) -> u8;
    unsafe fn sengoo_tar_write(bytes: * mut u8, index: i64, value: u8);
    fn sengoo_tar_windows_scalar_equal(left: i64, right: i64) -> i64;
} // Every helper is private. Pointer/extent authority belongs to the scan caller.
unsafe extern "C" fn sh_tar_number(source: * const u8, begin: i64, width: i64) -> i64 {
    let first = sengoo_tar_read(source, begin) as i64;
    let mut value = 0;
    let mut index = 0;
    if (first & 128) != 0 {
        // Positive base-256 only; do not truncate the high bytes like legacy tar.
        value = first & 127;
        index = 1;
        while index < width {
            let byte = sengoo_tar_read(source, begin + index) as i64;
            if value > (9223372036854775807 - byte) / 256 {
                return - 1;
            };
            value = value * 256 + byte;
            index = index + 1;
        };
        return value;
    };
    let mut digits = 0;
    let mut trailing = false;
    while index < width {
        let byte = sengoo_tar_read(source, begin + index) as i64;
        if byte == 0 {
            break;
        };
        if byte == 32 or byte == 9 or byte == 10 or byte == 13 {
            if digits > 0 {
                trailing = true;
            };
        } else {
            if trailing or byte < 48 or byte > 55 {
                return - 1;
            };
            if value > (9223372036854775807 - (byte - 48)) / 8 {
                return - 1;
            };
            value = value * 8 + byte - 48;
            digits = digits + 1;
        };
        index = index + 1;
    };
    if digits == 0 {
        return - 1;
    };
    value;
}
unsafe extern "C" fn sh_tar_decimal(source: * const u8, begin: i64, size: i64) -> i64 {
    if size < 1 {
        return - 1;
    };
    let mut index = 0;
    let mut value = 0;
    while index < size {
        let byte = sengoo_tar_read(source, begin + index) as i64;
        if byte < 48 or byte > 57 or value > (9223372036854775807 - (byte - 48)) / 10 {
            return - 1;
        };
        value = value * 10 + byte - 48;
        index = index + 1;
    };
    value;
}
unsafe extern "C" fn sh_tar_string_length(source: * const u8, begin: i64, maximum: i64) -> i64 {
    let mut index = 0;
    while index < maximum {
        if (sengoo_tar_read(source, begin + index) as i64) == 0 {
            return index;
        };
        index = index + 1;
    };
    maximum;
}
unsafe extern "C" fn sh_tar_get64(table: * mut u8, offset: i64) -> i64 {
    let mut value = 0;
    let mut index = 0;
    while index < 8 {
        value = value | ((sengoo_tar_output_read(table, offset + index) as i64) << (index * 8));
        index = index + 1;
    };
    value;
}
unsafe extern "C" fn sh_tar_put64(table: * mut u8, offset: i64, value: i64) {
    let mut index = 0;
    while index < 8 {
        sengoo_tar_write(table, offset + index, ((value >> (index * 8)) & 255) as u8);
        index = index + 1;
    };
} // Return width<<32 | scalar, or -1. Extent was already checked by the caller.
unsafe extern "C" fn sh_tar_scalar(bytes: * mut u8, at: i64, end: i64) -> i64 {
    if at >= end {
        return - 1;
    };
    let first = sengoo_tar_output_read(bytes, at) as i64;
    if first < 128 {
        return (1 << 32) | first;
    };
    let mut width = 0;
    let mut scalar = 0;
    let mut low = 128;
    let mut high = 191;
    if first >= 194 and first <= 223 {
        width = 2;
        scalar = first & 31;
    } else if first >= 224 and first <= 239 {
        width = 3;
        scalar = first & 15;
        if first == 224 {
            low = 160;
        };
        if first == 237 {
            high = 159;
        };
    } else if first >= 240 and first <= 244 {
        width = 4;
        scalar = first & 7;
        if first == 240 {
            low = 144;
        };
        if first == 244 {
            high = 143;
        };
    } else {
        return - 1;
    };
    if width > end - at {
        return - 1;
    };
    let mut index = 1;
    while index < width {
        let byte = sengoo_tar_output_read(bytes, at + index) as i64;
        if byte < low or byte > high {
            return - 1;
        };
        scalar = (scalar << 6) | (byte & 63);
        low = 128;
        high = 191;
        index = index + 1;
    };
    (width << 32) | scalar;
}
def sh_tar_utf16(scalar: i64) -> i64 {
    if scalar < 65536 {
        return scalar;
    };
    let value = scalar - 65536;
    (55296 + (value >> 10)) | ((56320 + (value & 1023)) << 16);
} // Compare whole paths or ancestry under Windows ordinal case identity.
// 0=unrelated, 1=equal, 2=left ancestor, 3=right ancestor.
unsafe extern "C" fn sh_tar_relation(paths: * mut u8, left: i64, left_length: i64, right: i64, right_length: i64) -> i64 {
    let mut a = left;
    let mut b = right;
    let ae = left + left_length;
    let be = right + right_length;
    while a < ae and b < be {
        let ac = sh_tar_scalar(paths, a, ae);
        let bc = sh_tar_scalar(paths, b, be);
        if ac < 0 or bc < 0 {
            return 0;
        };
        let mut av = ac & 4294967295;
        let mut bv = bc & 4294967295;
        if av != bv {
            if av < 128 and bv < 128 {
                if av >= 65 and av <= 90 {
                    av = av + 32;
                };
                if bv >= 65 and bv <= 90 {
                    bv = bv + 32;
                };
                if av != bv {
                    return 0;
                };
            } else if sengoo_tar_windows_scalar_equal(sh_tar_utf16(av), sh_tar_utf16(bv)) != 1 {
                return 0;
            };
        };
        a = a + (ac >> 32);
        b = b + (bc >> 32);
    };
    if a == ae and b == be {
        return 1;
    };
    if a == ae and (sengoo_tar_output_read(paths, b) as i64) == 47 {
        return 2;
    };
    if b == be and (sengoo_tar_output_read(paths, a) as i64) == 47 {
        return 3;
    };
    0;
}
unsafe extern "C" fn sh_tar_device(paths: * mut u8, start: i64, size: i64) -> i64 {
    // Microsoft also reserves COM/LPT plus superscript 1, 2 or 3.
    if size >= 5 {
        let mut prefix = 0;
        let mut n = 0;
        while n < 3 {
            let mut byte = sengoo_tar_output_read(paths, start + n) as i64;
            if byte >= 65 and byte <= 90 {
                byte = byte + 32;
            };
            prefix = prefix | (byte << (n * 8));
            n = n + 1;
        };
        if prefix == 7171939 or prefix == 7630956 {
            let lead = sengoo_tar_output_read(paths, start + 3) as i64;
            let digit = sengoo_tar_output_read(paths, start + 4) as i64;
            if lead == 194 and (digit == 185 or digit == 178 or digit == 179) {
                if size == 5 {
                    return 1;
                };
                if (sengoo_tar_output_read(paths, start + 5) as i64) == 46 {
                    return 1;
                };
            };
        };
    };
    let mut word = 0;
    let mut index = 0;
    while index < size {
        let mut byte = sengoo_tar_output_read(paths, start + index) as i64;
        if byte == 46 {
            break;
        };
        if index >= 4 {
            return 0;
        };
        if byte >= 65 and byte <= 90 {
            byte = byte + 32;
        };
        word = word | (byte << (index * 8));
        index = index + 1;
    };
    if index == 3 and (word == 7237475 or word == 7238256 or word == 7894369 or word == 7107950) {
        return 1;
    };
    if index == 4 {
        let digit = word >> 24;
        let base = word & 16777215;
        if digit >= 49 and digit <= 57 and (base == 7171939 or base == 7630956) {
            return 1;
        };
    };
    0;
}
unsafe extern "C" fn sh_tar_marker(paths: * mut u8, start: i64, size: i64) -> i64 {
    let archive = [46, 115, 103, 112, 109, 45, 97, 114, 99, 104, 105, 118, 101, 46, 115, 104, 97, 50,
    53, 54];
    let content = [46, 115, 103, 112, 109, 45, 99, 111, 110, 116, 101, 110, 116, 46, 115, 104, 97, 50,
    53, 54];
    let registry = [46, 115, 103, 112, 109, 45, 114, 101, 103, 105, 115, 116, 114, 121, 45, 109, 101,
    116, 97, 100, 97, 116, 97, 46, 106, 115, 111, 110];
    let mut a = size == 20;
    let mut b = size == 20;
    let mut c = size == 28;
    let mut index = 0;
    while index < size {
        let mut byte = sengoo_tar_output_read(paths, start + index) as i64;
        if byte >= 65 and byte <= 90 {
            byte = byte + 32;
        };
        if index < 20 {
            if byte != archive [index] {
                a = false;
            };
            if byte != content [index] {
                b = false;
            };
        };
        if index < 28 and byte != registry [index] {
            c = false;
        };
        index = index + 1;
    };
    if a or b or c {
        return 1;
    };
    0;
} // Normalize a raw path already copied to paths[start..start+size].
unsafe extern "C" fn sh_tar_path(paths: * mut u8, start: i64, size: i64) -> i64 {
    if size < 1 or size > 65535 {
        return - 4;
    };
    let first = sengoo_tar_output_read(paths, start) as i64;
    if first == 47 or first == 92 {
        return - 4;
    };
    let mut at = start;
    let end = start + size;
    let mut out = start;
    while at < end {
        let begin = at;
        while at < end {
            let byte = sengoo_tar_output_read(paths, at) as i64;
            if byte == 47 or byte == 92 {
                break;
            };
            if byte < 32 or byte == 127 or byte == 58 or byte == 60 or byte == 62 or byte == 34 or byte == 124 or byte == 63 or byte == 42 {
                return - 4;
            };
            at = at + 1;
        };
        let count = at - begin;
        if count == 2 and (sengoo_tar_output_read(paths, begin) as i64) == 46 and (sengoo_tar_output_read(paths,
        begin + 1) as i64) == 46 {
            return - 4;
        };
        if count > 0 and not (count == 1 and (sengoo_tar_output_read(paths, begin) as i64) == 46) {
            let last = sengoo_tar_output_read(paths, at - 1) as i64;
            if last == 32 or last == 46 or sh_tar_device(paths, begin, count) == 1 {
                return - 4;
            };
            if out > start {
                sengoo_tar_write(paths, out, 47 as u8);
                out = out + 1;
            };
            let mut index = 0;
            while index < count {
                let byte = sengoo_tar_output_read(paths, begin + index);
                sengoo_tar_write(paths, out, byte);
                out = out + 1;
                index = index + 1;
            };
        };
        at = at + 1;
    };
    if out == start {
        return - 4;
    };
    at = start;
    while at < out {
        let scalar = sh_tar_scalar(paths, at, out);
        if scalar < 0 {
            return - 4;
        };
        at = at + (scalar >> 32);
    };
    if sh_tar_marker(paths, start, out - start) == 1 {
        return - 4;
    };
    out - start;
} // Caller must discard both output arenas on any negative result.
pub unsafe extern "C" fn sengoo_sg_tar_scan(source: * const u8, length: i64, table: * mut u8, table_capacity: i64,
paths: * mut u8, path_capacity: i64) -> i64 {
    if length < 0 or length > 536870912 or table_capacity < 0 or table_capacity > 480032 or path_capacity < 0 or path_capacity > 16777216 {
        return - 3;
    };
    if table_capacity < 32 {
        return - 2;
    };
    let mut at = 0;
    let mut count = 0;
    let mut content = 0;
    let mut path_used = 0;
    let mut metadata = 0;
    let mut long_start = - 1;
    let mut long_size = 0;
    let mut pax_start = - 1;
    let mut pax_length = 0;
    let mut pax_size = - 1;
    let mut pax_seen = false;
    let mut terminated = false;
    while at < length {
        if length - at < 512 {
            return - 1;
        };
        let header = at;
        let mut index = 0;
        let mut sum = 0;
        let mut nonzero = false;
        while index < 512 {
            let byte = sengoo_tar_read(source, at + index) as i64;
            if byte != 0 {
                nonzero = true;
            };
            sum = sum + if index >= 148 and index < 156 {
                32;
            } else {
                byte;
            };
            index = index + 1;
        };
        if not nonzero {
            if long_start >= 0 or pax_seen or length - at < 1024 {
                return - 1;
            };
            index = at;
            while index < length {
                if (sengoo_tar_read(source, index) as i64) != 0 {
                    return - 1;
                };
                index = index + 1;
            };
            terminated = true;
            break;
        };
        if (sengoo_tar_read(source, at + 148) as i64) >= 128 or sh_tar_number(source, at + 148, 8) != sum {
            return - 1;
        };
        let kind = sengoo_tar_read(source, at + 156) as i64;
        let mut size = sh_tar_number(source, at + 124, 12);
        if size < 0 {
            return - 1;
        };
        let ustar = (sengoo_tar_read(source, at + 257) as i64) == 117 and (sengoo_tar_read(source, at + 258) as i64) == 115 and (sengoo_tar_read(source,
        at + 259) as i64) == 116 and (sengoo_tar_read(source, at + 260) as i64) == 97 and (sengoo_tar_read(source,
        at + 261) as i64) == 114;
        let posix = ustar and (sengoo_tar_read(source, at + 262) as i64) == 0 and (sengoo_tar_read(source,
        at + 263) as i64) == 48 and (sengoo_tar_read(source, at + 264) as i64) == 48;
        let gnu = ustar and (sengoo_tar_read(source, at + 262) as i64) == 32 and (sengoo_tar_read(source,
        at + 263) as i64) == 32 and (sengoo_tar_read(source, at + 264) as i64) == 0;
        at = at + 512;
        if (kind == 76 or kind == 120) and (posix or gnu) {
            if size > 1048576 or metadata > 16777216 - size {
                return - 7;
            };
            metadata = metadata + size;
            if size > length - at {
                return - 1;
            };
            if kind == 76 {
                if long_start >= 0 or size < 1 {
                    return - 1;
                };
                long_start = at;
                long_size = size;
                if (sengoo_tar_read(source, at + size - 1) as i64) == 0 {
                    long_size = long_size - 1;
                };
            } else {
                if pax_seen {
                    return - 1;
                };
                pax_seen = true;
                let finish = at + size;
                let mut cursor = at;
                while cursor < finish {
                    let begin = cursor;
                    let mut digits = 0;
                    let mut record = 0;
                    while cursor < finish {
                        let byte = sengoo_tar_read(source, cursor) as i64;
                        if byte == 32 {
                            break;
                        };
                        if byte < 48 or byte > 57 or record > 1048576 {
                            return - 1;
                        };
                        record = record * 10 + byte - 48;
                        cursor = cursor + 1;
                        digits = digits + 1;
                    };
                    if digits == 0 or record < digits + 4 or record > finish - begin {
                        return - 1;
                    };
                    let record_end = begin + record;
                    if (sengoo_tar_read(source, record_end - 1) as i64) != 10 {
                        return - 1;
                    };
                    cursor = cursor + 1;
                    let key = cursor;
                    while cursor < record_end - 1 and (sengoo_tar_read(source, cursor) as i64) != 61 {
                        cursor = cursor + 1;
                    };
                    if cursor == key or cursor >= record_end - 1 {
                        return - 1;
                    };
                    let key_size = cursor - key;
                    cursor = cursor + 1;
                    let value_size = record_end - 1 - cursor;
                    if key_size == 4 {
                        let k0 = sengoo_tar_read(source, key) as i64;
                        let k1 = sengoo_tar_read(source, key + 1) as i64;
                        let k2 = sengoo_tar_read(source, key + 2) as i64;
                        let k3 = sengoo_tar_read(source, key + 3) as i64;
                        if k0 == 112 and k1 == 97 and k2 == 116 and k3 == 104 {
                            if pax_start < 0 {
                                pax_start = cursor;
                                pax_length = value_size;
                            };
                            // The first path record wins, as in tar 0.4.46.
                        };
                        if k0 == 115 and k1 == 105 and k2 == 122 and k3 == 101 and pax_size < 0 {
                            pax_size = sh_tar_decimal(source, cursor, value_size);
                            if pax_size < 0 {
                                return - 1;
                            };
                        };
                    };
                    cursor = record_end;
                };
            };
        } else {
            if kind != 0 and kind != 48 and kind != 53 {
                return - 5;
            };
            if pax_size >= 0 {
                size = pax_size;
            };
            if count >= 10000 or size > 268435456 - content {
                return - 7;
            };
            if size > length - at {
                return - 1;
            };
            if kind == 53 and size != 0 {
                return - 5;
            };
            if table_capacity - 32 < (count + 1) * 48 {
                return - 2;
            };
            let mut start = header;
            let mut name_size = sh_tar_string_length(source, header, 100);
            let mut prefix_size = 0;
            if long_start >= 0 {
                start = long_start;
                name_size = long_size;
            } else if pax_start >= 0 {
                start = pax_start;
                name_size = pax_length;
            } else if posix {
                prefix_size = sh_tar_string_length(source, header + 345, 155);
            };
            let total = name_size + if prefix_size > 0 {
                prefix_size + 1;
            } else {
                0;
            };
            if total > 65535 {
                return - 4;
            };
            if total > path_capacity - path_used {
                return - 2;
            };
            index = 0;
            while index < prefix_size {
                sengoo_tar_write(paths, path_used + index, sengoo_tar_read(source, header + 345 + index));
                index = index + 1;
            };
            if prefix_size > 0 {
                sengoo_tar_write(paths, path_used + index, 47 as u8);
                index = index + 1;
            };
            let mut n = 0;
            while n < name_size {
                sengoo_tar_write(paths, path_used + index + n, sengoo_tar_read(source, start + n));
                n = n + 1;
            };
            let normalized = sh_tar_path(paths, path_used, total);
            if normalized < 0 {
                return normalized;
            };
            let mut previous = 0;
            let mut previous_path = 0;
            let mut first = sengoo_tar_output_read(paths, path_used) as i64;
            if first >= 65 and first <= 90 {
                first = first + 32;
            };
            while previous < count {
                let row = 32 + previous * 48;
                // Every earlier row and path was written by this invocation.
                // Length <=65535, contiguous path offsets and type 0/1 are
                // producer invariants; no caller-supplied table is trusted.
                let old_length = (sengoo_tar_output_read(table, row + 32) as i64) | ((sengoo_tar_output_read(table,
                row + 33) as i64) << 8);
                let mut old_first = sengoo_tar_output_read(paths, previous_path) as i64;
                if old_first >= 65 and old_first <= 90 {
                    old_first = old_first + 32;
                };
                if first == old_first or first >= 128 or old_first >= 128 {
                    let relation = sh_tar_relation(paths, previous_path, old_length, path_used, normalized);
                    if relation == 1 or (relation == 3 and kind != 53) {
                        return - 6;
                    };
                    if relation == 2 and (sengoo_tar_output_read(table, row + 40) as i64) == 0 {
                        return - 6;
                    };
                };
                previous_path = previous_path + old_length;
                previous = previous + 1;
            };
            let row = 32 + count * 48;
            sh_tar_put64(table, row, header);
            sh_tar_put64(table, row + 8, at);
            sh_tar_put64(table, row + 16, size);
            sh_tar_put64(table, row + 24, path_used);
            sh_tar_put64(table, row + 32, normalized);
            sh_tar_put64(table, row + 40, if kind == 53 {
                1;
            } else {
                0;
            });
            count = count + 1;
            content = content + size;
            path_used = path_used + normalized;
            long_start = - 1;
            long_size = 0;
            pax_start = - 1;
            pax_length = 0;
            pax_size = - 1;
            pax_seen = false;
        };
        if size > length - at {
            return - 1;
        };
        let padded = ((size + 511) / 512) * 512;
        if padded > length - at {
            return - 1;
        };
        at = at + padded;
    };
    if not terminated {
        return - 1;
    };
    sh_tar_put64(table, 0, 1);
    sh_tar_put64(table, 8, count);
    sh_tar_put64(table, 16, content);
    sh_tar_put64(table, 24, at + 1024);
    count;
}
