pub unsafe extern "C" fn sengoo_sg_raw_inflate(source: * const u8, input_length: i64, target: * mut u8,
capacity: i64) -> i64 {
    let result = sh_deflate_inflate(source, input_length, target, capacity, true);
    if result < 0 {
        return result;
    };
    result & 134217727;
}
pub unsafe extern "C" fn sengoo_sg_raw_inflate_prefix(source: * const u8, input_length: i64, target: * mut u8,
capacity: i64) -> i64 {
    sh_deflate_inflate(source, input_length, target, capacity, false);
}
