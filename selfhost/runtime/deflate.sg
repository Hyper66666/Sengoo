} // Macros preserve the enclosing unsafe context; the current language does not
// admit unsafe SG-ABI helpers or aggregate/reference types in the C ABI.
macro_rules! sh_def_bits {
    ($width: expr) => {
        {
            let wanted = $width;
            while bits.count < wanted {
                if bits.used >= bits.length {
                    return - 1;
                };
                let byte = sengoo_deflate_input_read(bits.source, bits.used) as i64;
                bits.value = bits.value | (byte << bits.count);
                bits.count = bits.count + 8;
                bits.used = bits.used + 1;
            };
            let bit_result = bits.value & ((1 << wanted) - 1);
            bits.value = bits.value >> wanted;
            bits.count = bits.count - wanted;
            bit_result;
        }
    };
}
macro_rules! sh_def_symbol {
    ($which: ident) => {
        {
            let code_tree = & $which;
            if code_tree.used == 0 {
                return - 1;
            };
            let mut code = 0;
            let mut first = 0;
            let mut symbol_index = 0;
            let mut code_width = 1;
            let mut decoded_symbol = - 1;
            while code_width <= 15 {
                let bit = sh_def_bits! (1);
                code = (code << 1) | bit;
                let amount = code_tree.counts [code_width];
                if code >= first and code - first < amount {
                    decoded_symbol = code_tree.symbols [symbol_index + code - first];
                    break;
                };
                symbol_index = symbol_index + amount;
                first = (first + amount) << 1;
                code_width = code_width + 1;
            };
            if decoded_symbol < 0 {
                return - 1;
            };
            decoded_symbol;
        }
    };
}
macro_rules! sh_def_dynamic {
    () => {
