unsafe extern "C" fn sh_sha_rotr(value: i64, bits: i64) -> i64 {
    ((value >> bits) | (value << (32 - bits))) & 4294967295;
}
unsafe extern "C" fn sh_sha_block(state: * mut u8) {
    let mut i = 0;
    while i < 16 {
        let at = 640 + i * 4;
        let word = ((sengoo_tar_output_read(state, at) as i64) << 24) | ((sengoo_tar_output_read(state,
        at + 1) as i64) << 16) | ((sengoo_tar_output_read(state, at + 2) as i64) << 8) | (sengoo_tar_output_read(state,
        at + 3) as i64);
        sengoo_ds_word_put(state, 16 + i, word);
        i = i + 1;
    };
    while i < 64 {
        let x = sengoo_ds_word_get(state, 16 + i - 15);
        let y = sengoo_ds_word_get(state, 16 + i - 2);
        let s0 = sh_sha_rotr(x, 7) ^ sh_sha_rotr(x, 18) ^ (x >> 3);
        let s1 = sh_sha_rotr(y, 17) ^ sh_sha_rotr(y, 19) ^ (y >> 10);
        sengoo_ds_word_put(state, 16 + i, (sengoo_ds_word_get(state, 16 + i - 16) + s0 + sengoo_ds_word_get(state,
        16 + i - 7) + s1) & 4294967295);
        i = i + 1;
    };
    let mut a = sengoo_ds_word_get(state, 8);
    let mut b = sengoo_ds_word_get(state, 9);
    let mut c = sengoo_ds_word_get(state, 10);
    let mut d = sengoo_ds_word_get(state, 11);
    let mut e = sengoo_ds_word_get(state, 12);
    let mut f = sengoo_ds_word_get(state, 13);
    let mut g = sengoo_ds_word_get(state, 14);
    let mut h = sengoo_ds_word_get(state, 15);
    i = 0;
    while i < 64 {
        let s1 = sh_sha_rotr(e, 6) ^ sh_sha_rotr(e, 11) ^ sh_sha_rotr(e, 25);
        let choice = (e & f) ^ ((e ^ 4294967295) & g);
        let t1 = (h + s1 + choice + sh_sha_k(i) + sengoo_ds_word_get(state, 16 + i)) & 4294967295;
        let s0 = sh_sha_rotr(a, 2) ^ sh_sha_rotr(a, 13) ^ sh_sha_rotr(a, 22);
        let majority = (a & b) ^ (a & c) ^ (b & c);
        let t2 = (s0 + majority) & 4294967295;
        h = g;
        g = f;
        f = e;
        e = (d + t1) & 4294967295;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & 4294967295;
        i = i + 1;
    };
    sengoo_ds_word_put(state, 8, (sengoo_ds_word_get(state, 8) + a) & 4294967295);
    sengoo_ds_word_put(state, 9, (sengoo_ds_word_get(state, 9) + b) & 4294967295);
    sengoo_ds_word_put(state, 10, (sengoo_ds_word_get(state, 10) + c) & 4294967295);
    sengoo_ds_word_put(state, 11, (sengoo_ds_word_get(state, 11) + d) & 4294967295);
    sengoo_ds_word_put(state, 12, (sengoo_ds_word_get(state, 12) + e) & 4294967295);
    sengoo_ds_word_put(state, 13, (sengoo_ds_word_get(state, 13) + f) & 4294967295);
    sengoo_ds_word_put(state, 14, (sengoo_ds_word_get(state, 14) + g) & 4294967295);
    sengoo_ds_word_put(state, 15, (sengoo_ds_word_get(state, 15) + h) & 4294967295);
}
pub unsafe extern "C" fn sengoo_sg_sha256_init(state: * mut u8, extent: i64) -> i64 {
    if extent != 1024 {
        return - 3;
    };
    let mut i = 0;
    while i < 128 {
        sengoo_ds_word_put(state, i, 0);
        i = i + 1;
    };
    sengoo_ds_word_put(state, 0, 1397246001);
    sengoo_ds_word_put(state, 8, 1779033703);
    sengoo_ds_word_put(state, 9, 3144134277);
    sengoo_ds_word_put(state, 10, 1013904242);
    sengoo_ds_word_put(state, 11, 2773480762);
    sengoo_ds_word_put(state, 12, 1359893119);
    sengoo_ds_word_put(state, 13, 2600822924);
    sengoo_ds_word_put(state, 14, 528734635);
    sengoo_ds_word_put(state, 15, 1541459225);
    0;
}
pub unsafe extern "C" fn sengoo_sg_sha256_update(state: * mut u8, extent: i64, source: * const u8, length: i64) -> i64 {
    if extent != 1024 or length < 0 or length > 67108864 {
        return - 3;
    };
    if sengoo_ds_word_get(state, 0) != 1397246001 or sengoo_ds_word_get(state, 3) != 0 {
        return - 4;
    };
    let total = sengoo_ds_word_get(state, 1);
    let mut pending = sengoo_ds_word_get(state, 2);
    if total < 0 or total > 1073741824 - length or pending < 0 or pending > 63 {
        return - 4;
    };
    let mut at = 0;
    while at < length {
        sengoo_tar_write(state, 640 + pending, sengoo_tar_read(source, at));
        pending = pending + 1;
        at = at + 1;
        if pending == 64 {
            sh_sha_block(state);
            pending = 0;
        };
    };
    sengoo_ds_word_put(state, 1, total + length);
    sengoo_ds_word_put(state, 2, pending);
    0;
}
pub unsafe extern "C" fn sengoo_sg_sha256_final(state: * mut u8, extent: i64, output: * mut u8, capacity: i64) -> i64 {
    if extent != 1024 or capacity < 32 or capacity > 67108864 {
        return - 3;
    };
    if sengoo_ds_word_get(state, 0) != 1397246001 or sengoo_ds_word_get(state, 3) != 0 {
        return - 4;
    };
    let total = sengoo_ds_word_get(state, 1);
    let mut pending = sengoo_ds_word_get(state, 2);
    if total < 0 or total > 1073741824 or pending < 0 or pending > 63 {
        return - 4;
    };
    sengoo_tar_write(state, 640 + pending, 128u8);
    pending = pending + 1;
    if pending > 56 {
        while pending < 64 {
            sengoo_tar_write(state, 640 + pending, 0u8);
            pending = pending + 1;
        };
        sh_sha_block(state);
        pending = 0;
    };
    while pending < 56 {
        sengoo_tar_write(state, 640 + pending, 0u8);
        pending = pending + 1;
    };
    let bits = total * 8;
    let mut i = 0;
    while i < 8 {
        sengoo_tar_write(state, 696 + i, ((bits >> ((7 - i) * 8)) & 255) as u8);
        i = i + 1;
    };
    sh_sha_block(state);
    i = 0;
    while i < 32 {
        let word = sengoo_ds_word_get(state, 8 + i / 4);
        sengoo_tar_write(output, i, ((word >> ((3 - i % 4) * 8)) & 255) as u8);
        i = i + 1;
    };
    sengoo_ds_word_put(state, 3, 1);
    0;
}
pub unsafe extern "C" fn sengoo_sg_sha256_dispose(state: * mut u8, extent: i64) -> i64 {
    if extent != 1024 {
        return - 3;
    };
    let mut i = 0;
    while i < 128 {
        sengoo_ds_word_put(state, i, 0);
        i = i + 1;
    };
    0;
}
