extern "C" {
    unsafe fn sengoo_tar_read(source: * const u8, index: i64) -> u8;
}
unsafe extern "C" fn sh_sv_byte(text: * const u8, length: i64, at: i64) -> i64 {
    if at < 0 or at >= length {
        return - 1;
    };
    sengoo_tar_read(text, at) as i64;
} // Byte-for-byte u64::MAX decimal bound, without narrowing through signed i64.
unsafe extern "C" fn sh_sv_max(index: i64) -> i64 {
    if index < 8 {
        (3761692294704805937 >> (index * 8)) & 255;
    } else if index < 16 {
        (3834033537023162160 >> ((index - 8) * 8)) & 255;
    } else {
        (892417585 >> ((index - 16) * 8)) & 255;
    };
}
unsafe extern "C" fn sh_sv_number(text: * const u8, length: i64, start: i64) -> i64 {
    let mut at = start;
    while sh_sv_byte(text, length, at) >= 48 and sh_sv_byte(text, length, at) <= 57 {
        at = at + 1;
    };
    let n = at - start;
    if n < 1 or n > 20 or (n > 1 and sh_sv_byte(text, length, start) == 48) {
        return - 1;
    };
    if n == 20 {
        let mut i = 0;
        while i < 20 {
            let b = sh_sv_byte(text, length, start + i);
            let m = sh_sv_max(i);
            if b < m {
                return at;
            };
            if b > m {
                return - 1;
            };
            i = i + 1;
        };
    };
    at;
}
unsafe extern "C" fn sh_sv_ident(text: * const u8, length: i64, start: i64, pre: i64) -> i64 {
    let mut at = start;
    let mut begin = start;
    let mut numeric = true;
    loop {
        let b = sh_sv_byte(text, length, at);
        if (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45 {
            numeric = false;
            at = at + 1;
        } else if b >= 48 and b <= 57 {
            at = at + 1;
        } else {
            if at == begin or (pre == 1 and numeric and at - begin > 1 and sh_sv_byte(text, length, begin) == 48) {
                return - 1;
            };
            if b == 46 {
                at = at + 1;
                begin = at;
                numeric = true;
            } else {
                return at;
            };
        };
    };
} // mode0 strict Version, mode1 canonical semver 1.0 VersionReq syntax.
pub unsafe extern "C" fn sengoo_sg_semver_validate(text: * const u8, length: i64, mode: i64) -> i64 {
    if length < 0 or length > 1048576 or mode < 0 or mode > 1 {
        return - 3;
    };
    let mut at = 0;
    let mut count = 0;
    if mode == 1 {
        while sh_sv_byte(text, length, at) == 32 {
            at = at + 1;
        };
        let b = sh_sv_byte(text, length, at);
        if b == 42 or b == 120 or b == 88 {
            at = at + 1;
            while sh_sv_byte(text, length, at) == 32 {
                at = at + 1;
            };
            return if at == length {
                1;
            } else {
                0;
            };
        };
    };
    loop {
        if mode == 1 {
            let b = sh_sv_byte(text, length, at);
            if b == 61 or b == 126 or b == 94 {
                at = at + 1;
            } else if b == 62 or b == 60 {
                at = at + 1;
                if sh_sv_byte(text, length, at) == 61 {
                    at = at + 1;
                };
            };
            while sh_sv_byte(text, length, at) == 32 {
                at = at + 1;
            };
        };
        at = sh_sv_number(text, length, at);
        if at < 0 {
            return 0;
        };
        let mut minor = false;
        let mut patch = false;
        let mut wildcard = false;
        if sh_sv_byte(text, length, at) == 46 {
            at = at + 1;
            let b = sh_sv_byte(text, length, at);
            if mode == 1 and (b == 42 or b == 120 or b == 88) {
                wildcard = true;
                at = at + 1;
            } else {
                at = sh_sv_number(text, length, at);
                if at < 0 {
                    return 0;
                };
                minor = true;
            };
            if sh_sv_byte(text, length, at) == 46 {
                at = at + 1;
                let c = sh_sv_byte(text, length, at);
                if mode == 1 and (c == 42 or c == 120 or c == 88) {
                    at = at + 1;
                } else {
                    if wildcard {
                        return 0;
                    };
                    at = sh_sv_number(text, length, at);
                    if at < 0 {
                        return 0;
                    };
                    patch = true;
                };
            };
        };
        if mode == 0 and (not minor or not patch) {
            return 0;
        };
        if patch and sh_sv_byte(text, length, at) == 45 {
            at = sh_sv_ident(text, length, at + 1, 1);
            if at < 0 {
                return 0;
            };
        };
        if patch and sh_sv_byte(text, length, at) == 43 {
            at = sh_sv_ident(text, length, at + 1, 0);
            if at < 0 {
                return 0;
            };
        };
        if mode == 0 {
            return if at == length {
                1;
            } else {
                0;
            };
        };
        while sh_sv_byte(text, length, at) == 32 {
            at = at + 1;
        };
        count = count + 1;
        if at == length {
            return 1;
        };
        if sh_sv_byte(text, length, at) != 44 or count >= 32 {
            return 0;
        };
        at = at + 1;
        while sh_sv_byte(text, length, at) == 32 {
            at = at + 1;
        };
    };
}
