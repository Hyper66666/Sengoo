// Typed serde-compatible registry metadata. Parsing/escaping are SG algorithms.
extern "C" {
    unsafe fn sengoo_tar_read(source: * const u8, index: i64) -> u8;
    unsafe fn sengoo_tar_output_read(state: * mut u8, index: i64) -> u8;
    unsafe fn sengoo_tar_write(state: * mut u8, index: i64, value: u8);
    unsafe fn sengoo_ds_word_get(state: * mut u8, index: i64) -> i64;
    unsafe fn sengoo_ds_word_put(state: * mut u8, index: i64, value: i64);
    unsafe fn sengoo_sg_utf8_validate(source: * const u8, length: i64) -> i64;
    unsafe fn sh_mt_new(state: * mut u8, parent: i64, key: i64, length: i64, kind: i64) -> i64;
    unsafe fn sh_mt_word(state: * mut u8, node: i64, field: i64) -> i64;
    unsafe fn sh_mt_set(state: * mut u8, node: i64, field: i64, value: i64);
    unsafe fn sh_mt_string(source: * const u8, state: * mut u8, key: i64) -> i64;
    unsafe fn sh_mm_key(state: * mut u8, node: i64, low: i64, high: i64, length: i64) -> bool;
    unsafe fn sh_mm_sequence(state: * mut u8, node: i64, structure: i64) -> i64;
    unsafe fn sengoo_ps_const_offset(state: * mut u8, offset: i64) -> * const u8;
}
unsafe extern "C" fn sh_rj_byte(source: * const u8, state: * mut u8, at: i64) -> i64 {
    if at < 0 or at >= sengoo_ds_word_get(state, 2) {
        return - 1;
    };
    sengoo_tar_read(source, at) as i64;
}
unsafe extern "C" fn sh_rj_fail(state: * mut u8) -> i64 {
    sengoo_ds_word_put(state, 5, - 23);
    sengoo_ds_word_put(state, 6, sengoo_ds_word_get(state, 1));
    - 23;
}
unsafe extern "C" fn sh_rj_skip(source: * const u8, state: * mut u8) {
    let mut at = sengoo_ds_word_get(state, 1);
    loop {
        let b = sh_rj_byte(source, state, at);
        if b != 32 and b != 9 and b != 10 and b != 13 {
            break;
        };
        at = at + 1;
    };
    sengoo_ds_word_put(state, 1, at);
}
unsafe extern "C" fn sh_rj_role(state: * mut u8, child: i64) -> i64 {
    if sh_mm_key(state, child, 7887337227475576931, 0, 8) {
        1;
    } else if sh_mm_key(state, child, 110386756870521, 0, 6) {
        2;
    } else if sh_mm_key(state, child, 7018141348476641657, 7237491, 11) {
        3;
    } else if sh_mm_key(state, child, 8315178135798768998, 0, 8) {
        4;
    } else {
        0;
    };
}
unsafe extern "C" fn sh_rj_value(source: * const u8, state: * mut u8, node: i64, depth: i64, discard: i64) -> i64 {
    if depth > 64 {
        return sh_rj_fail(state);
    };
    sh_rj_skip(source, state);
    let mut at = sengoo_ds_word_get(state, 1);
    let b = sh_rj_byte(source, state, at);
    if b == 34 {
        sengoo_ds_word_put(state, 15, discard);
        if sh_mt_string(source, state, 1) < 0 {
            return sh_rj_fail(state);
        };
        sengoo_ds_word_put(state, 15, 0);
        if discard == 0 and sengoo_sg_utf8_validate(sengoo_ps_const_offset(state, sengoo_ds_word_get(state,
        8)), sengoo_ds_word_get(state, 9)) != 1 {
            return sh_rj_fail(state);
        };
        sh_mt_set(state, node, 0, if discard == 1 {
            4;
        } else {
            1;
        });
        sh_mt_set(state, node, 4, sengoo_ds_word_get(state, 8));
        sh_mt_set(state, node, 5, sengoo_ds_word_get(state, 9));
        return 0;
    };
    if b == 123 or b == 91 {
        let object = b == 123;
        sh_mt_set(state, node, 0, if object {
            0;
        } else {
            3;
        });
        sengoo_ds_word_put(state, 1, at + 1);
        sh_rj_skip(source, state);
        let closing = if object {
            125;
        } else {
            93;
        };
        if sh_rj_byte(source, state, sengoo_ds_word_get(state, 1)) == closing {
            sengoo_ds_word_put(state, 1, sengoo_ds_word_get(state, 1) + 1);
            return 0;
        };
        loop {
            let mut key = 0;
            let mut length = 0;
            if object {
                sengoo_ds_word_put(state, 15, discard);
                if sh_rj_byte(source, state, sengoo_ds_word_get(state, 1)) != 34 or sh_mt_string(source,
                state, 1) < 0 {
                    return sh_rj_fail(state);
                };
                sengoo_ds_word_put(state, 15, 0);
                if discard == 0 and sengoo_sg_utf8_validate(sengoo_ps_const_offset(state, sengoo_ds_word_get(state,
                8)), sengoo_ds_word_get(state, 9)) != 1 {
                    return sh_rj_fail(state);
                };
                key = sengoo_ds_word_get(state, 8);
                length = sengoo_ds_word_get(state, 9);
                sh_rj_skip(source, state);
                if sh_rj_byte(source, state, sengoo_ds_word_get(state, 1)) != 58 {
                    return sh_rj_fail(state);
                };
                sengoo_ds_word_put(state, 1, sengoo_ds_word_get(state, 1) + 1);
            };
            let child = sh_mt_new(state, node, key, length, 4);
            if child < 0 {
                return sh_rj_fail(state);
            };
            let mut ignored = discard;
            if object and depth == 0 and sh_rj_role(state, child) == 0 {
                ignored = 1;
            };
            if sh_rj_value(source, state, child, depth + 1, ignored) < 0 {
                return - 23;
            };
            sh_rj_skip(source, state);
            let c = sh_rj_byte(source, state, sengoo_ds_word_get(state, 1));
            sengoo_ds_word_put(state, 1, sengoo_ds_word_get(state, 1) + 1);
            if c == closing {
                return 0;
            };
            if c != 44 {
                return sh_rj_fail(state);
            };
            sh_rj_skip(source, state);
        };
    };
    let mut literal = 0;
    let mut width = 0;
    let mut kind = 4;
    let mut value = 0;
    if b == 116 {
        literal = 1702195828;
        width = 4;
        kind = 5;
        value = 1;
    } else if b == 102 {
        literal = 435728179558;
        width = 5;
        kind = 5;
    } else if b == 110 {
        literal = 1819047278;
        width = 4;
        kind = 6;
    };
    if width > 0 {
        let mut i = 0;
        while i < width {
            if sh_rj_byte(source, state, at + i) != ((literal >> (i * 8)) & 255) {
                return sh_rj_fail(state);
            };
            i = i + 1;
        };
        sengoo_ds_word_put(state, 1, at + width);
        sh_mt_set(state, node, 0, kind);
        sh_mt_set(state, node, 4, value);
        return 0;
    };
    // Unknown fields are ignored by the reference struct but their complete
    // JSON syntax still must be validated; numeric values gain no authority.
    if b == 45 {
        at = at + 1;
    };
    let first = sh_rj_byte(source, state, at);
    if first == 48 {
        at = at + 1;
    } else {
        if first < 49 or first > 57 {
            return sh_rj_fail(state);
        };
        while sh_rj_byte(source, state, at) >= 48 and sh_rj_byte(source, state, at) <= 57 {
            at = at + 1;
        };
    };
    if sh_rj_byte(source, state, at) == 46 {
        at = at + 1;
        let start = at;
        while sh_rj_byte(source, state, at) >= 48 and sh_rj_byte(source, state, at) <= 57 {
            at = at + 1;
        };
        if at == start {
            return sh_rj_fail(state);
        };
    };
    if sh_rj_byte(source, state, at) == 101 or sh_rj_byte(source, state, at) == 69 {
        at = at + 1;
        let sign = sh_rj_byte(source, state, at);
        if sign == 43 or sign == 45 {
            at = at + 1;
        };
        let start = at;
        while sh_rj_byte(source, state, at) >= 48 and sh_rj_byte(source, state, at) <= 57 {
            at = at + 1;
        };
        if at == start {
            return sh_rj_fail(state);
        };
    };
    sengoo_ds_word_put(state, 1, at);
    sh_mt_set(state, node, 0, 4);
    0;
}
pub unsafe extern "C" fn sengoo_sg_registry_metadata_parse(source: * const u8, length: i64, state: * mut u8,
extent: i64) -> i64 {
    if length < 0 or length > 1048576 or extent != 8388608 {
        return - 3;
    };
    let mut i = 0;
    while i < 128 {
        sengoo_ds_word_put(state, i, 0);
        i = i + 1;
    };
    sengoo_ds_word_put(state, 0, 1397576753);
    sengoo_ds_word_put(state, 2, length);
    sengoo_ds_word_put(state, 4, 2625536);
    sengoo_ds_word_put(state, 14, 1);
    let root = sh_mt_new(state, - 1, 0, 0, 4);
    if sh_rj_value(source, state, root, 0, 0) < 0 {
        return - 23;
    };
    sh_rj_skip(source, state);
    if sengoo_ds_word_get(state, 1) != length or sh_mm_sequence(state, root, 7) < 0 or sh_mt_word(state,
    root, 0) != 0 {
        return sh_rj_fail(state);
    };
    let mut child = sh_mt_word(state, root, 6);
    let mut seen = 0;
    while child >= 0 {
        let role = sh_rj_role(state, child);
        if role > 0 {
            let bit = 1 << role;
            if (seen & bit) != 0 {
                return sh_rj_fail(state);
            };
            seen = seen | bit;
            let kind = sh_mt_word(state, child, 0);
            if role == 1 or role == 3 {
                if kind != 1 and kind != 6 {
                    return sh_rj_fail(state);
                };
            } else if role == 2 {
                if kind != 5 {
                    return sh_rj_fail(state);
                };
            } else {
                if kind != 3 {
                    return sh_rj_fail(state);
                };
                let mut item = sh_mt_word(state, child, 6);
                while item >= 0 {
                    if sh_mt_word(state, item, 0) != 1 {
                        return sh_rj_fail(state);
                    };
                    item = sh_mt_word(state, item, 7);
                };
            };
            sengoo_ds_word_put(state, 30 + role, child);
        };
        child = sh_mt_word(state, child, 7);
    };
    if (seen & 20) != 20 {
        return sh_rj_fail(state);
    };
    sengoo_ds_word_put(state, 30, seen);
    0;
}
unsafe extern "C" fn sh_rj_put(output: * mut u8, capacity: i64, position: i64, byte: i64) -> i64 {
    if position < 0 or position >= capacity {
        return - 22;
    };
    sengoo_tar_write(output, position, byte as u8);
    position + 1;
}
unsafe extern "C" fn sh_rj_text(output: * mut u8, capacity: i64, position: i64, low: i64, high: i64,
length: i64) -> i64 {
    let mut at = position;
    let mut i = 0;
    while i < length {
        let byte = if i < 8 {
            (low >> (i * 8)) & 255;
        } else {
            (high >> ((i - 8) * 8)) & 255;
        };
        at = sh_rj_put(output, capacity, at, byte);
        if at < 0 {
            return at;
        };
        i = i + 1;
    };
    at;
}
unsafe extern "C" fn sh_rj_hex(value: i64) -> i64 {
    if value < 10 {
        48 + value;
    } else {
        87 + value;
    };
}
unsafe extern "C" fn sh_rj_quote(state: * mut u8, node: i64, output: * mut u8, capacity: i64, position: i64) -> i64 {
    let start = sh_mt_word(state, node, 4);
    let length = sh_mt_word(state, node, 5);
    let mut at = sh_rj_put(output, capacity, position, 34);
    let mut i = 0;
    while i < length and at >= 0 {
        let b = sengoo_tar_output_read(state, start + i) as i64;
        let mut escape = 0;
        if b == 8 {
            escape = 98;
        } else if b == 9 {
            escape = 116;
        } else if b == 10 {
            escape = 110;
        } else if b == 12 {
            escape = 102;
        } else if b == 13 {
            escape = 114;
        } else if b == 34 or b == 92 {
            escape = b;
        };
        if escape > 0 {
            at = sh_rj_put(output, capacity, at, 92);
            at = sh_rj_put(output, capacity, at, escape);
        } else if b < 32 {
            at = sh_rj_put(output, capacity, at, 92);
            at = sh_rj_put(output, capacity, at, 117);
            at = sh_rj_put(output, capacity, at, 48);
            at = sh_rj_put(output, capacity, at, 48);
            at = sh_rj_put(output, capacity, at, sh_rj_hex(b >> 4));
            at = sh_rj_put(output, capacity, at, sh_rj_hex(b & 15));
        } else {
            at = sh_rj_put(output, capacity, at, b);
        };
        i = i + 1;
    };
    sh_rj_put(output, capacity, at, 34);
}
pub unsafe extern "C" fn sengoo_sg_registry_metadata_encode(state: * mut u8, extent: i64, output: * mut u8,
capacity: i64) -> i64 {
    if extent != 8388608 or capacity < 0 or capacity > 1048704 {
        return - 3;
    };
    if sengoo_ds_word_get(state, 0) != 1397576753 or sengoo_ds_word_get(state, 14) != 1 or sengoo_ds_word_get(state,
    5) != 0 {
        return - 23;
    };
    let seen = sengoo_ds_word_get(state, 30);
    if (seen & 20) != 20 {
        return - 23;
    };
    let mut at = sh_rj_text(output, capacity, 0, 8316850424063926907, 975334773, 12);
    let checksum = sengoo_ds_word_get(state, 31);
    if (seen & 2) == 0 or sh_mt_word(state, checksum, 0) == 6 {
        at = sh_rj_text(output, capacity, at, 1819047278, 0, 4);
    } else {
        at = sh_rj_quote(state, checksum, output, capacity, at);
    };
    at = sh_rj_text(output, capacity, at, 7234306498266473004, 14882, 10);
    let yanked = sengoo_ds_word_get(state, 32);
    if sh_mt_word(state, yanked, 4) == 1 {
        at = sh_rj_text(output, capacity, at, 1702195828, 0, 4);
    } else {
        at = sh_rj_text(output, capacity, at, 435728179558, 0, 5);
    };
    at = sh_rj_text(output, capacity, at, 8241423964937200172, 16363406360797541, 15);
    let reason = sengoo_ds_word_get(state, 33);
    if (seen & 8) == 0 or sh_mt_word(state, reason, 0) == 6 {
        at = sh_rj_text(output, capacity, at, 1819047278, 0, 4);
    } else {
        at = sh_rj_quote(state, reason, output, capacity, at);
    };
    at = sh_rj_text(output, capacity, at, 8247626254260773420, 391817360229, 13);
    let features = sengoo_ds_word_get(state, 34);
    let mut item = sh_mt_word(state, features, 6);
    let mut count = 0;
    while item >= 0 and at >= 0 {
        if count > 0 {
            at = sh_rj_put(output, capacity, at, 44);
        };
        at = sh_rj_quote(state, item, output, capacity, at);
        item = sh_mt_word(state, item, 7);
        count = count + 1;
    };
    at = sh_rj_put(output, capacity, at, 93);
    sh_rj_put(output, capacity, at, 125);
}
