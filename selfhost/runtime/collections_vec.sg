    unsafe fn sengoo_collections_null() -> * mut u8;
    unsafe fn sengoo_collections_present(bytes: * mut u8) -> i64;
    unsafe fn sengoo_collections_equal(left: * mut u8, right: * mut u8) -> i64;
    unsafe fn sengoo_collections_allocate(bytes: i64, align: i64) -> * mut u8;
    unsafe fn sengoo_collections_release(bytes: * mut u8);
    unsafe fn sengoo_collections_move(callback: i64, target: * mut u8, source: * mut u8);
    unsafe fn sengoo_collections_drop(callback: i64, value: * mut u8);
