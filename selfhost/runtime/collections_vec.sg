pub unsafe extern "C" fn sengoo_sg_collections_vec_live(state: * mut u8, extent: i64) -> i64 {
    if not sengoo_sg_cr_valid(state, extent) {
        return - 1;
    };
    sengoo_collections_word(state, 2);
}
pub unsafe extern "C" fn sengoo_sg_collections_context_dispose(state: * mut u8, extent: i64) -> i64 {
    if extent != 12352 or sengoo_collections_present(state) == 0 {
        return 2;
    };
    if not sengoo_sg_cr_valid(state, extent) {
        return 3;
    };
    let mut index = 0;
    while index < 128 {
        let at = 8 + index * 12;
        if sengoo_collections_word(state, at + 1) == 1 {
            sengoo_sg_collections_vec_free(state, extent, sengoo_collections_word(state, 3) * 4294967296 + sengoo_collections_word(state,
            at) * 256 + index + 1);
            ();
        };
        if sengoo_collections_word(state, at + 1) == 2 {
            sengoo_sg_collections_vec_iter_free(state, extent, sengoo_collections_word(state, 3) * 4294967296 + sengoo_collections_word(state,
            at) * 256 + index + 1);
            ();
        };
        index = index + 1;
    };
    index = 0;
    while index < 1544 {
        sengoo_collections_put(state, index, 0);
        index = index + 1;
    };
    0;
}
