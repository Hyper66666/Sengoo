    let metadata_size = sh_pa_metadata(arguments, document, buffer);
    if metadata_size < 0 {
        return metadata_size;
    };
    sh_pa_literal(tar, 512, 8241918741125231406, 7526410415579424867, 909455969, 0, 20);
    sh_pa_literal(tar, 544, 8026308908964868910, 7526410479869457518, 909455969, 0, 20);
    sh_pa_literal(tar, 576, 7309955093236249390, 7867077656573077863, 3342080360130376805, 1852797802,
    28);
    let metadata_node = sh_pa_marker(session, tar, 576, 28, sengoo_ps_const_offset(buffer, 0), metadata_size);
    if metadata_node < 0 {
        return metadata_node;
