    unsafe fn sengoo_pa_argument_length(arguments: * mut u8, index: i64) -> i64;
    unsafe fn sengoo_pa_allow_yanked(arguments: * mut u8) -> i64;
    unsafe fn sengoo_pa_file_size(session: i64, id: i64) -> i64;
    unsafe fn sengoo_pa_file_identity(session: i64, id: i64) -> i64;
    unsafe fn sengoo_pa_file_read(session: i64, id: i64, offset: i64, target: * mut u8, capacity: i64) -> i64;
    unsafe fn sengoo_pa_open_attributes(session: i64, parent: i64, name: * const u8, length: i64) -> i64;
    unsafe fn sengoo_pa_attributes_match(session: i64, id: i64, handle: i64) -> i64;
    unsafe fn sengoo_pa_close_attributes(handle: i64);
    unsafe fn sengoo_ps_component_equal(a: * const u8, n: i64, b: * const u8, m: i64) -> i64;
    unsafe fn sengoo_ps_const_offset(state: * mut u8, offset: i64) -> * const u8;
    unsafe fn sengoo_ps_mut_offset(state: * mut u8, offset: i64) -> * mut u8;
    unsafe fn sengoo_ps_input_offset(source: * const u8, offset: i64) -> * const u8;
    unsafe fn sengoo_tar_read(source: * const u8, index: i64) -> u8;
    unsafe fn sengoo_tar_output_read(state: * mut u8, index: i64) -> u8;
    unsafe fn sengoo_tar_write(state: * mut u8, index: i64, value: u8);
    unsafe fn sengoo_ds_word_get(state: * mut u8, index: i64) -> i64;
    unsafe fn sengoo_ds_word_put(state: * mut u8, index: i64, value: i64);
    unsafe fn sengoo_sg_semver_validate(source: * const u8, length: i64, mode: i64) -> i64;
    unsafe fn sengoo_sg_sha256_init(state: * mut u8, extent: i64) -> i64;
    unsafe fn sengoo_sg_sha256_update(state: * mut u8, extent: i64, source: * const u8, length: i64) -> i64;
    unsafe fn sengoo_sg_sha256_final(state: * mut u8, extent: i64, output: * mut u8, capacity: i64) -> i64;
    unsafe fn sengoo_sg_manifest_validate(source: * const u8, length: i64, state: * mut u8, extent: i64) -> i64;
    unsafe fn sh_mt_word(state: * mut u8, node: i64, field: i64) -> i64;
    unsafe fn sh_mm_root_role(state: * mut u8, node: i64) -> i64;
    unsafe fn sh_mm_role(state: * mut u8, node: i64) -> i64;
    unsafe fn sh_tar_path(state: * mut u8, start: i64, length: i64) -> i64;
    unsafe fn sengoo_sg_registry_metadata_parse(source: * const u8, length: i64, state: * mut u8, extent: i64) -> i64;
    unsafe fn sengoo_sg_registry_metadata_encode(state: * mut u8, extent: i64, output: * mut u8, capacity: i64) -> i64;
    unsafe fn sengoo_ps_create_node(session: i64, parent: i64, name: * const u8, length: i64, kind: i64) -> i64;
    unsafe fn sengoo_ps_write_node(session: i64, node: i64, source: * const u8, length: i64) -> i64;
    unsafe fn sengoo_ps_flush_node(session: i64, node: i64) -> i64;
    unsafe fn sengoo_ds_storage_alloc(length: i64) -> * mut u8;
    unsafe fn sengoo_ds_storage_present(state: * mut u8) -> i64;
    unsafe fn sengoo_ds_storage_free(state: * mut u8);
    unsafe fn sengoo_sg_sha256_dispose(state: * mut u8, extent: i64) -> i64;
