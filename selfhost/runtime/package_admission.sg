    if sengoo_ps_component_equal(name, component, sengoo_ps_const_offset(tar, 512), 20) == 1 or sengoo_ps_component_equal(name,
    component, sengoo_ps_const_offset(tar, 544), 20) == 1 or sengoo_ps_component_equal(name, component,
    sengoo_ps_const_offset(tar, 576), 28) == 1 {
        return - 4;
    };
    0;
}
pub unsafe extern "C" fn sh_pa_read_manifest(session: i64, node: i64, arguments: * mut u8, buffer: * mut u8,
document: * mut u8) -> i64 {
