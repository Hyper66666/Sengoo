    if length < 0 or length > 1048576 {
        return - 24;
    };
    let mut at = 0;
    while at < length {
        let mut chunk = length - at;
        if chunk > 32768 {
            chunk = 32768;
        };
        let read = sengoo_pa_file_read(session, node, at, sengoo_ps_mut_offset(buffer, at), chunk);
        if read != chunk {
            return - 8;
        };
        at = at + chunk;
    };
    if sengoo_pa_file_identity(session, node) != 1 or sengoo_pa_file_size(session, node) != length {
        return - 8;
    };
    let parsed = sengoo_sg_manifest_validate(sengoo_ps_const_offset(buffer, 0), length, document, 8388608);
    if parsed < 0 {
        return parsed;
    };
    let mut role = 0;
    while role < 2 {
        let start = sengoo_ds_word_get(document, 20 + role * 2);
        let size = sengoo_ds_word_get(document, 21 + role * 2);
        let expected = sengoo_pa_argument(arguments, role);
        if size != sengoo_pa_argument_length(arguments, role) {
            return - 24;
