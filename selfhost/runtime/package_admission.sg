pub unsafe extern "C" fn sengoo_sg_package_admit(session: i64, tar: * mut u8, nodes: * mut u8, entries: i64,
source: * const u8, length: i64, arguments: * mut u8) -> i64 {
    let document = sengoo_ds_storage_alloc(8388608);
    if sengoo_ds_storage_present(document) == 0 {
        return - 8;
    };
    let buffer = sengoo_ds_storage_alloc(1048704);
    if sengoo_ds_storage_present(buffer) == 0 {
        sengoo_ds_storage_free(document);
        return - 8;
    };
    let hash = sengoo_ds_storage_alloc(1024);
    if sengoo_ds_storage_present(hash) == 0 {
        sengoo_ds_storage_free(buffer);
        sengoo_ds_storage_free(document);
        return - 8;
    };
    let result = sh_pa_admit_inner(session, tar, nodes, entries, source, length, arguments, document,
    buffer, hash);
