unsafe extern "C" fn sh_pa_literal(target: * mut u8, at: i64, a: i64, b: i64, c: i64, d: i64, length: i64) {
    let mut i = 0;
    while i < length {
        let word = if i < 8 {
            a;
        } else if i < 16 {
            b;
        } else if i < 24 {
            c;
        } else {
            d;
        };
        sengoo_tar_write(target, at + i, ((word >> ((i % 8) * 8)) & 255) as u8);
        i = i + 1;
    };
}
pub unsafe extern "C" fn sh_pa_preflight(arguments: * mut u8) -> i64 {
    let name_length = sengoo_pa_argument_length(arguments, 0);
    let version_length = sengoo_pa_argument_length(arguments, 1);
    let checksum_length = sengoo_pa_argument_length(arguments, 2);
    let metadata_length = sengoo_pa_argument_length(arguments, 3);
    let allow = sengoo_pa_allow_yanked(arguments);
    if name_length < 1 or name_length > 65535 or version_length < 1 or version_length > 65535 or checksum_length != 64 or metadata_length < 1 or metadata_length > 1048576 or allow < 0 or allow > 1 {
        return - 3;
    };
    let name = sengoo_pa_argument(arguments, 0);
    let mut i = 0;
    while i < name_length {
        let b = sengoo_tar_read(name, i) as i64;
        if not ((b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 95) {
            return - 24;
        };
        i = i + 1;
    };
    if sengoo_sg_semver_validate(sengoo_pa_argument(arguments, 1), version_length, 0) != 1 {
        return - 24;
    };
    let checksum = sengoo_pa_argument(arguments, 2);
    i = 0;
    while i < 64 {
        let b = sengoo_tar_read(checksum, i) as i64;
        if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102)) {
            return - 25;
        };
        i = i + 1;
    };
    0;
}
unsafe extern "C" fn sh_pa_hex(byte: i64) -> i64 {
    if byte <= 57 {
        byte - 48;
    } else {
        byte - 87;
    };
}
pub unsafe extern "C" fn sh_pa_archive_checksum(source: * const u8, length: i64, arguments: * mut u8,
hash: * mut u8, digest: * mut u8) -> i64 {
    if length < 0 or length > 67108864 {
        return - 3;
    };
    if sengoo_sg_sha256_init(hash, 1024) < 0 {
        return - 25;
    };
    let mut at = 0;
    while at < length {
        let mut chunk = length - at;
        if chunk > 32768 {
            chunk = 32768;
        };
        if sengoo_sg_sha256_update(hash, 1024, sengoo_ps_input_offset(source, at), chunk) < 0 {
            return - 25;
        };
        at = at + chunk;
    };
    if sengoo_sg_sha256_final(hash, 1024, digest, 32) < 0 {
        return - 25;
    };
    let expected = sengoo_pa_argument(arguments, 2);
    let mut i = 0;
    while i < 32 {
        let value = (sh_pa_hex(sengoo_tar_read(expected, i * 2) as i64) << 4) | sh_pa_hex(sengoo_tar_read(expected,
        i * 2 + 1) as i64);
        if (sengoo_tar_output_read(digest, i) as i64) != value {
            return - 25;
        };
        i = i + 1;
    };
    0;
}
unsafe extern "C" fn sh_pa_node_find(session: i64, tar: * mut u8, nodes: * mut u8, parent: i64, name: * const u8,
length: i64) -> i64 {
    let count = sengoo_ds_word_get(nodes, 0);
    if count < 1 or count > 32768 {
        return - 26;
    };
    let mut i = 1;
    while i < count {
        if sengoo_ds_word_get(nodes, i * 4) == parent and sengoo_ps_component_equal(sengoo_ps_const_offset(tar,
        sengoo_ds_word_get(nodes, i * 4 + 1)), sengoo_ds_word_get(nodes, i * 4 + 2), name, length) == 1 {
            return i;
        };
        i = i + 1;
    };
    // Actual 8.3 spellings may differ from the archive's spelling. An OS
    // attributes-only handle must identify a retained session-created node.
    let attributes = sengoo_pa_open_attributes(session, parent, name, length);
    if attributes == 0 {
        return - 26;
    };
    let mut found = - 1;
    i = 1;
    while i < count {
        if sengoo_ds_word_get(nodes, i * 4) == parent and sengoo_pa_attributes_match(session, i, attributes) == 1 {
            found = i;
        };
        i = i + 1;
    };
    sengoo_pa_close_attributes(attributes);
    if found < 0 {
        - 26;
    } else {
        found;
    };
}
pub unsafe extern "C" fn sh_pa_root_manifest(session: i64, tar: * mut u8, nodes: * mut u8) -> i64 {
    sh_pa_literal(tar, 384, 8371751281595671891, 7105903, 0, 0, 11);
