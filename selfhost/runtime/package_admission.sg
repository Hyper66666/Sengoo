pub unsafe extern "C" fn sh_pa_targets(session: i64, tar: * mut u8, nodes: * mut u8, document: * mut u8,
scratch: * mut u8) -> i64 {
    sh_pa_literal(tar, 400, 7955997338301067891, 6779694, 0, 0, 11);
    sh_pa_literal(tar, 416, 3342349786834760307, 26483, 0, 0, 10);
    let mut child = sh_mt_word(document, 0, 6);
    let mut explicit = false;
    while child >= 0 {
        let role = sh_mm_root_role(document, child);
        if role == 3 or role == 4 {
            explicit = true;
            let mut item = sh_mt_word(document, child, 6);
            let mut path = - 1;
            while item >= 0 {
                if sh_mm_role(document, item) == 6 {
                    path = item;
                };
                item = sh_mt_word(document, item, 7);
            };
            let result = if path >= 0 {
                sh_pa_target(session, tar, nodes, sengoo_ps_const_offset(document, sh_mt_word(document,
                path, 4)), sh_mt_word(document, path, 5), scratch);
            } else if role == 3 {
                sh_pa_target(session, tar, nodes, sengoo_ps_const_offset(tar, 400), 11, scratch);
            } else {
                sh_pa_target(session, tar, nodes, sengoo_ps_const_offset(tar, 416), 10, scratch);
            };
            if result < 0 {
                return result;
            };
        };
        child = sh_mt_word(document, child, 7);
    };
    if not explicit {
        return sh_pa_target(session, tar, nodes, sengoo_ps_const_offset(tar, 400), 11, scratch);
    };
