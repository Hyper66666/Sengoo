pub unsafe extern "C" fn sh_pa_target(session: i64, tar: * mut u8, nodes: * mut u8, source: * const u8,
length: i64, scratch: * mut u8) -> i64 {
    if length < 1 or length > 65535 {
        return - 26;
    };
    let first = sengoo_tar_read(source, 0) as i64;
    if first == 47 or first == 92 {
        return - 26;
    };
    let mut read = 0;
    let mut used = 0;
    while read < length {
        let begin = read;
        while read < length and (sengoo_tar_read(source, read) as i64) != 47 and (sengoo_tar_read(source,
        read) as i64) != 92 {
            read = read + 1;
        };
        let size = read - begin;
        if size == 0 or (size == 1 and (sengoo_tar_read(source, begin) as i64) == 46) {
        } else if size == 2 and (sengoo_tar_read(source, begin) as i64) == 46 and (sengoo_tar_read(source,
        begin + 1) as i64) == 46 {
            if used == 0 {
                return - 26;
            };
            while used > 0 and (sengoo_tar_output_read(scratch, used - 1) as i64) != 47 {
                used = used - 1;
            };
            if used > 0 {
                used = used - 1;
            };
        } else {
            if used > 0 {
                sengoo_tar_write(scratch, used, 47u8);
                used = used + 1;
            };
            let mut i = 0;
            while i < size {
                sengoo_tar_write(scratch, used, sengoo_tar_read(source, begin + i));
                used = used + 1;
                i = i + 1;
            };
        };
        read = read + 1;
    };
    let normalized = sh_tar_path(scratch, 0, used);
    if normalized < 1 {
        return - 26;
    };
    let mut parent = 0;
    let mut begin = 0;
    while begin < normalized {
        let mut end = begin;
        while end < normalized and (sengoo_tar_output_read(scratch, end) as i64) != 47 {
            end = end + 1;
